    <typeMember xsi:type="spoon:CtMethod" name="dispatch">
      <comment xsi:type="spoon:CtJavaDoc" commentContent="Delivers one event from the Vehicle. A gas reading is analysed to&#xA;completion and the resulting commands are passed to the movement&#xA;subsystem; any other event goes to the movement subsystem."/>
