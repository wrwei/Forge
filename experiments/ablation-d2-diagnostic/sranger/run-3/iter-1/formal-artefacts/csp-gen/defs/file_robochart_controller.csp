			)
			\ union(
				{|
				|},
				{|
					stm_ref0::set_EXT_distance
				|}
			)
			[|{|terminate|}|>SKIP
			))
		
			HEXT(id__,
					    const_SRangerController_Ctrl_obstacleThreshold,
					    const_SRangerController_Ctrl_turnDurationMs) = O__(id__,
					    const_SRangerController_Ctrl_obstacleThreshold,
					    const_SRangerController_Ctrl_turnDurationMs) [|shared_variable_events|] SKIP			

	endmodule

module SRangerController
exports
	transparent diamond
	transparent sbisim
	transparent dbisim
	transparent chase

	-- Transition identifiers
	-- declaring identifiers of transitions
	datatype NIDS = 
	              NID_TURNING|
	              NID_MOVING|
	              NID_FINAL|
	              NID_i0
	
	channel internal__ : NIDS
	
	-- Flow channels		
	channel interrupt
	channel exited
	channel exit
	channel terminate
	
	-- Variable channels
	channel get_distance, set_distance, setL_distance, setR_distance: core_real
	
	-- Shared variable channels
	channel set_EXT_distance: core_real
	
	-- Local variable channels for defined operations that are required by the state machine
	
	-- Declaring state machine events
	channel endTask__: NIDS.InOut
	channel endTask: InOut
	channel obstacle__: NIDS.InOut
	channel obstacle: InOut
	channel tick__: NIDS.InOut
	channel tick: InOut
	channel move__: NIDS.InOut.core_real
	channel move: InOut.core_real
	
	-- Declaring call and ret events for undefined operations
	
	enterSS = {|
	TURNING::enter,
	MOVING::enter,
	FINAL::enter,
	i0::enter
	|}
	
	enteredSS = 	{|
	TURNING::entered,
	MOVING::entered,
	FINAL::entered
	|}
	
	internal_events = union(enteredSS,union(enterSS,{|interrupt,exited|}))
	
	shared_variable_events = {|
		set_EXT_distance
	|}
	
	-- channel set with all visible events
	sem__events = {|
		terminate
	,	set_EXT_distance, set_distance
	,	endTask,
		obstacle,
		tick,
		move
		|}

	-- Nodes --
	-- declaring all nodes
	
	----------------------------------------------------------------------
	-- State: TURNING
	module TURNING
	
	enterSS = {}
	
	enteredSS = {}
	
	exports
	
		--  Declarations
		
		channel enter, entered, interrupt
		channel enteredL, enteredR
		
						
		
		--	Nodes
		-- declaring all nodes
		
		
		--	Rule: behaviours(Node)
		--  Note that FDR has problems with efficiently compiling the process below
		-- 	if using a different recursion pattern.
		D__(id__,
				    const_SRangerController_obstacleThreshold,
				    const_SRangerController_turnDurationMs) = 
		dbisim(let
			-- IMPLEMENTATION NOTE: 
			-- The following should be defined as: Inactive = share__choice(Activation [] Termination),
			-- however FDR struggles with that form in certain cases. So we use the exception operator
			-- instead to 'terminate'.
			
			Inactive 	= share__choice(enter -> SKIP [] terminate -> SKIP) ; Active
			
			Termination = terminate -> SKIP
			
			Active 		= true&(share__choice(move.out!0 -> SKIP)) ; 
					 	  Behaviour ; 
					 	  share__choice(exit -> SKIP) ; SKIP ; 
					 	  share__choice(exited -> SKIP) ; Inactive
		
			Behaviour 	= entered -> During
			During 		= ((SKIP ; SStop) /\ interrupt -> SKIP)
		within
			Inactive [| {terminate} |> SKIP)
			
		VS_O__(id__,
				    const_SRangerController_obstacleThreshold,
				    const_SRangerController_turnDurationMs) = 
		dbisim(let
			Inactive 	= share__choice(enter -> SKIP [] terminate -> SKIP) ; Active
			
			Termination = terminate -> SKIP
			
			Active 		= true&(share__choice(move.out!0 -> SKIP)) ; 
					 	  Behaviour ; 
					 	  share__choice(exit -> SKIP) ; SKIP ; 
					 	  share__choice(exited -> SKIP) ; Inactive
		
			Behaviour 	= entered -> During
			During 		= ((SKIP ; SStop) /\ interrupt -> SKIP)
		within
			Inactive [| {terminate} |> SKIP)
		
	
	endmodule
	----------------------------------------------------------------------
	
	
	----------------------------------------------------------------------
	-- State: MOVING
	module MOVING
	
	enterSS = {}
	
	enteredSS = {}
	
	exports
	
		--  Declarations
		
		channel enter, entered, interrupt
		channel enteredL, enteredR
		
						
		
		--	Nodes
		-- declaring all nodes
		
		
		--	Rule: behaviours(Node)
		--  Note that FDR has problems with efficiently compiling the process below
		-- 	if using a different recursion pattern.
		D__(id__,
				    const_SRangerController_obstacleThreshold,
				    const_SRangerController_turnDurationMs) = 
		dbisim(let
			-- IMPLEMENTATION NOTE: 
			-- The following should be defined as: Inactive = share__choice(Activation [] Termination),
			-- however FDR struggles with that form in certain cases. So we use the exception operator
			-- instead to 'terminate'.
			
			Inactive 	= share__choice(enter -> SKIP [] terminate -> SKIP) ; Active
			
			Termination = terminate -> SKIP
			
			Active 		= true&(share__choice(move.out!1 -> SKIP)) ; 
					 	  Behaviour ; 
					 	  share__choice(exit -> SKIP) ; SKIP ; 
					 	  share__choice(exited -> SKIP) ; Inactive
		
			Behaviour 	= entered -> During
			During 		= ((SKIP ; SStop) /\ interrupt -> SKIP)
		within
			Inactive [| {terminate} |> SKIP)
			
		VS_O__(id__,
				    const_SRangerController_obstacleThreshold,
				    const_SRangerController_turnDurationMs) = 
		dbisim(let
			Inactive 	= share__choice(enter -> SKIP [] terminate -> SKIP) ; Active
			
			Termination = terminate -> SKIP
			
			Active 		= true&(share__choice(move.out!1 -> SKIP)) ; 
					 	  Behaviour ; 
					 	  share__choice(exit -> SKIP) ; SKIP ; 
					 	  share__choice(exited -> SKIP) ; Inactive
		
			Behaviour 	= entered -> During
			During 		= ((SKIP ; SStop) /\ interrupt -> SKIP)
		within
			Inactive [| {terminate} |> SKIP)
		
	
	endmodule
	----------------------------------------------------------------------
	
	
	----------------------------------------------------------------------
	-- State: FINAL
	module FINAL
	
	enterSS = {}
	
	enteredSS = {}
	
	exports
	
		--  Declarations
		
		channel enter, entered, interrupt
		channel enteredL, enteredR
		
						
		
		--	Nodes
		-- declaring all nodes
		
		
		--	Rule: behaviours(Node)
		--  Note that FDR has problems with efficiently compiling the process below
		-- 	if using a different recursion pattern.
		D__(id__,
				    const_SRangerController_obstacleThreshold,
				    const_SRangerController_turnDurationMs) = 
		dbisim(let
			-- IMPLEMENTATION NOTE: 
			-- The following should be defined as: Inactive = share__choice(Activation [] Termination),
			-- however FDR struggles with that form in certain cases. So we use the exception operator
			-- instead to 'terminate'.
			
			Inactive 	= share__choice(enter -> SKIP [] terminate -> SKIP) ; Active
			
			Termination = terminate -> SKIP
			
			Active 		= true&(share__choice(move.out!0 -> SKIP)) ; 
					 	  Behaviour ; 
					 	  share__choice(exit -> SKIP) ; SKIP ; 
					 	  share__choice(exited -> SKIP) ; Inactive
		
			Behaviour 	= entered -> During
			During 		= ((SKIP ; SStop) /\ interrupt -> SKIP)
		within
			Inactive [| {terminate} |> SKIP)
			
		VS_O__(id__,
				    const_SRangerController_obstacleThreshold,
				    const_SRangerController_turnDurationMs) = 
		dbisim(let
			Inactive 	= share__choice(enter -> SKIP [] terminate -> SKIP) ; Active
			
			Termination = terminate -> SKIP
			
			Active 		= true&(share__choice(move.out!0 -> SKIP)) ; 
					 	  Behaviour ; 
					 	  share__choice(exit -> SKIP) ; SKIP ; 
					 	  share__choice(exited -> SKIP) ; Inactive
		
			Behaviour 	= entered -> During
			During 		= ((SKIP ; SStop) /\ interrupt -> SKIP)
		within
			Inactive [| {terminate} |> SKIP)
		
	
	endmodule
	----------------------------------------------------------------------
	
	
	----------------------------------------------------------------------
	-- Initial: i0
	module i0
	exports
	
		channel enter, interrupt
		
		D__(id__,
				    const_SRangerController_obstacleThreshold,
				    const_SRangerController_turnDurationMs) = 
			dbisim(let
				Inactive 	= share__choice(enter -> SKIP [] terminate -> SKIP) ; Active
				
				Termination = terminate -> SKIP
				
				Active 		= share__choice(interrupt -> SKIP) ; Inactive
			within
				Inactive [| {terminate} |> SKIP)
		
		VS_O__(id__,
				    const_SRangerController_obstacleThreshold,
				    const_SRangerController_turnDurationMs) = D__(id__,
				    const_SRangerController_obstacleThreshold,
				    const_SRangerController_turnDurationMs)
	
	endmodule
	----------------------------------------------------------------------
	
	-- END of Nodes --
	
	-- Operation calls --
	-- Only the undefined operations are declared here.
	-- If the state machine is in isolation, all required operations will be undefined.
	-- If it is in the context of a controller, the required operations not provided by the
	-- controller will be declared here, and the defined operations will be defined in the
	-- context of the Controller module, and therefore within scope of the state machine module.
	
	-- END of Operation calls --
	
	-- STM processes
	STM(id__,
			    const_SRangerController_obstacleThreshold,
			    const_SRangerController_turnDurationMs) = -- RULE: [[stm:StateMachineDef]]_STM^nops : CSPProcess
	( 
		(
			(
				(IteratedStateful(id__,
						    const_SRangerController_obstacleThreshold,
						    const_SRangerController_turnDurationMs) \ {terminate} ; share__choice(terminate -> SKIP))
			 	[[ share__ <- x__ | x__ <- {|set_EXT_distance|} ]]
			)
		[| {share__} |]
		SKIP
		)
		[| union(sharedVarSync,{terminate}) |]
		dbisim(sharedVarMemory(id__,
				    const_SRangerController_obstacleThreshold,
				    const_SRangerController_turnDurationMs))
	)\sharedVarHide
	
	STM_VS_O(id__,
			    const_SRangerController_obstacleThreshold,
			    const_SRangerController_turnDurationMs) = -- RULE: [[stm:StateMachineDef]]_STM^nops : CSPProcess
	( 
		(
			(
				(IteratedStateful_VS_O(id__,
						    const_SRangerController_obstacleThreshold,
						    const_SRangerController_turnDurationMs) \ {terminate} ; share__choice(terminate -> SKIP))
			 	[[ share__ <- x__ | x__ <- {|set_EXT_distance|} ]]
			)
		[| {share__} |]
		SKIP
		)
		[| union(sharedVarSync,{terminate}) |]
		dbisim(sharedVarMemory(id__,
				    const_SRangerController_obstacleThreshold,
				    const_SRangerController_turnDurationMs))
	)\sharedVarHide
	
	-- Transitions
	Transitions(id__,
			    const_SRangerController_obstacleThreshold,
			    const_SRangerController_turnDurationMs) = ((let
		Trans = share__choice(get_distance?distance -> (
			((share__ -> SKIP
			 [] dbisim((true)&(internal__!NID_i0 -> SKIP ;  ((SKIP ; MOVING::enter -> SKIP))))
			 	 [] dbisim((true)&(endTask__!NID_MOVING.in -> SKIP ;  share__choice(exit -> SKIP) ; (share__choice(exited -> SKIP) ; SKIP ; FINAL::enter -> SKIP)))
			 	 [] dbisim(((distance<=const_SRangerController_obstacleThreshold))&(obstacle__!NID_MOVING.in -> SKIP ;  share__choice(exit -> SKIP) ; (share__choice(exited -> SKIP) ; SKIP ; TURNING::enter -> SKIP)))
			 	 [] dbisim((true)&(tick__!NID_MOVING.in -> SKIP ;  share__choice(exit -> SKIP) ; (share__choice(exited -> SKIP) ; SKIP ; MOVING::enter -> SKIP)))
			 	 [] dbisim((true)&(endTask__!NID_TURNING.in -> SKIP ;  share__choice(exit -> SKIP) ; (share__choice(exited -> SKIP) ; SKIP ; FINAL::enter -> SKIP)))
			 	 [] dbisim((true)&(internal__!NID_TURNING -> SKIP ;  share__choice(exit -> SKIP) ; (share__choice(exited -> SKIP) ; SKIP ; MOVING::enter -> SKIP)))
			 	 [] dbisim((true)&(tick__!NID_TURNING.in -> SKIP ;  share__choice(exit -> SKIP) ; (share__choice(exited -> SKIP) ; SKIP ; TURNING::enter -> SKIP)))
			 	 [] dbisim((true)&(tick__!NID_FINAL.in -> SKIP ;  share__choice(exit -> SKIP) ; (share__choice(exited -> SKIP) ; SKIP ; FINAL::enter -> SKIP)))
			 ) ; Trans)
			 []
			 (interrupt -> share__choice(exit -> SKIP) ; share__choice(exited -> terminate -> SKIP))
			 []
			 terminate -> SKIP
		)
		)
	within
		Trans
	)
	)
	
	-- Stateful
	-- RULE: Stateful(stm:StateMachineBody) : CSPProcess
	
	-- Named process definitions
	MachineBody(id__,
			    const_SRangerController_obstacleThreshold,
			    const_SRangerController_turnDurationMs) = 
		dbisim((
		let
			finalNodesEntered = {||}
		within
			((let
				-- IMPLEMENTATION NOTE:
				-- Here the 'enter' channel set is calculated explicitly because of the use of CSPM 
				-- modules for defining the semantics of each node.
				enterSS = {|
				TURNING::enter,
				MOVING::enter,
				FINAL::enter,
				i0::enter
				|}
				hideSet = union(enterSS,{|exit,exited,internal__|})
			within 
				((let
					-- IMPLEMENTATION NOTE: the channel set 'enter' is calculated explicitly
					-- because CSPM modules are used for the semantics of Node.
					flowevts = union(enterSS,{|exit,exited,interrupt|})
					transSync = {|internal__.NID_i0,endTask__.NID_MOVING.in,obstacle__.NID_MOVING.in,tick__.NID_MOVING.in,endTask__.NID_TURNING.in,internal__.NID_TURNING,tick__.NID_TURNING.in,tick__.NID_FINAL.in|}
				within
					((
					 (((-- RULE composeNodes(nc:NodeContainer)^nops : CSPProcess
					   TURNING::D__(id__,
					   		    const_SRangerController_obstacleThreshold,
					   		    const_SRangerController_turnDurationMs)
					   [| { share__, terminate } |] (
					   MOVING::D__(id__,
					   		    const_SRangerController_obstacleThreshold,
					   		    const_SRangerController_turnDurationMs)
					   [| { share__, terminate } |] (
					   FINAL::D__(id__,
					   		    const_SRangerController_obstacleThreshold,
					   		    const_SRangerController_turnDurationMs)
					   [| { share__, terminate } |] (
					   i0::D__(id__,
					   		    const_SRangerController_obstacleThreshold,
					   		    const_SRangerController_turnDurationMs)
					   )
					   )
					   )
					 )
					 [[TURNING::interrupt <- x__ | x__ <- {|interrupt,endTask__.NID_TURNING.in,internal__.NID_TURNING,tick__.NID_TURNING.in|}]]
					 [[MOVING::interrupt <- x__ | x__ <- {|interrupt,endTask__.NID_MOVING.in,obstacle__.NID_MOVING.in,tick__.NID_MOVING.in|}]]
					 [[FINAL::interrupt <- x__ | x__ <- {|interrupt,tick__.NID_FINAL.in|}]]
					 [[i0::interrupt <- x__ | x__ <- {|internal__.NID_i0|}]]
					 )
					  [[ share__ <- x__ | x__ <- {| share__ |} ]] 
					  [[set_distance <- setL_distance]]
					 )
					 [| union(union(union(flowevts,transSync),{terminate}),{|share__
					 			,setL_distance
					|}) |]
					 ((i0::enter -> Transitions(id__,
					 		    const_SRangerController_obstacleThreshold,
					 		    const_SRangerController_turnDurationMs))
					  [[ share__ <- x__ | x__ <- {| share__,setL_distance |} ]]
					 )
					)[[setL_distance <- set_distance]]
					)
				)
				 \ hideSet)
				[[
					endTask__.x____ <- endTask,
					obstacle__.x____ <- obstacle,
					tick__.x____ <- tick,
					move__.x____ <- move
					| x____ <- NIDS
				]]
			)
			 [| {| interrupt |} |] SKIP)
		)
		)
	
	Behaviour(id__,
			    const_SRangerController_obstacleThreshold,
			    const_SRangerController_turnDurationMs) = 
		dbisim((MachineBody(id__,
				    const_SRangerController_obstacleThreshold,
				    const_SRangerController_turnDurationMs)\ enteredSS)
		)
	
	IteratedBehaviour(id__,
			    const_SRangerController_obstacleThreshold,
			    const_SRangerController_turnDurationMs) = 
		dbisim((MachineBody(id__,
				    const_SRangerController_obstacleThreshold,
				    const_SRangerController_turnDurationMs)\ enteredSS)
		)
	
	Stateful(id__,
			    const_SRangerController_obstacleThreshold,
			    const_SRangerController_turnDurationMs) = 
		((
			(Behaviour(id__,
					    const_SRangerController_obstacleThreshold,
					    const_SRangerController_turnDurationMs) [| union(getsetLocalChannels,{terminate}) |] varMemory(id__,
					    const_SRangerController_obstacleThreshold,
					    const_SRangerController_turnDurationMs))
		 	\getsetLocalChannels
		)
		)
	
	IteratedStateful(id__,
			    const_SRangerController_obstacleThreshold,
			    const_SRangerController_turnDurationMs) =
		(Behaviour(id__,
				    const_SRangerController_obstacleThreshold,
				    const_SRangerController_turnDurationMs))
	
	-- Visible counterparts
	MachineBody_VS_O(id__,
			    const_SRangerController_obstacleThreshold,
			    const_SRangerController_turnDurationMs) = 
		dbisim((
		let
			finalNodesEntered = {||}
		within
			((let
				-- IMPLEMENTATION NOTE:
				-- Here the 'enter' channel set is calculated explicitly because of the use of CSPM 
				-- modules for defining the semantics of each node.
				enterSS = {|
				TURNING::enter,
				MOVING::enter,
				FINAL::enter,
				i0::enter
				|}
				hideSet = union(enterSS,{|exit,exited,internal__|})
			within 
				((let
					-- IMPLEMENTATION NOTE: the channel set 'enter' is calculated explicitly
					-- because CSPM modules are used for the semantics of Node.
					flowevts = union(enterSS,{|exit,exited,interrupt|})
					transSync = {|internal__.NID_i0,endTask__.NID_MOVING.in,obstacle__.NID_MOVING.in,tick__.NID_MOVING.in,endTask__.NID_TURNING.in,internal__.NID_TURNING,tick__.NID_TURNING.in,tick__.NID_FINAL.in|}
				within
					((
					 (((-- RULE composeNodes(nc:NodeContainer)^nops : CSPProcess
					   TURNING::VS_O__(id__,
					   		    const_SRangerController_obstacleThreshold,
					   		    const_SRangerController_turnDurationMs)
					   [| { share__, terminate } |] (
					   MOVING::VS_O__(id__,
					   		    const_SRangerController_obstacleThreshold,
					   		    const_SRangerController_turnDurationMs)
					   [| { share__, terminate } |] (
					   FINAL::VS_O__(id__,
					   		    const_SRangerController_obstacleThreshold,
					   		    const_SRangerController_turnDurationMs)
					   [| { share__, terminate } |] (
					   i0::VS_O__(id__,
					   		    const_SRangerController_obstacleThreshold,
					   		    const_SRangerController_turnDurationMs)
					   )
					   )
					   )
					 )
					 [[TURNING::interrupt <- x__ | x__ <- {|interrupt,endTask__.NID_TURNING.in,internal__.NID_TURNING,tick__.NID_TURNING.in|}]]
					 [[MOVING::interrupt <- x__ | x__ <- {|interrupt,endTask__.NID_MOVING.in,obstacle__.NID_MOVING.in,tick__.NID_MOVING.in|}]]
					 [[FINAL::interrupt <- x__ | x__ <- {|interrupt,tick__.NID_FINAL.in|}]]
					 [[i0::interrupt <- x__ | x__ <- {|internal__.NID_i0|}]]
					 )
					  [[ share__ <- x__ | x__ <- {| share__ |} ]] 
					  [[set_distance <- setL_distance]]
					 )
					 [| union(union(union(flowevts,transSync),{terminate}),{|share__
					 			,setL_distance
					|}) |]
					 ((i0::enter -> Transitions(id__,
					 		    const_SRangerController_obstacleThreshold,
					 		    const_SRangerController_turnDurationMs))
					  [[ share__ <- x__ | x__ <- {| share__,setL_distance |} ]]
					 )
					)[[setL_distance <- set_distance]]
					)
				)
				 \ hideSet)
				[[
					endTask__.x____ <- endTask,
					obstacle__.x____ <- obstacle,
					tick__.x____ <- tick,
					move__.x____ <- move
					| x____ <- NIDS
				]]
			)
			 [| {| interrupt |} |] SKIP)
		)
		)
	
	Behaviour_VS_O(id__,
			    const_SRangerController_obstacleThreshold,
			    const_SRangerController_turnDurationMs) = 
		dbisim((MachineBody_VS_O(id__,
				    const_SRangerController_obstacleThreshold,
				    const_SRangerController_turnDurationMs))
		)
	
	IteratedBehaviour_VS_O(id__,
			    const_SRangerController_obstacleThreshold,
			    const_SRangerController_turnDurationMs) = 
		dbisim((MachineBody_VS_O(id__,
				    const_SRangerController_obstacleThreshold,
				    const_SRangerController_turnDurationMs))
		)
	
	Stateful_VS_O(id__,
			    const_SRangerController_obstacleThreshold,
			    const_SRangerController_turnDurationMs) = 
		dbisim((
			(Behaviour_VS_O(id__,
					    const_SRangerController_obstacleThreshold,
					    const_SRangerController_turnDurationMs) [| union(getsetLocalChannels,{terminate}) |] varMemory(id__,
					    const_SRangerController_obstacleThreshold,
					    const_SRangerController_turnDurationMs))
		 	\getsetLocalChannels
		)
		)
	
	IteratedStateful_VS_O(id__,
			    const_SRangerController_obstacleThreshold,
			    const_SRangerController_turnDurationMs) =
		(Behaviour_VS_O(id__,
				    const_SRangerController_obstacleThreshold,
				    const_SRangerController_turnDurationMs))
	
	-- END
	
	-- Memory
	-- Memory variables
	
	-- varMemory process
	varMemory(id__,
			    const_SRangerController_obstacleThreshold,
			    const_SRangerController_turnDurationMs) = terminate -> SKIP
	
	getsetLocalChannels = {||}
	
	-- Definition of the behaviour of state machines (default, optimised, visible, visible and optimised)
	FVS__(id__,
			    const_SRangerController_obstacleThreshold,
			    const_SRangerController_turnDurationMs) = STM_VS_O(id__,
			    const_SRangerController_obstacleThreshold,
			    const_SRangerController_turnDurationMs)
	
	D__(id__,
			    const_SRangerController_obstacleThreshold,
			    const_SRangerController_turnDurationMs) = STM(id__,
			    const_SRangerController_obstacleThreshold,
			    const_SRangerController_turnDurationMs) \ internal_events
	O__(id__,
			    const_SRangerController_obstacleThreshold,
			    const_SRangerController_turnDurationMs) = sbisim(diamond(D__(id__,
			    const_SRangerController_obstacleThreshold,
			    const_SRangerController_turnDurationMs)))
	VS__(id__,
			    const_SRangerController_obstacleThreshold,
			    const_SRangerController_turnDurationMs) = FVS__(id__,
			    const_SRangerController_obstacleThreshold,
			    const_SRangerController_turnDurationMs)
	VS_O__(id__,
			    const_SRangerController_obstacleThreshold,
			    const_SRangerController_turnDurationMs) = sbisim(diamond(FVS__(id__,
			    const_SRangerController_obstacleThreshold,
			    const_SRangerController_turnDurationMs)))
	HEXT__(id__,
			    const_SRangerController_obstacleThreshold,
			    const_SRangerController_turnDurationMs) = O__(id__,
			    const_SRangerController_obstacleThreshold,
			    const_SRangerController_turnDurationMs) [|shared_variable_events|] SKIP
	HUP__(id__,
			    const_SRangerController_obstacleThreshold,
			    const_SRangerController_turnDurationMs) = O__(id__,
			    const_SRangerController_obstacleThreshold,
			    const_SRangerController_turnDurationMs) [|{share__}|] SKIP
	
	-- Shared memory
	-- Shared memory variables
	Memory_distance(distance) =
		get_distance!distance -> Memory_distance(distance)
		[]
		set_distance?x__ -> Memory_distance(x__)
		[]
		set_EXT_distance?x__ -> Memory_distance(x__)
		[]
		terminate -> SKIP
	
	-- sharedVarMemory process
	sharedVarMemory(id__,
			    const_SRangerController_obstacleThreshold,
			    const_SRangerController_turnDurationMs) = Memory_distance(0)
	
	sharedVarSync = {|get_distance,set_distance,set_EXT_distance|}
	
	sharedVarHide = {|get_distance|}
endmodule


