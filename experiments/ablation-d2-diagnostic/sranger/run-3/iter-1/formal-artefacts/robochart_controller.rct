diagram SRangerController

interface Inputs {
	event endTask
	event obstacle
	event tick
}

interface Outputs {
	event move : real
}

interface Sensors {
	var distance : real
}

interface Actuators {
}

interface SRangerController_State {
}

interface Constants {
	const obstacleThreshold : real = 1
	const turnDurationMs : real = 2000
}

stm SRangerController {
	uses Inputs uses Outputs requires SRangerController_State requires Constants requires Sensors
	clock clockResetTime
	state TURNING {
		entry move ! 0
	}
	state MOVING {
		entry move ! 1
	}
	state FINAL {
		entry move ! 0
	}
	initial i0
	transition t_init {
		from i0
		to MOVING
	}
	transition t1 {
		from MOVING
		to FINAL
		trigger endTask
	}
	transition t2 {
		from MOVING
		to TURNING
		trigger obstacle
		# clockResetTime
		condition distance <= obstacleThreshold
	}
	transition t3 {
		from MOVING
		to MOVING
		trigger tick
	}
	transition t4 {
		from TURNING
		to FINAL
		trigger endTask
	}
	transition t5 {
		from TURNING
		to MOVING
		condition since ( clockResetTime ) >= turnDurationMs
	}
	transition t6 {
		from TURNING
		to TURNING
		trigger tick
		condition not ( since ( clockResetTime ) >= turnDurationMs )
	}
	transition t7 {
		from FINAL
		to FINAL
		trigger tick
	}
}

controller SRangerController_Ctrl {
	uses Inputs uses Outputs requires SRangerController_State requires Constants requires Sensors
	sref stm_ref0 = SRangerController
	connection SRangerController_Ctrl on endTask to stm_ref0 on endTask
	connection SRangerController_Ctrl on obstacle to stm_ref0 on obstacle
	connection SRangerController_Ctrl on tick to stm_ref0 on tick
	connection stm_ref0 on move to SRangerController_Ctrl on move
}

module SRangerController_Module {
	robotic platform SRangerController_Platform {
		provides Sensors provides Actuators provides Constants
		event endTask
		event obstacle
		event tick
		event move : real
	}
	cref ctrl_ref0 = SRangerController_Ctrl
	connection SRangerController_Platform on endTask to ctrl_ref0 on endTask
	connection SRangerController_Platform on obstacle to ctrl_ref0 on obstacle
	connection SRangerController_Platform on tick to ctrl_ref0 on tick
	connection ctrl_ref0 on move to SRangerController_Platform on move
}

