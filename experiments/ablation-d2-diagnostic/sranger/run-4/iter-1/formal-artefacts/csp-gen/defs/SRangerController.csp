			    const_SRangerController_obstacleThreshold,
			    const_SRangerController_turnDuration) = Memory_NO_READING_DISTANCE(0)
	[| { terminate } |] (
	Memory_reading(0)
	[| { terminate } |] (
	Memory_distance(0)
	)
	)
	
	sharedVarSync = {|get_NO_READING_DISTANCE,set_NO_READING_DISTANCE,set_EXT_NO_READING_DISTANCE,get_reading,set_reading,set_EXT_reading,get_distance,set_distance,set_EXT_distance|}
	
	sharedVarHide = {|get_NO_READING_DISTANCE,get_reading,get_distance|}
endmodule
