						          const_SRangerController_turnduration) = 
					TimeOut_1(
						clockReset.CLID_clockResetTime -> Clock_CLID_clockResetTime(id__,0,
								          const_SRangerController_turnduration)
						[]
						get_CLID_clockResetTime!x__ -> Clock_CLID_clockResetTime(id__,x__,
								          const_SRangerController_turnduration)
						[]
						terminate -> SKIP,Clock_CLID_clockResetTime(id__,clock_type_plus(x__,1,CLID_clockResetTime_clock_type(id__,
								          const_SRangerController_turnduration)),
								          const_SRangerController_turnduration))
				
				Clocks(id__,
						          const_SRangerController_turnduration) = dbisim(Clock_CLID_clockResetTime(id__,0,
						          const_SRangerController_turnduration))
				
				clockSync = {|get_CLID_clockResetTime,clockReset.CLID_clockResetTime|}
				
				Clock_CLID_Moving(id__,x__,
						          const_SRangerController_turnduration) = 
					TimeOut_1(
						Moving::entered -> Clock_CLID_Moving(id__,0,
								          const_SRangerController_turnduration)
						[]
						get_CLID_Moving!x__ -> Clock_CLID_Moving(id__,x__,
								          const_SRangerController_turnduration)
						[]
						terminate -> SKIP,Clock_CLID_Moving(id__,clock_type_plus(x__,1,CLID_Moving_clock_type(id__,
								          const_SRangerController_turnduration)),
								          const_SRangerController_turnduration))
				Clock_CLID_Final(id__,x__,
						          const_SRangerController_turnduration) = 
					TimeOut_1(
						Final::entered -> Clock_CLID_Final(id__,0,
								          const_SRangerController_turnduration)
						[]
						get_CLID_Final!x__ -> Clock_CLID_Final(id__,x__,
								          const_SRangerController_turnduration)
						[]
						terminate -> SKIP,Clock_CLID_Final(id__,clock_type_plus(x__,1,CLID_Final_clock_type(id__,
								          const_SRangerController_turnduration)),
								          const_SRangerController_turnduration))
				Clock_CLID_Turning(id__,x__,
						          const_SRangerController_turnduration) = 
					TimeOut_1(
						Turning::entered -> Clock_CLID_Turning(id__,0,
								          const_SRangerController_turnduration)
						[]
						get_CLID_Turning!x__ -> Clock_CLID_Turning(id__,x__,
								          const_SRangerController_turnduration)
						[]
						terminate -> SKIP,Clock_CLID_Turning(id__,clock_type_plus(x__,1,CLID_Turning_clock_type(id__,
								          const_SRangerController_turnduration)),
								          const_SRangerController_turnduration))
				
				StateClocks(id__,
						          const_SRangerController_turnduration) = dbisim(Clock_CLID_Moving(id__,0,
						          const_SRangerController_turnduration))
				[| { terminate } |] (
				dbisim(Clock_CLID_Final(id__,0,
						          const_SRangerController_turnduration))
				[| { terminate } |] (
