						 [[Turning::interrupt <- x__ | x__ <- {|interrupt,endTask__.NID_Turning.in,internal__.NID_Turning,tick__.NID_Turning.in|}]]
						 [[Moving::interrupt <- x__ | x__ <- {|interrupt,endTask__.NID_Moving.in,obstacle__.NID_Moving.in,tick__.NID_Moving.in|}]]
						 [[Final::interrupt <- x__ | x__ <- {|interrupt|}]]
						 [[i0::interrupt <- x__ | x__ <- {|internal__.NID_i0|}]]
						 )
						  [[ share__ <- x__ | x__ <- {| share__ |} ]] 
						  [[clockReset.CLID_clockResetTime <- clockResetL.CLID_clockResetTime]]
						 )
						 [| union(union(union(flowevts,transSync),{terminate}),{|share__
						 			,clockResetL.CLID_clockResetTime
						|}) |]
						 ((i0::enter -> Transitions(id__,
						 		    const_SRangerController_turnduration))
						  [[ share__ <- x__ | x__ <- {| share__,clockResetL.CLID_clockResetTime |} ]]
						 )
						)[[clockResetL.CLID_clockResetTime <- clockReset.CLID_clockResetTime]]
						)
					)
					 \ hideSet)
					[[
						endTask__.x____ <- endTask,
						obstacle__.x____ <- obstacle,
						tick__.x____ <- tick,
						move__.x____ <- move
						| x____ <- NIDS
