				)\diff(stateClockSync,enteredSS))
				 [| {| interrupt |} |] SKIP)
			)
			)
		
		Behaviour(id__,
				    const_SRangerController_turnduration) = 
			dbisim((let
				stateClockSync = {|get_CLID_Moving,Moving::entered,get_CLID_Final,Final::entered,get_CLID_Turning,Turning::entered|}
