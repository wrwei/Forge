			localClockResets = {|clockReset.CLID_clockResetTime|}
			
			
			channel get_CLID_Moving : core_clock_type 
			channel get_CLID_Final : core_clock_type 
			channel get_CLID_Turning : core_clock_type 
			channel get_CLID_clockResetTime : core_clock_type 
			--channel increment__
			
			CLID_Moving_clock_type(id__,
					          const_SRangerController_turnduration) = 
				let
					max = (clock_type_max(Union({
			{}
			}))+1)
				ctype = {0..max}
			within
				if member(max,core_clock_type) then ctype else error("core_clock_type is not wide enough")
			
			CLID_Final_clock_type(id__,
					          const_SRangerController_turnduration) = 
				let
					max = (clock_type_max(Union({
			{}
			}))+1)
				ctype = {0..max}
			within
				if member(max,core_clock_type) then ctype else error("core_clock_type is not wide enough")
			
			CLID_Turning_clock_type(id__,
					          const_SRangerController_turnduration) = 
				let
					max = (clock_type_max(Union({
			{}
			}))+1)
				ctype = {0..max}
			within
				if member(max,core_clock_type) then ctype else error("core_clock_type is not wide enough")
			
			CLID_clockResetTime_clock_type(id__,
					          const_SRangerController_turnduration) = 
				let
					max = (clock_type_max(Union({
			({const_SRangerController_turnduration|turnduration <- core_real}),
			({const_SRangerController_turnduration|turnduration <- core_real})
			}))+1)
