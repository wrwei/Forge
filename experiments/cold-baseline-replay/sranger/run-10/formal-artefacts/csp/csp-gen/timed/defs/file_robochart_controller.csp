module SRangerController
exports
	transparent diamond
	transparent sbisim
	transparent dbisim
	transparent chase

	-- Transition identifiers
	-- declaring identifiers of transitions
	datatype NIDS = 
	              NID_Turning|
	              NID_Moving|
	              NID_Final|
	              NID_i0
	
	channel internal__ : NIDS
	
	-- Flow channels		
	channel interrupt
	channel exited
	channel exit
	channel terminate
	
	-- Variable channels
	
	-- Shared variable channels
	
	-- Local variable channels for defined operations that are required by the state machine
	
	-- Declaring state machine events
	channel endTask__: NIDS.InOut
	channel endTask: InOut
	channel obstacle__: NIDS.InOut
	channel obstacle: InOut
	channel tick__: NIDS.InOut
	channel tick: InOut
	channel move__: NIDS.InOut.core_real
	channel move: InOut.core_real
	
	-- Declaring call and ret events for undefined operations
	
	enterSS = {|
	Turning::enter,
	Moving::enter,
	Final::enter,
	i0::enter
	|}
	
	enteredSS = 	{|
	Turning::entered,
	Moving::entered,
	Final::entered
	|}
	
	internal_events = union(enteredSS,union(enterSS,{|interrupt,exited|}))
	
	shared_variable_events = {|
	|}
	
	-- channel set with all visible events
	sem__events = {|
		terminate
	,	endTask,
		obstacle,
		tick,
		move
		|}
	datatype ClockSet = 
		CLID_clockResetTime
	
	channel clockReset, clockResetL, clockResetR : ClockSet
	
	localClockResets = {|clockReset.CLID_clockResetTime|}
	
	
	channel get_CLID_Moving : core_clock_type 
	channel get_CLID_Final : core_clock_type 
	channel get_CLID_Turning : core_clock_type 
	channel get_CLID_clockResetTime : core_clock_type 
	--channel increment__
	
	CLID_Moving_clock_type(id__,
			          const_SRangerController_turnduration) = 
		let
			max = (clock_type_max(Union({
	{}
	}))+1)
		ctype = {0..max}
	within
		if member(max,core_clock_type) then ctype else error("core_clock_type is not wide enough")
	
	CLID_Final_clock_type(id__,
			          const_SRangerController_turnduration) = 
		let
			max = (clock_type_max(Union({
	{}
	}))+1)
		ctype = {0..max}
	within
		if member(max,core_clock_type) then ctype else error("core_clock_type is not wide enough")
	
	CLID_Turning_clock_type(id__,
			          const_SRangerController_turnduration) = 
		let
			max = (clock_type_max(Union({
	{}
	}))+1)
		ctype = {0..max}
	within
		if member(max,core_clock_type) then ctype else error("core_clock_type is not wide enough")
	
	CLID_clockResetTime_clock_type(id__,
			          const_SRangerController_turnduration) = 
		let
			max = (clock_type_max(Union({
	({const_SRangerController_turnduration|turnduration <- core_real}),
	({const_SRangerController_turnduration|turnduration <- core_real})
	}))+1)
		ctype = {0..max}
	within
		if member(max,core_clock_type) then ctype else error("core_clock_type is not wide enough")
	
	

		-- Nodes --
		-- declaring all nodes
		
		----------------------------------------------------------------------
		-- State: Turning
		module Turning
		
		enterSS = {}
		
		enteredSS = {}
		
		exports
		
			--  Declarations
			
			channel enter, entered, interrupt
			channel enteredL, enteredR
			
							
			
			--channel increment__
			
			
			--	Nodes
			-- declaring all nodes
			
			
			Timed(OneStep) {
				--	Rule: behaviours(Node)
				--  Note that FDR has problems with efficiently compiling the process below
				-- 	if using a different recursion pattern.
				D__(id__,
						    const_SRangerController_turnduration) = 
				dbisim(let
					-- IMPLEMENTATION NOTE: 
					-- The following should be defined as: Inactive = share__choice(Activation [] Termination),
					-- however FDR struggles with that form in certain cases. So we use the exception operator
					-- instead to 'terminate'.
					
					Inactive 	= share__choice(enter -> SKIP [] terminate -> SKIP) ; Active
					
					Termination = terminate -> SKIP
					
					Active 		= true&(share__choice(move.out!0 -> SKIP)) ; 
							 	  Behaviour ; 
							 	  share__choice(exit -> SKIP) ; SKIP ; 
							 	  share__choice(exited -> SKIP) ; Inactive
				
					Behaviour 	= entered -> During
					During 		= ((SKIP ; SStop) /\ interrupt -> SKIP)
				within
					Inactive [| {terminate} |> SKIP)
					
				VS_O__(id__,
						    const_SRangerController_turnduration) = 
				dbisim(let
					Inactive 	= share__choice(enter -> SKIP [] terminate -> SKIP) ; Active
					
					Termination = terminate -> SKIP
					
					Active 		= true&(share__choice(move.out!0 -> SKIP)) ; 
							 	  Behaviour ; 
							 	  share__choice(exit -> SKIP) ; SKIP ; 
							 	  share__choice(exited -> SKIP) ; Inactive
				
					Behaviour 	= entered -> During
					During 		= ((SKIP ; SStop) /\ interrupt -> SKIP)
				within
					Inactive [| {terminate} |> SKIP)
				
				
				-- Clocks
				
				StateClocks(id__,
						          const_SRangerController_turnduration) = terminate -> SKIP
				
				stateClockSync = {||}
			}
		
		endmodule
