						    const_SRangerController_turnduration))
				)
			
			Stateful_VS_O(id__,
					    const_SRangerController_turnduration) = 
				dbisim((
					(Behaviour_VS_O(id__,
							    const_SRangerController_turnduration) [| union(getsetLocalChannels,{terminate}) |] varMemory(id__,
							    const_SRangerController_turnduration))
