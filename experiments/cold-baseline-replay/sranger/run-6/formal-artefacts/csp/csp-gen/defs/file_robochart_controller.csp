					    const_SRangerController_turnduration) [|{share__}|] SKIP
			
			-- Shared memory
			-- Shared memory variables
			
			-- sharedVarMemory process
			sharedVarMemory(id__,
					    const_SRangerController_turnduration) = terminate -> SKIP
			
			sharedVarSync = {||}
			
			sharedVarHide = {||}
		endmodule
		
			-- undefined operations
			
			-- declaring controller memory
			Memory(id__, turnduration) = SKIP
			
			D__(id__,
					    const_SRangerController_Ctrl_turnduration) = 	((
					let
						const_SRangerController_turnduration = const_SRangerController_Ctrl_turnduration
					within 
					stm_ref0::D__(id__,
