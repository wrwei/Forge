				)
			
			IteratedStateful_VS_O(id__,
					    const_SRangerController_turnduration) =
				(Behaviour_VS_O(id__,
						    const_SRangerController_turnduration))
			
			-- END
			
			-- Memory
			-- Memory variables
			
			-- varMemory process
			varMemory(id__,
					    const_SRangerController_turnduration) = terminate -> SKIP
			
			getsetLocalChannels = {||}
			
			-- Definition of the behaviour of state machines (default, optimised, visible, visible and optimised)
			FVS__(id__,
					    const_SRangerController_turnduration) = STM_VS_O(id__,
					    const_SRangerController_turnduration)
			
			D__(id__,
					    const_SRangerController_turnduration) = STM(id__,
					    const_SRangerController_turnduration) \ internal_events
			O__(id__,
