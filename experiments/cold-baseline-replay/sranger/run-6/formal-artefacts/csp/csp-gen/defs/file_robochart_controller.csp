	----------------------------------------------------------------------
	
	
	----------------------------------------------------------------------
	-- Initial: i0
	module i0
	exports
	
		channel enter, interrupt
		
		D__(id__,
				    const_SRangerController_turnduration) = 
			dbisim(let
				Inactive 	= share__choice(enter -> SKIP [] terminate -> SKIP) ; Active
				
				Termination = terminate -> SKIP
				
				Active 		= share__choice(interrupt -> SKIP) ; Inactive
			within
				Inactive [| {terminate} |> SKIP)
		
		VS_O__(id__,
				    const_SRangerController_turnduration) = D__(id__,
				    const_SRangerController_turnduration)
	
	endmodule
	----------------------------------------------------------------------
	
	-- END of Nodes --
	
	-- Operation calls --
	-- Only the undefined operations are declared here.
	-- If the state machine is in isolation, all required operations will be undefined.
	-- If it is in the context of a controller, the required operations not provided by the
	-- controller will be declared here, and the defined operations will be defined in the
	-- context of the Controller module, and therefore within scope of the state machine module.
	
	-- END of Operation calls --
	
	-- STM processes
	STM(id__,
			    const_SRangerController_turnduration) = -- RULE: [[stm:StateMachineDef]]_STM^nops : CSPProcess
	( 
		(
			(
				(IteratedStateful(id__,
						    const_SRangerController_turnduration) \ {terminate} ; share__choice(terminate -> SKIP))
			 	[[ share__ <- x__ | x__ <- {||} ]]
			)
		[| {share__} |]
		SKIP
		)
		[| union(sharedVarSync,{terminate}) |]
		dbisim(sharedVarMemory(id__,
				    const_SRangerController_turnduration))
	)\sharedVarHide
	
	STM_VS_O(id__,
			    const_SRangerController_turnduration) = -- RULE: [[stm:StateMachineDef]]_STM^nops : CSPProcess
	( 
		(
			(
				(IteratedStateful_VS_O(id__,
						    const_SRangerController_turnduration) \ {terminate} ; share__choice(terminate -> SKIP))
			 	[[ share__ <- x__ | x__ <- {||} ]]
			)
		[| {share__} |]
		SKIP
		)
		[| union(sharedVarSync,{terminate}) |]
		dbisim(sharedVarMemory(id__,
				    const_SRangerController_turnduration))
	)\sharedVarHide
	
	-- Transitions
	Transitions(id__,
			    const_SRangerController_turnduration) = ((let
		Trans = (
			((share__ -> SKIP
			 [] dbisim((true)&(internal__!NID_i0 -> SKIP ;  ((SKIP ; Moving::enter -> SKIP))))
			 	 [] dbisim((true)&(endTask__!NID_Moving.in -> SKIP ;  share__choice(exit -> SKIP) ; (share__choice(exited -> SKIP) ; SKIP ; Final::enter -> SKIP)))
			 	 [] dbisim((true)&(obstacle__!NID_Moving.in -> SKIP ;  share__choice(exit -> SKIP) ; (share__choice(exited -> SKIP) ; SKIP ; Turning::enter -> SKIP)))
			 	 [] dbisim((true)&(tick__!NID_Moving.in -> SKIP ;  share__choice(exit -> SKIP) ; (share__choice(exited -> SKIP) ; SKIP ; Moving::enter -> SKIP)))
			 	 [] dbisim((true)&(endTask__!NID_Turning.in -> SKIP ;  share__choice(exit -> SKIP) ; (share__choice(exited -> SKIP) ; SKIP ; Final::enter -> SKIP)))
			 	 [] dbisim((true)&(internal__!NID_Turning -> SKIP ;  share__choice(exit -> SKIP) ; (share__choice(exited -> SKIP) ; SKIP ; Moving::enter -> SKIP)))
			 	 [] dbisim((true)&(tick__!NID_Turning.in -> SKIP ;  share__choice(exit -> SKIP) ; (share__choice(exited -> SKIP) ; SKIP ; Turning::enter -> SKIP)))
			 ) ; Trans)
			 []
			 (interrupt -> share__choice(exit -> SKIP) ; share__choice(exited -> terminate -> SKIP))
			 []
			 terminate -> SKIP
		)
	within
		Trans
	)
	)
	
	-- Stateful
	-- RULE: Stateful(stm:StateMachineBody) : CSPProcess
	
	-- Named process definitions
	MachineBody(id__,
			    const_SRangerController_turnduration) = 
		dbisim((
		let
			finalNodesEntered = {||}
		within
			((let
				-- IMPLEMENTATION NOTE:
				-- Here the 'enter' channel set is calculated explicitly because of the use of CSPM 
				-- modules for defining the semantics of each node.
				enterSS = {|
				Final::enter,
				Turning::enter,
				Moving::enter,
				i0::enter
				|}
				hideSet = union(enterSS,{|exit,exited,internal__|})
			within 
				((let
					-- IMPLEMENTATION NOTE: the channel set 'enter' is calculated explicitly
					-- because CSPM modules are used for the semantics of Node.
					flowevts = union(enterSS,{|exit,exited,interrupt|})
					transSync = {|internal__.NID_i0,endTask__.NID_Moving.in,obstacle__.NID_Moving.in,tick__.NID_Moving.in,endTask__.NID_Turning.in,internal__.NID_Turning,tick__.NID_Turning.in|}
				within
					((
					 (((-- RULE composeNodes(nc:NodeContainer)^nops : CSPProcess
					   Final::D__(id__,
					   		    const_SRangerController_turnduration)
					   [| { share__, terminate } |] (
					   Turning::D__(id__,
					   		    const_SRangerController_turnduration)
					   [| { share__, terminate } |] (
					   Moving::D__(id__,
					   		    const_SRangerController_turnduration)
					   [| { share__, terminate } |] (
					   i0::D__(id__,
					   		    const_SRangerController_turnduration)
					   )
					   )
					   )
					 )
					 [[Final::interrupt <- x__ | x__ <- {|interrupt|}]]
					 [[Turning::interrupt <- x__ | x__ <- {|interrupt,endTask__.NID_Turning.in,internal__.NID_Turning,tick__.NID_Turning.in|}]]
					 [[Moving::interrupt <- x__ | x__ <- {|interrupt,endTask__.NID_Moving.in,obstacle__.NID_Moving.in,tick__.NID_Moving.in|}]]
					 [[i0::interrupt <- x__ | x__ <- {|internal__.NID_i0|}]]
					 )
					  [[ share__ <- x__ | x__ <- {| share__ |} ]] 
					 )
					 [| union(union(union(flowevts,transSync),{terminate}),{|share__
					|}) |]
					 ((i0::enter -> Transitions(id__,
					 		    const_SRangerController_turnduration))
					  [[ share__ <- x__ | x__ <- {| share__ |} ]]
					 )
					)
					)
				)
				 \ hideSet)
				[[
					endTask__.x____ <- endTask,
					obstacle__.x____ <- obstacle,
					tick__.x____ <- tick,
					move__.x____ <- move
					| x____ <- NIDS
				]]
			)
			 [| {| interrupt |} |] SKIP)
		)
		)
	
	Behaviour(id__,
			    const_SRangerController_turnduration) = 
		dbisim((MachineBody(id__,
				    const_SRangerController_turnduration)\ enteredSS)
		)
	
	IteratedBehaviour(id__,
			    const_SRangerController_turnduration) = 
