					    const_Movement_Ctrl_stuckdist,
					    const_Movement_Ctrl_outperiod) = O__(id__,
					    const_Movement_Ctrl_lv,
					    const_Movement_Ctrl_evadetime,
					    const_Movement_Ctrl_stuckperiod,
					    const_Movement_Ctrl_stuckdist,
					    const_Movement_Ctrl_outperiod) [|shared_variable_events|] SKIP			

	endmodule

module GasAnalysis
exports
	transparent diamond
	transparent sbisim
	transparent dbisim
	transparent chase

	-- Transition identifiers
	-- declaring identifiers of transitions
	datatype NIDS = 
	              NID_Analysis|
	              NID_Reading|
	              NID_Final|
	              NID_NoGas|
	              NID_GasDetected|
	              NID_i0
	
	channel internal__ : NIDS
	
	-- Flow channels		
	channel interrupt
	channel exited
	channel exit
	channel terminate
	
	-- Variable channels
	channel get_v, set_v, setL_v, setR_v: core_real
	channel get_gs, set_gs, setL_gs, setR_gs: LSeq(GasSensor,2)
	channel get_sts, set_sts, setL_sts, setR_sts: Status
	channel get_ins, set_ins, setL_ins, setR_ins: Intensity
	channel get_anl, set_anl, setL_anl, setR_anl: Angle
	channel get_value, set_value, setL_value, setR_value: core_real
