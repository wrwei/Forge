	VS_O__(id__,
			    const_Movement_lv,
			    const_Movement_evadetime,
			    const_Movement_stuckperiod,
			    const_Movement_stuckdist,
			    const_Movement_outperiod) = sbisim(diamond(FVS__(id__,
			    const_Movement_lv,
			    const_Movement_evadetime,
			    const_Movement_stuckperiod,
			    const_Movement_stuckdist,
			    const_Movement_outperiod)))
	HEXT__(id__,
			    const_Movement_lv,
			    const_Movement_evadetime,
			    const_Movement_stuckperiod,
			    const_Movement_stuckdist,
			    const_Movement_outperiod) = O__(id__,
			    const_Movement_lv,
			    const_Movement_evadetime,
			    const_Movement_stuckperiod,
			    const_Movement_stuckdist,
			    const_Movement_outperiod) [|shared_variable_events|] SKIP
	HUP__(id__,
			    const_Movement_lv,
			    const_Movement_evadetime,
			    const_Movement_stuckperiod,
			    const_Movement_stuckdist,
			    const_Movement_outperiod) = O__(id__,
			    const_Movement_lv,
			    const_Movement_evadetime,
			    const_Movement_stuckperiod,
			    const_Movement_stuckdist,
			    const_Movement_outperiod) [|{share__}|] SKIP
	
	-- Shared memory
	-- Shared memory variables
	Memory_a(a) =
		get_a!a -> Memory_a(a)
		[]
		set_a?x__ -> Memory_a(x__)
		[]
		set_EXT_a?x__ -> Memory_a(x__)
		[]
		terminate -> SKIP
	Memory_d0(d0) =
		get_d0!d0 -> Memory_d0(d0)
		[]
		set_d0?x__ -> Memory_d0(x__)
		[]
		set_EXT_d0?x__ -> Memory_d0(x__)
		[]
		terminate -> SKIP
	Memory_d1(d1) =
		get_d1!d1 -> Memory_d1(d1)
		[]
		set_d1?x__ -> Memory_d1(x__)
		[]
		set_EXT_d1?x__ -> Memory_d1(x__)
		[]
		terminate -> SKIP
	Memory_l(l) =
		get_l!l -> Memory_l(l)
		[]
		set_l?x__ -> Memory_l(x__)
		[]
		set_EXT_l?x__ -> Memory_l(x__)
		[]
		terminate -> SKIP
	
	-- sharedVarMemory process
	sharedVarMemory(id__,
			    const_Movement_lv,
			    const_Movement_evadetime,
			    const_Movement_stuckperiod,
			    const_Movement_stuckdist,
			    const_Movement_outperiod) = Memory_a(Angle_Left)
	[| { terminate } |] (
	Memory_d0(0)
	[| { terminate } |] (
	Memory_d1(0)
	[| { terminate } |] (
	Memory_l(Loc_left)
	)
	)
	)
	
	sharedVarSync = {|get_a,set_a,set_EXT_a,get_d0,set_d0,set_EXT_d0,get_d1,set_d1,set_EXT_d1,get_l,set_l,set_EXT_l|}
	
	sharedVarHide = {|get_a,get_d0,get_d1,get_l|}
endmodule


