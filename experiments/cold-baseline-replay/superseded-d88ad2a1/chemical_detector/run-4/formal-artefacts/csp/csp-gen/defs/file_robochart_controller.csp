							 [[Found::interrupt <- x__ | x__ <- {|interrupt,internal__.NID_Found|}]]
							 [[Waiting::interrupt <- x__ | x__ <- {|interrupt,stop__.NID_Waiting.in,turn__.NID_Waiting.in,resume__.NID_Waiting.in|}]]
							 [[Avoiding::interrupt <- x__ | x__ <- {|interrupt,stop__.NID_Avoiding.in,turn__.NID_Avoiding.in,resume__.NID_Avoiding.in,odometer__.NID_Avoiding.in|}]]
							 [[Going::interrupt <- x__ | x__ <- {|interrupt,stop__.NID_Going.in,turn__.NID_Going.in,obstacle__.NID_Going.in,resume__.NID_Going.in|}]]
							 [[AvoidingAgain::interrupt <- x__ | x__ <- {|interrupt,stop__.NID_AvoidingAgain.in,resume__.NID_AvoidingAgain.in,internal__.NID_AvoidingAgain,internal__.NID_AvoidingAgain|}]]
							 [[i0::interrupt <- x__ | x__ <- {|internal__.NID_i0|}]]
							 )
							  [[ share__ <- x__ | x__ <- {| share__,setR_d0,setR_l,setR_a,setR_d1 |} ]] 
							  [[set_d0 <- setL_d0,set_d1 <- setL_d1]]
							 )
							 [| union(union(union(flowevts,transSync),{terminate}),{|share__
							 			,setL_d0
							 			,setL_d1
							 			,setR_d0
							 			 			,setR_l
							 			 			,setR_a
							 			 			,setR_d1
							 			|}) |]
							 ((i0::enter -> Transitions(id__,
							 		    const_Movement_lv,
							 		    const_Movement_evadetime,
							 		    const_Movement_stuckperiod,
							 		    const_Movement_stuckdist,
							 		    const_Movement_outperiod))
							  [[ share__ <- x__ | x__ <- {| share__,setL_d0,setL_d1 |} ]]
							  [[set_d0 <- setR_d0,set_l <- setR_l,set_a <- setR_a,set_d1 <- setR_d1]]
							 )
							)[[setL_d0 <- set_d0,setL_d1 <- set_d1]]
							 [[setR_d0 <- set_d0,setR_l <- set_l,setR_a <- set_a,setR_d1 <- set_d1]]
							)
						)
						 \ hideSet)
						[[
							gas__.x____ <- gas,
							obstacle__.x____ <- obstacle,
							odometer__.x____ <- odometer,
							randomWalk__.x____ <- randomWalk,
							flag__.x____ <- flag,
							shortRandomWalk__.x____ <- shortRandomWalk,
							stop__.x____ <- stop,
							turn__.x____ <- turn,
							resume__.x____ <- resume
							| x____ <- NIDS
						]]
					)
					 [| {| interrupt |} |] SKIP)
				)
				)
			
			Behaviour_VS_O(id__,
					    const_Movement_lv,
					    const_Movement_evadetime,
					    const_Movement_stuckperiod,
					    const_Movement_stuckdist,
					    const_Movement_outperiod) = 
				dbisim((MachineBody_VS_O(id__,
						    const_Movement_lv,
						    const_Movement_evadetime,
						    const_Movement_stuckperiod,
						    const_Movement_stuckdist,
						    const_Movement_outperiod))
				)
			
			IteratedBehaviour_VS_O(id__,
					    const_Movement_lv,
					    const_Movement_evadetime,
					    const_Movement_stuckperiod,
					    const_Movement_stuckdist,
					    const_Movement_outperiod) = 
				dbisim((MachineBody_VS_O(id__,
						    const_Movement_lv,
						    const_Movement_evadetime,
						    const_Movement_stuckperiod,
						    const_Movement_stuckdist,
						    const_Movement_outperiod))
				)
			
			Stateful_VS_O(id__,
					    const_Movement_lv,
					    const_Movement_evadetime,
					    const_Movement_stuckperiod,
					    const_Movement_stuckdist,
					    const_Movement_outperiod) = 
				dbisim((
					(Behaviour_VS_O(id__,
							    const_Movement_lv,
							    const_Movement_evadetime,
							    const_Movement_stuckperiod,
							    const_Movement_stuckdist,
							    const_Movement_outperiod) [| union(getsetLocalChannels,{terminate}) |] varMemory(id__,
							    const_Movement_lv,
							    const_Movement_evadetime,
							    const_Movement_stuckperiod,
							    const_Movement_stuckdist,
							    const_Movement_outperiod))
				 	\getsetLocalChannels
				)
				)
			
			IteratedStateful_VS_O(id__,
					    const_Movement_lv,
					    const_Movement_evadetime,
					    const_Movement_stuckperiod,
					    const_Movement_stuckdist,
					    const_Movement_outperiod) =
				(dbisim(
					sbisim(
						Behaviour_VS_O(id__,
								    const_Movement_lv,
								    const_Movement_evadetime,
								    const_Movement_stuckperiod,
								    const_Movement_stuckdist,
								    const_Movement_outperiod)
						[| {|get_v,set_v,terminate|} |]
						Memory_v(0)
					)\{|get_v,set_v|}
				)
				)
			
			-- END
			
			-- Memory
			-- Memory variables
			Memory_v(v) =
				get_v!v -> Memory_v(v)
				[]
				set_v?x__ -> Memory_v(x__)
				[]
				terminate -> SKIP
			
			-- varMemory process
			varMemory(id__,
					    const_Movement_lv,
					    const_Movement_evadetime,
					    const_Movement_stuckperiod,
					    const_Movement_stuckdist,
					    const_Movement_outperiod) = Memory_v(0)
			
			getsetLocalChannels = {|get_v,set_v|}
			
			-- Definition of the behaviour of state machines (default, optimised, visible, visible and optimised)
			FVS__(id__,
					    const_Movement_lv,
					    const_Movement_evadetime,
					    const_Movement_stuckperiod,
					    const_Movement_stuckdist,
					    const_Movement_outperiod) = STM_VS_O(id__,
					    const_Movement_lv,
					    const_Movement_evadetime,
					    const_Movement_stuckperiod,
					    const_Movement_stuckdist,
					    const_Movement_outperiod)
			
			D__(id__,
					    const_Movement_lv,
					    const_Movement_evadetime,
					    const_Movement_stuckperiod,
					    const_Movement_stuckdist,
					    const_Movement_outperiod) = STM(id__,
					    const_Movement_lv,
					    const_Movement_evadetime,
					    const_Movement_stuckperiod,
					    const_Movement_stuckdist,
					    const_Movement_outperiod) \ internal_events
			O__(id__,
					    const_Movement_lv,
					    const_Movement_evadetime,
					    const_Movement_stuckperiod,
					    const_Movement_stuckdist,
					    const_Movement_outperiod) = sbisim(diamond(D__(id__,
					    const_Movement_lv,
					    const_Movement_evadetime,
					    const_Movement_stuckperiod,
					    const_Movement_stuckdist,
					    const_Movement_outperiod)))
			VS__(id__,
					    const_Movement_lv,
					    const_Movement_evadetime,
					    const_Movement_stuckperiod,
					    const_Movement_stuckdist,
					    const_Movement_outperiod) = FVS__(id__,
					    const_Movement_lv,
					    const_Movement_evadetime,
					    const_Movement_stuckperiod,
					    const_Movement_stuckdist,
					    const_Movement_outperiod)
			VS_O__(id__,
					    const_Movement_lv,
					    const_Movement_evadetime,
					    const_Movement_stuckperiod,
					    const_Movement_stuckdist,
					    const_Movement_outperiod) = sbisim(diamond(FVS__(id__,
					    const_Movement_lv,
					    const_Movement_evadetime,
					    const_Movement_stuckperiod,
					    const_Movement_stuckdist,
					    const_Movement_outperiod)))
			HEXT__(id__,
					    const_Movement_lv,
					    const_Movement_evadetime,
					    const_Movement_stuckperiod,
					    const_Movement_stuckdist,
					    const_Movement_outperiod) = O__(id__,
					    const_Movement_lv,
					    const_Movement_evadetime,
					    const_Movement_stuckperiod,
					    const_Movement_stuckdist,
					    const_Movement_outperiod) [|shared_variable_events|] SKIP
			HUP__(id__,
					    const_Movement_lv,
					    const_Movement_evadetime,
					    const_Movement_stuckperiod,
					    const_Movement_stuckdist,
					    const_Movement_outperiod) = O__(id__,
					    const_Movement_lv,
					    const_Movement_evadetime,
					    const_Movement_stuckperiod,
					    const_Movement_stuckdist,
					    const_Movement_outperiod) [|{share__}|] SKIP
			
			-- Shared memory
			-- Shared memory variables
			Memory_a(a) =
				get_a!a -> Memory_a(a)
				[]
				set_a?x__ -> Memory_a(x__)
				[]
				set_EXT_a?x__ -> Memory_a(x__)
				[]
				terminate -> SKIP
			Memory_d0(d0) =
				get_d0!d0 -> Memory_d0(d0)
				[]
				set_d0?x__ -> Memory_d0(x__)
				[]
				set_EXT_d0?x__ -> Memory_d0(x__)
				[]
				terminate -> SKIP
			Memory_d1(d1) =
				get_d1!d1 -> Memory_d1(d1)
				[]
				set_d1?x__ -> Memory_d1(x__)
				[]
				set_EXT_d1?x__ -> Memory_d1(x__)
				[]
				terminate -> SKIP
			Memory_l(l) =
				get_l!l -> Memory_l(l)
				[]
