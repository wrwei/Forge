					   		    const_GasAnalysis_stuckperiod,
					   		    const_GasAnalysis_stuckdist,
					   		    const_GasAnalysis_outperiod)
					   )
					   )
					   )
					   )
					   )
					 )
					 [[Analysis::interrupt <- x__ | x__ <- {|interrupt,internal__.NID_Analysis,internal__.NID_Analysis|}]]
					 [[Reading::interrupt <- x__ | x__ <- {|interrupt,gas__.NID_Reading.in|}]]
					 [[Final::interrupt <- x__ | x__ <- {|interrupt|}]]
					 [[NoGas::interrupt <- x__ | x__ <- {|interrupt,internal__.NID_NoGas|}]]
					 [[GasDetected::interrupt <- x__ | x__ <- {|interrupt,internal__.NID_GasDetected,internal__.NID_GasDetected|}]]
					 [[i0::interrupt <- x__ | x__ <- {|internal__.NID_i0|}]]
					 )
					  [[ share__ <- x__ | x__ <- {| share__,setR_gs |} ]] 
					  [[set_sts <- setL_sts,set_insAboveThr <- setL_insAboveThr]]
					 )
					 [| union(union(union(flowevts,transSync),{terminate}),{|share__
					 			,setL_sts
					 			,setL_insAboveThr
					 			,setR_gs
					 			|}) |]
					 ((i0::enter -> Transitions(id__,
					 		    const_GasAnalysis_lv,
					 		    const_GasAnalysis_evadetime,
					 		    const_GasAnalysis_stuckperiod,
					 		    const_GasAnalysis_stuckdist,
					 		    const_GasAnalysis_outperiod))
					  [[ share__ <- x__ | x__ <- {| share__,setL_sts,setL_insAboveThr |} ]]
					  [[set_gs <- setR_gs]]
					 )
					)[[setL_sts <- set_sts,setL_insAboveThr <- set_insAboveThr]]
					 [[setR_gs <- set_gs]]
					)
				)
				 \ hideSet)
				[[
					gas__.x____ <- gas,
					obstacle__.x____ <- obstacle,
					odometer__.x____ <- odometer,
