				[]
				set_EXT_l?x__ -> Memory_l(x__)
				[]
				terminate -> SKIP
			
			-- sharedVarMemory process
			sharedVarMemory(id__,
					    const_Movement_lv,
					    const_Movement_evadetime,
					    const_Movement_stuckperiod,
					    const_Movement_stuckdist,
					    const_Movement_outperiod) = Memory_a(Angle_Left)
			[| { terminate } |] (
			Memory_d0(0)
			[| { terminate } |] (
			Memory_d1(0)
			[| { terminate } |] (
			Memory_l(Loc_left)
			)
			)
			)
			
			sharedVarSync = {|get_a,set_a,set_EXT_a,get_d0,set_d0,set_EXT_d0,get_d1,set_d1,set_EXT_d1,get_l,set_l,set_EXT_l|}
			
			sharedVarHide = {|get_a,get_d0,get_d1,get_l|}
		endmodule
		
			-- undefined operations
			CALL__move(id__,
					    param_p0,
					    param_p1) 	= moveCall.param_p0.param_p1 -> SKIP
			
			-- declaring controller memory
			Memory(id__, a, d0, d1, l, lv, evadetime, stuckperiod, stuckdist, outperiod) = (
			set_EXT_a?x__ -> stm_ref0::set_EXT_a!x__ -> 
			Memory(id__,x__,d0,d1,l,lv,evadetime,stuckperiod,stuckdist,outperiod)
			 []
			set_EXT_d0?x__ -> stm_ref0::set_EXT_d0!x__ -> 
			Memory(id__,a,x__,d1,l,lv,evadetime,stuckperiod,stuckdist,outperiod)
			 []
			set_EXT_d1?x__ -> stm_ref0::set_EXT_d1!x__ -> 
			Memory(id__,a,d0,x__,l,lv,evadetime,stuckperiod,stuckdist,outperiod)
			 []
			set_EXT_l?x__ -> stm_ref0::set_EXT_l!x__ -> 
			Memory(id__,a,d0,d1,x__,lv,evadetime,stuckperiod,stuckdist,outperiod)
			)
			
			D__(id__,
					    const_Movement_Ctrl_lv,
					    const_Movement_Ctrl_evadetime,
					    const_Movement_Ctrl_stuckperiod,
					    const_Movement_Ctrl_stuckdist,
					    const_Movement_Ctrl_outperiod) = 	((
					let
						const_Movement_lv = const_Movement_Ctrl_lv
						const_Movement_evadetime = const_Movement_Ctrl_evadetime
						const_Movement_stuckperiod = const_Movement_Ctrl_stuckperiod
						const_Movement_stuckdist = const_Movement_Ctrl_stuckdist
						const_Movement_outperiod = const_Movement_Ctrl_outperiod
					within 
					stm_ref0::D__(id__,
							    const_Movement_lv,
							    const_Movement_evadetime,
							    const_Movement_stuckperiod,
							    const_Movement_stuckdist,
							    const_Movement_outperiod)[[
						stm_ref0::terminate <- terminate,
						stm_ref0::stop <- stop,
						stm_ref0::turn <- turn,
						stm_ref0::resume <- resume,
						stm_ref0::obstacle <- obstacle,
						stm_ref0::odometer <- odometer,
						stm_ref0::randomWalk <- randomWalk,
						stm_ref0::flag <- flag,
