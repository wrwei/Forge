			 	 [] dbisim(((not ((insAboveThr))))&(internal__!NID_GasDetected -> SKIP ;  share__choice(exit -> SKIP) ; (share__choice(exited -> SKIP) ; share__choice(share__choice(get_gs?gs -> true & (share__choice(set_anl!location(gs) -> SKIP))));share__choice(get_anl?anl -> true&(share__choice(turn.out!anl -> SKIP))) ; Reading::enter -> SKIP)))
