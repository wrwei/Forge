	IteratedBehaviour(id__,
			    const_GasAnalysis_lv,
			    const_GasAnalysis_evadetime,
			    const_GasAnalysis_stuckperiod,
			    const_GasAnalysis_stuckdist,
			    const_GasAnalysis_outperiod) = 
		dbisim((MachineBody(id__,
				    const_GasAnalysis_lv,
				    const_GasAnalysis_evadetime,
				    const_GasAnalysis_stuckperiod,
				    const_GasAnalysis_stuckdist,
				    const_GasAnalysis_outperiod)\ enteredSS)
		)
	
	Stateful(id__,
			    const_GasAnalysis_lv,
			    const_GasAnalysis_evadetime,
			    const_GasAnalysis_stuckperiod,
			    const_GasAnalysis_stuckdist,
			    const_GasAnalysis_outperiod) = 
		((
			(Behaviour(id__,
					    const_GasAnalysis_lv,
					    const_GasAnalysis_evadetime,
					    const_GasAnalysis_stuckperiod,
					    const_GasAnalysis_stuckdist,
					    const_GasAnalysis_outperiod) [| union(getsetLocalChannels,{terminate}) |] varMemory(id__,
					    const_GasAnalysis_lv,
					    const_GasAnalysis_evadetime,
					    const_GasAnalysis_stuckperiod,
					    const_GasAnalysis_stuckdist,
					    const_GasAnalysis_outperiod))
		 	\getsetLocalChannels
		)
		)
	
	IteratedStateful(id__,
			    const_GasAnalysis_lv,
			    const_GasAnalysis_evadetime,
			    const_GasAnalysis_stuckperiod,
			    const_GasAnalysis_stuckdist,
			    const_GasAnalysis_outperiod) =
		(dbisim(
			sbisim(
				Behaviour(id__,
						    const_GasAnalysis_lv,
						    const_GasAnalysis_evadetime,
						    const_GasAnalysis_stuckperiod,
						    const_GasAnalysis_stuckdist,
						    const_GasAnalysis_outperiod)
				[| {|get_v,set_v,terminate|} |]
				Memory_v(0)
			)\{|get_v,set_v|}
		)
		)
	
	-- Visible counterparts
	MachineBody_VS_O(id__,
			    const_GasAnalysis_lv,
			    const_GasAnalysis_evadetime,
			    const_GasAnalysis_stuckperiod,
			    const_GasAnalysis_stuckdist,
			    const_GasAnalysis_outperiod) = 
		dbisim((
		let
			finalNodesEntered = {||}
		within
			((let
				-- IMPLEMENTATION NOTE:
				-- Here the 'enter' channel set is calculated explicitly because of the use of CSPM 
				-- modules for defining the semantics of each node.
				enterSS = {|
				Analysis::enter,
				Reading::enter,
				Final::enter,
				NoGas::enter,
				GasDetected::enter,
				i0::enter
				|}
				hideSet = union(enterSS,{|exit,exited,internal__|})
			within 
				((let
					-- IMPLEMENTATION NOTE: the channel set 'enter' is calculated explicitly
					-- because CSPM modules are used for the semantics of Node.
					flowevts = union(enterSS,{|exit,exited,interrupt|})
					transSync = {|internal__.NID_i0,gas__.NID_Reading.in,internal__.NID_Analysis,internal__.NID_Analysis,internal__.NID_NoGas,internal__.NID_GasDetected,internal__.NID_GasDetected|}
				within
					((
					 (((-- RULE composeNodes(nc:NodeContainer)^nops : CSPProcess
					   Analysis::VS_O__(id__,
					   		    const_GasAnalysis_lv,
					   		    const_GasAnalysis_evadetime,
					   		    const_GasAnalysis_stuckperiod,
					   		    const_GasAnalysis_stuckdist,
					   		    const_GasAnalysis_outperiod)
					   [| { share__, terminate } |] (
					   Reading::VS_O__(id__,
					   		    const_GasAnalysis_lv,
					   		    const_GasAnalysis_evadetime,
					   		    const_GasAnalysis_stuckperiod,
					   		    const_GasAnalysis_stuckdist,
					   		    const_GasAnalysis_outperiod)
					   [| { share__, terminate } |] (
					   Final::VS_O__(id__,
					   		    const_GasAnalysis_lv,
					   		    const_GasAnalysis_evadetime,
					   		    const_GasAnalysis_stuckperiod,
					   		    const_GasAnalysis_stuckdist,
					   		    const_GasAnalysis_outperiod)
					   [| { share__, terminate } |] (
					   NoGas::VS_O__(id__,
					   		    const_GasAnalysis_lv,
					   		    const_GasAnalysis_evadetime,
					   		    const_GasAnalysis_stuckperiod,
					   		    const_GasAnalysis_stuckdist,
					   		    const_GasAnalysis_outperiod)
					   [| { share__, terminate } |] (
					   GasDetected::VS_O__(id__,
					   		    const_GasAnalysis_lv,
					   		    const_GasAnalysis_evadetime,
					   		    const_GasAnalysis_stuckperiod,
					   		    const_GasAnalysis_stuckdist,
					   		    const_GasAnalysis_outperiod)
					   [| { share__, terminate } |] (
					   i0::VS_O__(id__,
					   		    const_GasAnalysis_lv,
					   		    const_GasAnalysis_evadetime,
					   		    const_GasAnalysis_stuckperiod,
					   		    const_GasAnalysis_stuckdist,
					   		    const_GasAnalysis_outperiod)
					   )
					   )
					   )
					   )
					   )
					 )
					 [[Analysis::interrupt <- x__ | x__ <- {|interrupt,internal__.NID_Analysis,internal__.NID_Analysis|}]]
					 [[Reading::interrupt <- x__ | x__ <- {|interrupt,gas__.NID_Reading.in|}]]
					 [[Final::interrupt <- x__ | x__ <- {|interrupt|}]]
					 [[NoGas::interrupt <- x__ | x__ <- {|interrupt,internal__.NID_NoGas|}]]
					 [[GasDetected::interrupt <- x__ | x__ <- {|interrupt,internal__.NID_GasDetected,internal__.NID_GasDetected|}]]
					 [[i0::interrupt <- x__ | x__ <- {|internal__.NID_i0|}]]
					 )
					  [[ share__ <- x__ | x__ <- {| share__,setR_gs |} ]] 
					  [[set_sts <- setL_sts,set_insAboveThr <- setL_insAboveThr]]
					 )
					 [| union(union(union(flowevts,transSync),{terminate}),{|share__
					 			,setL_sts
					 			,setL_insAboveThr
					 			,setR_gs
					 			|}) |]
					 ((i0::enter -> Transitions(id__,
					 		    const_GasAnalysis_lv,
					 		    const_GasAnalysis_evadetime,
					 		    const_GasAnalysis_stuckperiod,
					 		    const_GasAnalysis_stuckdist,
					 		    const_GasAnalysis_outperiod))
					  [[ share__ <- x__ | x__ <- {| share__,setL_sts,setL_insAboveThr |} ]]
					  [[set_gs <- setR_gs]]
					 )
					)[[setL_sts <- set_sts,setL_insAboveThr <- set_insAboveThr]]
					 [[setR_gs <- set_gs]]
					)
				)
				 \ hideSet)
				[[
					gas__.x____ <- gas,
					obstacle__.x____ <- obstacle,
					odometer__.x____ <- odometer,
					randomWalk__.x____ <- randomWalk,
					flag__.x____ <- flag,
					shortRandomWalk__.x____ <- shortRandomWalk,
					stop__.x____ <- stop,
					turn__.x____ <- turn,
					resume__.x____ <- resume
					| x____ <- NIDS
				]]
			)
			 [| {| interrupt |} |] SKIP)
		)
		)
	
	Behaviour_VS_O(id__,
			    const_GasAnalysis_lv,
			    const_GasAnalysis_evadetime,
			    const_GasAnalysis_stuckperiod,
			    const_GasAnalysis_stuckdist,
			    const_GasAnalysis_outperiod) = 
		dbisim((MachineBody_VS_O(id__,
				    const_GasAnalysis_lv,
				    const_GasAnalysis_evadetime,
				    const_GasAnalysis_stuckperiod,
				    const_GasAnalysis_stuckdist,
				    const_GasAnalysis_outperiod))
		)
	
	IteratedBehaviour_VS_O(id__,
			    const_GasAnalysis_lv,
			    const_GasAnalysis_evadetime,
			    const_GasAnalysis_stuckperiod,
			    const_GasAnalysis_stuckdist,
			    const_GasAnalysis_outperiod) = 
		dbisim((MachineBody_VS_O(id__,
				    const_GasAnalysis_lv,
				    const_GasAnalysis_evadetime,
				    const_GasAnalysis_stuckperiod,
				    const_GasAnalysis_stuckdist,
				    const_GasAnalysis_outperiod))
		)
	
	Stateful_VS_O(id__,
			    const_GasAnalysis_lv,
			    const_GasAnalysis_evadetime,
			    const_GasAnalysis_stuckperiod,
			    const_GasAnalysis_stuckdist,
			    const_GasAnalysis_outperiod) = 
		dbisim((
			(Behaviour_VS_O(id__,
					    const_GasAnalysis_lv,
					    const_GasAnalysis_evadetime,
					    const_GasAnalysis_stuckperiod,
					    const_GasAnalysis_stuckdist,
					    const_GasAnalysis_outperiod) [| union(getsetLocalChannels,{terminate}) |] varMemory(id__,
					    const_GasAnalysis_lv,
					    const_GasAnalysis_evadetime,
					    const_GasAnalysis_stuckperiod,
					    const_GasAnalysis_stuckdist,
					    const_GasAnalysis_outperiod))
		 	\getsetLocalChannels
		)
		)
	
	IteratedStateful_VS_O(id__,
			    const_GasAnalysis_lv,
			    const_GasAnalysis_evadetime,
			    const_GasAnalysis_stuckperiod,
			    const_GasAnalysis_stuckdist,
			    const_GasAnalysis_outperiod) =
		(dbisim(
			sbisim(
				Behaviour_VS_O(id__,
						    const_GasAnalysis_lv,
						    const_GasAnalysis_evadetime,
						    const_GasAnalysis_stuckperiod,
						    const_GasAnalysis_stuckdist,
						    const_GasAnalysis_outperiod)
				[| {|get_v,set_v,terminate|} |]
				Memory_v(0)
			)\{|get_v,set_v|}
		)
		)
	
	-- END
	
	-- Memory
	-- Memory variables
	Memory_v(v) =
		get_v!v -> Memory_v(v)
		[]
		set_v?x__ -> Memory_v(x__)
		[]
		terminate -> SKIP
	
	-- varMemory process
	varMemory(id__,
			    const_GasAnalysis_lv,
			    const_GasAnalysis_evadetime,
			    const_GasAnalysis_stuckperiod,
			    const_GasAnalysis_stuckdist,
			    const_GasAnalysis_outperiod) = Memory_v(0)
	
	getsetLocalChannels = {|get_v,set_v|}
	
	-- Definition of the behaviour of state machines (default, optimised, visible, visible and optimised)
	FVS__(id__,
			    const_GasAnalysis_lv,
			    const_GasAnalysis_evadetime,
			    const_GasAnalysis_stuckperiod,
			    const_GasAnalysis_stuckdist,
			    const_GasAnalysis_outperiod) = STM_VS_O(id__,
			    const_GasAnalysis_lv,
			    const_GasAnalysis_evadetime,
			    const_GasAnalysis_stuckperiod,
			    const_GasAnalysis_stuckdist,
			    const_GasAnalysis_outperiod)
	
	D__(id__,
			    const_GasAnalysis_lv,
			    const_GasAnalysis_evadetime,
			    const_GasAnalysis_stuckperiod,
			    const_GasAnalysis_stuckdist,
			    const_GasAnalysis_outperiod) = STM(id__,
			    const_GasAnalysis_lv,
			    const_GasAnalysis_evadetime,
			    const_GasAnalysis_stuckperiod,
			    const_GasAnalysis_stuckdist,
			    const_GasAnalysis_outperiod) \ internal_events
	O__(id__,
			    const_GasAnalysis_lv,
			    const_GasAnalysis_evadetime,
			    const_GasAnalysis_stuckperiod,
			    const_GasAnalysis_stuckdist,
			    const_GasAnalysis_outperiod) = sbisim(diamond(D__(id__,
			    const_GasAnalysis_lv,
			    const_GasAnalysis_evadetime,
			    const_GasAnalysis_stuckperiod,
			    const_GasAnalysis_stuckdist,
			    const_GasAnalysis_outperiod)))
	VS__(id__,
			    const_GasAnalysis_lv,
			    const_GasAnalysis_evadetime,
			    const_GasAnalysis_stuckperiod,
			    const_GasAnalysis_stuckdist,
			    const_GasAnalysis_outperiod) = FVS__(id__,
			    const_GasAnalysis_lv,
			    const_GasAnalysis_evadetime,
			    const_GasAnalysis_stuckperiod,
			    const_GasAnalysis_stuckdist,
			    const_GasAnalysis_outperiod)
	VS_O__(id__,
			    const_GasAnalysis_lv,
			    const_GasAnalysis_evadetime,
			    const_GasAnalysis_stuckperiod,
			    const_GasAnalysis_stuckdist,
			    const_GasAnalysis_outperiod) = sbisim(diamond(FVS__(id__,
			    const_GasAnalysis_lv,
			    const_GasAnalysis_evadetime,
			    const_GasAnalysis_stuckperiod,
			    const_GasAnalysis_stuckdist,
			    const_GasAnalysis_outperiod)))
	HEXT__(id__,
			    const_GasAnalysis_lv,
			    const_GasAnalysis_evadetime,
			    const_GasAnalysis_stuckperiod,
			    const_GasAnalysis_stuckdist,
			    const_GasAnalysis_outperiod) = O__(id__,
			    const_GasAnalysis_lv,
			    const_GasAnalysis_evadetime,
			    const_GasAnalysis_stuckperiod,
			    const_GasAnalysis_stuckdist,
			    const_GasAnalysis_outperiod) [|shared_variable_events|] SKIP
	HUP__(id__,
			    const_GasAnalysis_lv,
			    const_GasAnalysis_evadetime,
			    const_GasAnalysis_stuckperiod,
			    const_GasAnalysis_stuckdist,
			    const_GasAnalysis_outperiod) = O__(id__,
			    const_GasAnalysis_lv,
			    const_GasAnalysis_evadetime,
			    const_GasAnalysis_stuckperiod,
			    const_GasAnalysis_stuckdist,
			    const_GasAnalysis_outperiod) [|{share__}|] SKIP
	
	-- Shared memory
	-- Shared memory variables
	Memory_gs(gs) =
		get_gs!gs -> Memory_gs(gs)
		[]
		set_gs?x__ -> Memory_gs(x__)
		[]
		set_EXT_gs?x__ -> Memory_gs(x__)
		[]
		terminate -> SKIP
	Memory_sts(sts) =
		get_sts!sts -> Memory_sts(sts)
		[]
		set_sts?x__ -> Memory_sts(x__)
		[]
		set_EXT_sts?x__ -> Memory_sts(x__)
		[]
		terminate -> SKIP
	Memory_ins(ins) =
		get_ins!ins -> Memory_ins(ins)
		[]
		set_ins?x__ -> Memory_ins(x__)
		[]
		set_EXT_ins?x__ -> Memory_ins(x__)
		[]
		terminate -> SKIP
	Memory_anl(anl) =
		get_anl!anl -> Memory_anl(anl)
		[]
		set_anl?x__ -> Memory_anl(x__)
		[]
		set_EXT_anl?x__ -> Memory_anl(x__)
		[]
		terminate -> SKIP
	Memory_value(value) =
		get_value!value -> Memory_value(value)
		[]
		set_value?x__ -> Memory_value(x__)
		[]
		set_EXT_value?x__ -> Memory_value(x__)
		[]
		terminate -> SKIP
	Memory_insAboveThr(insAboveThr) =
		get_insAboveThr!insAboveThr -> Memory_insAboveThr(insAboveThr)
		[]
		set_insAboveThr?x__ -> Memory_insAboveThr(x__)
		[]
		set_EXT_insAboveThr?x__ -> Memory_insAboveThr(x__)
		[]
		terminate -> SKIP
	
	-- sharedVarMemory process
	sharedVarMemory(id__,
			    const_GasAnalysis_lv,
			    const_GasAnalysis_evadetime,
			    const_GasAnalysis_stuckperiod,
			    const_GasAnalysis_stuckdist,
			    const_GasAnalysis_outperiod) = Memory_gs(<>)
	[| { terminate } |] (
	Memory_sts(Status_noGas)
	[| { terminate } |] (
	Memory_ins((0))
	[| { terminate } |] (
	Memory_anl(Angle_Left)
	[| { terminate } |] (
	Memory_value(0)
	[| { terminate } |] (
	Memory_insAboveThr(true)
	)
	)
	)
	)
	)
	
	sharedVarSync = {|get_gs,set_gs,set_EXT_gs,get_sts,set_sts,set_EXT_sts,get_ins,set_ins,set_EXT_ins,get_anl,set_anl,set_EXT_anl,get_value,set_value,set_EXT_value,get_insAboveThr,set_insAboveThr,set_EXT_insAboveThr|}
	
	sharedVarHide = {|get_gs,get_sts,get_ins,get_anl,get_value,get_insAboveThr|}
endmodule
module Movement
exports
	transparent diamond
	transparent sbisim
	transparent dbisim
	transparent chase

	-- Transition identifiers
	-- declaring identifiers of transitions
	datatype NIDS = 
	              NID_TryingAgain|
	              NID_GettingOut|
	              NID_Final|
	              NID_Found|
	              NID_Waiting|
	              NID_Avoiding|
	              NID_Going|
	              NID_AvoidingAgain|
	              NID_i0
	
	channel internal__ : NIDS
	
	-- Flow channels		
	channel interrupt
	channel exited
	channel exit
	channel terminate
	
	-- Variable channels
	channel get_v, set_v, setL_v, setR_v: core_real
	channel get_a, set_a, setL_a, setR_a: Angle
	channel get_d0, set_d0, setL_d0, setR_d0: core_real
	channel get_d1, set_d1, setL_d1, setR_d1: core_real
	channel get_l, set_l, setL_l, setR_l: Loc
	
	-- Shared variable channels
	channel set_EXT_a: Angle
	channel set_EXT_d0: core_real
	channel set_EXT_d1: core_real
	channel set_EXT_l: Loc
	
	-- Local variable channels for defined operations that are required by the state machine
	
	-- Declaring state machine events
	channel gas__: NIDS.InOut.LSeq(GasSensor,2)
	channel gas: InOut.LSeq(GasSensor,2)
	channel obstacle__: NIDS.InOut.Loc
	channel obstacle: InOut.Loc
	channel odometer__: NIDS.InOut.core_real
	channel odometer: InOut.core_real
	channel randomWalk__: NIDS.InOut
	channel randomWalk: InOut
	channel flag__: NIDS.InOut
	channel flag: InOut
	channel shortRandomWalk__: NIDS.InOut
	channel shortRandomWalk: InOut
	channel stop__: NIDS.InOut
	channel stop: InOut
	channel turn__: NIDS.InOut.Angle
	channel turn: InOut.Angle
	channel resume__: NIDS.InOut
	channel resume: InOut
	
	-- Declaring call and ret events for undefined operations
	channel moveCall: core_real.Angle
	
	enterSS = {|
	TryingAgain::enter,
	GettingOut::enter,
	Final::enter,
	Found::enter,
	Waiting::enter,
	Avoiding::enter,
	Going::enter,
	AvoidingAgain::enter,
	i0::enter
	|}
	
	enteredSS = 	{|
	TryingAgain::entered,
	GettingOut::entered,
	Final::entered,
	Found::entered,
	Waiting::entered,
	Avoiding::entered,
	Going::entered,
	AvoidingAgain::entered
	|}
	
	internal_events = union(enteredSS,union(enterSS,{|interrupt,exited|}))
	
	shared_variable_events = {|
		set_EXT_a,
		set_EXT_d0,
		set_EXT_d1,
		set_EXT_l
	|}
	
	-- channel set with all visible events
	sem__events = {|
		terminate
	,	set_EXT_a, set_a,
		set_EXT_d0, set_d0,
		set_EXT_d1, set_d1,
		set_EXT_l, set_l
	,	gas,
		obstacle,
		odometer,
		randomWalk,
		flag,
		shortRandomWalk,
		stop,
		turn,
		resume
	,	moveCall
		|}

	-- Nodes --
	-- declaring all nodes
	
	----------------------------------------------------------------------
	-- State: TryingAgain
	module TryingAgain
	
	enterSS = {}
	
	enteredSS = {}
	
	exports
	
		--  Declarations
		
		channel enter, entered, interrupt
		channel enteredL, enteredR
		
						
		
		--	Nodes
		-- declaring all nodes
		
		
		--	Rule: behaviours(Node)
		--  Note that FDR has problems with efficiently compiling the process below
		-- 	if using a different recursion pattern.
		D__(id__,
				    const_Movement_lv,
				    const_Movement_evadetime,
				    const_Movement_stuckperiod,
				    const_Movement_stuckdist,
				    const_Movement_outperiod) = 
		dbisim(let
			-- IMPLEMENTATION NOTE: 
			-- The following should be defined as: Inactive = share__choice(Activation [] Termination),
			-- however FDR struggles with that form in certain cases. So we use the exception operator
			-- instead to 'terminate'.
			
			Inactive 	= share__choice(enter -> SKIP [] terminate -> SKIP) ; Active
			
			Termination = terminate -> SKIP
			
			Active 		= share__choice(get_a?a -> true&CALL__move(
						id__,
					    const_Movement_lv,
					    const_Movement_evadetime,
					    const_Movement_stuckperiod,
					    const_Movement_stuckdist,
					    const_Movement_outperiod,
						const_Movement_lv,
						a
					)) ; 
					 	  Behaviour ; 
					 	  share__choice(exit -> SKIP) ; SKIP ; 
					 	  share__choice(exited -> SKIP) ; Inactive
		
			Behaviour 	= entered -> During
			During 		= ((SKIP ; SStop) /\ interrupt -> SKIP)
		within
			Inactive [| {terminate} |> SKIP)
			
		VS_O__(id__,
				    const_Movement_lv,
				    const_Movement_evadetime,
				    const_Movement_stuckperiod,
				    const_Movement_stuckdist,
				    const_Movement_outperiod) = 
		dbisim(let
			Inactive 	= share__choice(enter -> SKIP [] terminate -> SKIP) ; Active
			
			Termination = terminate -> SKIP
			
			Active 		= share__choice(get_a?a -> true&CALL__move(
						id__,
					    const_Movement_lv,
					    const_Movement_evadetime,
					    const_Movement_stuckperiod,
					    const_Movement_stuckdist,
					    const_Movement_outperiod,
						const_Movement_lv,
						a
					)) ; 
					 	  Behaviour ; 
					 	  share__choice(exit -> SKIP) ; SKIP ; 
					 	  share__choice(exited -> SKIP) ; Inactive
		
			Behaviour 	= entered -> During
			During 		= ((SKIP ; SStop) /\ interrupt -> SKIP)
		within
			Inactive [| {terminate} |> SKIP)
		
	
	endmodule
	----------------------------------------------------------------------
	
	
	----------------------------------------------------------------------
	-- State: GettingOut
	module GettingOut
	
	enterSS = {}
	
	enteredSS = {}
	
	exports
	
		--  Declarations
		
		channel enter, entered, interrupt
		channel enteredL, enteredR
		
						
		
		--	Nodes
		-- declaring all nodes
		
		
		--	Rule: behaviours(Node)
		--  Note that FDR has problems with efficiently compiling the process below
		-- 	if using a different recursion pattern.
		D__(id__,
				    const_Movement_lv,
				    const_Movement_evadetime,
				    const_Movement_stuckperiod,
				    const_Movement_stuckdist,
				    const_Movement_outperiod) = 
		dbisim(let
			-- IMPLEMENTATION NOTE: 
			-- The following should be defined as: Inactive = share__choice(Activation [] Termination),
			-- however FDR struggles with that form in certain cases. So we use the exception operator
			-- instead to 'terminate'.
			
			Inactive 	= share__choice(enter -> SKIP [] terminate -> SKIP) ; Active
			
			Termination = terminate -> SKIP
			
			Active 		= true&(share__choice(shortRandomWalk.out -> SKIP));SKIP ; 
					 	  Behaviour ; 
					 	  share__choice(exit -> SKIP) ; SKIP ; 
					 	  share__choice(exited -> SKIP) ; Inactive
		
			Behaviour 	= entered -> During
			During 		= ((SKIP ; SStop) /\ interrupt -> SKIP)
		within
			Inactive [| {terminate} |> SKIP)
			
		VS_O__(id__,
				    const_Movement_lv,
				    const_Movement_evadetime,
				    const_Movement_stuckperiod,
				    const_Movement_stuckdist,
				    const_Movement_outperiod) = 
		dbisim(let
			Inactive 	= share__choice(enter -> SKIP [] terminate -> SKIP) ; Active
			
			Termination = terminate -> SKIP
			
			Active 		= true&(share__choice(shortRandomWalk.out -> SKIP));SKIP ; 
					 	  Behaviour ; 
					 	  share__choice(exit -> SKIP) ; SKIP ; 
					 	  share__choice(exited -> SKIP) ; Inactive
		
			Behaviour 	= entered -> During
			During 		= ((SKIP ; SStop) /\ interrupt -> SKIP)
		within
			Inactive [| {terminate} |> SKIP)
		
	
	endmodule
	----------------------------------------------------------------------
	
	
	----------------------------------------------------------------------
	-- State: Final
	module Final
	
	enterSS = {}
	
	enteredSS = {}
	
	exports
	
		--  Declarations
		
		channel enter, entered, interrupt
		channel enteredL, enteredR
		
						
		
		--	Nodes
		-- declaring all nodes
		
		
		--	Rule: behaviours(Node)
		--  Note that FDR has problems with efficiently compiling the process below
		-- 	if using a different recursion pattern.
		D__(id__,
				    const_Movement_lv,
				    const_Movement_evadetime,
				    const_Movement_stuckperiod,
				    const_Movement_stuckdist,
				    const_Movement_outperiod) = 
		dbisim(let
			-- IMPLEMENTATION NOTE: 
			-- The following should be defined as: Inactive = share__choice(Activation [] Termination),
