						    const_GasAnalysisController_stuckdist,
						    const_GasAnalysisController_outperiod) = 
				dbisim(let
					Inactive 	= share__choice(enter -> SKIP [] terminate -> SKIP) ; Active
					
					Termination = terminate -> SKIP
					
					Active 		= share__choice(get_gs?gs -> true&(share__choice(update.out!gs -> SKIP)));share__choice(get_gs?gs -> true&(share__choice(setInput.out!gs -> SKIP)));true&(share__choice(compute.out -> SKIP));share__choice(share__choice(get_sts?sts -> true & (share__choice(set_sts!sts -> SKIP)))) ; 
