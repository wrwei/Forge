            <statement xsi:type="spoon:CtLocalVariable" name="t">
              <type name="Turn">
                <declaringType name="SystemEvent">
                  <packageRef isImplicit="true" name="chemical_detector.event"/>
                </declaringType>
              </type>
              <assignment xsi:type="spoon:CtVariableRead">
                <type name="SystemEvent">
                  <packageRef name="chemical_detector.event"/>
                </type>
                <cast name="Turn">
                  <declaringType name="SystemEvent">
                    <packageRef isImplicit="true" name="chemical_detector.event"/>
                  </declaringType>
                </cast>
                <variable xsi:type="spoon:CtParameterReference" name="signal"/>
              </assignment>
            </statement>
            <statement xsi:type="spoon:CtAssignment">
              <type name="Angle">
                <packageRef name="chemical_detector.data"/>
              </type>
              <assignment xsi:type="spoon:CtInvocation">
                <type name="Angle">
                  <packageRef name="chemical_detector.data"/>
                </type>
                <target xsi:type="spoon:CtVariableRead">
                  <type name="Turn">
                    <declaringType name="SystemEvent">
                      <packageRef name="chemical_detector.event"/>
                    </declaringType>
                  </type>
                  <variable xsi:type="spoon:CtLocalVariableReference" name="t"/>
                </target>
                <executableRef name="a">
                  <declaringType name="Turn">
                    <declaringType name="SystemEvent">
                      <packageRef name="chemical_detector.event"/>
                    </declaringType>
                  </declaringType>
                </executableRef>
              </assignment>
              <assigned xsi:type="spoon:CtFieldWrite">
                <type name="Angle">
                  <packageRef name="chemical_detector.data"/>
                </type>
                <target xsi:type="spoon:CtThisAccess">
