                  <declaringType name="Emitter">
                    <packageRef name="chemical_detector.actuator"/>
                  </declaringType>
                </variable>
              </assigned>
            </statement>
          </then>
        </statement>
      </body>
      <type name="void"/>
      <parameter name="signal">
        <type name="SystemEvent">
          <packageRef isImplicit="true" name="chemical_detector.event"/>
        </type>
      </parameter>
