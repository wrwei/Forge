		Trans = share__choice(get_d0?d0 -> get_d1?d1 -> (
			((share__ -> SKIP
			 [] dbisim((true)&(internal__!NID_i0 -> SKIP ;  ((SKIP ; WAITING::enter -> SKIP))))
			 	 [] dbisim((true)&(stop__!NID_WAITING.in -> SKIP ;  share__choice(exit -> SKIP) ; (share__choice(exited -> SKIP) ; SKIP ; FOUND::enter -> SKIP)))
			 	 [] dbisim((true)&(resume__!NID_WAITING.in -> SKIP ;  share__choice(exit -> SKIP) ; (share__choice(exited -> SKIP) ; SKIP ; WAITING::enter -> SKIP)))
			 	 [] dbisim((true)&(turn__!NID_WAITING.in?a:{a|a <- Angle, true} -> share__choice(set_a!a -> SKIP) ;  share__choice(exit -> SKIP) ; (share__choice(exited -> SKIP) ; SKIP ; GOING::enter -> SKIP)))
			 	 [] dbisim((true)&(stop__!NID_GOING.in -> SKIP ;  share__choice(exit -> SKIP) ; (share__choice(exited -> SKIP) ; SKIP ; FOUND::enter -> SKIP)))
			 	 [] dbisim((true)&(resume__!NID_GOING.in -> SKIP ;  share__choice(exit -> SKIP) ; (share__choice(exited -> SKIP) ; SKIP ; WAITING::enter -> SKIP)))
			 	 [] dbisim((true)&(turn__!NID_GOING.in?a:{a|a <- Angle, true} -> share__choice(set_a!a -> SKIP) ;  share__choice(exit -> SKIP) ; (share__choice(exited -> SKIP) ; SKIP ; GOING::enter -> SKIP)))
			 	 [] dbisim((true)&(obstacle__!NID_GOING.in?l:{l|l <- Loc, true} -> share__choice(set_l!l -> SKIP) ;  share__choice(exit -> SKIP) ; (share__choice(exited -> SKIP) ; SKIP ; AVOIDING::enter -> SKIP)))
			 	 [] dbisim((true)&(stop__!NID_AVOIDING.in -> SKIP ;  share__choice(exit -> SKIP) ; (share__choice(exited -> SKIP) ; SKIP ; FOUND::enter -> SKIP)))
			 	 [] dbisim((true)&(resume__!NID_AVOIDING.in -> SKIP ;  share__choice(exit -> SKIP) ; (share__choice(exited -> SKIP) ; SKIP ; WAITING::enter -> SKIP)))
			 	 [] dbisim((true)&(turn__!NID_AVOIDING.in?a:{a|a <- Angle, true} -> share__choice(set_a!a -> SKIP) ;  share__choice(exit -> SKIP) ; (share__choice(exited -> SKIP) ; SKIP ; TRYING_AGAIN::enter -> SKIP)))
			 	 [] dbisim((true)&(stop__!NID_TRYING_AGAIN.in -> SKIP ;  share__choice(exit -> SKIP) ; (share__choice(exited -> SKIP) ; SKIP ; FOUND::enter -> SKIP)))
			 	 [] dbisim((true)&(resume__!NID_TRYING_AGAIN.in -> SKIP ;  share__choice(exit -> SKIP) ; (share__choice(exited -> SKIP) ; SKIP ; WAITING::enter -> SKIP)))
			 	 [] dbisim((true)&(turn__!NID_TRYING_AGAIN.in?a:{a|a <- Angle, true} -> share__choice(set_a!a -> SKIP) ;  share__choice(exit -> SKIP) ; (share__choice(exited -> SKIP) ; SKIP ; TRYING_AGAIN::enter -> SKIP)))
			 	 [] dbisim((true)&(obstacle__!NID_TRYING_AGAIN.in?l:{l|l <- Loc, true} -> share__choice(set_l!l -> SKIP) ;  share__choice(exit -> SKIP) ; (share__choice(exited -> SKIP) ; SKIP ; AVOIDING_AGAIN::enter -> SKIP)))
			 	 [] dbisim((true)&(stop__!NID_AVOIDING_AGAIN.in -> SKIP ;  share__choice(exit -> SKIP) ; (share__choice(exited -> SKIP) ; SKIP ; FOUND::enter -> SKIP)))
			 	 [] dbisim((true)&(resume__!NID_AVOIDING_AGAIN.in -> SKIP ;  share__choice(exit -> SKIP) ; (share__choice(exited -> SKIP) ; SKIP ; WAITING::enter -> SKIP)))
			 	 [] dbisim((true)&(internal__!NID_AVOIDING_AGAIN -> SKIP ;  share__choice(exit -> SKIP) ; (share__choice(exited -> SKIP) ; SKIP ; AVOIDING::enter -> SKIP)))
			 	 [] dbisim((true)&(internal__!NID_AVOIDING_AGAIN -> SKIP ;  share__choice(exit -> SKIP) ; (share__choice(exited -> SKIP) ; SKIP ; GETTING_OUT::enter -> SKIP)))
			 	 [] dbisim((true)&(stop__!NID_GETTING_OUT.in -> SKIP ;  share__choice(exit -> SKIP) ; (share__choice(exited -> SKIP) ; SKIP ; FOUND::enter -> SKIP)))
			 	 [] dbisim((true)&(resume__!NID_GETTING_OUT.in -> SKIP ;  share__choice(exit -> SKIP) ; (share__choice(exited -> SKIP) ; SKIP ; WAITING::enter -> SKIP)))
			 	 [] dbisim((true)&(turn__!NID_GETTING_OUT.in?a:{a|a <- Angle, true} -> share__choice(set_a!a -> SKIP) ;  share__choice(exit -> SKIP) ; (share__choice(exited -> SKIP) ; SKIP ; GOING::enter -> SKIP)))
			 	 [] dbisim((true)&(internal__!NID_FOUND -> SKIP ;  share__choice(exit -> SKIP) ; (share__choice(exited -> SKIP) ; SKIP ; HALTED::enter -> SKIP)))
			 	 [] dbisim((true)&(stop__!NID_HALTED.in -> SKIP ;  share__choice(exit -> SKIP) ; (share__choice(exited -> SKIP) ; SKIP ; HALTED::enter -> SKIP)))
			 ) ; Trans)
			 []
			 (interrupt -> share__choice(exit -> SKIP) ; share__choice(exited -> terminate -> SKIP))
			 []
			 terminate -> SKIP
