								stm_ref0::set_EXT_a,stm_ref0::set_EXT_l,stm_ref0::set_EXT_d0,stm_ref0::set_EXT_d1,stm_ref0::set_EXT_odometer
							|}
						)
					|]
				dbisim(Memory(id__, Angle_Left, Loc_left, 0, 0, 0, const_MovementController_Ctrl_thr, const_MovementController_Ctrl_lv, const_MovementController_Ctrl_evadeTime, const_MovementController_Ctrl_stuckPeriod, const_MovementController_Ctrl_stuckDist, const_MovementController_Ctrl_outPeriod))
			)
