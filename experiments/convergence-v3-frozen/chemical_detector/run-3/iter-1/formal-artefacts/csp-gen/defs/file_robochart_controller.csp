			    const_GasAnalysisController_stuckDist,
			    const_GasAnalysisController_outPeriod)
	VS_O__(id__,
			    const_GasAnalysisController_thr,
			    const_GasAnalysisController_lv,
			    const_GasAnalysisController_evadeTime,
			    const_GasAnalysisController_stuckPeriod,
			    const_GasAnalysisController_stuckDist,
			    const_GasAnalysisController_outPeriod) = sbisim(diamond(FVS__(id__,
			    const_GasAnalysisController_thr,
			    const_GasAnalysisController_lv,
			    const_GasAnalysisController_evadeTime,
			    const_GasAnalysisController_stuckPeriod,
			    const_GasAnalysisController_stuckDist,
			    const_GasAnalysisController_outPeriod)))
	HEXT__(id__,
			    const_GasAnalysisController_thr,
			    const_GasAnalysisController_lv,
			    const_GasAnalysisController_evadeTime,
			    const_GasAnalysisController_stuckPeriod,
			    const_GasAnalysisController_stuckDist,
			    const_GasAnalysisController_outPeriod) = O__(id__,
			    const_GasAnalysisController_thr,
			    const_GasAnalysisController_lv,
			    const_GasAnalysisController_evadeTime,
			    const_GasAnalysisController_stuckPeriod,
			    const_GasAnalysisController_stuckDist,
			    const_GasAnalysisController_outPeriod) [|shared_variable_events|] SKIP
	HUP__(id__,
			    const_GasAnalysisController_thr,
			    const_GasAnalysisController_lv,
			    const_GasAnalysisController_evadeTime,
			    const_GasAnalysisController_stuckPeriod,
			    const_GasAnalysisController_stuckDist,
			    const_GasAnalysisController_outPeriod) = O__(id__,
			    const_GasAnalysisController_thr,
			    const_GasAnalysisController_lv,
			    const_GasAnalysisController_evadeTime,
			    const_GasAnalysisController_stuckPeriod,
			    const_GasAnalysisController_stuckDist,
			    const_GasAnalysisController_outPeriod) [|{share__}|] SKIP
	
	-- Shared memory
	-- Shared memory variables
	Memory_gs(gs) =
		get_gs!gs -> Memory_gs(gs)
		[]
		set_gs?x__ -> Memory_gs(x__)
		[]
		set_EXT_gs?x__ -> Memory_gs(x__)
		[]
		terminate -> SKIP
	Memory_sts(sts) =
		get_sts!sts -> Memory_sts(sts)
		[]
		set_sts?x__ -> Memory_sts(x__)
		[]
		set_EXT_sts?x__ -> Memory_sts(x__)
		[]
		terminate -> SKIP
	Memory_ins(ins) =
		get_ins!ins -> Memory_ins(ins)
		[]
		set_ins?x__ -> Memory_ins(x__)
		[]
		set_EXT_ins?x__ -> Memory_ins(x__)
		[]
		terminate -> SKIP
	Memory_anl(anl) =
		get_anl!anl -> Memory_anl(anl)
		[]
		set_anl?x__ -> Memory_anl(x__)
		[]
		set_EXT_anl?x__ -> Memory_anl(x__)
		[]
		terminate -> SKIP
	
	-- sharedVarMemory process
	sharedVarMemory(id__,
			    const_GasAnalysisController_thr,
			    const_GasAnalysisController_lv,
			    const_GasAnalysisController_evadeTime,
			    const_GasAnalysisController_stuckPeriod,
			    const_GasAnalysisController_stuckDist,
			    const_GasAnalysisController_outPeriod) = Memory_gs(<>)
	[| { terminate } |] (
	Memory_sts(Status_noGas)
	[| { terminate } |] (
	Memory_ins(0)
	[| { terminate } |] (
	Memory_anl(Angle_Left)
	)
	)
	)
	
	sharedVarSync = {|get_gs,set_gs,set_EXT_gs,get_sts,set_sts,set_EXT_sts,get_ins,set_ins,set_EXT_ins,get_anl,set_anl,set_EXT_anl|}
	
	sharedVarHide = {|get_gs,get_sts,get_ins,get_anl|}
endmodule
module MovementController
exports
	transparent diamond
	transparent sbisim
	transparent dbisim
	transparent chase

	-- Transition identifiers
	-- declaring identifiers of transitions
	datatype NIDS = 
	              NID_WAITING|
	              NID_GETTING_OUT|
	              NID_AVOIDING|
	              NID_AVOIDING_AGAIN|
	              NID_TRYING_AGAIN|
	              NID_FOUND|
	              NID_HALTED|
	              NID_GOING|
	              NID_i0
	
	channel internal__ : NIDS
	
	-- Flow channels		
	channel interrupt
	channel exited
	channel exit
	channel terminate
	
	-- Variable channels
	channel get_v, set_v, setL_v, setR_v: core_real
	channel get_a, set_a, setL_a, setR_a: Angle
	channel get_l, set_l, setL_l, setR_l: Loc
	channel get_d0, set_d0, setL_d0, setR_d0: core_real
	channel get_d1, set_d1, setL_d1, setR_d1: core_real
	channel get_odometer, set_odometer, setL_odometer, setR_odometer: core_real
	
	-- Shared variable channels
	channel set_EXT_a: Angle
	channel set_EXT_l: Loc
	channel set_EXT_d0: core_real
	channel set_EXT_d1: core_real
	channel set_EXT_odometer: core_real
	
	-- Local variable channels for defined operations that are required by the state machine
	
	-- Declaring state machine events
	channel gas__: NIDS.InOut.LSeq(GasSensor,2)
	channel gas: InOut.LSeq(GasSensor,2)
	channel obstacle__: NIDS.InOut.Loc
	channel obstacle: InOut.Loc
	channel randomWalk__: NIDS.InOut
	channel randomWalk: InOut
	channel flag__: NIDS.InOut
	channel flag: InOut
	channel changeDirection__: NIDS.InOut.Loc
	channel changeDirection: InOut.Loc
	channel shortRandomWalk__: NIDS.InOut
	channel shortRandomWalk: InOut
	channel stop__: NIDS.InOut
	channel stop: InOut
	channel resume__: NIDS.InOut
	channel resume: InOut
	channel turn__: NIDS.InOut.Angle
	channel turn: InOut.Angle
	
	-- Declaring call and ret events for undefined operations
	channel moveCall: core_real.Angle
	
	enterSS = {|
	WAITING::enter,
	GETTING_OUT::enter,
	AVOIDING::enter,
	AVOIDING_AGAIN::enter,
	TRYING_AGAIN::enter,
	FOUND::enter,
	HALTED::enter,
	GOING::enter,
	i0::enter
	|}
	
	enteredSS = 	{|
	WAITING::entered,
	GETTING_OUT::entered,
	AVOIDING::entered,
	AVOIDING_AGAIN::entered,
	TRYING_AGAIN::entered,
	FOUND::entered,
	HALTED::entered,
	GOING::entered
	|}
	
	internal_events = union(enteredSS,union(enterSS,{|interrupt,exited|}))
	
	shared_variable_events = {|
		set_EXT_a,
		set_EXT_l,
		set_EXT_d0,
		set_EXT_d1,
		set_EXT_odometer
	|}
	
	-- channel set with all visible events
	sem__events = {|
		terminate
	,	set_EXT_a, set_a,
		set_EXT_l, set_l,
		set_EXT_d0, set_d0,
		set_EXT_d1, set_d1,
		set_EXT_odometer, set_odometer
	,	gas,
		obstacle,
		randomWalk,
		flag,
		changeDirection,
		shortRandomWalk,
		stop,
		resume,
		turn
	,	moveCall
		|}

	-- Nodes --
	-- declaring all nodes
	
	----------------------------------------------------------------------
	-- State: WAITING
	module WAITING
	
	enterSS = {}
	
	enteredSS = {}
	
	exports
	
		--  Declarations
		
		channel enter, entered, interrupt
		channel enteredL, enteredR
		
						
		
		--	Nodes
		-- declaring all nodes
		
		
		--	Rule: behaviours(Node)
		--  Note that FDR has problems with efficiently compiling the process below
		-- 	if using a different recursion pattern.
		D__(id__,
				    const_MovementController_thr,
				    const_MovementController_lv,
				    const_MovementController_evadeTime,
				    const_MovementController_stuckPeriod,
				    const_MovementController_stuckDist,
				    const_MovementController_outPeriod) = 
		dbisim(let
			-- IMPLEMENTATION NOTE: 
			-- The following should be defined as: Inactive = share__choice(Activation [] Termination),
			-- however FDR struggles with that form in certain cases. So we use the exception operator
			-- instead to 'terminate'.
			
			Inactive 	= share__choice(enter -> SKIP [] terminate -> SKIP) ; Active
			
			Termination = terminate -> SKIP
			
			Active 		= true&(share__choice(randomWalk.out -> SKIP)) ; 
					 	  Behaviour ; 
					 	  share__choice(exit -> SKIP) ; SKIP ; 
					 	  share__choice(exited -> SKIP) ; Inactive
		
			Behaviour 	= entered -> During
			During 		= ((SKIP ; SStop) /\ interrupt -> SKIP)
		within
			Inactive [| {terminate} |> SKIP)
			
		VS_O__(id__,
				    const_MovementController_thr,
				    const_MovementController_lv,
				    const_MovementController_evadeTime,
				    const_MovementController_stuckPeriod,
				    const_MovementController_stuckDist,
