						const_MovementController_stuckPeriod = const_MovementController_Ctrl_stuckPeriod
						const_MovementController_stuckDist = const_MovementController_Ctrl_stuckDist
						const_MovementController_outPeriod = const_MovementController_Ctrl_outPeriod
					within 
