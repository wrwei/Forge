				|}
			)
			[|{|terminate|}|>SKIP
			))
							
			-- VS_O version
			VS_O__(id__,
					    const_MovementController_Ctrl_thr,
					    const_MovementController_Ctrl_lv,
					    const_MovementController_Ctrl_evadeTime,
					    const_MovementController_Ctrl_stuckPeriod,
					    const_MovementController_Ctrl_stuckDist,
					    const_MovementController_Ctrl_outPeriod) = sbisim(diamond(	((
