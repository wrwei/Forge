				-- Transition identifiers
				-- declaring identifiers of transitions
				datatype NIDS = 
				              NID_WAITING|
				              NID_GETTING_OUT|
				              NID_AVOIDING|
				              NID_AVOIDING_AGAIN|
				              NID_TRYING_AGAIN|
				              NID_FOUND|
