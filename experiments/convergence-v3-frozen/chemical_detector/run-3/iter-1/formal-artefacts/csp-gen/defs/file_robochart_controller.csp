					 [[GETTING_OUT::interrupt <- x__ | x__ <- {|interrupt,stop__.NID_GETTING_OUT.in,resume__.NID_GETTING_OUT.in,turn__.NID_GETTING_OUT.in|}]]
					 [[AVOIDING::interrupt <- x__ | x__ <- {|interrupt,stop__.NID_AVOIDING.in,resume__.NID_AVOIDING.in,turn__.NID_AVOIDING.in|}]]
					 [[AVOIDING_AGAIN::interrupt <- x__ | x__ <- {|interrupt,stop__.NID_AVOIDING_AGAIN.in,resume__.NID_AVOIDING_AGAIN.in,internal__.NID_AVOIDING_AGAIN,internal__.NID_AVOIDING_AGAIN|}]]
					 [[TRYING_AGAIN::interrupt <- x__ | x__ <- {|interrupt,stop__.NID_TRYING_AGAIN.in,resume__.NID_TRYING_AGAIN.in,turn__.NID_TRYING_AGAIN.in,obstacle__.NID_TRYING_AGAIN.in|}]]
					 [[FOUND::interrupt <- x__ | x__ <- {|interrupt,internal__.NID_FOUND|}]]
					 [[HALTED::interrupt <- x__ | x__ <- {|interrupt,stop__.NID_HALTED.in|}]]
					 [[GOING::interrupt <- x__ | x__ <- {|interrupt,stop__.NID_GOING.in,resume__.NID_GOING.in,turn__.NID_GOING.in,obstacle__.NID_GOING.in|}]]
					 [[i0::interrupt <- x__ | x__ <- {|internal__.NID_i0|}]]
					 )
					  [[ share__ <- x__ | x__ <- {| share__,setR_l,setR_a |} ]] 
					  [[set_d0 <- setL_d0,set_d1 <- setL_d1]]
					 )
					 [| union(union(union(flowevts,transSync),{terminate}),{|share__
					 			,setL_d0
					 			,setL_d1
					 			,setR_l
