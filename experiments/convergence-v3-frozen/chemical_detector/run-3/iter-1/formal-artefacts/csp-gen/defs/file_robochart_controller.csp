		within
			((let
				-- IMPLEMENTATION NOTE:
				-- Here the 'enter' channel set is calculated explicitly because of the use of CSPM 
				-- modules for defining the semantics of each node.
				enterSS = {|
				WAITING::enter,
				GETTING_OUT::enter,
				AVOIDING::enter,
				AVOIDING_AGAIN::enter,
				TRYING_AGAIN::enter,
				FOUND::enter,
				HALTED::enter,
				GOING::enter,
				i0::enter
				|}
				hideSet = union(enterSS,{|exit,exited,internal__|})
			within 
				((let
					-- IMPLEMENTATION NOTE: the channel set 'enter' is calculated explicitly
					-- because CSPM modules are used for the semantics of Node.
					flowevts = union(enterSS,{|exit,exited,interrupt|})
					transSync = {|internal__.NID_i0,stop__.NID_WAITING.in,resume__.NID_WAITING.in,turn__.NID_WAITING.in,stop__.NID_GOING.in,resume__.NID_GOING.in,turn__.NID_GOING.in,obstacle__.NID_GOING.in,stop__.NID_AVOIDING.in,resume__.NID_AVOIDING.in,turn__.NID_AVOIDING.in,stop__.NID_TRYING_AGAIN.in,resume__.NID_TRYING_AGAIN.in,turn__.NID_TRYING_AGAIN.in,obstacle__.NID_TRYING_AGAIN.in,stop__.NID_AVOIDING_AGAIN.in,resume__.NID_AVOIDING_AGAIN.in,internal__.NID_AVOIDING_AGAIN,internal__.NID_AVOIDING_AGAIN,stop__.NID_GETTING_OUT.in,resume__.NID_GETTING_OUT.in,turn__.NID_GETTING_OUT.in,internal__.NID_FOUND,stop__.NID_HALTED.in|}
				within
					((
					 (((-- RULE composeNodes(nc:NodeContainer)^nops : CSPProcess
					   WAITING::VS_O__(id__,
					   		    const_MovementController_thr,
					   		    const_MovementController_lv,
					   		    const_MovementController_evadeTime,
					   		    const_MovementController_stuckPeriod,
					   		    const_MovementController_stuckDist,
					   		    const_MovementController_outPeriod)
					   [| { share__, terminate } |] (
					   GETTING_OUT::VS_O__(id__,
					   		    const_MovementController_thr,
					   		    const_MovementController_lv,
					   		    const_MovementController_evadeTime,
					   		    const_MovementController_stuckPeriod,
					   		    const_MovementController_stuckDist,
					   		    const_MovementController_outPeriod)
					   [| { share__, terminate } |] (
					   AVOIDING::VS_O__(id__,
					   		    const_MovementController_thr,
					   		    const_MovementController_lv,
					   		    const_MovementController_evadeTime,
					   		    const_MovementController_stuckPeriod,
					   		    const_MovementController_stuckDist,
					   		    const_MovementController_outPeriod)
					   [| { share__, terminate } |] (
					   AVOIDING_AGAIN::VS_O__(id__,
					   		    const_MovementController_thr,
					   		    const_MovementController_lv,
					   		    const_MovementController_evadeTime,
					   		    const_MovementController_stuckPeriod,
					   		    const_MovementController_stuckDist,
					   		    const_MovementController_outPeriod)
					   [| { share__, terminate } |] (
					   TRYING_AGAIN::VS_O__(id__,
					   		    const_MovementController_thr,
					   		    const_MovementController_lv,
					   		    const_MovementController_evadeTime,
					   		    const_MovementController_stuckPeriod,
					   		    const_MovementController_stuckDist,
					   		    const_MovementController_outPeriod)
					   [| { share__, terminate } |] (
					   FOUND::VS_O__(id__,
					   		    const_MovementController_thr,
					   		    const_MovementController_lv,
					   		    const_MovementController_evadeTime,
					   		    const_MovementController_stuckPeriod,
					   		    const_MovementController_stuckDist,
					   		    const_MovementController_outPeriod)
					   [| { share__, terminate } |] (
					   HALTED::VS_O__(id__,
					   		    const_MovementController_thr,
					   		    const_MovementController_lv,
					   		    const_MovementController_evadeTime,
					   		    const_MovementController_stuckPeriod,
					   		    const_MovementController_stuckDist,
					   		    const_MovementController_outPeriod)
					   [| { share__, terminate } |] (
					   GOING::VS_O__(id__,
					   		    const_MovementController_thr,
					   		    const_MovementController_lv,
					   		    const_MovementController_evadeTime,
					   		    const_MovementController_stuckPeriod,
					   		    const_MovementController_stuckDist,
					   		    const_MovementController_outPeriod)
					   [| { share__, terminate } |] (
					   i0::VS_O__(id__,
					   		    const_MovementController_thr,
					   		    const_MovementController_lv,
					   		    const_MovementController_evadeTime,
					   		    const_MovementController_stuckPeriod,
					   		    const_MovementController_stuckDist,
					   		    const_MovementController_outPeriod)
					   )
					   )
					   )
					   )
					   )
					   )
					   )
					   )
					 )
					 [[WAITING::interrupt <- x__ | x__ <- {|interrupt,stop__.NID_WAITING.in,resume__.NID_WAITING.in,turn__.NID_WAITING.in|}]]
					 [[GETTING_OUT::interrupt <- x__ | x__ <- {|interrupt,stop__.NID_GETTING_OUT.in,resume__.NID_GETTING_OUT.in,turn__.NID_GETTING_OUT.in|}]]
					 [[AVOIDING::interrupt <- x__ | x__ <- {|interrupt,stop__.NID_AVOIDING.in,resume__.NID_AVOIDING.in,turn__.NID_AVOIDING.in|}]]
					 [[AVOIDING_AGAIN::interrupt <- x__ | x__ <- {|interrupt,stop__.NID_AVOIDING_AGAIN.in,resume__.NID_AVOIDING_AGAIN.in,internal__.NID_AVOIDING_AGAIN,internal__.NID_AVOIDING_AGAIN|}]]
					 [[TRYING_AGAIN::interrupt <- x__ | x__ <- {|interrupt,stop__.NID_TRYING_AGAIN.in,resume__.NID_TRYING_AGAIN.in,turn__.NID_TRYING_AGAIN.in,obstacle__.NID_TRYING_AGAIN.in|}]]
					 [[FOUND::interrupt <- x__ | x__ <- {|interrupt,internal__.NID_FOUND|}]]
					 [[HALTED::interrupt <- x__ | x__ <- {|interrupt,stop__.NID_HALTED.in|}]]
					 [[GOING::interrupt <- x__ | x__ <- {|interrupt,stop__.NID_GOING.in,resume__.NID_GOING.in,turn__.NID_GOING.in,obstacle__.NID_GOING.in|}]]
					 [[i0::interrupt <- x__ | x__ <- {|internal__.NID_i0|}]]
					 )
					  [[ share__ <- x__ | x__ <- {| share__,setR_l,setR_a |} ]] 
					  [[set_d0 <- setL_d0,set_d1 <- setL_d1]]
					 )
					 [| union(union(union(flowevts,transSync),{terminate}),{|share__
					 			,setL_d0
					 			,setL_d1
					 			,setR_l
					 			 			,setR_a
					 			|}) |]
					 ((i0::enter -> Transitions(id__,
					 		    const_MovementController_thr,
					 		    const_MovementController_lv,
					 		    const_MovementController_evadeTime,
					 		    const_MovementController_stuckPeriod,
					 		    const_MovementController_stuckDist,
					 		    const_MovementController_outPeriod))
					  [[ share__ <- x__ | x__ <- {| share__,setL_d0,setL_d1 |} ]]
					  [[set_l <- setR_l,set_a <- setR_a]]
					 )
					)[[setL_d0 <- set_d0,setL_d1 <- set_d1]]
					 [[setR_l <- set_l,setR_a <- set_a]]
					)
				)
				 \ hideSet)
				[[
					gas__.x____ <- gas,
					obstacle__.x____ <- obstacle,
					randomWalk__.x____ <- randomWalk,
					flag__.x____ <- flag,
					changeDirection__.x____ <- changeDirection,
					shortRandomWalk__.x____ <- shortRandomWalk,
					stop__.x____ <- stop,
					resume__.x____ <- resume,
					turn__.x____ <- turn
					| x____ <- NIDS
				]]
			)
			 [| {| interrupt |} |] SKIP)
		)
		)
	
	Behaviour_VS_O(id__,
			    const_MovementController_thr,
			    const_MovementController_lv,
			    const_MovementController_evadeTime,
			    const_MovementController_stuckPeriod,
			    const_MovementController_stuckDist,
			    const_MovementController_outPeriod) = 
		dbisim((MachineBody_VS_O(id__,
				    const_MovementController_thr,
				    const_MovementController_lv,
				    const_MovementController_evadeTime,
				    const_MovementController_stuckPeriod,
				    const_MovementController_stuckDist,
				    const_MovementController_outPeriod))
		)
	
	IteratedBehaviour_VS_O(id__,
			    const_MovementController_thr,
			    const_MovementController_lv,
			    const_MovementController_evadeTime,
			    const_MovementController_stuckPeriod,
			    const_MovementController_stuckDist,
			    const_MovementController_outPeriod) = 
		dbisim((MachineBody_VS_O(id__,
				    const_MovementController_thr,
				    const_MovementController_lv,
				    const_MovementController_evadeTime,
				    const_MovementController_stuckPeriod,
				    const_MovementController_stuckDist,
				    const_MovementController_outPeriod))
		)
	
	Stateful_VS_O(id__,
			    const_MovementController_thr,
			    const_MovementController_lv,
			    const_MovementController_evadeTime,
			    const_MovementController_stuckPeriod,
			    const_MovementController_stuckDist,
			    const_MovementController_outPeriod) = 
		dbisim((
			(Behaviour_VS_O(id__,
					    const_MovementController_thr,
					    const_MovementController_lv,
					    const_MovementController_evadeTime,
					    const_MovementController_stuckPeriod,
					    const_MovementController_stuckDist,
					    const_MovementController_outPeriod) [| union(getsetLocalChannels,{terminate}) |] varMemory(id__,
					    const_MovementController_thr,
					    const_MovementController_lv,
					    const_MovementController_evadeTime,
					    const_MovementController_stuckPeriod,
					    const_MovementController_stuckDist,
					    const_MovementController_outPeriod))
		 	\getsetLocalChannels
		)
		)
	
	IteratedStateful_VS_O(id__,
			    const_MovementController_thr,
			    const_MovementController_lv,
			    const_MovementController_evadeTime,
			    const_MovementController_stuckPeriod,
			    const_MovementController_stuckDist,
			    const_MovementController_outPeriod) =
		(dbisim(
			sbisim(
				Behaviour_VS_O(id__,
						    const_MovementController_thr,
						    const_MovementController_lv,
						    const_MovementController_evadeTime,
						    const_MovementController_stuckPeriod,
						    const_MovementController_stuckDist,
						    const_MovementController_outPeriod)
				[| {|get_v,set_v,terminate|} |]
				Memory_v(0)
			)\{|get_v,set_v|}
		)
		)
	
	-- END
	
	-- Memory
	-- Memory variables
	Memory_v(v) =
		get_v!v -> Memory_v(v)
		[]
		set_v?x__ -> Memory_v(x__)
		[]
		terminate -> SKIP
	
	-- varMemory process
	varMemory(id__,
			    const_MovementController_thr,
			    const_MovementController_lv,
			    const_MovementController_evadeTime,
			    const_MovementController_stuckPeriod,
			    const_MovementController_stuckDist,
			    const_MovementController_outPeriod) = Memory_v(0)
	
	getsetLocalChannels = {|get_v,set_v|}
	
	-- Definition of the behaviour of state machines (default, optimised, visible, visible and optimised)
	FVS__(id__,
			    const_MovementController_thr,
			    const_MovementController_lv,
			    const_MovementController_evadeTime,
			    const_MovementController_stuckPeriod,
			    const_MovementController_stuckDist,
			    const_MovementController_outPeriod) = STM_VS_O(id__,
			    const_MovementController_thr,
			    const_MovementController_lv,
			    const_MovementController_evadeTime,
			    const_MovementController_stuckPeriod,
			    const_MovementController_stuckDist,
			    const_MovementController_outPeriod)
	
	D__(id__,
			    const_MovementController_thr,
			    const_MovementController_lv,
			    const_MovementController_evadeTime,
			    const_MovementController_stuckPeriod,
			    const_MovementController_stuckDist,
			    const_MovementController_outPeriod) = STM(id__,
			    const_MovementController_thr,
			    const_MovementController_lv,
			    const_MovementController_evadeTime,
			    const_MovementController_stuckPeriod,
			    const_MovementController_stuckDist,
			    const_MovementController_outPeriod) \ internal_events
	O__(id__,
			    const_MovementController_thr,
			    const_MovementController_lv,
			    const_MovementController_evadeTime,
			    const_MovementController_stuckPeriod,
			    const_MovementController_stuckDist,
			    const_MovementController_outPeriod) = sbisim(diamond(D__(id__,
			    const_MovementController_thr,
			    const_MovementController_lv,
			    const_MovementController_evadeTime,
			    const_MovementController_stuckPeriod,
			    const_MovementController_stuckDist,
			    const_MovementController_outPeriod)))
	VS__(id__,
			    const_MovementController_thr,
			    const_MovementController_lv,
			    const_MovementController_evadeTime,
			    const_MovementController_stuckPeriod,
			    const_MovementController_stuckDist,
			    const_MovementController_outPeriod) = FVS__(id__,
			    const_MovementController_thr,
			    const_MovementController_lv,
			    const_MovementController_evadeTime,
			    const_MovementController_stuckPeriod,
			    const_MovementController_stuckDist,
			    const_MovementController_outPeriod)
	VS_O__(id__,
			    const_MovementController_thr,
			    const_MovementController_lv,
			    const_MovementController_evadeTime,
			    const_MovementController_stuckPeriod,
			    const_MovementController_stuckDist,
			    const_MovementController_outPeriod) = sbisim(diamond(FVS__(id__,
			    const_MovementController_thr,
			    const_MovementController_lv,
			    const_MovementController_evadeTime,
			    const_MovementController_stuckPeriod,
			    const_MovementController_stuckDist,
			    const_MovementController_outPeriod)))
	HEXT__(id__,
			    const_MovementController_thr,
			    const_MovementController_lv,
			    const_MovementController_evadeTime,
			    const_MovementController_stuckPeriod,
			    const_MovementController_stuckDist,
			    const_MovementController_outPeriod) = O__(id__,
			    const_MovementController_thr,
			    const_MovementController_lv,
			    const_MovementController_evadeTime,
			    const_MovementController_stuckPeriod,
			    const_MovementController_stuckDist,
			    const_MovementController_outPeriod) [|shared_variable_events|] SKIP
	HUP__(id__,
			    const_MovementController_thr,
			    const_MovementController_lv,
			    const_MovementController_evadeTime,
			    const_MovementController_stuckPeriod,
			    const_MovementController_stuckDist,
			    const_MovementController_outPeriod) = O__(id__,
			    const_MovementController_thr,
			    const_MovementController_lv,
			    const_MovementController_evadeTime,
			    const_MovementController_stuckPeriod,
			    const_MovementController_stuckDist,
			    const_MovementController_outPeriod) [|{share__}|] SKIP
	
	-- Shared memory
	-- Shared memory variables
	Memory_a(a) =
		get_a!a -> Memory_a(a)
		[]
		set_a?x__ -> Memory_a(x__)
		[]
		set_EXT_a?x__ -> Memory_a(x__)
		[]
		terminate -> SKIP
	Memory_l(l) =
		get_l!l -> Memory_l(l)
		[]
		set_l?x__ -> Memory_l(x__)
		[]
		set_EXT_l?x__ -> Memory_l(x__)
		[]
		terminate -> SKIP
	Memory_d0(d0) =
		get_d0!d0 -> Memory_d0(d0)
		[]
		set_d0?x__ -> Memory_d0(x__)
		[]
		set_EXT_d0?x__ -> Memory_d0(x__)
		[]
		terminate -> SKIP
	Memory_d1(d1) =
		get_d1!d1 -> Memory_d1(d1)
		[]
		set_d1?x__ -> Memory_d1(x__)
		[]
		set_EXT_d1?x__ -> Memory_d1(x__)
		[]
		terminate -> SKIP
	Memory_odometer(odometer) =
		get_odometer!odometer -> Memory_odometer(odometer)
		[]
		set_odometer?x__ -> Memory_odometer(x__)
		[]
		set_EXT_odometer?x__ -> Memory_odometer(x__)
		[]
		terminate -> SKIP
	
	-- sharedVarMemory process
	sharedVarMemory(id__,
			    const_MovementController_thr,
			    const_MovementController_lv,
			    const_MovementController_evadeTime,
			    const_MovementController_stuckPeriod,
			    const_MovementController_stuckDist,
			    const_MovementController_outPeriod) = Memory_a(Angle_Left)
	[| { terminate } |] (
	Memory_l(Loc_left)
	[| { terminate } |] (
	Memory_d0(0)
	[| { terminate } |] (
	Memory_d1(0)
	[| { terminate } |] (
	Memory_odometer(0)
	)
	)
	)
	)
	
	sharedVarSync = {|get_a,set_a,set_EXT_a,get_l,set_l,set_EXT_l,get_d0,set_d0,set_EXT_d0,get_d1,set_d1,set_EXT_d1,get_odometer,set_odometer,set_EXT_odometer|}
	
	sharedVarHide = {|get_a,get_l,get_d0,get_d1,get_odometer|}
endmodule


