				channel shortRandomWalk: InOut
				channel stop__: NIDS.InOut
				channel stop: InOut
				channel resume__: NIDS.InOut
				channel resume: InOut
				channel turn__: NIDS.InOut.Angle
				channel turn: InOut.Angle
				
				-- Declaring call and ret events for undefined operations
				channel moveCall: core_real.Angle
				
				enterSS = {|
				WAITING::enter,
				GETTING_OUT::enter,
				AVOIDING::enter,
				AVOIDING_AGAIN::enter,
				TRYING_AGAIN::enter,
				FOUND::enter,
