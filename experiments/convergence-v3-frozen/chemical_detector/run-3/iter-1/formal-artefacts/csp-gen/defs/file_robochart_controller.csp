			    const_MovementController_stuckPeriod,
			    const_MovementController_stuckDist,
			    const_MovementController_outPeriod) = 
		dbisim((
		let
			finalNodesEntered = {||}
		within
			((let
				-- IMPLEMENTATION NOTE:
				-- Here the 'enter' channel set is calculated explicitly because of the use of CSPM 
				-- modules for defining the semantics of each node.
				enterSS = {|
				WAITING::enter,
				GETTING_OUT::enter,
				AVOIDING::enter,
				AVOIDING_AGAIN::enter,
				TRYING_AGAIN::enter,
				FOUND::enter,
				HALTED::enter,
				GOING::enter,
