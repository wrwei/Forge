					-- IMPLEMENTATION NOTE: the channel set 'enter' is calculated explicitly
					-- because CSPM modules are used for the semantics of Node.
					flowevts = union(enterSS,{|exit,exited,interrupt|})
					transSync = {|internal__.NID_i0,stop__.NID_WAITING.in,resume__.NID_WAITING.in,turn__.NID_WAITING.in,stop__.NID_GOING.in,resume__.NID_GOING.in,turn__.NID_GOING.in,obstacle__.NID_GOING.in,stop__.NID_AVOIDING.in,resume__.NID_AVOIDING.in,turn__.NID_AVOIDING.in,stop__.NID_TRYING_AGAIN.in,resume__.NID_TRYING_AGAIN.in,turn__.NID_TRYING_AGAIN.in,obstacle__.NID_TRYING_AGAIN.in,stop__.NID_AVOIDING_AGAIN.in,resume__.NID_AVOIDING_AGAIN.in,internal__.NID_AVOIDING_AGAIN,internal__.NID_AVOIDING_AGAIN,stop__.NID_GETTING_OUT.in,resume__.NID_GETTING_OUT.in,turn__.NID_GETTING_OUT.in,internal__.NID_FOUND,stop__.NID_HALTED.in|}
				within
