						          const_GasAnalysisController_stuckPeriod,
						          const_GasAnalysisController_stuckDist,
						          const_GasAnalysisController_outPeriod)
				[]
				get_CLID_READING!x__ -> Clock_CLID_READING(id__,x__,
						          const_GasAnalysisController_thr,
						          const_GasAnalysisController_lv,
						          const_GasAnalysisController_evadeTime,
						          const_GasAnalysisController_stuckPeriod,
						          const_GasAnalysisController_stuckDist,
						          const_GasAnalysisController_outPeriod)
				[]
				terminate -> SKIP,Clock_CLID_READING(id__,clock_type_plus(x__,1,CLID_READING_clock_type(id__,
						          const_GasAnalysisController_thr,
						          const_GasAnalysisController_lv,
						          const_GasAnalysisController_evadeTime,
						          const_GasAnalysisController_stuckPeriod,
						          const_GasAnalysisController_stuckDist,
						          const_GasAnalysisController_outPeriod)),
						          const_GasAnalysisController_thr,
						          const_GasAnalysisController_lv,
						          const_GasAnalysisController_evadeTime,
						          const_GasAnalysisController_stuckPeriod,
						          const_GasAnalysisController_stuckDist,
						          const_GasAnalysisController_outPeriod))
		
		StateClocks(id__,
				          const_GasAnalysisController_thr,
				          const_GasAnalysisController_lv,
				          const_GasAnalysisController_evadeTime,
				          const_GasAnalysisController_stuckPeriod,
				          const_GasAnalysisController_stuckDist,
				          const_GasAnalysisController_outPeriod) = dbisim(Clock_CLID_NO_GAS(id__,0,
				          const_GasAnalysisController_thr,
				          const_GasAnalysisController_lv,
				          const_GasAnalysisController_evadeTime,
				          const_GasAnalysisController_stuckPeriod,
				          const_GasAnalysisController_stuckDist,
				          const_GasAnalysisController_outPeriod))
		[| { terminate } |] (
		dbisim(Clock_CLID_GAS_DETECTED(id__,0,
				          const_GasAnalysisController_thr,
				          const_GasAnalysisController_lv,
				          const_GasAnalysisController_evadeTime,
				          const_GasAnalysisController_stuckPeriod,
				          const_GasAnalysisController_stuckDist,
				          const_GasAnalysisController_outPeriod))
		[| { terminate } |] (
		dbisim(Clock_CLID_CONCLUDED(id__,0,
				          const_GasAnalysisController_thr,
				          const_GasAnalysisController_lv,
				          const_GasAnalysisController_evadeTime,
				          const_GasAnalysisController_stuckPeriod,
				          const_GasAnalysisController_stuckDist,
				          const_GasAnalysisController_outPeriod))
		[| { terminate } |] (
		dbisim(Clock_CLID_ANALYSIS(id__,0,
				          const_GasAnalysisController_thr,
				          const_GasAnalysisController_lv,
				          const_GasAnalysisController_evadeTime,
				          const_GasAnalysisController_stuckPeriod,
				          const_GasAnalysisController_stuckDist,
				          const_GasAnalysisController_outPeriod))
		[| { terminate } |] (
		dbisim(Clock_CLID_SOURCE_FOUND(id__,0,
				          const_GasAnalysisController_thr,
				          const_GasAnalysisController_lv,
				          const_GasAnalysisController_evadeTime,
				          const_GasAnalysisController_stuckPeriod,
				          const_GasAnalysisController_stuckDist,
				          const_GasAnalysisController_outPeriod))
		[| { terminate } |] (
		dbisim(Clock_CLID_READING(id__,0,
				          const_GasAnalysisController_thr,
				          const_GasAnalysisController_lv,
				          const_GasAnalysisController_evadeTime,
				          const_GasAnalysisController_stuckPeriod,
				          const_GasAnalysisController_stuckDist,
				          const_GasAnalysisController_outPeriod))
		)
		)
		)
		)
		)
		
		stateClockSync = {|get_CLID_NO_GAS,NO_GAS::entered,get_CLID_GAS_DETECTED,GAS_DETECTED::entered,get_CLID_CONCLUDED,CONCLUDED::entered,get_CLID_ANALYSIS,ANALYSIS::entered,get_CLID_SOURCE_FOUND,SOURCE_FOUND::entered,get_CLID_READING,READING::entered|}
		
		-- Shared memory
		-- Shared memory variables
		Memory_gs(gs) =
			get_gs!gs -> Memory_gs(gs)
			[]
			set_gs?x__ -> Memory_gs(x__)
			[]
			set_EXT_gs?x__ -> Memory_gs(x__)
			[]
			terminate -> SKIP
		Memory_sts(sts) =
			get_sts!sts -> Memory_sts(sts)
			[]
			set_sts?x__ -> Memory_sts(x__)
			[]
			set_EXT_sts?x__ -> Memory_sts(x__)
			[]
			terminate -> SKIP
		Memory_ins(ins) =
			get_ins!ins -> Memory_ins(ins)
			[]
			set_ins?x__ -> Memory_ins(x__)
			[]
			set_EXT_ins?x__ -> Memory_ins(x__)
			[]
			terminate -> SKIP
		Memory_anl(anl) =
			get_anl!anl -> Memory_anl(anl)
			[]
			set_anl?x__ -> Memory_anl(x__)
			[]
			set_EXT_anl?x__ -> Memory_anl(x__)
			[]
			terminate -> SKIP
		
		-- sharedVarMemory process
		sharedVarMemory(id__,
				    const_GasAnalysisController_thr,
				    const_GasAnalysisController_lv,
				    const_GasAnalysisController_evadeTime,
				    const_GasAnalysisController_stuckPeriod,
				    const_GasAnalysisController_stuckDist,
				    const_GasAnalysisController_outPeriod) = Memory_gs(<>)
		[| { terminate } |] (
		Memory_sts(Status_noGas)
		[| { terminate } |] (
		Memory_ins(0)
		[| { terminate } |] (
		Memory_anl(Angle_Left)
		)
		)
		)
		
		sharedVarSync = {|get_gs,set_gs,set_EXT_gs,get_sts,set_sts,set_EXT_sts,get_ins,set_ins,set_EXT_ins,get_anl,set_anl,set_EXT_anl|}
		
		sharedVarHide = {|get_gs,get_sts,get_ins,get_anl|}
		}
endmodule
