									stm_ref0::set_EXT_a,stm_ref0::set_EXT_l,stm_ref0::set_EXT_d0,stm_ref0::set_EXT_d1,stm_ref0::set_EXT_odometer
								|}
							)
						|]
					dbisim(Memory(id__, Angle_Left, Loc_left, 0, 0, 0, const_MovementController_Ctrl_thr, const_MovementController_Ctrl_lv, const_MovementController_Ctrl_evadeTime, const_MovementController_Ctrl_stuckPeriod, const_MovementController_Ctrl_stuckDist, const_MovementController_Ctrl_outPeriod))
				)
				\ union(
					{|
					|},
					{|
						stm_ref0::set_EXT_a,stm_ref0::set_EXT_l,stm_ref0::set_EXT_d0,stm_ref0::set_EXT_d1,stm_ref0::set_EXT_odometer
					|}
				)
				[|{|terminate|}|>SKIP
				,<visibleMemoryEvents,{tock}>))
								
				-- VS_O version
				VS_O__(id__,
						    const_MovementController_Ctrl_thr,
						    const_MovementController_Ctrl_lv,
						    const_MovementController_Ctrl_evadeTime,
						    const_MovementController_Ctrl_stuckPeriod,
						    const_MovementController_Ctrl_stuckDist,
						    const_MovementController_Ctrl_outPeriod) = dbisim(prioritise(	((
						let
							const_MovementController_thr = const_MovementController_Ctrl_thr
							const_MovementController_lv = const_MovementController_Ctrl_lv
							const_MovementController_evadeTime = const_MovementController_Ctrl_evadeTime
							const_MovementController_stuckPeriod = const_MovementController_Ctrl_stuckPeriod
							const_MovementController_stuckDist = const_MovementController_Ctrl_stuckDist
							const_MovementController_outPeriod = const_MovementController_Ctrl_outPeriod
						within 
						stm_ref0::VS_O__(id__,
								    const_MovementController_thr,
								    const_MovementController_lv,
								    const_MovementController_evadeTime,
								    const_MovementController_stuckPeriod,
								    const_MovementController_stuckDist,
								    const_MovementController_outPeriod)[[
							stm_ref0::terminate <- terminate,
							stm_ref0::stop <- stop,
							stm_ref0::resume <- resume,
							stm_ref0::turn <- turn,
							stm_ref0::obstacle <- obstacle,
							stm_ref0::randomWalk <- randomWalk,
							stm_ref0::flag <- flag,
							stm_ref0::changeDirection <- changeDirection,
							stm_ref0::shortRandomWalk <- shortRandomWalk,
							stm_ref0::set_a <- set_a,
							stm_ref0::get_a <- get_a,
							stm_ref0::set_l <- set_l,
							stm_ref0::get_l <- get_l,
							stm_ref0::set_d0 <- set_d0,
							stm_ref0::get_d0 <- get_d0,
							stm_ref0::set_d1 <- set_d1,
							stm_ref0::get_d1 <- get_d1,
							stm_ref0::set_odometer <- set_odometer,
							stm_ref0::get_odometer <- get_odometer,
							stm_ref0::moveCall <- moveCall
						]]
						\ {|
							stm_ref0::gas
						|}
					)
						[|
							union(
								{|
								|},
								{|
									stm_ref0::set_EXT_a,stm_ref0::set_EXT_l,stm_ref0::set_EXT_d0,stm_ref0::set_EXT_d1,stm_ref0::set_EXT_odometer
								|}
							)
						|]
					dbisim(Memory(id__, Angle_Left, Loc_left, 0, 0, 0, const_MovementController_Ctrl_thr, const_MovementController_Ctrl_lv, const_MovementController_Ctrl_evadeTime, const_MovementController_Ctrl_stuckPeriod, const_MovementController_Ctrl_stuckDist, const_MovementController_Ctrl_outPeriod))
				)
				\ union(
					{|
					|},
					{|
						stm_ref0::set_EXT_a,stm_ref0::set_EXT_l,stm_ref0::set_EXT_d0,stm_ref0::set_EXT_d1,stm_ref0::set_EXT_odometer
					|}
				)
				[|{|terminate|}|>SKIP
				,<visibleMemoryEvents,{tock}>))
			
				HEXT(id__,
						    const_MovementController_Ctrl_thr,
						    const_MovementController_Ctrl_lv,
						    const_MovementController_Ctrl_evadeTime,
						    const_MovementController_Ctrl_stuckPeriod,
						    const_MovementController_Ctrl_stuckDist,
						    const_MovementController_Ctrl_outPeriod) = O__(id__,
						    const_MovementController_Ctrl_thr,
						    const_MovementController_Ctrl_lv,
						    const_MovementController_Ctrl_evadeTime,
						    const_MovementController_Ctrl_stuckPeriod,
						    const_MovementController_Ctrl_stuckDist,
						    const_MovementController_Ctrl_outPeriod) [|shared_variable_events|] SKIP			
		}

	endmodule
