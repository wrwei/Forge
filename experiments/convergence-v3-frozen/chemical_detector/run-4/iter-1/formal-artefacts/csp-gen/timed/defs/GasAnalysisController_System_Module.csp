			-- defined operations
		
			-- declaring machines
			module stm_ref0
			exports
				transparent diamond
				transparent sbisim
				transparent dbisim
				transparent chase
			
				-- Transition identifiers
				-- declaring identifiers of transitions
				datatype NIDS = 
				              NID_FOUND|
				              NID_TRYING_AGAIN|
				              NID_GETTING_OUT|
				              NID_AVOIDING_AGAIN|
				              NID_GOING|
				              NID_WAITING|
				              NID_AVOIDING|
				              NID_i0
				
				channel internal__ : NIDS
				
