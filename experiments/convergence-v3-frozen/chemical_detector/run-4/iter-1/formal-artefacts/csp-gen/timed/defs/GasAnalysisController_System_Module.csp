				datatype ClockSet = 
					CLID_evasionStart
				
				channel clockReset, clockResetL, clockResetR : ClockSet
				
				localClockResets = {|clockReset.CLID_evasionStart|}
				
				
				channel get_CLID_FOUND : core_clock_type 
				channel get_CLID_AVOIDING : core_clock_type 
				channel get_CLID_GOING : core_clock_type 
				channel get_CLID_evasionStart : core_clock_type 
				channel get_CLID_GETTING_OUT : core_clock_type 
				channel get_CLID_TRYING_AGAIN : core_clock_type 
				channel get_CLID_WAITING : core_clock_type 
				channel get_CLID_AVOIDING_AGAIN : core_clock_type 
				--channel increment__
				
				CLID_FOUND_clock_type(id__,
						          const_MovementController_thr,
						          const_MovementController_lv,
						          const_MovementController_evadeTime,
						          const_MovementController_stuckPeriod,
						          const_MovementController_stuckDist,
						          const_MovementController_outPeriod) = 
					let
						max = (clock_type_max(Union({
				{}
				}))+1)
