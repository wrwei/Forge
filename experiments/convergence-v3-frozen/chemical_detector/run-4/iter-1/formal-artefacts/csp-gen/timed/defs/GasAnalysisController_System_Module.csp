				channel resume: InOut
				channel turn__: NIDS.InOut.Angle
				channel turn: InOut.Angle
				
				-- Declaring call and ret events for undefined operations
				channel moveCall: core_real.Angle
				
				enterSS = {|
				FOUND::enter,
				TRYING_AGAIN::enter,
				GETTING_OUT::enter,
				AVOIDING_AGAIN::enter,
				GOING::enter,
				WAITING::enter,
				AVOIDING::enter,
				i0::enter
				|}
				
				enteredSS = 	{|
				FOUND::entered,
				TRYING_AGAIN::entered,
				GETTING_OUT::entered,
				AVOIDING_AGAIN::entered,
				GOING::entered,
				WAITING::entered,
				AVOIDING::entered
				|}
				
				internal_events = union(enteredSS,union(enterSS,{|interrupt,exited|}))
				
				shared_variable_events = {|
					set_EXT_a,
					set_EXT_l,
					set_EXT_d0,
					set_EXT_d1,
