		stateClockSync = {|get_CLID_FOUND,FOUND::entered,get_CLID_AVOIDING_AGAIN,AVOIDING_AGAIN::entered,get_CLID_WAITING,WAITING::entered,get_CLID_AVOIDING,AVOIDING::entered,get_CLID_TRYING_AGAIN,TRYING_AGAIN::entered,get_CLID_GOING,GOING::entered,get_CLID_GETTING_OUT,GETTING_OUT::entered|}
		
		-- Shared memory
		-- Shared memory variables
		Memory_a(a) =
			get_a!a -> Memory_a(a)
			[]
			set_a?x__ -> Memory_a(x__)
			[]
			set_EXT_a?x__ -> Memory_a(x__)
			[]
			terminate -> SKIP
		Memory_d0(d0) =
			get_d0!d0 -> Memory_d0(d0)
			[]
			set_d0?x__ -> Memory_d0(x__)
			[]
			set_EXT_d0?x__ -> Memory_d0(x__)
			[]
			terminate -> SKIP
		Memory_d1(d1) =
			get_d1!d1 -> Memory_d1(d1)
			[]
			set_d1?x__ -> Memory_d1(x__)
			[]
			set_EXT_d1?x__ -> Memory_d1(x__)
			[]
			terminate -> SKIP
		Memory_l(l) =
			get_l!l -> Memory_l(l)
			[]
			set_l?x__ -> Memory_l(x__)
			[]
			set_EXT_l?x__ -> Memory_l(x__)
			[]
			terminate -> SKIP
		Memory_odometer(odometer) =
			get_odometer!odometer -> Memory_odometer(odometer)
			[]
			set_odometer?x__ -> Memory_odometer(x__)
			[]
			set_EXT_odometer?x__ -> Memory_odometer(x__)
			[]
			terminate -> SKIP
		
		-- sharedVarMemory process
		sharedVarMemory(id__,
				    const_MovementController_thr,
				    const_MovementController_lv,
				    const_MovementController_evadeTime,
				    const_MovementController_stuckPeriod,
				    const_MovementController_stuckDist,
				    const_MovementController_outPeriod) = Memory_a(Angle_Left)
		[| { terminate } |] (
		Memory_d0(0)
		[| { terminate } |] (
		Memory_d1(0)
		[| { terminate } |] (
		Memory_l(Loc_left)
		[| { terminate } |] (
		Memory_odometer(0)
		)
		)
		)
		)
		
		sharedVarSync = {|get_a,set_a,set_EXT_a,get_d0,set_d0,set_EXT_d0,get_d1,set_d1,set_EXT_d1,get_l,set_l,set_EXT_l,get_odometer,set_odometer,set_EXT_odometer|}
		
		sharedVarHide = {|get_a,get_d0,get_d1,get_l,get_odometer|}
		}
endmodule
