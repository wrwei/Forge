      <modifier>STATIC</modifier>
      <modifier>PRIVATE</modifier>
      <type name="int"/>
      <assignment xsi:type="spoon:CtLiteral" value="8" valueKind="Integer">
        <type name="int"/>
      </assignment>
    </typeMember>
