  <spoon:CtClass name="ChemicalDetector">
    <comment xsi:type="spoon:CtJavaDoc" commentContent="The Chemical Detector system: wires the Vehicle to the gas-analysis and&#xA;movement subsystems and runs the sense-analyse-act loop. Vehicle events are&#xA;routed to the subsystem that consumes them; turn, stop and resume emitted by&#xA;the gas-analysis subsystem are delivered to the movement subsystem; each&#xA;subsystem is then stepped until it rests in a mode that waits for an event."/>
    <modifier>FINAL</modifier>
    <modifier>PUBLIC</modifier>
    <typeMember xsi:type="spoon:CtField" name="SETTLE_LIMIT">
      <comment xsi:type="spoon:CtJavaDoc" commentContent="Upper bound on consecutive autonomous steps taken to settle a subsystem."/>
