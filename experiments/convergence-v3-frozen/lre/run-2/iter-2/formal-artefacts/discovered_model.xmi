  <spoon:CtClass name="ObstacleRegister">
    <comment xsi:type="spoon:CtJavaDoc" commentContent="The obstacles the AUV currently knows about, indexed by natural number&#xA;(LRE-DM3). Immutable: {@link #with(Obstacle)} returns a new register."/>
    <modifier>PUBLIC</modifier>
    <modifier>FINAL</modifier>
