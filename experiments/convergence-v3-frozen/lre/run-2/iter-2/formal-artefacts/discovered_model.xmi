  <spoon:CtRecord name="Obstacle">
    <comment xsi:type="spoon:CtJavaDoc" commentContent="One obstacle known to the AUV (LRE-DM2). Positions are relative to the AUV;&#xA;an obstacle whose north-south and east-west velocities are both zero is&#xA;static, otherwise it is dynamic."/>
