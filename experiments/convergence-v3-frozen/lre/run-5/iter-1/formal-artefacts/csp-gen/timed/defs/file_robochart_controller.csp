module LreController
exports
	transparent diamond
	transparent sbisim
	transparent dbisim
	transparent chase

	-- Transition identifiers
	-- declaring identifiers of transitions
	datatype NIDS = 
	              NID_CAM|
	              NID_HCM|
	              NID_OCM|
	              NID_MOM|
	              NID_i0
	
	channel internal__ : NIDS
	
	-- Flow channels		
	channel interrupt
	channel exited
	channel exit
	channel terminate
	
	-- Variable channels
	channel get_v, set_v, setL_v, setR_v: core_real
	channel get_vel, set_vel, setL_vel, setR_vel: core_real
	channel get_inOpez, set_inOpez, setL_inOpez, setR_inOpez: core_boolean
	channel get_odistCdyn, set_odistCdyn, setL_odistCdyn, setR_odistCdyn: core_real
	channel get_odistCstc, set_odistCstc, setL_odistCstc, setR_odistCstc: core_real
	channel get_cda, set_cda, setL_cda, setR_cda: core_real
	channel get_tcpa, set_tcpa, setL_tcpa, setR_tcpa: core_real
	channel get_hvel, set_hvel, setL_hvel, setR_hvel: core_real
	channel get_hdistCstc, set_hdistCstc, setL_hdistCstc, setR_hdistCstc: core_real
	channel get_vdistCstc, set_vdistCstc, setL_vdistCstc, setR_vdistCstc: core_real
	channel get_vvel, set_vvel, setL_vvel, setR_vvel: core_real
	channel get_cdyn, set_cdyn, setL_cdyn, setR_cdyn: core_int
	channel get_relNsVel, set_relNsVel, setL_relNsVel, setR_relNsVel: core_real
	channel get_relEwVel, set_relEwVel, setL_relEwVel, setR_relEwVel: core_real
	channel get_closingRate, set_closingRate, setL_closingRate, setR_closingRate: core_real
	channel get_hdistCdyn, set_hdistCdyn, setL_hdistCdyn, setR_hdistCdyn: core_real
	channel get_cstc, set_cstc, setL_cstc, setR_cstc: core_int
	channel get_relSpeedSq, set_relSpeedSq, setL_relSpeedSq, setR_relSpeedSq: core_real
	
	-- Shared variable channels
	channel set_EXT_vel: core_real
	channel set_EXT_inOpez: core_boolean
	channel set_EXT_odistCdyn: core_real
	channel set_EXT_odistCstc: core_real
	channel set_EXT_cda: core_real
	channel set_EXT_tcpa: core_real
	channel set_EXT_hvel: core_real
	channel set_EXT_hdistCstc: core_real
	channel set_EXT_vdistCstc: core_real
	channel set_EXT_vvel: core_real
	channel set_EXT_cdyn: core_int
	channel set_EXT_relNsVel: core_real
	channel set_EXT_relEwVel: core_real
	channel set_EXT_closingRate: core_real
	channel set_EXT_hdistCdyn: core_real
	channel set_EXT_cstc: core_int
	channel set_EXT_relSpeedSq: core_real
	
	-- Local variable channels for defined operations that are required by the state machine
	
	-- Declaring state machine events
	channel reqVel__: NIDS.InOut.core_real
	channel reqVel: InOut.core_real
	channel reqHdng__: NIDS.InOut.core_real
	channel reqHdng: InOut.core_real
	channel reqMOM__: NIDS.InOut
	channel reqMOM: InOut
	channel reqOCM__: NIDS.InOut
	channel reqOCM: InOut
	channel endTask__: NIDS.InOut
	channel endTask: InOut
	channel reqHCM__: NIDS.InOut
	channel reqHCM: InOut
	channel advVel__: NIDS.InOut.core_real
	channel advVel: InOut.core_real
	channel advHdng__: NIDS.InOut.core_real
	channel advHdng: InOut.core_real
	
	-- Declaring call and ret events for undefined operations
	
	enterSS = {|
	CAM::enter,
	HCM::enter,
	OCM::enter,
	MOM::enter,
	i0::enter
	|}
	
	enteredSS = 	{|
	CAM::entered,
	HCM::entered,
	OCM::entered,
	MOM::entered
	|}
	
	internal_events = union(enteredSS,union(enterSS,{|interrupt,exited|}))
	
	shared_variable_events = {|
		set_EXT_vel,
		set_EXT_inOpez,
		set_EXT_odistCdyn,
		set_EXT_odistCstc,
		set_EXT_cda,
		set_EXT_tcpa,
		set_EXT_hvel,
		set_EXT_hdistCstc,
		set_EXT_vdistCstc,
		set_EXT_vvel,
		set_EXT_cdyn,
		set_EXT_relNsVel,
		set_EXT_relEwVel,
		set_EXT_closingRate,
		set_EXT_hdistCdyn,
		set_EXT_cstc,
		set_EXT_relSpeedSq
	|}
	
	-- channel set with all visible events
	sem__events = {|
		terminate
	,	set_EXT_vel, set_vel,
		set_EXT_inOpez, set_inOpez,
		set_EXT_odistCdyn, set_odistCdyn,
