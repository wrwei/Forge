						          const_MovementController_stuckperiod,
						          const_MovementController_stuckdist,
						          const_MovementController_outperiod) = 
					let
						max = (clock_type_max(Union({
				({const_MovementController_stuckperiod|stuckperiod <- core_real}),
				({const_MovementController_stuckperiod|stuckperiod <- core_real})
				}))+1)
