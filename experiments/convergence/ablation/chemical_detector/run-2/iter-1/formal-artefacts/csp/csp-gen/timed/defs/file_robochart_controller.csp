		}
endmodule
module MovementController
exports
	transparent diamond
	transparent sbisim
	transparent dbisim
	transparent chase

	-- Transition identifiers
	-- declaring identifiers of transitions
	datatype NIDS = 
	              NID_TryingAgain|
	              NID_Going|
	              NID_Avoiding|
	              NID_Waiting|
	              NID_GettingOut|
	              NID_Found|
	              NID_AvoidingAgain|
	              NID_i0
	
	channel internal__ : NIDS
	
	-- Flow channels		
	channel interrupt
	channel exited
	channel exit
	channel terminate
	
	-- Variable channels
	channel get_v, set_v, setL_v, setR_v: core_real
	channel get_a, set_a, setL_a, setR_a: Angle
	channel get_d0, set_d0, setL_d0, setR_d0: core_real
	channel get_d1, set_d1, setL_d1, setR_d1: core_real
	channel get_l, set_l, setL_l, setR_l: Loc
	channel get_distance, set_distance, setL_distance, setR_distance: core_real
	
	-- Shared variable channels
	channel set_EXT_a: Angle
	channel set_EXT_d0: core_real
	channel set_EXT_d1: core_real
	channel set_EXT_l: Loc
	channel set_EXT_distance: core_real
	
	-- Local variable channels for defined operations that are required by the state machine
	
	-- Declaring state machine events
	channel gas__: NIDS.InOut.LSeq(GasSensor,2)
	channel gas: InOut.LSeq(GasSensor,2)
	channel obstacle__: NIDS.InOut.Loc
	channel obstacle: InOut.Loc
	channel randomWalk__: NIDS.InOut
	channel randomWalk: InOut
