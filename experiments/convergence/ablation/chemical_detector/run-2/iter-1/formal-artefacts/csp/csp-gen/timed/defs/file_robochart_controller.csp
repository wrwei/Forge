				channel moveCall: core_real.Angle
				
				enterSS = {|
				TryingAgain::enter,
				Going::enter,
				Avoiding::enter,
				Waiting::enter,
				GettingOut::enter,
				Found::enter,
				AvoidingAgain::enter,
				i0::enter
				|}
				
				enteredSS = 	{|
				TryingAgain::entered,
				Going::entered,
				Avoiding::entered,
				Waiting::entered,
				GettingOut::entered,
				Found::entered,
				AvoidingAgain::entered
				|}
				
				internal_events = union(enteredSS,union(enterSS,{|interrupt,exited|}))
				
				shared_variable_events = {|
					set_EXT_a,
					set_EXT_d0,
					set_EXT_d1,
					set_EXT_l,
					set_EXT_distance
