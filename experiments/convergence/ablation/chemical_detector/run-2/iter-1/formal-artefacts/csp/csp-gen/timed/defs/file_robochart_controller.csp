			visibleMemoryEvents = {|get_a,set_a,get_d0,set_d0,get_d1,set_d1,get_l,set_l,get_distance,set_distance|}
	
			-- defined operations
		
			-- declaring machines
			module stm_ref0
			exports
				transparent diamond
				transparent sbisim
				transparent dbisim
				transparent chase
			
				-- Transition identifiers
				-- declaring identifiers of transitions
				datatype NIDS = 
				              NID_TryingAgain|
				              NID_Going|
				              NID_Avoiding|
				              NID_Waiting|
				              NID_GettingOut|
				              NID_Found|
				              NID_AvoidingAgain|
				              NID_i0
				
				channel internal__ : NIDS
				
