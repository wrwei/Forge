		exports
			transparent diamond
			transparent sbisim
			transparent dbisim
			transparent chase
	
			-- declaring controller events
			channel gas: InOut.LSeq(GasSensor,2)
			channel obstacle: InOut.Loc
			channel randomWalk: InOut
			channel flag: InOut
			channel changeDirection: InOut.Loc
			channel shortRandomWalk: InOut
			channel stop: InOut
			channel turn: InOut.Angle
