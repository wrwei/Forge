						)[[setL_sts <- set_sts,setL_ins <- set_ins]]
						 [[setR_gs <- set_gs]]
						)
					)
					 \ hideSet)
					[[
						gas__.x____ <- gas,
						obstacle__.x____ <- obstacle,
						randomWalk__.x____ <- randomWalk,
						flag__.x____ <- flag,
						changeDirection__.x____ <- changeDirection,
						shortRandomWalk__.x____ <- shortRandomWalk,
						stop__.x____ <- stop,
						turn__.x____ <- turn,
						resume__.x____ <- resume
						| x____ <- NIDS
					]]
				)
				)
				 [| union(stateClockSync,{terminate}) |]
				 StateClocks(id__,
				 		          const_GasAnalysisController_thr,
				 		          const_GasAnalysisController_lv,
				 		          const_GasAnalysisController_evadetime,
				 		          const_GasAnalysisController_stuckperiod,
				 		          const_GasAnalysisController_stuckdist,
				 		          const_GasAnalysisController_outperiod)
				)\diff(stateClockSync,enteredSS))
				 [| {| interrupt |} |] SKIP)
			)
			)
		
