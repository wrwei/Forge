						    const_MovementController_Ctrl_stuckperiod,
						    const_MovementController_Ctrl_stuckdist,
						    const_MovementController_Ctrl_outperiod) [|shared_variable_events|] SKIP			
		}

	endmodule

module GasAnalysisController
exports
	transparent diamond
	transparent sbisim
	transparent dbisim
	transparent chase

	-- Transition identifiers
	-- declaring identifiers of transitions
	datatype NIDS = 
	              NID_NoGas|
	              NID_Analysis|
	              NID_Reading|
	              NID_GasDetected|
	              NID_i0
	
	channel internal__ : NIDS
	
	-- Flow channels		
	channel interrupt
	channel exited
	channel exit
	channel terminate
	
	-- Variable channels
	channel get_v, set_v, setL_v, setR_v: core_real
	channel get_gs, set_gs, setL_gs, setR_gs: LSeq(GasSensor,2)
	channel get_sts, set_sts, setL_sts, setR_sts: Status
	channel get_ins, set_ins, setL_ins, setR_ins: core_real
	channel get_anl, set_anl, setL_anl, setR_anl: Angle
	
	-- Shared variable channels
	channel set_EXT_gs: LSeq(GasSensor,2)
	channel set_EXT_sts: Status
	channel set_EXT_ins: core_real
	channel set_EXT_anl: Angle
	
	-- Local variable channels for defined operations that are required by the state machine
	
	-- Declaring state machine events
	channel gas__: NIDS.InOut.LSeq(GasSensor,2)
	channel gas: InOut.LSeq(GasSensor,2)
	channel obstacle__: NIDS.InOut.Loc
	channel obstacle: InOut.Loc
	channel randomWalk__: NIDS.InOut
	channel randomWalk: InOut
	channel flag__: NIDS.InOut
	channel flag: InOut
	channel changeDirection__: NIDS.InOut.Loc
	channel changeDirection: InOut.Loc
	channel shortRandomWalk__: NIDS.InOut
	channel shortRandomWalk: InOut
	channel stop__: NIDS.InOut
	channel stop: InOut
	channel turn__: NIDS.InOut.Angle
	channel turn: InOut.Angle
	channel resume__: NIDS.InOut
	channel resume: InOut
	
	-- Declaring call and ret events for undefined operations
	
	enterSS = {|
	NoGas::enter,
	Analysis::enter,
	Reading::enter,
	GasDetected::enter,
	i0::enter
	|}
	
	enteredSS = 	{|
	NoGas::entered,
	Analysis::entered,
	Reading::entered,
	GasDetected::entered
	|}
	
	internal_events = union(enteredSS,union(enterSS,{|interrupt,exited|}))
	
	shared_variable_events = {|
		set_EXT_gs,
		set_EXT_sts,
		set_EXT_ins,
		set_EXT_anl
	|}
	
	-- channel set with all visible events
	sem__events = {|
		terminate
	,	set_EXT_gs, set_gs,
		set_EXT_sts, set_sts,
		set_EXT_ins, set_ins,
		set_EXT_anl, set_anl
	,	gas,
		obstacle,
		randomWalk,
		flag,
		changeDirection,
		shortRandomWalk,
		stop,
		turn,
		resume
		|}
	
	channel clockReset, clockResetL, clockResetR 
	
	localClockResets = {||}
	
	
	channel get_CLID_NoGas : core_clock_type 
	channel get_CLID_Analysis : core_clock_type 
	channel get_CLID_GasDetected : core_clock_type 
	channel get_CLID_Reading : core_clock_type 
	--channel increment__
	
	CLID_NoGas_clock_type(id__,
			          const_GasAnalysisController_thr,
			          const_GasAnalysisController_lv,
			          const_GasAnalysisController_evadetime,
			          const_GasAnalysisController_stuckperiod,
			          const_GasAnalysisController_stuckdist,
			          const_GasAnalysisController_outperiod) = 
		let
			max = (clock_type_max(Union({
	{}
	}))+1)
		ctype = {0..max}
	within
		if member(max,core_clock_type) then ctype else error("core_clock_type is not wide enough")
	
	CLID_Analysis_clock_type(id__,
			          const_GasAnalysisController_thr,
			          const_GasAnalysisController_lv,
			          const_GasAnalysisController_evadetime,
			          const_GasAnalysisController_stuckperiod,
			          const_GasAnalysisController_stuckdist,
			          const_GasAnalysisController_outperiod) = 
		let
			max = (clock_type_max(Union({
	{}
	}))+1)
		ctype = {0..max}
	within
		if member(max,core_clock_type) then ctype else error("core_clock_type is not wide enough")
	
	CLID_GasDetected_clock_type(id__,
			          const_GasAnalysisController_thr,
			          const_GasAnalysisController_lv,
			          const_GasAnalysisController_evadetime,
			          const_GasAnalysisController_stuckperiod,
			          const_GasAnalysisController_stuckdist,
			          const_GasAnalysisController_outperiod) = 
		let
			max = (clock_type_max(Union({
	{}
	}))+1)
		ctype = {0..max}
	within
		if member(max,core_clock_type) then ctype else error("core_clock_type is not wide enough")
	
	CLID_Reading_clock_type(id__,
			          const_GasAnalysisController_thr,
			          const_GasAnalysisController_lv,
			          const_GasAnalysisController_evadetime,
			          const_GasAnalysisController_stuckperiod,
			          const_GasAnalysisController_stuckdist,
			          const_GasAnalysisController_outperiod) = 
		let
			max = (clock_type_max(Union({
	{}
	}))+1)
		ctype = {0..max}
	within
		if member(max,core_clock_type) then ctype else error("core_clock_type is not wide enough")
	
	

		-- Nodes --
		-- declaring all nodes
		
		----------------------------------------------------------------------
		-- State: NoGas
		module NoGas
		
		enterSS = {}
		
		enteredSS = {}
		
		exports
		
			--  Declarations
			
			channel enter, entered, interrupt
			channel enteredL, enteredR
			
							
			
			--channel increment__
			
			
			--	Nodes
			-- declaring all nodes
			
			
			Timed(OneStep) {
				--	Rule: behaviours(Node)
				--  Note that FDR has problems with efficiently compiling the process below
				-- 	if using a different recursion pattern.
				D__(id__,
						    const_GasAnalysisController_thr,
						    const_GasAnalysisController_lv,
						    const_GasAnalysisController_evadetime,
						    const_GasAnalysisController_stuckperiod,
						    const_GasAnalysisController_stuckdist,
						    const_GasAnalysisController_outperiod) = 
				dbisim(let
					-- IMPLEMENTATION NOTE: 
					-- The following should be defined as: Inactive = share__choice(Activation [] Termination),
					-- however FDR struggles with that form in certain cases. So we use the exception operator
					-- instead to 'terminate'.
					
					Inactive 	= share__choice(enter -> SKIP [] terminate -> SKIP) ; Active
					
					Termination = terminate -> SKIP
					
					Active 		= true&(share__choice(resume.out -> SKIP)) ; 
							 	  Behaviour ; 
							 	  share__choice(exit -> SKIP) ; SKIP ; 
							 	  share__choice(exited -> SKIP) ; Inactive
				
					Behaviour 	= entered -> During
					During 		= ((SKIP ; SStop) /\ interrupt -> SKIP)
				within
					Inactive [| {terminate} |> SKIP)
					
				VS_O__(id__,
						    const_GasAnalysisController_thr,
						    const_GasAnalysisController_lv,
						    const_GasAnalysisController_evadetime,
						    const_GasAnalysisController_stuckperiod,
						    const_GasAnalysisController_stuckdist,
						    const_GasAnalysisController_outperiod) = 
				dbisim(let
					Inactive 	= share__choice(enter -> SKIP [] terminate -> SKIP) ; Active
					
					Termination = terminate -> SKIP
					
					Active 		= true&(share__choice(resume.out -> SKIP)) ; 
							 	  Behaviour ; 
							 	  share__choice(exit -> SKIP) ; SKIP ; 
							 	  share__choice(exited -> SKIP) ; Inactive
				
					Behaviour 	= entered -> During
					During 		= ((SKIP ; SStop) /\ interrupt -> SKIP)
				within
					Inactive [| {terminate} |> SKIP)
				
				
				-- Clocks
				
				StateClocks(id__,
						          const_GasAnalysisController_thr,
						          const_GasAnalysisController_lv,
						          const_GasAnalysisController_evadetime,
						          const_GasAnalysisController_stuckperiod,
						          const_GasAnalysisController_stuckdist,
						          const_GasAnalysisController_outperiod) = terminate -> SKIP
				
				stateClockSync = {||}
			}
		
		endmodule
