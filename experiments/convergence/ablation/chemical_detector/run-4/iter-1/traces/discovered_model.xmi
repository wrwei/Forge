      <comment xsi:type="spoon:CtJavaDoc" commentContent="Steers away from an obstacle on side {@code side}, moving at&#xA;velocity {@code velocity}: left turns right, right turns left,&#xA;front turns back."/>
      <modifier>PUBLIC</modifier>
      <body xsi:type="spoon:CtBlock">
        <statement xsi:type="spoon:CtIf">
          <else xsi:type="spoon:CtBlock" isImplicit="true">
            <statement xsi:type="spoon:CtIf">
              <else xsi:type="spoon:CtBlock" isImplicit="true">
