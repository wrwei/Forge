                        <target xsi:type="spoon:CtTypeAccess">
                          <type name="void"/>
                          <accessedType name="Vehicle">
                            <packageRef name="chemdetector.actuator"/>
                          </accessedType>
                        </target>
                      </target>
                      <executableRef name="move">
                        <type name="void"/>
                        <argumentType name="double"/>
                        <argumentType name="Angle">
                          <packageRef name="chemdetector.data"/>
                        </argumentType>
                        <declaringType name="Vehicle">
                          <packageRef name="chemdetector.actuator"/>
