  <spoon:CtClass name="AnalysisRelay">
    <comment xsi:type="spoon:CtJavaDoc" commentContent="The communication channel from the gas-analysis subsystem to the&#xA;movement subsystem. The two reasoning subsystems communicate only via&#xA;the turn, stop, and resume events carried here."/>
    <modifier>FINAL</modifier>
    <modifier>PUBLIC</modifier>
    <typeMember xsi:type="spoon:CtConstructor" isImplicit="true" name="&lt;init>">
      <modifier>PUBLIC</modifier>
      <body xsi:type="spoon:CtBlock">
        <statement xsi:type="spoon:CtInvocation" isImplicit="true">
          <executableRef isImplicit="true" name="&lt;init>">
            <type name="Object">
              <packageRef name="java.lang"/>
            </type>
            <declaringType name="Object">
              <packageRef name="java.lang"/>
            </declaringType>
          </executableRef>
        </statement>
      </body>
      <type name="AnalysisRelay">
        <packageRef name="chemdetector.actuator"/>
      </type>
    </typeMember>
    <typeMember xsi:type="spoon:CtField" name="movement">
      <modifier>PRIVATE</modifier>
      <type name="MovementController">
        <packageRef isImplicit="true" name="chemdetector.controller"/>
      </type>
    </typeMember>
    <typeMember xsi:type="spoon:CtMethod" name="connect">
      <comment xsi:type="spoon:CtJavaDoc" commentContent="Connects the relay to the movement subsystem it delivers to."/>
      <modifier>PUBLIC</modifier>
      <body xsi:type="spoon:CtBlock">
        <statement xsi:type="spoon:CtAssignment">
          <type name="MovementController">
            <packageRef name="chemdetector.controller"/>
          </type>
          <assignment xsi:type="spoon:CtVariableRead">
            <variable xsi:type="spoon:CtParameterReference" name="controller">
              <type name="MovementController">
                <packageRef name="chemdetector.controller"/>
              </type>
            </variable>
          </assignment>
          <assigned xsi:type="spoon:CtFieldWrite">
            <target xsi:type="spoon:CtThisAccess">
              <type name="AnalysisRelay">
                <packageRef name="chemdetector.actuator"/>
              </type>
              <target xsi:type="spoon:CtTypeAccess">
                <type name="void"/>
                <accessedType name="AnalysisRelay">
                  <packageRef name="chemdetector.actuator"/>
                </accessedType>
              </target>
            </target>
            <variable xsi:type="spoon:CtFieldReference" name="movement">
              <type name="MovementController">
                <packageRef name="chemdetector.controller"/>
              </type>
              <declaringType name="AnalysisRelay">
                <packageRef name="chemdetector.actuator"/>
              </declaringType>
            </variable>
          </assigned>
        </statement>
      </body>
      <type name="void"/>
      <parameter name="controller">
        <type name="MovementController">
          <packageRef isImplicit="true" name="chemdetector.controller"/>
        </type>
      </parameter>
    </typeMember>
    <typeMember xsi:type="spoon:CtMethod" name="apply">
      <comment xsi:type="spoon:CtJavaDoc" commentContent="Delivers one event to the movement subsystem."/>
      <modifier>PUBLIC</modifier>
      <body xsi:type="spoon:CtBlock">
        <statement xsi:type="spoon:CtIf">
          <condition xsi:type="spoon:CtBinaryOperator" operatorKind="NE">
            <type name="boolean"/>
            <leftOperand xsi:type="spoon:CtFieldRead">
              <variable xsi:type="spoon:CtFieldReference" name="movement">
                <type name="MovementController">
                  <packageRef name="chemdetector.controller"/>
                </type>
                <declaringType name="AnalysisRelay">
                  <packageRef name="chemdetector.actuator"/>
                </declaringType>
              </variable>
              <target xsi:type="spoon:CtThisAccess" isImplicit="true">
                <type name="AnalysisRelay">
                  <packageRef name="chemdetector.actuator"/>
                </type>
                <target xsi:type="spoon:CtTypeAccess">
                  <type name="void"/>
                  <accessedType name="AnalysisRelay">
                    <packageRef name="chemdetector.actuator"/>
                  </accessedType>
                </target>
              </target>
            </leftOperand>
            <rightOperand xsi:type="spoon:CtLiteral">
              <type name="&lt;nulltype>"/>
            </rightOperand>
          </condition>
          <then xsi:type="spoon:CtBlock">
            <statement xsi:type="spoon:CtInvocation">
              <target xsi:type="spoon:CtFieldRead">
                <variable xsi:type="spoon:CtFieldReference" name="movement">
                  <type name="MovementController">
                    <packageRef name="chemdetector.controller"/>
                  </type>
                  <declaringType name="AnalysisRelay">
                    <packageRef name="chemdetector.actuator"/>
                  </declaringType>
                </variable>
                <target xsi:type="spoon:CtThisAccess" isImplicit="true">
                  <type name="AnalysisRelay">
                    <packageRef name="chemdetector.actuator"/>
                  </type>
                  <target xsi:type="spoon:CtTypeAccess">
                    <type name="void"/>
                    <accessedType name="AnalysisRelay">
                      <packageRef name="chemdetector.actuator"/>
                    </accessedType>
                  </target>
                </target>
              </target>
              <executableRef name="step">
                <type name="void"/>
                <argumentType name="MovementEvent">
                  <packageRef name="chemdetector.event"/>
                </argumentType>
                <declaringType name="MovementController">
                  <packageRef name="chemdetector.controller"/>
                </declaringType>
              </executableRef>
              <argument xsi:type="spoon:CtVariableRead">
                <variable xsi:type="spoon:CtParameterReference" name="command">
                  <type name="MovementEvent">
                    <packageRef name="chemdetector.event"/>
                  </type>
                </variable>
              </argument>
            </statement>
          </then>
        </statement>
      </body>
      <type name="void"/>
      <parameter name="command">
        <type name="MovementEvent">
          <packageRef isImplicit="true" name="chemdetector.event"/>
        </type>
      </parameter>
    </typeMember>
  </spoon:CtClass>
  <spoon:CtClass name="Vehicle">
