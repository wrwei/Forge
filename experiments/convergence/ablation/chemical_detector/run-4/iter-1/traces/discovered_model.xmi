    <typeMember xsi:type="spoon:CtMethod" name="pause">
      <comment xsi:type="spoon:CtJavaDoc" commentContent="Waits {@code duration} time units for the current action to settle."/>
      <modifier>PUBLIC</modifier>
      <body xsi:type="spoon:CtBlock">
        <statement xsi:type="spoon:CtComment" commentContent="Timing is realised by the platform; no simulated delay here."/>
