					[| {|get_v,set_v,terminate|} |]
					Memory_v(0)
				)\{|get_v,set_v|}
			)
			)
		
		-- END
		
		-- Memory
		-- Memory variables
		Memory_v(v) =
			get_v!v -> Memory_v(v)
			[]
			set_v?x__ -> Memory_v(x__)
			[]
			terminate -> SKIP
		
		-- varMemory process
		varMemory(id__,
