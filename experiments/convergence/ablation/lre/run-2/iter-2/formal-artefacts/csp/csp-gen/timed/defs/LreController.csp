										          const_LreController_staticobsvertdist))
							)\{|get_CLID_MOM|}
						)
						[| {|get_CLID_HCM,HCM::entered,terminate|} |]
						dbisim(Clock_CLID_HCM(id__,0,
								          const_LreController_minsafedist,
								          const_LreController_staticobshorizdist,
								          const_LreController_staticobsdfltvertdist,
								          const_LreController_staticobsvertdist))
					)\{|get_CLID_HCM|}
				)
				) \ diff(union(stateClockSync,enteredSS),enteredSS)
			)
			)
		
		Stateful_VS_O(id__,
				    const_LreController_minsafedist,
				    const_LreController_staticobshorizdist,
				    const_LreController_staticobsdfltvertdist,
				    const_LreController_staticobsvertdist) = 
			dbisim((let
				getsetLocalChannels = {|get_v,set_v|}
				clockSync = {||}
			within
				(Behaviour_VS_O(id__,
						    const_LreController_minsafedist,
						    const_LreController_staticobshorizdist,
						    const_LreController_staticobsdfltvertdist,
						    const_LreController_staticobsvertdist) 
				 [| union(union(getsetLocalChannels,clockSync),{terminate}) |] 
				 (varMemory(id__,
				 		    const_LreController_minsafedist,
				 		    const_LreController_staticobshorizdist,
				 		    const_LreController_staticobsdfltvertdist,
				 		    const_LreController_staticobsvertdist) [| {terminate} |] Clocks(id__,
				 		          const_LreController_minsafedist,
				 		          const_LreController_staticobshorizdist,
				 		          const_LreController_staticobsdfltvertdist,
				 		          const_LreController_staticobsvertdist))
			 	)\union(getsetLocalChannels,clockSync)
			)
			)
		
		IteratedStateful_VS_O(id__,
				    const_LreController_minsafedist,
				    const_LreController_staticobshorizdist,
				    const_LreController_staticobsdfltvertdist,
				    const_LreController_staticobsvertdist) =
