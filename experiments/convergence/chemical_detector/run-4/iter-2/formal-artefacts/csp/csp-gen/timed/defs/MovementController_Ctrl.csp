				)
				)
				)
				)
				)
				
				stateClockSync = {|get_CLID_Avoiding,Avoiding::entered,get_CLID_TryingAgain,TryingAgain::entered,get_CLID_Found,Found::entered,get_CLID_GettingOut,GettingOut::entered,get_CLID_AvoidingAgain,AvoidingAgain::entered,get_CLID_Going,Going::entered,get_CLID_Waiting,Waiting::entered|}
				
				-- Shared memory
				-- Shared memory variables
				Memory_a(a) =
					get_a!a -> Memory_a(a)
					[]
					set_a?x__ -> Memory_a(x__)
					[]
					set_EXT_a?x__ -> Memory_a(x__)
					[]
					terminate -> SKIP
				Memory_d0(d0) =
					get_d0!d0 -> Memory_d0(d0)
					[]
					set_d0?x__ -> Memory_d0(x__)
					[]
					set_EXT_d0?x__ -> Memory_d0(x__)
					[]
