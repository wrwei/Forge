					-- Nodes --
					-- declaring all nodes
					
					----------------------------------------------------------------------
					-- State: AvoidingAgain
					module AvoidingAgain
					
					enterSS = {}
					
					enteredSS = {}
					
					exports
					
						--  Declarations
						
						channel enter, entered, interrupt
