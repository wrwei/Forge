diagram GasAnalysis

enumeration Angle { Left Right Back Front }
enumeration Loc { left right front }
enumeration Status { noGas gasD }

datatype GasSensor {
	c : nat
	i : real
}

function analysis ( gs : Seq(GasSensor) ) : Status { }
function intensity ( gs : Seq(GasSensor) ) : real { }
function location ( gs : Seq(GasSensor) ) : Angle { }

interface LOperations {
	move ( p0 : real , p1 : Angle )
}

interface Inputs {
	event gas : Seq(GasSensor)
	event obstacle : Loc
}

interface Outputs {
	event randomWalk
	event flag
	event changeDirection : Loc
	event shortRandomWalk
}

interface Shared {
	event stop
	event resume
	event turn : Angle
}

interface Sensors {
	var odometer : real
}

interface Actuators {
}

interface GasAnalysis_State {
	var gs : Seq(GasSensor)
	var sts : Status
	var ins : real
	var anl : Angle
}

interface Movement_State {
	var a : Angle
	var d0 : real
	var d1 : real
	var l : Loc
}

interface Constants {
	const thr : real = 1
	const lv : real = 1
	const evadetime : real = 1
	const stuckperiod : real = 1
	const stuckdist : real = 1
	const outperiod : real = 1
}

stm GasAnalysis {
	uses Inputs uses Outputs uses Shared requires GasAnalysis_State requires Constants
	var v : real
	state Analysis {
		entry sts = analysis ( gs )
	}
	state Done {
		entry send stop
	}
	state NoGas {
		entry send resume
	}
	state Reading {
	}
	state GasDetected {
		entry ins = intensity ( gs )
	}
	initial i0
	transition t_init {
		from i0
		to Reading
	}
	transition t1 {
		from Reading
		to Analysis
		trigger gas ? gs
	}
	transition t2 {
		from Analysis
		to NoGas
		condition sts == noGas
	}
	transition t3 {
		from Analysis
		to GasDetected
		condition not ( sts == noGas )
	}
	transition t4 {
		from GasDetected
		to Done
		condition ins >= thr
	}
	transition t5 {
		from GasDetected
		to Reading
		condition not ( ins >= thr )
		action anl = location ( gs ) ; turn ! anl
	}
	transition t6 {
		from NoGas
		to Reading
	}
	transition t7 {
		from Done
		to Done
		trigger gas ? gs
	}
}

controller GasAnalysis_Ctrl {
	uses Inputs uses Outputs uses Shared requires GasAnalysis_State requires Constants
	sref stm_ref0 = GasAnalysis
	connection GasAnalysis_Ctrl on gas to stm_ref0 on gas
	connection stm_ref0 on resume to GasAnalysis_Ctrl on resume
	connection stm_ref0 on stop to GasAnalysis_Ctrl on stop
	connection stm_ref0 on turn to GasAnalysis_Ctrl on turn
}

stm Movement {
	uses Inputs uses Outputs uses Shared requires Movement_State requires Constants requires Sensors requires LOperations
	var v : real
	clock t
	state AvoidingAgain {
		entry d1 = odometer
	}
	state Waiting {
		entry send randomWalk
	}
	state Going {
		entry move ( lv , a )
	}
	state Avoiding {
		entry d0 = odometer ; changeDirection ! l ; wait ( evadetime )
	}
	state TryingAgain {
		entry move ( lv , a )
	}
	state Found {
		entry send flag ; move ( 0 , Front )
	}
	state GettingOut {
		entry send shortRandomWalk ; wait ( outperiod )
	}
	initial i0
	transition t_init {
		from i0
		to Waiting
	}
	transition t1 {
		from Waiting
		to Found
		trigger stop
	}
	transition t2 {
		from Waiting
		to Waiting
		trigger resume
	}
	transition t3 {
		from Waiting
		to Going
		trigger turn ? a
	}
	transition t4 {
		from Going
		to Found
		trigger stop
	}
	transition t5 {
		from Going
		to Waiting
		trigger resume
	}
	transition t6 {
		from Going
		to Going
		trigger turn ? a
	}
	transition t7 {
		from Going
		to Avoiding
		trigger obstacle ? l
		# t
	}
	transition t8 {
		from Avoiding
		to Found
		trigger stop
	}
	transition t9 {
		from Avoiding
		to Waiting
		trigger resume
	}
	transition t10 {
		from Avoiding
		to TryingAgain
		trigger turn ? a
	}
	transition t11 {
		from TryingAgain
		to Found
		trigger stop
	}
	transition t12 {
		from TryingAgain
		to Waiting
		trigger resume
	}
	transition t13 {
		from TryingAgain
		to TryingAgain
		trigger turn ? a
	}
	transition t14 {
		from TryingAgain
		to AvoidingAgain
		trigger obstacle ? l
	}
	transition t15 {
		from AvoidingAgain
		to Found
		trigger stop
	}
	transition t16 {
		from AvoidingAgain
		to Waiting
		trigger resume
	}
	transition t17 {
		from AvoidingAgain
		to Avoiding
		# t
		condition since ( t ) < stuckperiod \/ d1 - d0 > stuckdist
	}
	transition t18 {
		from AvoidingAgain
		to GettingOut
		condition not ( since ( t ) < stuckperiod \/ d1 - d0 > stuckdist )
	}
	transition t19 {
		from GettingOut
		to Found
		trigger stop
	}
	transition t20 {
		from GettingOut
		to Waiting
		trigger resume
	}
	transition t21 {
		from GettingOut
		to Going
		trigger turn ? a
	}
	transition t22 {
		from Found
		to Found
		trigger stop
	}
}

controller Movement_Ctrl {
	uses Inputs uses Outputs uses Shared requires Movement_State requires Constants requires Sensors requires LOperations
	sref stm_ref0 = Movement
	connection Movement_Ctrl on stop to stm_ref0 on stop
	connection Movement_Ctrl on resume to stm_ref0 on resume
	connection Movement_Ctrl on turn to stm_ref0 on turn
	connection Movement_Ctrl on obstacle to stm_ref0 on obstacle
	connection stm_ref0 on randomWalk to Movement_Ctrl on randomWalk
	connection stm_ref0 on flag to Movement_Ctrl on flag
	connection stm_ref0 on changeDirection to Movement_Ctrl on changeDirection
	connection stm_ref0 on shortRandomWalk to Movement_Ctrl on shortRandomWalk
}

module GasAnalysis_System_Module {
	robotic platform GasAnalysis_System_Platform {
		provides Sensors provides Actuators provides Constants
		event gas : Seq(GasSensor)
		event obstacle : Loc
		event randomWalk
		event flag
		event changeDirection : Loc
		event shortRandomWalk
	}
	cref ctrl_ref0 = GasAnalysis_Ctrl
	cref ctrl_ref1 = Movement_Ctrl
	connection GasAnalysis_System_Platform on gas to ctrl_ref0 on gas
	connection GasAnalysis_System_Platform on obstacle to ctrl_ref1 on obstacle
	connection ctrl_ref1 on randomWalk to GasAnalysis_System_Platform on randomWalk
	connection ctrl_ref1 on flag to GasAnalysis_System_Platform on flag
	connection ctrl_ref1 on changeDirection to GasAnalysis_System_Platform on changeDirection
	connection ctrl_ref1 on shortRandomWalk to GasAnalysis_System_Platform on shortRandomWalk
	connection ctrl_ref0 on stop to ctrl_ref1 on stop
	connection ctrl_ref0 on resume to ctrl_ref1 on resume
	connection ctrl_ref0 on turn to ctrl_ref1 on turn
}

