diagram LreController

datatype Obstacle {
	nsRelDist : real
	ewRelDist : real
	obsDepth : real
	obsNsVel : real
	obsEwVel : real
	obsRoc : real
}

function odist ( index : nat ) : real { }
function hdist ( index : nat ) : real { }
function vdist ( index : nat ) : real { }
function nsRelDist ( x : real ) : real { }
function ewRelDist ( x : real ) : real { }
function obsNsVel ( x : real ) : real { }
function obsEwVel ( x : real ) : real { }
function sqrt ( x : real ) : real { }

interface Inputs {
	event reqVel : real
	event reqHdng : real
	event reqMOM
	event reqOCM
	event endTask
	event reqHCM
	event tick
}

interface Outputs {
	event advVel : real
	event advHdng : real
}

interface Sensors {
	var NO_OBSTACLE_DIST : real
	var depth : real
	var nsVel : real
	var ewVel : real
	var rateOfClimb : real
	var closestDynamicIndex : nat
	var closestStaticIndex : nat
}

interface Actuators {
}

interface LreController_State {
	var inOpez : boolean
	var hvel : real
	var vvel : real
	var vel : real
	var cstc : nat
	var cdyn : nat
	var cda : real
	var tcpa : real
	var opVel : real
	var opHdng : real
	var closingNsVel : real
	var closingEwVel : real
	var relNs : real
	var relEw : real
	var closingSpeedSq : real
}

interface Constants {
	const minSafeDist : real = 1
	const staticObsHorizDist : real = 1
	const staticObsDfltVertDist : real = 1
	const staticObsVertDist : real = 1
}

operation CalcCDyn ( ) {
	requires LreController_State requires Sensors
	initial i0
	final f0
	transition t0 {
		from i0
		to f0
		action cdyn = closestDynamicIndex
	}
}

operation CalcCPA ( ) {
	requires LreController_State requires Sensors requires Constants
	initial i0
	final f0
	transition t0 {
		from i0
		to f0
		action relNs = nsRelDist ( cdyn ) ; relEw = ewRelDist ( cdyn ) ; closingNsVel = obsNsVel ( cdyn ) ; closingEwVel = obsEwVel ( cdyn ) ; closingSpeedSq = closingNsVel * closingNsVel + closingEwVel * closingEwVel ; tcpa = -relNs * closingNsVel + relEw * closingEwVel / closingSpeedSq ; cda = sqrt ( relNs + closingNsVel * tcpa * relNs + closingNsVel * tcpa + relEw + closingEwVel * tcpa * relEw + closingEwVel * tcpa )
	}
}

operation CalcCStc ( ) {
	requires LreController_State requires Sensors
	initial i0
	final f0
	transition t0 {
		from i0
		to f0
		action cstc = closestStaticIndex
	}
}

operation CalcVel ( ) {
	requires LreController_State requires Sensors
	initial i0
	final f0
	transition t0 {
		from i0
		to f0
		action hvel = sqrt ( nsVel * nsVel + ewVel * ewVel ) ; vvel = rateOfClimb ; vel = sqrt ( hvel * hvel + vvel * vvel )
	}
}

operation CheckOPEZ ( ) {
	requires LreController_State requires Sensors requires Constants
	initial i0
	final f0
	transition t0 {
		from i0
		to f0
		action inOpez = ( odist ( cstc ) <= minSafeDist \/ depth <= 0 )
	}
}

stm LreController {
	uses Inputs uses Outputs requires LreController_State requires Constants
	var v : real
	state HCM {
		entry advVel ! 0
	}
	state MOM {
		entry advVel ! 1
	}
	state OCM {
	}
	state CAM {
	}
	initial i0
	transition t_init {
		from i0
		to OCM
	}
	transition t1 {
		from OCM
		to OCM
		trigger reqVel ? opVel
		action advVel ! opVel
	}
	transition t2 {
		from OCM
		to OCM
		trigger reqHdng ? opHdng
		action advHdng ! opHdng
	}
	transition t3 {
		from OCM
		to MOM
		trigger reqMOM
		condition vel <= 1 /\ not ( inOpez ) /\ odist ( cdyn ) > minSafeDist /\ odist ( cstc ) > minSafeDist
	}
	transition t4 {
		from MOM
		to OCM
		trigger reqOCM
	}
	transition t5 {
		from MOM
		to OCM
		trigger endTask
		action advVel ! 0
	}
	transition t6 {
		from MOM
		to HCM
		trigger reqHCM
	}
	transition t7 {
		from MOM
		to OCM
		trigger tick
		condition inOpez
	}
	transition t8 {
		from MOM
		to CAM
		trigger tick
		condition not ( inOpez ) /\ cda < minSafeDist /\ tcpa >= 0
	}
	transition t9 {
		from MOM
		to HCM
		trigger tick
		condition not ( inOpez ) /\ not ( cda < minSafeDist /\ tcpa >= 0 ) /\ hvel >= 1 /\ hdist ( cstc ) <= staticObsHorizDist
	}
	transition t10 {
		from MOM
		to HCM
		trigger tick
		condition not ( inOpez ) /\ not ( cda < minSafeDist /\ tcpa >= 0 ) /\ vdist ( cstc ) <= staticObsDfltVertDist
	}
	transition t11 {
		from MOM
		to HCM
		trigger tick
		condition not ( inOpez ) /\ not ( cda < minSafeDist /\ tcpa >= 0 ) /\ vvel >= 1 /\ vdist ( cstc ) <= staticObsVertDist
	}
	transition t12 {
		from HCM
		to OCM
		trigger reqOCM
	}
	transition t13 {
		from HCM
		to OCM
		trigger tick
		condition inOpez
	}
	transition t14 {
		from HCM
		to CAM
		trigger tick
		condition not ( inOpez ) /\ cda < minSafeDist /\ tcpa >= 0
	}
	transition t15 {
		from HCM
		to MOM
		trigger tick
		condition not ( inOpez ) /\ not ( cda < minSafeDist /\ tcpa >= 0 ) /\ not ( hdist ( cstc ) <= staticObsHorizDist ) /\ not ( vdist ( cstc ) <= staticObsVertDist )
	}
	transition t16 {
		from CAM
		to OCM
		trigger reqOCM
	}
	transition t17 {
		from CAM
		to OCM
		trigger tick
		condition not ( cda < minSafeDist )
		action advVel ! 0
	}
}

controller LreController_Ctrl {
	uses Inputs uses Outputs requires LreController_State requires Constants requires Sensors
	sref stm_ref0 = LreController
	opref op_ref0 = CalcCDyn
	opref op_ref1 = CalcCPA
	opref op_ref2 = CalcCStc
	opref op_ref3 = CalcVel
	opref op_ref4 = CheckOPEZ
	connection LreController_Ctrl on reqVel to stm_ref0 on reqVel
	connection LreController_Ctrl on reqHdng to stm_ref0 on reqHdng
	connection LreController_Ctrl on reqMOM to stm_ref0 on reqMOM
	connection LreController_Ctrl on reqOCM to stm_ref0 on reqOCM
	connection LreController_Ctrl on endTask to stm_ref0 on endTask
	connection LreController_Ctrl on reqHCM to stm_ref0 on reqHCM
	connection LreController_Ctrl on tick to stm_ref0 on tick
	connection stm_ref0 on advVel to LreController_Ctrl on advVel
	connection stm_ref0 on advHdng to LreController_Ctrl on advHdng
}

module LreController_Module {
	robotic platform LreController_Platform {
		provides Sensors provides Actuators provides Constants
		event reqVel : real
		event reqHdng : real
		event reqMOM
		event reqOCM
		event endTask
		event reqHCM
		event tick
		event advVel : real
		event advHdng : real
	}
	cref ctrl_ref0 = LreController_Ctrl
	connection LreController_Platform on reqVel to ctrl_ref0 on reqVel
	connection LreController_Platform on reqHdng to ctrl_ref0 on reqHdng
	connection LreController_Platform on reqMOM to ctrl_ref0 on reqMOM
	connection LreController_Platform on reqOCM to ctrl_ref0 on reqOCM
	connection LreController_Platform on endTask to ctrl_ref0 on endTask
	connection LreController_Platform on reqHCM to ctrl_ref0 on reqHCM
	connection LreController_Platform on tick to ctrl_ref0 on tick
	connection ctrl_ref0 on advVel to LreController_Platform on advVel
	connection ctrl_ref0 on advHdng to LreController_Platform on advHdng
}

