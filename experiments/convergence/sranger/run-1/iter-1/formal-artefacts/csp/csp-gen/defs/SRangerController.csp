				    const_SRangerController_obstacleThreshold,
				    const_SRangerController_turnVel,
				    const_SRangerController_turnDuration,
				    const_SRangerController_moveVel))
		)
	
	IteratedBehaviour_VS_O(id__,
			    const_SRangerController_obstacleThreshold,
			    const_SRangerController_turnVel,
			    const_SRangerController_turnDuration,
			    const_SRangerController_moveVel) = 
		dbisim((MachineBody_VS_O(id__,
				    const_SRangerController_obstacleThreshold,
				    const_SRangerController_turnVel,
				    const_SRangerController_turnDuration,
				    const_SRangerController_moveVel))
		)
	
	Stateful_VS_O(id__,
			    const_SRangerController_obstacleThreshold,
			    const_SRangerController_turnVel,
			    const_SRangerController_turnDuration,
			    const_SRangerController_moveVel) = 
		dbisim((
			(Behaviour_VS_O(id__,
					    const_SRangerController_obstacleThreshold,
					    const_SRangerController_turnVel,
					    const_SRangerController_turnDuration,
					    const_SRangerController_moveVel) [| union(getsetLocalChannels,{terminate}) |] varMemory(id__,
					    const_SRangerController_obstacleThreshold,
					    const_SRangerController_turnVel,
					    const_SRangerController_turnDuration,
					    const_SRangerController_moveVel))
		 	\getsetLocalChannels
		)
		)
	
	IteratedStateful_VS_O(id__,
			    const_SRangerController_obstacleThreshold,
			    const_SRangerController_turnVel,
			    const_SRangerController_turnDuration,
			    const_SRangerController_moveVel) =
		(Behaviour_VS_O(id__,
				    const_SRangerController_obstacleThreshold,
				    const_SRangerController_turnVel,
				    const_SRangerController_turnDuration,
				    const_SRangerController_moveVel))
	
	-- END
	
	-- Memory
	-- Memory variables
	
	-- varMemory process
	varMemory(id__,
			    const_SRangerController_obstacleThreshold,
			    const_SRangerController_turnVel,
			    const_SRangerController_turnDuration,
			    const_SRangerController_moveVel) = terminate -> SKIP
	
	getsetLocalChannels = {||}
	
	-- Definition of the behaviour of state machines (default, optimised, visible, visible and optimised)
	FVS__(id__,
			    const_SRangerController_obstacleThreshold,
			    const_SRangerController_turnVel,
			    const_SRangerController_turnDuration,
			    const_SRangerController_moveVel) = STM_VS_O(id__,
			    const_SRangerController_obstacleThreshold,
			    const_SRangerController_turnVel,
			    const_SRangerController_turnDuration,
			    const_SRangerController_moveVel)
	
	D__(id__,
			    const_SRangerController_obstacleThreshold,
			    const_SRangerController_turnVel,
			    const_SRangerController_turnDuration,
			    const_SRangerController_moveVel) = STM(id__,
			    const_SRangerController_obstacleThreshold,
			    const_SRangerController_turnVel,
			    const_SRangerController_turnDuration,
			    const_SRangerController_moveVel) \ internal_events
	O__(id__,
			    const_SRangerController_obstacleThreshold,
			    const_SRangerController_turnVel,
			    const_SRangerController_turnDuration,
			    const_SRangerController_moveVel) = sbisim(diamond(D__(id__,
			    const_SRangerController_obstacleThreshold,
			    const_SRangerController_turnVel,
			    const_SRangerController_turnDuration,
			    const_SRangerController_moveVel)))
	VS__(id__,
			    const_SRangerController_obstacleThreshold,
			    const_SRangerController_turnVel,
			    const_SRangerController_turnDuration,
			    const_SRangerController_moveVel) = FVS__(id__,
			    const_SRangerController_obstacleThreshold,
			    const_SRangerController_turnVel,
			    const_SRangerController_turnDuration,
			    const_SRangerController_moveVel)
	VS_O__(id__,
			    const_SRangerController_obstacleThreshold,
			    const_SRangerController_turnVel,
			    const_SRangerController_turnDuration,
			    const_SRangerController_moveVel) = sbisim(diamond(FVS__(id__,
			    const_SRangerController_obstacleThreshold,
			    const_SRangerController_turnVel,
			    const_SRangerController_turnDuration,
			    const_SRangerController_moveVel)))
	HEXT__(id__,
			    const_SRangerController_obstacleThreshold,
			    const_SRangerController_turnVel,
			    const_SRangerController_turnDuration,
			    const_SRangerController_moveVel) = O__(id__,
			    const_SRangerController_obstacleThreshold,
			    const_SRangerController_turnVel,
			    const_SRangerController_turnDuration,
			    const_SRangerController_moveVel) [|shared_variable_events|] SKIP
	HUP__(id__,
			    const_SRangerController_obstacleThreshold,
			    const_SRangerController_turnVel,
			    const_SRangerController_turnDuration,
			    const_SRangerController_moveVel) = O__(id__,
			    const_SRangerController_obstacleThreshold,
			    const_SRangerController_turnVel,
			    const_SRangerController_turnDuration,
			    const_SRangerController_moveVel) [|{share__}|] SKIP
	
	-- Shared memory
	-- Shared memory variables
	Memory_NO_READING_DEFAULT(NO_READING_DEFAULT) =
		get_NO_READING_DEFAULT!NO_READING_DEFAULT -> Memory_NO_READING_DEFAULT(NO_READING_DEFAULT)
		[]
		set_NO_READING_DEFAULT?x__ -> Memory_NO_READING_DEFAULT(x__)
		[]
		set_EXT_NO_READING_DEFAULT?x__ -> Memory_NO_READING_DEFAULT(x__)
		[]
		terminate -> SKIP
	Memory_distance(distance) =
		get_distance!distance -> Memory_distance(distance)
		[]
		set_distance?x__ -> Memory_distance(x__)
		[]
		set_EXT_distance?x__ -> Memory_distance(x__)
		[]
		terminate -> SKIP
	Memory_clockResetTime(clockResetTime) =
		get_clockResetTime!clockResetTime -> Memory_clockResetTime(clockResetTime)
		[]
		set_clockResetTime?x__ -> Memory_clockResetTime(x__)
		[]
		set_EXT_clockResetTime?x__ -> Memory_clockResetTime(x__)
		[]
		terminate -> SKIP
	
	-- sharedVarMemory process
	sharedVarMemory(id__,
			    const_SRangerController_obstacleThreshold,
			    const_SRangerController_turnVel,
			    const_SRangerController_turnDuration,
			    const_SRangerController_moveVel) = Memory_NO_READING_DEFAULT(0)
	[| { terminate } |] (
	Memory_distance(0)
	[| { terminate } |] (
	Memory_clockResetTime(0)
	)
	)
	
	sharedVarSync = {|get_NO_READING_DEFAULT,set_NO_READING_DEFAULT,set_EXT_NO_READING_DEFAULT,get_distance,set_distance,set_EXT_distance,get_clockResetTime,set_clockResetTime,set_EXT_clockResetTime|}
	
	sharedVarHide = {|get_NO_READING_DEFAULT,get_distance,get_clockResetTime|}
endmodule
