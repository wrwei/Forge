													          const_SRangerController_obstaclethreshold,
													          const_SRangerController_turnduration))
										)\{|get_CLID_Final|}
									)
									[| {|get_CLID_Moving,Moving::entered,terminate|} |]
									dbisim(Clock_CLID_Moving(id__,0,
											          const_SRangerController_obstaclethreshold,
											          const_SRangerController_turnduration))
								)\{|get_CLID_Moving|}
							)
							) \ union(stateClockSync,enteredSS)
						)
						)
					
					Stateful(id__,
							    const_SRangerController_obstaclethreshold,
							    const_SRangerController_turnduration) = 
						((let
							getsetLocalChannels = {||}
							clockSync = {|get_CLID_clockResetTime,clockReset.CLID_clockResetTime|}
						within
							(Behaviour(id__,
									    const_SRangerController_obstaclethreshold,
									    const_SRangerController_turnduration) 
							 [| union(union(getsetLocalChannels,clockSync),{terminate}) |] 
							 (varMemory(id__,
							 		    const_SRangerController_obstaclethreshold,
							 		    const_SRangerController_turnduration) [| {terminate} |] Clocks(id__,
							 		          const_SRangerController_obstaclethreshold,
							 		          const_SRangerController_turnduration))
						 	)\union(getsetLocalChannels,clockSync)
						)
						)
					
					IteratedStateful(id__,
							    const_SRangerController_obstaclethreshold,
							    const_SRangerController_turnduration) =
						(dbisim(
							sbisim(
								IteratedBehaviour(id__,
										    const_SRangerController_obstaclethreshold,
										    const_SRangerController_turnduration)
								[| {|get_CLID_clockResetTime,clockReset.CLID_clockResetTime,terminate|} |]
								dbisim(Clock_CLID_clockResetTime(id__,0,
										          const_SRangerController_obstaclethreshold,
										          const_SRangerController_turnduration))
							)\{|get_CLID_clockResetTime,clockReset.CLID_clockResetTime|}
						)
						)
					
					-- Visible counterparts
					MachineBody_VS_O(id__,
							    const_SRangerController_obstaclethreshold,
							    const_SRangerController_turnduration) = 
						dbisim((
						let
							finalNodesEntered = {||}
						within
							(dbisim((dbisim((let
								-- IMPLEMENTATION NOTE:
								-- Here the 'enter' channel set is calculated explicitly because of the use of CSPM 
								-- modules for defining the semantics of each node.
								enterSS = {|
								Final::enter,
								Turning::enter,
								Moving::enter,
								i0::enter
								|}
								hideSet = union(enterSS,{|exit,exited,internal__|})
							within 
								((let
									-- IMPLEMENTATION NOTE: the channel set 'enter' is calculated explicitly
									-- because CSPM modules are used for the semantics of Node.
									flowevts = union(enterSS,{|exit,exited,interrupt|})
									transSync = {|internal__.NID_i0,endTask__.NID_Moving.in,obstacle__.NID_Moving.in,tick__.NID_Moving.in,endTask__.NID_Turning.in,internal__.NID_Turning,tick__.NID_Turning.in|}
								within
									((
									 (((-- RULE composeNodes(nc:NodeContainer)^nops : CSPProcess
									   Final::VS_O__(id__,
									   		    const_SRangerController_obstaclethreshold,
									   		    const_SRangerController_turnduration)
									   [| { share__, terminate } |] (
									   Turning::VS_O__(id__,
									   		    const_SRangerController_obstaclethreshold,
									   		    const_SRangerController_turnduration)
									   [| { share__, terminate } |] (
									   Moving::VS_O__(id__,
									   		    const_SRangerController_obstaclethreshold,
									   		    const_SRangerController_turnduration)
									   [| { share__, terminate } |] (
									   i0::VS_O__(id__,
									   		    const_SRangerController_obstaclethreshold,
									   		    const_SRangerController_turnduration)
									   )
									   )
									   )
									 )
									 [[Final::interrupt <- x__ | x__ <- {|interrupt|}]]
									 [[Turning::interrupt <- x__ | x__ <- {|interrupt,endTask__.NID_Turning.in,internal__.NID_Turning,tick__.NID_Turning.in|}]]
									 [[Moving::interrupt <- x__ | x__ <- {|interrupt,endTask__.NID_Moving.in,obstacle__.NID_Moving.in,tick__.NID_Moving.in|}]]
									 [[i0::interrupt <- x__ | x__ <- {|internal__.NID_i0|}]]
									 )
									  [[ share__ <- x__ | x__ <- {| share__ |} ]] 
									  [[set_distance <- setL_distance,clockReset.CLID_clockResetTime <- clockResetL.CLID_clockResetTime]]
									 )
									 [| union(union(union(flowevts,transSync),{terminate}),{|share__
									 			,setL_distance
									 			,clockResetL.CLID_clockResetTime
									|}) |]
									 ((i0::enter -> Transitions(id__,
									 		    const_SRangerController_obstaclethreshold,
									 		    const_SRangerController_turnduration))
									  [[ share__ <- x__ | x__ <- {| share__,setL_distance,clockResetL.CLID_clockResetTime |} ]]
									 )
									)[[setL_distance <- set_distance,clockResetL.CLID_clockResetTime <- clockReset.CLID_clockResetTime]]
									)
								)
								 \ hideSet)
								[[
									endTask__.x____ <- endTask,
									obstacle__.x____ <- obstacle,
									tick__.x____ <- tick,
									move__.x____ <- move
									| x____ <- NIDS
								]]
							)
							)
							 [| union(stateClockSync,{terminate}) |]
							 StateClocks(id__,
							 		          const_SRangerController_obstaclethreshold,
							 		          const_SRangerController_turnduration)
							)\diff(stateClockSync,enteredSS))
							 [| {| interrupt |} |] SKIP)
						)
						)
					
					Behaviour_VS_O(id__,
							    const_SRangerController_obstaclethreshold,
							    const_SRangerController_turnduration) = 
						dbisim((let
							stateClockSync = {|get_CLID_Moving,Moving::entered,get_CLID_Final,Final::entered,get_CLID_Turning,Turning::entered|}
						 within
							(MachineBody_VS_O(id__,
									    const_SRangerController_obstaclethreshold,
									    const_SRangerController_turnduration) [| union(stateClockSync,{terminate}) |] StateClocks(id__,
									          const_SRangerController_obstaclethreshold,
									          const_SRangerController_turnduration)) \ diff(union(stateClockSync,enteredSS),enteredSS)
						)
						)
					
					IteratedBehaviour_VS_O(id__,
							    const_SRangerController_obstaclethreshold,
							    const_SRangerController_turnduration) = 
						dbisim((let
							stateClockSync = {|get_CLID_Moving,Moving::entered,get_CLID_Final,Final::entered,get_CLID_Turning,Turning::entered|}
						 within
							(dbisim(
								sbisim(
									dbisim(
										sbisim(
											dbisim(
												sbisim(
													MachineBody_VS_O(id__,
															    const_SRangerController_obstaclethreshold,
															    const_SRangerController_turnduration)
													[| {|get_CLID_Turning,Turning::entered,terminate|} |]
													dbisim(Clock_CLID_Turning(id__,0,
															          const_SRangerController_obstaclethreshold,
															          const_SRangerController_turnduration))
												)\{|get_CLID_Turning|}
											)
											[| {|get_CLID_Final,Final::entered,terminate|} |]
											dbisim(Clock_CLID_Final(id__,0,
													          const_SRangerController_obstaclethreshold,
													          const_SRangerController_turnduration))
										)\{|get_CLID_Final|}
									)
									[| {|get_CLID_Moving,Moving::entered,terminate|} |]
									dbisim(Clock_CLID_Moving(id__,0,
											          const_SRangerController_obstaclethreshold,
											          const_SRangerController_turnduration))
								)\{|get_CLID_Moving|}
							)
							) \ diff(union(stateClockSync,enteredSS),enteredSS)
						)
						)
					
					Stateful_VS_O(id__,
							    const_SRangerController_obstaclethreshold,
							    const_SRangerController_turnduration) = 
						dbisim((let
							getsetLocalChannels = {||}
							clockSync = {|get_CLID_clockResetTime,clockReset.CLID_clockResetTime|}
						within
							(Behaviour_VS_O(id__,
									    const_SRangerController_obstaclethreshold,
									    const_SRangerController_turnduration) 
							 [| union(union(getsetLocalChannels,clockSync),{terminate}) |] 
							 (varMemory(id__,
							 		    const_SRangerController_obstaclethreshold,
							 		    const_SRangerController_turnduration) [| {terminate} |] Clocks(id__,
							 		          const_SRangerController_obstaclethreshold,
							 		          const_SRangerController_turnduration))
						 	)\union(getsetLocalChannels,clockSync)
						)
						)
					
					IteratedStateful_VS_O(id__,
							    const_SRangerController_obstaclethreshold,
							    const_SRangerController_turnduration) =
						(dbisim(
							sbisim(
								IteratedBehaviour_VS_O(id__,
										    const_SRangerController_obstaclethreshold,
										    const_SRangerController_turnduration)
								[| {|get_CLID_clockResetTime,clockReset.CLID_clockResetTime,terminate|} |]
								dbisim(Clock_CLID_clockResetTime(id__,0,
										          const_SRangerController_obstaclethreshold,
										          const_SRangerController_turnduration))
							)\{|get_CLID_clockResetTime,clockReset.CLID_clockResetTime|}
						)
						)
					
					-- END
					
					-- Memory
					-- Memory variables
					
					-- varMemory process
					varMemory(id__,
							    const_SRangerController_obstaclethreshold,
							    const_SRangerController_turnduration) = terminate -> SKIP
					
					getsetLocalChannels = {||}
					
					-- Definition of the behaviour of state machines (default, optimised, visible, visible and optimised)
					FVS__(id__,
							    const_SRangerController_obstaclethreshold,
							    const_SRangerController_turnduration) = STM_VS_O(id__,
							    const_SRangerController_obstaclethreshold,
							    const_SRangerController_turnduration) \ localClockResets
					D__(id__,
							    const_SRangerController_obstaclethreshold,
							    const_SRangerController_turnduration) = timed_priority(STM(id__,
							    const_SRangerController_obstaclethreshold,
							    const_SRangerController_turnduration) \ union(internal_events,localClockResets))
					O__(id__,
							    const_SRangerController_obstaclethreshold,
							    const_SRangerController_turnduration) = dbisim(D__(id__,
							    const_SRangerController_obstaclethreshold,
							    const_SRangerController_turnduration))
					VS__(id__,
							    const_SRangerController_obstaclethreshold,
							    const_SRangerController_turnduration) = FVS__(id__,
							    const_SRangerController_obstaclethreshold,
							    const_SRangerController_turnduration)
					VS_O__(id__,
							    const_SRangerController_obstaclethreshold,
							    const_SRangerController_turnduration) = dbisim(FVS__(id__,
							    const_SRangerController_obstaclethreshold,
							    const_SRangerController_turnduration))
					HEXT__(id__,
							    const_SRangerController_obstaclethreshold,
							    const_SRangerController_turnduration) = O__(id__,
							    const_SRangerController_obstaclethreshold,
							    const_SRangerController_turnduration) [|shared_variable_events|] SKIP
					FVS_C__(id__,
							    const_SRangerController_obstaclethreshold,
							    const_SRangerController_turnduration) = dbisim(timed_priority(STM(id__,
							    const_SRangerController_obstaclethreshold,
							    const_SRangerController_turnduration) \ internal_events))
					HUP__(id__,
							    const_SRangerController_obstaclethreshold,
							    const_SRangerController_turnduration) = timed_priority(O__(id__,
							    const_SRangerController_obstaclethreshold,
							    const_SRangerController_turnduration) [|{share__}|] SKIP)
					
					-- Clocks
					Clock_CLID_clockResetTime(id__,x__,
							          const_SRangerController_obstaclethreshold,
							          const_SRangerController_turnduration) = 
						TimeOut_1(
							clockReset.CLID_clockResetTime -> Clock_CLID_clockResetTime(id__,0,
									          const_SRangerController_obstaclethreshold,
									          const_SRangerController_turnduration)
							[]
							get_CLID_clockResetTime!x__ -> Clock_CLID_clockResetTime(id__,x__,
									          const_SRangerController_obstaclethreshold,
									          const_SRangerController_turnduration)
							[]
							terminate -> SKIP,Clock_CLID_clockResetTime(id__,clock_type_plus(x__,1,CLID_clockResetTime_clock_type(id__,
									          const_SRangerController_obstaclethreshold,
									          const_SRangerController_turnduration)),
									          const_SRangerController_obstaclethreshold,
									          const_SRangerController_turnduration))
					
					Clocks(id__,
							          const_SRangerController_obstaclethreshold,
							          const_SRangerController_turnduration) = dbisim(Clock_CLID_clockResetTime(id__,0,
							          const_SRangerController_obstaclethreshold,
							          const_SRangerController_turnduration))
					
					clockSync = {|get_CLID_clockResetTime,clockReset.CLID_clockResetTime|}
					
					Clock_CLID_Moving(id__,x__,
							          const_SRangerController_obstaclethreshold,
							          const_SRangerController_turnduration) = 
						TimeOut_1(
							Moving::entered -> Clock_CLID_Moving(id__,0,
									          const_SRangerController_obstaclethreshold,
									          const_SRangerController_turnduration)
							[]
							get_CLID_Moving!x__ -> Clock_CLID_Moving(id__,x__,
									          const_SRangerController_obstaclethreshold,
									          const_SRangerController_turnduration)
							[]
							terminate -> SKIP,Clock_CLID_Moving(id__,clock_type_plus(x__,1,CLID_Moving_clock_type(id__,
									          const_SRangerController_obstaclethreshold,
									          const_SRangerController_turnduration)),
									          const_SRangerController_obstaclethreshold,
									          const_SRangerController_turnduration))
					Clock_CLID_Final(id__,x__,
							          const_SRangerController_obstaclethreshold,
							          const_SRangerController_turnduration) = 
						TimeOut_1(
							Final::entered -> Clock_CLID_Final(id__,0,
									          const_SRangerController_obstaclethreshold,
									          const_SRangerController_turnduration)
							[]
							get_CLID_Final!x__ -> Clock_CLID_Final(id__,x__,
									          const_SRangerController_obstaclethreshold,
									          const_SRangerController_turnduration)
							[]
							terminate -> SKIP,Clock_CLID_Final(id__,clock_type_plus(x__,1,CLID_Final_clock_type(id__,
									          const_SRangerController_obstaclethreshold,
									          const_SRangerController_turnduration)),
									          const_SRangerController_obstaclethreshold,
									          const_SRangerController_turnduration))
					Clock_CLID_Turning(id__,x__,
							          const_SRangerController_obstaclethreshold,
							          const_SRangerController_turnduration) = 
						TimeOut_1(
							Turning::entered -> Clock_CLID_Turning(id__,0,
									          const_SRangerController_obstaclethreshold,
									          const_SRangerController_turnduration)
							[]
							get_CLID_Turning!x__ -> Clock_CLID_Turning(id__,x__,
									          const_SRangerController_obstaclethreshold,
									          const_SRangerController_turnduration)
							[]
							terminate -> SKIP,Clock_CLID_Turning(id__,clock_type_plus(x__,1,CLID_Turning_clock_type(id__,
									          const_SRangerController_obstaclethreshold,
									          const_SRangerController_turnduration)),
									          const_SRangerController_obstaclethreshold,
									          const_SRangerController_turnduration))
					
					StateClocks(id__,
							          const_SRangerController_obstaclethreshold,
							          const_SRangerController_turnduration) = dbisim(Clock_CLID_Moving(id__,0,
							          const_SRangerController_obstaclethreshold,
							          const_SRangerController_turnduration))
					[| { terminate } |] (
					dbisim(Clock_CLID_Final(id__,0,
							          const_SRangerController_obstaclethreshold,
							          const_SRangerController_turnduration))
					[| { terminate } |] (
					dbisim(Clock_CLID_Turning(id__,0,
							          const_SRangerController_obstaclethreshold,
							          const_SRangerController_turnduration))
					)
					)
					
					stateClockSync = {|get_CLID_Moving,Moving::entered,get_CLID_Final,Final::entered,get_CLID_Turning,Turning::entered|}
					
					-- Shared memory
					-- Shared memory variables
					Memory_NO_READING_DEFAULT(NO_READING_DEFAULT) =
						get_NO_READING_DEFAULT!NO_READING_DEFAULT -> Memory_NO_READING_DEFAULT(NO_READING_DEFAULT)
						[]
						set_NO_READING_DEFAULT?x__ -> Memory_NO_READING_DEFAULT(x__)
						[]
						set_EXT_NO_READING_DEFAULT?x__ -> Memory_NO_READING_DEFAULT(x__)
						[]
						terminate -> SKIP
					Memory_lastReading(lastReading) =
						get_lastReading!lastReading -> Memory_lastReading(lastReading)
						[]
						set_lastReading?x__ -> Memory_lastReading(x__)
						[]
						set_EXT_lastReading?x__ -> Memory_lastReading(x__)
						[]
						terminate -> SKIP
					Memory_distance(distance) =
						get_distance!distance -> Memory_distance(distance)
						[]
						set_distance?x__ -> Memory_distance(x__)
						[]
						set_EXT_distance?x__ -> Memory_distance(x__)
						[]
						terminate -> SKIP
					Memory_clockResetTime(clockResetTime) =
						get_clockResetTime!clockResetTime -> Memory_clockResetTime(clockResetTime)
						[]
						set_clockResetTime?x__ -> Memory_clockResetTime(x__)
						[]
						set_EXT_clockResetTime?x__ -> Memory_clockResetTime(x__)
						[]
						terminate -> SKIP
					
					-- sharedVarMemory process
					sharedVarMemory(id__,
							    const_SRangerController_obstaclethreshold,
							    const_SRangerController_turnduration) = Memory_NO_READING_DEFAULT(0)
					[| { terminate } |] (
					Memory_lastReading(0)
					[| { terminate } |] (
					Memory_distance(0)
					[| { terminate } |] (
					Memory_clockResetTime(0)
					)
					)
					)
					
					sharedVarSync = {|get_NO_READING_DEFAULT,set_NO_READING_DEFAULT,set_EXT_NO_READING_DEFAULT,get_lastReading,set_lastReading,set_EXT_lastReading,get_distance,set_distance,set_EXT_distance,get_clockResetTime,set_clockResetTime,set_EXT_clockResetTime|}
					
					sharedVarHide = {|get_NO_READING_DEFAULT,get_lastReading,get_distance,get_clockResetTime|}
					}
			endmodule
			
			Timed(OneStep) {
					-- undefined operations
					
					-- declaring controller memory
					Memory(id__, NO_READING_DEFAULT, lastReading, distance, clockResetTime, obstaclethreshold, turnduration) = (
					set_EXT_NO_READING_DEFAULT?x__ -> stm_ref0::set_EXT_NO_READING_DEFAULT!x__ -> 
					Memory(id__,x__,lastReading,distance,clockResetTime,obstaclethreshold,turnduration)
					 []
					set_EXT_lastReading?x__ -> stm_ref0::set_EXT_lastReading!x__ -> 
					Memory(id__,NO_READING_DEFAULT,x__,distance,clockResetTime,obstaclethreshold,turnduration)
					 []
					set_EXT_distance?x__ -> stm_ref0::set_EXT_distance!x__ -> 
					Memory(id__,NO_READING_DEFAULT,lastReading,x__,clockResetTime,obstaclethreshold,turnduration)
					 []
					set_EXT_clockResetTime?x__ -> stm_ref0::set_EXT_clockResetTime!x__ -> 
					Memory(id__,NO_READING_DEFAULT,lastReading,distance,x__,obstaclethreshold,turnduration)
					)
					
					D__(id__,
							    const_SRangerController_Ctrl_obstaclethreshold,
							    const_SRangerController_Ctrl_turnduration) = prioritise(	((
							let
								const_SRangerController_obstaclethreshold = const_SRangerController_Ctrl_obstaclethreshold
								const_SRangerController_turnduration = const_SRangerController_Ctrl_turnduration
							within 
							stm_ref0::D__(id__,
									    const_SRangerController_obstaclethreshold,
									    const_SRangerController_turnduration)[[
								stm_ref0::terminate <- terminate,
								stm_ref0::endTask <- endTask,
								stm_ref0::obstacle <- obstacle,
								stm_ref0::tick <- tick,
								stm_ref0::move <- move,
								stm_ref0::set_NO_READING_DEFAULT <- set_NO_READING_DEFAULT,
								stm_ref0::get_NO_READING_DEFAULT <- get_NO_READING_DEFAULT,
								stm_ref0::set_lastReading <- set_lastReading,
								stm_ref0::get_lastReading <- get_lastReading,
								stm_ref0::set_distance <- set_distance,
								stm_ref0::get_distance <- get_distance,
								stm_ref0::set_clockResetTime <- set_clockResetTime,
								stm_ref0::get_clockResetTime <- get_clockResetTime
							]]
						)
							[|
								union(
									{|
									|},
									{|
										stm_ref0::set_EXT_NO_READING_DEFAULT,stm_ref0::set_EXT_lastReading,stm_ref0::set_EXT_distance,stm_ref0::set_EXT_clockResetTime
									|}
								)
							|]
						Memory(id__, 0, 0, 0, 0, const_SRangerController_Ctrl_obstaclethreshold, const_SRangerController_Ctrl_turnduration)
					)
					\ union(
						{|
						|},
						{|
							stm_ref0::set_EXT_NO_READING_DEFAULT,stm_ref0::set_EXT_lastReading,stm_ref0::set_EXT_distance,stm_ref0::set_EXT_clockResetTime
						|}
					)
					[|{|terminate|}|>SKIP
					,<visibleMemoryEvents,{tock}>)
					
					-- VS version
					VS__(id__,
							    const_SRangerController_Ctrl_obstaclethreshold,
							    const_SRangerController_Ctrl_turnduration) = prioritise(	((
							let
								const_SRangerController_obstaclethreshold = const_SRangerController_Ctrl_obstaclethreshold
								const_SRangerController_turnduration = const_SRangerController_Ctrl_turnduration
							within 
							stm_ref0::VS__(id__,
									    const_SRangerController_obstaclethreshold,
									    const_SRangerController_turnduration)[[
								stm_ref0::terminate <- terminate,
								stm_ref0::endTask <- endTask,
								stm_ref0::obstacle <- obstacle,
								stm_ref0::tick <- tick,
								stm_ref0::move <- move,
								stm_ref0::set_NO_READING_DEFAULT <- set_NO_READING_DEFAULT,
								stm_ref0::get_NO_READING_DEFAULT <- get_NO_READING_DEFAULT,
								stm_ref0::set_lastReading <- set_lastReading,
								stm_ref0::get_lastReading <- get_lastReading,
								stm_ref0::set_distance <- set_distance,
								stm_ref0::get_distance <- get_distance,
								stm_ref0::set_clockResetTime <- set_clockResetTime,
								stm_ref0::get_clockResetTime <- get_clockResetTime
							]]
						)
							[|
								union(
									{|
									|},
									{|
										stm_ref0::set_EXT_NO_READING_DEFAULT,stm_ref0::set_EXT_lastReading,stm_ref0::set_EXT_distance,stm_ref0::set_EXT_clockResetTime
									|}
								)
							|]
						Memory(id__, 0, 0, 0, 0, const_SRangerController_Ctrl_obstaclethreshold, const_SRangerController_Ctrl_turnduration)
					)
					\ union(
						{|
						|},
						{|
							stm_ref0::set_EXT_NO_READING_DEFAULT,stm_ref0::set_EXT_lastReading,stm_ref0::set_EXT_distance,stm_ref0::set_EXT_clockResetTime
						|}
					)
					[|{|terminate|}|>SKIP
					,<visibleMemoryEvents,{tock}>)
				
					-- O version (optimised) THESE TWO PROCESSES SHOULD BE KEPT IN SYNC WITH THE ABOVE TWO
					O__(id__,
							    const_SRangerController_Ctrl_obstaclethreshold,
							    const_SRangerController_Ctrl_turnduration) = dbisim(prioritise(	((
							let
								const_SRangerController_obstaclethreshold = const_SRangerController_Ctrl_obstaclethreshold
								const_SRangerController_turnduration = const_SRangerController_Ctrl_turnduration
							within 
							stm_ref0::O__(id__,
									    const_SRangerController_obstaclethreshold,
