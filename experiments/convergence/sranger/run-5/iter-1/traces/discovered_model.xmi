                </target>
                <executableRef name="now">
                  <type name="double"/>
                  <declaringType name="Clock">
                    <packageRef name="sranger.sensor"/>
                  </declaringType>
                </executableRef>
              </leftOperand>
              <rightOperand xsi:type="spoon:CtFieldRead">
                <variable xsi:type="spoon:CtFieldReference" name="clockResetTime">
                  <type name="double"/>
                  <declaringType name="SRangerController">
