        </statement>
        <statement xsi:type="spoon:CtLocalVariable" name="turnDurationElapsed">
          <type name="boolean"/>
          <assignment xsi:type="spoon:CtBinaryOperator" operatorKind="GE">
            <type name="boolean"/>
            <leftOperand xsi:type="spoon:CtBinaryOperator" operatorKind="MINUS">
              <type name="double"/>
              <leftOperand xsi:type="spoon:CtInvocation">
                <target xsi:type="spoon:CtFieldRead">
