diagram GasAnalysisController

enumeration Angle { Left Right Back Front }
enumeration Loc { left right front }
enumeration Status { noGas gasD }

datatype GasSensor {
	c : Chem
	i : real
}

datatype Chem {
	species : int
}

function analysis ( readings : Seq(GasSensor) ) : Status { }
function intensity ( readings : Seq(GasSensor) ) : real { }
function location ( readings : Seq(GasSensor) ) : Angle { }

interface LOperations {
	move ( p0 : real , p1 : Angle )
}

interface Inputs {
	event gas : Seq(GasSensor)
	event tick
	event obstacle : Loc
}

interface Outputs {
	event randomWalk
	event flag
	event changeDirection : Loc
	event shortRandomWalk
}

interface Shared {
	event stop
	event resume
	event turn : Angle
}

interface Sensors {
	var species : int
	var insAtLeastThr : boolean
	var odometer : real
}

interface Actuators {
}

interface GasAnalysisController_State {
	var gs : Seq(GasSensor)
	var sts : Status
	var ins : real = 0
	var anl : Angle
}

interface MovementController_State {
	var a : Angle
	var d0 : real = 0
	var d1 : real = 0
	var l : Loc
}

interface Constants {
	const lv : real = 1
	const evadeTime : real = 1
	const stuckPeriod : real = 2
	const stuckDist : real = 1
	const outPeriod : real = 1
}

stm GasAnalysisController {
	uses Inputs uses Outputs uses Shared requires GasAnalysisController_State requires Constants requires Sensors
	var v : real
	state Analysis {
		entry sts = analysis ( gs )
	}
	state Reading {
	}
	state Concluded {
		entry send stop
	}
	state NoGas {
		entry send resume
	}
	state GasDetected {
		entry ins = intensity ( gs )
	}
	initial i0
	transition t_init {
		from i0
		to Reading
	}
	transition t1 {
		from Reading
		to Analysis
		trigger gas ? gs
	}
	transition t2 {
		from Analysis
		to NoGas
		condition sts == noGas
	}
	transition t3 {
		from Analysis
		to GasDetected
		condition not ( sts == noGas )
	}
	transition t4 {
		from NoGas
		to Reading
	}
	transition t5 {
		from GasDetected
		to Concluded
		condition insAtLeastThr
	}
	transition t6 {
		from GasDetected
		to Reading
		condition not ( insAtLeastThr )
		action anl = location ( gs ) ; turn ! anl
	}
	transition t7 {
		from Concluded
		to Concluded
		trigger gas ? gs
	}
}

controller GasAnalysisController_Ctrl {
	uses Inputs uses Outputs uses Shared requires GasAnalysisController_State requires Constants requires Sensors
	sref stm_ref0 = GasAnalysisController
	connection GasAnalysisController_Ctrl on gas to stm_ref0 on gas
	connection stm_ref0 on resume to GasAnalysisController_Ctrl on resume
	connection stm_ref0 on stop to GasAnalysisController_Ctrl on stop
	connection stm_ref0 on turn to GasAnalysisController_Ctrl on turn
}

stm MovementController {
	uses Inputs uses Outputs uses Shared requires MovementController_State requires Constants requires Sensors requires LOperations
	var v : real
	clock evadeStart
	state Found {
		entry send flag ; move ( 0 , Front )
	}
	state TryingAgain {
		entry move ( lv , a )
	}
	state GettingOut {
		entry send shortRandomWalk ; wait ( outPeriod )
	}
	state AvoidingAgain {
		entry d1 = odometer
	}
	state Going {
		entry move ( lv , a )
	}
	state Waiting {
		entry send randomWalk
	}
	state Avoiding {
		entry d0 = odometer ; changeDirection ! l ; wait ( evadeTime )
	}
	initial i0
	transition t_init {
		from i0
		to Waiting
	}
	transition t1 {
		from Waiting
		to Found
		trigger stop
	}
	transition t2 {
		from Waiting
		to Waiting
		trigger resume
	}
	transition t3 {
		from Waiting
		to Going
		trigger turn ? a
	}
	transition t4 {
		from Waiting
		to Waiting
		trigger tick
	}
	transition t5 {
		from Going
		to Found
		trigger stop
	}
	transition t6 {
		from Going
		to Waiting
		trigger resume
	}
	transition t7 {
		from Going
		to Going
		trigger turn ? a
	}
	transition t8 {
		from Going
		to Avoiding
		trigger obstacle ? l
		# evadeStart
	}
	transition t9 {
		from Going
		to Going
		trigger tick
	}
	transition t10 {
		from Found
		to Found
		trigger tick
	}
	transition t11 {
		from Avoiding
		to Found
		trigger stop
	}
	transition t12 {
		from Avoiding
		to Waiting
		trigger resume
	}
	transition t13 {
		from Avoiding
		to TryingAgain
		trigger turn ? a
	}
	transition t14 {
		from Avoiding
		to Avoiding
		trigger tick
	}
	transition t15 {
		from TryingAgain
		to Found
		trigger stop
	}
	transition t16 {
		from TryingAgain
		to Waiting
		trigger resume
	}
	transition t17 {
		from TryingAgain
		to TryingAgain
		trigger turn ? a
	}
	transition t18 {
		from TryingAgain
		to AvoidingAgain
		trigger obstacle ? l
	}
	transition t19 {
		from TryingAgain
		to TryingAgain
		trigger tick
	}
	transition t20 {
		from AvoidingAgain
		to Found
		trigger stop
	}
	transition t21 {
		from AvoidingAgain
		to Waiting
		trigger resume
	}
	transition t22 {
		from AvoidingAgain
		to Avoiding
		# evadeStart
		condition since ( evadeStart ) < stuckPeriod \/ d1 - d0 > stuckDist
	}
	transition t23 {
		from AvoidingAgain
		to GettingOut
		condition not ( since ( evadeStart ) < stuckPeriod ) /\ not ( d1 - d0 > stuckDist ) /\ not ( since ( evadeStart ) < stuckPeriod \/ d1 - d0 > stuckDist )
	}
	transition t24 {
		from GettingOut
		to Found
		trigger stop
	}
	transition t25 {
		from GettingOut
		to Waiting
		trigger resume
	}
	transition t26 {
		from GettingOut
		to Going
		trigger turn ? a
	}
	transition t27 {
		from GettingOut
		to GettingOut
		trigger tick
	}
}

controller MovementController_Ctrl {
	uses Inputs uses Outputs uses Shared requires MovementController_State requires Constants requires Sensors requires LOperations
	sref stm_ref0 = MovementController
	connection MovementController_Ctrl on stop to stm_ref0 on stop
	connection MovementController_Ctrl on resume to stm_ref0 on resume
	connection MovementController_Ctrl on turn to stm_ref0 on turn
	connection MovementController_Ctrl on tick to stm_ref0 on tick
	connection MovementController_Ctrl on obstacle to stm_ref0 on obstacle
	connection stm_ref0 on randomWalk to MovementController_Ctrl on randomWalk
	connection stm_ref0 on flag to MovementController_Ctrl on flag
	connection stm_ref0 on changeDirection to MovementController_Ctrl on changeDirection
	connection stm_ref0 on shortRandomWalk to MovementController_Ctrl on shortRandomWalk
}

module GasAnalysisController_System_Module {
	robotic platform GasAnalysisController_System_Platform {
		provides Sensors provides Actuators provides Constants
		event gas : Seq(GasSensor)
		event tick
		event obstacle : Loc
		event randomWalk
		event flag
		event changeDirection : Loc
		event shortRandomWalk
	}
	cref ctrl_ref0 = GasAnalysisController_Ctrl
	cref ctrl_ref1 = MovementController_Ctrl
	connection GasAnalysisController_System_Platform on gas to ctrl_ref0 on gas
	connection GasAnalysisController_System_Platform on tick to ctrl_ref1 on tick
	connection GasAnalysisController_System_Platform on obstacle to ctrl_ref1 on obstacle
	connection ctrl_ref1 on randomWalk to GasAnalysisController_System_Platform on randomWalk
	connection ctrl_ref1 on flag to GasAnalysisController_System_Platform on flag
	connection ctrl_ref1 on changeDirection to GasAnalysisController_System_Platform on changeDirection
	connection ctrl_ref1 on shortRandomWalk to GasAnalysisController_System_Platform on shortRandomWalk
	connection ctrl_ref0 on stop to ctrl_ref1 on stop
	connection ctrl_ref0 on resume to ctrl_ref1 on resume
	connection ctrl_ref0 on turn to ctrl_ref1 on turn
}

