							within
								((
								 (((-- RULE composeNodes(nc:NodeContainer)^nops : CSPProcess
								   AvoidingAgain::D__(id__,
								   		    const_MovementController_lv,
								   		    const_MovementController_evadetime)
								   [| { share__, terminate } |] (
								   Waiting::D__(id__,
								   		    const_MovementController_lv,
								   		    const_MovementController_evadetime)
								   [| { share__, terminate } |] (
								   Going::D__(id__,
								   		    const_MovementController_lv,
								   		    const_MovementController_evadetime)
								   [| { share__, terminate } |] (
								   GettingOut::D__(id__,
								   		    const_MovementController_lv,
								   		    const_MovementController_evadetime)
								   [| { share__, terminate } |] (
								   Final::D__(id__,
								   		    const_MovementController_lv,
								   		    const_MovementController_evadetime)
								   [| { share__, terminate } |] (
								   Avoiding::D__(id__,
								   		    const_MovementController_lv,
								   		    const_MovementController_evadetime)
								   [| { share__, terminate } |] (
								   TryingAgain::D__(id__,
								   		    const_MovementController_lv,
								   		    const_MovementController_evadetime)
								   [| { share__, terminate } |] (
