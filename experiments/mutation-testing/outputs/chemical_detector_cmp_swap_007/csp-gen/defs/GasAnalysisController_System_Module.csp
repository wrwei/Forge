				VS__(id__,
						    const_GasAnalysisController_Ctrl_lv,
						    const_GasAnalysisController_Ctrl_evadetime) = 	((
						let
							const_GasAnalysisController_lv = const_GasAnalysisController_Ctrl_lv
							const_GasAnalysisController_evadetime = const_GasAnalysisController_Ctrl_evadetime
						within 
						stm_ref0::VS__(id__,
								    const_GasAnalysisController_lv,
								    const_GasAnalysisController_evadetime)[[
							stm_ref0::terminate <- terminate,
							stm_ref0::gas <- gas,
							stm_ref0::tick <- tick,
							stm_ref0::resume <- resume,
							stm_ref0::stop <- stop,
							stm_ref0::turn <- turn,
							stm_ref0::set_gs <- set_gs,
							stm_ref0::get_gs <- get_gs,
							stm_ref0::set_sts <- set_sts,
							stm_ref0::get_sts <- get_sts,
							stm_ref0::set_insVal <- set_insVal,
							stm_ref0::get_insVal <- get_insVal,
							stm_ref0::set_anl <- set_anl,
							stm_ref0::get_anl <- get_anl
						]]
						\ {|
							stm_ref0::obstacle,
							stm_ref0::randomWalk,
							stm_ref0::flag,
							stm_ref0::compute
						|}
					)
						[|
							union(
								{|
								|},
								{|
									stm_ref0::set_EXT_gs,stm_ref0::set_EXT_sts,stm_ref0::set_EXT_insVal,stm_ref0::set_EXT_anl
								|}
							)
						|]
					Memory(id__, <>, Status_noGas, 0, Angle_Left, const_GasAnalysisController_Ctrl_lv, const_GasAnalysisController_Ctrl_evadetime)
				)
				\ union(
					{|
					|},
					{|
						stm_ref0::set_EXT_gs,stm_ref0::set_EXT_sts,stm_ref0::set_EXT_insVal,stm_ref0::set_EXT_anl
					|}
				)
				[|{|terminate|}|>SKIP
			
				-- O version (optimised) THESE TWO PROCESSES SHOULD BE KEPT IN SYNC WITH THE ABOVE TWO
				O__(id__,
						    const_GasAnalysisController_Ctrl_lv,
						    const_GasAnalysisController_Ctrl_evadetime) = sbisim(diamond(	((
						let
							const_GasAnalysisController_lv = const_GasAnalysisController_Ctrl_lv
							const_GasAnalysisController_evadetime = const_GasAnalysisController_Ctrl_evadetime
						within 
						stm_ref0::O__(id__,
								    const_GasAnalysisController_lv,
								    const_GasAnalysisController_evadetime)[[
							stm_ref0::terminate <- terminate,
							stm_ref0::gas <- gas,
							stm_ref0::tick <- tick,
							stm_ref0::resume <- resume,
							stm_ref0::stop <- stop,
							stm_ref0::turn <- turn,
							stm_ref0::set_gs <- set_gs,
							stm_ref0::get_gs <- get_gs,
							stm_ref0::set_sts <- set_sts,
							stm_ref0::get_sts <- get_sts,
							stm_ref0::set_insVal <- set_insVal,
							stm_ref0::get_insVal <- get_insVal,
							stm_ref0::set_anl <- set_anl,
							stm_ref0::get_anl <- get_anl
						]]
						\ {|
							stm_ref0::obstacle,
							stm_ref0::randomWalk,
							stm_ref0::flag,
							stm_ref0::compute
						|}
					)
						[|
							union(
								{|
								|},
								{|
									stm_ref0::set_EXT_gs,stm_ref0::set_EXT_sts,stm_ref0::set_EXT_insVal,stm_ref0::set_EXT_anl
								|}
							)
						|]
					dbisim(Memory(id__, <>, Status_noGas, 0, Angle_Left, const_GasAnalysisController_Ctrl_lv, const_GasAnalysisController_Ctrl_evadetime))
				)
				\ union(
					{|
					|},
					{|
						stm_ref0::set_EXT_gs,stm_ref0::set_EXT_sts,stm_ref0::set_EXT_insVal,stm_ref0::set_EXT_anl
					|}
				)
				[|{|terminate|}|>SKIP
				))
								
				-- VS_O version
				VS_O__(id__,
						    const_GasAnalysisController_Ctrl_lv,
						    const_GasAnalysisController_Ctrl_evadetime) = sbisim(diamond(	((
						let
							const_GasAnalysisController_lv = const_GasAnalysisController_Ctrl_lv
							const_GasAnalysisController_evadetime = const_GasAnalysisController_Ctrl_evadetime
						within 
						stm_ref0::VS_O__(id__,
								    const_GasAnalysisController_lv,
								    const_GasAnalysisController_evadetime)[[
							stm_ref0::terminate <- terminate,
							stm_ref0::gas <- gas,
							stm_ref0::tick <- tick,
							stm_ref0::resume <- resume,
							stm_ref0::stop <- stop,
							stm_ref0::turn <- turn,
							stm_ref0::set_gs <- set_gs,
							stm_ref0::get_gs <- get_gs,
							stm_ref0::set_sts <- set_sts,
							stm_ref0::get_sts <- get_sts,
							stm_ref0::set_insVal <- set_insVal,
							stm_ref0::get_insVal <- get_insVal,
							stm_ref0::set_anl <- set_anl,
							stm_ref0::get_anl <- get_anl
						]]
						\ {|
							stm_ref0::obstacle,
							stm_ref0::randomWalk,
							stm_ref0::flag,
							stm_ref0::compute
						|}
					)
						[|
							union(
								{|
								|},
								{|
									stm_ref0::set_EXT_gs,stm_ref0::set_EXT_sts,stm_ref0::set_EXT_insVal,stm_ref0::set_EXT_anl
								|}
							)
						|]
					dbisim(Memory(id__, <>, Status_noGas, 0, Angle_Left, const_GasAnalysisController_Ctrl_lv, const_GasAnalysisController_Ctrl_evadetime))
				)
				\ union(
					{|
					|},
					{|
						stm_ref0::set_EXT_gs,stm_ref0::set_EXT_sts,stm_ref0::set_EXT_insVal,stm_ref0::set_EXT_anl
					|}
