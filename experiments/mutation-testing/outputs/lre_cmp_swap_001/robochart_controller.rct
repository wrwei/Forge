diagram LreController

datatype Obstacle {
	ns_rel_dist : real
	ew_rel_dist : real
	obs_depth : real
	obs_ns_vel : real
	obs_ew_vel : real
	obs_roc : real
}

function odist ( index : int ) : real { }
function nsRelDist ( index : int ) : real { }
function obsNsVel ( index : int ) : real { }
function ewRelDist ( index : int ) : real { }
function obsEwVel ( index : int ) : real { }
function sqrt ( x : real ) : real { }
function hdist ( index : int ) : real { }
function vdist ( index : int ) : real { }

interface Inputs {
	event reqVel : real
	event reqHdng : real
	event reqMOM
	event reqOCM
}

interface Outputs {
	event advVel : real
	event advHdng : real
}

interface Sensors {
	var depth : real
	var ns_vel : real
	var ew_vel : real
	var rate_of_climb : real
	var closestDynamicIndex : int
	var closestStaticIndex : int
}

interface Actuators {
}

interface LreController_State {
	var inOpez : boolean = false
	var vel : real = 0
	var cstc : int = -1
	var cdyn : int = -1
	var cda : real
	var camActive : boolean = false
	var momReturn : boolean = false
	var hvel : real = 0
	var vvel : real = 0
	var tcpa : real = -1
	var hcmActive : boolean = false
}

interface Constants {
	const minsafedist : real = 1
	const staticobshorizdist : real = 1
	const staticobsdfltvertdist : real = 1
	const staticobsvertdist : real = 1
}

operation CalcCDyn ( ) {
	requires LreController_State requires Sensors
	initial i0
	final f0
	transition t0 {
		from i0
		to f0
		action cdyn = closestDynamicIndex
	}
}

operation CalcCPA ( ) {
	requires LreController_State requires Sensors
	initial i0
	final f0
	transition t0 {
		from i0
		to f0
		action tcpa = -(nsRelDist ( cdyn ) * (obsNsVel ( cdyn ) - ns_vel) + ewRelDist ( cdyn ) * (obsEwVel ( cdyn ) - ew_vel)) / ((obsNsVel ( cdyn ) - ns_vel) * (obsNsVel ( cdyn ) - ns_vel) + (obsEwVel ( cdyn ) - ew_vel) * (obsEwVel ( cdyn ) - ew_vel)) ; cda = sqrt ( (nsRelDist ( cdyn ) + (obsNsVel ( cdyn ) - ns_vel) * tcpa) * (nsRelDist ( cdyn ) + (obsNsVel ( cdyn ) - ns_vel) * tcpa) + (ewRelDist ( cdyn ) + (obsEwVel ( cdyn ) - ew_vel) * tcpa) * (ewRelDist ( cdyn ) + (obsEwVel ( cdyn ) - ew_vel) * tcpa) )
	}
}

operation CalcCStc ( ) {
	requires LreController_State requires Sensors
	initial i0
	final f0
	transition t0 {
		from i0
		to f0
		action cstc = closestStaticIndex
	}
}

operation CalcVel ( ) {
	requires LreController_State requires Sensors
	initial i0
	final f0
	transition t0 {
		from i0
		to f0
		action hvel = sqrt ( ns_vel * ns_vel + ew_vel * ew_vel ) ; vvel = rate_of_climb ; vel = sqrt ( hvel * hvel + vvel * vvel )
	}
}

operation CheckOPEZ ( ) {
	requires LreController_State requires Sensors requires Constants
	initial i0
	final f0
	transition t0 {
		from i0
		to f0
		action inOpez = ( odist ( cstc ) <= minsafedist \/ depth <= 0 )
	}
}

operation LreController_Refresh ( ) {
	requires LreController_State requires Sensors requires Constants
	initial i0
	final f0
	transition t0 {
		from i0
		to f0
		action camActive = ( cda < minsafedist /\ tcpa >= 0 ) ; hcmActive = ( hvel >= 1 /\ hdist ( cstc ) <= staticobshorizdist \/ vdist ( cstc ) <= staticobsdfltvertdist \/ vvel >= 1 /\ vdist ( cstc ) <= staticobsvertdist ) ; momReturn = ( hdist ( cstc ) > staticobshorizdist /\ vdist ( cstc ) > staticobsvertdist )
	}
}

stm LreController {
	uses Inputs uses Outputs requires LreController_State requires Constants
	var v : real
	state CAM {
	}
	state OCM {
	}
	state HCM {
	}
	state MOM {
		entry advVel ! 1
	}
	initial i0
	transition t_init {
		from i0
		to OCM
	}
	transition t1 {
		from OCM
		to OCM
		trigger reqVel ? v
		action advVel ! v
	}
	transition t2 {
		from OCM
		to OCM
		trigger reqHdng ? v
		action advHdng ! v
	}
	transition t3 {
		from OCM
		to MOM
		trigger reqMOM
		condition vel <= 1 /\ not ( inOpez ) /\ odist ( cdyn ) > 1 /\ odist ( cstc ) > 1
	}
	transition t4 {
		from HCM
		to CAM
		condition camActive
	}
	transition t5 {
		from HCM
		to OCM
		condition inOpez /\ not ( camActive )
	}
	transition t6 {
		from HCM
		to MOM
		condition momReturn /\ not ( camActive ) /\ not ( inOpez )
	}
	transition t7 {
		from HCM
		to OCM
		trigger reqOCM
		condition not ( camActive ) /\ not ( inOpez ) /\ not ( momReturn )
	}
	transition t8 {
		from CAM
		to OCM
		trigger reqOCM
	}
	transition t9 {
		from CAM
		to OCM
		condition cda >= minsafedist
		action advVel ! 0
	}
}

controller LreController_Ctrl {
	uses Inputs uses Outputs requires LreController_State requires Constants requires Sensors
	sref stm_ref0 = LreController
	opref op_ref0 = CalcCDyn
	opref op_ref1 = CalcCPA
	opref op_ref2 = CalcCStc
	opref op_ref3 = CalcVel
	opref op_ref4 = CheckOPEZ
	opref op_ref5 = LreController_Refresh
	connection LreController_Ctrl on reqVel to stm_ref0 on reqVel
	connection LreController_Ctrl on reqHdng to stm_ref0 on reqHdng
	connection LreController_Ctrl on reqMOM to stm_ref0 on reqMOM
	connection LreController_Ctrl on reqOCM to stm_ref0 on reqOCM
	connection stm_ref0 on advVel to LreController_Ctrl on advVel
	connection stm_ref0 on advHdng to LreController_Ctrl on advHdng
}

module LreController_Module {
	robotic platform LreController_Platform {
		provides Sensors provides Actuators provides Constants
		event reqVel : real
		event reqHdng : real
		event reqMOM
		event reqOCM
		event advVel : real
		event advHdng : real
	}
	cref ctrl_ref0 = LreController_Ctrl
	connection LreController_Platform on reqVel to ctrl_ref0 on reqVel
	connection LreController_Platform on reqHdng to ctrl_ref0 on reqHdng
	connection LreController_Platform on reqMOM to ctrl_ref0 on reqMOM
	connection LreController_Platform on reqOCM to ctrl_ref0 on reqOCM
	connection ctrl_ref0 on advVel to LreController_Platform on advVel
	connection ctrl_ref0 on advHdng to LreController_Platform on advHdng
}

