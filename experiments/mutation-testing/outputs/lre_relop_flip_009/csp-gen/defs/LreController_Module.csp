				channel get_vel, set_vel, setL_vel, setR_vel: core_real
				channel get_cstc, set_cstc, setL_cstc, setR_cstc: core_nat
				channel get_cdyn, set_cdyn, setL_cdyn, setR_cdyn: core_nat
				channel get_cda, set_cda, setL_cda, setR_cda: core_real
				channel get_camActive, set_camActive, setL_camActive, setR_camActive: core_boolean
				channel get_hcmActive, set_hcmActive, setL_hcmActive, setR_hcmActive: core_boolean
				channel get_momReturn, set_momReturn, setL_momReturn, setR_momReturn: core_boolean
				channel get_hvel, set_hvel, setL_hvel, setR_hvel: core_real
				channel get_vvel, set_vvel, setL_vvel, setR_vvel: core_real
				channel get_tcpa, set_tcpa, setL_tcpa, setR_tcpa: core_real
				
				-- Shared variable channels
				channel set_EXT_inOpez: core_boolean
				channel set_EXT_vel: core_real
				channel set_EXT_cstc: core_nat
				channel set_EXT_cdyn: core_nat
				channel set_EXT_cda: core_real
				channel set_EXT_camActive: core_boolean
				channel set_EXT_hcmActive: core_boolean
				channel set_EXT_momReturn: core_boolean
				channel set_EXT_hvel: core_real
				channel set_EXT_vvel: core_real
				channel set_EXT_tcpa: core_real
				
				-- Local variable channels for defined operations that are required by the state machine
				
				-- Declaring state machine events
				channel reqVel__: NIDS.InOut.core_real
				channel reqVel: InOut.core_real
				channel reqHdng__: NIDS.InOut.core_real
				channel reqHdng: InOut.core_real
				channel reqMOM__: NIDS.InOut
				channel reqMOM: InOut
				channel reqOCM__: NIDS.InOut
				channel reqOCM: InOut
				channel endTask__: NIDS.InOut
				channel endTask: InOut
				channel reqHCM__: NIDS.InOut
				channel reqHCM: InOut
				channel advVel__: NIDS.InOut.core_real
				channel advVel: InOut.core_real
				channel advHdng__: NIDS.InOut.core_real
				channel advHdng: InOut.core_real
				
				-- Declaring call and ret events for undefined operations
				
				enterSS = {|
				CAM::enter,
				MOM::enter,
				OCM::enter,
				HCM::enter,
				i0::enter
				|}
				
				enteredSS = 	{|
				CAM::entered,
				MOM::entered,
				OCM::entered,
				HCM::entered
				|}
				
				internal_events = union(enteredSS,union(enterSS,{|interrupt,exited|}))
				
				shared_variable_events = {|
					set_EXT_inOpez,
					set_EXT_vel,
					set_EXT_cstc,
					set_EXT_cdyn,
					set_EXT_cda,
					set_EXT_camActive,
					set_EXT_hcmActive,
					set_EXT_momReturn,
					set_EXT_hvel,
					set_EXT_vvel,
					set_EXT_tcpa
				|}
				
				-- channel set with all visible events
				sem__events = {|
					terminate
				,	set_EXT_inOpez, set_inOpez,
					set_EXT_vel, set_vel,
					set_EXT_cstc, set_cstc,
					set_EXT_cdyn, set_cdyn,
					set_EXT_cda, set_cda,
					set_EXT_camActive, set_camActive,
					set_EXT_hcmActive, set_hcmActive,
					set_EXT_momReturn, set_momReturn,
					set_EXT_hvel, set_hvel,
					set_EXT_vvel, set_vvel,
					set_EXT_tcpa, set_tcpa
				,	reqVel,
					reqHdng,
					reqMOM,
					reqOCM,
					endTask,
					reqHCM,
					advVel,
					advHdng
					|}
			
				-- Nodes --
				-- declaring all nodes
				
				----------------------------------------------------------------------
				-- State: CAM
				module CAM
				
				enterSS = {}
				
				enteredSS = {}
				
				exports
				
					--  Declarations
					
					channel enter, entered, interrupt
					channel enteredL, enteredR
					
									
					
					--	Nodes
					-- declaring all nodes
					
					
					--	Rule: behaviours(Node)
					--  Note that FDR has problems with efficiently compiling the process below
					-- 	if using a different recursion pattern.
					D__(id__,
							    const_LreController_minsafedist) = 
					dbisim(let
						-- IMPLEMENTATION NOTE: 
						-- The following should be defined as: Inactive = share__choice(Activation [] Termination),
						-- however FDR struggles with that form in certain cases. So we use the exception operator
						-- instead to 'terminate'.
						
						Inactive 	= share__choice(enter -> SKIP [] terminate -> SKIP) ; Active
						
						Termination = terminate -> SKIP
						
						Active 		= SKIP ; 
								 	  Behaviour ; 
								 	  share__choice(exit -> SKIP) ; SKIP ; 
								 	  share__choice(exited -> SKIP) ; Inactive
					
						Behaviour 	= entered -> During
						During 		= ((SKIP ; SStop) /\ interrupt -> SKIP)
					within
						Inactive [| {terminate} |> SKIP)
						
					VS_O__(id__,
							    const_LreController_minsafedist) = 
					dbisim(let
						Inactive 	= share__choice(enter -> SKIP [] terminate -> SKIP) ; Active
						
						Termination = terminate -> SKIP
						
						Active 		= SKIP ; 
								 	  Behaviour ; 
								 	  share__choice(exit -> SKIP) ; SKIP ; 
								 	  share__choice(exited -> SKIP) ; Inactive
					
						Behaviour 	= entered -> During
						During 		= ((SKIP ; SStop) /\ interrupt -> SKIP)
					within
						Inactive [| {terminate} |> SKIP)
					
				
				endmodule
				----------------------------------------------------------------------
				
				
				----------------------------------------------------------------------
				-- State: MOM
				module MOM
				
				enterSS = {}
				
				enteredSS = {}
				
				exports
				
					--  Declarations
					
					channel enter, entered, interrupt
					channel enteredL, enteredR
					
									
					
					--	Nodes
					-- declaring all nodes
					
					
					--	Rule: behaviours(Node)
					--  Note that FDR has problems with efficiently compiling the process below
					-- 	if using a different recursion pattern.
					D__(id__,
							    const_LreController_minsafedist) = 
					dbisim(let
						-- IMPLEMENTATION NOTE: 
						-- The following should be defined as: Inactive = share__choice(Activation [] Termination),
						-- however FDR struggles with that form in certain cases. So we use the exception operator
						-- instead to 'terminate'.
						
						Inactive 	= share__choice(enter -> SKIP [] terminate -> SKIP) ; Active
						
						Termination = terminate -> SKIP
						
						Active 		= true&(share__choice(advVel.out!1 -> SKIP)) ; 
								 	  Behaviour ; 
								 	  share__choice(exit -> SKIP) ; SKIP ; 
								 	  share__choice(exited -> SKIP) ; Inactive
					
						Behaviour 	= entered -> During
						During 		= ((SKIP ; SStop) /\ interrupt -> SKIP)
					within
						Inactive [| {terminate} |> SKIP)
						
					VS_O__(id__,
							    const_LreController_minsafedist) = 
					dbisim(let
						Inactive 	= share__choice(enter -> SKIP [] terminate -> SKIP) ; Active
						
						Termination = terminate -> SKIP
						
						Active 		= true&(share__choice(advVel.out!1 -> SKIP)) ; 
								 	  Behaviour ; 
								 	  share__choice(exit -> SKIP) ; SKIP ; 
								 	  share__choice(exited -> SKIP) ; Inactive
					
						Behaviour 	= entered -> During
						During 		= ((SKIP ; SStop) /\ interrupt -> SKIP)
					within
						Inactive [| {terminate} |> SKIP)
					
				
				endmodule
				----------------------------------------------------------------------
				
				
				----------------------------------------------------------------------
				-- State: OCM
				module OCM
				
				enterSS = {}
				
				enteredSS = {}
				
				exports
				
					--  Declarations
					
					channel enter, entered, interrupt
					channel enteredL, enteredR
					
									
					
					--	Nodes
					-- declaring all nodes
					
					
					--	Rule: behaviours(Node)
					--  Note that FDR has problems with efficiently compiling the process below
					-- 	if using a different recursion pattern.
					D__(id__,
							    const_LreController_minsafedist) = 
					dbisim(let
						-- IMPLEMENTATION NOTE: 
						-- The following should be defined as: Inactive = share__choice(Activation [] Termination),
						-- however FDR struggles with that form in certain cases. So we use the exception operator
						-- instead to 'terminate'.
						
						Inactive 	= share__choice(enter -> SKIP [] terminate -> SKIP) ; Active
						
						Termination = terminate -> SKIP
						
						Active 		= SKIP ; 
								 	  Behaviour ; 
								 	  share__choice(exit -> SKIP) ; SKIP ; 
								 	  share__choice(exited -> SKIP) ; Inactive
					
						Behaviour 	= entered -> During
						During 		= ((SKIP ; SStop) /\ interrupt -> SKIP)
					within
						Inactive [| {terminate} |> SKIP)
						
					VS_O__(id__,
							    const_LreController_minsafedist) = 
					dbisim(let
						Inactive 	= share__choice(enter -> SKIP [] terminate -> SKIP) ; Active
						
						Termination = terminate -> SKIP
						
						Active 		= SKIP ; 
								 	  Behaviour ; 
								 	  share__choice(exit -> SKIP) ; SKIP ; 
								 	  share__choice(exited -> SKIP) ; Inactive
					
						Behaviour 	= entered -> During
						During 		= ((SKIP ; SStop) /\ interrupt -> SKIP)
					within
						Inactive [| {terminate} |> SKIP)
					
				
				endmodule
				----------------------------------------------------------------------
				
				
				----------------------------------------------------------------------
				-- State: HCM
				module HCM
				
				enterSS = {}
				
				enteredSS = {}
				
				exports
				
					--  Declarations
					
					channel enter, entered, interrupt
					channel enteredL, enteredR
					
									
					
					--	Nodes
					-- declaring all nodes
					
					
					--	Rule: behaviours(Node)
					--  Note that FDR has problems with efficiently compiling the process below
					-- 	if using a different recursion pattern.
					D__(id__,
							    const_LreController_minsafedist) = 
					dbisim(let
						-- IMPLEMENTATION NOTE: 
						-- The following should be defined as: Inactive = share__choice(Activation [] Termination),
						-- however FDR struggles with that form in certain cases. So we use the exception operator
						-- instead to 'terminate'.
						
						Inactive 	= share__choice(enter -> SKIP [] terminate -> SKIP) ; Active
						
						Termination = terminate -> SKIP
						
						Active 		= true&(share__choice(advVel.out!0 -> SKIP)) ; 
								 	  Behaviour ; 
								 	  share__choice(exit -> SKIP) ; SKIP ; 
								 	  share__choice(exited -> SKIP) ; Inactive
					
						Behaviour 	= entered -> During
						During 		= ((SKIP ; SStop) /\ interrupt -> SKIP)
					within
						Inactive [| {terminate} |> SKIP)
						
					VS_O__(id__,
							    const_LreController_minsafedist) = 
					dbisim(let
						Inactive 	= share__choice(enter -> SKIP [] terminate -> SKIP) ; Active
						
						Termination = terminate -> SKIP
						
						Active 		= true&(share__choice(advVel.out!0 -> SKIP)) ; 
								 	  Behaviour ; 
								 	  share__choice(exit -> SKIP) ; SKIP ; 
								 	  share__choice(exited -> SKIP) ; Inactive
					
						Behaviour 	= entered -> During
						During 		= ((SKIP ; SStop) /\ interrupt -> SKIP)
					within
						Inactive [| {terminate} |> SKIP)
					
				
				endmodule
				----------------------------------------------------------------------
				
				
				----------------------------------------------------------------------
				-- Initial: i0
				module i0
				exports
				
					channel enter, interrupt
					
					D__(id__,
							    const_LreController_minsafedist) = 
						dbisim(let
							Inactive 	= share__choice(enter -> SKIP [] terminate -> SKIP) ; Active
							
							Termination = terminate -> SKIP
							
							Active 		= share__choice(interrupt -> SKIP) ; Inactive
						within
							Inactive [| {terminate} |> SKIP)
					
					VS_O__(id__,
							    const_LreController_minsafedist) = D__(id__,
							    const_LreController_minsafedist)
				
				endmodule
				----------------------------------------------------------------------
				
				-- END of Nodes --
				
				-- Operation calls --
				-- Only the undefined operations are declared here.
				-- If the state machine is in isolation, all required operations will be undefined.
				-- If it is in the context of a controller, the required operations not provided by the
				-- controller will be declared here, and the defined operations will be defined in the
				-- context of the Controller module, and therefore within scope of the state machine module.
				
				-- END of Operation calls --
				
				-- STM processes
				STM(id__,
						    const_LreController_minsafedist) = -- RULE: [[stm:StateMachineDef]]_STM^nops : CSPProcess
				( 
					(
						(
							(IteratedStateful(id__,
									    const_LreController_minsafedist) \ {terminate} ; share__choice(terminate -> SKIP))
						 	[[ share__ <- x__ | x__ <- {|set_EXT_inOpez,set_EXT_vel,set_EXT_cstc,set_EXT_cdyn,set_EXT_cda,set_EXT_camActive,set_EXT_hcmActive,set_EXT_momReturn,set_EXT_hvel,set_EXT_vvel,set_EXT_tcpa|} ]]
						)
					[| {share__} |]
					SKIP
					)
					[| union(sharedVarSync,{terminate}) |]
					dbisim(sharedVarMemory(id__,
							    const_LreController_minsafedist))
				)\sharedVarHide
				
				STM_VS_O(id__,
						    const_LreController_minsafedist) = -- RULE: [[stm:StateMachineDef]]_STM^nops : CSPProcess
				( 
					(
						(
							(IteratedStateful_VS_O(id__,
									    const_LreController_minsafedist) \ {terminate} ; share__choice(terminate -> SKIP))
						 	[[ share__ <- x__ | x__ <- {|set_EXT_inOpez,set_EXT_vel,set_EXT_cstc,set_EXT_cdyn,set_EXT_cda,set_EXT_camActive,set_EXT_hcmActive,set_EXT_momReturn,set_EXT_hvel,set_EXT_vvel,set_EXT_tcpa|} ]]
						)
					[| {share__} |]
					SKIP
					)
					[| union(sharedVarSync,{terminate}) |]
					dbisim(sharedVarMemory(id__,
							    const_LreController_minsafedist))
				)\sharedVarHide
				
				-- Transitions
				Transitions(id__,
						    const_LreController_minsafedist) = ((let
					Trans = share__choice(get_cstc?cstc -> get_camActive?camActive -> get_vel?vel -> get_inOpez?inOpez -> get_hcmActive?hcmActive -> get_momReturn?momReturn -> get_cda?cda -> get_cdyn?cdyn -> (
						((share__ -> SKIP
						 [] dbisim((true)&(internal__!NID_i0 -> SKIP ;  ((SKIP ; OCM::enter -> SKIP))))
						 	 [] dbisim((true)&(reqVel__!NID_OCM.in?v:{v|v <- core_real, true} -> share__choice(set_v!v -> SKIP) ;  share__choice(exit -> SKIP) ; (share__choice(exited -> SKIP) ; share__choice(get_v?v -> true&(share__choice(advVel.out!v -> SKIP))) ; OCM::enter -> SKIP)))
						 	 [] dbisim((true)&(reqHdng__!NID_OCM.in?v:{v|v <- core_real, true} -> share__choice(set_v!v -> SKIP) ;  share__choice(exit -> SKIP) ; (share__choice(exited -> SKIP) ; share__choice(get_v?v -> true&(share__choice(advHdng.out!v -> SKIP))) ; OCM::enter -> SKIP)))
						 	 [] dbisim((((((vel<=1) and (not ((inOpez)))) and (odist(cdyn)>1)) and (odist(cstc)>1)))&(reqMOM__!NID_OCM.in -> SKIP ;  share__choice(exit -> SKIP) ; (share__choice(exited -> SKIP) ; SKIP ; MOM::enter -> SKIP)))
						 	 [] dbisim((camActive)&(internal__!NID_MOM -> SKIP ;  share__choice(exit -> SKIP) ; (share__choice(exited -> SKIP) ; SKIP ; CAM::enter -> SKIP)))
						 	 [] dbisim(((hcmActive and (not ((camActive)))))&(internal__!NID_MOM -> SKIP ;  share__choice(exit -> SKIP) ; (share__choice(exited -> SKIP) ; SKIP ; HCM::enter -> SKIP)))
						 	 [] dbisim((((inOpez and (not ((camActive)))) and (not ((hcmActive)))))&(internal__!NID_MOM -> SKIP ;  share__choice(exit -> SKIP) ; (share__choice(exited -> SKIP) ; SKIP ; OCM::enter -> SKIP)))
						 	 [] dbisim((true)&(reqOCM__!NID_MOM.in -> SKIP ;  share__choice(exit -> SKIP) ; (share__choice(exited -> SKIP) ; SKIP ; OCM::enter -> SKIP)))
						 	 [] dbisim((true)&(endTask__!NID_MOM.in -> SKIP ;  share__choice(exit -> SKIP) ; (share__choice(exited -> SKIP) ; true&(share__choice(advVel.out!0 -> SKIP)) ; OCM::enter -> SKIP)))
						 	 [] dbisim((true)&(reqHCM__!NID_MOM.in -> SKIP ;  share__choice(exit -> SKIP) ; (share__choice(exited -> SKIP) ; SKIP ; HCM::enter -> SKIP)))
						 	 [] dbisim((camActive)&(internal__!NID_HCM -> SKIP ;  share__choice(exit -> SKIP) ; (share__choice(exited -> SKIP) ; SKIP ; CAM::enter -> SKIP)))
						 	 [] dbisim(((inOpez and (not ((camActive)))))&(internal__!NID_HCM -> SKIP ;  share__choice(exit -> SKIP) ; (share__choice(exited -> SKIP) ; SKIP ; OCM::enter -> SKIP)))
						 	 [] dbisim((((momReturn and (not ((camActive)))) and (not ((inOpez)))))&(internal__!NID_HCM -> SKIP ;  share__choice(exit -> SKIP) ; (share__choice(exited -> SKIP) ; SKIP ; MOM::enter -> SKIP)))
						 	 [] dbisim((true)&(reqOCM__!NID_HCM.in -> SKIP ;  share__choice(exit -> SKIP) ; (share__choice(exited -> SKIP) ; SKIP ; OCM::enter -> SKIP)))
						 	 [] dbisim((true)&(reqOCM__!NID_CAM.in -> SKIP ;  share__choice(exit -> SKIP) ; (share__choice(exited -> SKIP) ; SKIP ; OCM::enter -> SKIP)))
						 	 [] dbisim(((cda>=const_LreController_minsafedist))&(internal__!NID_CAM -> SKIP ;  share__choice(exit -> SKIP) ; (share__choice(exited -> SKIP) ; true&(share__choice(advVel.out!0 -> SKIP)) ; OCM::enter -> SKIP)))
						 ) ; Trans)
						 []
						 (interrupt -> share__choice(exit -> SKIP) ; share__choice(exited -> terminate -> SKIP))
						 []
						 terminate -> SKIP
					)
					)
				within
					Trans
				)
				)
				
				-- Stateful
				-- RULE: Stateful(stm:StateMachineBody) : CSPProcess
				
				-- Named process definitions
				MachineBody(id__,
						    const_LreController_minsafedist) = 
					dbisim((
					let
						finalNodesEntered = {||}
					within
						((let
							-- IMPLEMENTATION NOTE:
							-- Here the 'enter' channel set is calculated explicitly because of the use of CSPM 
							-- modules for defining the semantics of each node.
							enterSS = {|
							CAM::enter,
							MOM::enter,
							OCM::enter,
							HCM::enter,
							i0::enter
							|}
							hideSet = union(enterSS,{|exit,exited,internal__|})
						within 
							((let
								-- IMPLEMENTATION NOTE: the channel set 'enter' is calculated explicitly
								-- because CSPM modules are used for the semantics of Node.
								flowevts = union(enterSS,{|exit,exited,interrupt|})
								transSync = {|internal__.NID_i0,reqVel__.NID_OCM.in,reqHdng__.NID_OCM.in,reqMOM__.NID_OCM.in,internal__.NID_MOM,internal__.NID_MOM,internal__.NID_MOM,reqOCM__.NID_MOM.in,endTask__.NID_MOM.in,reqHCM__.NID_MOM.in,internal__.NID_HCM,internal__.NID_HCM,internal__.NID_HCM,reqOCM__.NID_HCM.in,reqOCM__.NID_CAM.in,internal__.NID_CAM|}
							within
								((
								 (((-- RULE composeNodes(nc:NodeContainer)^nops : CSPProcess
								   CAM::D__(id__,
								   		    const_LreController_minsafedist)
								   [| { share__, terminate } |] (
								   MOM::D__(id__,
								   		    const_LreController_minsafedist)
								   [| { share__, terminate } |] (
								   OCM::D__(id__,
								   		    const_LreController_minsafedist)
								   [| { share__, terminate } |] (
								   HCM::D__(id__,
								   		    const_LreController_minsafedist)
								   [| { share__, terminate } |] (
								   i0::D__(id__,
								   		    const_LreController_minsafedist)
								   )
								   )
								   )
								   )
								 )
								 [[CAM::interrupt <- x__ | x__ <- {|interrupt,reqOCM__.NID_CAM.in,internal__.NID_CAM|}]]
								 [[MOM::interrupt <- x__ | x__ <- {|interrupt,internal__.NID_MOM,internal__.NID_MOM,internal__.NID_MOM,reqOCM__.NID_MOM.in,endTask__.NID_MOM.in,reqHCM__.NID_MOM.in|}]]
								 [[OCM::interrupt <- x__ | x__ <- {|interrupt,reqVel__.NID_OCM.in,reqHdng__.NID_OCM.in,reqMOM__.NID_OCM.in|}]]
								 [[HCM::interrupt <- x__ | x__ <- {|interrupt,internal__.NID_HCM,internal__.NID_HCM,internal__.NID_HCM,reqOCM__.NID_HCM.in|}]]
								 [[i0::interrupt <- x__ | x__ <- {|internal__.NID_i0|}]]
								 )
								  [[ share__ <- x__ | x__ <- {| share__,setR_v |} ]] 
								  [[set_cstc <- setL_cstc,set_camActive <- setL_camActive,set_vel <- setL_vel,set_inOpez <- setL_inOpez,set_hcmActive <- setL_hcmActive,set_momReturn <- setL_momReturn,set_cda <- setL_cda,set_cdyn <- setL_cdyn]]
								 )
								 [| union(union(union(flowevts,transSync),{terminate}),{|share__
								 			,setL_cstc
								 			,setL_camActive
								 			,setL_vel
								 			,setL_inOpez
								 			,setL_hcmActive
								 			,setL_momReturn
								 			,setL_cda
								 			,setL_cdyn
								 			,setR_v
								 			|}) |]
								 ((i0::enter -> Transitions(id__,
								 		    const_LreController_minsafedist))
								  [[ share__ <- x__ | x__ <- {| share__,setL_cstc,setL_camActive,setL_vel,setL_inOpez,setL_hcmActive,setL_momReturn,setL_cda,setL_cdyn |} ]]
								  [[set_v <- setR_v]]
								 )
								)[[setL_cstc <- set_cstc,setL_camActive <- set_camActive,setL_vel <- set_vel,setL_inOpez <- set_inOpez,setL_hcmActive <- set_hcmActive,setL_momReturn <- set_momReturn,setL_cda <- set_cda,setL_cdyn <- set_cdyn]]
								 [[setR_v <- set_v]]
								)
							)
							 \ hideSet)
							[[
								reqVel__.x____ <- reqVel,
								reqHdng__.x____ <- reqHdng,
								reqMOM__.x____ <- reqMOM,
								reqOCM__.x____ <- reqOCM,
								endTask__.x____ <- endTask,
								reqHCM__.x____ <- reqHCM,
								advVel__.x____ <- advVel,
								advHdng__.x____ <- advHdng
								| x____ <- NIDS
							]]
						)
						 [| {| interrupt |} |] SKIP)
					)
					)
				
				Behaviour(id__,
						    const_LreController_minsafedist) = 
					dbisim((MachineBody(id__,
							    const_LreController_minsafedist)\ enteredSS)
					)
				
				IteratedBehaviour(id__,
						    const_LreController_minsafedist) = 
					dbisim((MachineBody(id__,
							    const_LreController_minsafedist)\ enteredSS)
					)
				
				Stateful(id__,
						    const_LreController_minsafedist) = 
					((
						(Behaviour(id__,
								    const_LreController_minsafedist) [| union(getsetLocalChannels,{terminate}) |] varMemory(id__,
								    const_LreController_minsafedist))
					 	\getsetLocalChannels
					)
					)
				
				IteratedStateful(id__,
						    const_LreController_minsafedist) =
					(dbisim(
						sbisim(
							Behaviour(id__,
									    const_LreController_minsafedist)
							[| {|get_v,set_v,terminate|} |]
							Memory_v(0)
						)\{|get_v,set_v|}
