        <statement xsi:type="spoon:CtIf">
          <comment commentContent="--- Pure mode-nested if-else: one outer block per mode ---"/>
          <comment commentContent=""/>
          <comment commentContent="Within MOM and HCM, autonomous safety branches are ordered by descending"/>
          <comment commentContent="severity (CAM > HCM-proximity > OCM-via-OPEZ) AHEAD of all operator"/>
          <comment commentContent="events, and each lower-priority autonomous guard explicitly negates the"/>
          <comment commentContent="higher-priority ones. The negations are required for Dafny postcondition"/>
          <comment commentContent="consistency &#x2014; see class javadoc. Within OCM and CAM the existing"/>
          <comment commentContent="event-driven ordering already verifies cleanly."/>
          <else xsi:type="spoon:CtBlock" isImplicit="true">
