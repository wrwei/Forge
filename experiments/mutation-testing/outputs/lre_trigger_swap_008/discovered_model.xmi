    <typeMember xsi:type="spoon:CtMethod" name="step">
      <modifier>PUBLIC</modifier>
      <body xsi:type="spoon:CtBlock">
        <statement xsi:type="spoon:CtInvocation">
          <comment commentContent="--- Refresh derived quantities (operation dispatch order matters) ---"/>
          <target xsi:type="spoon:CtFieldRead">
            <variable xsi:type="spoon:CtFieldReference" name="calcVel" isFinal="true">
              <type name="CalcVel">
                <packageRef name="lre.operation"/>
              </type>
