					dbisim((MachineBody(id__)\ enteredSS)
					)
				
				Stateful(id__) = 
					((
						(Behaviour(id__) [| union(getsetLocalChannels,{terminate}) |] varMemory(id__))
					 	\getsetLocalChannels
					)
					)
				
				IteratedStateful(id__) =
					(Behaviour(id__))
				
				-- Visible counterparts
				MachineBody_VS_O(id__) = 
					dbisim((
					let
						finalNodesEntered = {||}
					within
						((let
							-- IMPLEMENTATION NOTE:
							-- Here the 'enter' channel set is calculated explicitly because of the use of CSPM 
							-- modules for defining the semantics of each node.
							enterSS = {|
							Moving::enter,
							Final::enter,
							Turning::enter,
							i0::enter
							|}
							hideSet = union(enterSS,{|exit,exited,internal__|})
						within 
							((let
								-- IMPLEMENTATION NOTE: the channel set 'enter' is calculated explicitly
								-- because CSPM modules are used for the semantics of Node.
								flowevts = union(enterSS,{|exit,exited,interrupt|})
								transSync = {|internal__.NID_i0,internal__.NID_Turning,endTask__.NID_Turning.in,tick__.NID_Turning.in,tick__.NID_Final.in|}
							within
								((
								 (((-- RULE composeNodes(nc:NodeContainer)^nops : CSPProcess
								   Moving::VS_O__(id__)
								   [| { share__, terminate } |] (
								   Final::VS_O__(id__)
								   [| { share__, terminate } |] (
								   Turning::VS_O__(id__)
								   [| { share__, terminate } |] (
								   i0::VS_O__(id__)
								   )
								   )
								   )
								 )
								 [[Moving::interrupt <- x__ | x__ <- {|interrupt|}]]
								 [[Final::interrupt <- x__ | x__ <- {|interrupt,tick__.NID_Final.in|}]]
								 [[Turning::interrupt <- x__ | x__ <- {|interrupt,internal__.NID_Turning,endTask__.NID_Turning.in,tick__.NID_Turning.in|}]]
								 [[i0::interrupt <- x__ | x__ <- {|internal__.NID_i0|}]]
								 )
								  [[ share__ <- x__ | x__ <- {| share__ |} ]] 
								  [[set_turnDurationElapsed <- setL_turnDurationElapsed]]
								 )
								 [| union(union(union(flowevts,transSync),{terminate}),{|share__
								 			,setL_turnDurationElapsed
								|}) |]
								 ((i0::enter -> Transitions(id__))
								  [[ share__ <- x__ | x__ <- {| share__,setL_turnDurationElapsed |} ]]
								 )
								)[[setL_turnDurationElapsed <- set_turnDurationElapsed]]
								)
							)
							 \ hideSet)
							[[
								endTask__.x____ <- endTask,
								tick__.x____ <- tick,
								move__.x____ <- move
								| x____ <- NIDS
							]]
						)
						 [| {| interrupt |} |] SKIP)
					)
					)
				
				Behaviour_VS_O(id__) = 
					dbisim((MachineBody_VS_O(id__))
					)
				
				IteratedBehaviour_VS_O(id__) = 
					dbisim((MachineBody_VS_O(id__))
					)
				
				Stateful_VS_O(id__) = 
					dbisim((
						(Behaviour_VS_O(id__) [| union(getsetLocalChannels,{terminate}) |] varMemory(id__))
					 	\getsetLocalChannels
					)
					)
				
				IteratedStateful_VS_O(id__) =
					(Behaviour_VS_O(id__))
				
				-- END
				
				-- Memory
				-- Memory variables
				
				-- varMemory process
				varMemory(id__) = terminate -> SKIP
				
				getsetLocalChannels = {||}
				
				-- Definition of the behaviour of state machines (default, optimised, visible, visible and optimised)
				FVS__(id__) = STM_VS_O(id__)
				
				D__(id__) = STM(id__) \ internal_events
				O__(id__) = sbisim(diamond(D__(id__)))
				VS__(id__) = FVS__(id__)
				VS_O__(id__) = sbisim(diamond(FVS__(id__)))
				HEXT__(id__) = O__(id__) [|shared_variable_events|] SKIP
				HUP__(id__) = O__(id__) [|{share__}|] SKIP
				
				-- Shared memory
				-- Shared memory variables
				Memory_turnDurationElapsed(turnDurationElapsed) =
					get_turnDurationElapsed!turnDurationElapsed -> Memory_turnDurationElapsed(turnDurationElapsed)
					[]
					set_turnDurationElapsed?x__ -> Memory_turnDurationElapsed(x__)
					[]
					set_EXT_turnDurationElapsed?x__ -> Memory_turnDurationElapsed(x__)
					[]
					terminate -> SKIP
				Memory_resetTime(resetTime) =
					get_resetTime!resetTime -> Memory_resetTime(resetTime)
					[]
					set_resetTime?x__ -> Memory_resetTime(x__)
					[]
					set_EXT_resetTime?x__ -> Memory_resetTime(x__)
					[]
					terminate -> SKIP
				Memory_elapsed(elapsed) =
					get_elapsed!elapsed -> Memory_elapsed(elapsed)
					[]
					set_elapsed?x__ -> Memory_elapsed(x__)
					[]
					set_EXT_elapsed?x__ -> Memory_elapsed(x__)
					[]
					terminate -> SKIP
				
				-- sharedVarMemory process
				sharedVarMemory(id__) = Memory_turnDurationElapsed(true)
				[| { terminate } |] (
				Memory_resetTime(0)
				[| { terminate } |] (
				Memory_elapsed(true)
				)
				)
				
				sharedVarSync = {|get_turnDurationElapsed,set_turnDurationElapsed,set_EXT_turnDurationElapsed,get_resetTime,set_resetTime,set_EXT_resetTime,get_elapsed,set_elapsed,set_EXT_elapsed|}
				
				sharedVarHide = {|get_turnDurationElapsed,get_resetTime,get_elapsed|}
			endmodule
			
				-- undefined operations
				
				-- declaring controller memory
				Memory(id__, turnDurationElapsed, resetTime, elapsed) = (
				set_EXT_turnDurationElapsed?x__ -> stm_ref0::set_EXT_turnDurationElapsed!x__ -> 
				Memory(id__,x__,resetTime,elapsed)
				 []
				set_EXT_resetTime?x__ -> stm_ref0::set_EXT_resetTime!x__ -> 
				Memory(id__,turnDurationElapsed,x__,elapsed)
				 []
				set_EXT_elapsed?x__ -> stm_ref0::set_EXT_elapsed!x__ -> 
				Memory(id__,turnDurationElapsed,resetTime,x__)
				)
				
				D__(id__) = 	((
						stm_ref0::D__(id__)[[
							stm_ref0::terminate <- terminate,
							stm_ref0::endTask <- endTask,
							stm_ref0::tick <- tick,
							stm_ref0::move <- move,
							stm_ref0::set_turnDurationElapsed <- set_turnDurationElapsed,
							stm_ref0::get_turnDurationElapsed <- get_turnDurationElapsed,
							stm_ref0::set_resetTime <- set_resetTime,
							stm_ref0::get_resetTime <- get_resetTime,
							stm_ref0::set_elapsed <- set_elapsed,
							stm_ref0::get_elapsed <- get_elapsed
						]]
					)
						[|
							union(
								{|
								|},
								{|
									stm_ref0::set_EXT_turnDurationElapsed,stm_ref0::set_EXT_resetTime,stm_ref0::set_EXT_elapsed
								|}
							)
						|]
					Memory(id__, true, 0, true)
				)
				\ union(
					{|
					|},
					{|
						stm_ref0::set_EXT_turnDurationElapsed,stm_ref0::set_EXT_resetTime,stm_ref0::set_EXT_elapsed
					|}
				)
				[|{|terminate|}|>SKIP
				
				-- VS version
				VS__(id__) = 	((
						stm_ref0::VS__(id__)[[
							stm_ref0::terminate <- terminate,
							stm_ref0::endTask <- endTask,
							stm_ref0::tick <- tick,
							stm_ref0::move <- move,
							stm_ref0::set_turnDurationElapsed <- set_turnDurationElapsed,
							stm_ref0::get_turnDurationElapsed <- get_turnDurationElapsed,
							stm_ref0::set_resetTime <- set_resetTime,
							stm_ref0::get_resetTime <- get_resetTime,
							stm_ref0::set_elapsed <- set_elapsed,
							stm_ref0::get_elapsed <- get_elapsed
						]]
					)
						[|
							union(
								{|
								|},
								{|
									stm_ref0::set_EXT_turnDurationElapsed,stm_ref0::set_EXT_resetTime,stm_ref0::set_EXT_elapsed
								|}
							)
						|]
					Memory(id__, true, 0, true)
				)
				\ union(
					{|
					|},
					{|
						stm_ref0::set_EXT_turnDurationElapsed,stm_ref0::set_EXT_resetTime,stm_ref0::set_EXT_elapsed
					|}
				)
				[|{|terminate|}|>SKIP
			
				-- O version (optimised) THESE TWO PROCESSES SHOULD BE KEPT IN SYNC WITH THE ABOVE TWO
				O__(id__) = sbisim(diamond(	((
						stm_ref0::O__(id__)[[
							stm_ref0::terminate <- terminate,
							stm_ref0::endTask <- endTask,
							stm_ref0::tick <- tick,
							stm_ref0::move <- move,
							stm_ref0::set_turnDurationElapsed <- set_turnDurationElapsed,
							stm_ref0::get_turnDurationElapsed <- get_turnDurationElapsed,
							stm_ref0::set_resetTime <- set_resetTime,
							stm_ref0::get_resetTime <- get_resetTime,
							stm_ref0::set_elapsed <- set_elapsed,
							stm_ref0::get_elapsed <- get_elapsed
						]]
					)
						[|
							union(
								{|
								|},
								{|
									stm_ref0::set_EXT_turnDurationElapsed,stm_ref0::set_EXT_resetTime,stm_ref0::set_EXT_elapsed
								|}
							)
						|]
					dbisim(Memory(id__, true, 0, true))
				)
				\ union(
					{|
					|},
					{|
						stm_ref0::set_EXT_turnDurationElapsed,stm_ref0::set_EXT_resetTime,stm_ref0::set_EXT_elapsed
					|}
				)
				[|{|terminate|}|>SKIP
				))
								
				-- VS_O version
				VS_O__(id__) = sbisim(diamond(	((
						stm_ref0::VS_O__(id__)[[
							stm_ref0::terminate <- terminate,
							stm_ref0::endTask <- endTask,
							stm_ref0::tick <- tick,
							stm_ref0::move <- move,
							stm_ref0::set_turnDurationElapsed <- set_turnDurationElapsed,
							stm_ref0::get_turnDurationElapsed <- get_turnDurationElapsed,
							stm_ref0::set_resetTime <- set_resetTime,
							stm_ref0::get_resetTime <- get_resetTime,
							stm_ref0::set_elapsed <- set_elapsed,
							stm_ref0::get_elapsed <- get_elapsed
						]]
					)
						[|
							union(
								{|
								|},
								{|
									stm_ref0::set_EXT_turnDurationElapsed,stm_ref0::set_EXT_resetTime,stm_ref0::set_EXT_elapsed
								|}
							)
						|]
					dbisim(Memory(id__, true, 0, true))
				)
				\ union(
					{|
					|},
					{|
						stm_ref0::set_EXT_turnDurationElapsed,stm_ref0::set_EXT_resetTime,stm_ref0::set_EXT_elapsed
					|}
				)
				[|{|terminate|}|>SKIP
				))
			
				HEXT(id__) = O__(id__) [|shared_variable_events|] SKIP			
	
		endmodule
	
	-- declaring module memory
	Memory(id__, lv, av) = (
					set_lv?x__ -> 
					Memory(id__,x__,av)
					  []
					set_av?x__ -> 
					Memory(id__,lv,x__)
					)
	
	D__(id__) = 	(
			(
				(SKIP)
					[|{||}|]
				(
					(
						ctrl_ref0::D__(id__)[[
							ctrl_ref0::terminate <- terminate,
							ctrl_ref0::endTask <- endTask,
							ctrl_ref0::tick <- tick,
							ctrl_ref0::move <- move
						]]
					)
						[|
							union(
								{|
									set_lv,
									set_av
								|},
								{|
									ctrl_ref0::set_EXT_turnDurationElapsed,ctrl_ref0::set_EXT_resetTime,ctrl_ref0::set_EXT_elapsed
								|}
							)
						|]
					Memory(id__, 0, 0)
				)
			)
			\ Union({
				{|
				|},
				{|
					ctrl_ref0::set_EXT_turnDurationElapsed,ctrl_ref0::set_EXT_resetTime,ctrl_ref0::set_EXT_elapsed
				|},
				{|
				|}
			})
			[|{|terminate|}|>SKIP
		)
		\{|terminate|}
	
	-- visible state equivalent
	
	VS__(id__) = 	(
			(
				(SKIP)
					[|{||}|]
				(
					(
						ctrl_ref0::VS__(id__)[[
							ctrl_ref0::terminate <- terminate,
							ctrl_ref0::endTask <- endTask,
							ctrl_ref0::tick <- tick,
							ctrl_ref0::move <- move
						]]
					)
						[|
							union(
								{|
									set_lv,
									set_av
								|},
								{|
									ctrl_ref0::set_EXT_turnDurationElapsed,ctrl_ref0::set_EXT_resetTime,ctrl_ref0::set_EXT_elapsed
								|}
							)
						|]
					Memory(id__, 0, 0)
				)
			)
			\ Union({
				{|
				|},
				{|
					ctrl_ref0::set_EXT_turnDurationElapsed,ctrl_ref0::set_EXT_resetTime,ctrl_ref0::set_EXT_elapsed
				|},
				{|
				|}
			})
			[|{|terminate|}|>SKIP
		)
		\{|terminate|}
	
	-- O version (optimised)
	
	O__(id__) = sbisim(diamond(	(
			(
				(SKIP)
					[|{||}|]
				(
					(
						ctrl_ref0::O__(id__)[[
							ctrl_ref0::terminate <- terminate,
							ctrl_ref0::endTask <- endTask,
							ctrl_ref0::tick <- tick,
							ctrl_ref0::move <- move
						]]
					)
