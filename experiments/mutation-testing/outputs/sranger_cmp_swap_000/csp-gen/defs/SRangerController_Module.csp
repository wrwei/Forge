									ctrl_ref0::set_EXT_turnDurationElapsed,ctrl_ref0::set_EXT_resetTime,ctrl_ref0::set_EXT_elapsed
								|}
							)
						|]
					dbisim(Memory(id__, 0, 0))
				)
			)
			\ Union({
				{|
				|},
				{|
					ctrl_ref0::set_EXT_turnDurationElapsed,ctrl_ref0::set_EXT_resetTime,ctrl_ref0::set_EXT_elapsed
				|},
				{|
				|}
			})
			[|{|terminate|}|>SKIP
		)
		\{|terminate|}
	))
	
	-- visible state optimised equivalent
	
	VS_O__(id__) = sbisim(diamond(	(
			(
				(SKIP)
					[|{||}|]
				(
					(
						ctrl_ref0::VS_O__(id__)[[
							ctrl_ref0::terminate <- terminate,
							ctrl_ref0::endTask <- endTask,
							ctrl_ref0::tick <- tick,
							ctrl_ref0::move <- move
