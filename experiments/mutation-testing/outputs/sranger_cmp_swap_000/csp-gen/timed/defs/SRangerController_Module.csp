									 [[Moving::interrupt <- x__ | x__ <- {|interrupt|}]]
									 [[Final::interrupt <- x__ | x__ <- {|interrupt,tick__.NID_Final.in|}]]
									 [[Turning::interrupt <- x__ | x__ <- {|interrupt,internal__.NID_Turning,endTask__.NID_Turning.in,tick__.NID_Turning.in|}]]
									 [[i0::interrupt <- x__ | x__ <- {|internal__.NID_i0|}]]
									 )
									  [[ share__ <- x__ | x__ <- {| share__ |} ]] 
									  [[set_turnDurationElapsed <- setL_turnDurationElapsed]]
									 )
									 [| union(union(union(flowevts,transSync),{terminate}),{|share__
									 			,setL_turnDurationElapsed
									|}) |]
									 ((i0::enter -> Transitions(id__))
									  [[ share__ <- x__ | x__ <- {| share__,setL_turnDurationElapsed |} ]]
									 )
									)[[setL_turnDurationElapsed <- set_turnDurationElapsed]]
									)
								)
								 \ hideSet)
								[[
									endTask__.x____ <- endTask,
									tick__.x____ <- tick,
									move__.x____ <- move
									| x____ <- NIDS
								]]
							)
							)
							 [| union(stateClockSync,{terminate}) |]
							 StateClocks(id__)
							)\diff(stateClockSync,enteredSS))
							 [| {| interrupt |} |] SKIP)
						)
						)
					
					Behaviour_VS_O(id__) = 
						dbisim((let
							stateClockSync = {|get_CLID_Final,Final::entered,get_CLID_Turning,Turning::entered,get_CLID_Moving,Moving::entered|}
						 within
							(MachineBody_VS_O(id__) [| union(stateClockSync,{terminate}) |] StateClocks(id__)) \ diff(union(stateClockSync,enteredSS),enteredSS)
