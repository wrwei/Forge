							stateClockSync = {|get_CLID_Final,Final::entered,get_CLID_Turning,Turning::entered,get_CLID_Moving,Moving::entered|}
						 within
							(dbisim(
								sbisim(
									dbisim(
										sbisim(
											dbisim(
												sbisim(
