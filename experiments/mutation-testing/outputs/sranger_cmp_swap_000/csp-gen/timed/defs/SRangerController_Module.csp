								(IteratedStateful_VS_O(id__) \ {terminate} ; share__choice(terminate -> SKIP))
							 	[[ share__ <- x__ | x__ <- {|set_EXT_turnDurationElapsed,set_EXT_resetTime,set_EXT_elapsed|} ]]
							)
						[| {share__} |]
						SKIP
						)
						[| union(sharedVarSync,{terminate}) |]
						dbisim(sharedVarMemory(id__))
					)\sharedVarHide
					
					-- Transitions
					Transitions(id__) = ((let
						Trans = share__choice(get_turnDurationElapsed?turnDurationElapsed -> TimeOut_1(
							 (share__ -> SKIP
							 [] dbisim((true)&(internal__!NID_i0 -> SKIP ;  ((SKIP ; Moving::enter -> SKIP))))
							 [] dbisim((turnDurationElapsed)&(internal__!NID_Turning -> SKIP ;  share__choice(exit -> SKIP) ; (share__choice(exited -> SKIP) ; SKIP ; Moving::enter -> SKIP)))
							 [] dbisim((true)&(endTask__!NID_Turning.in -> SKIP ;  share__choice(exit -> SKIP) ; (share__choice(exited -> SKIP) ; SKIP ; Final::enter -> SKIP)))
							 [] dbisim((true)&(tick__!NID_Turning.in -> SKIP ;  share__choice(exit -> SKIP) ; (share__choice(exited -> SKIP) ; SKIP ; Turning::enter -> SKIP)))
							 [] dbisim((true)&(tick__!NID_Final.in -> SKIP ;  share__choice(exit -> SKIP) ; (share__choice(exited -> SKIP) ; SKIP ; Final::enter -> SKIP)))
							 []
							 (interrupt -> share__choice(exit -> SKIP) ; share__choice(exited -> terminate -> SKIP))
							 []
							 terminate -> SKIP
							 )
						,SKIP);Trans
						)
					within
						Trans [|{terminate}|> SKIP
					)
					)
					
					-- Stateful
					-- RULE: Stateful(stm:StateMachineBody) : CSPProcess
					
					-- Named process definitions
					MachineBody(id__) = 
						dbisim((
						let
							finalNodesEntered = {||}
						within
							(dbisim((dbisim((let
								-- IMPLEMENTATION NOTE:
								-- Here the 'enter' channel set is calculated explicitly because of the use of CSPM 
								-- modules for defining the semantics of each node.
								enterSS = {|
								Moving::enter,
								Final::enter,
								Turning::enter,
								i0::enter
								|}
								hideSet = union(enterSS,{|exit,exited,internal__|})
							within 
								((let
									-- IMPLEMENTATION NOTE: the channel set 'enter' is calculated explicitly
									-- because CSPM modules are used for the semantics of Node.
									flowevts = union(enterSS,{|exit,exited,interrupt|})
									transSync = {|internal__.NID_i0,internal__.NID_Turning,endTask__.NID_Turning.in,tick__.NID_Turning.in,tick__.NID_Final.in|}
								within
									((
									 (((-- RULE composeNodes(nc:NodeContainer)^nops : CSPProcess
									   Moving::D__(id__)
									   [| { share__, terminate } |] (
									   Final::D__(id__)
									   [| { share__, terminate } |] (
									   Turning::D__(id__)
									   [| { share__, terminate } |] (
									   i0::D__(id__)
									   )
									   )
									   )
									 )
									 [[Moving::interrupt <- x__ | x__ <- {|interrupt|}]]
									 [[Final::interrupt <- x__ | x__ <- {|interrupt,tick__.NID_Final.in|}]]
									 [[Turning::interrupt <- x__ | x__ <- {|interrupt,internal__.NID_Turning,endTask__.NID_Turning.in,tick__.NID_Turning.in|}]]
									 [[i0::interrupt <- x__ | x__ <- {|internal__.NID_i0|}]]
									 )
									  [[ share__ <- x__ | x__ <- {| share__ |} ]] 
									  [[set_turnDurationElapsed <- setL_turnDurationElapsed]]
									 )
									 [| union(union(union(flowevts,transSync),{terminate}),{|share__
									 			,setL_turnDurationElapsed
									|}) |]
									 ((i0::enter -> Transitions(id__))
									  [[ share__ <- x__ | x__ <- {| share__,setL_turnDurationElapsed |} ]]
									 )
									)[[setL_turnDurationElapsed <- set_turnDurationElapsed]]
									)
								)
								 \ hideSet)
								[[
									endTask__.x____ <- endTask,
									tick__.x____ <- tick,
									move__.x____ <- move
									| x____ <- NIDS
								]]
							)
							)
							 [| union(stateClockSync,{terminate}) |]
							 StateClocks(id__)
							)\diff(stateClockSync,enteredSS))
							 [| {| interrupt |} |] SKIP)
						)
						)
					
					Behaviour(id__) = 
						dbisim((let
							stateClockSync = {|get_CLID_Final,Final::entered,get_CLID_Turning,Turning::entered,get_CLID_Moving,Moving::entered|}
						 within
							(MachineBody(id__) [| union(stateClockSync,{terminate}) |] StateClocks(id__)) \ union(stateClockSync,enteredSS)
						)
						)
					
					IteratedBehaviour(id__) = 
						dbisim((let
							stateClockSync = {|get_CLID_Final,Final::entered,get_CLID_Turning,Turning::entered,get_CLID_Moving,Moving::entered|}
						 within
							(dbisim(
								sbisim(
									dbisim(
										sbisim(
											dbisim(
												sbisim(
													MachineBody(id__)
													[| {|get_CLID_Moving,Moving::entered,terminate|} |]
													dbisim(Clock_CLID_Moving(id__,0))
												)\{|get_CLID_Moving|}
											)
											[| {|get_CLID_Turning,Turning::entered,terminate|} |]
											dbisim(Clock_CLID_Turning(id__,0))
