include "GasAnalysisController_coreassertions.csp"
-- Run 3: Analysis's entry action writes sts = analysis(gs) as a visible set_sts event (the stub gives noGas); G3 asks for the gasD write, which the stub never produces.
assert P_GasAnalysisController :[has trace [T]]: <GasAnalysisController::set_EXT_sts.Status_noGas, GasAnalysisController::gas.in.<>, GasAnalysisController::set_gs.<>, GasAnalysisController::set_sts.Status_noGas, GasAnalysisController::resume.out>
assert P_GasAnalysisController :[has trace [T]]: <GasAnalysisController::set_EXT_sts.Status_noGas, GasAnalysisController::gas.in.<>, GasAnalysisController::set_gs.<>, GasAnalysisController::set_sts.Status_noGas, GasAnalysisController::resume.out, GasAnalysisController::gas.in.<>, GasAnalysisController::set_gs.<>, GasAnalysisController::set_sts.Status_noGas, GasAnalysisController::resume.out>
assert P_GasAnalysisController :[has trace [T]]: <GasAnalysisController::set_EXT_sts.Status_gasD, GasAnalysisController::gas.in.<>, GasAnalysisController::set_gs.<>, GasAnalysisController::set_sts.Status_gasD, GasAnalysisController::stop.out>
assert P_GasAnalysisController :[has trace [T]]: <GasAnalysisController::resume.out>
assert P_GasAnalysisController :[has trace [T]]: <GasAnalysisController::tick.in, GasAnalysisController::resume.out>
assert P_GasAnalysisController :[has trace [T]]: <GasAnalysisController::set_EXT_sts.Status_noGas, GasAnalysisController::gas.in.<>, GasAnalysisController::set_gs.<>, GasAnalysisController::set_sts.Status_noGas, GasAnalysisController::resume.out, GasAnalysisController::resume.out>
