include "GasAnalysisController_coreassertions.csp"
-- Run 2: the gas transition's variable write set_gs is visible in this controller's alphabet and
-- follows gas.in; sts is an environment-set judgement (set_EXT_sts), set explicitly here.
assert P_GasAnalysisController :[has trace]: <GasAnalysisController::set_EXT_sts.Status_noGas, GasAnalysisController::gas.in.<>, GasAnalysisController::set_gs.<>, GasAnalysisController::resume.out>
assert P_GasAnalysisController :[has trace]: <GasAnalysisController::set_EXT_sts.Status_noGas, GasAnalysisController::gas.in.<>, GasAnalysisController::set_gs.<>, GasAnalysisController::resume.out, GasAnalysisController::gas.in.<>, GasAnalysisController::set_gs.<>, GasAnalysisController::resume.out>
assert P_GasAnalysisController :[has trace]: <GasAnalysisController::set_EXT_sts.Status_gasD, GasAnalysisController::gas.in.<>, GasAnalysisController::set_gs.<>, GasAnalysisController::stop.out>
assert P_GasAnalysisController :[has trace]: <GasAnalysisController::resume.out>
assert P_GasAnalysisController :[has trace]: <GasAnalysisController::tick.in, GasAnalysisController::resume.out>
assert P_GasAnalysisController :[has trace]: <GasAnalysisController::set_EXT_sts.Status_noGas, GasAnalysisController::gas.in.<>, GasAnalysisController::set_gs.<>, GasAnalysisController::resume.out, GasAnalysisController::resume.out>
