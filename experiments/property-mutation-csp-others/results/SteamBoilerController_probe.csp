include "SteamBoilerController_coreassertions.csp"
-- Encoding probes (not pre-registered claims): how is the handshake transition's action
-- sequence visible, and when is a shared-variable write read by the guards?
assert P_SteamBoilerController :[has trace]: <SteamBoilerController::set_EXT_startUpAbort.false, SteamBoilerController::transmission.in, SteamBoilerController::programReady.out>
assert P_SteamBoilerController :[has trace]: <SteamBoilerController::set_EXT_startUpAbort.false, SteamBoilerController::transmission.in, SteamBoilerController::setL_programReadySent.true>
assert P_SteamBoilerController :[has trace]: <SteamBoilerController::set_EXT_startUpAbort.false, SteamBoilerController::transmission.in, SteamBoilerController::mode.out, SteamBoilerController::transmission.in, SteamBoilerController::programReady.out>
assert P_SteamBoilerController :[has trace]: <SteamBoilerController::set_EXT_startUpAbort.false, SteamBoilerController::transmission.in, SteamBoilerController::mode.out, SteamBoilerController::transmission.in, SteamBoilerController::set_programReadySent.true>
assert P_SteamBoilerController :[has trace]: <SteamBoilerController::set_EXT_startUpAbort.false, SteamBoilerController::set_EXT_startUpLevelReached.true, SteamBoilerController::set_EXT_programReadySent.false, SteamBoilerController::transmission.in, SteamBoilerController::programReady.out>
assert P_SteamBoilerController :[has trace]: <SteamBoilerController::set_EXT_startUpAbort.false, SteamBoilerController::set_EXT_startUpLevelReached.true, SteamBoilerController::set_EXT_programReadySent.false, SteamBoilerController::transmission.in, SteamBoilerController::set_programReadySent.true>
