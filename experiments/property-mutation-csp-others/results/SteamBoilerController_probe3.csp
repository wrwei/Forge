assert P_SteamBoilerController :[has trace]: <SteamBoilerController::set_EXT_startUpAbort.false, SteamBoilerController::transmission.in, SteamBoilerController::set_programReadySent.true, SteamBoilerController::programReady.out, SteamBoilerController::mode.out>
assert P_SteamBoilerController :[has trace]: <SteamBoilerController::transmission.in, SteamBoilerController::set_EXT_startUpAbort.false, SteamBoilerController::set_programReadySent.true, SteamBoilerController::programReady.out>
assert P_SteamBoilerController :[has trace]: <SteamBoilerController::set_EXT_startUpAbort.false, SteamBoilerController::set_EXT_startUpAbort.false, SteamBoilerController::set_programReadySent.true, SteamBoilerController::programReady.out>
assert P_SteamBoilerController :[has trace]: <SteamBoilerController::set_EXT_startUpAbort.false, SteamBoilerController::transmission.in>
