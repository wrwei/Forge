include "SteamBoilerController_coreassertions.csp"
-- Probe 4: the shortest visible trace that reaches the handshake write, shown in full by the
-- counterexample of a refinement that allows every event except that write.
assert CHAOS(diff(Events, {|SteamBoilerController::set_programReadySent|})) [T= P_SteamBoilerController
assert CHAOS(diff(Events, {|SteamBoilerController::programReady|})) [T= P_SteamBoilerController
