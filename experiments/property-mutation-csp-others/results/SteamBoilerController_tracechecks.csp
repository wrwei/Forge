include "SteamBoilerController_coreassertions.csp"
-- Run 2: the handshake transition's variable write set_programReadySent.true is visible and
-- precedes programReady.out (run 1 omitted it).
assert P_SteamBoilerController :[has trace]: <SteamBoilerController::transmission.in, SteamBoilerController::mode.out>
assert P_SteamBoilerController :[has trace]: <SteamBoilerController::set_EXT_startUpAbort.false, SteamBoilerController::transmission.in, SteamBoilerController::set_programReadySent.true, SteamBoilerController::programReady.out, SteamBoilerController::mode.out>
assert P_SteamBoilerController :[has trace]: <SteamBoilerController::set_EXT_startUpAbort.false, SteamBoilerController::transmission.in, SteamBoilerController::set_programReadySent.true, SteamBoilerController::programReady.out, SteamBoilerController::mode.out, SteamBoilerController::transmission.in, SteamBoilerController::mode.out>
assert P_SteamBoilerController :[has trace]: <SteamBoilerController::mode.out>
assert P_SteamBoilerController :[has trace]: <SteamBoilerController::transmission.in, SteamBoilerController::mode.out, SteamBoilerController::mode.out>
assert P_SteamBoilerController :[has trace]: <SteamBoilerController::transmission.in, SteamBoilerController::programReady.out>
