include "SRangerController_coreassertions.csp"

-- Property-mutation supplement (prereg-property-mutation-sranger.md, addendum): six trace
-- assertions on the controller state machine as checked by Phase 6b. Run 2: every trace
-- begins with Moving's entry action move.out.1, which the initial transition performs before
-- any input is accepted (run 1 omitted it and all six assertions failed at the first event).
assert P_SRangerController :[has trace [T]]: <SRangerController::move.out.1, SRangerController::obstacle.in, SRangerController::markReset.out, SRangerController::move.out.0>
assert P_SRangerController :[has trace [T]]: <SRangerController::move.out.1, SRangerController::endTask.in, SRangerController::move.out.0>
assert P_SRangerController :[has trace [T]]: <SRangerController::move.out.1, SRangerController::obstacle.in, SRangerController::markReset.out, SRangerController::move.out.0, SRangerController::endTask.in, SRangerController::move.out.0>
assert P_SRangerController :[has trace [T]]: <SRangerController::move.out.1, SRangerController::markReset.out>
assert P_SRangerController :[has trace [T]]: <SRangerController::move.out.1, SRangerController::endTask.in, SRangerController::move.out.0, SRangerController::obstacle.in>
assert P_SRangerController :[has trace [T]]: <SRangerController::move.out.1, SRangerController::obstacle.in, SRangerController::markReset.out, SRangerController::move.out.0, SRangerController::obstacle.in>
