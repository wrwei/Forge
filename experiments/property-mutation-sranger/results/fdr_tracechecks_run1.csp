include "SRangerController_coreassertions.csp"

-- Property-mutation supplement (prereg-property-mutation-sranger.md, addendum): six trace
-- assertions on the controller state machine as checked by Phase 6b.
assert P_SRangerController :[has trace]: <SRangerController::obstacle.in, SRangerController::markReset.out, SRangerController::move.out.0>
assert P_SRangerController :[has trace]: <SRangerController::endTask.in, SRangerController::move.out.0>
assert P_SRangerController :[has trace]: <SRangerController::obstacle.in, SRangerController::markReset.out, SRangerController::move.out.0, SRangerController::endTask.in, SRangerController::move.out.0>
assert P_SRangerController :[has trace]: <SRangerController::markReset.out>
assert P_SRangerController :[has trace]: <SRangerController::endTask.in, SRangerController::move.out.0, SRangerController::obstacle.in>
assert P_SRangerController :[has trace]: <SRangerController::obstacle.in, SRangerController::markReset.out, SRangerController::move.out.0, SRangerController::obstacle.in>
