diagram GasAnalysis

enumeration Angle { Left Right Back Front }
enumeration Loc { left right front }
enumeration Status { noGas gasD }

datatype GasSensor {
	c : Chem
	i : real
}

datatype Chem {
	id : int
}

function analysis ( readings : Seq(GasSensor) ) : Status { }
function intensity ( readings : Seq(GasSensor) ) : real { }
function location ( readings : Seq(GasSensor) ) : Angle { }

interface LOperations {
	move ( p0 : real , p1 : Angle )
}

interface Inputs {
	event gas : Seq(GasSensor)
	event tick
	event obstacle : Loc
}

interface Outputs {
	event randomWalk
	event flag
	event changeDirection : Loc
	event shortRandomWalk
}

interface Shared {
	event stop
	event turn : Angle
	event resume
}

interface Sensors {
	var id : int
	var odometer : real
}

interface Actuators {
}

interface GasAnalysis_State {
	var gs : Seq(GasSensor)
	var sts : Status
	var ins : real = 0
	var anl : Angle
}

interface Movement_State {
	var a : Angle
	var d0 : real = 0
	var d1 : real = 0
	var l : Loc
}

interface Constants {
	const thr : real = 5
	const lv : real = 1
	const evadeTime : real = 1
	const stuckPeriod : real = 3
	const stuckDist : real = 2
	const outPeriod : real = 2
}

stm GasAnalysis {
	uses Inputs uses Outputs uses Shared requires GasAnalysis_State requires Constants
	var v : real
	state ANALYSIS {
		entry sts = analysis ( gs )
	}
	state READING {
	}
	state CONCLUDED {
		entry send stop
	}
	state NO_GAS {
		entry send resume
	}
	state GAS_DETECTED {
		entry ins = intensity ( gs )
	}
	initial i0
	transition t_init {
		from i0
		to READING
	}
	transition t1 {
		from READING
		to ANALYSIS
		trigger gas ? gs
	}
	transition t2 {
		from ANALYSIS
		to NO_GAS
		condition sts == noGas
	}
	transition t3 {
		from ANALYSIS
		to GAS_DETECTED
		condition not ( sts == noGas )
	}
	transition t4 {
		from NO_GAS
		to READING
	}
	transition t5 {
		from GAS_DETECTED
		to CONCLUDED
		condition ins >= thr
	}
	transition t6 {
		from GAS_DETECTED
		to READING
		condition not ( ins >= thr )
		action anl = location ( gs ) ; turn ! anl
	}
	transition t7 {
		from CONCLUDED
		to CONCLUDED
		trigger tick
	}
}

controller GasAnalysis_Ctrl {
	uses Inputs uses Outputs uses Shared requires GasAnalysis_State requires Constants
	sref stm_ref0 = GasAnalysis
	connection GasAnalysis_Ctrl on gas to stm_ref0 on gas
	connection GasAnalysis_Ctrl on tick to stm_ref0 on tick
	connection stm_ref0 on resume to GasAnalysis_Ctrl on resume
	connection stm_ref0 on stop to GasAnalysis_Ctrl on stop
	connection stm_ref0 on turn to GasAnalysis_Ctrl on turn
}

stm Movement {
	uses Inputs uses Outputs uses Shared requires Movement_State requires Constants requires Sensors requires LOperations
	var v : real
	clock T
	state FOUND {
		entry send flag ; move ( 0 , Front )
	}
	state TRYING_AGAIN {
		entry move ( lv , a )
	}
	state GETTING_OUT {
		entry send shortRandomWalk ; wait ( outPeriod )
	}
	state AVOIDING_AGAIN {
		entry d1 = odometer
	}
	state GOING {
		entry move ( lv , a )
	}
	state WAITING {
		entry send randomWalk
	}
	state AVOIDING {
		entry d0 = odometer ; changeDirection ! l ; wait ( evadeTime )
	}
	initial i0
	transition t_init {
		from i0
		to WAITING
	}
	transition t1 {
		from WAITING
		to FOUND
		trigger stop
	}
	transition t2 {
		from WAITING
		to GOING
		trigger turn ? a
	}
	transition t3 {
		from WAITING
		to WAITING
		trigger resume
	}
	transition t4 {
		from GOING
		to FOUND
		trigger stop
	}
	transition t5 {
		from GOING
		to GOING
		trigger turn ? a
	}
	transition t6 {
		from GOING
		to AVOIDING
		trigger obstacle ? l
		# T
	}
	transition t7 {
		from GOING
		to WAITING
		trigger resume
	}
	transition t8 {
		from FOUND
		to FOUND
		trigger tick
	}
	transition t9 {
		from AVOIDING
		to FOUND
		trigger stop
	}
	transition t10 {
		from AVOIDING
		to TRYING_AGAIN
		trigger turn ? a
	}
	transition t11 {
		from AVOIDING
		to WAITING
		trigger resume
	}
	transition t12 {
		from TRYING_AGAIN
		to FOUND
		trigger stop
	}
	transition t13 {
		from TRYING_AGAIN
		to TRYING_AGAIN
		trigger turn ? a
	}
	transition t14 {
		from TRYING_AGAIN
		to AVOIDING_AGAIN
		trigger obstacle ? l
	}
	transition t15 {
		from TRYING_AGAIN
		to WAITING
		trigger resume
	}
	transition t16 {
		from AVOIDING_AGAIN
		to FOUND
		trigger stop
	}
	transition t17 {
		from AVOIDING_AGAIN
		to WAITING
		trigger resume
	}
	transition t18 {
		from AVOIDING_AGAIN
		to AVOIDING
		# T
		condition since ( T ) < stuckPeriod \/ d1 - d0 > stuckDist
	}
	transition t19 {
		from AVOIDING_AGAIN
		to GETTING_OUT
		condition not ( since ( T ) < stuckPeriod ) /\ not ( d1 - d0 > stuckDist ) /\ not ( since ( T ) < stuckPeriod \/ d1 - d0 > stuckDist )
	}
	transition t20 {
		from GETTING_OUT
		to FOUND
		trigger stop
	}
	transition t21 {
		from GETTING_OUT
		to GOING
		trigger turn ? a
	}
	transition t22 {
		from GETTING_OUT
		to WAITING
		trigger resume
	}
}

controller Movement_Ctrl {
	uses Inputs uses Outputs uses Shared requires Movement_State requires Constants requires Sensors requires LOperations
	sref stm_ref0 = Movement
	connection Movement_Ctrl on stop to stm_ref0 on stop
	connection Movement_Ctrl on turn to stm_ref0 on turn
	connection Movement_Ctrl on resume to stm_ref0 on resume
	connection Movement_Ctrl on obstacle to stm_ref0 on obstacle
	connection Movement_Ctrl on tick to stm_ref0 on tick
	connection stm_ref0 on randomWalk to Movement_Ctrl on randomWalk
	connection stm_ref0 on flag to Movement_Ctrl on flag
	connection stm_ref0 on changeDirection to Movement_Ctrl on changeDirection
	connection stm_ref0 on shortRandomWalk to Movement_Ctrl on shortRandomWalk
}

module GasAnalysis_System_Module {
	robotic platform GasAnalysis_System_Platform {
		provides Sensors provides Actuators provides Constants
		event gas : Seq(GasSensor)
		event tick
		event obstacle : Loc
		event randomWalk
		event flag
		event changeDirection : Loc
		event shortRandomWalk
	}
	cref ctrl_ref0 = GasAnalysis_Ctrl
	cref ctrl_ref1 = Movement_Ctrl
	connection GasAnalysis_System_Platform on gas to ctrl_ref0 on gas
	connection GasAnalysis_System_Platform on tick to ctrl_ref0 on tick
	connection GasAnalysis_System_Platform on tick to ctrl_ref1 on tick
	connection GasAnalysis_System_Platform on obstacle to ctrl_ref1 on obstacle
	connection ctrl_ref1 on randomWalk to GasAnalysis_System_Platform on randomWalk
	connection ctrl_ref1 on flag to GasAnalysis_System_Platform on flag
	connection ctrl_ref1 on changeDirection to GasAnalysis_System_Platform on changeDirection
	connection ctrl_ref1 on shortRandomWalk to GasAnalysis_System_Platform on shortRandomWalk
	connection ctrl_ref0 on stop to ctrl_ref1 on stop
	connection ctrl_ref0 on turn to ctrl_ref1 on turn
	connection ctrl_ref0 on resume to ctrl_ref1 on resume
}

