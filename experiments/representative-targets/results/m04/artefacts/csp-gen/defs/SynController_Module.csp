								 		    const_SynController_threshold3))
								  [[ share__ <- x__ | x__ <- {| share__,setL_reading1,setL_reading2,setL_reading3 |} ]]
								 )
								)[[setL_reading1 <- set_reading1,setL_reading2 <- set_reading2,setL_reading3 <- set_reading3]]
								)
							)
							 \ hideSet)
							[[
								endTask__.x____ <- endTask,
								advance__.x____ <- advance,
								retreat__.x____ <- retreat,
								tick__.x____ <- tick,
								move__.x____ <- move
