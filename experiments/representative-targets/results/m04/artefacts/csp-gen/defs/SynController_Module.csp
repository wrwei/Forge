					dbisim((
					let
						finalNodesEntered = {||}
					within
						((let
							-- IMPLEMENTATION NOTE:
							-- Here the 'enter' channel set is calculated explicitly because of the use of CSPM 
							-- modules for defining the semantics of each node.
							enterSS = {|
							M2::enter,
							M1::enter,
							M3::enter,
							Final::enter,
							i0::enter
							|}
							hideSet = union(enterSS,{|exit,exited,internal__|})
						within 
							((let
								-- IMPLEMENTATION NOTE: the channel set 'enter' is calculated explicitly
								-- because CSPM modules are used for the semantics of Node.
								flowevts = union(enterSS,{|exit,exited,interrupt|})
								transSync = {|internal__.NID_i0,endTask__.NID_M1.in,advance__.NID_M1.in,retreat__.NID_M1.in,tick__.NID_M1.in,endTask__.NID_M2.in,advance__.NID_M2.in,retreat__.NID_M2.in,tick__.NID_M2.in,endTask__.NID_M3.in,advance__.NID_M3.in,retreat__.NID_M3.in,tick__.NID_M3.in,tick__.NID_Final.in|}
							within
