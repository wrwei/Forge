							stm_ref0::retreat <- retreat,
							stm_ref0::tick <- tick,
							stm_ref0::move <- move,
							stm_ref0::set_lv <- set_lv,
							stm_ref0::get_lv <- get_lv,
							stm_ref0::set_av <- set_av,
							stm_ref0::get_av <- get_av,
							stm_ref0::set_reading1 <- set_reading1,
							stm_ref0::get_reading1 <- get_reading1,
							stm_ref0::set_reading2 <- set_reading2,
							stm_ref0::get_reading2 <- get_reading2,
							stm_ref0::set_reading3 <- set_reading3,
							stm_ref0::get_reading3 <- get_reading3
						]]
					)
						[|
							union(
								{|
								|},
								{|
									stm_ref0::set_EXT_lv,stm_ref0::set_EXT_av,stm_ref0::set_EXT_reading1,stm_ref0::set_EXT_reading2,stm_ref0::set_EXT_reading3
								|}
							)
						|]
					Memory(id__, 0, 0, 0, 0, 0, const_SynController_Ctrl_threshold1, const_SynController_Ctrl_threshold2, const_SynController_Ctrl_threshold3)
				)
				\ union(
					{|
					|},
					{|
						stm_ref0::set_EXT_lv,stm_ref0::set_EXT_av,stm_ref0::set_EXT_reading1,stm_ref0::set_EXT_reading2,stm_ref0::set_EXT_reading3
					|}
				)
				[|{|terminate|}|>SKIP
				,<visibleMemoryEvents,{tock}>)
				
				-- VS version
				VS__(id__,
						    const_SynController_Ctrl_threshold1,
						    const_SynController_Ctrl_threshold2,
						    const_SynController_Ctrl_threshold3) = prioritise(	((
						let
							const_SynController_threshold1 = const_SynController_Ctrl_threshold1
							const_SynController_threshold2 = const_SynController_Ctrl_threshold2
