				-- sharedVarMemory process
				sharedVarMemory(id__,
						    const_SynController_threshold1,
						    const_SynController_threshold2,
						    const_SynController_threshold3) = Memory_lv(0)
				[| { terminate } |] (
				Memory_av(0)
				[| { terminate } |] (
				Memory_reading1(0)
				[| { terminate } |] (
				Memory_reading2(0)
				[| { terminate } |] (
				Memory_reading3(0)
				)
				)
				)
				)
				
				sharedVarSync = {|get_lv,set_lv,set_EXT_lv,get_av,set_av,set_EXT_av,get_reading1,set_reading1,set_EXT_reading1,get_reading2,set_reading2,set_EXT_reading2,get_reading3,set_reading3,set_EXT_reading3|}
				
				sharedVarHide = {|get_lv,get_av,get_reading1,get_reading2,get_reading3|}
				}
		endmodule
		
		Timed(OneStep) {
				-- undefined operations
				
				-- declaring controller memory
				Memory(id__, lv, av, reading1, reading2, reading3, threshold1, threshold2, threshold3) = (
				set_EXT_lv?x__ -> stm_ref0::set_EXT_lv!x__ -> 
				Memory(id__,x__,av,reading1,reading2,reading3,threshold1,threshold2,threshold3)
				 []
				set_EXT_av?x__ -> stm_ref0::set_EXT_av!x__ -> 
				Memory(id__,lv,x__,reading1,reading2,reading3,threshold1,threshold2,threshold3)
				 []
				set_EXT_reading1?x__ -> stm_ref0::set_EXT_reading1!x__ -> 
				Memory(id__,lv,av,x__,reading2,reading3,threshold1,threshold2,threshold3)
				 []
				set_EXT_reading2?x__ -> stm_ref0::set_EXT_reading2!x__ -> 
				Memory(id__,lv,av,reading1,x__,reading3,threshold1,threshold2,threshold3)
				 []
				set_EXT_reading3?x__ -> stm_ref0::set_EXT_reading3!x__ -> 
				Memory(id__,lv,av,reading1,reading2,x__,threshold1,threshold2,threshold3)
				)
				
				D__(id__,
						    const_SynController_Ctrl_threshold1,
						    const_SynController_Ctrl_threshold2,
						    const_SynController_Ctrl_threshold3) = prioritise(	((
						let
							const_SynController_threshold1 = const_SynController_Ctrl_threshold1
							const_SynController_threshold2 = const_SynController_Ctrl_threshold2
							const_SynController_threshold3 = const_SynController_Ctrl_threshold3
						within 
