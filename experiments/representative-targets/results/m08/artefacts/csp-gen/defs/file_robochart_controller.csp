			 	 [] dbisim(((reading5<=const_SynController_threshold5))&(advance__!NID_M5.in -> SKIP ;  share__choice(exit -> SKIP) ; (share__choice(exited -> SKIP) ; true&(share__choice(move.out!1 -> SKIP)) ; M6::enter -> SKIP)))
			 	 [] dbisim(((not (((reading5<=const_SynController_threshold5)))))&(retreat__!NID_M5.in -> SKIP ;  share__choice(exit -> SKIP) ; (share__choice(exited -> SKIP) ; true&(share__choice(move.out!0 -> SKIP)) ; M4::enter -> SKIP)))
			 	 [] dbisim((true)&(tick__!NID_M5.in -> SKIP ;  share__choice(exit -> SKIP) ; (share__choice(exited -> SKIP) ; SKIP ; M5::enter -> SKIP)))
