			    const_SynController_threshold2,
			    const_SynController_threshold3,
			    const_SynController_threshold4,
			    const_SynController_threshold5,
			    const_SynController_threshold6,
			    const_SynController_threshold7) = -- RULE: [[stm:StateMachineDef]]_STM^nops : CSPProcess
	( 
		(
			(
				(IteratedStateful(id__,
						    const_SynController_threshold1,
						    const_SynController_threshold2,
						    const_SynController_threshold3,
						    const_SynController_threshold4,
						    const_SynController_threshold5,
						    const_SynController_threshold6,
						    const_SynController_threshold7) \ {terminate} ; share__choice(terminate -> SKIP))
			 	[[ share__ <- x__ | x__ <- {|set_EXT_lv,set_EXT_av,set_EXT_reading1,set_EXT_reading2,set_EXT_reading3,set_EXT_reading4,set_EXT_reading5,set_EXT_reading6,set_EXT_reading7|} ]]
			)
		[| {share__} |]
		SKIP
		)
		[| union(sharedVarSync,{terminate}) |]
