		[]
		set_reading7?x__ -> Memory_reading7(x__)
		[]
		set_EXT_reading7?x__ -> Memory_reading7(x__)
		[]
		terminate -> SKIP
	
	-- sharedVarMemory process
	sharedVarMemory(id__,
			    const_SynController_threshold1,
			    const_SynController_threshold2,
			    const_SynController_threshold3,
			    const_SynController_threshold4,
			    const_SynController_threshold5,
			    const_SynController_threshold6,
			    const_SynController_threshold7) = Memory_lv(0)
	[| { terminate } |] (
	Memory_av(0)
	[| { terminate } |] (
	Memory_reading1(0)
	[| { terminate } |] (
	Memory_reading2(0)
	[| { terminate } |] (
	Memory_reading3(0)
	[| { terminate } |] (
	Memory_reading4(0)
	[| { terminate } |] (
	Memory_reading5(0)
	[| { terminate } |] (
	Memory_reading6(0)
	[| { terminate } |] (
	Memory_reading7(0)
	)
	)
	)
	)
	)
	)
	)
	)
	
	sharedVarSync = {|get_lv,set_lv,set_EXT_lv,get_av,set_av,set_EXT_av,get_reading1,set_reading1,set_EXT_reading1,get_reading2,set_reading2,set_EXT_reading2,get_reading3,set_reading3,set_EXT_reading3,get_reading4,set_reading4,set_EXT_reading4,get_reading5,set_reading5,set_EXT_reading5,get_reading6,set_reading6,set_EXT_reading6,get_reading7,set_reading7,set_EXT_reading7|}
	
	sharedVarHide = {|get_lv,get_av,get_reading1,get_reading2,get_reading3,get_reading4,get_reading5,get_reading6,get_reading7|}
endmodule


