module SynController
exports
	transparent diamond
	transparent sbisim
	transparent dbisim
	transparent chase

	-- Transition identifiers
	-- declaring identifiers of transitions
	datatype NIDS = 
	              NID_M2|
	              NID_M1|
	              NID_M6|
	              NID_M5|
	              NID_M3|
	              NID_M4|
	              NID_Final|
	              NID_M7|
	              NID_i0
	
	channel internal__ : NIDS
	
	-- Flow channels		
	channel interrupt
	channel exited
	channel exit
	channel terminate
	
	-- Variable channels
	channel get_lv, set_lv, setL_lv, setR_lv: core_real
	channel get_av, set_av, setL_av, setR_av: core_real
	channel get_reading1, set_reading1, setL_reading1, setR_reading1: core_real
	channel get_reading2, set_reading2, setL_reading2, setR_reading2: core_real
	channel get_reading3, set_reading3, setL_reading3, setR_reading3: core_real
	channel get_reading4, set_reading4, setL_reading4, setR_reading4: core_real
	channel get_reading5, set_reading5, setL_reading5, setR_reading5: core_real
	channel get_reading6, set_reading6, setL_reading6, setR_reading6: core_real
	channel get_reading7, set_reading7, setL_reading7, setR_reading7: core_real
	
	-- Shared variable channels
	channel set_EXT_lv: core_real
	channel set_EXT_av: core_real
	channel set_EXT_reading1: core_real
	channel set_EXT_reading2: core_real
	channel set_EXT_reading3: core_real
	channel set_EXT_reading4: core_real
	channel set_EXT_reading5: core_real
	channel set_EXT_reading6: core_real
	channel set_EXT_reading7: core_real
	
	-- Local variable channels for defined operations that are required by the state machine
	
	-- Declaring state machine events
	channel endTask__: NIDS.InOut
	channel endTask: InOut
	channel advance__: NIDS.InOut
	channel advance: InOut
	channel retreat__: NIDS.InOut
	channel retreat: InOut
	channel tick__: NIDS.InOut
	channel tick: InOut
	channel move__: NIDS.InOut.core_real
	channel move: InOut.core_real
	
	-- Declaring call and ret events for undefined operations
	
	enterSS = {|
	M2::enter,
	M1::enter,
	M6::enter,
	M5::enter,
	M3::enter,
	M4::enter,
	Final::enter,
	M7::enter,
	i0::enter
	|}
	
	enteredSS = 	{|
	M2::entered,
	M1::entered,
	M6::entered,
	M5::entered,
	M3::entered,
	M4::entered,
	Final::entered,
	M7::entered
	|}
	
	internal_events = union(enteredSS,union(enterSS,{|interrupt,exited|}))
	
	shared_variable_events = {|
		set_EXT_lv,
		set_EXT_av,
		set_EXT_reading1,
		set_EXT_reading2,
		set_EXT_reading3,
		set_EXT_reading4,
		set_EXT_reading5,
		set_EXT_reading6,
		set_EXT_reading7
	|}
	
	-- channel set with all visible events
	sem__events = {|
		terminate
	,	set_EXT_lv, set_lv,
		set_EXT_av, set_av,
		set_EXT_reading1, set_reading1,
		set_EXT_reading2, set_reading2,
		set_EXT_reading3, set_reading3,
		set_EXT_reading4, set_reading4,
		set_EXT_reading5, set_reading5,
		set_EXT_reading6, set_reading6,
		set_EXT_reading7, set_reading7
	,	endTask,
		advance,
		retreat,
		tick,
		move
		|}

	-- Nodes --
	-- declaring all nodes
	
	----------------------------------------------------------------------
	-- State: M2
	module M2
	
	enterSS = {}
	
	enteredSS = {}
	
	exports
	
		--  Declarations
		
		channel enter, entered, interrupt
		channel enteredL, enteredR
		
						
		
		--	Nodes
		-- declaring all nodes
		
		
		--	Rule: behaviours(Node)
		--  Note that FDR has problems with efficiently compiling the process below
		-- 	if using a different recursion pattern.
		D__(id__,
				    const_SynController_threshold1,
				    const_SynController_threshold2,
				    const_SynController_threshold3,
				    const_SynController_threshold4,
				    const_SynController_threshold5,
				    const_SynController_threshold6,
				    const_SynController_threshold7) = 
		dbisim(let
			-- IMPLEMENTATION NOTE: 
			-- The following should be defined as: Inactive = share__choice(Activation [] Termination),
			-- however FDR struggles with that form in certain cases. So we use the exception operator
			-- instead to 'terminate'.
			
			Inactive 	= share__choice(enter -> SKIP [] terminate -> SKIP) ; Active
			
			Termination = terminate -> SKIP
			
			Active 		= SKIP ; 
					 	  Behaviour ; 
					 	  share__choice(exit -> SKIP) ; SKIP ; 
					 	  share__choice(exited -> SKIP) ; Inactive
		
			Behaviour 	= entered -> During
			During 		= ((SKIP ; SStop) /\ interrupt -> SKIP)
		within
			Inactive [| {terminate} |> SKIP)
			
		VS_O__(id__,
				    const_SynController_threshold1,
