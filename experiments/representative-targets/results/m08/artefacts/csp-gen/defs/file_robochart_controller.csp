				    const_SynController_threshold2,
				    const_SynController_threshold3,
				    const_SynController_threshold4,
				    const_SynController_threshold5,
				    const_SynController_threshold6,
				    const_SynController_threshold7))
	
	-- END
	
	-- Memory
	-- Memory variables
	
	-- varMemory process
	varMemory(id__,
			    const_SynController_threshold1,
			    const_SynController_threshold2,
			    const_SynController_threshold3,
			    const_SynController_threshold4,
			    const_SynController_threshold5,
			    const_SynController_threshold6,
			    const_SynController_threshold7) = terminate -> SKIP
	
	getsetLocalChannels = {||}
	
	-- Definition of the behaviour of state machines (default, optimised, visible, visible and optimised)
	FVS__(id__,
			    const_SynController_threshold1,
			    const_SynController_threshold2,
			    const_SynController_threshold3,
			    const_SynController_threshold4,
			    const_SynController_threshold5,
			    const_SynController_threshold6,
			    const_SynController_threshold7) = STM_VS_O(id__,
			    const_SynController_threshold1,
			    const_SynController_threshold2,
			    const_SynController_threshold3,
			    const_SynController_threshold4,
			    const_SynController_threshold5,
			    const_SynController_threshold6,
			    const_SynController_threshold7)
	
	D__(id__,
			    const_SynController_threshold1,
			    const_SynController_threshold2,
			    const_SynController_threshold3,
			    const_SynController_threshold4,
			    const_SynController_threshold5,
			    const_SynController_threshold6,
			    const_SynController_threshold7) = STM(id__,
			    const_SynController_threshold1,
			    const_SynController_threshold2,
			    const_SynController_threshold3,
			    const_SynController_threshold4,
			    const_SynController_threshold5,
			    const_SynController_threshold6,
			    const_SynController_threshold7) \ internal_events
	O__(id__,
			    const_SynController_threshold1,
			    const_SynController_threshold2,
			    const_SynController_threshold3,
			    const_SynController_threshold4,
			    const_SynController_threshold5,
			    const_SynController_threshold6,
			    const_SynController_threshold7) = sbisim(diamond(D__(id__,
			    const_SynController_threshold1,
			    const_SynController_threshold2,
			    const_SynController_threshold3,
			    const_SynController_threshold4,
			    const_SynController_threshold5,
			    const_SynController_threshold6,
			    const_SynController_threshold7)))
	VS__(id__,
			    const_SynController_threshold1,
			    const_SynController_threshold2,
			    const_SynController_threshold3,
			    const_SynController_threshold4,
			    const_SynController_threshold5,
			    const_SynController_threshold6,
			    const_SynController_threshold7) = FVS__(id__,
			    const_SynController_threshold1,
			    const_SynController_threshold2,
			    const_SynController_threshold3,
			    const_SynController_threshold4,
			    const_SynController_threshold5,
			    const_SynController_threshold6,
			    const_SynController_threshold7)
	VS_O__(id__,
			    const_SynController_threshold1,
			    const_SynController_threshold2,
			    const_SynController_threshold3,
			    const_SynController_threshold4,
			    const_SynController_threshold5,
			    const_SynController_threshold6,
			    const_SynController_threshold7) = sbisim(diamond(FVS__(id__,
			    const_SynController_threshold1,
			    const_SynController_threshold2,
			    const_SynController_threshold3,
			    const_SynController_threshold4,
			    const_SynController_threshold5,
			    const_SynController_threshold6,
			    const_SynController_threshold7)))
	HEXT__(id__,
			    const_SynController_threshold1,
			    const_SynController_threshold2,
			    const_SynController_threshold3,
			    const_SynController_threshold4,
			    const_SynController_threshold5,
			    const_SynController_threshold6,
			    const_SynController_threshold7) = O__(id__,
			    const_SynController_threshold1,
			    const_SynController_threshold2,
			    const_SynController_threshold3,
			    const_SynController_threshold4,
			    const_SynController_threshold5,
			    const_SynController_threshold6,
			    const_SynController_threshold7) [|shared_variable_events|] SKIP
	HUP__(id__,
			    const_SynController_threshold1,
			    const_SynController_threshold2,
			    const_SynController_threshold3,
			    const_SynController_threshold4,
			    const_SynController_threshold5,
			    const_SynController_threshold6,
			    const_SynController_threshold7) = O__(id__,
			    const_SynController_threshold1,
			    const_SynController_threshold2,
			    const_SynController_threshold3,
			    const_SynController_threshold4,
			    const_SynController_threshold5,
			    const_SynController_threshold6,
			    const_SynController_threshold7) [|{share__}|] SKIP
	
	-- Shared memory
	-- Shared memory variables
	Memory_lv(lv) =
		get_lv!lv -> Memory_lv(lv)
		[]
		set_lv?x__ -> Memory_lv(x__)
		[]
		set_EXT_lv?x__ -> Memory_lv(x__)
		[]
		terminate -> SKIP
	Memory_av(av) =
		get_av!av -> Memory_av(av)
		[]
		set_av?x__ -> Memory_av(x__)
		[]
		set_EXT_av?x__ -> Memory_av(x__)
		[]
		terminate -> SKIP
	Memory_reading1(reading1) =
		get_reading1!reading1 -> Memory_reading1(reading1)
		[]
		set_reading1?x__ -> Memory_reading1(x__)
		[]
