					 [[M1::interrupt <- x__ | x__ <- {|interrupt,endTask__.NID_M1.in,advance__.NID_M1.in,retreat__.NID_M1.in,tick__.NID_M1.in|}]]
					 [[M6::interrupt <- x__ | x__ <- {|interrupt,endTask__.NID_M6.in,advance__.NID_M6.in,retreat__.NID_M6.in,tick__.NID_M6.in|}]]
