		[]
		set_reading5?x__ -> Memory_reading5(x__)
		[]
		set_EXT_reading5?x__ -> Memory_reading5(x__)
		[]
		terminate -> SKIP
	Memory_reading6(reading6) =
		get_reading6!reading6 -> Memory_reading6(reading6)
		[]
		set_reading6?x__ -> Memory_reading6(x__)
		[]
		set_EXT_reading6?x__ -> Memory_reading6(x__)
		[]
