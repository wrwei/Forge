			    const_SynController_threshold7) = ((let
		Trans = share__choice(get_reading1?reading1 -> get_reading4?reading4 -> get_reading2?reading2 -> get_reading6?reading6 -> get_reading3?reading3 -> get_reading5?reading5 -> get_reading7?reading7 -> (
			((share__ -> SKIP
			 [] dbisim((true)&(internal__!NID_i0 -> SKIP ;  ((SKIP ; M1::enter -> SKIP))))
			 	 [] dbisim((true)&(endTask__!NID_M1.in -> SKIP ;  share__choice(exit -> SKIP) ; (share__choice(exited -> SKIP) ; SKIP ; Final::enter -> SKIP)))
			 	 [] dbisim(((reading1<=const_SynController_threshold1))&(advance__!NID_M1.in -> SKIP ;  share__choice(exit -> SKIP) ; (share__choice(exited -> SKIP) ; true&(share__choice(move.out!1 -> SKIP)) ; M2::enter -> SKIP)))
			 	 [] dbisim(((not (((reading1<=const_SynController_threshold1)))))&(retreat__!NID_M1.in -> SKIP ;  share__choice(exit -> SKIP) ; (share__choice(exited -> SKIP) ; true&(share__choice(move.out!0 -> SKIP)) ; M1::enter -> SKIP)))
			 	 [] dbisim((true)&(tick__!NID_M1.in -> SKIP ;  share__choice(exit -> SKIP) ; (share__choice(exited -> SKIP) ; SKIP ; M1::enter -> SKIP)))
			 	 [] dbisim((true)&(endTask__!NID_M2.in -> SKIP ;  share__choice(exit -> SKIP) ; (share__choice(exited -> SKIP) ; SKIP ; Final::enter -> SKIP)))
			 	 [] dbisim(((reading2<=const_SynController_threshold2))&(advance__!NID_M2.in -> SKIP ;  share__choice(exit -> SKIP) ; (share__choice(exited -> SKIP) ; true&(share__choice(move.out!1 -> SKIP)) ; M3::enter -> SKIP)))
			 	 [] dbisim(((not (((reading2<=const_SynController_threshold2)))))&(retreat__!NID_M2.in -> SKIP ;  share__choice(exit -> SKIP) ; (share__choice(exited -> SKIP) ; true&(share__choice(move.out!0 -> SKIP)) ; M1::enter -> SKIP)))
			 	 [] dbisim((true)&(tick__!NID_M2.in -> SKIP ;  share__choice(exit -> SKIP) ; (share__choice(exited -> SKIP) ; SKIP ; M2::enter -> SKIP)))
			 	 [] dbisim((true)&(endTask__!NID_M3.in -> SKIP ;  share__choice(exit -> SKIP) ; (share__choice(exited -> SKIP) ; SKIP ; Final::enter -> SKIP)))
			 	 [] dbisim(((reading3<=const_SynController_threshold3))&(advance__!NID_M3.in -> SKIP ;  share__choice(exit -> SKIP) ; (share__choice(exited -> SKIP) ; true&(share__choice(move.out!1 -> SKIP)) ; M4::enter -> SKIP)))
			 	 [] dbisim(((not (((reading3<=const_SynController_threshold3)))))&(retreat__!NID_M3.in -> SKIP ;  share__choice(exit -> SKIP) ; (share__choice(exited -> SKIP) ; true&(share__choice(move.out!0 -> SKIP)) ; M2::enter -> SKIP)))
			 	 [] dbisim((true)&(tick__!NID_M3.in -> SKIP ;  share__choice(exit -> SKIP) ; (share__choice(exited -> SKIP) ; SKIP ; M3::enter -> SKIP)))
			 	 [] dbisim((true)&(endTask__!NID_M4.in -> SKIP ;  share__choice(exit -> SKIP) ; (share__choice(exited -> SKIP) ; SKIP ; Final::enter -> SKIP)))
			 	 [] dbisim(((reading4<=const_SynController_threshold4))&(advance__!NID_M4.in -> SKIP ;  share__choice(exit -> SKIP) ; (share__choice(exited -> SKIP) ; true&(share__choice(move.out!1 -> SKIP)) ; M5::enter -> SKIP)))
