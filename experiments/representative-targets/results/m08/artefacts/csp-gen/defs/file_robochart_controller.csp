					    const_SynController_threshold5,
					    const_SynController_threshold6,
					    const_SynController_threshold7) [| union(getsetLocalChannels,{terminate}) |] varMemory(id__,
					    const_SynController_threshold1,
					    const_SynController_threshold2,
					    const_SynController_threshold3,
					    const_SynController_threshold4,
					    const_SynController_threshold5,
					    const_SynController_threshold6,
					    const_SynController_threshold7))
		 	\getsetLocalChannels
		)
		)
	
	IteratedStateful(id__,
			    const_SynController_threshold1,
			    const_SynController_threshold2,
			    const_SynController_threshold3,
			    const_SynController_threshold4,
			    const_SynController_threshold5,
			    const_SynController_threshold6,
			    const_SynController_threshold7) =
		(Behaviour(id__,
				    const_SynController_threshold1,
				    const_SynController_threshold2,
				    const_SynController_threshold3,
				    const_SynController_threshold4,
				    const_SynController_threshold5,
				    const_SynController_threshold6,
				    const_SynController_threshold7))
	
	-- Visible counterparts
	MachineBody_VS_O(id__,
			    const_SynController_threshold1,
			    const_SynController_threshold2,
			    const_SynController_threshold3,
			    const_SynController_threshold4,
			    const_SynController_threshold5,
			    const_SynController_threshold6,
			    const_SynController_threshold7) = 
		dbisim((
		let
			finalNodesEntered = {||}
		within
			((let
				-- IMPLEMENTATION NOTE:
				-- Here the 'enter' channel set is calculated explicitly because of the use of CSPM 
				-- modules for defining the semantics of each node.
				enterSS = {|
				M2::enter,
				M1::enter,
				M6::enter,
				M5::enter,
				M3::enter,
				M4::enter,
				Final::enter,
				M7::enter,
				i0::enter
				|}
				hideSet = union(enterSS,{|exit,exited,internal__|})
			within 
				((let
					-- IMPLEMENTATION NOTE: the channel set 'enter' is calculated explicitly
					-- because CSPM modules are used for the semantics of Node.
					flowevts = union(enterSS,{|exit,exited,interrupt|})
					transSync = {|internal__.NID_i0,endTask__.NID_M1.in,advance__.NID_M1.in,retreat__.NID_M1.in,tick__.NID_M1.in,endTask__.NID_M2.in,advance__.NID_M2.in,retreat__.NID_M2.in,tick__.NID_M2.in,endTask__.NID_M3.in,advance__.NID_M3.in,retreat__.NID_M3.in,tick__.NID_M3.in,endTask__.NID_M4.in,advance__.NID_M4.in,retreat__.NID_M4.in,tick__.NID_M4.in,endTask__.NID_M5.in,advance__.NID_M5.in,retreat__.NID_M5.in,tick__.NID_M5.in,endTask__.NID_M6.in,advance__.NID_M6.in,retreat__.NID_M6.in,tick__.NID_M6.in,endTask__.NID_M7.in,advance__.NID_M7.in,retreat__.NID_M7.in,tick__.NID_M7.in,tick__.NID_Final.in|}
				within
					((
					 (((-- RULE composeNodes(nc:NodeContainer)^nops : CSPProcess
					   M2::VS_O__(id__,
					   		    const_SynController_threshold1,
					   		    const_SynController_threshold2,
					   		    const_SynController_threshold3,
					   		    const_SynController_threshold4,
					   		    const_SynController_threshold5,
					   		    const_SynController_threshold6,
					   		    const_SynController_threshold7)
					   [| { share__, terminate } |] (
					   M1::VS_O__(id__,
					   		    const_SynController_threshold1,
					   		    const_SynController_threshold2,
					   		    const_SynController_threshold3,
					   		    const_SynController_threshold4,
					   		    const_SynController_threshold5,
					   		    const_SynController_threshold6,
					   		    const_SynController_threshold7)
					   [| { share__, terminate } |] (
					   M6::VS_O__(id__,
					   		    const_SynController_threshold1,
					   		    const_SynController_threshold2,
					   		    const_SynController_threshold3,
					   		    const_SynController_threshold4,
					   		    const_SynController_threshold5,
					   		    const_SynController_threshold6,
					   		    const_SynController_threshold7)
					   [| { share__, terminate } |] (
					   M5::VS_O__(id__,
					   		    const_SynController_threshold1,
					   		    const_SynController_threshold2,
					   		    const_SynController_threshold3,
					   		    const_SynController_threshold4,
					   		    const_SynController_threshold5,
					   		    const_SynController_threshold6,
					   		    const_SynController_threshold7)
					   [| { share__, terminate } |] (
					   M3::VS_O__(id__,
					   		    const_SynController_threshold1,
					   		    const_SynController_threshold2,
					   		    const_SynController_threshold3,
					   		    const_SynController_threshold4,
					   		    const_SynController_threshold5,
					   		    const_SynController_threshold6,
					   		    const_SynController_threshold7)
					   [| { share__, terminate } |] (
					   M4::VS_O__(id__,
					   		    const_SynController_threshold1,
					   		    const_SynController_threshold2,
					   		    const_SynController_threshold3,
					   		    const_SynController_threshold4,
					   		    const_SynController_threshold5,
					   		    const_SynController_threshold6,
					   		    const_SynController_threshold7)
					   [| { share__, terminate } |] (
					   Final::VS_O__(id__,
					   		    const_SynController_threshold1,
					   		    const_SynController_threshold2,
					   		    const_SynController_threshold3,
					   		    const_SynController_threshold4,
					   		    const_SynController_threshold5,
					   		    const_SynController_threshold6,
					   		    const_SynController_threshold7)
					   [| { share__, terminate } |] (
					   M7::VS_O__(id__,
					   		    const_SynController_threshold1,
					   		    const_SynController_threshold2,
					   		    const_SynController_threshold3,
					   		    const_SynController_threshold4,
					   		    const_SynController_threshold5,
					   		    const_SynController_threshold6,
					   		    const_SynController_threshold7)
					   [| { share__, terminate } |] (
					   i0::VS_O__(id__,
					   		    const_SynController_threshold1,
					   		    const_SynController_threshold2,
					   		    const_SynController_threshold3,
					   		    const_SynController_threshold4,
					   		    const_SynController_threshold5,
					   		    const_SynController_threshold6,
					   		    const_SynController_threshold7)
					   )
					   )
					   )
					   )
					   )
					   )
					   )
					   )
					 )
					 [[M2::interrupt <- x__ | x__ <- {|interrupt,endTask__.NID_M2.in,advance__.NID_M2.in,retreat__.NID_M2.in,tick__.NID_M2.in|}]]
					 [[M1::interrupt <- x__ | x__ <- {|interrupt,endTask__.NID_M1.in,advance__.NID_M1.in,retreat__.NID_M1.in,tick__.NID_M1.in|}]]
					 [[M6::interrupt <- x__ | x__ <- {|interrupt,endTask__.NID_M6.in,advance__.NID_M6.in,retreat__.NID_M6.in,tick__.NID_M6.in|}]]
					 [[M5::interrupt <- x__ | x__ <- {|interrupt,endTask__.NID_M5.in,advance__.NID_M5.in,retreat__.NID_M5.in,tick__.NID_M5.in|}]]
					 [[M3::interrupt <- x__ | x__ <- {|interrupt,endTask__.NID_M3.in,advance__.NID_M3.in,retreat__.NID_M3.in,tick__.NID_M3.in|}]]
					 [[M4::interrupt <- x__ | x__ <- {|interrupt,endTask__.NID_M4.in,advance__.NID_M4.in,retreat__.NID_M4.in,tick__.NID_M4.in|}]]
					 [[Final::interrupt <- x__ | x__ <- {|interrupt,tick__.NID_Final.in|}]]
					 [[M7::interrupt <- x__ | x__ <- {|interrupt,endTask__.NID_M7.in,advance__.NID_M7.in,retreat__.NID_M7.in,tick__.NID_M7.in|}]]
					 [[i0::interrupt <- x__ | x__ <- {|internal__.NID_i0|}]]
					 )
					  [[ share__ <- x__ | x__ <- {| share__ |} ]] 
					  [[set_reading1 <- setL_reading1,set_reading4 <- setL_reading4,set_reading2 <- setL_reading2,set_reading6 <- setL_reading6,set_reading3 <- setL_reading3,set_reading5 <- setL_reading5,set_reading7 <- setL_reading7]]
					 )
					 [| union(union(union(flowevts,transSync),{terminate}),{|share__
					 			,setL_reading1
					 			,setL_reading4
					 			,setL_reading2
					 			,setL_reading6
					 			,setL_reading3
					 			,setL_reading5
					 			,setL_reading7
					|}) |]
					 ((i0::enter -> Transitions(id__,
					 		    const_SynController_threshold1,
					 		    const_SynController_threshold2,
					 		    const_SynController_threshold3,
					 		    const_SynController_threshold4,
					 		    const_SynController_threshold5,
					 		    const_SynController_threshold6,
					 		    const_SynController_threshold7))
					  [[ share__ <- x__ | x__ <- {| share__,setL_reading1,setL_reading4,setL_reading2,setL_reading6,setL_reading3,setL_reading5,setL_reading7 |} ]]
					 )
					)[[setL_reading1 <- set_reading1,setL_reading4 <- set_reading4,setL_reading2 <- set_reading2,setL_reading6 <- set_reading6,setL_reading3 <- set_reading3,setL_reading5 <- set_reading5,setL_reading7 <- set_reading7]]
					)
				)
				 \ hideSet)
				[[
					endTask__.x____ <- endTask,
					advance__.x____ <- advance,
					retreat__.x____ <- retreat,
					tick__.x____ <- tick,
					move__.x____ <- move
					| x____ <- NIDS
				]]
			)
			 [| {| interrupt |} |] SKIP)
		)
		)
	
	Behaviour_VS_O(id__,
			    const_SynController_threshold1,
			    const_SynController_threshold2,
			    const_SynController_threshold3,
			    const_SynController_threshold4,
			    const_SynController_threshold5,
			    const_SynController_threshold6,
			    const_SynController_threshold7) = 
		dbisim((MachineBody_VS_O(id__,
				    const_SynController_threshold1,
				    const_SynController_threshold2,
				    const_SynController_threshold3,
				    const_SynController_threshold4,
				    const_SynController_threshold5,
				    const_SynController_threshold6,
				    const_SynController_threshold7))
		)
	
	IteratedBehaviour_VS_O(id__,
			    const_SynController_threshold1,
			    const_SynController_threshold2,
			    const_SynController_threshold3,
			    const_SynController_threshold4,
			    const_SynController_threshold5,
			    const_SynController_threshold6,
			    const_SynController_threshold7) = 
