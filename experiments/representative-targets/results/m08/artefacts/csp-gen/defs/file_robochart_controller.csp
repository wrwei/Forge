			 	 [] dbisim(((not (((reading6<=const_SynController_threshold6)))))&(retreat__!NID_M6.in -> SKIP ;  share__choice(exit -> SKIP) ; (share__choice(exited -> SKIP) ; true&(share__choice(move.out!0 -> SKIP)) ; M5::enter -> SKIP)))
			 	 [] dbisim((true)&(tick__!NID_M6.in -> SKIP ;  share__choice(exit -> SKIP) ; (share__choice(exited -> SKIP) ; SKIP ; M6::enter -> SKIP)))
			 	 [] dbisim((true)&(endTask__!NID_M7.in -> SKIP ;  share__choice(exit -> SKIP) ; (share__choice(exited -> SKIP) ; SKIP ; Final::enter -> SKIP)))
			 	 [] dbisim(((reading7<=const_SynController_threshold7))&(advance__!NID_M7.in -> SKIP ;  share__choice(exit -> SKIP) ; (share__choice(exited -> SKIP) ; true&(share__choice(move.out!1 -> SKIP)) ; M1::enter -> SKIP)))
			 	 [] dbisim(((not (((reading7<=const_SynController_threshold7)))))&(retreat__!NID_M7.in -> SKIP ;  share__choice(exit -> SKIP) ; (share__choice(exited -> SKIP) ; true&(share__choice(move.out!0 -> SKIP)) ; M6::enter -> SKIP)))
			 	 [] dbisim((true)&(tick__!NID_M7.in -> SKIP ;  share__choice(exit -> SKIP) ; (share__choice(exited -> SKIP) ; SKIP ; M7::enter -> SKIP)))
			 	 [] dbisim((true)&(tick__!NID_Final.in -> SKIP ;  share__choice(exit -> SKIP) ; (share__choice(exited -> SKIP) ; SKIP ; Final::enter -> SKIP)))
			 ) ; Trans)
			 []
			 (interrupt -> share__choice(exit -> SKIP) ; share__choice(exited -> terminate -> SKIP))
			 []
			 terminate -> SKIP
		)
		)
	within
		Trans
	)
	)
	
	-- Stateful
	-- RULE: Stateful(stm:StateMachineBody) : CSPProcess
	
	-- Named process definitions
	MachineBody(id__,
			    const_SynController_threshold1,
			    const_SynController_threshold2,
			    const_SynController_threshold3,
			    const_SynController_threshold4,
			    const_SynController_threshold5,
			    const_SynController_threshold6,
			    const_SynController_threshold7) = 
		dbisim((
		let
			finalNodesEntered = {||}
		within
			((let
				-- IMPLEMENTATION NOTE:
				-- Here the 'enter' channel set is calculated explicitly because of the use of CSPM 
				-- modules for defining the semantics of each node.
				enterSS = {|
				M2::enter,
				M1::enter,
				M6::enter,
				M5::enter,
				M3::enter,
				M4::enter,
				Final::enter,
				M7::enter,
				i0::enter
				|}
				hideSet = union(enterSS,{|exit,exited,internal__|})
			within 
				((let
					-- IMPLEMENTATION NOTE: the channel set 'enter' is calculated explicitly
					-- because CSPM modules are used for the semantics of Node.
					flowevts = union(enterSS,{|exit,exited,interrupt|})
					transSync = {|internal__.NID_i0,endTask__.NID_M1.in,advance__.NID_M1.in,retreat__.NID_M1.in,tick__.NID_M1.in,endTask__.NID_M2.in,advance__.NID_M2.in,retreat__.NID_M2.in,tick__.NID_M2.in,endTask__.NID_M3.in,advance__.NID_M3.in,retreat__.NID_M3.in,tick__.NID_M3.in,endTask__.NID_M4.in,advance__.NID_M4.in,retreat__.NID_M4.in,tick__.NID_M4.in,endTask__.NID_M5.in,advance__.NID_M5.in,retreat__.NID_M5.in,tick__.NID_M5.in,endTask__.NID_M6.in,advance__.NID_M6.in,retreat__.NID_M6.in,tick__.NID_M6.in,endTask__.NID_M7.in,advance__.NID_M7.in,retreat__.NID_M7.in,tick__.NID_M7.in,tick__.NID_Final.in|}
				within
