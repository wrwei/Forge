	module SynController_Ctrl
		shared_variable_events = {|
			set_EXT_lv,
			set_EXT_av,
			set_EXT_reading1,
			set_EXT_reading2,
			set_EXT_reading3,
			set_EXT_reading4,
			set_EXT_reading5,
			set_EXT_reading6,
			set_EXT_reading7
		|}
		
	exports
		transparent diamond
		transparent sbisim
		transparent dbisim
		transparent chase

		-- declaring controller events
		channel endTask: InOut
		channel advance: InOut
		channel retreat: InOut
		channel tick: InOut
		channel move: InOut.core_real
		
		channel set_lv: core_real
		channel get_lv: core_real
		channel set_av: core_real
		channel get_av: core_real
		channel set_reading1: core_real
		channel get_reading1: core_real
		channel set_reading2: core_real
		channel get_reading2: core_real
		channel set_reading3: core_real
		channel get_reading3: core_real
		channel set_reading4: core_real
		channel get_reading4: core_real
		channel set_reading5: core_real
		channel get_reading5: core_real
		channel set_reading6: core_real
		channel get_reading6: core_real
