diagram SynController

interface Inputs {
	event endTask
	event advance
	event retreat
	event tick
}

interface Outputs {
	event move : real
}

interface Sensors {
	var lv : real
	var av : real
	var reading1 : real
	var reading2 : real
	var reading3 : real
	var reading4 : real
	var reading5 : real
	var reading6 : real
	var reading7 : real
	var reading8 : real
	var reading9 : real
	var reading10 : real
	var reading11 : real
	var reading12 : real
	var reading13 : real
	var reading14 : real
	var reading15 : real
}

interface Actuators {
}

interface SynController_State {
}

interface Constants {
	const threshold1 : real = 1
	const threshold2 : real = 1
	const threshold3 : real = 2
	const threshold4 : real = 2
	const threshold5 : real = 2
	const threshold6 : real = 2
	const threshold7 : real = 3
	const threshold8 : real = 3
	const threshold9 : real = 3
	const threshold10 : real = 3
	const threshold11 : real = 4
	const threshold12 : real = 4
	const threshold13 : real = 4
	const threshold14 : real = 4
	const threshold15 : real = 5
}

stm SynController {
	uses Inputs uses Outputs requires SynController_State requires Constants requires Sensors
	state M2 {
	}
	state M12 {
	}
	state Final {
		entry move ! 0
	}
	state M5 {
	}
	state M8 {
	}
	state M13 {
	}
	state M7 {
	}
	state M11 {
	}
	state M1 {
	}
	state M14 {
	}
	state M9 {
	}
	state M10 {
	}
	state M6 {
	}
	state M15 {
		entry move ! 1
	}
	state M3 {
	}
	state M4 {
	}
	initial i0
	transition t_init {
		from i0
		to M1
	}
	transition t1 {
		from M1
		to Final
		trigger endTask
	}
	transition t2 {
		from M1
		to M2
		trigger advance
		condition reading1 <= threshold1
		action move ! 1
	}
	transition t3 {
		from M1
		to M1
		trigger retreat
		condition not ( reading1 <= threshold1 )
		action move ! 0
	}
	transition t4 {
		from M1
		to M1
		trigger tick
	}
	transition t5 {
		from M2
		to Final
		trigger endTask
	}
	transition t6 {
		from M2
		to M3
		trigger advance
		condition reading2 <= threshold2
		action move ! 1
	}
	transition t7 {
		from M2
		to M1
		trigger retreat
		condition not ( reading2 <= threshold2 )
		action move ! 0
	}
	transition t8 {
		from M2
		to M2
		trigger tick
	}
	transition t9 {
		from M3
		to Final
		trigger endTask
	}
	transition t10 {
		from M3
		to M4
		trigger advance
		condition reading3 <= threshold3
		action move ! 1
	}
	transition t11 {
		from M3
		to M2
		trigger retreat
		condition not ( reading3 <= threshold3 )
		action move ! 0
	}
	transition t12 {
