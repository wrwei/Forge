  {"name": "staticObsHorizDist", "value": 1.0, "req": "LRE-DM4"},
  {"name": "staticObsVertDist", "value": 1.0, "req": "LRE-DM4"},
  {"name": "staticObsDfltVertDist", "value": 1.0, "req": "LRE-DM4"}],
 "comparisons": [
  {"quantity": "depth", "pattern": "\\bdepth\\b", "values": [0.0], "req": "LRE-OP2"},
  {"quantity": "vel", "pattern": "\\bvel\\b", "values": [1.0], "req": "LRE-Beh4"},
  {"quantity": "odist(cdyn)", "pattern": "\\bodist\\s*\\([^()]*cdyn", "values": [1.0], "req": "LRE-Beh4"},
  {"quantity": "odist(cstc)", "pattern": "\\bodist\\s*\\([^()]*cstc", "values": [1.0, "minSafeDist"], "req": "LRE-Beh4, LRE-OP2"},
  {"quantity": "cda", "pattern": "\\bcda\\b", "values": ["minSafeDist"], "req": "LRE-Beh8, Beh14, Beh18"},
  {"quantity": "tcpa", "pattern": "\\btcpa\\b", "values": [0.0], "req": "LRE-Beh8, Beh14"},
  {"quantity": "hvel", "pattern": "\\bhvel\\b", "values": [1.0], "req": "LRE-Beh9"},
  {"quantity": "vvel", "pattern": "\\bvvel\\b", "values": [1.0], "req": "LRE-Beh11"},
  {"quantity": "hdist(cstc)", "pattern": "\\bhdist\\s*\\([^()]*cstc", "values": ["staticObsHorizDist"], "req": "LRE-Beh9"},
