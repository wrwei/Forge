                    </variable>
                    <target xsi:type="spoon:CtTypeAccess">
                      <type name="void"/>
                      <accessedType name="Status">
                        <packageRef isImplicit="true" name="chemdetector.data"/>
                      </accessedType>
                    </target>
                  </assignment>
                  <assigned xsi:type="spoon:CtVariableWrite">
                    <variable xsi:type="spoon:CtLocalVariableReference" name="result">
                      <type name="Status">
                        <packageRef name="chemdetector.data"/>
