          </forInit>
          <forUpdate xsi:type="spoon:CtUnaryOperator" operatorKind="POSTINC">
            <type name="int"/>
            <expression xsi:type="spoon:CtVariableWrite">
              <variable xsi:type="spoon:CtLocalVariableReference" name="idx">
