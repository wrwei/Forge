                              <comment commentContent="CD-GA-Beh6: send stop, transition to Final."/>
                              <comment commentContent="Constructor-pattern OutputEvent publish &#x2014; see EventBus doc."/>
                              <target xsi:type="spoon:CtFieldRead">
                                <variable xsi:type="spoon:CtFieldReference" name="bus" isFinal="true">
