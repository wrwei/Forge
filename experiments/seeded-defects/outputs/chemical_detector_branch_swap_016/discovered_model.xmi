  <spoon:CtClass name="GasFunctions">
    <comment xsi:type="spoon:CtJavaDoc" commentContent="Pure gas-reading analysis functions (CD-Fn1, CD-Fn2, CD-Fn3).&#xA;&lt;p>&#xA;Each function returns a safe default when the input sequence is empty:&#xA;&lt;ul>&#xA;  &lt;li>{@link #analysis} returns {@link Status#noGas}&lt;/li>&#xA;  &lt;li>{@link #intensity} returns intensity {@code 0.0}&lt;/li>&#xA;  &lt;li>{@link #location} returns {@link Angle#Front}&lt;/li>&#xA;&lt;/ul>&#xA;This honours the &quot;Sensor layer returns safe defaults for missing data&quot;&#xA;rule and keeps controller predicates free of sentinel-existence checks.&#xA;&lt;p>&#xA;&lt;b>GasSensor flattening note.&lt;/b> A {@link GasSensor} now exposes the&#xA;intensity directly as a primitive {@code double} via&#xA;{@link GasSensor#intensityValue()} (the nested {@code Intensity} record&#xA;was removed to fix an FDR4 polymorphic-type error on the {@code gas}&#xA;channel). The functions below read the primitive field directly and only&#xA;wrap it back into an {@link Intensity} where the return type demands it."/>
    <modifier>FINAL</modifier>
    <modifier>PUBLIC</modifier>
    <typeMember xsi:type="spoon:CtMethod" name="analysis">
      <comment xsi:type="spoon:CtJavaDoc" commentContent="CD-Fn1: classify the reading as {@link Status#gasD} if any sensor sees&#xA;the target chemical at or above {@link ChemDetectorConstants#thrVal},&#xA;{@link Status#noGas} otherwise. An empty reading yields {@code noGas}."/>
      <modifier>STATIC</modifier>
      <modifier>PUBLIC</modifier>
      <body xsi:type="spoon:CtBlock">
        <statement xsi:type="spoon:CtLocalVariable" name="result">
          <type name="Status">
            <packageRef isImplicit="true" name="chemdetector.data"/>
          </type>
          <assignment xsi:type="spoon:CtFieldRead">
            <variable xsi:type="spoon:CtFieldReference" name="noGas" isFinal="true" isStatic="true">
              <type name="Status">
                <packageRef name="chemdetector.data"/>
              </type>
              <declaringType name="Status">
                <packageRef name="chemdetector.data"/>
              </declaringType>
            </variable>
            <target xsi:type="spoon:CtTypeAccess">
              <type name="void"/>
              <accessedType name="Status">
                <packageRef isImplicit="true" name="chemdetector.data"/>
              </accessedType>
            </target>
          </assignment>
        </statement>
        <statement xsi:type="spoon:CtFor">
          <body xsi:type="spoon:CtBlock">
            <statement xsi:type="spoon:CtLocalVariable" name="s">
              <type name="GasSensor">
                <packageRef isImplicit="true" name="chemdetector.data"/>
              </type>
              <assignment xsi:type="spoon:CtInvocation">
                <target xsi:type="spoon:CtVariableRead">
                  <variable xsi:type="spoon:CtParameterReference" name="gs">
                    <type name="List">
                      <typeArgument name="GasSensor">
                        <packageRef name="chemdetector.data"/>
                      </typeArgument>
                      <packageRef name="java.util"/>
                    </type>
                  </variable>
                </target>
                <executableRef name="get">
                  <type name="GasSensor">
                    <packageRef name="chemdetector.data"/>
                  </type>
                  <argumentType name="int"/>
                  <declaringType name="List">
                    <packageRef name="java.util"/>
                  </declaringType>
                </executableRef>
                <argument xsi:type="spoon:CtVariableRead">
                  <variable xsi:type="spoon:CtLocalVariableReference" name="idx">
                    <type name="int"/>
                  </variable>
                </argument>
              </assignment>
            </statement>
            <statement xsi:type="spoon:CtIf">
              <condition xsi:type="spoon:CtBinaryOperator" operatorKind="GE">
                <type name="boolean"/>
                <leftOperand xsi:type="spoon:CtInvocation">
                  <target xsi:type="spoon:CtVariableRead">
                    <variable xsi:type="spoon:CtLocalVariableReference" name="s">
                      <type name="GasSensor">
                        <packageRef name="chemdetector.data"/>
                      </type>
                    </variable>
                  </target>
                  <executableRef name="intensityValue">
                    <type name="double"/>
                    <declaringType name="GasSensor">
                      <packageRef name="chemdetector.data"/>
                    </declaringType>
                  </executableRef>
                </leftOperand>
                <rightOperand xsi:type="spoon:CtFieldRead">
                  <variable xsi:type="spoon:CtFieldReference" name="thrVal" isFinal="true" isStatic="true">
                    <type name="double"/>
