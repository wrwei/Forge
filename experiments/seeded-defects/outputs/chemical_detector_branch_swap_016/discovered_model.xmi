            </leftOperand>
            <rightOperand xsi:type="spoon:CtInvocation">
              <target xsi:type="spoon:CtVariableRead">
                <variable xsi:type="spoon:CtParameterReference" name="gs">
                  <type name="List">
                    <typeArgument name="GasSensor">
                      <packageRef name="chemdetector.data"/>
                    </typeArgument>
                    <packageRef name="java.util"/>
                  </type>
                </variable>
              </target>
              <executableRef name="size">
                <type name="int"/>
                <declaringType name="List">
                  <packageRef name="java.util"/>
                </declaringType>
              </executableRef>
            </rightOperand>
          </expression>
        </statement>
        <statement xsi:type="spoon:CtIf">
          <comment commentContent="If any sensor crossed the threshold, classify as gasD; else any"/>
          <comment commentContent="non-empty reading with a non-zero intensity also counts as gasD"/>
          <comment commentContent="so the downstream GasDetected->Reading branch is reachable."/>
          <condition xsi:type="spoon:CtBinaryOperator" operatorKind="EQ">
