                      <packageRef name="chemdetector.constants"/>
                    </declaringType>
                  </variable>
                  <target xsi:type="spoon:CtTypeAccess">
                    <type name="void"/>
                    <accessedType name="ChemDetectorConstants">
                      <packageRef isImplicit="true" name="chemdetector.constants"/>
                    </accessedType>
                  </target>
                </rightOperand>
              </condition>
              <then xsi:type="spoon:CtBlock">
                <statement xsi:type="spoon:CtAssignment">
                  <type name="Status">
                    <packageRef name="chemdetector.data"/>
                  </type>
                  <assignment xsi:type="spoon:CtFieldRead">
                    <variable xsi:type="spoon:CtFieldReference" name="gasD" isFinal="true" isStatic="true">
                      <type name="Status">
                        <packageRef name="chemdetector.data"/>
                      </type>
