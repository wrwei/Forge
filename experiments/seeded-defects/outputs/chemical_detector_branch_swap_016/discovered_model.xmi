                                        <type name="GasAnalysisEvent">
                                          <packageRef name="chemdetector.event"/>
                                        </type>
                                      </variable>
                                    </leftOperand>
                                    <rightOperand xsi:type="spoon:CtTypeAccess">
                                      <type name="void"/>
                                      <accessedType name="Tick">
                                        <declaringType name="GasAnalysisEvent">
                                          <packageRef isImplicit="true" name="chemdetector.event"/>
                                        </declaringType>
                                      </accessedType>
                                    </rightOperand>
                                  </condition>
                                  <then xsi:type="spoon:CtBlock">
                                    <statement xsi:type="spoon:CtAssignment">
                                      <comment commentContent="Tick-triggered self-loop replacing the iter-6 &#x3c4;-self-loop."/>
                                      <comment commentContent="insAboveThr is total over reals, so this branch is logically"/>
                                      <comment commentContent="unreachable at the model level; included to give GasDetected"/>
                                      <comment commentContent="a bare-pre operation that survives the M2M lint and the"/>
