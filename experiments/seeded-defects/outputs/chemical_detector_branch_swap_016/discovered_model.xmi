                          <else xsi:type="spoon:CtBlock" isImplicit="true">
                            <statement xsi:type="spoon:CtIf">
                              <else xsi:type="spoon:CtBlock" isImplicit="true">
                                <statement xsi:type="spoon:CtIf">
                                  <else xsi:type="spoon:CtBlock" isImplicit="true">
                                    <statement xsi:type="spoon:CtIf">
                                      <condition xsi:type="spoon:CtBinaryOperator" operatorKind="EQ">
                                        <type name="boolean"/>
                                        <leftOperand xsi:type="spoon:CtFieldRead">
                                          <variable xsi:type="spoon:CtFieldReference" name="currentMode">
                                            <type name="MovementMode">
                                              <packageRef name="chemdetector.movement"/>
                                            </type>
                                            <declaringType name="MovementController">
                                              <packageRef name="chemdetector.movement"/>
                                            </declaringType>
                                          </variable>
                                          <target xsi:type="spoon:CtThisAccess" isImplicit="true">
                                            <type name="MovementController">
                                              <packageRef name="chemdetector.movement"/>
                                            </type>
                                            <target xsi:type="spoon:CtTypeAccess">
                                              <type name="void"/>
                                              <accessedType name="MovementController">
                                                <packageRef name="chemdetector.movement"/>
                                              </accessedType>
                                            </target>
                                          </target>
                                        </leftOperand>
                                        <rightOperand xsi:type="spoon:CtFieldRead">
                                          <variable xsi:type="spoon:CtFieldReference" name="Final" isFinal="true" isStatic="true">
                                            <type name="MovementMode">
                                              <packageRef name="chemdetector.movement"/>
                                            </type>
                                            <declaringType name="MovementMode">
                                              <packageRef name="chemdetector.movement"/>
                                            </declaringType>
                                          </variable>
                                          <target xsi:type="spoon:CtTypeAccess">
                                            <type name="void"/>
                                            <accessedType name="MovementMode">
                                              <packageRef isImplicit="true" name="chemdetector.movement"/>
                                            </accessedType>
                                          </target>
                                        </rightOperand>
                                      </condition>
                                      <then xsi:type="spoon:CtBlock">
                                        <statement xsi:type="spoon:CtIf">
                                          <comment commentContent="Terminal sink. Iter-8 (FDR4 deadlock + divergence fix):"/>
                                          <comment commentContent="Iter-7's unconditional `currentMode = MovementMode.Final` produced"/>
                                          <comment commentContent="a guard-free, trigger-free self-loop in the .rct (t23 Final->Final),"/>
                                          <comment commentContent="which the RoboChart CSP generator emitted as a &#x3c4;-self-loop. That"/>
                                          <comment commentContent="&#x3c4;-edge appeared as the final step of every MovementController-wrapper"/>
                                          <comment commentContent="deadlock counterexample (e.g. `randomWalk.out -> stop.in -> flag.out"/>
                                          <comment commentContent="-> moveCall.0.Angle_Front -> &#x3c4;`) and also as the divergence cycle"/>
                                          <comment commentContent="source for `ctrl_ref1 :[divergence free]`. Replacing the bare"/>
                                          <comment commentContent="self-loop with a Tick-triggered self-loop converts the &#x3c4;-edge into"/>
                                          <comment commentContent="a visible `tick` event, clearing both the deadlock counterexamples"/>
                                          <comment commentContent="and the divergence cycles for ctrl_ref1."/>
                                          <comment commentContent=""/>
                                          <comment commentContent="This mirrors the iter-7 recipe applied to GasAnalysisController's"/>
                                          <comment commentContent="Final/Reading/Analysis/GasDetected modes. The other MovementController"/>
                                          <comment commentContent="modes (Waiting, Going, Avoiding, TryingAgain, AvoidingAgain,"/>
                                          <comment commentContent="GettingOut) already have only event-triggered or guarded outgoing"/>
                                          <comment commentContent="transitions &#x2014; no &#x3c4;-self-loop, no fix needed. The Found mode's"/>
                                          <comment commentContent="autonomous `currentMode = Final` is a one-shot transition to a"/>
                                          <comment commentContent="different state, not a self-loop, so it is also safe."/>
                                          <comment commentContent=""/>
                                          <comment commentContent="MovementController is not verified by Isabelle in the current"/>
                                          <comment commentContent="iter-7 build (only GasAnalysisController_Beh.thy is built), so"/>
                                          <comment commentContent="there is no deadlock_free tactic constraint demanding the lost"/>
                                          <comment commentContent="bare-precondition coverage here."/>
                                          <condition xsi:type="spoon:CtBinaryOperator" operatorKind="INSTANCEOF">
                                            <type name="boolean"/>
                                            <leftOperand xsi:type="spoon:CtVariableRead">
                                              <variable xsi:type="spoon:CtParameterReference" name="e">
                                                <type name="MovementEvent">
                                                  <packageRef name="chemdetector.event"/>
                                                </type>
                                              </variable>
                                            </leftOperand>
                                            <rightOperand xsi:type="spoon:CtTypeAccess">
                                              <type name="void"/>
                                              <accessedType name="Tick">
                                                <declaringType name="MovementEvent">
                                                  <packageRef isImplicit="true" name="chemdetector.event"/>
                                                </declaringType>
                                              </accessedType>
                                            </rightOperand>
                                          </condition>
                                          <then xsi:type="spoon:CtBlock">
                                            <statement xsi:type="spoon:CtAssignment">
                                              <type name="MovementMode">
                                                <packageRef name="chemdetector.movement"/>
                                              </type>
                                              <assignment xsi:type="spoon:CtFieldRead">
                                                <variable xsi:type="spoon:CtFieldReference" name="Final" isFinal="true" isStatic="true">
                                                  <type name="MovementMode">
                                                    <packageRef name="chemdetector.movement"/>
                                                  </type>
                                                  <declaringType name="MovementMode">
                                                    <packageRef name="chemdetector.movement"/>
                                                  </declaringType>
                                                </variable>
                                                <target xsi:type="spoon:CtTypeAccess">
                                                  <type name="void"/>
                                                  <accessedType name="MovementMode">
                                                    <packageRef isImplicit="true" name="chemdetector.movement"/>
                                                  </accessedType>
                                                </target>
                                              </assignment>
                                              <assigned xsi:type="spoon:CtFieldWrite">
                                                <target xsi:type="spoon:CtThisAccess" isImplicit="true">
                                                  <type name="MovementController">
                                                    <packageRef name="chemdetector.movement"/>
                                                  </type>
                                                  <target xsi:type="spoon:CtTypeAccess">
                                                    <type name="void"/>
                                                    <accessedType name="MovementController">
                                                      <packageRef name="chemdetector.movement"/>
                                                    </accessedType>
                                                  </target>
                                                </target>
                                                <variable xsi:type="spoon:CtFieldReference" name="currentMode">
                                                  <type name="MovementMode">
                                                    <packageRef name="chemdetector.movement"/>
                                                  </type>
                                                  <declaringType name="MovementController">
                                                    <packageRef name="chemdetector.movement"/>
                                                  </declaringType>
                                                </variable>
                                              </assigned>
                                            </statement>
                                          </then>
                                        </statement>
                                      </then>
                                    </statement>
                                  </else>
                                  <condition xsi:type="spoon:CtBinaryOperator" operatorKind="EQ">
                                    <type name="boolean"/>
                                    <leftOperand xsi:type="spoon:CtFieldRead">
                                      <variable xsi:type="spoon:CtFieldReference" name="currentMode">
                                        <type name="MovementMode">
                                          <packageRef name="chemdetector.movement"/>
                                        </type>
                                        <declaringType name="MovementController">
                                          <packageRef name="chemdetector.movement"/>
                                        </declaringType>
                                      </variable>
                                      <target xsi:type="spoon:CtThisAccess" isImplicit="true">
                                        <type name="MovementController">
                                          <packageRef name="chemdetector.movement"/>
                                        </type>
                                        <target xsi:type="spoon:CtTypeAccess">
                                          <type name="void"/>
                                          <accessedType name="MovementController">
                                            <packageRef name="chemdetector.movement"/>
                                          </accessedType>
                                        </target>
                                      </target>
                                    </leftOperand>
                                    <rightOperand xsi:type="spoon:CtFieldRead">
                                      <variable xsi:type="spoon:CtFieldReference" name="AvoidingAgain" isFinal="true" isStatic="true">
                                        <type name="MovementMode">
                                          <packageRef name="chemdetector.movement"/>
                                        </type>
                                        <declaringType name="MovementMode">
                                          <packageRef name="chemdetector.movement"/>
                                        </declaringType>
                                      </variable>
                                      <target xsi:type="spoon:CtTypeAccess">
                                        <type name="void"/>
                                        <accessedType name="MovementMode">
                                          <packageRef isImplicit="true" name="chemdetector.movement"/>
                                        </accessedType>
                                      </target>
                                    </rightOperand>
                                  </condition>
                                  <then xsi:type="spoon:CtBlock">
                                    <statement xsi:type="spoon:CtIf">
                                      <else xsi:type="spoon:CtBlock" isImplicit="true">
                                        <statement xsi:type="spoon:CtIf">
                                          <else xsi:type="spoon:CtBlock" isImplicit="true">
                                            <statement xsi:type="spoon:CtIf">
                                              <else xsi:type="spoon:CtBlock" isImplicit="true">
                                                <statement xsi:type="spoon:CtIf">
                                                  <condition xsi:type="spoon:CtVariableRead">
                                                    <variable xsi:type="spoon:CtLocalVariableReference" name="stuckFired">
                                                      <type name="boolean"/>
                                                    </variable>
                                                  </condition>
                                                  <then xsi:type="spoon:CtBlock">
                                                    <statement xsi:type="spoon:CtAssignment">
                                                      <comment commentContent="CD-MV-Beh18: AvoidingAgain -> GettingOut."/>
                                                      <type name="MovementMode">
                                                        <packageRef name="chemdetector.movement"/>
                                                      </type>
                                                      <assignment xsi:type="spoon:CtFieldRead">
                                                        <variable xsi:type="spoon:CtFieldReference" name="GettingOut" isFinal="true" isStatic="true">
                                                          <type name="MovementMode">
                                                            <packageRef name="chemdetector.movement"/>
                                                          </type>
                                                          <declaringType name="MovementMode">
                                                            <packageRef name="chemdetector.movement"/>
                                                          </declaringType>
                                                        </variable>
