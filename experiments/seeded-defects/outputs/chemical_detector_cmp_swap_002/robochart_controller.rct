diagram GasAnalysisController

enumeration Angle { Left Right Back Front }
enumeration Loc { left right front }
enumeration Status { noGas gasD }

datatype GasSensor {
	chemId : nat
	intensityValue : real
}

datatype Intensity {
	value : real
}

function analysis ( gs : Seq(GasSensor) ) : Status { }
function peakIntensity ( gs : Seq(GasSensor) ) : real { }

interface LOperations {
	move ( p0 : real , p1 : Angle )
}

interface Inputs {
	event gas : Seq(GasSensor)
	event tick
	event stop
	event turn : Angle
	event obstacle : Loc
}

interface Outputs {
	event randomWalk
	event flag
	event compute : Loc
	event shortRandomWalk
}

interface Shared {
	event resume
}

interface Sensors {
}

interface Actuators {
}

interface Ctrl_State_Shared {
	var anl : Angle
}

interface GasAnalysisController_State {
	var gs : Seq(GasSensor)
	var sts : Status
	var insVal : real
}

interface MovementController_State {
	var a : Angle
	var d0 : real
	var d1 : real
	var l : Loc
}

interface Constants {
	const lv : real = 1
	const evadetime : real = 2
	const stuckperiod : real = 5
	const stuckdist : real = 1
	const outperiod : real = 3
}

operation ChangeDirection ( ) {
	requires GasAnalysisController_State requires MovementController_State requires Sensors
	initial i0
	final f0
	transition t0 {
		from i0
		to f0
	}
}

stm GasAnalysisController {
	uses Inputs uses Outputs uses Shared requires GasAnalysisController_State requires Constants
	var v : real
	state Reading {
	}
	state Analysis {
		entry sts = analysis ( gs )
	}
	state GasDetected {
		entry insVal = peakIntensity ( gs )
	}
	state Final {
	}
	state NoGas {
		entry send resume
	}
	initial i0
	transition t_init {
		from i0
		to Reading
	}
	transition t1 {
		from Reading
		to Analysis
		trigger gas ? gs
	}
	transition t2 {
		from Reading
		to Reading
		trigger tick
	}
	transition t3 {
		from Analysis
		to NoGas
		condition sts == noGas
	}
	transition t4 {
		from Analysis
		to GasDetected
		condition sts == gasD
	}
	transition t5 {
		from Analysis
		to Analysis
		trigger tick
	}
	transition t6 {
		from NoGas
		to Reading
	}
	transition t7 {
		from Final
		to Final
		trigger tick
	}
}

controller GasAnalysisController_Ctrl {
	uses Inputs uses Outputs uses Shared requires GasAnalysisController_State requires Constants
	sref stm_ref0 = GasAnalysisController
	opref op_ref0 = ChangeDirection
	connection GasAnalysisController_Ctrl on gas to stm_ref0 on gas
	connection GasAnalysisController_Ctrl on tick to stm_ref0 on tick
	connection stm_ref0 on resume to GasAnalysisController_Ctrl on resume
}

stm MovementController {
	uses Inputs uses Outputs uses Shared requires MovementController_State requires Constants requires LOperations
	var v : real
	clock clockResetTime
	state GettingOut {
		entry send shortRandomWalk ; wait ( outperiod )
	}
	state Waiting {
		entry send randomWalk
	}
	state Avoiding {
		entry d0 = 0 ; compute ! l ; wait ( evadetime )
	}
	state Found {
		entry send flag ; move ( 0 , Front )
	}
	state AvoidingAgain {
		entry d1 = 0
	}
	state Final {
	}
	state Going {
		entry move ( lv , a )
	}
	state TryingAgain {
		entry move ( lv , a )
	}
	initial i0
	transition t_init {
		from i0
		to Waiting
	}
	transition t1 {
		from Waiting
		to Found
		trigger stop
	}
	transition t2 {
		from Waiting
		to Going
		trigger turn ? a
	}
	transition t3 {
		from Waiting
		to Waiting
		trigger resume
	}
	transition t4 {
		from Going
		to Found
		trigger stop
	}
	transition t5 {
		from Going
		to Going
		trigger turn ? a
	}
	transition t6 {
		from Going
		to Avoiding
		trigger obstacle ? l
		# clockResetTime
	}
	transition t7 {
		from Going
		to Waiting
		trigger resume
	}
	transition t8 {
		from Found
		to Final
	}
	transition t9 {
		from Avoiding
		to Found
		trigger stop
	}
	transition t10 {
		from Avoiding
		to TryingAgain
		trigger turn ? a
	}
	transition t11 {
		from Avoiding
		to Waiting
		trigger resume
	}
	transition t12 {
		from TryingAgain
		to Found
		trigger stop
	}
	transition t13 {
		from TryingAgain
		to TryingAgain
		trigger turn ? a
	}
	transition t14 {
		from TryingAgain
		to AvoidingAgain
		trigger obstacle ? l
	}
	transition t15 {
		from TryingAgain
		to Waiting
		trigger resume
	}
	transition t16 {
		from AvoidingAgain
		to Found
		trigger stop
	}
	transition t17 {
		from AvoidingAgain
		to Waiting
		trigger resume
	}
	transition t18 {
		from AvoidingAgain
		to Avoiding
		# clockResetTime
		condition since ( clockResetTime ) < stuckperiod \/ d1 - d0 > stuckdist
	}
	transition t19 {
		from AvoidingAgain
		to GettingOut
		condition since ( clockResetTime ) >= stuckperiod /\ d1 - d0 <= stuckdist
	}
	transition t20 {
		from GettingOut
		to Found
		trigger stop
	}
	transition t21 {
		from GettingOut
		to Going
		trigger turn ? a
	}
	transition t22 {
		from GettingOut
		to Waiting
		trigger resume
	}
	transition t23 {
		from Final
		to Final
		trigger tick
	}
}

controller MovementController_Ctrl {
	uses Inputs uses Outputs uses Shared requires MovementController_State requires Constants requires LOperations
	sref stm_ref0 = MovementController
	opref op_ref0 = ChangeDirection
	connection MovementController_Ctrl on stop to stm_ref0 on stop
	connection MovementController_Ctrl on turn to stm_ref0 on turn
	connection MovementController_Ctrl on resume to stm_ref0 on resume
	connection MovementController_Ctrl on obstacle to stm_ref0 on obstacle
	connection MovementController_Ctrl on tick to stm_ref0 on tick
	connection stm_ref0 on randomWalk to MovementController_Ctrl on randomWalk
	connection stm_ref0 on flag to MovementController_Ctrl on flag
	connection stm_ref0 on compute to MovementController_Ctrl on compute
	connection stm_ref0 on shortRandomWalk to MovementController_Ctrl on shortRandomWalk
}

module GasAnalysisController_System_Module {
	robotic platform GasAnalysisController_System_Platform {
		provides Sensors provides Actuators provides Constants
		event gas : Seq(GasSensor)
		event tick
		event stop
		event turn : Angle
		event obstacle : Loc
		event randomWalk
		event flag
		event compute : Loc
		event shortRandomWalk
	}
	cref ctrl_ref0 = GasAnalysisController_Ctrl
	cref ctrl_ref1 = MovementController_Ctrl
	connection GasAnalysisController_System_Platform on gas to ctrl_ref0 on gas
	connection GasAnalysisController_System_Platform on tick to ctrl_ref0 on tick
	connection GasAnalysisController_System_Platform on tick to ctrl_ref1 on tick
	connection GasAnalysisController_System_Platform on stop to ctrl_ref1 on stop
	connection GasAnalysisController_System_Platform on turn to ctrl_ref1 on turn
	connection GasAnalysisController_System_Platform on obstacle to ctrl_ref1 on obstacle
	connection ctrl_ref1 on randomWalk to GasAnalysisController_System_Platform on randomWalk
	connection ctrl_ref1 on flag to GasAnalysisController_System_Platform on flag
	connection ctrl_ref1 on compute to GasAnalysisController_System_Platform on compute
	connection ctrl_ref1 on shortRandomWalk to GasAnalysisController_System_Platform on shortRandomWalk
	connection ctrl_ref0 on resume to ctrl_ref1 on resume
}

