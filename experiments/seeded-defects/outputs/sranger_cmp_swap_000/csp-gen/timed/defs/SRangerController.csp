		Memory_resetTime(resetTime) =
			get_resetTime!resetTime -> Memory_resetTime(resetTime)
			[]
			set_resetTime?x__ -> Memory_resetTime(x__)
			[]
			set_EXT_resetTime?x__ -> Memory_resetTime(x__)
			[]
			terminate -> SKIP
		Memory_elapsed(elapsed) =
			get_elapsed!elapsed -> Memory_elapsed(elapsed)
			[]
			set_elapsed?x__ -> Memory_elapsed(x__)
			[]
			set_EXT_elapsed?x__ -> Memory_elapsed(x__)
			[]
			terminate -> SKIP
		
		-- sharedVarMemory process
		sharedVarMemory(id__) = Memory_turnDurationElapsed(true)
		[| { terminate } |] (
		Memory_resetTime(0)
		[| { terminate } |] (
		Memory_elapsed(true)
		)
		)
		
		sharedVarSync = {|get_turnDurationElapsed,set_turnDurationElapsed,set_EXT_turnDurationElapsed,get_resetTime,set_resetTime,set_EXT_resetTime,get_elapsed,set_elapsed,set_EXT_elapsed|}
		
		sharedVarHide = {|get_turnDurationElapsed,get_resetTime,get_elapsed|}
		}
endmodule
