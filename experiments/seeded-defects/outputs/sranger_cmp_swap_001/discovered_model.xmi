                <target xsi:type="spoon:CtFieldRead">
                  <variable xsi:type="spoon:CtFieldReference" name="cycleClock" isFinal="true">
                    <type name="Clock">
                      <packageRef name="sranger.timing"/>
                    </type>
                    <declaringType name="TurnTimer">
                      <packageRef name="sranger.operation"/>
                    </declaringType>
                  </variable>
                  <target xsi:type="spoon:CtThisAccess" isImplicit="true">
                    <type name="TurnTimer">
                      <packageRef name="sranger.operation"/>
                    </type>
                    <target xsi:type="spoon:CtTypeAccess">
