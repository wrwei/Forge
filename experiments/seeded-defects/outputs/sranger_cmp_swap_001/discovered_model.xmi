    <typeMember xsi:type="spoon:CtMethod" name="compute">
      <comment xsi:type="spoon:CtJavaDoc" commentContent="Recompute {@link #elapsed} from the current clock reading. Direct&#xA;{@code this.field = expression} assignment with no local variables, per&#xA;the codegen rules for Operation compute() methods."/>
      <modifier>PUBLIC</modifier>
      <body xsi:type="spoon:CtBlock">
        <statement xsi:type="spoon:CtAssignment">
