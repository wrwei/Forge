    <typeMember xsi:type="spoon:CtField" name="turnDurationMs">
      <annotation>
        <type name="RoboChartType">
          <packageRef name="sranger.annotation"/>
        </type>
        <annotationType name="RoboChartType">
          <packageRef isImplicit="true" name="sranger.annotation"/>
