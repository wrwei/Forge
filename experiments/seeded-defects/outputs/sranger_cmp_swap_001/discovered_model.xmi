        <packageRef isImplicit="true" name="sranger.mode"/>
      </type>
    </typeMember>
    <typeMember xsi:type="spoon:CtMethod" name="step">
      <comment xsi:type="spoon:CtJavaDoc" commentContent="One control cycle. Per the codegen rules, all guard predicates are named&#xA;booleans declared (and assigned) before the if-else chain. SR-GP2's&#xA;{@code turnDurationElapsed} is the controller field (see field Javadoc);&#xA;SR-GP1's {@code obstacleDetected} remains a local boolean &#x2014; its predicate&#xA;is referenced only in an event-gated postcondition where the antecedent&#xA;is already false on every other branch, so the Dafny inliner is benign."/>
      <modifier>PUBLIC</modifier>
      <body xsi:type="spoon:CtBlock">
        <statement xsi:type="spoon:CtInvocation">
          <comment commentContent="--- Refresh the TurnTimer's cached elapsed value from the clock ---"/>
          <target xsi:type="spoon:CtFieldRead">
            <variable xsi:type="spoon:CtFieldReference" name="turnTimer" isFinal="true">
              <type name="TurnTimer">
                <packageRef name="sranger.operation"/>
              </type>
              <declaringType name="SRangerController">
                <packageRef name="sranger.controller"/>
              </declaringType>
            </variable>
            <target xsi:type="spoon:CtThisAccess" isImplicit="true">
              <type name="SRangerController">
                <packageRef name="sranger.controller"/>
              </type>
              <target xsi:type="spoon:CtTypeAccess">
                <type name="void"/>
                <accessedType name="SRangerController">
                  <packageRef name="sranger.controller"/>
                </accessedType>
              </target>
            </target>
          </target>
          <executableRef name="compute">
            <type name="void"/>
            <declaringType name="TurnTimer">
              <packageRef name="sranger.operation"/>
            </declaringType>
          </executableRef>
        </statement>
        <statement xsi:type="spoon:CtLocalVariable" name="obstacleDetected">
          <comment commentContent="--- Named boolean predicates (declared / assigned BEFORE the if-else chain) ---"/>
          <comment commentContent="SR-GP1: obstacle detected when IR distance &lt;= obstacleThreshold."/>
          <type name="boolean"/>
          <assignment xsi:type="spoon:CtBinaryOperator" operatorKind="LE">
            <type name="boolean"/>
            <leftOperand xsi:type="spoon:CtInvocation">
              <target xsi:type="spoon:CtFieldRead">
                <variable xsi:type="spoon:CtFieldReference" name="sensor" isFinal="true">
                  <type name="Sensor">
                    <packageRef name="sranger.sensor"/>
                  </type>
                  <declaringType name="SRangerController">
                    <packageRef name="sranger.controller"/>
                  </declaringType>
                </variable>
                <target xsi:type="spoon:CtThisAccess" isImplicit="true">
                  <type name="SRangerController">
                    <packageRef name="sranger.controller"/>
                  </type>
                  <target xsi:type="spoon:CtTypeAccess">
                    <type name="void"/>
                    <accessedType name="SRangerController">
                      <packageRef name="sranger.controller"/>
                    </accessedType>
                  </target>
                </target>
              </target>
              <executableRef name="distance">
                <type name="double"/>
                <declaringType name="Sensor">
                  <packageRef name="sranger.sensor"/>
                </declaringType>
              </executableRef>
            </leftOperand>
            <rightOperand xsi:type="spoon:CtFieldRead">
              <variable xsi:type="spoon:CtFieldReference" name="obstacleThreshold" isFinal="true" isStatic="true">
                <type name="double"/>
                <declaringType name="SRangerConstants">
                  <packageRef name="sranger.constants"/>
                </declaringType>
              </variable>
              <target xsi:type="spoon:CtTypeAccess">
                <type name="void"/>
                <accessedType name="SRangerConstants">
                  <packageRef isImplicit="true" name="sranger.constants"/>
                </accessedType>
              </target>
            </rightOperand>
          </assignment>
        </statement>
        <statement xsi:type="spoon:CtAssignment">
          <comment commentContent="SR-GP2: refresh the controller-side boolean state field from the Operation's"/>
          <comment commentContent="cached value. RHS is a single method call on a non-Clock receiver, so the"/>
          <comment commentContent="M2M's containsClockCall returns false and the field stays Ctrl_State."/>
          <type name="boolean"/>
          <assignment xsi:type="spoon:CtInvocation">
            <target xsi:type="spoon:CtFieldRead">
              <variable xsi:type="spoon:CtFieldReference" name="turnTimer" isFinal="true">
                <type name="TurnTimer">
                  <packageRef name="sranger.operation"/>
                </type>
                <declaringType name="SRangerController">
                  <packageRef name="sranger.controller"/>
                </declaringType>
              </variable>
              <target xsi:type="spoon:CtThisAccess" isImplicit="true">
                <type name="SRangerController">
                  <packageRef name="sranger.controller"/>
                </type>
                <target xsi:type="spoon:CtTypeAccess">
                  <type name="void"/>
                  <accessedType name="SRangerController">
                    <packageRef name="sranger.controller"/>
                  </accessedType>
                </target>
              </target>
            </target>
            <executableRef name="elapsed">
              <type name="boolean"/>
              <declaringType name="TurnTimer">
                <packageRef name="sranger.operation"/>
              </declaringType>
            </executableRef>
          </assignment>
          <assigned xsi:type="spoon:CtFieldWrite">
            <target xsi:type="spoon:CtThisAccess">
              <type name="SRangerController">
                <packageRef name="sranger.controller"/>
              </type>
              <target xsi:type="spoon:CtTypeAccess">
                <type name="void"/>
                <accessedType name="SRangerController">
                  <packageRef name="sranger.controller"/>
                </accessedType>
              </target>
            </target>
            <variable xsi:type="spoon:CtFieldReference" name="turnDurationElapsed">
              <type name="boolean"/>
              <declaringType name="SRangerController">
                <packageRef name="sranger.controller"/>
              </declaringType>
            </variable>
          </assigned>
        </statement>
        <statement xsi:type="spoon:CtIf">
          <comment commentContent="--- Pure mode-nested if-else: every outer branch is currentMode == X ---"/>
          <else xsi:type="spoon:CtBlock" isImplicit="true">
            <statement xsi:type="spoon:CtIf">
              <else xsi:type="spoon:CtBlock" isImplicit="true">
                <statement xsi:type="spoon:CtIf">
                  <condition xsi:type="spoon:CtBinaryOperator" operatorKind="EQ">
                    <type name="boolean"/>
                    <leftOperand xsi:type="spoon:CtFieldRead">
                      <variable xsi:type="spoon:CtFieldReference" name="currentMode">
                        <type name="SRangerMode">
                          <packageRef name="sranger.mode"/>
                        </type>
                        <declaringType name="SRangerController">
                          <packageRef name="sranger.controller"/>
                        </declaringType>
                      </variable>
                      <target xsi:type="spoon:CtThisAccess" isImplicit="true">
                        <type name="SRangerController">
                          <packageRef name="sranger.controller"/>
                        </type>
                        <target xsi:type="spoon:CtTypeAccess">
                          <type name="void"/>
                          <accessedType name="SRangerController">
                            <packageRef name="sranger.controller"/>
                          </accessedType>
                        </target>
                      </target>
                    </leftOperand>
                    <rightOperand xsi:type="spoon:CtFieldRead">
                      <variable xsi:type="spoon:CtFieldReference" name="Final" isFinal="true" isStatic="true">
                        <type name="SRangerMode">
                          <packageRef name="sranger.mode"/>
                        </type>
                        <declaringType name="SRangerMode">
                          <packageRef name="sranger.mode"/>
                        </declaringType>
                      </variable>
                      <target xsi:type="spoon:CtTypeAccess">
                        <type name="void"/>
                        <accessedType name="SRangerMode">
                          <packageRef isImplicit="true" name="sranger.mode"/>
                        </accessedType>
                      </target>
                    </rightOperand>
                  </condition>
                  <then xsi:type="spoon:CtBlock">
                    <statement xsi:type="spoon:CtIf">
                      <comment commentContent="Final is a terminal mode (SR-FR3) &#x2014; no transitions back to Moving or"/>
                      <comment commentContent="Turning are specified. The Tick self-loop below is the only outgoing"/>
                      <comment commentContent="edge; it preserves the absorbing semantics (currentMode stays Final"/>
                      <comment commentContent="and no Move command is re-issued) while giving FDR4 a visible event"/>
                      <comment commentContent="out of Final so the controller is deadlock-free. The spec mandates a"/>
                      <comment commentContent="tick each control cycle globally &#x2014; this just extends the same handling"/>
                      <comment commentContent="pattern used in Moving (SR-Beh4) and Turning (SR-Beh7) to Final."/>
                      <condition xsi:type="spoon:CtBinaryOperator" operatorKind="INSTANCEOF">
                        <type name="boolean"/>
                        <leftOperand xsi:type="spoon:CtVariableRead">
                          <variable xsi:type="spoon:CtParameterReference" name="event">
                            <type name="InputEvent">
                              <packageRef name="sranger.event"/>
                            </type>
                          </variable>
                        </leftOperand>
                        <rightOperand xsi:type="spoon:CtTypeAccess">
                          <type name="void"/>
                          <accessedType name="Tick">
                            <declaringType name="InputEvent">
                              <packageRef isImplicit="true" name="sranger.event"/>
                            </declaringType>
                          </accessedType>
                        </rightOperand>
                      </condition>
                      <then xsi:type="spoon:CtBlock">
                        <statement xsi:type="spoon:CtAssignment">
                          <type name="SRangerMode">
                            <packageRef name="sranger.mode"/>
                          </type>
                          <assignment xsi:type="spoon:CtFieldRead">
                            <variable xsi:type="spoon:CtFieldReference" name="Final" isFinal="true" isStatic="true">
                              <type name="SRangerMode">
                                <packageRef name="sranger.mode"/>
                              </type>
                              <declaringType name="SRangerMode">
                                <packageRef name="sranger.mode"/>
                              </declaringType>
                            </variable>
                            <target xsi:type="spoon:CtTypeAccess">
                              <type name="void"/>
                              <accessedType name="SRangerMode">
                                <packageRef isImplicit="true" name="sranger.mode"/>
                              </accessedType>
                            </target>
                          </assignment>
                          <assigned xsi:type="spoon:CtFieldWrite">
                            <target xsi:type="spoon:CtThisAccess" isImplicit="true">
                              <type name="SRangerController">
                                <packageRef name="sranger.controller"/>
                              </type>
                              <target xsi:type="spoon:CtTypeAccess">
                                <type name="void"/>
                                <accessedType name="SRangerController">
                                  <packageRef name="sranger.controller"/>
                                </accessedType>
                              </target>
                            </target>
                            <variable xsi:type="spoon:CtFieldReference" name="currentMode">
                              <type name="SRangerMode">
                                <packageRef name="sranger.mode"/>
                              </type>
                              <declaringType name="SRangerController">
                                <packageRef name="sranger.controller"/>
                              </declaringType>
                            </variable>
                          </assigned>
                        </statement>
                      </then>
                    </statement>
                  </then>
                </statement>
              </else>
              <condition xsi:type="spoon:CtBinaryOperator" operatorKind="NE">
                <type name="boolean"/>
                <leftOperand xsi:type="spoon:CtFieldRead">
                  <variable xsi:type="spoon:CtFieldReference" name="currentMode">
                    <type name="SRangerMode">
                      <packageRef name="sranger.mode"/>
                    </type>
                    <declaringType name="SRangerController">
                      <packageRef name="sranger.controller"/>
                    </declaringType>
                  </variable>
                  <target xsi:type="spoon:CtThisAccess" isImplicit="true">
                    <type name="SRangerController">
                      <packageRef name="sranger.controller"/>
                    </type>
                    <target xsi:type="spoon:CtTypeAccess">
                      <type name="void"/>
                      <accessedType name="SRangerController">
                        <packageRef name="sranger.controller"/>
                      </accessedType>
                    </target>
                  </target>
                </leftOperand>
                <rightOperand xsi:type="spoon:CtFieldRead">
                  <variable xsi:type="spoon:CtFieldReference" name="Turning" isFinal="true" isStatic="true">
                    <type name="SRangerMode">
                      <packageRef name="sranger.mode"/>
                    </type>
                    <declaringType name="SRangerMode">
                      <packageRef name="sranger.mode"/>
                    </declaringType>
                  </variable>
                  <target xsi:type="spoon:CtTypeAccess">
                    <type name="void"/>
                    <accessedType name="SRangerMode">
                      <packageRef isImplicit="true" name="sranger.mode"/>
                    </accessedType>
                  </target>
                </rightOperand>
              </condition>
              <then xsi:type="spoon:CtBlock">
                <statement xsi:type="spoon:CtIf">
                  <comment commentContent="SR-Beh5: Turning -> Moving when turnDurationElapsed (autonomous)."/>
                  <comment commentContent="PLACED FIRST in Turning so the Dafny postcondition"/>
                  <comment commentContent="ensures turnDurationElapsed ==> mode == Moving"/>
                  <comment commentContent="is satisfied for every event value. With EndTask first, the simultaneous"/>
                  <comment commentContent="case turnDurationElapsed &amp;&amp; EndTask would route to Final and break the"/>
                  <comment commentContent="postcondition."/>
                  <else xsi:type="spoon:CtBlock" isImplicit="true">
                    <comment commentContent="SR-Beh6: Turning -> Final on endTask."/>
                    <statement xsi:type="spoon:CtIf">
                      <else xsi:type="spoon:CtBlock" isImplicit="true">
                        <comment commentContent="SR-Beh7: Turning -> Turning on tick (no action). Bare-precondition cover."/>
                        <statement xsi:type="spoon:CtIf">
                          <condition xsi:type="spoon:CtBinaryOperator" operatorKind="INSTANCEOF">
                            <type name="boolean"/>
                            <leftOperand xsi:type="spoon:CtVariableRead">
                              <variable xsi:type="spoon:CtParameterReference" name="event">
                                <type name="InputEvent">
                                  <packageRef name="sranger.event"/>
                                </type>
                              </variable>
                            </leftOperand>
                            <rightOperand xsi:type="spoon:CtTypeAccess">
                              <type name="void"/>
                              <accessedType name="Tick">
                                <declaringType name="InputEvent">
                                  <packageRef isImplicit="true" name="sranger.event"/>
                                </declaringType>
                              </accessedType>
                            </rightOperand>
                          </condition>
                          <then xsi:type="spoon:CtBlock">
                            <statement xsi:type="spoon:CtAssignment">
                              <type name="SRangerMode">
                                <packageRef name="sranger.mode"/>
                              </type>
                              <assignment xsi:type="spoon:CtFieldRead">
                                <variable xsi:type="spoon:CtFieldReference" name="Turning" isFinal="true" isStatic="true">
                                  <type name="SRangerMode">
                                    <packageRef name="sranger.mode"/>
                                  </type>
                                  <declaringType name="SRangerMode">
                                    <packageRef name="sranger.mode"/>
                                  </declaringType>
                                </variable>
                                <target xsi:type="spoon:CtTypeAccess">
                                  <type name="void"/>
                                  <accessedType name="SRangerMode">
                                    <packageRef isImplicit="true" name="sranger.mode"/>
                                  </accessedType>
                                </target>
                              </assignment>
                              <assigned xsi:type="spoon:CtFieldWrite">
                                <target xsi:type="spoon:CtThisAccess" isImplicit="true">
                                  <type name="SRangerController">
                                    <packageRef name="sranger.controller"/>
                                  </type>
                                  <target xsi:type="spoon:CtTypeAccess">
                                    <type name="void"/>
                                    <accessedType name="SRangerController">
                                      <packageRef name="sranger.controller"/>
                                    </accessedType>
                                  </target>
                                </target>
                                <variable xsi:type="spoon:CtFieldReference" name="currentMode">
                                  <type name="SRangerMode">
                                    <packageRef name="sranger.mode"/>
                                  </type>
                                  <declaringType name="SRangerController">
                                    <packageRef name="sranger.controller"/>
                                  </declaringType>
                                </variable>
                              </assigned>
                            </statement>
                          </then>
                        </statement>
                      </else>
                      <condition xsi:type="spoon:CtBinaryOperator" operatorKind="INSTANCEOF">
                        <type name="boolean"/>
                        <leftOperand xsi:type="spoon:CtVariableRead">
                          <variable xsi:type="spoon:CtParameterReference" name="event">
                            <type name="InputEvent">
                              <packageRef name="sranger.event"/>
                            </type>
                          </variable>
                        </leftOperand>
                        <rightOperand xsi:type="spoon:CtTypeAccess">
                          <type name="void"/>
                          <accessedType name="EndTask">
                            <declaringType name="InputEvent">
                              <packageRef isImplicit="true" name="sranger.event"/>
                            </declaringType>
                          </accessedType>
                        </rightOperand>
                      </condition>
                      <then xsi:type="spoon:CtBlock">
                        <statement xsi:type="spoon:CtAssignment">
                          <type name="SRangerMode">
                            <packageRef name="sranger.mode"/>
                          </type>
                          <assignment xsi:type="spoon:CtFieldRead">
                            <variable xsi:type="spoon:CtFieldReference" name="Final" isFinal="true" isStatic="true">
                              <type name="SRangerMode">
                                <packageRef name="sranger.mode"/>
                              </type>
                              <declaringType name="SRangerMode">
                                <packageRef name="sranger.mode"/>
                              </declaringType>
                            </variable>
                            <target xsi:type="spoon:CtTypeAccess">
                              <type name="void"/>
                              <accessedType name="SRangerMode">
                                <packageRef isImplicit="true" name="sranger.mode"/>
                              </accessedType>
                            </target>
                          </assignment>
                          <assigned xsi:type="spoon:CtFieldWrite">
                            <target xsi:type="spoon:CtThisAccess" isImplicit="true">
                              <type name="SRangerController">
                                <packageRef name="sranger.controller"/>
                              </type>
                              <target xsi:type="spoon:CtTypeAccess">
                                <type name="void"/>
                                <accessedType name="SRangerController">
                                  <packageRef name="sranger.controller"/>
                                </accessedType>
                              </target>
