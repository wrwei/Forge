						    const_SRangerController_obstaclethreshold) [| union(stateClockSync,{terminate}) |] StateClocks(id__,
						          const_SRangerController_obstaclethreshold)) \ diff(union(stateClockSync,enteredSS),enteredSS)
			)
			)
		
		IteratedBehaviour_VS_O(id__,
				    const_SRangerController_obstaclethreshold) = 
			dbisim((let
				stateClockSync = {|get_CLID_Moving,Moving::entered,get_CLID_Turning,Turning::entered,get_CLID_Final,Final::entered|}
			 within
				(dbisim(
					sbisim(
						dbisim(
							sbisim(
								dbisim(
									sbisim(
										MachineBody_VS_O(id__,
												    const_SRangerController_obstaclethreshold)
										[| {|get_CLID_Final,Final::entered,terminate|} |]
										dbisim(Clock_CLID_Final(id__,0,
												          const_SRangerController_obstaclethreshold))
									)\{|get_CLID_Final|}
								)
								[| {|get_CLID_Turning,Turning::entered,terminate|} |]
								dbisim(Clock_CLID_Turning(id__,0,
										          const_SRangerController_obstaclethreshold))
							)\{|get_CLID_Turning|}
						)
						[| {|get_CLID_Moving,Moving::entered,terminate|} |]
						dbisim(Clock_CLID_Moving(id__,0,
								          const_SRangerController_obstaclethreshold))
					)\{|get_CLID_Moving|}
				)
				) \ diff(union(stateClockSync,enteredSS),enteredSS)
			)
			)
		
		Stateful_VS_O(id__,
				    const_SRangerController_obstaclethreshold) = 
			dbisim((let
				getsetLocalChannels = {||}
				clockSync = {||}
			within
				(Behaviour_VS_O(id__,
						    const_SRangerController_obstaclethreshold) 
				 [| union(union(getsetLocalChannels,clockSync),{terminate}) |] 
				 (varMemory(id__,
				 		    const_SRangerController_obstaclethreshold) [| {terminate} |] Clocks(id__,
				 		          const_SRangerController_obstaclethreshold))
			 	)\union(getsetLocalChannels,clockSync)
			)
			)
		
		IteratedStateful_VS_O(id__,
				    const_SRangerController_obstaclethreshold) =
			(IteratedBehaviour_VS_O(id__,
					    const_SRangerController_obstaclethreshold))
		
		-- END
		
		-- Memory
		-- Memory variables
		
		-- varMemory process
		varMemory(id__,
				    const_SRangerController_obstaclethreshold) = terminate -> SKIP
		
		getsetLocalChannels = {||}
		
		-- Definition of the behaviour of state machines (default, optimised, visible, visible and optimised)
		FVS__(id__,
				    const_SRangerController_obstaclethreshold) = STM_VS_O(id__,
				    const_SRangerController_obstaclethreshold) \ localClockResets
		D__(id__,
				    const_SRangerController_obstaclethreshold) = timed_priority(STM(id__,
				    const_SRangerController_obstaclethreshold) \ union(internal_events,localClockResets))
		O__(id__,
				    const_SRangerController_obstaclethreshold) = dbisim(D__(id__,
				    const_SRangerController_obstaclethreshold))
		VS__(id__,
				    const_SRangerController_obstaclethreshold) = FVS__(id__,
				    const_SRangerController_obstaclethreshold)
		VS_O__(id__,
				    const_SRangerController_obstaclethreshold) = dbisim(FVS__(id__,
				    const_SRangerController_obstaclethreshold))
		HEXT__(id__,
				    const_SRangerController_obstaclethreshold) = O__(id__,
				    const_SRangerController_obstaclethreshold) [|shared_variable_events|] SKIP
		FVS_C__(id__,
				    const_SRangerController_obstaclethreshold) = dbisim(timed_priority(STM(id__,
				    const_SRangerController_obstaclethreshold) \ internal_events))
		HUP__(id__,
				    const_SRangerController_obstaclethreshold) = timed_priority(O__(id__,
				    const_SRangerController_obstaclethreshold) [|{share__}|] SKIP)
		
		-- Clocks
		
		Clocks(id__,
				          const_SRangerController_obstaclethreshold) = terminate -> SKIP
		
		clockSync = {||}
		
		Clock_CLID_Moving(id__,x__,
				          const_SRangerController_obstaclethreshold) = 
			TimeOut_1(
				Moving::entered -> Clock_CLID_Moving(id__,0,
						          const_SRangerController_obstaclethreshold)
				[]
				get_CLID_Moving!x__ -> Clock_CLID_Moving(id__,x__,
						          const_SRangerController_obstaclethreshold)
				[]
				terminate -> SKIP,Clock_CLID_Moving(id__,clock_type_plus(x__,1,CLID_Moving_clock_type(id__,
						          const_SRangerController_obstaclethreshold)),
						          const_SRangerController_obstaclethreshold))
		Clock_CLID_Turning(id__,x__,
				          const_SRangerController_obstaclethreshold) = 
			TimeOut_1(
				Turning::entered -> Clock_CLID_Turning(id__,0,
						          const_SRangerController_obstaclethreshold)
				[]
				get_CLID_Turning!x__ -> Clock_CLID_Turning(id__,x__,
						          const_SRangerController_obstaclethreshold)
				[]
				terminate -> SKIP,Clock_CLID_Turning(id__,clock_type_plus(x__,1,CLID_Turning_clock_type(id__,
						          const_SRangerController_obstaclethreshold)),
						          const_SRangerController_obstaclethreshold))
		Clock_CLID_Final(id__,x__,
				          const_SRangerController_obstaclethreshold) = 
			TimeOut_1(
				Final::entered -> Clock_CLID_Final(id__,0,
						          const_SRangerController_obstaclethreshold)
				[]
				get_CLID_Final!x__ -> Clock_CLID_Final(id__,x__,
						          const_SRangerController_obstaclethreshold)
				[]
				terminate -> SKIP,Clock_CLID_Final(id__,clock_type_plus(x__,1,CLID_Final_clock_type(id__,
						          const_SRangerController_obstaclethreshold)),
						          const_SRangerController_obstaclethreshold))
		
		StateClocks(id__,
				          const_SRangerController_obstaclethreshold) = dbisim(Clock_CLID_Moving(id__,0,
				          const_SRangerController_obstaclethreshold))
		[| { terminate } |] (
		dbisim(Clock_CLID_Turning(id__,0,
				          const_SRangerController_obstaclethreshold))
		[| { terminate } |] (
		dbisim(Clock_CLID_Final(id__,0,
				          const_SRangerController_obstaclethreshold))
		)
		)
		
		stateClockSync = {|get_CLID_Moving,Moving::entered,get_CLID_Turning,Turning::entered,get_CLID_Final,Final::entered|}
		
		-- Shared memory
		-- Shared memory variables
		Memory_turnDurationElapsed(turnDurationElapsed) =
			get_turnDurationElapsed!turnDurationElapsed -> Memory_turnDurationElapsed(turnDurationElapsed)
			[]
			set_turnDurationElapsed?x__ -> Memory_turnDurationElapsed(x__)
			[]
			set_EXT_turnDurationElapsed?x__ -> Memory_turnDurationElapsed(x__)
			[]
			terminate -> SKIP
		Memory_resetTime(resetTime) =
			get_resetTime!resetTime -> Memory_resetTime(resetTime)
			[]
			set_resetTime?x__ -> Memory_resetTime(x__)
			[]
			set_EXT_resetTime?x__ -> Memory_resetTime(x__)
			[]
			terminate -> SKIP
		Memory_elapsed(elapsed) =
			get_elapsed!elapsed -> Memory_elapsed(elapsed)
			[]
			set_elapsed?x__ -> Memory_elapsed(x__)
			[]
			set_EXT_elapsed?x__ -> Memory_elapsed(x__)
			[]
			terminate -> SKIP
		Memory_lv(lv) =
			get_lv!lv -> Memory_lv(lv)
			[]
			set_lv?x__ -> Memory_lv(x__)
			[]
			set_EXT_lv?x__ -> Memory_lv(x__)
			[]
			terminate -> SKIP
		Memory_av(av) =
			get_av!av -> Memory_av(av)
			[]
			set_av?x__ -> Memory_av(x__)
			[]
			set_EXT_av?x__ -> Memory_av(x__)
			[]
			terminate -> SKIP
		Memory_distance(distance) =
			get_distance!distance -> Memory_distance(distance)
			[]
			set_distance?x__ -> Memory_distance(x__)
			[]
			set_EXT_distance?x__ -> Memory_distance(x__)
			[]
			terminate -> SKIP
		
		-- sharedVarMemory process
		sharedVarMemory(id__,
				    const_SRangerController_obstaclethreshold) = Memory_turnDurationElapsed(true)
		[| { terminate } |] (
		Memory_resetTime(0)
		[| { terminate } |] (
		Memory_elapsed(true)
		[| { terminate } |] (
		Memory_lv(0)
		[| { terminate } |] (
		Memory_av(0)
		[| { terminate } |] (
		Memory_distance(0)
		)
		)
		)
		)
		)
		
		sharedVarSync = {|get_turnDurationElapsed,set_turnDurationElapsed,set_EXT_turnDurationElapsed,get_resetTime,set_resetTime,set_EXT_resetTime,get_elapsed,set_elapsed,set_EXT_elapsed,get_lv,set_lv,set_EXT_lv,get_av,set_av,set_EXT_av,get_distance,set_distance,set_EXT_distance|}
		
		sharedVarHide = {|get_turnDurationElapsed,get_resetTime,get_elapsed,get_lv,get_av,get_distance|}
		}
endmodule
