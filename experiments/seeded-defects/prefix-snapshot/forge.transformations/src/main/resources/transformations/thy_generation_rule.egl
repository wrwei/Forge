[%
// FORK: archive left Init RHSs empty with a `(*To be filled in by user*)`
// comment, producing a parse error in Isabelle (empty-RHS substitutions).
// Emit sensible defaults so the theory parses:
//   st       -> initial          (designated pseudo-state from St enumtype)
//   tr       -> [State initial]  (history starts at the initial state)
//   triggers -> {}               (no triggers before first step)
// The developer can hand-edit the defaults to match their domain if
// Init_inv doesn't close automatically.
%]
definition Init :: "[%=stm_name%] subst" where
  [z_defs]:
  "Init =
  [st\<leadsto> initial
  ,tr\<leadsto> [State initial]
  ,triggers\<leadsto> {}
  ]"
(* FORK: defaults emitted by template; edit to match intended initial state if needed. *)
  
  
zmachine [%=stm_name%]Machine =
  init Init
  invariant [%=stm_name%]_inv
  operations [%=zoperations_string%] 


subsection \<open> Structural Invariants \<close>

lemma Init_inv [hoare_lemmas]: "Init establishes [%=stm_name%]_inv"
  by zpog_full

[%
var n=0;
while (n<zoperations_set.size())
{
if(zoperations_set.at(n)!="initial"){
if(zoperations_set.at(n).hasPara){
// FORK: build the lemma's argument list. For lens-rebind params the
// param-binder declared on the zoperation is `<sv>_input`, NOT the
// bare `<sv>` — using bare `<sv>` would collide with the zstore lens
// of the same name and fail with `Type unification failed: ...
// lens_scheme ... list`. For traditional INPUT-trigger params the
// archive convention is to use the bare param name.
var argString_inv = "(";
var firstArg_inv = true;
for(p in zoperations_set.at(n).paras){
	if(not firstArg_inv){ argString_inv = argString_inv + ", "; }
	if(zoperations_set.at(n).lensParas.includes(p)){
		argString_inv = argString_inv + p + "_input";
	} else {
		argString_inv = argString_inv + p;
	}
	firstArg_inv = false;
}
argString_inv = argString_inv + ")";
%]
lemma [%=zoperations_set.at(n).name%]_inv [hoare_lemmas]: "[%=zoperations_set.at(n).name%] [%=argString_inv%] preserves [%=stm_name%]_inv"
  by (zpog_full; auto simp add: wf_rcstore_def)  (* FORK: archive used `auto` alone; our trace-update shape `tr @ [Event x] @ [State y]` needs explicit unfolding of wf_rcstore *)

[%
} else if(not zoperations_set.at(n).hasPara){
%]
lemma [%=zoperations_set.at(n).name%]_inv [hoare_lemmas]: "[%=zoperations_set.at(n).name%]() preserves [%=stm_name%]_inv"
  by (zpog_full; auto simp add: wf_rcstore_def)  (* FORK: see twin lemma above for rationale *)

[%
}
}
n++;
}
%]

subsection \<open> Safety Requirements \<close>

[%
// FORK: archive emitted `zexpr R1 is ""` with an empty body, an
// intentional user-fillin. The empty term fails to parse. We emit
// `True` so R1 trivially holds; the `_inv`-style preservation
// lemmas then close automatically via zpog_full. The developer
// should hand-edit this predicate to encode the actual safety
// requirement they want to verify.
%]
zexpr R1 is "True"

lemma  "Init establishes R1"
  by zpog_full

[%
var n=0;
while (n<zoperations_set.size())
{
if(zoperations_set.at(n)!="initial"){
if(zoperations_set.at(n).hasPara){

%]
[%
// FORK: same lens-rebind / bare distinction as for the _inv lemma above.
var argString_R1 = "(";
var firstArg_R1 = true;
for(p in zoperations_set.at(n).paras){
	if(not firstArg_R1){ argString_R1 = argString_R1 + ", "; }
	if(zoperations_set.at(n).lensParas.includes(p)){
		argString_R1 = argString_R1 + p + "_input";
	} else {
		argString_R1 = argString_R1 + p;
	}
	firstArg_R1 = false;
}
argString_R1 = argString_R1 + ")";
%]
lemma "[%=zoperations_set.at(n).name%] [%=argString_R1%] preserves R1 under [%=stm_name%]_inv"
  by (zpog_full; auto)
  
[%
} else if(not zoperations_set.at(n).hasPara){
%]
lemma "[%=zoperations_set.at(n).name%]() preserves R1 under [%=stm_name%]_inv"
  by (zpog_full; auto)
  
[%
}
}
n++;
}
%]

[%
// FORK: archive defined `_axioms = ()` (unit), but the
// `<stm>_deadlock_free` lemma uses `_axioms \<Longrightarrow> ...`
// which requires a proposition. Unit `()` is not a bool. Use `True`
// for the vacuous-axioms case so the lemma typechecks. The developer
// can replace this with concrete axioms about the machine if needed.
%]
definition [z_defs]: "[%=stm_name%]_axioms = True"

lemma [%=stm_name%]_deadlock_free: "[%=stm_name%]_axioms  \<Longrightarrow> deadlock_free [%=stm_name%]Machine"
  unfolding [%=stm_name%]Machine_def
  apply deadlock_free
[% var ddTac; if(hasPayloadDomain){ ddTac = "using St.exhaust_disc by auto"; } else { ddTac = "by (metis St.exhaust_disc)"; } %]
  [%=ddTac%]
  (* FORK: the deadlock_free closing tactic is selected by `hasPayloadDomain`
     (set in PART 2 when this machine emits a typed-payload domain set such as
     `SeqGs`). The residual goal after `apply deadlock_free` is
       \<And>st. st = M\<^sub>1 \<or> ... \<or> guarded-disjuncts
     and St.exhaust_disc is the enumtype discriminator exhaustion lemma that
     matches the bare `st = X` disjunct for each state. Two cases:
       * has payload domain -> `using St.exhaust_disc by auto`. metis HANGS
         (>10 min) when a state's ONLY transition consumes a typed payload
         (e.g. gas-analysis Reading: `params gs_input \<in> SeqGs`), because the
         enabledness disjunct is `\<exists>gs_input \<in> SeqGs. ...`. With the set
         emitted as a [simp] `= UNIV` definition (PART 2), `auto` discharges the
         existential and closes via the bare disjunct. Verified on
         chemical_detector (gas-analysis, ~15s).
       * no payload domain -> `by (metis St.exhaust_disc)` (the ICECCS2023 LRE
         tactic). `auto` TIMES OUT (>6 min) on LRE's real-arithmetic guards --
         confirmed by regression -- so LRE-style machines keep metis.
     Tried and rejected: `(cases st; simp_all)` / `(cases st; auto)` leave the
     guarded disjunct (e.g. `thr() \<le> ins`) open because the split selects the
     guarded disjunct instead of the bare one. *)
 [%
// '}' in the line below is the close end of package scope: if (p.name="Chemical")
} 
}
%]
end
[%
//-------------------------------------------------------------------
//                     Operations
//-------------------------------------------------------------------
operation OrderedSet toparathString(): String{
	var str:String;
	str=self.at(0);
	var i=1;
	while(i<self.size()){
		str= str+", "+self.at(i);
		i++;
	}
	str="("+str + ")";
	return str;
}
%]





[*convert initial state name from i1 to initial, final j1 to final*]
[%
operation RC!Node zmState(): String{
  if(self.isTypeOf(Initial)){
  return "initial";
  } else if(self.isTypeOf(Final)){
    return "final";
  } else{
  return self.name;
  }
  }%]
  

[*convert initial state name from i1 to Initial, final j1 to Final*]
[%
operation RC!Node zmStateCapt(): String{
  if(self.isTypeOf(Initial)){
  return "Initial";
  } else if(self.isTypeOf(Final)){
    return "Final";
  } else{
  return self.name;
  }
  }%]
  
  
[*convert boolean type to bool type, real to integer*]
[%
operation RC!Type zmType(): String{
  if(self.isTypeOf(ProductType)){
  return "("+self.types.at(0).zmType() + "\\<times>" + self.types.at(1).zmType()+")";
  } else if(self.ref.name="boolean"){
  return "bool";
  } else if(self.ref.name="real"){
  // FORK: archive mapped RoboChart `real` to Isabelle `integer`,
  // which forced everything into integer arithmetic but caused type
  // unification failures when literal `1.0` appears in a guard
  // (Isabelle parses 1.0 as a rational requiring `inverse`-class).
  // Mapping to Isabelle `real` aligns with our Java `double` source
  // semantics and unifies cleanly with the FloatExp renderer.
  return "real";
  } else  {
  return self.ref.name;
  }
  }%]
  
  
  
[%
operation RC!Expression binaryExpString(): String{
	
	if(self.isTypeOf(LessThan)){
		return self.lessThanString();}
	else if(self.isTypeOf(GreaterThan)){
		return self.greaterThanString();}
	else if(self.isTypeOf(LessOrEqual)){
		return self.lessOrEqualString();}
	else if(self.isTypeOf(GreaterOrEqual)){
		return self.greaterOrEqualString();}
	else if(self.isTypeOf(Equals)){
		return self.equalsString();}
	else if (self.isTypeOf(And)){
		return self.andString();}
	else if (self.isTypeOf(Or)){
		return self.orString();}
	else if (self.isTypeOf(Not)){
		return self.notString();}
	else if (self.isTypeOf(Plus)){
		return self.plusString();}
	else if (self.isTypeOf(Minus)){
		return self.minusString();}
	else if (self.isTypeOf(Mult)){
		return self.multString();}
	// FORK: archive's dispatcher missed Different (!=), Div (/), Neg (-x).
	// `Different` is emitted by the ETL for any Java != in a guard; without
	// this case the operation returned undefined and the precondition came
	// out as e.g. "st = MOM \<and> " (empty RHS), unparseable in Isabelle.
	else if (self.isTypeOf(Different)){
		return self.differentString();}
	else if (self.isTypeOf(Div)){
		return self.divString();}
	else if (self.isTypeOf(Neg)){
		return self.negString();}
	else if(self.isTypeOf(IntegerExp) or self.isTypeOf(RefExp) or self.isTypeOf(CallExp)  or self.isTypeOf(ResultExp) or self.isTypeOf(Selection) or self.isTypeOf(EnumExp) or self.isTypeOf(ArrayExp) or self.isTypeOf(TupleExp) or self.isTypeOf(ClockExp) or self.isTypeOf(SeqExp) or self.isTypeOf(FloatExp) or self.isTypeOf(BooleanExp) or self.isTypeOf(StringExp) ){
		return self.oneSideOfBianryString();}
	else if(self.isTypeOf(ParExp)){
		return self.exp.binaryExpString();
	}
}
%]
[%

operation RC!Expression lessThanString(): String{
	return self.left.binaryExpString() +"<" + self.right.binaryExpString();
}
%]

[%
operation RC!Expression lessOrEqualString(): String{
	return self.left.binaryExpString() +"\\<le>" + self.right.binaryExpString();
}
%]

[%
operation RC!Expression greaterThanString(): String{
return self.left.binaryExpString() +">" + self.right.binaryExpString();
}
%]

[%
operation RC!Expression greaterOrEqualString(): String{
	return self.left.binaryExpString() +"\\<ge>" + self.right.binaryExpString();
}
%]

[%
operation RC!Expression equalsString(): String{
	return self.left.binaryExpString() +"= (" + self.right.binaryExpString()+")";
}
%]
[%
operation RC!Expression andString(): String{
	return self.left.binaryExpString() +" \\<and> " + self.right.binaryExpString();
}
%]

[%
operation RC!Expression orString(): String{
	return "("+self.left.binaryExpString() +" \\<or> " + self.right.binaryExpString()+")";
}
%]

[%
operation RC!Expression notString(): String{
	return "\\<not>" + self.exp.binaryExpString();
}
%]

[%
operation RC!Expression plusString(): String{
	return "("+self.left.binaryExpString() +" + " + self.right.binaryExpString()+")";
}
%]

[%
operation RC!Expression minusString(): String{
	return "("+self.left.binaryExpString() +" - " + self.right.binaryExpString()+")";
}
%]


[%
operation RC!Expression multString(): String{
	return "("+self.left.binaryExpString() +" * " + self.right.binaryExpString()+")";
}
%]
[%
// FORK: helpers for Different, Div, Neg. See binaryExpString() dispatch above.
operation RC!Expression differentString(): String{
	return "("+self.left.binaryExpString() +" \\<noteq> " + self.right.binaryExpString()+")";
}
%]
[%
operation RC!Expression divString(): String{
	return "("+self.left.binaryExpString() +" / " + self.right.binaryExpString()+")";
}
%]
[%
operation RC!Expression negString(): String{
	return "(- " + self.exp.binaryExpString() + ")";
}
%]
[%
//DONE
//to return the string of left or right expression string of the binary expression
//currently covers 3 types: Integer, RefExp, CallExp
operation RC!Expression oneSideOfBianryString(): String{
	if(self.isTypeOf(IntegerExp)){
		return self.value.toString();
	}
	// FORK: handle FloatExp (value may be null if ETL didn't populate) and
	// BoolExp / StringExp literals. Without this, numeric-literal RHSs
	// vanish from comparison preconditions and Isabelle parses truncated
	// operators (e.g. `vel()\<le>`).
	else if(self.isTypeOf(FloatExp)){
		// FORK: in EOL, `== null` is harness-dependent for unset
		// EAttributes — `.isUndefined()` is the idiomatic check.
		if(self.value.isUndefined()){ return "0"; }
		return self.value.toString();
	}
	else if(self.isTypeOf(BooleanExp)){
		return self.value.toString();
	}
	else if(self.isTypeOf(StringExp)){
		return "\"" + self.value + "\"";
	}
	else if(self.isTypeOf(RefExp)){
		return self.ref.name;
	}
	else if(self.isTypeOf(CallExp)){
		return self.callExpString();
	}
	else if(self.isTypeOf(ResultExp)){
		return "result";
	}
	else if(self.isTypeOf(Selection)){
		return self.member.name+"("+self.receiver.value.ref.name+"!"+self.receiver.parameters.at(0).ref.name+")";
	}
	
	else if(self.isTypeOf(EnumExp)){
		return self.literal.name;
	}
	else if(self.isTypeOf(SeqExp)){
		return self.sequenceString();
	}
	
	else if(self.isTypeOf(ArrayExp)){
		return self.value.ref.name + "."+self.parameters.at(0).value;
	//e.g., vel[1] -> vel.1
	}
	
	else if(self.isTypeOf(TupleExp)){
		return "("+ self.values.at(0).oneSideOfBianryString()+", "+self.values.at(1).oneSideOfBianryString() +")";
	//e.g., (3,4)
	}
	
	else if(self.isTypeOf(ClockExp)){
		return "clock";
	}
} 
%]
  
  
  
  
[*to generate the CallExp expression string for the statement of CallExp type, i.e. functions*]
[% 
// FORK: extract a function name from a CallExp's `function` feature,
// handling both RefExp (archive's shape) and StringExp (the shape our
// ETL emits). Keeps all callExp-name accesses in one place.
operation RC!CallExp funcName(): String{
	if(self.`function`.isTypeOf(StringExp)){
		return self.`function`.value;
	}
	return self.`function`.ref.name;
}

// FORK: recursive collector for CallExp identifiers used anywhere in
// an expression tree. Used by the consts-emission pass to discover
// functions referenced via StringExp-named CallExp (the shape our ETL
// emits for sensor/operation calls). Deliberately conservative — walks
// only the structural shapes the template understands.
operation RC!Expression collectCallExpNames(acc: OrderedSet, declared: Set){
	if (self.isTypeOf(CallExp)){
		var fn = self.funcName();
		if (not declared.includes(fn)){
			acc.add(fn);
		}
		for (a in self.args){
			a.collectCallExpNames(acc, declared);
		}
		return;
	}
	if (self.isTypeOf(And) or self.isTypeOf(Or) or self.isTypeOf(LessThan)
			or self.isTypeOf(LessOrEqual) or self.isTypeOf(GreaterThan)
			or self.isTypeOf(GreaterOrEqual) or self.isTypeOf(Equals)
			or self.isTypeOf(Different) or self.isTypeOf(Plus)
			or self.isTypeOf(Minus) or self.isTypeOf(Mult) or self.isTypeOf(Div)){
		self.left.collectCallExpNames(acc, declared);
		self.right.collectCallExpNames(acc, declared);
		return;
	}
	if (self.isTypeOf(Not)){
		self.exp.collectCallExpNames(acc, declared);
		return;
	}
	if (self.isTypeOf(ParExp)){
		self.exp.collectCallExpNames(acc, declared);
		return;
	}
	// Leaves (IntegerExp, FloatExp, BooleanExp, StringExp, RefExp, ...) contribute nothing.
}

// FORK: collect names of CallExps that appear as the direct operand
// of Not (e.g. `\<not>inOpez()`). These should be typed as boolean,
// not numeric, in the auto-emitted consts. Recurses through other
// expression shapes so nested occurrences are still caught.
operation RC!Expression collectBoolCallExpNames(acc: OrderedSet, declared: Set){
	if (self.isTypeOf(Not)){
		// The direct operand of Not is the boolean call site.
		if (self.exp.isTypeOf(CallExp)){
			var fn = self.exp.funcName();
			if (not declared.includes(fn)){
				acc.add(fn);
			}
		} else {
			// Could be \<not>(\<not> ...) or \<not>(par); recurse.
			self.exp.collectBoolCallExpNames(acc, declared);
		}
		return;
	}
	if (self.isTypeOf(And) or self.isTypeOf(Or)){
		// Boolean operands of And/Or could themselves be CallExps;
		// while we'd want to type those as bool too, we don't have
		// signal that they're used purely as bool (vs. e.g. compared).
		// Conservatively: only Not-direct triggers the bool override.
		self.left.collectBoolCallExpNames(acc, declared);
		self.right.collectBoolCallExpNames(acc, declared);
		return;
	}
	if (self.isTypeOf(LessThan) or self.isTypeOf(LessOrEqual) or self.isTypeOf(GreaterThan)
			or self.isTypeOf(GreaterOrEqual) or self.isTypeOf(Equals) or self.isTypeOf(Different)
			or self.isTypeOf(Plus) or self.isTypeOf(Minus) or self.isTypeOf(Mult) or self.isTypeOf(Div)){
		self.left.collectBoolCallExpNames(acc, declared);
		self.right.collectBoolCallExpNames(acc, declared);
		return;
	}
	if (self.isTypeOf(ParExp)){
		self.exp.collectBoolCallExpNames(acc, declared);
		return;
	}
	if (self.isTypeOf(CallExp)){
		// Recurse into args (may contain nested Not-CallExp patterns).
		for (a in self.args){
			a.collectBoolCallExpNames(acc, declared);
		}
		return;
	}
}

// FORK: collect names of CallExps that appear as direct args of
// another CallExp. Heuristic: in our LRE-style models, functions
// declared on the RoboChart package take `nat` indices (vdist, hdist,
// odist take `nat` per RoboChart Function declarations); callees that
// produce those indices (cstc, cdyn, cda, ...) therefore return `nat`.
// So if X appears as an arg of any CallExp, mark X's name as
// nat-returning so the auto-emit pass overrides the default `real`.
operation RC!Expression collectNatCallExpNames(acc: OrderedSet, declared: Set){
	if (self.isTypeOf(CallExp)){
		for (a in self.args){
			if (a.isTypeOf(CallExp)){
				var fn = a.funcName();
				if (not declared.includes(fn)){
					acc.add(fn);
				}
			}
			// Recurse into args to catch nested cases.
			a.collectNatCallExpNames(acc, declared);
		}
		return;
	}
	if (self.isTypeOf(And) or self.isTypeOf(Or) or self.isTypeOf(LessThan)
			or self.isTypeOf(LessOrEqual) or self.isTypeOf(GreaterThan)
			or self.isTypeOf(GreaterOrEqual) or self.isTypeOf(Equals)
			or self.isTypeOf(Different) or self.isTypeOf(Plus)
			or self.isTypeOf(Minus) or self.isTypeOf(Mult) or self.isTypeOf(Div)){
		self.left.collectNatCallExpNames(acc, declared);
		self.right.collectNatCallExpNames(acc, declared);
		return;
	}
	if (self.isTypeOf(Not) or self.isTypeOf(ParExp)){
		self.exp.collectNatCallExpNames(acc, declared);
		return;
	}
}

operation RC!CallExp callExpString(): String{
	var args_string: String = "";
	var callExp_string: String;
	// FORK: guard zero-argument calls — archive version blew up here
	if(self.args.size() == 0){
		return self.funcName() + "()";
	}
	//to get the parameter on the right

	if(self.args.at(0).isTypeOf(RefExp)){
		args_string= self.args.at(0).ref.name;
	}
	else
	//this branch is for callexp used in functions where we have the keyword result
	if(self.args.at(0).isTypeOf(ResultExp)){
		args_string= "result";
	}
	else
	if(self.args.at(0).isTypeOf(Selection)){
		args_string=self.args.at(0).member.name+"("+self.args.at(0).receiver.value.ref.name+"!"+self.args.at(0).receiver.parameters.at(0).ref.name+")";
	}
	else {
		// FORK: archive only handled RefExp/ResultExp/Selection. Anything
		// else (CallExp, IntegerExp, FloatExp, BinaryExpression, ...)
		// silently produced empty arg-string and dropped the argument,
		// e.g. odist(cstc()) became odist(). Render via the existing
		// expression dispatcher so any leaf or nested expression works.
		args_string = self.args.at(0).oneSideOfBianryString();
	}

	//for the case that there are more than 2 args, we need insert ',' between args
	var j=1;
	while(j<self.args.size()){

		if(self.args.at(j).isTypeOf(RefExp)){
			args_string=args_string+ ", "+ self.args.at(j).ref.name;
		}
		else
		//this branch is for callexp used in functions where we have the keyword result
		if(self.args.at(j).isTypeOf(ResultExp)){
			args_string=args_string+ ", "+ "result";
		}
		else
		if(self.args.at(j).isTypeOf(Selection)){
			self.args.at(j).receiver.println();
			args_string= args_string+ ", "+self.args.at(j).member.name+"("+self.args.at(j).receiver.value.ref.name+"!"+self.args.at(j).receiver.parameters.at(0).ref.name+")";
		}
		else {
			// FORK: same fallback for second-and-subsequent args.
			args_string = args_string + ", " + self.args.at(j).oneSideOfBianryString();
		}
		j++;
	}
	
	callExp_string=self.funcName()+"("+args_string+")";
	return callExp_string;
	}
  %]
    
[*to generate the Call expression string for the statement of Call type, i.e. operations*]
[% 
operation RC!Call callString(): String{
	var args_string: String;
	var call_string: String;
	//to get the parameter on the right
	if(self.args.size()=0){
		args_string="";
	}
	else if(self.args.size()>0){
		if(self.args.at(0).isTypeOf(RefExp)){
			args_string= self.args.at(0).ref.name;
		}
		else if(self.args.at(0).isTypeOf(IntegerExp)){
			args_string= self.args.at(0).value.toString();
		}
		else if(self.args.at(0).isTypeOf(EnumExp)){
			args_string= self.args.at(0).literal.name;
		}
		else 
		//this branch is for callexp used in functions where we have the keyword result
		if(self.args.at(0).isTypeOf(ResultExp)){
			args_string= "result";
		}
		else
		if(self.args.at(0).isTypeOf(Selection)){
			args_string=self.args.at(0).member.name+"("+self.args.at(0).receiver.value.ref.name+"!"+self.args.at(0).receiver.parameters.at(0).ref.name+")";
		}
		
		//for the case that there are more than 2 args, we need insert ',' between args
		var j=1;
		while(j<self.args.size()){
		//"self.args.at(j).type:".println();
		//self.args.at(j).type.println();
				
		if(self.args.at(j).isTypeOf(RefExp)){
			args_string=args_string+ ", "+ self.args.at(j).ref.name;
		}
		else if(self.args.at(j).isTypeOf(IntegerExp)){
			args_string= args_string+ ", "+ self.args.at(j).value.toString();
		}
		else if(self.args.at(j).isTypeOf(EnumExp)){
			args_string= args_string+ ", "+ self.args.at(j).literal.name;
		}
		else 
		//this branch is for callexp used in functions where we have the keyword result
		if(self.args.at(j).isTypeOf(ResultExp)){
			args_string=args_string+ ", "+ "result";
		}
		else
		if(self.args.at(j).isTypeOf(Selection)){
			self.args.at(j).receiver.println();
		args_string= args_string+ ", "+self.args.at(j).member.name+"("+self.args.at(j).receiver.value.ref.name+"!"+self.args.at(j).receiver.parameters.at(0).ref.name+")";
		
		}
		
		j++;
		}
	}
	call_string=self.`operation`.name+"("+args_string+")";
	return call_string;
}
  %]

  
[%
operation RC!SeqExp sequenceString(): String{
	
	if(self.values.size()=0){
		return  "[]";
	} 
	else if(self.values.size()>0) {
		var m=1;
		var sequence_string="["+self.values.at(0);
		while (m<self.values.size()){
			sequence_string=sequence_string+", "+self.values.at(m);
			m++;
		}
		sequence_string=sequence_string+"]";
		return sequence_string;
	}
}
%]


[%
operation RC!ProductType productString(): String{
	var strings: String;
	strings= "("+self.types.at(0).zmType() + "\\<times>" + self.types.at(1).zmType()+")" ;
	return strings;
}
%]