  <spoon:CtClass name="CalcLevelEstimate">
    <comment xsi:type="spoon:CtJavaDoc" commentContent="Maintains the level estimate interval and the M1/M2 risk predicates&#xA;(SB-V8, SB-Beh13, SB-Beh19). While the level device is sound the interval&#xA;collapses onto the accepted reading; while it is out of order the interval&#xA;is advanced each cycle from its previous value using the maximal steam&#xA;dynamics (W, U1, U2) and the water known to be supplied by the pumps,&#xA;one supplied litre counting as one litre of content (SB-Beh19), with the&#xA;pump start latency respected (SB-Beh25).&#xA;&#xA;&lt;p>This operation carries state across cycles: {@code projLow} and&#xA;{@code projHigh} computed in cycle t are the carried-over candidates read&#xA;in cycle t+1."/>
    <modifier>PUBLIC</modifier>
    <modifier>FINAL</modifier>
    <typeMember xsi:type="spoon:CtField" name="sensor">
      <modifier>PRIVATE</modifier>
      <modifier>FINAL</modifier>
