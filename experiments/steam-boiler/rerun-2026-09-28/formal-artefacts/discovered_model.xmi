          <packageRef isImplicit="true" name="steamboiler.annotation"/>
        </annotationType>
      </annotation>
      <comment xsi:type="spoon:CtJavaDoc" commentContent="Upper bound on the current water level (litre)."/>
      <modifier>PRIVATE</modifier>
      <type name="double"/>
    </typeMember>
    <typeMember xsi:type="spoon:CtField" name="projLow">
