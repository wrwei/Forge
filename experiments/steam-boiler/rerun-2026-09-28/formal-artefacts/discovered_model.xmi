        </annotationType>
      </annotation>
      <comment xsi:type="spoon:CtJavaDoc" commentContent="Worst-case upper bound projected one cycle ahead (litre)."/>
      <modifier>PRIVATE</modifier>
      <type name="double"/>
    </typeMember>
    <typeMember xsi:type="spoon:CtField" name="riskBelowM1">
      <comment xsi:type="spoon:CtJavaDoc" commentContent="The level risks reaching M1 within one worst-case cycle (SB-Beh13)."/>
