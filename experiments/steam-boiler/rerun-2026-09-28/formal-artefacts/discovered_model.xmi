        </annotationType>
      </annotation>
      <comment xsi:type="spoon:CtJavaDoc" commentContent="Worst-case lower bound projected one cycle ahead (litre)."/>
      <modifier>PRIVATE</modifier>
      <type name="double"/>
    </typeMember>
