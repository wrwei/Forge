    <typeMember xsi:type="spoon:CtField" name="transmissionFailed">
      <comment commentContent="---- Guard predicate fields, refreshed each step (SB-FR8 priority"/>
      <comment commentContent="discipline). Stored as instance FIELDS rather than method-local"/>
