  <spoon:CtInterface name="InputEvent">
    <comment xsi:type="spoon:CtJavaDoc" commentContent="Input events delivered to the controller. The steam-boiler protocol is&#xA;cycle-batched (SB-V3): within one transmission all incoming messages&#xA;arrive simultaneously, so the single controller-visible event is one&#xA;{@link Transmission} tick per cycle. The batch content itself is parsed&#xA;into the Sensor layer before {@code step} runs (encoding choice for the&#xA;batched-input construct; see encoding_choices.md)."/>
    <permittedType isImplicit="true" name="Transmission">
      <declaringType name="InputEvent">
        <packageRef name="steamboiler.event"/>
      </declaringType>
    </permittedType>
