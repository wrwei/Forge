    <typeMember xsi:type="spoon:CtMethod" name="anyPumpFailed">
      <comment xsi:type="spoon:CtJavaDoc" commentContent="Any of the four pumps currently believed out of order."/>
      <modifier>PUBLIC</modifier>
      <body xsi:type="spoon:CtBlock">
        <statement xsi:type="spoon:CtLocalVariable" name="any">
          <type name="boolean"/>
          <assignment xsi:type="spoon:CtLiteral" value="false" valueKind="Boolean">
            <type name="boolean"/>
          </assignment>
        </statement>
        <statement xsi:type="spoon:CtFor">
          <body xsi:type="spoon:CtBlock">
            <statement xsi:type="spoon:CtIf">
              <condition xsi:type="spoon:CtUnaryOperator" operatorKind="NOT">
                <type name="boolean"/>
                <expression xsi:type="spoon:CtArrayRead">
                  <type name="boolean"/>
                  <target xsi:type="spoon:CtFieldRead">
                    <type xsi:type="spoon:CtArrayTypeReference" name="boolean[]">
                      <type name="boolean"/>
                    </type>
                    <variable xsi:type="spoon:CtFieldReference" name="pumpSound" isFinal="true">
                      <declaringType name="StatusRegister">
                        <packageRef name="steamboiler.sensor"/>
                      </declaringType>
                    </variable>
                    <target xsi:type="spoon:CtThisAccess" isImplicit="true">
                      <type name="StatusRegister">
                        <packageRef name="steamboiler.sensor"/>
                      </type>
                      <target xsi:type="spoon:CtTypeAccess">
                        <type name="void"/>
                        <accessedType name="StatusRegister">
                          <packageRef name="steamboiler.sensor"/>
                        </accessedType>
                      </target>
                    </target>
                  </target>
                  <expression xsi:type="spoon:CtVariableRead">
                    <type name="int"/>
                    <variable xsi:type="spoon:CtLocalVariableReference" name="i"/>
                  </expression>
                </expression>
              </condition>
              <then xsi:type="spoon:CtBlock">
                <statement xsi:type="spoon:CtAssignment">
                  <type name="boolean"/>
                  <assignment xsi:type="spoon:CtLiteral" value="true" valueKind="Boolean">
                    <type name="boolean"/>
                  </assignment>
                  <assigned xsi:type="spoon:CtVariableWrite">
                    <type name="boolean"/>
                    <variable xsi:type="spoon:CtLocalVariableReference" name="any"/>
                  </assigned>
                </statement>
              </then>
            </statement>
          </body>
          <forInit xsi:type="spoon:CtLocalVariable" name="i">
            <type name="int"/>
            <assignment xsi:type="spoon:CtLiteral" value="1" valueKind="Integer">
              <type name="int"/>
            </assignment>
          </forInit>
          <forUpdate xsi:type="spoon:CtUnaryOperator" operatorKind="POSTINC">
            <type name="int"/>
            <expression xsi:type="spoon:CtVariableWrite">
              <type name="int"/>
              <variable xsi:type="spoon:CtLocalVariableReference" name="i"/>
            </expression>
          </forUpdate>
          <expression xsi:type="spoon:CtBinaryOperator" operatorKind="LE">
            <type name="boolean"/>
            <leftOperand xsi:type="spoon:CtVariableRead">
              <type name="int"/>
              <variable xsi:type="spoon:CtLocalVariableReference" name="i"/>
            </leftOperand>
            <rightOperand xsi:type="spoon:CtFieldRead">
              <type name="int"/>
              <variable xsi:type="spoon:CtFieldReference" name="PUMP_COUNT" isFinal="true" isStatic="true">
                <declaringType name="BoilerConstants">
                  <packageRef name="steamboiler.constants"/>
                </declaringType>
              </variable>
              <target xsi:type="spoon:CtTypeAccess">
                <type name="void"/>
                <accessedType name="BoilerConstants">
                  <packageRef isImplicit="true" name="steamboiler.constants"/>
                </accessedType>
              </target>
            </rightOperand>
          </expression>
        </statement>
        <statement xsi:type="spoon:CtReturn">
