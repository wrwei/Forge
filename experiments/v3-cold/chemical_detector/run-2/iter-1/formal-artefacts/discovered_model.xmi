    <typeMember xsi:type="spoon:CtMethod" name="changeDirection">
      <comment xsi:type="spoon:CtJavaDoc" commentContent="Steers away from an obstacle at the linear velocity (CD-OP4): an&#xA;obstacle on the left turns right, on the right turns left, in front&#xA;turns back.">
