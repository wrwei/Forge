                      </declaringType>
                    </variable>
                    <target xsi:type="spoon:CtTypeAccess">
                      <type name="void"/>
                      <accessedType name="ChemicalDetectorConstants">
                        <packageRef isImplicit="true" name="chemical_detector"/>
                      </accessedType>
