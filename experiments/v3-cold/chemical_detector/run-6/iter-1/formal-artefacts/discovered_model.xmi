    <typeMember xsi:type="spoon:CtMethod" name="toMovementEvent">
      <comment commentContent="The commands issued are turn, stop and resume only."/>
      <modifier>PRIVATE</modifier>
      <body xsi:type="spoon:CtBlock">
        <statement xsi:type="spoon:CtIf">
