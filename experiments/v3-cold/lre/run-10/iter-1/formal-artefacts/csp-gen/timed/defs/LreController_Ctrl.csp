				reqMOM,
				reqOCM,
				endTask,
				reqHCM,
				advVel,
				advHdng
				|}
			
			channel clockReset, clockResetL, clockResetR 
			
			localClockResets = {||}
			
			
			channel get_CLID_OCM : core_clock_type 
			channel get_CLID_MOM : core_clock_type 
			channel get_CLID_HCM : core_clock_type 
			channel get_CLID_CAM : core_clock_type 
			--channel increment__
			
			CLID_OCM_clock_type(id__,
					          const_LreController_engageMaxVel,
					          const_LreController_engageMinDist,
					          const_LreController_minSafeDist,
					          const_LreController_highHorizVel,
					          const_LreController_staticObsHorizDist,
