								  [[ share__ <- x__ | x__ <- {| share__ |} ]] 
								 )
								 [| union(union(union(flowevts,transSync),{terminate}),{|share__
								|}) |]
								 ((i0::enter -> Transitions(id__,
								 		    const_CheckOPEZ_engageMaxVel,
								 		    const_CheckOPEZ_engageMinDist,
								 		    const_CheckOPEZ_minSafeDist,
								 		    const_CheckOPEZ_highHorizVel,
								 		    const_CheckOPEZ_staticObsHorizDist,
								 		    const_CheckOPEZ_highVertVel,
								 		    const_CheckOPEZ_staticObsVertDist,
								 		    const_CheckOPEZ_staticObsDfltVertDist,
								 		    const_CheckOPEZ_cpaSpeedEps))
								  [[ share__ <- x__ | x__ <- {| share__ |} ]]
								 )
								)
								)
							)
							 \ hideSet)
						)
						)
						 [| union(stateClockSync,{terminate}) |]
						 StateClocks(id__,
						 		          const_CheckOPEZ_engageMaxVel,
						 		          const_CheckOPEZ_engageMinDist,
						 		          const_CheckOPEZ_minSafeDist,
						 		          const_CheckOPEZ_highHorizVel,
						 		          const_CheckOPEZ_staticObsHorizDist,
						 		          const_CheckOPEZ_highVertVel,
						 		          const_CheckOPEZ_staticObsVertDist,
						 		          const_CheckOPEZ_staticObsDfltVertDist,
						 		          const_CheckOPEZ_cpaSpeedEps)
						)\diff(stateClockSync,enteredSS))
						 [| {| interrupt |} |] SKIP)
					)
					)
				
				Behaviour_VS_O(id__,
						    const_CheckOPEZ_engageMaxVel,
						    const_CheckOPEZ_engageMinDist,
						    const_CheckOPEZ_minSafeDist,
						    const_CheckOPEZ_highHorizVel,
						    const_CheckOPEZ_staticObsHorizDist,
