						    const_CheckOPEZ_staticObsVertDist,
						    const_CheckOPEZ_staticObsDfltVertDist,
						    const_CheckOPEZ_cpaSpeedEps) = terminate -> SKIP
				
				getsetLocalChannels = {||}
				
				-- Definition of the behaviour of state machines (default, optimised, visible, visible and optimised)
				FVS__(id__,
						    const_CheckOPEZ_engageMaxVel,
						    const_CheckOPEZ_engageMinDist,
						    const_CheckOPEZ_minSafeDist,
						    const_CheckOPEZ_highHorizVel,
						    const_CheckOPEZ_staticObsHorizDist,
