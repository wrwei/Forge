			i0::enter
			|}
			
			enteredSS = 	{|
			MOM::entered,
			OCM::entered,
			HCM::entered,
			CAM::entered
			|}
			
			internal_events = union(enteredSS,union(enterSS,{|interrupt,exited|}))
			
			shared_variable_events = {|
				set_EXT_vel,
				set_EXT_inOpez,
				set_EXT_cdyn,
				set_EXT_cstc,
				set_EXT_cda,
				set_EXT_tcpa,
