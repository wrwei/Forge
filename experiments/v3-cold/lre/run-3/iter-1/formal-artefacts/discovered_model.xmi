    <typeMember xsi:type="spoon:CtConstructor" name="&lt;init>">
      <comment xsi:type="spoon:CtJavaDoc" commentContent="A controller in OCM reading the given sensor and advising the given actuator."/>
      <modifier>PUBLIC</modifier>
      <body xsi:type="spoon:CtBlock">
        <statement xsi:type="spoon:CtInvocation" isImplicit="true">
          <type name="Object">
            <packageRef name="java.lang"/>
          </type>
          <executableRef isImplicit="true" name="&lt;init>">
            <declaringType name="Object">
              <packageRef name="java.lang"/>
            </declaringType>
          </executableRef>
        </statement>
        <statement xsi:type="spoon:CtAssignment">
          <type name="Sensor">
            <packageRef name="lre.sensor"/>
          </type>
          <assignment xsi:type="spoon:CtVariableRead">
            <type name="Sensor">
              <packageRef name="lre.sensor"/>
            </type>
            <variable xsi:type="spoon:CtParameterReference" name="sensor"/>
          </assignment>
          <assigned xsi:type="spoon:CtFieldWrite">
            <type name="Sensor">
              <packageRef name="lre.sensor"/>
            </type>
            <target xsi:type="spoon:CtThisAccess">
              <type name="LreController">
                <packageRef name="lre.controller"/>
              </type>
              <target xsi:type="spoon:CtTypeAccess">
                <type name="void"/>
                <accessedType name="LreController">
                  <packageRef name="lre.controller"/>
                </accessedType>
              </target>
            </target>
            <variable xsi:type="spoon:CtFieldReference" name="sensor" isFinal="true">
              <declaringType name="LreController">
                <packageRef name="lre.controller"/>
