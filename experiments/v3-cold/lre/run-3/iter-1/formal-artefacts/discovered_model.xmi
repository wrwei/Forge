  <spoon:CtClass name="LreController">
    <comment xsi:type="spoon:CtJavaDoc" commentContent="The Last Response Engine: the AUV's reactive safety controller between the&#xA;operator controller and the autopilot. It reads the Sensor, computes the&#xA;derived quantities each step, and advises velocity and heading through the&#xA;Actuator while switching between OCM, MOM, HCM and CAM."/>
    <modifier>FINAL</modifier>
    <modifier>PUBLIC</modifier>
    <typeMember xsi:type="spoon:CtField" name="currentMode">
      <modifier>PRIVATE</modifier>
      <type name="LreMode">
        <packageRef isImplicit="true" name="lre.mode"/>
      </type>
      <assignment xsi:type="spoon:CtFieldRead">
        <type name="LreMode">
          <packageRef name="lre.mode"/>
        </type>
        <variable xsi:type="spoon:CtFieldReference" name="OCM" isFinal="true" isStatic="true">
