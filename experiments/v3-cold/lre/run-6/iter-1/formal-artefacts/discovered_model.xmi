  <spoon:CtClass name="LreController">
    <comment xsi:type="spoon:CtJavaDoc" commentContent="The Last Response Engine (LRE-ARCH1, LRE-ARCH2): reads the AUV's sensor,&#xA;receives operator events and advises velocity and heading to the autopilot&#xA;through the actuator."/>
    <modifier>FINAL</modifier>
    <modifier>PUBLIC</modifier>
    <typeMember xsi:type="spoon:CtField" name="currentMode">
      <modifier>PRIVATE</modifier>
      <type name="LreMode">
        <packageRef isImplicit="true" name="lre.controller"/>
      </type>
      <assignment xsi:type="spoon:CtFieldRead">
        <type name="LreMode">
          <packageRef name="lre.controller"/>
        </type>
