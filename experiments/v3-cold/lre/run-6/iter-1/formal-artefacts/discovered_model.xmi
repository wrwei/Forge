                    </declaringType>
                  </type>
                  <variable xsi:type="spoon:CtLocalVariableReference" name="velocityCommand"/>
                </target>
                <executableRef name="value">
                  <declaringType name="AdvVel">
                    <declaringType name="OutputEvent">
                      <packageRef name="lre.event"/>
                    </declaringType>
                  </declaringType>
                </executableRef>
              </assignment>
              <assigned xsi:type="spoon:CtFieldWrite">
                <type name="double"/>
                <target xsi:type="spoon:CtThisAccess">
                  <type name="Actuator">
                    <packageRef name="lre.actuator"/>
