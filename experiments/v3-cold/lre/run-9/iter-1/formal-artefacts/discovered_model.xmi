    <typeMember xsi:type="spoon:CtConstructor" name="&lt;init>">
      <comment xsi:type="spoon:CtJavaDoc" commentContent="Creates the controller in OCM over the given sensor and actuator."/>
      <modifier>PUBLIC</modifier>
      <body xsi:type="spoon:CtBlock">
        <statement xsi:type="spoon:CtInvocation" isImplicit="true">
          <type name="Object">
            <packageRef name="java.lang"/>
          </type>
          <executableRef isImplicit="true" name="&lt;init>">
