                    <packageRef name="lre.actuator"/>
                  </declaringType>
                </variable>
              </assigned>
            </statement>
          </then>
        </statement>
      </body>
      <type name="void"/>
      <parameter name="output">
        <type name="OutputEvent">
          <packageRef isImplicit="true" name="lre.event"/>
        </type>
