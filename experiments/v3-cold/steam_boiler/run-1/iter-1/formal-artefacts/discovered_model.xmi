      <modifier>PUBLIC</modifier>
      <modifier>STATIC</modifier>
      <modifier>FINAL</modifier>
      <type name="double"/>
      <assignment xsi:type="spoon:CtLiteral" value="1000.0" valueKind="Double">
        <type name="double"/>
      </assignment>
    </typeMember>
