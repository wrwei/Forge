diagram SteamBoilerController

enumeration ModeValue { INITIALIZATION NORMAL DEGRADED RESCUE EMERGENCY_STOP }

datatype FlowReading {
	pump : int
	flowing : boolean
}

datatype PumpReading {
	pump : int
	open : boolean
}

interface Inputs {
	event transmission
}

interface Outputs {
	event mode
	event programReady
	event valve
	event openPump : int
	event closePump : int
}

interface Sensors {
	var PUMPS : int
	var stopCount : int
	var boilerWaitingEver : boolean
	var boilerWaitingNow : boolean
	var unitsReadyNow : boolean
	var intact : boolean
	var q : real
	var v : real
	var levelRepair : boolean
	var steamRepair : boolean
	var levelFailureAck : boolean
	var steamFailureAck : boolean
	var successiveStops : int
	var boilerWaitingSeen : boolean
	var transmissionIntact : boolean
	var unitsReadyPresent : boolean
	var steamReading : real
	var levelUnitFailed : boolean
	var steamUnitFailed : boolean
	var pumpUnitFailed : boolean
	var pumpControlUnitFailed : boolean
	var levelHigh : real
	var levelLow : real
	var waitingMessagePresent : boolean
	var predictedLevelMin : real
	var predictedLevelMax : real
}

interface Actuators {
}

interface SteamBoilerController_State {
	var readyAnnounced : boolean = false
	var valveOpen : boolean = false
}

interface Constants {
	const stopLimit : real = 3
	const normalN2 : real = 600
	const normalN1 : real = 400
	const limitM1 : real = 100
	const limitM2 : real = 900
}

stm SteamBoilerController {
	uses Inputs uses Outputs requires SteamBoilerController_State requires Constants requires Sensors
	state RESCUE {
		entry send mode
	}
	state DEGRADED {
		entry send mode
	}
	state NORMAL {
		entry send mode
	}
	state INITIALIZATION {
	}
	state EMERGENCY_STOP {
		entry send mode
	}
	initial i0
	transition t_init {
		from i0
		to INITIALIZATION
	}
	transition t1 {
		from INITIALIZATION
		to EMERGENCY_STOP
		trigger transmission
		condition successiveStops >= stopLimit
	}
	transition t2 {
		from INITIALIZATION
		to INITIALIZATION
		trigger transmission
		condition not ( successiveStops >= stopLimit ) /\ not ( boilerWaitingSeen )
		action send mode
	}
	transition t3 {
		from INITIALIZATION
		to EMERGENCY_STOP
		trigger transmission
		condition not ( successiveStops >= stopLimit ) /\ not ( not ( boilerWaitingSeen ) ) /\ (not ( transmissionIntact ) \/ not ( readyAnnounced ))
	}
	transition t4 {
		from INITIALIZATION
		to EMERGENCY_STOP
		trigger transmission
		condition not ( successiveStops >= stopLimit ) /\ not ( not ( boilerWaitingSeen ) ) /\ not ( not ( transmissionIntact ) \/ unitsReadyPresent /\ not ( readyAnnounced ) ) /\ steamReading != 0
	}
	transition t5 {
		from INITIALIZATION
		to EMERGENCY_STOP
		trigger transmission
		condition not ( successiveStops >= stopLimit ) /\ not ( not ( boilerWaitingSeen ) ) /\ not ( not ( transmissionIntact ) \/ unitsReadyPresent /\ not ( readyAnnounced ) ) /\ not ( steamReading != 0 ) /\ levelUnitFailed
	}
	transition t6 {
		from INITIALIZATION
		to NORMAL
		trigger transmission
		condition not ( successiveStops >= stopLimit ) /\ not ( not ( boilerWaitingSeen ) ) /\ not ( not ( transmissionIntact ) \/ unitsReadyPresent /\ not ( readyAnnounced ) ) /\ not ( steamReading != 0 ) /\ not ( levelUnitFailed ) /\ readyAnnounced /\ not ( levelUnitFailed ) /\ not ( steamUnitFailed \/ pumpUnitFailed \/ pumpControlUnitFailed )
	}
	transition t7 {
		from INITIALIZATION
		to DEGRADED
		trigger transmission
		condition not ( successiveStops >= stopLimit ) /\ not ( not ( boilerWaitingSeen ) ) /\ not ( not ( transmissionIntact ) \/ unitsReadyPresent /\ not ( readyAnnounced ) ) /\ not ( steamReading != 0 ) /\ not ( levelUnitFailed ) /\ readyAnnounced /\ not ( not ( levelUnitFailed ) /\ not ( steamUnitFailed \/ pumpUnitFailed \/ pumpControlUnitFailed ) )
	}
	transition t8 {
		from INITIALIZATION
		to INITIALIZATION
		trigger transmission
		condition not ( successiveStops >= stopLimit ) /\ not ( not ( boilerWaitingSeen ) ) /\ not ( not ( transmissionIntact ) \/ unitsReadyPresent /\ not ( readyAnnounced ) ) /\ not ( steamReading != 0 ) /\ not ( levelUnitFailed ) /\ readyAnnounced /\ not ( unitsReadyPresent )
		action send mode ; send programReady
	}
	transition t9 {
		from INITIALIZATION
		to INITIALIZATION
		trigger transmission
		condition not ( successiveStops >= stopLimit ) /\ not ( not ( boilerWaitingSeen ) ) /\ not ( not ( transmissionIntact ) \/ unitsReadyPresent /\ not ( readyAnnounced ) ) /\ not ( steamReading != 0 ) /\ not ( levelUnitFailed ) /\ not ( readyAnnounced ) /\ levelHigh > normalN2 /\ not ( valveOpen )
		action send mode ; send valve ; valveOpen = true
	}
	transition t10 {
		from INITIALIZATION
		to INITIALIZATION
		trigger transmission
		condition not ( successiveStops >= stopLimit ) /\ not ( not ( boilerWaitingSeen ) ) /\ not ( not ( transmissionIntact ) \/ unitsReadyPresent /\ not ( readyAnnounced ) ) /\ not ( steamReading != 0 ) /\ not ( levelUnitFailed ) /\ not ( readyAnnounced ) /\ levelHigh > normalN2 /\ valveOpen
		action send mode
	}
	transition t11 {
		from INITIALIZATION
		to INITIALIZATION
		trigger transmission
		condition not ( successiveStops >= stopLimit ) /\ not ( not ( boilerWaitingSeen ) ) /\ not ( not ( transmissionIntact ) \/ unitsReadyPresent /\ not ( readyAnnounced ) ) /\ not ( steamReading != 0 ) /\ not ( levelUnitFailed ) /\ not ( readyAnnounced ) /\ levelLow < normalN1 /\ not ( levelHigh > normalN2 ) /\ valveOpen
		action send mode ; send valve ; valveOpen = false ; openPump ! 0 ; openPump ! 1 ; openPump ! 2 ; openPump ! 3
	}
	transition t12 {
		from INITIALIZATION
		to INITIALIZATION
		trigger transmission
		condition not ( successiveStops >= stopLimit ) /\ not ( not ( boilerWaitingSeen ) ) /\ not ( not ( transmissionIntact ) \/ unitsReadyPresent /\ not ( readyAnnounced ) ) /\ not ( steamReading != 0 ) /\ not ( levelUnitFailed ) /\ not ( readyAnnounced ) /\ levelLow < normalN1 /\ not ( levelHigh > normalN2 ) /\ not ( valveOpen )
		action send mode ; openPump ! 0 ; openPump ! 1 ; openPump ! 2 ; openPump ! 3
	}
	transition t13 {
		from INITIALIZATION
		to INITIALIZATION
		trigger transmission
		condition not ( successiveStops >= stopLimit ) /\ not ( not ( boilerWaitingSeen ) ) /\ not ( not ( transmissionIntact ) \/ unitsReadyPresent /\ not ( readyAnnounced ) ) /\ not ( steamReading != 0 ) /\ not ( levelUnitFailed ) /\ not ( readyAnnounced ) /\ not ( levelLow < normalN1 ) /\ not ( levelHigh > normalN2 ) /\ valveOpen
		action send mode ; send valve ; valveOpen = false ; closePump ! 0 ; closePump ! 1 ; closePump ! 2 ; closePump ! 3 ; send programReady ; readyAnnounced = true
	}
	transition t14 {
		from INITIALIZATION
		to INITIALIZATION
		trigger transmission
		condition not ( successiveStops >= stopLimit ) /\ not ( not ( boilerWaitingSeen ) ) /\ not ( not ( transmissionIntact ) \/ unitsReadyPresent /\ not ( readyAnnounced ) ) /\ not ( steamReading != 0 ) /\ not ( levelUnitFailed ) /\ not ( readyAnnounced ) /\ not ( levelLow < normalN1 ) /\ not ( levelHigh > normalN2 ) /\ not ( valveOpen )
		action send mode ; closePump ! 0 ; closePump ! 1 ; closePump ! 2 ; closePump ! 3 ; send programReady ; readyAnnounced = true
	}
	transition t15 {
		from NORMAL
		to EMERGENCY_STOP
		trigger transmission
		condition successiveStops >= stopLimit
	}
	transition t16 {
		from NORMAL
		to EMERGENCY_STOP
		trigger transmission
		condition not ( successiveStops >= stopLimit ) /\ not ( transmissionIntact )
	}
	transition t17 {
		from NORMAL
		to EMERGENCY_STOP
		trigger transmission
		condition not ( successiveStops >= stopLimit ) /\ not ( not ( transmissionIntact ) \/ waitingMessagePresent \/ unitsReadyPresent ) /\ (predictedLevelMin <= limitM1 \/ predictedLevelMax >= limitM2)
	}
	transition t18 {
		from NORMAL
		to EMERGENCY_STOP
		trigger transmission
		condition not ( successiveStops >= stopLimit ) /\ not ( not ( transmissionIntact ) \/ waitingMessagePresent \/ unitsReadyPresent ) /\ not ( predictedLevelMin <= limitM1 \/ predictedLevelMax >= limitM2 ) /\ levelUnitFailed /\ (steamUnitFailed \/ pumpControlUnitFailed)
	}
	transition t19 {
		from NORMAL
		to RESCUE
		trigger transmission
		condition not ( successiveStops >= stopLimit ) /\ not ( not ( transmissionIntact ) \/ waitingMessagePresent \/ unitsReadyPresent ) /\ not ( predictedLevelMin <= limitM1 \/ predictedLevelMax >= limitM2 ) /\ levelUnitFailed /\ not ( steamUnitFailed \/ pumpControlUnitFailed )
	}
	transition t20 {
		from NORMAL
		to DEGRADED
		trigger transmission
		condition not ( successiveStops >= stopLimit ) /\ not ( not ( transmissionIntact ) \/ waitingMessagePresent \/ unitsReadyPresent ) /\ not ( predictedLevelMin <= limitM1 \/ predictedLevelMax >= limitM2 ) /\ not ( levelUnitFailed ) /\ (steamUnitFailed \/ pumpUnitFailed \/ pumpControlUnitFailed)
	}
	transition t21 {
		from NORMAL
		to NORMAL
		trigger transmission
		condition not ( successiveStops >= stopLimit ) /\ not ( not ( transmissionIntact ) \/ waitingMessagePresent \/ unitsReadyPresent ) /\ not ( predictedLevelMin <= limitM1 \/ predictedLevelMax >= limitM2 ) /\ not ( levelUnitFailed ) /\ not ( steamUnitFailed \/ pumpUnitFailed \/ pumpControlUnitFailed ) /\ levelLow < normalN1 /\ not ( levelHigh > normalN2 )
		action send mode ; openPump ! 0 ; openPump ! 1 ; openPump ! 2 ; openPump ! 3
	}
	transition t22 {
		from NORMAL
		to NORMAL
		trigger transmission
		condition not ( successiveStops >= stopLimit ) /\ not ( not ( transmissionIntact ) \/ waitingMessagePresent \/ unitsReadyPresent ) /\ not ( predictedLevelMin <= limitM1 \/ predictedLevelMax >= limitM2 ) /\ not ( levelUnitFailed ) /\ not ( steamUnitFailed \/ pumpUnitFailed \/ pumpControlUnitFailed ) /\ levelHigh > normalN2 /\ not ( levelLow < normalN1 )
		action send mode ; closePump ! 0 ; closePump ! 1 ; closePump ! 2 ; closePump ! 3
	}
	transition t23 {
		from NORMAL
		to NORMAL
		trigger transmission
		condition not ( successiveStops >= stopLimit ) /\ not ( not ( transmissionIntact ) \/ waitingMessagePresent \/ unitsReadyPresent ) /\ not ( predictedLevelMin <= limitM1 \/ predictedLevelMax >= limitM2 ) /\ not ( levelUnitFailed ) /\ not ( steamUnitFailed \/ pumpUnitFailed \/ pumpControlUnitFailed ) /\ not ( levelLow < normalN1 /\ not ( levelHigh > normalN2 ) ) /\ not ( levelHigh > normalN2 /\ not ( levelLow < normalN1 ) )
	}
	transition t24 {
		from DEGRADED
		to EMERGENCY_STOP
		trigger transmission
		condition successiveStops >= stopLimit
	}
	transition t25 {
		from DEGRADED
		to EMERGENCY_STOP
		trigger transmission
		condition not ( successiveStops >= stopLimit ) /\ not ( transmissionIntact )
	}
	transition t26 {
		from DEGRADED
		to EMERGENCY_STOP
		trigger transmission
		condition not ( successiveStops >= stopLimit ) /\ not ( not ( transmissionIntact ) \/ waitingMessagePresent \/ unitsReadyPresent ) /\ (predictedLevelMin <= limitM1 \/ predictedLevelMax >= limitM2)
	}
	transition t27 {
		from DEGRADED
		to EMERGENCY_STOP
		trigger transmission
		condition not ( successiveStops >= stopLimit ) /\ not ( not ( transmissionIntact ) \/ waitingMessagePresent \/ unitsReadyPresent ) /\ not ( predictedLevelMin <= limitM1 \/ predictedLevelMax >= limitM2 ) /\ levelUnitFailed /\ (steamUnitFailed \/ pumpControlUnitFailed)
	}
	transition t28 {
		from DEGRADED
		to RESCUE
		trigger transmission
		condition not ( successiveStops >= stopLimit ) /\ not ( not ( transmissionIntact ) \/ waitingMessagePresent \/ unitsReadyPresent ) /\ not ( predictedLevelMin <= limitM1 \/ predictedLevelMax >= limitM2 ) /\ levelUnitFailed /\ not ( steamUnitFailed \/ pumpControlUnitFailed )
	}
	transition t29 {
		from DEGRADED
		to NORMAL
		trigger transmission
		condition not ( successiveStops >= stopLimit ) /\ not ( not ( transmissionIntact ) \/ waitingMessagePresent \/ unitsReadyPresent ) /\ not ( predictedLevelMin <= limitM1 \/ predictedLevelMax >= limitM2 ) /\ not ( levelUnitFailed ) /\ not ( steamUnitFailed \/ pumpUnitFailed \/ pumpControlUnitFailed )
	}
	transition t30 {
		from DEGRADED
		to DEGRADED
		trigger transmission
		condition not ( successiveStops >= stopLimit ) /\ not ( not ( transmissionIntact ) \/ waitingMessagePresent \/ unitsReadyPresent ) /\ not ( predictedLevelMin <= limitM1 \/ predictedLevelMax >= limitM2 ) /\ not ( levelUnitFailed ) /\ (steamUnitFailed \/ pumpUnitFailed \/ pumpControlUnitFailed) /\ levelLow < normalN1 /\ not ( levelHigh > normalN2 )
		action send mode ; openPump ! 0 ; openPump ! 1 ; openPump ! 2 ; openPump ! 3
	}
	transition t31 {
		from DEGRADED
		to DEGRADED
		trigger transmission
		condition not ( successiveStops >= stopLimit ) /\ not ( not ( transmissionIntact ) \/ waitingMessagePresent \/ unitsReadyPresent ) /\ not ( predictedLevelMin <= limitM1 \/ predictedLevelMax >= limitM2 ) /\ not ( levelUnitFailed ) /\ (steamUnitFailed \/ pumpUnitFailed \/ pumpControlUnitFailed) /\ levelHigh > normalN2 /\ not ( levelLow < normalN1 )
		action send mode ; closePump ! 0 ; closePump ! 1 ; closePump ! 2 ; closePump ! 3
	}
	transition t32 {
		from DEGRADED
		to DEGRADED
		trigger transmission
		condition not ( successiveStops >= stopLimit ) /\ not ( not ( transmissionIntact ) \/ waitingMessagePresent \/ unitsReadyPresent ) /\ not ( predictedLevelMin <= limitM1 \/ predictedLevelMax >= limitM2 ) /\ not ( levelUnitFailed ) /\ (steamUnitFailed \/ pumpUnitFailed \/ pumpControlUnitFailed) /\ not ( levelLow < normalN1 /\ not ( levelHigh > normalN2 ) ) /\ not ( levelHigh > normalN2 /\ not ( levelLow < normalN1 ) )
	}
	transition t33 {
		from RESCUE
		to EMERGENCY_STOP
		trigger transmission
		condition successiveStops >= stopLimit
	}
	transition t34 {
		from RESCUE
		to EMERGENCY_STOP
		trigger transmission
		condition not ( successiveStops >= stopLimit ) /\ not ( transmissionIntact )
	}
	transition t35 {
		from RESCUE
		to EMERGENCY_STOP
		trigger transmission
		condition not ( successiveStops >= stopLimit ) /\ not ( not ( transmissionIntact ) \/ waitingMessagePresent \/ unitsReadyPresent ) /\ (predictedLevelMin <= limitM1 \/ predictedLevelMax >= limitM2)
	}
	transition t36 {
		from RESCUE
		to EMERGENCY_STOP
		trigger transmission
		condition not ( successiveStops >= stopLimit ) /\ not ( not ( transmissionIntact ) \/ waitingMessagePresent \/ unitsReadyPresent ) /\ not ( predictedLevelMin <= limitM1 \/ predictedLevelMax >= limitM2 ) /\ (steamUnitFailed \/ pumpControlUnitFailed)
	}
	transition t37 {
		from RESCUE
		to NORMAL
		trigger transmission
		condition not ( successiveStops >= stopLimit ) /\ not ( not ( transmissionIntact ) \/ waitingMessagePresent \/ unitsReadyPresent ) /\ not ( predictedLevelMin <= limitM1 \/ predictedLevelMax >= limitM2 ) /\ not ( steamUnitFailed \/ pumpControlUnitFailed ) /\ not ( levelUnitFailed ) /\ not ( steamUnitFailed \/ pumpUnitFailed \/ pumpControlUnitFailed )
	}
	transition t38 {
		from RESCUE
		to DEGRADED
		trigger transmission
		condition not ( successiveStops >= stopLimit ) /\ not ( not ( transmissionIntact ) \/ waitingMessagePresent \/ unitsReadyPresent ) /\ not ( predictedLevelMin <= limitM1 \/ predictedLevelMax >= limitM2 ) /\ not ( steamUnitFailed \/ pumpControlUnitFailed ) /\ not ( levelUnitFailed ) /\ (steamUnitFailed \/ pumpUnitFailed \/ pumpControlUnitFailed)
	}
	transition t39 {
		from RESCUE
		to RESCUE
		trigger transmission
		condition not ( successiveStops >= stopLimit ) /\ not ( not ( transmissionIntact ) \/ waitingMessagePresent \/ unitsReadyPresent ) /\ not ( predictedLevelMin <= limitM1 \/ predictedLevelMax >= limitM2 ) /\ not ( steamUnitFailed \/ pumpControlUnitFailed ) /\ levelUnitFailed /\ levelLow < normalN1 /\ not ( levelHigh > normalN2 )
		action send mode ; openPump ! 0 ; openPump ! 1 ; openPump ! 2 ; openPump ! 3
	}
	transition t40 {
		from RESCUE
		to RESCUE
		trigger transmission
		condition not ( successiveStops >= stopLimit ) /\ not ( not ( transmissionIntact ) \/ waitingMessagePresent \/ unitsReadyPresent ) /\ not ( predictedLevelMin <= limitM1 \/ predictedLevelMax >= limitM2 ) /\ not ( steamUnitFailed \/ pumpControlUnitFailed ) /\ levelUnitFailed /\ levelHigh > normalN2 /\ not ( levelLow < normalN1 )
		action send mode ; closePump ! 0 ; closePump ! 1 ; closePump ! 2 ; closePump ! 3
	}
	transition t41 {
		from RESCUE
		to RESCUE
		trigger transmission
		condition not ( successiveStops >= stopLimit ) /\ not ( not ( transmissionIntact ) \/ waitingMessagePresent \/ unitsReadyPresent ) /\ not ( predictedLevelMin <= limitM1 \/ predictedLevelMax >= limitM2 ) /\ not ( steamUnitFailed \/ pumpControlUnitFailed ) /\ levelUnitFailed /\ not ( levelLow < normalN1 /\ not ( levelHigh > normalN2 ) ) /\ not ( levelHigh > normalN2 /\ not ( levelLow < normalN1 ) )
	}
	transition t42 {
		from EMERGENCY_STOP
		to EMERGENCY_STOP
		trigger transmission
	}
}

controller SteamBoilerController_Ctrl {
	uses Inputs uses Outputs requires SteamBoilerController_State requires Constants requires Sensors
	sref stm_ref0 = SteamBoilerController
	connection SteamBoilerController_Ctrl on transmission to stm_ref0 on transmission
	connection stm_ref0 on mode to SteamBoilerController_Ctrl on mode
	connection stm_ref0 on programReady to SteamBoilerController_Ctrl on programReady
	connection stm_ref0 on valve to SteamBoilerController_Ctrl on valve
	connection stm_ref0 on openPump to SteamBoilerController_Ctrl on openPump
	connection stm_ref0 on closePump to SteamBoilerController_Ctrl on closePump
}

module SteamBoilerController_Module {
	robotic platform SteamBoilerController_Platform {
		provides Sensors provides Actuators provides Constants
		event transmission
		event mode
		event programReady
		event valve
		event openPump : int
		event closePump : int
	}
	cref ctrl_ref0 = SteamBoilerController_Ctrl
	connection SteamBoilerController_Platform on transmission to ctrl_ref0 on transmission
	connection ctrl_ref0 on mode to SteamBoilerController_Platform on mode
	connection ctrl_ref0 on programReady to SteamBoilerController_Platform on programReady
	connection ctrl_ref0 on valve to SteamBoilerController_Platform on valve
	connection ctrl_ref0 on openPump to SteamBoilerController_Platform on openPump
	connection ctrl_ref0 on closePump to SteamBoilerController_Platform on closePump
}

