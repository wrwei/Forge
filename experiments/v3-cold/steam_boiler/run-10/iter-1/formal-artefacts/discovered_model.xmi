      <comment xsi:type="spoon:CtJavaDoc" commentContent="Runs one cycle.">
        <commentTag documentationTypeRealname="param" commentContent="the messages received in this cycle" javadocTagValue="incoming"/>
        <commentTag documentationTypeRealname="return" commentContent="the messages transmitted in this cycle; none once the program has stopped"/>
      </comment>
      <modifier>PUBLIC</modifier>
      <body xsi:type="spoon:CtBlock">
        <statement xsi:type="spoon:CtIf">
          <condition xsi:type="spoon:CtInvocation">
            <type name="boolean"/>
            <target xsi:type="spoon:CtThisAccess" isImplicit="true">
              <type name="SteamBoilerProgram">
