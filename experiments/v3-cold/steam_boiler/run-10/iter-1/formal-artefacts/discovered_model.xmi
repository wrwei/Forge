  <spoon:CtClass name="SteamBoilerController">
    <comment xsi:type="spoon:CtJavaDoc" commentContent="The steam-boiler control program's mode logic (SB-V1, SB-V2). {@link #step} runs once per cycle,&#xA;in the analysis stage, triggered by {@link InputEvent.CycleStart} once the cycle's messages have&#xA;been received (SB-V3). Every branch sends MODE(m) for the mode it enters (SB-Beh24)."/>
    <modifier>PUBLIC</modifier>
    <modifier>FINAL</modifier>
    <typeMember xsi:type="spoon:CtField" name="currentMode">
      <modifier>PRIVATE</modifier>
      <type name="OperatingMode">
