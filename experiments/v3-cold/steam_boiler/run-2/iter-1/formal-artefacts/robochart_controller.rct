diagram SteamBoilerController

datatype FlowReading {
	pump : int
	flowing : boolean
}

datatype PumpReading {
	pump : int
	running : boolean
}

interface Inputs {
	event transmission
}

interface Outputs {
	event mode
	event programReady
	event valve
	event closePump : int
	event openPump : int
}

interface Sensors {
	var PUMPS : int
	var DT : real
	var consecutiveStops : int
	var boilerWaitingSeen : boolean
	var programReadySent : boolean
	var valveOpen : boolean
	var initializationOver : boolean
	var transmissionFailed : boolean
	var steamNonZero : boolean
	var levelValue : real
	var steamValue : real
	var pumpThroughput : real
	var knownLow : real
	var knownHigh : real
	var worstLow : real
	var worstHigh : real
	var steamOutMin : real
	var steamOutMax : real
	var estimateLow : real
	var estimateHigh : real
	var estimateKnown : boolean
	var plausibleLow : real
	var plausibleHigh : real
	var plausibleKnown : boolean
	var plausibleLowKnown : boolean
	var previousSteam : real
	var previousSteamValid : boolean
	var levelReading : real
	var steamReading : real
	var levelEstimateLow : real
	var levelEstimateHigh : real
	var plantWaiting : boolean
	var transmissionFailure : boolean
	var steamNotZero : boolean
	var levelFailure : boolean
	var readyAnnounced : boolean
	var unitsReady : boolean
	var steamFailure : boolean
	var pumpFailure : boolean
	var pumpControlFailure : boolean
	var knownLevelHigh : real
	var knownLevelLow : real
	var valveIsOpen : boolean
	var worstCaseLevelLow : real
	var worstCaseLevelHigh : real
}

interface Actuators {
}

interface SteamBoilerController_State {
	var waterLevel : real = 0
	var steamRate : real = 0
	var pumpRate : real = 0
	var levelLowBound : real = 0
	var levelHighBound : real = 0
}

interface Constants {
	const stopLimit : real = 3
	const normalN2 : real = 600
	const normalN1 : real = 400
	const limitM1 : real = 100
	const limitM2 : real = 900
}

stm SteamBoilerController {
	uses Inputs uses Outputs requires SteamBoilerController_State requires Constants requires Sensors
	state NORMAL {
		entry send mode ; waterLevel = levelReading ; steamRate = steamReading ; pumpRate = pumpThroughput ; levelLowBound = levelEstimateLow ; levelHighBound = levelEstimateHigh
	}
	state INITIALIZATION {
	}
	state EMERGENCY_STOP {
		entry send mode ; waterLevel = levelReading ; steamRate = steamReading ; pumpRate = pumpThroughput ; levelLowBound = levelEstimateLow ; levelHighBound = levelEstimateHigh
	}
	state DEGRADED {
		entry send mode ; waterLevel = levelReading ; steamRate = steamReading ; pumpRate = pumpThroughput ; levelLowBound = levelEstimateLow ; levelHighBound = levelEstimateHigh
	}
	state RESCUE {
		entry send mode ; waterLevel = levelReading ; steamRate = steamReading ; pumpRate = pumpThroughput ; levelLowBound = levelEstimateLow ; levelHighBound = levelEstimateHigh
	}
	initial i0
	transition t_init {
		from i0
		to INITIALIZATION
	}
	transition t1 {
		from INITIALIZATION
		to EMERGENCY_STOP
		trigger transmission
		condition consecutiveStops >= stopLimit
	}
	transition t2 {
		from INITIALIZATION
		to EMERGENCY_STOP
		trigger transmission
		condition not ( consecutiveStops >= stopLimit ) /\ plantWaiting /\ (transmissionFailure \/ steamNotZero \/ levelFailure)
	}
	transition t3 {
		from INITIALIZATION
		to INITIALIZATION
		trigger transmission
		condition not ( consecutiveStops >= stopLimit ) /\ not ( plantWaiting /\ (transmissionFailure \/ steamNotZero \/ levelFailure) ) /\ not ( plantWaiting )
		action send mode
	}
	transition t4 {
		from INITIALIZATION
		to NORMAL
		trigger transmission
		condition not ( consecutiveStops >= stopLimit ) /\ not ( plantWaiting /\ (transmissionFailure \/ steamNotZero \/ levelFailure) ) /\ plantWaiting /\ readyAnnounced /\ unitsReady /\ not ( steamFailure \/ pumpFailure \/ pumpControlFailure )
	}
	transition t5 {
		from INITIALIZATION
		to DEGRADED
		trigger transmission
		condition not ( consecutiveStops >= stopLimit ) /\ not ( plantWaiting /\ (transmissionFailure \/ steamNotZero \/ levelFailure) ) /\ plantWaiting /\ readyAnnounced /\ unitsReady /\ (steamFailure \/ pumpFailure \/ pumpControlFailure)
	}
	transition t6 {
		from INITIALIZATION
		to INITIALIZATION
		trigger transmission
		condition not ( consecutiveStops >= stopLimit ) /\ not ( plantWaiting /\ (transmissionFailure \/ steamNotZero \/ levelFailure) ) /\ plantWaiting /\ readyAnnounced /\ not ( unitsReady )
		action send mode ; send programReady ; waterLevel = levelReading ; steamRate = steamReading ; pumpRate = pumpThroughput ; levelLowBound = levelEstimateLow ; levelHighBound = levelEstimateHigh
	}
	transition t7 {
		from INITIALIZATION
		to INITIALIZATION
		trigger transmission
		condition not ( consecutiveStops >= stopLimit ) /\ not ( plantWaiting /\ (transmissionFailure \/ steamNotZero \/ levelFailure) ) /\ plantWaiting /\ not ( readyAnnounced ) /\ knownLevelHigh > normalN2 /\ not ( knownLevelLow < normalN1 ) /\ not ( valveIsOpen )
		action send mode ; send valve ; closePump ! 1 ; closePump ! 2 ; closePump ! 3 ; closePump ! 4 ; waterLevel = levelReading ; steamRate = steamReading ; pumpRate = pumpThroughput ; levelLowBound = levelEstimateLow ; levelHighBound = levelEstimateHigh
	}
	transition t8 {
		from INITIALIZATION
		to INITIALIZATION
		trigger transmission
		condition not ( consecutiveStops >= stopLimit ) /\ not ( plantWaiting /\ (transmissionFailure \/ steamNotZero \/ levelFailure) ) /\ plantWaiting /\ not ( readyAnnounced ) /\ knownLevelHigh > normalN2 /\ not ( knownLevelLow < normalN1 ) /\ valveIsOpen
		action send mode ; closePump ! 1 ; closePump ! 2 ; closePump ! 3 ; closePump ! 4 ; waterLevel = levelReading ; steamRate = steamReading ; pumpRate = pumpThroughput ; levelLowBound = levelEstimateLow ; levelHighBound = levelEstimateHigh
	}
	transition t9 {
		from INITIALIZATION
		to INITIALIZATION
		trigger transmission
		condition not ( consecutiveStops >= stopLimit ) /\ not ( plantWaiting /\ (transmissionFailure \/ steamNotZero \/ levelFailure) ) /\ plantWaiting /\ not ( readyAnnounced ) /\ knownLevelLow < normalN1 /\ valveIsOpen
		action send mode ; send valve ; openPump ! 1 ; openPump ! 2 ; openPump ! 3 ; openPump ! 4 ; waterLevel = levelReading ; steamRate = steamReading ; pumpRate = pumpThroughput ; levelLowBound = levelEstimateLow ; levelHighBound = levelEstimateHigh
	}
	transition t10 {
		from INITIALIZATION
		to INITIALIZATION
		trigger transmission
		condition not ( consecutiveStops >= stopLimit ) /\ not ( plantWaiting /\ (transmissionFailure \/ steamNotZero \/ levelFailure) ) /\ plantWaiting /\ not ( readyAnnounced ) /\ knownLevelLow < normalN1 /\ not ( valveIsOpen )
		action send mode ; openPump ! 1 ; openPump ! 2 ; openPump ! 3 ; openPump ! 4 ; waterLevel = levelReading ; steamRate = steamReading ; pumpRate = pumpThroughput ; levelLowBound = levelEstimateLow ; levelHighBound = levelEstimateHigh
	}
	transition t11 {
		from INITIALIZATION
		to INITIALIZATION
		trigger transmission
		condition not ( consecutiveStops >= stopLimit ) /\ not ( plantWaiting /\ (transmissionFailure \/ steamNotZero \/ levelFailure) ) /\ plantWaiting /\ not ( readyAnnounced ) /\ not ( knownLevelLow < normalN1 ) /\ not ( knownLevelHigh > normalN2 /\ not ( knownLevelLow < normalN1 ) ) /\ valveIsOpen
		action send mode ; send valve ; closePump ! 1 ; closePump ! 2 ; closePump ! 3 ; closePump ! 4 ; send programReady ; waterLevel = levelReading ; steamRate = steamReading ; pumpRate = pumpThroughput ; levelLowBound = levelEstimateLow ; levelHighBound = levelEstimateHigh
	}
	transition t12 {
		from INITIALIZATION
		to INITIALIZATION
		trigger transmission
		condition not ( consecutiveStops >= stopLimit ) /\ not ( plantWaiting /\ (transmissionFailure \/ steamNotZero \/ levelFailure) ) /\ plantWaiting /\ not ( readyAnnounced ) /\ not ( knownLevelLow < normalN1 ) /\ not ( knownLevelHigh > normalN2 /\ not ( knownLevelLow < normalN1 ) ) /\ not ( valveIsOpen )
		action send mode ; closePump ! 1 ; closePump ! 2 ; closePump ! 3 ; closePump ! 4 ; send programReady ; waterLevel = levelReading ; steamRate = steamReading ; pumpRate = pumpThroughput ; levelLowBound = levelEstimateLow ; levelHighBound = levelEstimateHigh
	}
	transition t13 {
		from NORMAL
		to EMERGENCY_STOP
		trigger transmission
		condition consecutiveStops >= stopLimit
	}
	transition t14 {
		from NORMAL
		to EMERGENCY_STOP
		trigger transmission
		condition not ( consecutiveStops >= stopLimit ) /\ (transmissionFailure \/ worstCaseLevelLow <= limitM1 \/ worstCaseLevelHigh >= limitM2 \/ levelFailure /\ (steamFailure \/ pumpControlFailure))
	}
	transition t15 {
		from NORMAL
		to RESCUE
		trigger transmission
		condition not ( consecutiveStops >= stopLimit ) /\ not ( transmissionFailure \/ worstCaseLevelLow <= limitM1 \/ worstCaseLevelHigh >= limitM2 \/ levelFailure /\ (steamFailure \/ pumpControlFailure) ) /\ levelFailure
	}
	transition t16 {
		from NORMAL
		to DEGRADED
		trigger transmission
		condition not ( consecutiveStops >= stopLimit ) /\ not ( transmissionFailure \/ worstCaseLevelLow <= limitM1 \/ worstCaseLevelHigh >= limitM2 \/ levelFailure /\ (steamFailure \/ pumpControlFailure) ) /\ not ( levelFailure ) /\ (steamFailure \/ pumpFailure \/ pumpControlFailure)
	}
	transition t17 {
		from NORMAL
		to NORMAL
		trigger transmission
		condition not ( consecutiveStops >= stopLimit ) /\ not ( transmissionFailure \/ worstCaseLevelLow <= limitM1 \/ worstCaseLevelHigh >= limitM2 \/ levelFailure /\ (steamFailure \/ pumpControlFailure) ) /\ not ( levelFailure ) /\ not ( steamFailure \/ pumpFailure \/ pumpControlFailure ) /\ knownLevelLow < normalN1
		action send mode ; openPump ! 1 ; openPump ! 2 ; openPump ! 3 ; openPump ! 4 ; waterLevel = levelReading ; steamRate = steamReading ; pumpRate = pumpThroughput ; levelLowBound = levelEstimateLow ; levelHighBound = levelEstimateHigh
	}
	transition t18 {
		from NORMAL
		to NORMAL
		trigger transmission
		condition not ( consecutiveStops >= stopLimit ) /\ not ( transmissionFailure \/ worstCaseLevelLow <= limitM1 \/ worstCaseLevelHigh >= limitM2 \/ levelFailure /\ (steamFailure \/ pumpControlFailure) ) /\ not ( levelFailure ) /\ not ( steamFailure \/ pumpFailure \/ pumpControlFailure ) /\ knownLevelHigh > normalN2 /\ not ( knownLevelLow < normalN1 )
		action send mode ; closePump ! 1 ; closePump ! 2 ; closePump ! 3 ; closePump ! 4 ; waterLevel = levelReading ; steamRate = steamReading ; pumpRate = pumpThroughput ; levelLowBound = levelEstimateLow ; levelHighBound = levelEstimateHigh
	}
	transition t19 {
		from NORMAL
		to NORMAL
		trigger transmission
		condition not ( consecutiveStops >= stopLimit ) /\ not ( transmissionFailure \/ worstCaseLevelLow <= limitM1 \/ worstCaseLevelHigh >= limitM2 \/ levelFailure /\ (steamFailure \/ pumpControlFailure) ) /\ not ( levelFailure ) /\ not ( steamFailure \/ pumpFailure \/ pumpControlFailure ) /\ not ( knownLevelLow < normalN1 ) /\ not ( knownLevelHigh > normalN2 /\ not ( knownLevelLow < normalN1 ) )
	}
	transition t20 {
		from DEGRADED
		to EMERGENCY_STOP
		trigger transmission
		condition consecutiveStops >= stopLimit
	}
	transition t21 {
		from DEGRADED
		to EMERGENCY_STOP
		trigger transmission
		condition not ( consecutiveStops >= stopLimit ) /\ (transmissionFailure \/ worstCaseLevelLow <= limitM1 \/ worstCaseLevelHigh >= limitM2 \/ levelFailure /\ (steamFailure \/ pumpControlFailure))
	}
	transition t22 {
		from DEGRADED
		to RESCUE
		trigger transmission
		condition not ( consecutiveStops >= stopLimit ) /\ not ( transmissionFailure \/ worstCaseLevelLow <= limitM1 \/ worstCaseLevelHigh >= limitM2 \/ levelFailure /\ (steamFailure \/ pumpControlFailure) ) /\ levelFailure
	}
	transition t23 {
		from DEGRADED
		to NORMAL
		trigger transmission
		condition not ( consecutiveStops >= stopLimit ) /\ not ( transmissionFailure \/ worstCaseLevelLow <= limitM1 \/ worstCaseLevelHigh >= limitM2 \/ levelFailure /\ (steamFailure \/ pumpControlFailure) ) /\ not ( levelFailure ) /\ not ( steamFailure \/ pumpFailure \/ pumpControlFailure )
	}
	transition t24 {
		from DEGRADED
		to DEGRADED
		trigger transmission
		condition not ( consecutiveStops >= stopLimit ) /\ not ( transmissionFailure \/ worstCaseLevelLow <= limitM1 \/ worstCaseLevelHigh >= limitM2 \/ levelFailure /\ (steamFailure \/ pumpControlFailure) ) /\ not ( levelFailure ) /\ (steamFailure \/ pumpFailure \/ pumpControlFailure) /\ knownLevelLow < normalN1
		action send mode ; openPump ! 1 ; openPump ! 2 ; openPump ! 3 ; openPump ! 4 ; waterLevel = levelReading ; steamRate = steamReading ; pumpRate = pumpThroughput ; levelLowBound = levelEstimateLow ; levelHighBound = levelEstimateHigh
	}
	transition t25 {
		from DEGRADED
		to DEGRADED
		trigger transmission
		condition not ( consecutiveStops >= stopLimit ) /\ not ( transmissionFailure \/ worstCaseLevelLow <= limitM1 \/ worstCaseLevelHigh >= limitM2 \/ levelFailure /\ (steamFailure \/ pumpControlFailure) ) /\ not ( levelFailure ) /\ (steamFailure \/ pumpFailure \/ pumpControlFailure) /\ knownLevelHigh > normalN2 /\ not ( knownLevelLow < normalN1 )
		action send mode ; closePump ! 1 ; closePump ! 2 ; closePump ! 3 ; closePump ! 4 ; waterLevel = levelReading ; steamRate = steamReading ; pumpRate = pumpThroughput ; levelLowBound = levelEstimateLow ; levelHighBound = levelEstimateHigh
	}
	transition t26 {
		from DEGRADED
		to DEGRADED
		trigger transmission
		condition not ( consecutiveStops >= stopLimit ) /\ not ( transmissionFailure \/ worstCaseLevelLow <= limitM1 \/ worstCaseLevelHigh >= limitM2 \/ levelFailure /\ (steamFailure \/ pumpControlFailure) ) /\ not ( levelFailure ) /\ (steamFailure \/ pumpFailure \/ pumpControlFailure) /\ not ( knownLevelLow < normalN1 ) /\ not ( knownLevelHigh > normalN2 /\ not ( knownLevelLow < normalN1 ) )
	}
	transition t27 {
		from RESCUE
		to EMERGENCY_STOP
		trigger transmission
		condition consecutiveStops >= stopLimit
	}
	transition t28 {
		from RESCUE
		to EMERGENCY_STOP
		trigger transmission
		condition not ( consecutiveStops >= stopLimit ) /\ (transmissionFailure \/ worstCaseLevelLow <= limitM1 \/ worstCaseLevelHigh >= limitM2 \/ steamFailure \/ pumpControlFailure)
	}
	transition t29 {
		from RESCUE
		to NORMAL
		trigger transmission
		condition not ( consecutiveStops >= stopLimit ) /\ not ( transmissionFailure \/ worstCaseLevelLow <= limitM1 \/ worstCaseLevelHigh >= limitM2 \/ steamFailure \/ pumpControlFailure ) /\ not ( levelFailure ) /\ not ( steamFailure \/ pumpFailure \/ pumpControlFailure )
	}
	transition t30 {
		from RESCUE
		to DEGRADED
		trigger transmission
		condition not ( consecutiveStops >= stopLimit ) /\ not ( transmissionFailure \/ worstCaseLevelLow <= limitM1 \/ worstCaseLevelHigh >= limitM2 \/ steamFailure \/ pumpControlFailure ) /\ not ( levelFailure ) /\ (steamFailure \/ pumpFailure \/ pumpControlFailure)
	}
	transition t31 {
		from RESCUE
		to RESCUE
		trigger transmission
		condition not ( consecutiveStops >= stopLimit ) /\ not ( transmissionFailure \/ worstCaseLevelLow <= limitM1 \/ worstCaseLevelHigh >= limitM2 \/ steamFailure \/ pumpControlFailure ) /\ levelFailure /\ knownLevelLow < normalN1
		action send mode ; openPump ! 1 ; openPump ! 2 ; openPump ! 3 ; openPump ! 4 ; waterLevel = levelReading ; steamRate = steamReading ; pumpRate = pumpThroughput ; levelLowBound = levelEstimateLow ; levelHighBound = levelEstimateHigh
	}
	transition t32 {
		from RESCUE
		to RESCUE
		trigger transmission
		condition not ( consecutiveStops >= stopLimit ) /\ not ( transmissionFailure \/ worstCaseLevelLow <= limitM1 \/ worstCaseLevelHigh >= limitM2 \/ steamFailure \/ pumpControlFailure ) /\ levelFailure /\ knownLevelHigh > normalN2 /\ not ( knownLevelLow < normalN1 )
		action send mode ; closePump ! 1 ; closePump ! 2 ; closePump ! 3 ; closePump ! 4 ; waterLevel = levelReading ; steamRate = steamReading ; pumpRate = pumpThroughput ; levelLowBound = levelEstimateLow ; levelHighBound = levelEstimateHigh
	}
	transition t33 {
		from RESCUE
		to RESCUE
		trigger transmission
		condition not ( consecutiveStops >= stopLimit ) /\ not ( transmissionFailure \/ worstCaseLevelLow <= limitM1 \/ worstCaseLevelHigh >= limitM2 \/ steamFailure \/ pumpControlFailure ) /\ levelFailure /\ not ( knownLevelLow < normalN1 ) /\ not ( knownLevelHigh > normalN2 /\ not ( knownLevelLow < normalN1 ) )
	}
}

controller SteamBoilerController_Ctrl {
	uses Inputs uses Outputs requires SteamBoilerController_State requires Constants requires Sensors
	sref stm_ref0 = SteamBoilerController
	connection SteamBoilerController_Ctrl on transmission to stm_ref0 on transmission
	connection stm_ref0 on mode to SteamBoilerController_Ctrl on mode
	connection stm_ref0 on programReady to SteamBoilerController_Ctrl on programReady
	connection stm_ref0 on valve to SteamBoilerController_Ctrl on valve
	connection stm_ref0 on closePump to SteamBoilerController_Ctrl on closePump
	connection stm_ref0 on openPump to SteamBoilerController_Ctrl on openPump
}

module SteamBoilerController_Module {
	robotic platform SteamBoilerController_Platform {
		provides Sensors provides Actuators provides Constants
		event transmission
		event mode
		event programReady
		event valve
		event closePump : int
		event openPump : int
	}
	cref ctrl_ref0 = SteamBoilerController_Ctrl
	connection SteamBoilerController_Platform on transmission to ctrl_ref0 on transmission
	connection ctrl_ref0 on mode to SteamBoilerController_Platform on mode
	connection ctrl_ref0 on programReady to SteamBoilerController_Platform on programReady
	connection ctrl_ref0 on valve to SteamBoilerController_Platform on valve
	connection ctrl_ref0 on closePump to SteamBoilerController_Platform on closePump
	connection ctrl_ref0 on openPump to SteamBoilerController_Platform on openPump
}

