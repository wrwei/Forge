				-- Nodes --
				-- declaring all nodes
				
				----------------------------------------------------------------------
				-- State: NORMAL
				module NORMAL
				
				enterSS = {}
				
				enteredSS = {}
				
				exports
				
					--  Declarations
					
					channel enter, entered, interrupt
					channel enteredL, enteredR
					
									
					
					--channel increment__
					
					
					--	Nodes
					-- declaring all nodes
					
					
					Timed(OneStep) {
						--	Rule: behaviours(Node)
						--  Note that FDR has problems with efficiently compiling the process below
						-- 	if using a different recursion pattern.
						D__(id__,
								    const_SteamBoilerController_stopLimit,
								    const_SteamBoilerController_normalN2,
								    const_SteamBoilerController_normalN1,
								    const_SteamBoilerController_limitM1,
								    const_SteamBoilerController_limitM2) = 
						dbisim(let
							-- IMPLEMENTATION NOTE: 
							-- The following should be defined as: Inactive = share__choice(Activation [] Termination),
							-- however FDR struggles with that form in certain cases. So we use the exception operator
							-- instead to 'terminate'.
							
							Inactive 	= share__choice(enter -> SKIP [] terminate -> SKIP) ; Active
							
							Termination = terminate -> SKIP
							
							Active 		= true&(share__choice(mode.out -> SKIP));share__choice(share__choice(get_levelReading?levelReading -> true & (share__choice(set_waterLevel!levelReading -> SKIP))));share__choice(share__choice(get_steamReading?steamReading -> true & (share__choice(set_steamRate!steamReading -> SKIP))));share__choice(share__choice(get_pumpThroughput?pumpThroughput -> true & (share__choice(set_pumpRate!pumpThroughput -> SKIP))));share__choice(share__choice(get_levelEstimateLow?levelEstimateLow -> true & (share__choice(set_levelLowBound!levelEstimateLow -> SKIP))));share__choice(share__choice(get_levelEstimateHigh?levelEstimateHigh -> true & (share__choice(set_levelHighBound!levelEstimateHigh -> SKIP)))) ; 
									 	  Behaviour ; 
									 	  share__choice(exit -> SKIP) ; SKIP ; 
									 	  share__choice(exited -> SKIP) ; Inactive
						
							Behaviour 	= entered -> During
							During 		= ((SKIP ; SStop) /\ interrupt -> SKIP)
						within
							Inactive [| {terminate} |> SKIP)
							
						VS_O__(id__,
								    const_SteamBoilerController_stopLimit,
								    const_SteamBoilerController_normalN2,
								    const_SteamBoilerController_normalN1,
								    const_SteamBoilerController_limitM1,
								    const_SteamBoilerController_limitM2) = 
						dbisim(let
