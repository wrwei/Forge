        else if (event == TransmissionReceived && (!(((consecutiveStopCount() >= 3) || (transmissionFailure() || steamBoilerWaitingPresent() || physicalUnitsReadyPresent()) || ((((levelEstimate() > 600.0) || (worstCaseLevelHighPumpsKept() > 840.0)) && ((worstCaseLevelLowPumpsClosed() < 125.0) || (worstCaseLevelHighPumpsClosed() > 840.0))) || (!((levelEstimate() > 600.0) || (worstCaseLevelHighPumpsKept() > 840.0)) && (worstCaseLevelLowPumpsKept() < 125.0)))) || steamDeviceOutOfOrder() || pumpControllerOutOfOrder()) && levelDeviceOutOfOrder()) && (!((levelEstimate() > 600.0) || (worstCaseLevelHighPumpsKept() > 840.0)) && !(levelEstimate() < 400.0))) {
            mode := RESCUE;
            // action: Mode(RESCUE)
        }
    }

    method transitionFromEMERGENCY_STOP(event: InputEvent)
        requires mode == EMERGENCY_STOP
        requires Valid()
        modifies this
        ensures Valid()
    {
    }

    method step(event: InputEvent)
        requires Valid()
        modifies this
        ensures Valid()
    {
        if (mode == INITIALIZATION) {
            transitionFromINITIALIZATION(event);
        }
        else if (mode == NORMAL) {
            transitionFromNORMAL(event);
        }
        else if (mode == DEGRADED) {
            transitionFromDEGRADED(event);
        }
        else if (mode == RESCUE) {
            transitionFromRESCUE(event);
        }
        else if (mode == EMERGENCY_STOP) {
            transitionFromEMERGENCY_STOP(event);
        }
    }
}
