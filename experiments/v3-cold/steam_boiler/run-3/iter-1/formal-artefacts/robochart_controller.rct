		trigger transmissionReceived
		condition not ( consecutiveStopCount >= stopTransmissionsForEmergency ) /\ not ( transmissionFailed \/ unitsReadyReceived /\ not ( readyAnnounced ) ) /\ (plantWaiting \/ boilerWaitingReceived) /\ not ( steamReading != 0 ) /\ not ( levelDeviceFailed ) /\ not ( readyAnnounced ) /\ not ( levelReading > normalMaxN2 ) /\ not ( levelReading < normalMinN1 ) /\ not ( evacuationValve == VALVE_OPEN )
		action send mode ; closePump ! 1 ; send programReady ; readyAnnounced = true ; plantWaiting = true
	}
	transition t15 {
		from NORMAL
		to EMERGENCY_STOP
		trigger transmissionReceived
		condition consecutiveStopCount >= stopTransmissionsForEmergency
	}
	transition t16 {
		from NORMAL
		to EMERGENCY_STOP
		trigger transmissionReceived
		condition not ( consecutiveStopCount >= stopTransmissionsForEmergency ) /\ (transmissionFailed \/ boilerWaitingReceived \/ unitsReadyReceived)
	}
	transition t17 {
		from NORMAL
		to EMERGENCY_STOP
		trigger transmissionReceived
		condition not ( consecutiveStopCount >= stopTransmissionsForEmergency ) /\ not ( transmissionFailed \/ boilerWaitingReceived \/ unitsReadyReceived ) /\ ((levelEstimate > normalMaxN2 \/ worstCaseLevelHighPumpsKept > limitMaxM2) /\ (worstCaseLevelLowPumpsClosed < limitMinM1 \/ worstCaseLevelHighPumpsClosed > limitMaxM2) \/ not ( levelEstimate > normalMaxN2 \/ worstCaseLevelHighPumpsKept > limitMaxM2 ) /\ worstCaseLevelLowPumpsKept < limitMinM1)
	}
