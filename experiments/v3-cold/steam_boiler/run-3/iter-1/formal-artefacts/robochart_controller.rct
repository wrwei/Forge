		condition not ( consecutiveStopCount >= stopTransmissionsForEmergency \/ transmissionFailed \/ boilerWaitingReceived \/ unitsReadyReceived \/ (levelEstimate > normalMaxN2 \/ worstCaseLevelHighPumpsKept > limitMaxM2) /\ (worstCaseLevelLowPumpsClosed < limitMinM1 \/ worstCaseLevelHighPumpsClosed > limitMaxM2) \/ not ( levelEstimate > normalMaxN2 \/ worstCaseLevelHighPumpsKept > limitMaxM2 ) /\ worstCaseLevelLowPumpsKept < limitMinM1 ) /\ levelDeviceFailed /\ not ( levelEstimate > normalMaxN2 \/ worstCaseLevelHighPumpsKept > limitMaxM2 ) /\ levelEstimate < normalMinN1
