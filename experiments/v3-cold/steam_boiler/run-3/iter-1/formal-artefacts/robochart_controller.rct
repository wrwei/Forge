diagram SteamBoilerController

enumeration FlowObservation { WATER_NOT_FLOWING WATER_FLOWING }
enumeration PumpPosition { PUMP_OFF PUMP_ON }
enumeration ValvePosition { VALVE_CLOSED VALVE_OPEN }

datatype PumpControlReport {
	controlledPump : int
	observedFlow : FlowObservation
}

datatype PumpStateReport {
	pumpNumber : int
	reportedPosition : PumpPosition
}

interface Inputs {
	event transmissionReceived
}

interface Outputs {
	event mode
	event programReady
	event valve
	event closePump : int
	event openPump : int
}

interface Sensors {
	var PUMPS : int
	var CYCLE : real
	var PUMP_VOLUME_PER_CYCLE : real
	var waterLevel : real
	var steamRate : real
	var pumpThroughput : real
	var levelLowerBound : real
	var levelUpperBound : real
	var levelOutOfOrder : boolean
	var steamOutOfOrder : boolean
	var levelFailureUnacknowledged : boolean
	var steamFailureUnacknowledged : boolean
	var levelRepairToAcknowledge : boolean
	var steamRepairToAcknowledge : boolean
	var consecutiveStops : int
	var transmissionFailed : boolean
	var monitoring : boolean
	var historyKnown : boolean
	var previousSteam : real
	var previousSteamTrusted : boolean
	var valveOpen : boolean
	var consecutiveStopCount : int
	var unitsReadyReceived : boolean
	var boilerWaitingReceived : boolean
	var steamReading : real
	var levelDeviceFailed : boolean
	var otherUnitFailed : boolean
	var levelReading : real
	var levelEstimate : real
	var worstCaseLevelHighPumpsKept : real
	var worstCaseLevelLowPumpsClosed : real
	var worstCaseLevelHighPumpsClosed : real
	var worstCaseLevelLowPumpsKept : real
	var steamDeviceFailed : boolean
	var pumpControllerFailed : boolean
}

interface Actuators {
}

interface SteamBoilerController_State {
	var plantWaiting : boolean = false
	var evacuationValve : ValvePosition
	var readyAnnounced : boolean = false
}

interface Constants {
	const stopTransmissionsForEmergency : real = 3
	const normalMaxN2 : real = 600
	const normalMinN1 : real = 400
	const limitMaxM2 : real = 840
	const limitMinM1 : real = 125
}

stm SteamBoilerController {
	uses Inputs uses Outputs requires SteamBoilerController_State requires Constants requires Sensors
	state RESCUE {
	}
	state DEGRADED {
	}
	state NORMAL {
	}
	state INITIALIZATION {
	}
	state EMERGENCY_STOP {
		entry send mode
	}
	initial i0
	transition t_init {
		from i0
		to INITIALIZATION
	}
	transition t1 {
		from INITIALIZATION
		to EMERGENCY_STOP
		trigger transmissionReceived
		condition consecutiveStopCount >= stopTransmissionsForEmergency
	}
	transition t2 {
		from INITIALIZATION
		to EMERGENCY_STOP
		trigger transmissionReceived
		condition not ( consecutiveStopCount >= stopTransmissionsForEmergency ) /\ (transmissionFailed \/ unitsReadyReceived /\ not ( readyAnnounced ))
	}
	transition t3 {
		from INITIALIZATION
		to INITIALIZATION
		trigger transmissionReceived
		condition not ( consecutiveStopCount >= stopTransmissionsForEmergency ) /\ not ( transmissionFailed \/ unitsReadyReceived /\ not ( readyAnnounced ) ) /\ not ( plantWaiting \/ boilerWaitingReceived )
		action send mode
	}
	transition t4 {
		from INITIALIZATION
		to EMERGENCY_STOP
		trigger transmissionReceived
		condition not ( consecutiveStopCount >= stopTransmissionsForEmergency ) /\ not ( transmissionFailed \/ unitsReadyReceived /\ not ( readyAnnounced ) ) /\ (plantWaiting \/ boilerWaitingReceived) /\ steamReading != 0
	}
	transition t5 {
		from INITIALIZATION
		to EMERGENCY_STOP
		trigger transmissionReceived
		condition not ( consecutiveStopCount >= stopTransmissionsForEmergency ) /\ not ( transmissionFailed \/ unitsReadyReceived /\ not ( readyAnnounced ) ) /\ (plantWaiting \/ boilerWaitingReceived) /\ not ( steamReading != 0 ) /\ levelDeviceFailed
	}
	transition t6 {
		from INITIALIZATION
		to NORMAL
		trigger transmissionReceived
		condition not ( consecutiveStopCount >= stopTransmissionsForEmergency ) /\ not ( transmissionFailed \/ unitsReadyReceived /\ not ( readyAnnounced ) ) /\ (plantWaiting \/ boilerWaitingReceived) /\ not ( steamReading != 0 ) /\ not ( levelDeviceFailed ) /\ readyAnnounced /\ unitsReadyReceived /\ not ( otherUnitFailed )
		action send mode
	}
	transition t7 {
		from INITIALIZATION
		to DEGRADED
		trigger transmissionReceived
		condition not ( consecutiveStopCount >= stopTransmissionsForEmergency ) /\ not ( transmissionFailed \/ unitsReadyReceived /\ not ( readyAnnounced ) ) /\ (plantWaiting \/ boilerWaitingReceived) /\ not ( steamReading != 0 ) /\ not ( levelDeviceFailed ) /\ readyAnnounced /\ unitsReadyReceived /\ otherUnitFailed
		action send mode
	}
	transition t8 {
		from INITIALIZATION
		to INITIALIZATION
		trigger transmissionReceived
		condition not ( consecutiveStopCount >= stopTransmissionsForEmergency ) /\ not ( transmissionFailed \/ unitsReadyReceived /\ not ( readyAnnounced ) ) /\ (plantWaiting \/ boilerWaitingReceived) /\ not ( steamReading != 0 ) /\ not ( levelDeviceFailed ) /\ readyAnnounced /\ not ( unitsReadyReceived )
		action send mode ; send programReady
	}
	transition t9 {
		from INITIALIZATION
		to INITIALIZATION
		trigger transmissionReceived
		condition not ( consecutiveStopCount >= stopTransmissionsForEmergency ) /\ not ( transmissionFailed \/ unitsReadyReceived /\ not ( readyAnnounced ) ) /\ (plantWaiting \/ boilerWaitingReceived) /\ not ( steamReading != 0 ) /\ not ( levelDeviceFailed ) /\ not ( readyAnnounced ) /\ levelReading > normalMaxN2 /\ not ( evacuationValve == VALVE_OPEN )
		action send mode ; send valve ; closePump ! 1 ; evacuationValve = VALVE_OPEN ; plantWaiting = true
	}
	transition t10 {
		from INITIALIZATION
		to INITIALIZATION
		trigger transmissionReceived
		condition not ( consecutiveStopCount >= stopTransmissionsForEmergency ) /\ not ( transmissionFailed \/ unitsReadyReceived /\ not ( readyAnnounced ) ) /\ (plantWaiting \/ boilerWaitingReceived) /\ not ( steamReading != 0 ) /\ not ( levelDeviceFailed ) /\ not ( readyAnnounced ) /\ levelReading > normalMaxN2 /\ evacuationValve == VALVE_OPEN
		action send mode ; plantWaiting = true
	}
	transition t11 {
		from INITIALIZATION
		to INITIALIZATION
		trigger transmissionReceived
		condition not ( consecutiveStopCount >= stopTransmissionsForEmergency ) /\ not ( transmissionFailed \/ unitsReadyReceived /\ not ( readyAnnounced ) ) /\ (plantWaiting \/ boilerWaitingReceived) /\ not ( steamReading != 0 ) /\ not ( levelDeviceFailed ) /\ not ( readyAnnounced ) /\ not ( levelReading > normalMaxN2 ) /\ levelReading < normalMinN1 /\ evacuationValve == VALVE_OPEN
		action send mode ; send valve ; openPump ! 1 ; evacuationValve = VALVE_CLOSED ; plantWaiting = true
	}
	transition t12 {
		from INITIALIZATION
		to INITIALIZATION
		trigger transmissionReceived
		condition not ( consecutiveStopCount >= stopTransmissionsForEmergency ) /\ not ( transmissionFailed \/ unitsReadyReceived /\ not ( readyAnnounced ) ) /\ (plantWaiting \/ boilerWaitingReceived) /\ not ( steamReading != 0 ) /\ not ( levelDeviceFailed ) /\ not ( readyAnnounced ) /\ not ( levelReading > normalMaxN2 ) /\ levelReading < normalMinN1 /\ not ( evacuationValve == VALVE_OPEN )
		action send mode ; openPump ! 1 ; plantWaiting = true
	}
	transition t13 {
		from INITIALIZATION
		to INITIALIZATION
		trigger transmissionReceived
		condition not ( consecutiveStopCount >= stopTransmissionsForEmergency ) /\ not ( transmissionFailed \/ unitsReadyReceived /\ not ( readyAnnounced ) ) /\ (plantWaiting \/ boilerWaitingReceived) /\ not ( steamReading != 0 ) /\ not ( levelDeviceFailed ) /\ not ( readyAnnounced ) /\ not ( levelReading > normalMaxN2 ) /\ not ( levelReading < normalMinN1 ) /\ evacuationValve == VALVE_OPEN
		action send mode ; send valve ; closePump ! 1 ; send programReady ; evacuationValve = VALVE_CLOSED ; readyAnnounced = true ; plantWaiting = true
	}
	transition t14 {
