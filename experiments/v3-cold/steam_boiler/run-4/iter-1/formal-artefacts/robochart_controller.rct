	}
	transition t19 {
		from NORMAL
		to NORMAL
		trigger transmission
		condition not ( successiveStopCount >= stopLimit \/ transmissionFailed \/ boilerWaitingPresent \/ unitsReadyNow \/ not ( levelUnitFailed ) /\ (not ( steamUnitFailed ) /\ levelValue - cycleSeconds * steamValue - steamRiseMargin <= limitM1 \/ steamUnitFailed /\ levelValue - steamMaxOutflow <= limitM1 \/ not ( steamUnitFailed ) /\ levelValue + pumpsMaxInflow - cycleSeconds * steamValue + steamFallMargin >= limitM2 \/ steamUnitFailed /\ levelValue + pumpsMaxInflow >= limitM2) \/ levelUnitFailed /\ (steamUnitFailed \/ pumpControlUnitFailed) \/ levelUnitFailed /\ (levelLow + cycleSeconds * pumpThroughput - cycleSeconds * steamReading - steamRiseMargin - cycleSeconds * steamValue - steamRiseMargin <= limitM1 \/ levelHigh + cycleSeconds * openThroughput - cycleSeconds * steamReading + steamFallMargin + pumpsMaxInflow - cycleSeconds * steamValue + steamFallMargin >= limitM2) ) /\ not ( levelUnitFailed ) /\ not ( steamUnitFailed \/ pumpUnitFailed \/ pumpControlUnitFailed ) /\ levelValue < normalN1
		action send modeAnnouncement ; openPump ! 1 ; openPump ! 2 ; openPump ! 3 ; openPump ! 4 ; levelReading = levelValue ; steamReading = steamValue ; levelLow = levelValue ; levelHigh = levelValue ; pumpThroughput = flowingThroughput
	}
	transition t20 {
		from NORMAL
		to NORMAL
		trigger transmission
		condition not ( successiveStopCount >= stopLimit \/ transmissionFailed \/ boilerWaitingPresent \/ unitsReadyNow \/ not ( levelUnitFailed ) /\ (not ( steamUnitFailed ) /\ levelValue - cycleSeconds * steamValue - steamRiseMargin <= limitM1 \/ steamUnitFailed /\ levelValue - steamMaxOutflow <= limitM1 \/ not ( steamUnitFailed ) /\ levelValue + pumpsMaxInflow - cycleSeconds * steamValue + steamFallMargin >= limitM2 \/ steamUnitFailed /\ levelValue + pumpsMaxInflow >= limitM2) \/ levelUnitFailed /\ (steamUnitFailed \/ pumpControlUnitFailed) \/ levelUnitFailed /\ (levelLow + cycleSeconds * pumpThroughput - cycleSeconds * steamReading - steamRiseMargin - cycleSeconds * steamValue - steamRiseMargin <= limitM1 \/ levelHigh + cycleSeconds * openThroughput - cycleSeconds * steamReading + steamFallMargin + pumpsMaxInflow - cycleSeconds * steamValue + steamFallMargin >= limitM2) ) /\ not ( levelUnitFailed ) /\ not ( steamUnitFailed \/ pumpUnitFailed \/ pumpControlUnitFailed ) /\ levelValue > normalN2
		action send modeAnnouncement ; closePump ! 1 ; closePump ! 2 ; closePump ! 3 ; closePump ! 4 ; levelReading = levelValue ; steamReading = steamValue ; levelLow = levelValue ; levelHigh = levelValue ; pumpThroughput = 0
	}
