		to DEGRADED
		trigger transmission
		condition not ( successiveStopCount >= stopLimit \/ transmissionFailed \/ boilerWaitingPresent \/ unitsReadyNow \/ not ( levelUnitFailed ) /\ (not ( steamUnitFailed ) /\ levelValue - cycleSeconds * steamValue - steamRiseMargin <= limitM1 \/ steamUnitFailed /\ levelValue - steamMaxOutflow <= limitM1 \/ not ( steamUnitFailed ) /\ levelValue + pumpsMaxInflow - cycleSeconds * steamValue + steamFallMargin >= limitM2 \/ steamUnitFailed /\ levelValue + pumpsMaxInflow >= limitM2) \/ levelUnitFailed /\ (steamUnitFailed \/ pumpControlUnitFailed) \/ levelUnitFailed /\ (levelLow + cycleSeconds * pumpThroughput - cycleSeconds * steamReading - steamRiseMargin - cycleSeconds * steamValue - steamRiseMargin <= limitM1 \/ levelHigh + cycleSeconds * openThroughput - cycleSeconds * steamReading + steamFallMargin + pumpsMaxInflow - cycleSeconds * steamValue + steamFallMargin >= limitM2) ) /\ not ( levelUnitFailed ) /\ (steamUnitFailed \/ pumpUnitFailed \/ pumpControlUnitFailed) /\ levelValue > normalN2
