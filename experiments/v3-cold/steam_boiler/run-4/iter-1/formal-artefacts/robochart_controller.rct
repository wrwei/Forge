		to RESCUE
		trigger transmission
		condition not ( successiveStopCount >= stopLimit \/ transmissionFailed \/ boilerWaitingPresent \/ unitsReadyNow \/ not ( levelUnitFailed ) /\ (not ( steamUnitFailed ) /\ levelValue - cycleSeconds * steamValue - steamRiseMargin <= limitM1 \/ steamUnitFailed /\ levelValue - steamMaxOutflow <= limitM1 \/ not ( steamUnitFailed ) /\ levelValue + pumpsMaxInflow - cycleSeconds * steamValue + steamFallMargin >= limitM2 \/ steamUnitFailed /\ levelValue + pumpsMaxInflow >= limitM2) \/ levelUnitFailed /\ (steamUnitFailed \/ pumpControlUnitFailed) \/ levelUnitFailed /\ (levelLow + cycleSeconds * pumpThroughput - cycleSeconds * steamReading - steamRiseMargin - cycleSeconds * steamValue - steamRiseMargin <= limitM1 \/ levelHigh + cycleSeconds * openThroughput - cycleSeconds * steamReading + steamFallMargin + pumpsMaxInflow - cycleSeconds * steamValue + steamFallMargin >= limitM2) ) /\ levelUnitFailed /\ levelLow + cycleSeconds * pumpThroughput - cycleSeconds * steamReading - steamRiseMargin + levelHigh + cycleSeconds * openThroughput - cycleSeconds * steamReading + steamFallMargin > 2 * normalN2 /\ not ( levelLow + cycleSeconds * pumpThroughput - cycleSeconds * steamReading - steamRiseMargin + levelHigh + cycleSeconds * openThroughput - cycleSeconds * steamReading + steamFallMargin < 2 * normalN1 )
		action send modeAnnouncement ; closePump ! 1 ; closePump ! 2 ; closePump ! 3 ; closePump ! 4 ; levelLow = levelLow + cycleSeconds * pumpThroughput - cycleSeconds * steamReading - steamRiseMargin ; levelHigh = levelHigh + cycleSeconds * openThroughput - cycleSeconds * steamReading + steamFallMargin ; steamReading = steamValue ; pumpThroughput = 0
	}
	transition t38 {
		from RESCUE
		to RESCUE
		trigger transmission
		condition not ( successiveStopCount >= stopLimit \/ transmissionFailed \/ boilerWaitingPresent \/ unitsReadyNow \/ not ( levelUnitFailed ) /\ (not ( steamUnitFailed ) /\ levelValue - cycleSeconds * steamValue - steamRiseMargin <= limitM1 \/ steamUnitFailed /\ levelValue - steamMaxOutflow <= limitM1 \/ not ( steamUnitFailed ) /\ levelValue + pumpsMaxInflow - cycleSeconds * steamValue + steamFallMargin >= limitM2 \/ steamUnitFailed /\ levelValue + pumpsMaxInflow >= limitM2) \/ levelUnitFailed /\ (steamUnitFailed \/ pumpControlUnitFailed) \/ levelUnitFailed /\ (levelLow + cycleSeconds * pumpThroughput - cycleSeconds * steamReading - steamRiseMargin - cycleSeconds * steamValue - steamRiseMargin <= limitM1 \/ levelHigh + cycleSeconds * openThroughput - cycleSeconds * steamReading + steamFallMargin + pumpsMaxInflow - cycleSeconds * steamValue + steamFallMargin >= limitM2) ) /\ levelUnitFailed /\ not ( levelLow + cycleSeconds * pumpThroughput - cycleSeconds * steamReading - steamRiseMargin + levelHigh + cycleSeconds * openThroughput - cycleSeconds * steamReading + steamFallMargin < 2 * normalN1 ) /\ not ( levelLow + cycleSeconds * pumpThroughput - cycleSeconds * steamReading - steamRiseMargin + levelHigh + cycleSeconds * openThroughput - cycleSeconds * steamReading + steamFallMargin > 2 * normalN2 )
	}
}

controller SteamBoilerController_Ctrl {
	uses Inputs uses Outputs requires SteamBoilerController_State requires Constants requires Sensors
	sref stm_ref0 = SteamBoilerController
	connection SteamBoilerController_Ctrl on transmission to stm_ref0 on transmission
	connection stm_ref0 on modeAnnouncement to SteamBoilerController_Ctrl on modeAnnouncement
	connection stm_ref0 on valve to SteamBoilerController_Ctrl on valve
	connection stm_ref0 on closePump to SteamBoilerController_Ctrl on closePump
	connection stm_ref0 on openPump to SteamBoilerController_Ctrl on openPump
	connection stm_ref0 on programReady to SteamBoilerController_Ctrl on programReady
}

module SteamBoilerController_Module {
	robotic platform SteamBoilerController_Platform {
		provides Sensors provides Actuators provides Constants
		event transmission
		event modeAnnouncement
		event valve
		event closePump : int
		event openPump : int
		event programReady
	}
	cref ctrl_ref0 = SteamBoilerController_Ctrl
	connection SteamBoilerController_Platform on transmission to ctrl_ref0 on transmission
	connection ctrl_ref0 on modeAnnouncement to SteamBoilerController_Platform on modeAnnouncement
	connection ctrl_ref0 on valve to SteamBoilerController_Platform on valve
	connection ctrl_ref0 on closePump to SteamBoilerController_Platform on closePump
	connection ctrl_ref0 on openPump to SteamBoilerController_Platform on openPump
	connection ctrl_ref0 on programReady to SteamBoilerController_Platform on programReady
}

