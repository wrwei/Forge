  <spoon:CtClass name="SteamBoilerController">
    <comment xsi:type="spoon:CtJavaDoc" commentContent="Mode logic of the steam-boiler control program. It is always in exactly one of five modes&#xA;and starts in initialization. {@link #step(InputEvent)} is the analysis stage of one cycle:&#xA;it is called with {@link InputEvent.TransmissionReceived} once the cycle's incoming&#xA;transmission has been received and analysed by the sensor, decides the mode, and issues&#xA;MODE(m) and the mode's commands (PROGRAM_READY, VALVE, OPEN_PUMP, CLOSE_PUMP).&#xA;&#xA;&lt;p>Within each mode the transitions are listed in priority order and every guard conjoins&#xA;the negation of the guards above it, so that the most severe consequence prevails&#xA;(SB-FR8): emergency stop over rescue, rescue over degraded. A cycle that changes mode leaves&#xA;the pumps as they are; pump regulation changes at most one pump per cycle. Emergency stop&#xA;is terminal."/>
    <modifier>PUBLIC</modifier>
    <modifier>FINAL</modifier>
    <typeMember xsi:type="spoon:CtField" name="currentMode">
      <modifier>PRIVATE</modifier>
      <type name="BoilerMode">
        <packageRef isImplicit="true" name="steam_boiler.controller"/>
      </type>
      <assignment xsi:type="spoon:CtFieldRead">
        <type name="BoilerMode">
          <packageRef name="steam_boiler.controller"/>
        </type>
        <variable xsi:type="spoon:CtFieldReference" name="INITIALIZATION" isFinal="true" isStatic="true">
          <declaringType name="BoilerMode">
            <packageRef name="steam_boiler.controller"/>
          </declaringType>
        </variable>
        <target xsi:type="spoon:CtTypeAccess">
          <type name="void"/>
          <accessedType name="BoilerMode">
            <packageRef isImplicit="true" name="steam_boiler.controller"/>
          </accessedType>
        </target>
      </assignment>
    </typeMember>
    <typeMember xsi:type="spoon:CtField" name="sensor">
      <modifier>FINAL</modifier>
      <modifier>PRIVATE</modifier>
      <type name="BoilerSensor">
        <packageRef isImplicit="true" name="steam_boiler.sensor"/>
      </type>
    </typeMember>
    <typeMember xsi:type="spoon:CtField" name="actuator">
      <modifier>FINAL</modifier>
      <modifier>PRIVATE</modifier>
      <type name="BoilerActuator">
        <packageRef isImplicit="true" name="steam_boiler.actuator"/>
