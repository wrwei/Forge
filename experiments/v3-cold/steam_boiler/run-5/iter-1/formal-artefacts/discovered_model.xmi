                    <packageRef name="steam_boiler"/>
                  </declaringType>
                </variable>
                <target xsi:type="spoon:CtThisAccess" isImplicit="true">
                  <type name="SteamBoilerProgram">
                    <packageRef name="steam_boiler"/>
                  </type>
                  <target xsi:type="spoon:CtTypeAccess">
                    <type name="void"/>
                    <accessedType name="SteamBoilerProgram">
                      <packageRef name="steam_boiler"/>
                    </accessedType>
                  </target>
                </target>
              </target>
              <executableRef name="currentMode">
                <declaringType name="SteamBoilerController">
                  <packageRef name="steam_boiler.controller"/>
                </declaringType>
              </executableRef>
            </leftOperand>
            <rightOperand xsi:type="spoon:CtFieldRead">
              <type name="BoilerMode">
                <packageRef name="steam_boiler.controller"/>
              </type>
              <variable xsi:type="spoon:CtFieldReference" name="EMERGENCY_STOP" isFinal="true" isStatic="true">
                <declaringType name="BoilerMode">
                  <packageRef name="steam_boiler.controller"/>
                </declaringType>
              </variable>
              <target xsi:type="spoon:CtTypeAccess">
                <type name="void"/>
                <accessedType name="BoilerMode">
                  <packageRef isImplicit="true" name="steam_boiler.controller"/>
                </accessedType>
              </target>
            </rightOperand>
          </condition>
          <then xsi:type="spoon:CtBlock">
            <statement xsi:type="spoon:CtReturn">
              <expression xsi:type="spoon:CtVariableRead">
                <type name="List">
                  <typeArgument name="OutputEvent">
                    <packageRef name="steam_boiler.event"/>
                  </typeArgument>
                  <packageRef name="java.util"/>
                </type>
                <variable xsi:type="spoon:CtLocalVariableReference" name="outgoing"/>
