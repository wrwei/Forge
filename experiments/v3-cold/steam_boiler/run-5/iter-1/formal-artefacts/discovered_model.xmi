            <declaringType name="Object">
              <packageRef name="java.lang"/>
            </declaringType>
          </executableRef>
        </statement>
      </body>
      <type name="SteamBoilerProgram">
        <packageRef name="steam_boiler"/>
      </type>
    </typeMember>
