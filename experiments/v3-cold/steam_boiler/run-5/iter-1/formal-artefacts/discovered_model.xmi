                <packageRef name="steam_boiler"/>
              </declaringType>
            </variable>
            <target xsi:type="spoon:CtThisAccess" isImplicit="true">
              <type name="SteamBoilerProgram">
                <packageRef name="steam_boiler"/>
              </type>
              <target xsi:type="spoon:CtTypeAccess">
                <type name="void"/>
                <accessedType name="SteamBoilerProgram">
                  <packageRef name="steam_boiler"/>
                </accessedType>
              </target>
            </target>
          </target>
          <executableRef name="beginCycle">
            <declaringType name="BoilerSensor">
              <packageRef name="steam_boiler.sensor"/>
            </declaringType>
          </executableRef>
        </statement>
        <statement xsi:type="spoon:CtForEach">
          <body xsi:type="spoon:CtBlock">
            <statement xsi:type="spoon:CtInvocation">
