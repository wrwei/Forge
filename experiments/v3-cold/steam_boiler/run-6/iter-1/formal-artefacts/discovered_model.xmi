    <typeMember xsi:type="spoon:CtMethod" name="detectControlFailure">
      <comment xsi:type="spoon:CtJavaDoc" commentContent="The pump controller has failed when, in the second transmission after an&#xA;order to a sound pump, it does not show the flow starting or stopping,&#xA;or when its observation changes with no order in the last two&#xA;transmissions. A later contrary order supersedes the earlier one."/>
      <modifier>PRIVATE</modifier>
      <body xsi:type="spoon:CtBlock">
        <statement xsi:type="spoon:CtIf">
          <condition xsi:type="spoon:CtBinaryOperator">
            <type name="boolean"/>
            <leftOperand xsi:type="spoon:CtBinaryOperator">
              <type name="boolean"/>
              <leftOperand xsi:type="spoon:CtInvocation">
                <type name="boolean"/>
                <target xsi:type="spoon:CtFieldRead">
                  <type name="UnitStatus">
                    <packageRef name="steam_boiler.sensor"/>
                  </type>
                  <variable xsi:type="spoon:CtFieldReference" name="control" isFinal="true">
                    <declaringType name="PumpUnit">
                      <packageRef name="steam_boiler.sensor"/>
                    </declaringType>
                  </variable>
                  <target xsi:type="spoon:CtThisAccess" isImplicit="true">
                    <type name="PumpUnit">
                      <packageRef name="steam_boiler.sensor"/>
                    </type>
                    <target xsi:type="spoon:CtTypeAccess">
                      <type name="void"/>
                      <accessedType name="PumpUnit">
                        <packageRef name="steam_boiler.sensor"/>
                      </accessedType>
                    </target>
                  </target>
                </target>
                <executableRef name="failed">
                  <declaringType name="UnitStatus">
                    <packageRef name="steam_boiler.sensor"/>
                  </declaringType>
                </executableRef>
              </leftOperand>
              <rightOperand xsi:type="spoon:CtInvocation">
                <type name="boolean"/>
                <target xsi:type="spoon:CtFieldRead">
                  <type name="UnitStatus">
                    <packageRef name="steam_boiler.sensor"/>
                  </type>
                  <variable xsi:type="spoon:CtFieldReference" name="control" isFinal="true">
                    <declaringType name="PumpUnit">
                      <packageRef name="steam_boiler.sensor"/>
                    </declaringType>
                  </variable>
                  <target xsi:type="spoon:CtThisAccess" isImplicit="true">
                    <type name="PumpUnit">
                      <packageRef name="steam_boiler.sensor"/>
                    </type>
                    <target xsi:type="spoon:CtTypeAccess">
