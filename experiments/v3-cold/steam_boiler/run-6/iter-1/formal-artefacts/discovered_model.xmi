  <spoon:CtClass name="SteamBoilerProgram">
    <comment xsi:type="spoon:CtJavaDoc" commentContent="The steam-boiler control program: wires the sensor, the controller and the&#xA;actuator, and runs one five-second cycle at a time in its three stages:&#xA;receive the incoming messages, analyse them, transmit the outgoing messages.&#xA;Once emergency stop has been entered the program has stopped and takes part&#xA;in no further cycle."/>
    <modifier>FINAL</modifier>
    <modifier>PUBLIC</modifier>
    <typeMember xsi:type="spoon:CtField" name="actuator">
      <modifier>FINAL</modifier>
      <modifier>PRIVATE</modifier>
