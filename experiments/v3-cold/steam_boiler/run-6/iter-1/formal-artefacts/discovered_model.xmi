              <declaringType name="PumpUnit">
                <packageRef name="steam_boiler.sensor"/>
              </declaringType>
            </variable>
            <target xsi:type="spoon:CtThisAccess" isImplicit="true">
              <type name="PumpUnit">
                <packageRef name="steam_boiler.sensor"/>
              </type>
              <target xsi:type="spoon:CtTypeAccess">
                <type name="void"/>
                <accessedType name="PumpUnit">
                  <packageRef name="steam_boiler.sensor"/>
                </accessedType>
              </target>
            </target>
          </assignment>
        </statement>
        <statement xsi:type="spoon:CtIf">
          <else xsi:type="spoon:CtBlock" isImplicit="true">
            <statement xsi:type="spoon:CtIf">
              <condition xsi:type="spoon:CtFieldRead">
                <type name="boolean"/>
                <variable xsi:type="spoon:CtFieldReference" name="closeOrderedLast">
                  <declaringType name="PumpUnit">
                    <packageRef name="steam_boiler.sensor"/>
                  </declaringType>
                </variable>
