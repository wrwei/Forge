    <typeMember xsi:type="spoon:CtMethod" name="runCycle">
      <comment xsi:type="spoon:CtJavaDoc" commentContent="Runs one cycle.">
        <commentTag documentationTypeRealname="param" commentContent="the messages received in this cycle, all considered&#xA;                    received simultaneously" javadocTagValue="transmission"/>
        <commentTag documentationTypeRealname="return" commentContent="the messages emitted at the end of this cycle, all considered&#xA;        emitted simultaneously; empty once the program has stopped"/>
      </comment>
      <modifier>PUBLIC</modifier>
      <body xsi:type="spoon:CtBlock">
        <statement xsi:type="spoon:CtIf">
          <condition xsi:type="spoon:CtBinaryOperator" operatorKind="EQ">
            <type name="boolean"/>
            <leftOperand xsi:type="spoon:CtInvocation">
              <type name="OperatingMode">
                <packageRef name="steam_boiler.mode"/>
              </type>
              <target xsi:type="spoon:CtFieldRead">
                <type name="SteamBoilerController">
                  <packageRef name="steam_boiler.controller"/>
                </type>
                <variable xsi:type="spoon:CtFieldReference" name="controller" isFinal="true">
                  <declaringType name="SteamBoilerProgram">
                    <packageRef name="steam_boiler"/>
                  </declaringType>
                </variable>
                <target xsi:type="spoon:CtThisAccess" isImplicit="true">
                  <type name="SteamBoilerProgram">
                    <packageRef name="steam_boiler"/>
                  </type>
                  <target xsi:type="spoon:CtTypeAccess">
                    <type name="void"/>
                    <accessedType name="SteamBoilerProgram">
                      <packageRef name="steam_boiler"/>
                    </accessedType>
                  </target>
                </target>
              </target>
              <executableRef name="currentMode">
                <declaringType name="SteamBoilerController">
                  <packageRef name="steam_boiler.controller"/>
                </declaringType>
              </executableRef>
            </leftOperand>
            <rightOperand xsi:type="spoon:CtFieldRead">
              <type name="OperatingMode">
                <packageRef name="steam_boiler.mode"/>
              </type>
              <variable xsi:type="spoon:CtFieldReference" name="EMERGENCY_STOP" isFinal="true" isStatic="true">
                <declaringType name="OperatingMode">
                  <packageRef name="steam_boiler.mode"/>
                </declaringType>
              </variable>
              <target xsi:type="spoon:CtTypeAccess">
                <type name="void"/>
                <accessedType name="OperatingMode">
                  <packageRef isImplicit="true" name="steam_boiler.mode"/>
                </accessedType>
              </target>
            </rightOperand>
          </condition>
          <then xsi:type="spoon:CtBlock">
            <statement xsi:type="spoon:CtReturn">
              <expression xsi:type="spoon:CtConstructorCall">
                <type name="ArrayList">
                  <typeArgument isImplicit="true" name="OutputEvent">
                    <packageRef name="steam_boiler.event"/>
