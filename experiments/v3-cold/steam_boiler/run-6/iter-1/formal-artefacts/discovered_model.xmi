                  <type name="boolean"/>
                  <assignment xsi:type="spoon:CtLiteral" value="true" valueKind="Boolean">
                    <type name="boolean"/>
                  </assignment>
                  <assigned xsi:type="spoon:CtVariableWrite">
                    <type name="boolean"/>
                    <variable xsi:type="spoon:CtLocalVariableReference" name="expectationKnown"/>
                  </assigned>
                </statement>
                <statement xsi:type="spoon:CtAssignment">
                  <type name="boolean"/>
                  <assignment xsi:type="spoon:CtLiteral" value="false" valueKind="Boolean">
                    <type name="boolean"/>
                  </assignment>
                  <assigned xsi:type="spoon:CtVariableWrite">
                    <type name="boolean"/>
                    <variable xsi:type="spoon:CtLocalVariableReference" name="expectedOn"/>
                  </assigned>
                </statement>
              </then>
            </statement>
          </else>
          <condition xsi:type="spoon:CtFieldRead">
            <type name="boolean"/>
            <variable xsi:type="spoon:CtFieldReference" name="openOrderedLast">
              <declaringType name="PumpUnit">
                <packageRef name="steam_boiler.sensor"/>
              </declaringType>
            </variable>
            <target xsi:type="spoon:CtThisAccess" isImplicit="true">
