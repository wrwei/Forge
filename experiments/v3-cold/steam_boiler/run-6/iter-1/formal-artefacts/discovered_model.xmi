    <typeMember xsi:type="spoon:CtMethod" name="detectPumpFailure">
      <comment xsi:type="spoon:CtJavaDoc" commentContent="The pump has failed when, in the transmission following an order, its&#xA;state does not show the order carried out, or when its state changes&#xA;without an order."/>
      <modifier>PRIVATE</modifier>
      <body xsi:type="spoon:CtBlock">
        <statement xsi:type="spoon:CtIf">
          <condition xsi:type="spoon:CtBinaryOperator">
            <type name="boolean"/>
