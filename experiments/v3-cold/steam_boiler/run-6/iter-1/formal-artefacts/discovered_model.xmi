          </then>
        </statement>
        <statement xsi:type="spoon:CtLocalVariable" name="expectationKnown">
          <type name="boolean"/>
          <assignment xsi:type="spoon:CtFieldRead">
            <type name="boolean"/>
            <variable xsi:type="spoon:CtFieldReference" name="previousKnown">
              <declaringType name="PumpUnit">
                <packageRef name="steam_boiler.sensor"/>
              </declaringType>
            </variable>
            <target xsi:type="spoon:CtThisAccess" isImplicit="true">
              <type name="PumpUnit">
                <packageRef name="steam_boiler.sensor"/>
              </type>
              <target xsi:type="spoon:CtTypeAccess">
                <type name="void"/>
