                <packageRef name="steam_boiler.sensor"/>
              </type>
              <target xsi:type="spoon:CtTypeAccess">
                <type name="void"/>
                <accessedType name="PumpUnit">
                  <packageRef name="steam_boiler.sensor"/>
                </accessedType>
              </target>
            </target>
          </condition>
          <then xsi:type="spoon:CtBlock">
            <statement xsi:type="spoon:CtAssignment">
              <type name="boolean"/>
              <assignment xsi:type="spoon:CtLiteral" value="true" valueKind="Boolean">
                <type name="boolean"/>
              </assignment>
              <assigned xsi:type="spoon:CtVariableWrite">
                <type name="boolean"/>
                <variable xsi:type="spoon:CtLocalVariableReference" name="expectationKnown"/>
              </assigned>
            </statement>
            <statement xsi:type="spoon:CtAssignment">
              <type name="boolean"/>
              <assignment xsi:type="spoon:CtLiteral" value="true" valueKind="Boolean">
                <type name="boolean"/>
              </assignment>
              <assigned xsi:type="spoon:CtVariableWrite">
                <type name="boolean"/>
                <variable xsi:type="spoon:CtLocalVariableReference" name="expectedOn"/>
              </assigned>
            </statement>
          </then>
        </statement>
        <statement xsi:type="spoon:CtIf">
          <condition xsi:type="spoon:CtBinaryOperator" operatorKind="AND">
            <type name="boolean"/>
            <leftOperand xsi:type="spoon:CtVariableRead">
              <type name="boolean"/>
              <variable xsi:type="spoon:CtLocalVariableReference" name="expectationKnown"/>
            </leftOperand>
            <rightOperand xsi:type="spoon:CtBinaryOperator" operatorKind="NE">
              <type name="boolean"/>
              <leftOperand xsi:type="spoon:CtFieldRead">
                <type name="boolean"/>
