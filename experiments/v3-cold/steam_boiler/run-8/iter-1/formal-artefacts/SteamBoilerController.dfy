        else if (event == Transmission && (!((successiveStopCount() >= 3) || transmissionFailure() || ((levelLowerBound() - maximumSteamOutflow() <= 100.0) || ((waterLevel() > 600.0) && (levelUpperBound() - minimumSteamOutflow() >= 900.0)) || (!(waterLevel() > 600.0) && (levelUpperBound() + maximumPumpInflow() - minimumSteamOutflow() >= 900.0))) || (steamDeviceOutOfOrder() || pumpControlOutOfOrder())) && !levelDeviceOutOfOrder() && !(!levelDeviceOutOfOrder() && !steamDeviceOutOfOrder() && !pumpOutOfOrder() && !pumpControlOutOfOrder())) && waterLevel() > 600.0) {
            mode := DEGRADED;
            // action: Mode(DEGRADED)
        }
        else if (event == Transmission && (!((successiveStopCount() >= 3) || transmissionFailure() || ((levelLowerBound() - maximumSteamOutflow() <= 100.0) || ((waterLevel() > 600.0) && (levelUpperBound() - minimumSteamOutflow() >= 900.0)) || (!(waterLevel() > 600.0) && (levelUpperBound() + maximumPumpInflow() - minimumSteamOutflow() >= 900.0))) || (steamDeviceOutOfOrder() || pumpControlOutOfOrder())) && !levelDeviceOutOfOrder() && !(!levelDeviceOutOfOrder() && !steamDeviceOutOfOrder() && !pumpOutOfOrder() && !pumpControlOutOfOrder())) && (waterLevel() < 400.0) && !(waterLevel() > 600.0)) {
            mode := DEGRADED;
            // action: Mode(DEGRADED)
        }
        else if (event == Transmission && (!((successiveStopCount() >= 3) || transmissionFailure() || ((levelLowerBound() - maximumSteamOutflow() <= 100.0) || ((waterLevel() > 600.0) && (levelUpperBound() - minimumSteamOutflow() >= 900.0)) || (!(waterLevel() > 600.0) && (levelUpperBound() + maximumPumpInflow() - minimumSteamOutflow() >= 900.0))) || (steamDeviceOutOfOrder() || pumpControlOutOfOrder())) && !levelDeviceOutOfOrder() && !(!levelDeviceOutOfOrder() && !steamDeviceOutOfOrder() && !pumpOutOfOrder() && !pumpControlOutOfOrder())) && !(waterLevel() < 400.0) && !(waterLevel() > 600.0)) {
            mode := DEGRADED;
            // action: Mode(DEGRADED)
        }
        else if (event == Transmission && (!((successiveStopCount() >= 3) || transmissionFailure() || ((levelLowerBound() - maximumSteamOutflow() <= 100.0) || ((waterLevel() > 600.0) && (levelUpperBound() - minimumSteamOutflow() >= 900.0)) || (!(waterLevel() > 600.0) && (levelUpperBound() + maximumPumpInflow() - minimumSteamOutflow() >= 900.0))) || (steamDeviceOutOfOrder() || pumpControlOutOfOrder())) && levelDeviceOutOfOrder()) && waterLevel() > 600.0) {
            mode := RESCUE;
            // action: Mode(RESCUE)
        }
        else if (event == Transmission && (!((successiveStopCount() >= 3) || transmissionFailure() || ((levelLowerBound() - maximumSteamOutflow() <= 100.0) || ((waterLevel() > 600.0) && (levelUpperBound() - minimumSteamOutflow() >= 900.0)) || (!(waterLevel() > 600.0) && (levelUpperBound() + maximumPumpInflow() - minimumSteamOutflow() >= 900.0))) || (steamDeviceOutOfOrder() || pumpControlOutOfOrder())) && levelDeviceOutOfOrder()) && (waterLevel() < 400.0) && !(waterLevel() > 600.0)) {
            mode := RESCUE;
            // action: Mode(RESCUE)
        }
        else if (event == Transmission && (!((successiveStopCount() >= 3) || transmissionFailure() || ((levelLowerBound() - maximumSteamOutflow() <= 100.0) || ((waterLevel() > 600.0) && (levelUpperBound() - minimumSteamOutflow() >= 900.0)) || (!(waterLevel() > 600.0) && (levelUpperBound() + maximumPumpInflow() - minimumSteamOutflow() >= 900.0))) || (steamDeviceOutOfOrder() || pumpControlOutOfOrder())) && levelDeviceOutOfOrder()) && !(waterLevel() < 400.0) && !(waterLevel() > 600.0)) {
            mode := RESCUE;
            // action: Mode(RESCUE)
        }
    }

    method transitionFromEMERGENCY_STOP(event: InputEvent)
        requires mode == EMERGENCY_STOP
        requires Valid()
        modifies this
        ensures Valid()
    {
    }

    method step(event: InputEvent)
        requires Valid()
        modifies this
        ensures Valid()
    {
        if (mode == INITIALIZATION) {
            transitionFromINITIALIZATION(event);
        }
        else if (mode == NORMAL) {
            transitionFromNORMAL(event);
        }
        else if (mode == DEGRADED) {
            transitionFromDEGRADED(event);
        }
        else if (mode == RESCUE) {
            transitionFromRESCUE(event);
        }
        else if (mode == EMERGENCY_STOP) {
            transitionFromEMERGENCY_STOP(event);
        }
    }
}
