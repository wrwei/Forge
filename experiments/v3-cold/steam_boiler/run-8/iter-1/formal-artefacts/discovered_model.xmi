  <spoon:CtClass name="BoilerConstants">
    <comment xsi:type="spoon:CtJavaDoc" commentContent="Constant characteristics of the boiler, the steam exit and the pumps&#xA;(SB-DM1, SB-DM2, SB-DM3), and the fixed figures of the cycle protocol&#xA;(SB-V3, SB-Beh23). The requirements name the quantities but give no values&#xA;for C, M1, M2, N1, N2, W, U1, U2 and P; the values below are chosen to be&#xA;consistent with the stated ordering M1 &amp;lt; N1 &amp;lt; N2 &amp;lt; M2 &amp;lt;= C."/>
    <modifier>FINAL</modifier>
    <modifier>PUBLIC</modifier>
    <typeMember xsi:type="spoon:CtField" name="CAPACITY">
