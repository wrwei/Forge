diagram SteamBoilerController

datatype FlowReading {
	controllerIndex : int
	waterFlowing : boolean
}

datatype PumpReading {
	pumpIndex : int
	pumpOpen : boolean
}

interface Inputs {
	event transmission
}

interface Outputs {
	event mode
	event valve
	event closePump : int
	event openPump : int
	event programReady
}

interface Sensors {
	var successiveStopCount : int
	var plantWaiting : boolean
	var transmissionFailed : boolean
	var steamRate : real
	var levelDeviceFailed : boolean
	var unitsReady : boolean
	var steamDeviceFailed : boolean
	var pumpFailed : boolean
	var pumpControlFailed : boolean
	var valveIsOpen : boolean
	var waterLevel : real
	var openPumpCount : int
	var levelLowerBound : real
	var maximumSteamOutflow : real
	var levelUpperBound : real
	var minimumSteamOutflow : real
	var maximumPumpInflow : real
}

interface Actuators {
}

interface SteamBoilerController_State {
}

interface Constants {
	const stopRepetitions : real = 3
	const maxNormalLevel : real = 600
	const minNormalLevel : real = 400
	const minLimitLevel : real = 100
	const maxLimitLevel : real = 900
}

stm SteamBoilerController {
	uses Inputs uses Outputs requires SteamBoilerController_State requires Constants requires Sensors
	state NORMAL {
	}
	state INITIALIZATION {
	}
	state EMERGENCY_STOP {
		entry send mode
	}
	state DEGRADED {
	}
	state RESCUE {
	}
	initial i0
	transition t_init {
		from i0
		to INITIALIZATION
	}
	transition t1 {
		from INITIALIZATION
		to EMERGENCY_STOP
		trigger transmission
		condition successiveStopCount >= stopRepetitions
	}
	transition t2 {
		from INITIALIZATION
		to EMERGENCY_STOP
		trigger transmission
		condition not ( successiveStopCount >= stopRepetitions ) /\ plantWaiting /\ (transmissionFailed \/ steamRate != 0 \/ levelDeviceFailed)
	}
	transition t3 {
		from INITIALIZATION
		to NORMAL
		trigger transmission
		condition not ( successiveStopCount >= stopRepetitions ) /\ not ( plantWaiting /\ (transmissionFailed \/ steamRate != 0 \/ levelDeviceFailed) ) /\ plantWaiting /\ unitsReady /\ not ( levelDeviceFailed ) /\ not ( steamDeviceFailed ) /\ not ( pumpFailed ) /\ not ( pumpControlFailed ) /\ valveIsOpen
		action send mode ; send valve
	}
	transition t4 {
		from INITIALIZATION
		to NORMAL
		trigger transmission
		condition not ( successiveStopCount >= stopRepetitions ) /\ not ( plantWaiting /\ (transmissionFailed \/ steamRate != 0 \/ levelDeviceFailed) ) /\ plantWaiting /\ unitsReady /\ not ( levelDeviceFailed ) /\ not ( steamDeviceFailed ) /\ not ( pumpFailed ) /\ not ( pumpControlFailed ) /\ not ( valveIsOpen )
		action send mode
	}
	transition t5 {
		from INITIALIZATION
		to DEGRADED
		trigger transmission
		condition not ( successiveStopCount >= stopRepetitions ) /\ not ( plantWaiting /\ (transmissionFailed \/ steamRate != 0 \/ levelDeviceFailed) ) /\ plantWaiting /\ unitsReady /\ not ( not ( levelDeviceFailed ) /\ not ( steamDeviceFailed ) /\ not ( pumpFailed ) /\ not ( pumpControlFailed ) ) /\ valveIsOpen
		action send mode ; send valve
	}
	transition t6 {
		from INITIALIZATION
		to DEGRADED
		trigger transmission
		condition not ( successiveStopCount >= stopRepetitions ) /\ not ( plantWaiting /\ (transmissionFailed \/ steamRate != 0 \/ levelDeviceFailed) ) /\ plantWaiting /\ unitsReady /\ not ( not ( levelDeviceFailed ) /\ not ( steamDeviceFailed ) /\ not ( pumpFailed ) /\ not ( pumpControlFailed ) ) /\ not ( valveIsOpen )
		action send mode
	}
	transition t7 {
		from INITIALIZATION
		to INITIALIZATION
		trigger transmission
		condition not ( successiveStopCount >= stopRepetitions ) /\ not ( plantWaiting /\ (transmissionFailed \/ steamRate != 0 \/ levelDeviceFailed) ) /\ plantWaiting /\ not ( unitsReady ) /\ waterLevel > maxNormalLevel /\ not ( valveIsOpen )
		action send mode ; send valve ; closePump ! 1 ; closePump ! 2 ; closePump ! 3 ; closePump ! 4
	}
	transition t8 {
		from INITIALIZATION
		to INITIALIZATION
		trigger transmission
		condition not ( successiveStopCount >= stopRepetitions ) /\ not ( plantWaiting /\ (transmissionFailed \/ steamRate != 0 \/ levelDeviceFailed) ) /\ plantWaiting /\ not ( unitsReady ) /\ waterLevel > maxNormalLevel /\ valveIsOpen
		action send mode
	}
	transition t9 {
		from INITIALIZATION
		to INITIALIZATION
		trigger transmission
		condition not ( successiveStopCount >= stopRepetitions ) /\ not ( plantWaiting /\ (transmissionFailed \/ steamRate != 0 \/ levelDeviceFailed) ) /\ plantWaiting /\ not ( unitsReady ) /\ waterLevel < minNormalLevel /\ not ( waterLevel > maxNormalLevel ) /\ valveIsOpen
		action send mode ; send valve ; openPump ! 1 ; openPump ! 2 ; openPump ! 3 ; openPump ! 4
	}
	transition t10 {
		from INITIALIZATION
		to INITIALIZATION
		trigger transmission
		condition not ( successiveStopCount >= stopRepetitions ) /\ not ( plantWaiting /\ (transmissionFailed \/ steamRate != 0 \/ levelDeviceFailed) ) /\ plantWaiting /\ not ( unitsReady ) /\ waterLevel < minNormalLevel /\ not ( waterLevel > maxNormalLevel ) /\ not ( valveIsOpen )
		action send mode ; openPump ! 1 ; openPump ! 2 ; openPump ! 3 ; openPump ! 4
	}
	transition t11 {
		from INITIALIZATION
		to INITIALIZATION
		trigger transmission
		condition not ( successiveStopCount >= stopRepetitions ) /\ not ( plantWaiting /\ (transmissionFailed \/ steamRate != 0 \/ levelDeviceFailed) ) /\ plantWaiting /\ not ( unitsReady ) /\ not ( waterLevel < minNormalLevel ) /\ not ( waterLevel > maxNormalLevel ) /\ valveIsOpen
		action send mode ; send valve ; send programReady
	}
	transition t12 {
		from INITIALIZATION
		to INITIALIZATION
		trigger transmission
		condition not ( successiveStopCount >= stopRepetitions ) /\ not ( plantWaiting /\ (transmissionFailed \/ steamRate != 0 \/ levelDeviceFailed) ) /\ plantWaiting /\ not ( unitsReady ) /\ not ( waterLevel < minNormalLevel ) /\ not ( waterLevel > maxNormalLevel ) /\ not ( valveIsOpen ) /\ openPumpCount > 0
		action send mode ; closePump ! 1 ; closePump ! 2 ; closePump ! 3 ; closePump ! 4 ; send programReady
	}
	transition t13 {
		from INITIALIZATION
		to INITIALIZATION
		trigger transmission
		condition not ( successiveStopCount >= stopRepetitions ) /\ not ( plantWaiting /\ (transmissionFailed \/ steamRate != 0 \/ levelDeviceFailed) ) /\ plantWaiting /\ not ( unitsReady ) /\ not ( waterLevel < minNormalLevel ) /\ not ( waterLevel > maxNormalLevel ) /\ not ( valveIsOpen ) /\ not ( openPumpCount > 0 )
		action send mode ; send programReady
	}
	transition t14 {
		from INITIALIZATION
		to INITIALIZATION
		trigger transmission
		condition not ( successiveStopCount >= stopRepetitions ) /\ not ( plantWaiting )
		action send mode
	}
	transition t15 {
		from NORMAL
		to EMERGENCY_STOP
		trigger transmission
		condition successiveStopCount >= stopRepetitions \/ transmissionFailed \/ levelLowerBound - maximumSteamOutflow <= minLimitLevel \/ waterLevel > maxNormalLevel /\ levelUpperBound - minimumSteamOutflow >= maxLimitLevel \/ not ( waterLevel > maxNormalLevel ) /\ levelUpperBound + maximumPumpInflow - minimumSteamOutflow >= maxLimitLevel \/ levelDeviceFailed /\ (steamDeviceFailed \/ pumpControlFailed)
	}
	transition t16 {
