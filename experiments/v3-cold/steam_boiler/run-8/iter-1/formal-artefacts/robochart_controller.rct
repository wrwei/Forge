		condition not ( successiveStopCount >= stopRepetitions \/ transmissionFailed \/ levelLowerBound - maximumSteamOutflow <= minLimitLevel \/ waterLevel > maxNormalLevel /\ levelUpperBound - minimumSteamOutflow >= maxLimitLevel \/ not ( waterLevel > maxNormalLevel ) /\ levelUpperBound + maximumPumpInflow - minimumSteamOutflow >= maxLimitLevel \/ levelDeviceFailed /\ (steamDeviceFailed \/ pumpControlFailed) ) /\ levelDeviceFailed /\ waterLevel < minNormalLevel /\ not ( waterLevel > maxNormalLevel )
