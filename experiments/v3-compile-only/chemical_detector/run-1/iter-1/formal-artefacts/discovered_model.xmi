          <packageRef isImplicit="true" name="chemical_detector.annotation"/>
        </annotationType>
      </annotation>
      <comment xsi:type="spoon:CtJavaDoc" commentContent="Cycles without an event that let either subsystem settle (its longest autonomous chain is 2)."/>
      <modifier>PRIVATE</modifier>
      <modifier>FINAL</modifier>
      <modifier>STATIC</modifier>
      <type name="int"/>
      <assignment xsi:type="spoon:CtLiteral" value="3" valueKind="Integer">
        <type name="int"/>
      </assignment>
    </typeMember>
