                <argumentType name="InputEvent">
                  <packageRef name="chemical_detector.event"/>
                </argumentType>
                <declaringType name="MovementController">
                  <packageRef name="chemical_detector.controller"/>
                </declaringType>
              </executableRef>
              <argument xsi:type="spoon:CtVariableRead">
                <type name="InputEvent">
                  <packageRef name="chemical_detector.event"/>
                </type>
                <variable xsi:type="spoon:CtParameterReference" name="input"/>
              </argument>
            </statement>
            <statement xsi:type="spoon:CtInvocation">
              <type name="void"/>
              <target xsi:type="spoon:CtThisAccess" isImplicit="true">
                <type name="ChemicalDetectorSystem">
                  <packageRef name="chemical_detector"/>
                </type>
                <target xsi:type="spoon:CtTypeAccess">
                  <type name="void"/>
                  <accessedType name="ChemicalDetectorSystem">
                    <packageRef name="chemical_detector"/>
                  </accessedType>
                </target>
              </target>
              <executableRef name="settleMovement">
                <declaringType name="ChemicalDetectorSystem">
                  <packageRef name="chemical_detector"/>
                </declaringType>
              </executableRef>
            </statement>
          </else>
          <condition xsi:type="spoon:CtBinaryOperator" operatorKind="INSTANCEOF">
            <type name="boolean"/>
            <leftOperand xsi:type="spoon:CtVariableRead">
              <type name="InputEvent">
                <packageRef name="chemical_detector.event"/>
