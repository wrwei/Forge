    <typeMember xsi:type="spoon:CtMethod" name="gasAnalysis">
      <comment xsi:type="spoon:CtJavaDoc" commentContent="The gas-analysis subsystem."/>
      <modifier>PUBLIC</modifier>
      <body xsi:type="spoon:CtBlock">
        <statement xsi:type="spoon:CtReturn">
          <expression xsi:type="spoon:CtFieldRead">
            <type name="GasAnalysisController">
              <packageRef name="chemical_detector.controller"/>
            </type>
