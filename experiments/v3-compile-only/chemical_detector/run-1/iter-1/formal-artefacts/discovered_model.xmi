    <typeMember xsi:type="spoon:CtMethod" name="dispatch">
      <comment xsi:type="spoon:CtJavaDoc" commentContent="Delivers one event from the Vehicle: a gas reading to the gas-analysis&#xA;subsystem, any other event to the movement subsystem; then runs the&#xA;cycles without an event that complete the resulting behaviour."/>
      <modifier>PUBLIC</modifier>
      <body xsi:type="spoon:CtBlock">
        <statement xsi:type="spoon:CtIf">
          <else xsi:type="spoon:CtBlock">
            <statement xsi:type="spoon:CtInvocation">
              <type name="void"/>
              <target xsi:type="spoon:CtFieldRead">
