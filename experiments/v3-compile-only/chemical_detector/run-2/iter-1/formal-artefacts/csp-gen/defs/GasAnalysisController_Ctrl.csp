					stm_ref0::set_EXT_gs,stm_ref0::set_EXT_sts,stm_ref0::set_EXT_ins,stm_ref0::set_EXT_anl,stm_ref0::set_EXT_distance,stm_ref0::set_EXT_obstacleSide,stm_ref0::set_EXT_speed,stm_ref0::set_EXT_heading,stm_ref0::set_EXT_peakAtOrAboveThreshold,stm_ref0::set_EXT_distanceTravelled
				|}
			)
			[|{|terminate|}|>SKIP
			))
		
			HEXT(id__,
					    const_GasAnalysisController_Ctrl_lv,
					    const_GasAnalysisController_Ctrl_evadeTime,
					    const_GasAnalysisController_Ctrl_stuckPeriod,
					    const_GasAnalysisController_Ctrl_stuckDist,
					    const_GasAnalysisController_Ctrl_outPeriod) = O__(id__,
