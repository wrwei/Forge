			channel get_escapeVelocity, set_escapeVelocity, setL_escapeVelocity, setR_escapeVelocity: core_real
			channel get_escapeRight, set_escapeRight, setL_escapeRight, setR_escapeRight: core_boolean
			channel get_escapeLeft, set_escapeLeft, setL_escapeLeft, setR_escapeLeft: core_boolean
			channel get_escapeBack, set_escapeBack, setL_escapeBack, setR_escapeBack: core_boolean
			channel get_commandedVelocity, set_commandedVelocity, setL_commandedVelocity, setR_commandedVelocity: core_real
			channel get_commandedAngle, set_commandedAngle, setL_commandedAngle, setR_commandedAngle: Angle
			channel get_unboundedWalkRequested, set_unboundedWalkRequested, setL_unboundedWalkRequested, setR_unboundedWalkRequested: core_boolean
			channel get_boundedWalkRequested, set_boundedWalkRequested, setL_boundedWalkRequested, setR_boundedWalkRequested: core_boolean
			channel get_distance, set_distance, setL_distance, setR_distance: core_real
			channel get_obstacleSide, set_obstacleSide, setL_obstacleSide, setR_obstacleSide: Loc
			channel get_speed, set_speed, setL_speed, setR_speed: core_nat
			channel get_heading, set_heading, setL_heading, setR_heading: Angle
			channel get_peakAtOrAboveThreshold, set_peakAtOrAboveThreshold, setL_peakAtOrAboveThreshold, setR_peakAtOrAboveThreshold: core_boolean
			channel get_distanceTravelled, set_distanceTravelled, setL_distanceTravelled, setR_distanceTravelled: core_real
			
			-- Shared variable channels
			channel set_EXT_escapeVelocity: core_real
			channel set_EXT_escapeRight: core_boolean
			channel set_EXT_escapeLeft: core_boolean
			channel set_EXT_escapeBack: core_boolean
			channel set_EXT_commandedVelocity: core_real
			channel set_EXT_commandedAngle: Angle
			channel set_EXT_unboundedWalkRequested: core_boolean
			channel set_EXT_boundedWalkRequested: core_boolean
			channel set_EXT_distance: core_real
