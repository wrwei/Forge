				HUP__(id__) = timed_priority(O__(id__) [|{share__}|] SKIP)
				
				-- Clocks
				
				Clocks(id__) = terminate -> SKIP
				
				clockSync = {||}
				
				
				StateClocks(id__) = terminate -> SKIP
				
				stateClockSync = {||}
				}
					endmodule
	
		-- declaring machines
		module stm_ref0
		exports
			transparent diamond
			transparent sbisim
			transparent dbisim
			transparent chase
		
			-- Transition identifiers
			-- declaring identifiers of transitions
			datatype NIDS = 
			              NID_Avoiding|
			              NID_AvoidingAgain|
			              NID_Halted|
			              NID_GettingOut|
			              NID_Waiting|
			              NID_Found|
			              NID_Going|
			              NID_TryingAgain|
			              NID_i0
			
			channel internal__ : NIDS
			
			-- Flow channels		
			channel interrupt
			channel exited
			channel exit
			channel terminate
			
			-- Variable channels
			channel get_v, set_v, setL_v, setR_v: core_real
			channel get_a, set_a, setL_a, setR_a: Angle
			channel get_d0, set_d0, setL_d0, setR_d0: core_real
			channel get_d1, set_d1, setL_d1, setR_d1: core_real
			channel get_l, set_l, setL_l, setR_l: Loc
			channel get_distance, set_distance, setL_distance, setR_distance: core_real
			channel get_obstacleSide, set_obstacleSide, setL_obstacleSide, setR_obstacleSide: Loc
			channel get_speed, set_speed, setL_speed, setR_speed: core_nat
			channel get_heading, set_heading, setL_heading, setR_heading: Angle
			channel get_peakAtOrAboveThreshold, set_peakAtOrAboveThreshold, setL_peakAtOrAboveThreshold, setR_peakAtOrAboveThreshold: core_boolean
			channel get_distanceTravelled, set_distanceTravelled, setL_distanceTravelled, setR_distanceTravelled: core_real
			
			-- Shared variable channels
			channel set_EXT_a: Angle
			channel set_EXT_d0: core_real
			channel set_EXT_d1: core_real
			channel set_EXT_l: Loc
			channel set_EXT_distance: core_real
			channel set_EXT_obstacleSide: Loc
			channel set_EXT_speed: core_nat
			channel set_EXT_heading: Angle
			channel set_EXT_peakAtOrAboveThreshold: core_boolean
			channel set_EXT_distanceTravelled: core_real
			
			-- Local variable channels for defined operations that are required by the state machine
			
			-- Declaring state machine events
			channel gas__: NIDS.InOut.LSeq(GasSensor,2)
			channel gas: InOut.LSeq(GasSensor,2)
			channel obstacle__: NIDS.InOut.Loc
			channel obstacle: InOut.Loc
			channel compute__: NIDS.InOut.Loc
			channel compute: InOut.Loc
			channel flag__: NIDS.InOut
			channel flag: InOut
			channel stop__: NIDS.InOut
			channel stop: InOut
			channel turn__: NIDS.InOut.Angle
			channel turn: InOut.Angle
			channel resume__: NIDS.InOut
			channel resume: InOut
			
			-- Declaring call and ret events for undefined operations
			channel computeCall: core_real.Angle
			
			enterSS = {|
			Avoiding::enter,
			AvoidingAgain::enter,
			Halted::enter,
			GettingOut::enter,
			Waiting::enter,
			Found::enter,
			Going::enter,
			TryingAgain::enter,
			i0::enter
			|}
			
			enteredSS = 	{|
			Avoiding::entered,
			AvoidingAgain::entered,
			Halted::entered,
			GettingOut::entered,
			Waiting::entered,
			Found::entered,
			Going::entered,
			TryingAgain::entered
			|}
			
			internal_events = union(enteredSS,union(enterSS,{|interrupt,exited|}))
			
			shared_variable_events = {|
				set_EXT_a,
				set_EXT_d0,
				set_EXT_d1,
				set_EXT_l,
				set_EXT_distance,
				set_EXT_obstacleSide,
				set_EXT_speed,
				set_EXT_heading,
				set_EXT_peakAtOrAboveThreshold,
				set_EXT_distanceTravelled
			|}
			
			-- channel set with all visible events
			sem__events = {|
				terminate
			,	set_EXT_a, set_a,
				set_EXT_d0, set_d0,
				set_EXT_d1, set_d1,
				set_EXT_l, set_l,
				set_EXT_distance, set_distance,
				set_EXT_obstacleSide, set_obstacleSide,
				set_EXT_speed, set_speed,
				set_EXT_heading, set_heading,
				set_EXT_peakAtOrAboveThreshold, set_peakAtOrAboveThreshold,
				set_EXT_distanceTravelled, set_distanceTravelled
			,	gas,
				obstacle,
				compute,
				flag,
				stop,
				turn,
				resume
			,	computeCall
				|}
			datatype ClockSet = 
				CLID_evasionStart
			
			channel clockReset, clockResetL, clockResetR : ClockSet
			
			localClockResets = {|clockReset.CLID_evasionStart|}
			
			
			channel get_CLID_Waiting : core_clock_type 
			channel get_CLID_Going : core_clock_type 
			channel get_CLID_GettingOut : core_clock_type 
			channel get_CLID_TryingAgain : core_clock_type 
			channel get_CLID_Halted : core_clock_type 
			channel get_CLID_evasionStart : core_clock_type 
