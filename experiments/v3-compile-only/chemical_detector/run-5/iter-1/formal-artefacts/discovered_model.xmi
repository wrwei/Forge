          <packageRef isImplicit="true" name="chemical_detector.event"/>
        </type>
      </parameter>
    </typeMember>
    <typeMember xsi:type="spoon:CtMethod" name="lastOutput">
      <comment xsi:type="spoon:CtJavaDoc" commentContent="The last command issued, or null before the first."/>
      <modifier>PUBLIC</modifier>
      <body xsi:type="spoon:CtBlock">
        <statement xsi:type="spoon:CtReturn">
          <expression xsi:type="spoon:CtFieldRead">
            <type name="OutputEvent">
              <packageRef name="chemical_detector.event"/>
            </type>
            <variable xsi:type="spoon:CtFieldReference" name="lastOutput">
