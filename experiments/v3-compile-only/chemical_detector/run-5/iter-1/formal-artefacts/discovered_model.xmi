              <declaringType name="VehicleActuator">
                <packageRef name="chemical_detector.actuator"/>
              </declaringType>
            </variable>
          </assigned>
        </statement>
        <statement xsi:type="spoon:CtAssignment">
          <type name="boolean"/>
          <assignment xsi:type="spoon:CtLiteral" value="false" valueKind="Boolean">
