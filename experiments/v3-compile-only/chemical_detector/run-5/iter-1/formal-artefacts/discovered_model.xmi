      <body xsi:type="spoon:CtBlock">
        <statement xsi:type="spoon:CtAssignment">
          <type name="OutputEvent">
            <packageRef name="chemical_detector.event"/>
          </type>
          <assignment xsi:type="spoon:CtVariableRead">
            <type name="OutputEvent">
              <packageRef name="chemical_detector.event"/>
            </type>
            <variable xsi:type="spoon:CtParameterReference" name="command"/>
          </assignment>
          <assigned xsi:type="spoon:CtFieldWrite">
            <type name="OutputEvent">
              <packageRef name="chemical_detector.event"/>
            </type>
            <target xsi:type="spoon:CtThisAccess">
              <type name="GasAnalysisActuator">
                <packageRef name="chemical_detector.actuator"/>
              </type>
              <target xsi:type="spoon:CtTypeAccess">
                <type name="void"/>
                <accessedType name="GasAnalysisActuator">
                  <packageRef name="chemical_detector.actuator"/>
                </accessedType>
              </target>
            </target>
            <variable xsi:type="spoon:CtFieldReference" name="lastOutput">
