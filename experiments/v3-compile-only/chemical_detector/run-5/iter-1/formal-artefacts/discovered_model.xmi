    <typeMember xsi:type="spoon:CtMethod" name="changeDirection">
      <comment xsi:type="spoon:CtJavaDoc" commentContent="Steers away from an obstacle at the given side, at velocity lv&#xA;(CD-OP4): left turns right, right turns left, front turns back."/>
      <modifier>PUBLIC</modifier>
      <body xsi:type="spoon:CtBlock">
        <statement xsi:type="spoon:CtIf">
          <else xsi:type="spoon:CtBlock" isImplicit="true">
            <statement xsi:type="spoon:CtIf">
              <else xsi:type="spoon:CtBlock">
                <statement xsi:type="spoon:CtInvocation">
                  <type name="void"/>
                  <target xsi:type="spoon:CtThisAccess" isImplicit="true">
                    <type name="VehicleActuator">
                      <packageRef name="chemical_detector.actuator"/>
                    </type>
                    <target xsi:type="spoon:CtTypeAccess">
                      <type name="void"/>
                      <accessedType name="VehicleActuator">
                        <packageRef name="chemical_detector.actuator"/>
                      </accessedType>
                    </target>
                  </target>
                  <executableRef name="move">
                    <argumentType name="double"/>
                    <argumentType name="Angle">
                      <packageRef name="chemical_detector.types"/>
                    </argumentType>
                    <declaringType name="VehicleActuator">
                      <packageRef name="chemical_detector.actuator"/>
                    </declaringType>
                  </executableRef>
                  <argument xsi:type="spoon:CtFieldRead">
                    <type name="double"/>
                    <variable xsi:type="spoon:CtFieldReference" name="LV" isFinal="true" isStatic="true">
                      <declaringType name="ChemicalDetectorConstants">
                        <packageRef name="chemical_detector.controller"/>
                      </declaringType>
                    </variable>
                    <target xsi:type="spoon:CtTypeAccess">
                      <type name="void"/>
                      <accessedType name="ChemicalDetectorConstants">
                        <packageRef isImplicit="true" name="chemical_detector.controller"/>
                      </accessedType>
                    </target>
                  </argument>
                  <argument xsi:type="spoon:CtFieldRead">
                    <type name="Angle">
                      <packageRef name="chemical_detector.types"/>
                    </type>
                    <variable xsi:type="spoon:CtFieldReference" name="Back" isFinal="true" isStatic="true">
                      <declaringType name="Angle">
                        <packageRef name="chemical_detector.types"/>
                      </declaringType>
                    </variable>
                    <target xsi:type="spoon:CtTypeAccess">
                      <type name="void"/>
                      <accessedType name="Angle">
                        <packageRef isImplicit="true" name="chemical_detector.types"/>
                      </accessedType>
                    </target>
                  </argument>
                </statement>
              </else>
              <condition xsi:type="spoon:CtBinaryOperator" operatorKind="EQ">
                <type name="boolean"/>
                <leftOperand xsi:type="spoon:CtVariableRead">
                  <type name="Loc">
                    <packageRef name="chemical_detector.types"/>
                  </type>
                  <variable xsi:type="spoon:CtParameterReference" name="side"/>
                </leftOperand>
                <rightOperand xsi:type="spoon:CtFieldRead">
                  <type name="Loc">
                    <packageRef name="chemical_detector.types"/>
                  </type>
                  <variable xsi:type="spoon:CtFieldReference" name="right" isFinal="true" isStatic="true">
                    <declaringType name="Loc">
                      <packageRef name="chemical_detector.types"/>
                    </declaringType>
                  </variable>
                  <target xsi:type="spoon:CtTypeAccess">
                    <type name="void"/>
                    <accessedType name="Loc">
                      <packageRef isImplicit="true" name="chemical_detector.types"/>
                    </accessedType>
                  </target>
                </rightOperand>
              </condition>
              <then xsi:type="spoon:CtBlock">
                <statement xsi:type="spoon:CtInvocation">
                  <type name="void"/>
                  <target xsi:type="spoon:CtThisAccess" isImplicit="true">
                    <type name="VehicleActuator">
                      <packageRef name="chemical_detector.actuator"/>
                    </type>
                    <target xsi:type="spoon:CtTypeAccess">
                      <type name="void"/>
                      <accessedType name="VehicleActuator">
                        <packageRef name="chemical_detector.actuator"/>
                      </accessedType>
                    </target>
                  </target>
                  <executableRef name="move">
                    <argumentType name="double"/>
                    <argumentType name="Angle">
                      <packageRef name="chemical_detector.types"/>
                    </argumentType>
                    <declaringType name="VehicleActuator">
                      <packageRef name="chemical_detector.actuator"/>
                    </declaringType>
                  </executableRef>
                  <argument xsi:type="spoon:CtFieldRead">
                    <type name="double"/>
                    <variable xsi:type="spoon:CtFieldReference" name="LV" isFinal="true" isStatic="true">
                      <declaringType name="ChemicalDetectorConstants">
                        <packageRef name="chemical_detector.controller"/>
                      </declaringType>
                    </variable>
                    <target xsi:type="spoon:CtTypeAccess">
                      <type name="void"/>
                      <accessedType name="ChemicalDetectorConstants">
                        <packageRef isImplicit="true" name="chemical_detector.controller"/>
                      </accessedType>
                    </target>
                  </argument>
                  <argument xsi:type="spoon:CtFieldRead">
                    <type name="Angle">
                      <packageRef name="chemical_detector.types"/>
                    </type>
                    <variable xsi:type="spoon:CtFieldReference" name="Left" isFinal="true" isStatic="true">
                      <declaringType name="Angle">
                        <packageRef name="chemical_detector.types"/>
