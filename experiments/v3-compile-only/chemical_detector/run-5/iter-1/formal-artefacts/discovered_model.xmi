      </body>
      <type name="OutputEvent">
        <packageRef isImplicit="true" name="chemical_detector.event"/>
      </type>
    </typeMember>
  </spoon:CtClass>
  <spoon:CtClass name="VehicleActuator">
    <comment xsi:type="spoon:CtJavaDoc" commentContent="The Vehicle's actuation surface: the flag signal and the movement&#xA;operations (CD-OP1 to CD-OP4). Records the last command of each kind."/>
