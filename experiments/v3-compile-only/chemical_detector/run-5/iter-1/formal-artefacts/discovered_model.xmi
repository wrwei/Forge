  <spoon:CtClass name="GasAnalysisActuator">
    <comment xsi:type="spoon:CtJavaDoc" commentContent="Receives the gas-analysis subsystem's commands to the movement subsystem&#xA;(turn, stop, resume) and records the last one issued."/>
    <modifier>PUBLIC</modifier>
    <modifier>FINAL</modifier>
    <typeMember xsi:type="spoon:CtConstructor" isImplicit="true" name="&lt;init>">
      <modifier>PUBLIC</modifier>
      <body xsi:type="spoon:CtBlock">
        <statement xsi:type="spoon:CtInvocation" isImplicit="true">
          <type name="Object">
            <packageRef name="java.lang"/>
          </type>
          <executableRef isImplicit="true" name="&lt;init>">
            <declaringType name="Object">
              <packageRef name="java.lang"/>
            </declaringType>
          </executableRef>
        </statement>
      </body>
      <type name="GasAnalysisActuator">
        <packageRef name="chemical_detector.actuator"/>
      </type>
    </typeMember>
    <typeMember xsi:type="spoon:CtField" name="lastOutput">
      <modifier>PRIVATE</modifier>
      <type name="OutputEvent">
        <packageRef isImplicit="true" name="chemical_detector.event"/>
      </type>
    </typeMember>
    <typeMember xsi:type="spoon:CtMethod" name="apply">
      <comment xsi:type="spoon:CtJavaDoc" commentContent="Issues a command to the movement subsystem."/>
