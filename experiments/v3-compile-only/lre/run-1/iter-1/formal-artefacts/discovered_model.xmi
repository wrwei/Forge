    <typeMember xsi:type="spoon:CtMethod" name="apply">
      <comment xsi:type="spoon:CtJavaDoc" commentContent="Receives one output event from the LRE controller."/>
      <modifier>PUBLIC</modifier>
      <body xsi:type="spoon:CtBlock">
        <statement xsi:type="spoon:CtIf">
          <else xsi:type="spoon:CtBlock" isImplicit="true">
            <statement xsi:type="spoon:CtIf">
              <condition xsi:type="spoon:CtBinaryOperator" operatorKind="INSTANCEOF">
                <type name="boolean"/>
                <leftOperand xsi:type="spoon:CtVariableRead">
                  <type name="OutputEvent">
                    <packageRef name="lre.event"/>
                  </type>
                  <variable xsi:type="spoon:CtParameterReference" name="command"/>
                </leftOperand>
                <rightOperand xsi:type="spoon:CtTypeAccess">
                  <type name="void"/>
                  <accessedType name="advHdng">
                    <declaringType name="OutputEvent">
                      <packageRef isImplicit="true" name="lre.event"/>
                    </declaringType>
                  </accessedType>
                </rightOperand>
              </condition>
              <then xsi:type="spoon:CtBlock">
                <statement xsi:type="spoon:CtLocalVariable" name="headingAdvice">
                  <type name="advHdng">
                    <declaringType name="OutputEvent">
                      <packageRef isImplicit="true" name="lre.event"/>
                    </declaringType>
                  </type>
                  <assignment xsi:type="spoon:CtVariableRead">
                    <type name="OutputEvent">
                      <packageRef name="lre.event"/>
                    </type>
                    <cast name="advHdng">
                      <declaringType name="OutputEvent">
                        <packageRef isImplicit="true" name="lre.event"/>
                      </declaringType>
                    </cast>
                    <variable xsi:type="spoon:CtParameterReference" name="command"/>
                  </assignment>
                </statement>
                <statement xsi:type="spoon:CtAssignment">
                  <type name="double"/>
                  <assignment xsi:type="spoon:CtInvocation">
                    <type name="double"/>
                    <target xsi:type="spoon:CtVariableRead">
                      <type name="advHdng">
                        <declaringType name="OutputEvent">
                          <packageRef name="lre.event"/>
                        </declaringType>
                      </type>
                      <variable xsi:type="spoon:CtLocalVariableReference" name="headingAdvice"/>
                    </target>
                    <executableRef name="value">
                      <declaringType name="advHdng">
                        <declaringType name="OutputEvent">
                          <packageRef name="lre.event"/>
                        </declaringType>
                      </declaringType>
                    </executableRef>
                  </assignment>
                  <assigned xsi:type="spoon:CtFieldWrite">
                    <type name="double"/>
                    <target xsi:type="spoon:CtThisAccess">
                      <type name="Actuator">
                        <packageRef name="lre.actuator"/>
                      </type>
                      <target xsi:type="spoon:CtTypeAccess">
                        <type name="void"/>
                        <accessedType name="Actuator">
                          <packageRef name="lre.actuator"/>
                        </accessedType>
                      </target>
                    </target>
                    <variable xsi:type="spoon:CtFieldReference" name="advisedHeading">
                      <declaringType name="Actuator">
                        <packageRef name="lre.actuator"/>
                      </declaringType>
                    </variable>
                  </assigned>
                </statement>
              </then>
            </statement>
          </else>
          <condition xsi:type="spoon:CtBinaryOperator" operatorKind="INSTANCEOF">
            <type name="boolean"/>
            <leftOperand xsi:type="spoon:CtVariableRead">
              <type name="OutputEvent">
                <packageRef name="lre.event"/>
              </type>
              <variable xsi:type="spoon:CtParameterReference" name="command"/>
            </leftOperand>
            <rightOperand xsi:type="spoon:CtTypeAccess">
              <type name="void"/>
              <accessedType name="advVel">
                <declaringType name="OutputEvent">
                  <packageRef isImplicit="true" name="lre.event"/>
                </declaringType>
              </accessedType>
            </rightOperand>
          </condition>
          <then xsi:type="spoon:CtBlock">
            <statement xsi:type="spoon:CtLocalVariable" name="velocityAdvice">
              <type name="advVel">
                <declaringType name="OutputEvent">
                  <packageRef isImplicit="true" name="lre.event"/>
                </declaringType>
              </type>
              <assignment xsi:type="spoon:CtVariableRead">
                <type name="OutputEvent">
                  <packageRef name="lre.event"/>
                </type>
                <cast name="advVel">
                  <declaringType name="OutputEvent">
                    <packageRef isImplicit="true" name="lre.event"/>
                  </declaringType>
                </cast>
                <variable xsi:type="spoon:CtParameterReference" name="command"/>
              </assignment>
            </statement>
            <statement xsi:type="spoon:CtAssignment">
              <type name="double"/>
              <assignment xsi:type="spoon:CtInvocation">
                <type name="double"/>
