                  <packageRef name="chemical_detector.actuator"/>
                </accessedType>
              </target>
            </target>
          </expression>
        </statement>
      </body>
      <type name="Angle">
        <packageRef isImplicit="true" name="chemical_detector.domain"/>
      </type>
    </typeMember>
    <typeMember xsi:type="spoon:CtMethod" name="isStopSent">
