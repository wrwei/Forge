  <spoon:CtClass name="GasAnalysisOutput">
    <comment xsi:type="spoon:CtJavaDoc" commentContent="Receives the turn, stop and resume signals the gas-analysis subsystem sends&#xA;to the movement subsystem; records the last direction sent and whether&#xA;stop has been sent."/>
    <modifier>PUBLIC</modifier>
    <modifier>FINAL</modifier>
    <typeMember xsi:type="spoon:CtConstructor" isImplicit="true" name="&lt;init>">
      <modifier>PUBLIC</modifier>
