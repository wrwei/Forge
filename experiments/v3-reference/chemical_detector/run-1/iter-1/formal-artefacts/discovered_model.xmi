    </typeMember>
    <typeMember xsi:type="spoon:CtField" name="stopSent">
      <modifier>PRIVATE</modifier>
      <type name="boolean"/>
      <assignment xsi:type="spoon:CtLiteral" value="false" valueKind="Boolean">
        <type name="boolean"/>
      </assignment>
    </typeMember>
    <typeMember xsi:type="spoon:CtMethod" name="apply">
      <comment xsi:type="spoon:CtJavaDoc" commentContent="Sends a signal to the movement subsystem."/>
      <modifier>PUBLIC</modifier>
      <body xsi:type="spoon:CtBlock">
        <statement xsi:type="spoon:CtIf">
          <else xsi:type="spoon:CtBlock" isImplicit="true">
            <statement xsi:type="spoon:CtIf">
              <condition xsi:type="spoon:CtBinaryOperator" operatorKind="INSTANCEOF">
                <type name="boolean"/>
                <leftOperand xsi:type="spoon:CtVariableRead">
                  <type name="OutputEvent">
                    <packageRef name="chemical_detector.event"/>
                  </type>
                  <variable xsi:type="spoon:CtParameterReference" name="signal"/>
                </leftOperand>
                <rightOperand xsi:type="spoon:CtTypeAccess">
                  <type name="void"/>
                  <accessedType name="Stop">
                    <declaringType name="OutputEvent">
                      <packageRef isImplicit="true" name="chemical_detector.event"/>
                    </declaringType>
                  </accessedType>
                </rightOperand>
              </condition>
              <then xsi:type="spoon:CtBlock">
                <statement xsi:type="spoon:CtAssignment">
                  <type name="boolean"/>
                  <assignment xsi:type="spoon:CtLiteral" value="true" valueKind="Boolean">
                    <type name="boolean"/>
                  </assignment>
                  <assigned xsi:type="spoon:CtFieldWrite">
                    <type name="boolean"/>
                    <target xsi:type="spoon:CtThisAccess">
                      <type name="GasAnalysisOutput">
                        <packageRef name="chemical_detector.actuator"/>
                      </type>
                      <target xsi:type="spoon:CtTypeAccess">
                        <type name="void"/>
                        <accessedType name="GasAnalysisOutput">
                          <packageRef name="chemical_detector.actuator"/>
                        </accessedType>
                      </target>
                    </target>
                    <variable xsi:type="spoon:CtFieldReference" name="stopSent">
                      <declaringType name="GasAnalysisOutput">
                        <packageRef name="chemical_detector.actuator"/>
                      </declaringType>
                    </variable>
                  </assigned>
                </statement>
              </then>
            </statement>
          </else>
          <condition xsi:type="spoon:CtBinaryOperator" operatorKind="INSTANCEOF">
            <type name="boolean"/>
            <leftOperand xsi:type="spoon:CtVariableRead">
              <type name="OutputEvent">
                <packageRef name="chemical_detector.event"/>
              </type>
              <variable xsi:type="spoon:CtParameterReference" name="signal"/>
            </leftOperand>
            <rightOperand xsi:type="spoon:CtTypeAccess">
              <type name="void"/>
              <accessedType name="Turn">
                <declaringType name="OutputEvent">
                  <packageRef isImplicit="true" name="chemical_detector.event"/>
                </declaringType>
              </accessedType>
            </rightOperand>
          </condition>
          <then xsi:type="spoon:CtBlock">
            <statement xsi:type="spoon:CtLocalVariable" name="turnSignal">
              <type name="Turn">
                <declaringType name="OutputEvent">
                  <packageRef isImplicit="true" name="chemical_detector.event"/>
                </declaringType>
              </type>
              <assignment xsi:type="spoon:CtVariableRead">
                <type name="OutputEvent">
                  <packageRef name="chemical_detector.event"/>
                </type>
                <cast name="Turn">
                  <declaringType name="OutputEvent">
                    <packageRef isImplicit="true" name="chemical_detector.event"/>
                  </declaringType>
                </cast>
                <variable xsi:type="spoon:CtParameterReference" name="signal"/>
              </assignment>
            </statement>
            <statement xsi:type="spoon:CtAssignment">
              <type name="Angle">
                <packageRef name="chemical_detector.domain"/>
              </type>
              <assignment xsi:type="spoon:CtInvocation">
                <type name="Angle">
                  <packageRef name="chemical_detector.domain"/>
                </type>
                <target xsi:type="spoon:CtVariableRead">
                  <type name="Turn">
                    <declaringType name="OutputEvent">
                      <packageRef name="chemical_detector.event"/>
                    </declaringType>
                  </type>
                  <variable xsi:type="spoon:CtLocalVariableReference" name="turnSignal"/>
                </target>
                <executableRef name="direction">
                  <declaringType name="Turn">
                    <declaringType name="OutputEvent">
                      <packageRef name="chemical_detector.event"/>
                    </declaringType>
                  </declaringType>
                </executableRef>
              </assignment>
              <assigned xsi:type="spoon:CtFieldWrite">
                <type name="Angle">
                  <packageRef name="chemical_detector.domain"/>
                </type>
                <target xsi:type="spoon:CtThisAccess">
                  <type name="GasAnalysisOutput">
                    <packageRef name="chemical_detector.actuator"/>
                  </type>
                  <target xsi:type="spoon:CtTypeAccess">
                    <type name="void"/>
                    <accessedType name="GasAnalysisOutput">
                      <packageRef name="chemical_detector.actuator"/>
                    </accessedType>
                  </target>
                </target>
                <variable xsi:type="spoon:CtFieldReference" name="lastTurn">
                  <declaringType name="GasAnalysisOutput">
                    <packageRef name="chemical_detector.actuator"/>
                  </declaringType>
                </variable>
              </assigned>
            </statement>
          </then>
        </statement>
      </body>
      <type name="void"/>
      <parameter name="signal">
        <type name="OutputEvent">
          <packageRef isImplicit="true" name="chemical_detector.event"/>
        </type>
      </parameter>
    </typeMember>
    <typeMember xsi:type="spoon:CtMethod" name="lastTurn">
      <comment xsi:type="spoon:CtJavaDoc" commentContent="Direction carried by the last turn signal sent."/>
      <modifier>PUBLIC</modifier>
      <body xsi:type="spoon:CtBlock">
        <statement xsi:type="spoon:CtReturn">
          <expression xsi:type="spoon:CtFieldRead">
            <type name="Angle">
              <packageRef name="chemical_detector.domain"/>
            </type>
            <variable xsi:type="spoon:CtFieldReference" name="lastTurn">
