      <comment xsi:type="spoon:CtJavaDoc" commentContent="Delivers a Vehicle event: gas readings to gas analysis, obstacles to movement."/>
      <modifier>PUBLIC</modifier>
      <body xsi:type="spoon:CtBlock">
        <statement xsi:type="spoon:CtIf">
          <else xsi:type="spoon:CtBlock" isImplicit="true">
            <statement xsi:type="spoon:CtIf">
              <condition xsi:type="spoon:CtBinaryOperator" operatorKind="INSTANCEOF">
                <type name="boolean"/>
                <leftOperand xsi:type="spoon:CtVariableRead">
                  <type name="InputEvent">
                    <packageRef name="chemical_detector.event"/>
