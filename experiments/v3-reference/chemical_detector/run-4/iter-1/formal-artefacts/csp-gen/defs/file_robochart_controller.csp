	channel get_direction, set_direction, setL_direction, setR_direction: Angle
	channel get_unboundedWalk, set_unboundedWalk, setL_unboundedWalk, setR_unboundedWalk: core_boolean
	channel get_boundedWalk, set_boundedWalk, setL_boundedWalk, setR_boundedWalk: core_boolean
	channel get_id, set_id, setL_id, setR_id: core_int
	channel get_side, set_side, setL_side, setR_side: Loc
	channel get_speed, set_speed, setL_speed, setR_speed: core_nat
	channel get_heading, set_heading, setL_heading, setR_heading: Angle
	channel get_peakAtOrAboveThr, set_peakAtOrAboveThr, setL_peakAtOrAboveThr, setR_peakAtOrAboveThr: core_boolean
	channel get_odometer, set_odometer, setL_odometer, setR_odometer: core_real
	
	-- Shared variable channels
	channel set_EXT_evadeVelocity: core_real
	channel set_EXT_turnRight: core_boolean
	channel set_EXT_turnLeft: core_boolean
	channel set_EXT_turnBack: core_boolean
	channel set_EXT_velocity: core_real
	channel set_EXT_direction: Angle
	channel set_EXT_unboundedWalk: core_boolean
	channel set_EXT_boundedWalk: core_boolean
