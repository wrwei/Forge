				enterSS = {|
				AvoidingAgain::enter,
				Going::enter,
				Found::enter,
				TryingAgain::enter,
				Waiting::enter,
				Avoiding::enter,
				GettingOut::enter,
				i0::enter
				|}
				
				enteredSS = 	{|
				AvoidingAgain::entered,
				Going::entered,
				Found::entered,
				TryingAgain::entered,
				Waiting::entered,
				Avoiding::entered,
				GettingOut::entered
				|}
				
				internal_events = union(enteredSS,union(enterSS,{|interrupt,exited|}))
				
				shared_variable_events = {|
					set_EXT_a,
					set_EXT_d0,
					set_EXT_d1,
					set_EXT_l,
					set_EXT_id,
					set_EXT_side,
					set_EXT_speed,
					set_EXT_heading,
					set_EXT_peakAtOrAboveThr,
					set_EXT_odometer
				|}
				
				-- channel set with all visible events
				sem__events = {|
					terminate
				,	set_EXT_a, set_a,
					set_EXT_d0, set_d0,
					set_EXT_d1, set_d1,
					set_EXT_l, set_l,
