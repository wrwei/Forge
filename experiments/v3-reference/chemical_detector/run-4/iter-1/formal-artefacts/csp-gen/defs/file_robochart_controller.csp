				Memory_v(0)
			)\{|get_v,set_v|}
		)
		)
	
	-- END
	
	-- Memory
	-- Memory variables
	Memory_v(v) =
		get_v!v -> Memory_v(v)
		[]
		set_v?x__ -> Memory_v(x__)
		[]
		terminate -> SKIP
	
	-- varMemory process
	varMemory(id__,
			    const_GasAnalysisController_lv,
			    const_GasAnalysisController_evadeTime,
			    const_GasAnalysisController_stuckPeriod,
			    const_GasAnalysisController_stuckDist,
			    const_GasAnalysisController_outPeriod) = Memory_v(0)
	
	getsetLocalChannels = {|get_v,set_v|}
	
	-- Definition of the behaviour of state machines (default, optimised, visible, visible and optimised)
	FVS__(id__,
			    const_GasAnalysisController_lv,
			    const_GasAnalysisController_evadeTime,
			    const_GasAnalysisController_stuckPeriod,
			    const_GasAnalysisController_stuckDist,
