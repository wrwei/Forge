module GasAnalysisController
exports
	transparent diamond
	transparent sbisim
	transparent dbisim
	transparent chase

	-- Transition identifiers
	-- declaring identifiers of transitions
	datatype NIDS = 
	              NID_GasDetected|
	              NID_NoGas|
	              NID_Analysis|
	              NID_Reading|
	              NID_Concluded|
	              NID_i0
	
	channel internal__ : NIDS
	
	-- Flow channels		
	channel interrupt
	channel exited
	channel exit
	channel terminate
	
	-- Variable channels
	channel get_v, set_v, setL_v, setR_v: core_real
	channel get_gs, set_gs, setL_gs, setR_gs: LSeq(GasSample,2)
	channel get_sts, set_sts, setL_sts, setR_sts: Status
	channel get_ins, set_ins, setL_ins, setR_ins: core_real
	channel get_anl, set_anl, setL_anl, setR_anl: Angle
	channel get_id, set_id, setL_id, setR_id: core_int
	channel get_side, set_side, setL_side, setR_side: Loc
	channel get_speed, set_speed, setL_speed, setR_speed: core_nat
	channel get_heading, set_heading, setL_heading, setR_heading: Angle
	channel get_peakAtOrAboveThr, set_peakAtOrAboveThr, setL_peakAtOrAboveThr, setR_peakAtOrAboveThr: core_boolean
	channel get_odometer, set_odometer, setL_odometer, setR_odometer: core_real
	
	-- Shared variable channels
	channel set_EXT_gs: LSeq(GasSample,2)
	channel set_EXT_sts: Status
	channel set_EXT_ins: core_real
	channel set_EXT_anl: Angle
	channel set_EXT_id: core_int
	channel set_EXT_side: Loc
	channel set_EXT_speed: core_nat
	channel set_EXT_heading: Angle
	channel set_EXT_peakAtOrAboveThr: core_boolean
	channel set_EXT_odometer: core_real
	
	-- Local variable channels for defined operations that are required by the state machine
	
	-- Declaring state machine events
	channel gas__: NIDS.InOut.LSeq(GasSample,2)
	channel gas: InOut.LSeq(GasSample,2)
	channel obstacle__: NIDS.InOut.Loc
	channel obstacle: InOut.Loc
	channel flag__: NIDS.InOut
	channel flag: InOut
	channel compute__: NIDS.InOut.Loc
	channel compute: InOut.Loc
	channel stop__: NIDS.InOut
	channel stop: InOut
	channel resume__: NIDS.InOut
	channel resume: InOut
	channel turn__: NIDS.InOut.Angle
	channel turn: InOut.Angle
	
	-- Declaring call and ret events for undefined operations
	
	enterSS = {|
	GasDetected::enter,
	NoGas::enter,
	Analysis::enter,
	Reading::enter,
	Concluded::enter,
	i0::enter
	|}
	
	enteredSS = 	{|
	GasDetected::entered,
	NoGas::entered,
	Analysis::entered,
	Reading::entered,
	Concluded::entered
	|}
	
	internal_events = union(enteredSS,union(enterSS,{|interrupt,exited|}))
	
	shared_variable_events = {|
		set_EXT_gs,
		set_EXT_sts,
		set_EXT_ins,
		set_EXT_anl,
		set_EXT_id,
		set_EXT_side,
		set_EXT_speed,
		set_EXT_heading,
		set_EXT_peakAtOrAboveThr,
		set_EXT_odometer
	|}
	
	-- channel set with all visible events
	sem__events = {|
		terminate
	,	set_EXT_gs, set_gs,
		set_EXT_sts, set_sts,
		set_EXT_ins, set_ins,
		set_EXT_anl, set_anl,
		set_EXT_id, set_id,
		set_EXT_side, set_side,
		set_EXT_speed, set_speed,
		set_EXT_heading, set_heading,
		set_EXT_peakAtOrAboveThr, set_peakAtOrAboveThr,
		set_EXT_odometer, set_odometer
	,	gas,
		obstacle,
		flag,
		compute,
		stop,
		resume,
		turn
		|}

	-- Nodes --
	-- declaring all nodes
	
	----------------------------------------------------------------------
	-- State: GasDetected
	module GasDetected
	
	enterSS = {}
	
	enteredSS = {}
	
	exports
	
		--  Declarations
		
		channel enter, entered, interrupt
		channel enteredL, enteredR
		
						
		
		--	Nodes
		-- declaring all nodes
		
		
		--	Rule: behaviours(Node)
		--  Note that FDR has problems with efficiently compiling the process below
		-- 	if using a different recursion pattern.
		D__(id__,
				    const_GasAnalysisController_lv,
				    const_GasAnalysisController_evadeTime,
				    const_GasAnalysisController_stuckPeriod,
				    const_GasAnalysisController_stuckDist,
				    const_GasAnalysisController_outPeriod) = 
		dbisim(let
			-- IMPLEMENTATION NOTE: 
			-- The following should be defined as: Inactive = share__choice(Activation [] Termination),
			-- however FDR struggles with that form in certain cases. So we use the exception operator
			-- instead to 'terminate'.
			
			Inactive 	= share__choice(enter -> SKIP [] terminate -> SKIP) ; Active
			
			Termination = terminate -> SKIP
			
			Active 		= share__choice(share__choice(get_gs?gs -> true & (share__choice(set_ins!intensity(gs) -> SKIP)))) ; 
					 	  Behaviour ; 
					 	  share__choice(exit -> SKIP) ; SKIP ; 
					 	  share__choice(exited -> SKIP) ; Inactive
		
			Behaviour 	= entered -> During
			During 		= ((SKIP ; SStop) /\ interrupt -> SKIP)
		within
			Inactive [| {terminate} |> SKIP)
			
		VS_O__(id__,
				    const_GasAnalysisController_lv,
				    const_GasAnalysisController_evadeTime,
				    const_GasAnalysisController_stuckPeriod,
				    const_GasAnalysisController_stuckDist,
				    const_GasAnalysisController_outPeriod) = 
		dbisim(let
			Inactive 	= share__choice(enter -> SKIP [] terminate -> SKIP) ; Active
			
			Termination = terminate -> SKIP
			
			Active 		= share__choice(share__choice(get_gs?gs -> true & (share__choice(set_ins!intensity(gs) -> SKIP)))) ; 
					 	  Behaviour ; 
					 	  share__choice(exit -> SKIP) ; SKIP ; 
					 	  share__choice(exited -> SKIP) ; Inactive
		
			Behaviour 	= entered -> During
			During 		= ((SKIP ; SStop) /\ interrupt -> SKIP)
		within
			Inactive [| {terminate} |> SKIP)
		
	
	endmodule
	----------------------------------------------------------------------
	
	
	----------------------------------------------------------------------
	-- State: NoGas
	module NoGas
	
	enterSS = {}
	
	enteredSS = {}
	
	exports
	
		--  Declarations
		
		channel enter, entered, interrupt
		channel enteredL, enteredR
		
						
		
		--	Nodes
		-- declaring all nodes
		
		
		--	Rule: behaviours(Node)
		--  Note that FDR has problems with efficiently compiling the process below
		-- 	if using a different recursion pattern.
		D__(id__,
				    const_GasAnalysisController_lv,
				    const_GasAnalysisController_evadeTime,
				    const_GasAnalysisController_stuckPeriod,
				    const_GasAnalysisController_stuckDist,
				    const_GasAnalysisController_outPeriod) = 
		dbisim(let
			-- IMPLEMENTATION NOTE: 
			-- The following should be defined as: Inactive = share__choice(Activation [] Termination),
			-- however FDR struggles with that form in certain cases. So we use the exception operator
			-- instead to 'terminate'.
			
			Inactive 	= share__choice(enter -> SKIP [] terminate -> SKIP) ; Active
			
			Termination = terminate -> SKIP
			
			Active 		= true&(share__choice(resume.out -> SKIP)) ; 
					 	  Behaviour ; 
					 	  share__choice(exit -> SKIP) ; SKIP ; 
					 	  share__choice(exited -> SKIP) ; Inactive
		
			Behaviour 	= entered -> During
			During 		= ((SKIP ; SStop) /\ interrupt -> SKIP)
		within
			Inactive [| {terminate} |> SKIP)
			
		VS_O__(id__,
				    const_GasAnalysisController_lv,
				    const_GasAnalysisController_evadeTime,
				    const_GasAnalysisController_stuckPeriod,
				    const_GasAnalysisController_stuckDist,
				    const_GasAnalysisController_outPeriod) = 
		dbisim(let
			Inactive 	= share__choice(enter -> SKIP [] terminate -> SKIP) ; Active
			
			Termination = terminate -> SKIP
			
			Active 		= true&(share__choice(resume.out -> SKIP)) ; 
					 	  Behaviour ; 
					 	  share__choice(exit -> SKIP) ; SKIP ; 
					 	  share__choice(exited -> SKIP) ; Inactive
		
			Behaviour 	= entered -> During
			During 		= ((SKIP ; SStop) /\ interrupt -> SKIP)
		within
			Inactive [| {terminate} |> SKIP)
		
	
	endmodule
