			    const_GasAnalysisController_evadeTime,
			    const_GasAnalysisController_stuckPeriod,
			    const_GasAnalysisController_stuckDist,
			    const_GasAnalysisController_outPeriod) = 
		dbisim((MachineBody_VS_O(id__,
				    const_GasAnalysisController_lv,
				    const_GasAnalysisController_evadeTime,
				    const_GasAnalysisController_stuckPeriod,
				    const_GasAnalysisController_stuckDist,
				    const_GasAnalysisController_outPeriod))
		)
	
	IteratedBehaviour_VS_O(id__,
			    const_GasAnalysisController_lv,
			    const_GasAnalysisController_evadeTime,
			    const_GasAnalysisController_stuckPeriod,
			    const_GasAnalysisController_stuckDist,
			    const_GasAnalysisController_outPeriod) = 
