		[]
		set_EXT_speed?x__ -> Memory_speed(x__)
		[]
		terminate -> SKIP
	Memory_heading(heading) =
		get_heading!heading -> Memory_heading(heading)
		[]
		set_heading?x__ -> Memory_heading(x__)
		[]
		set_EXT_heading?x__ -> Memory_heading(x__)
		[]
		terminate -> SKIP
	Memory_peakAtOrAboveThr(peakAtOrAboveThr) =
		get_peakAtOrAboveThr!peakAtOrAboveThr -> Memory_peakAtOrAboveThr(peakAtOrAboveThr)
		[]
		set_peakAtOrAboveThr?x__ -> Memory_peakAtOrAboveThr(x__)
		[]
		set_EXT_peakAtOrAboveThr?x__ -> Memory_peakAtOrAboveThr(x__)
		[]
		terminate -> SKIP
	Memory_odometer(odometer) =
		get_odometer!odometer -> Memory_odometer(odometer)
		[]
		set_odometer?x__ -> Memory_odometer(x__)
		[]
		set_EXT_odometer?x__ -> Memory_odometer(x__)
		[]
		terminate -> SKIP
	
	-- sharedVarMemory process
	sharedVarMemory(id__,
			    const_GasAnalysisController_lv,
			    const_GasAnalysisController_evadeTime,
			    const_GasAnalysisController_stuckPeriod,
			    const_GasAnalysisController_stuckDist,
			    const_GasAnalysisController_outPeriod) = Memory_gs(<>)
	[| { terminate } |] (
	Memory_sts(Status_noGas)
	[| { terminate } |] (
	Memory_ins(0)
	[| { terminate } |] (
	Memory_anl(Angle_Left)
	[| { terminate } |] (
	Memory_id(0)
	[| { terminate } |] (
	Memory_side(Loc_left)
	[| { terminate } |] (
	Memory_speed(0)
	[| { terminate } |] (
	Memory_heading(Angle_Left)
	[| { terminate } |] (
	Memory_peakAtOrAboveThr(true)
	[| { terminate } |] (
	Memory_odometer(0)
	)
	)
	)
	)
	)
	)
	)
	)
	)
	
	sharedVarSync = {|get_gs,set_gs,set_EXT_gs,get_sts,set_sts,set_EXT_sts,get_ins,set_ins,set_EXT_ins,get_anl,set_anl,set_EXT_anl,get_id,set_id,set_EXT_id,get_side,set_side,set_EXT_side,get_speed,set_speed,set_EXT_speed,get_heading,set_heading,set_EXT_heading,get_peakAtOrAboveThr,set_peakAtOrAboveThr,set_EXT_peakAtOrAboveThr,get_odometer,set_odometer,set_EXT_odometer|}
	
	sharedVarHide = {|get_gs,get_sts,get_ins,get_anl,get_id,get_side,get_speed,get_heading,get_peakAtOrAboveThr,get_odometer|}
endmodule
module MovementController
exports
	transparent diamond
	transparent sbisim
	transparent dbisim
	transparent chase

	-- Transition identifiers
	-- declaring identifiers of transitions
	datatype NIDS = 
	              NID_AvoidingAgain|
	              NID_Going|
	              NID_Found|
	              NID_TryingAgain|
	              NID_Waiting|
	              NID_Avoiding|
	              NID_GettingOut|
	              NID_i0
	
	channel internal__ : NIDS
	
	-- Flow channels		
	channel interrupt
	channel exited
	channel exit
	channel terminate
	
	-- Variable channels
	channel get_v, set_v, setL_v, setR_v: core_real
	channel get_a, set_a, setL_a, setR_a: Angle
	channel get_d0, set_d0, setL_d0, setR_d0: core_real
	channel get_d1, set_d1, setL_d1, setR_d1: core_real
	channel get_l, set_l, setL_l, setR_l: Loc
	channel get_id, set_id, setL_id, setR_id: core_int
	channel get_side, set_side, setL_side, setR_side: Loc
	channel get_speed, set_speed, setL_speed, setR_speed: core_nat
	channel get_heading, set_heading, setL_heading, setR_heading: Angle
	channel get_peakAtOrAboveThr, set_peakAtOrAboveThr, setL_peakAtOrAboveThr, setR_peakAtOrAboveThr: core_boolean
	channel get_odometer, set_odometer, setL_odometer, setR_odometer: core_real
	
	-- Shared variable channels
	channel set_EXT_a: Angle
	channel set_EXT_d0: core_real
	channel set_EXT_d1: core_real
	channel set_EXT_l: Loc
	channel set_EXT_id: core_int
	channel set_EXT_side: Loc
	channel set_EXT_speed: core_nat
	channel set_EXT_heading: Angle
	channel set_EXT_peakAtOrAboveThr: core_boolean
	channel set_EXT_odometer: core_real
	
	-- Local variable channels for defined operations that are required by the state machine
	
	-- Declaring state machine events
	channel gas__: NIDS.InOut.LSeq(GasSample,2)
	channel gas: InOut.LSeq(GasSample,2)
	channel obstacle__: NIDS.InOut.Loc
	channel obstacle: InOut.Loc
	channel flag__: NIDS.InOut
	channel flag: InOut
	channel compute__: NIDS.InOut.Loc
	channel compute: InOut.Loc
	channel stop__: NIDS.InOut
	channel stop: InOut
	channel resume__: NIDS.InOut
	channel resume: InOut
	channel turn__: NIDS.InOut.Angle
	channel turn: InOut.Angle
	
	-- Declaring call and ret events for undefined operations
	channel computeCall: core_real.Angle
	
	enterSS = {|
	AvoidingAgain::enter,
	Going::enter,
	Found::enter,
	TryingAgain::enter,
	Waiting::enter,
	Avoiding::enter,
	GettingOut::enter,
	i0::enter
	|}
	
	enteredSS = 	{|
	AvoidingAgain::entered,
	Going::entered,
	Found::entered,
	TryingAgain::entered,
	Waiting::entered,
	Avoiding::entered,
	GettingOut::entered
	|}
	
	internal_events = union(enteredSS,union(enterSS,{|interrupt,exited|}))
	
	shared_variable_events = {|
		set_EXT_a,
		set_EXT_d0,
		set_EXT_d1,
		set_EXT_l,
		set_EXT_id,
		set_EXT_side,
		set_EXT_speed,
		set_EXT_heading,
		set_EXT_peakAtOrAboveThr,
		set_EXT_odometer
	|}
	
	-- channel set with all visible events
	sem__events = {|
		terminate
	,	set_EXT_a, set_a,
		set_EXT_d0, set_d0,
		set_EXT_d1, set_d1,
		set_EXT_l, set_l,
		set_EXT_id, set_id,
		set_EXT_side, set_side,
		set_EXT_speed, set_speed,
		set_EXT_heading, set_heading,
		set_EXT_peakAtOrAboveThr, set_peakAtOrAboveThr,
		set_EXT_odometer, set_odometer
	,	gas,
		obstacle,
		flag,
		compute,
		stop,
		resume,
		turn
	,	computeCall
		|}

	-- Nodes --
	-- declaring all nodes
	
	----------------------------------------------------------------------
	-- State: AvoidingAgain
	module AvoidingAgain
	
	enterSS = {}
	
	enteredSS = {}
	
	exports
	
		--  Declarations
		
		channel enter, entered, interrupt
		channel enteredL, enteredR
		
						
		
		--	Nodes
		-- declaring all nodes
		
		
		--	Rule: behaviours(Node)
		--  Note that FDR has problems with efficiently compiling the process below
		-- 	if using a different recursion pattern.
		D__(id__,
				    const_MovementController_lv,
				    const_MovementController_evadeTime,
				    const_MovementController_stuckPeriod,
				    const_MovementController_stuckDist,
				    const_MovementController_outPeriod) = 
		dbisim(let
			-- IMPLEMENTATION NOTE: 
			-- The following should be defined as: Inactive = share__choice(Activation [] Termination),
			-- however FDR struggles with that form in certain cases. So we use the exception operator
			-- instead to 'terminate'.
			
			Inactive 	= share__choice(enter -> SKIP [] terminate -> SKIP) ; Active
			
			Termination = terminate -> SKIP
			
			Active 		= share__choice(share__choice(get_odometer?odometer -> true & (share__choice(set_d1!odometer -> SKIP)))) ; 
					 	  Behaviour ; 
					 	  share__choice(exit -> SKIP) ; SKIP ; 
					 	  share__choice(exited -> SKIP) ; Inactive
		
			Behaviour 	= entered -> During
			During 		= ((SKIP ; SStop) /\ interrupt -> SKIP)
		within
			Inactive [| {terminate} |> SKIP)
			
		VS_O__(id__,
				    const_MovementController_lv,
				    const_MovementController_evadeTime,
				    const_MovementController_stuckPeriod,
				    const_MovementController_stuckDist,
				    const_MovementController_outPeriod) = 
		dbisim(let
			Inactive 	= share__choice(enter -> SKIP [] terminate -> SKIP) ; Active
			
			Termination = terminate -> SKIP
			
			Active 		= share__choice(share__choice(get_odometer?odometer -> true & (share__choice(set_d1!odometer -> SKIP)))) ; 
					 	  Behaviour ; 
					 	  share__choice(exit -> SKIP) ; SKIP ; 
					 	  share__choice(exited -> SKIP) ; Inactive
		
			Behaviour 	= entered -> During
			During 		= ((SKIP ; SStop) /\ interrupt -> SKIP)
		within
			Inactive [| {terminate} |> SKIP)
		
	
	endmodule
