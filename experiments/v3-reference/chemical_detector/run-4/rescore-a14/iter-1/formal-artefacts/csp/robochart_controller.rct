diagram GasAnalysisController

enumeration Angle { Left Right Back Front }
enumeration Loc { left right front }
enumeration Status { noGas gasD }

datatype GasSample {
	c : Chem
	i : real
}

datatype Chem {
	id : int
}

function analysis ( gs : Seq(GasSample) ) : Status { }
function intensity ( gs : Seq(GasSample) ) : real { }
function location ( gs : Seq(GasSample) ) : Angle { }

interface LOperations {
	compute ( p0 : real , p1 : Angle )
}

interface Inputs {
	event gas : Seq(GasSample)
	event obstacle : Loc
}

interface Outputs {
	event flag
	event compute : Loc
}

interface Shared {
	event stop
	event resume
	event turn : Angle
}

interface Sensors {
	var id : int
	var side : Loc
	var speed : nat
	var heading : Angle
	var peakAtOrAboveThr : boolean
	var odometer : real
}

interface Actuators {
}

interface Ctrl_State_Shared {
	var evadeVelocity : real
	var turnRight : boolean
	var turnLeft : boolean
	var turnBack : boolean
	var velocity : real
	var direction : Angle
	var unboundedWalk : boolean
	var boundedWalk : boolean
}

interface GasAnalysisController_State {
	var gs : Seq(GasSample)
	var sts : Status
	var ins : real = 0
	var anl : Angle
}

interface MovementController_State {
	var a : Angle
	var d0 : real = 0
	var d1 : real = 0
	var l : Loc
}

interface Constants {
	const lv : real = 1
	const evadeTime : real = 2
	const stuckPeriod : real = 4
	const stuckDist : real = 1
	const outPeriod : real = 2
}

operation ChangeDirection ( ) {
	requires Ctrl_State_Shared requires Sensors requires Constants
	initial i0
	final f0
	transition t0 {
		from i0
		to f0
		action evadeVelocity = lv ; turnRight = ( side == left ) ; turnLeft = ( side == right ) ; turnBack = ( side == front )
	}
}

operation Move ( ) {
	requires Ctrl_State_Shared requires Sensors
	initial i0
	final f0
	transition t0 {
		from i0
		to f0
		action velocity = speed ; direction = heading
	}
}

operation RandomWalk ( ) {
	requires Ctrl_State_Shared requires Sensors
	initial i0
	final f0
	transition t0 {
		from i0
		to f0
		action unboundedWalk = true
	}
}

operation ShortRandomWalk ( ) {
	requires Ctrl_State_Shared requires Sensors
	initial i0
	final f0
	transition t0 {
		from i0
		to f0
		action boundedWalk = true
	}
}

stm GasAnalysisController {
	uses Inputs uses Outputs uses Shared requires GasAnalysisController_State requires Constants requires Sensors
	var v : real
	state GasDetected {
		entry ins = intensity ( gs )
	}
	state NoGas {
		entry send resume
	}
	state Analysis {
		entry sts = analysis ( gs )
	}
	state Reading {
	}
	state Concluded {
		entry send stop
	}
	initial i0
	transition t_init {
		from i0
		to Reading
	}
	transition t1 {
		from Reading
		to Analysis
		trigger gas ? gs
	}
	transition t2 {
		from Analysis
		to NoGas
		condition sts == noGas
	}
	transition t3 {
		from Analysis
		to GasDetected
		condition sts == gasD /\ not ( sts == noGas )
	}
	transition t4 {
		from NoGas
		to Reading
	}
	transition t5 {
		from GasDetected
		to Concluded
		condition peakAtOrAboveThr
	}
	transition t6 {
		from GasDetected
		to Reading
		condition not ( peakAtOrAboveThr )
		action anl = location ( gs ) ; turn ! anl
	}
}

controller GasAnalysisController_Ctrl {
	uses Inputs uses Outputs uses Shared requires GasAnalysisController_State requires Constants requires Sensors
	sref stm_ref0 = GasAnalysisController
	opref op_ref0 = ChangeDirection
	opref op_ref1 = Move
	opref op_ref2 = RandomWalk
	opref op_ref3 = ShortRandomWalk
	connection GasAnalysisController_Ctrl on gas to stm_ref0 on gas
	connection stm_ref0 on resume to GasAnalysisController_Ctrl on resume
	connection stm_ref0 on stop to GasAnalysisController_Ctrl on stop
	connection stm_ref0 on turn to GasAnalysisController_Ctrl on turn
}

stm MovementController {
	uses Inputs uses Outputs uses Shared requires MovementController_State requires Constants requires Sensors requires LOperations
	var v : real
	clock evasionTimer
	state AvoidingAgain {
		entry d1 = odometer
	}
	state Going {
		entry compute ( lv , a )
	}
	state Found {
		entry send flag ; compute ( 0 , Front )
	}
	state TryingAgain {
		entry compute ( lv , a )
	}
	state Waiting {
		entry send compute
	}
	state Avoiding {
		entry d0 = odometer ; compute ! l ; wait ( evadeTime )
	}
	state GettingOut {
		entry send compute ; wait ( outPeriod )
	}
	initial i0
	transition t_init {
		from i0
		to Waiting
	}
	transition t1 {
		from Waiting
		to Found
		trigger stop
	}
	transition t2 {
		from Waiting
		to Waiting
		trigger resume
	}
	transition t3 {
		from Waiting
		to Going
		trigger turn ? a
	}
	transition t4 {
		from Going
		to Found
		trigger stop
	}
	transition t5 {
		from Going
		to Waiting
		trigger resume
	}
	transition t6 {
		from Going
		to Going
		trigger turn ? a
	}
	transition t7 {
		from Going
		to Avoiding
		trigger obstacle ? l
		# evasionTimer
	}
	transition t8 {
		from Avoiding
		to Found
		trigger stop
	}
	transition t9 {
		from Avoiding
		to Waiting
		trigger resume
	}
	transition t10 {
		from Avoiding
		to TryingAgain
		trigger turn ? a
	}
	transition t11 {
		from TryingAgain
		to Found
		trigger stop
	}
	transition t12 {
		from TryingAgain
		to Waiting
		trigger resume
	}
	transition t13 {
		from TryingAgain
		to TryingAgain
		trigger turn ? a
	}
	transition t14 {
		from TryingAgain
		to AvoidingAgain
		trigger obstacle ? l
	}
	transition t15 {
		from AvoidingAgain
		to Found
		trigger stop
	}
	transition t16 {
		from AvoidingAgain
		to Waiting
		trigger resume
	}
	transition t17 {
		from AvoidingAgain
		to Avoiding
		# evasionTimer
		condition since ( evasionTimer ) < stuckPeriod \/ d1 - d0 > stuckDist
	}
	transition t18 {
		from AvoidingAgain
		to GettingOut
		condition not ( since ( evasionTimer ) < stuckPeriod \/ d1 - d0 > stuckDist )
	}
	transition t19 {
		from GettingOut
		to Found
		trigger stop
	}
	transition t20 {
		from GettingOut
		to Waiting
		trigger resume
	}
	transition t21 {
		from GettingOut
		to Going
		trigger turn ? a
	}
}

controller MovementController_Ctrl {
	uses Inputs uses Outputs uses Shared requires MovementController_State requires Constants requires Sensors requires LOperations
	sref stm_ref0 = MovementController
	opref op_ref0 = ChangeDirection
	opref op_ref1 = Move
	opref op_ref2 = RandomWalk
	opref op_ref3 = ShortRandomWalk
	connection MovementController_Ctrl on stop to stm_ref0 on stop
	connection MovementController_Ctrl on resume to stm_ref0 on resume
	connection MovementController_Ctrl on turn to stm_ref0 on turn
	connection MovementController_Ctrl on obstacle to stm_ref0 on obstacle
	connection stm_ref0 on flag to MovementController_Ctrl on flag
	connection stm_ref0 on compute to MovementController_Ctrl on compute
}

module GasAnalysisController_System_Module {
	robotic platform GasAnalysisController_System_Platform {
		provides Sensors provides Actuators provides Constants
		event gas : Seq(GasSample)
		event obstacle : Loc
		event flag
		event compute : Loc
	}
	cref ctrl_ref0 = GasAnalysisController_Ctrl
	cref ctrl_ref1 = MovementController_Ctrl
	connection GasAnalysisController_System_Platform on gas to ctrl_ref0 on gas
	connection GasAnalysisController_System_Platform on obstacle to ctrl_ref1 on obstacle
	connection ctrl_ref1 on flag to GasAnalysisController_System_Platform on flag
	connection ctrl_ref1 on compute to GasAnalysisController_System_Platform on compute
	connection ctrl_ref0 on stop to ctrl_ref1 on stop
	connection ctrl_ref0 on resume to ctrl_ref1 on resume
	connection ctrl_ref0 on turn to ctrl_ref1 on turn
}

