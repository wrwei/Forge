    <typeMember xsi:type="spoon:CtMethod" name="step">
      <comment xsi:type="spoon:CtJavaDoc" commentContent="Performs the analysis stage of one cycle. In normal, degraded and&#xA;rescue mode every cycle that does not stop the program also regulates&#xA;the pumps: all four open below N1, all four closed above N2. Within each&#xA;mode the guards are exhaustive, so the last branch, which keeps the&#xA;mode, needs no condition beyond the transmission itself."/>
      <modifier>PUBLIC</modifier>
      <body xsi:type="spoon:CtBlock">
        <statement xsi:type="spoon:CtLocalVariable" name="shutdownDemanded">
          <comment commentContent="What the cycle's transmission established."/>
          <type name="boolean"/>
          <assignment xsi:type="spoon:CtInvocation">
            <type name="boolean"/>
            <target xsi:type="spoon:CtFieldRead">
              <type name="BoilerSensor">
                <packageRef name="steam_boiler.sensor"/>
              </type>
              <variable xsi:type="spoon:CtFieldReference" name="sensor" isFinal="true">
                <declaringType name="SteamBoilerController">
                  <packageRef name="steam_boiler.controller"/>
                </declaringType>
              </variable>
              <target xsi:type="spoon:CtThisAccess" isImplicit="true">
                <type name="SteamBoilerController">
                  <packageRef name="steam_boiler.controller"/>
                </type>
                <target xsi:type="spoon:CtTypeAccess">
                  <type name="void"/>
                  <accessedType name="SteamBoilerController">
                    <packageRef name="steam_boiler.controller"/>
                  </accessedType>
                </target>
              </target>
            </target>
            <executableRef name="shutdownDemanded">
              <declaringType name="BoilerSensor">
                <packageRef name="steam_boiler.sensor"/>
              </declaringType>
