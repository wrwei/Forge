diagram SteamBoilerController

enumeration PumpPosition { PUMP_OFF PUMP_ON }
enumeration WaterFlow { NO_FLOW FLOW }
enumeration OperatingMode { INITIALISATION_MODE NORMAL_MODE DEGRADED_MODE RESCUE_MODE EMERGENCY_STOP_MODE }

datatype PumpControlReading {
	controllerIndex : int
	observation : WaterFlow
}

datatype PumpReading {
	pumpIndex : int
	position : PumpPosition
}

interface Inputs {
	event transmission
}

interface Outputs {
	event mode
	event valve
	event openPump : int
	event closePump : int
	event programReady
}

interface Sensors {
	var shutdownDemanded : boolean
	var plantWaiting : boolean
	var unitsReady : boolean
	var startUpFault : boolean
	var levelBelowNormal : boolean
	var levelAboveNormal : boolean
	var levelAtRisk : boolean
	var levelFailure : boolean
	var unitFailure : boolean
	var estimateUnreliable : boolean
	var levelAboveN2 : boolean
	var levelBelowN1 : boolean
}

interface Actuators {
}

interface SteamBoilerController_State {
	var valveOpen : boolean = false
	var programReadySent : boolean = false
}

interface Constants {
}

stm SteamBoilerController {
	uses Inputs uses Outputs requires SteamBoilerController_State requires Constants requires Sensors
	state NORMAL {
	}
	state INITIALISATION {
	}
	state EMERGENCY_STOP {
		entry send mode
	}
	state DEGRADED {
	}
	state RESCUE {
	}
	initial i0
	transition t_init {
		from i0
		to INITIALISATION
	}
	transition t1 {
		from INITIALISATION
		to EMERGENCY_STOP
		trigger transmission
		condition shutdownDemanded \/ plantWaiting /\ startUpFault
	}
	transition t2 {
		from INITIALISATION
		to INITIALISATION
		trigger transmission
		condition not ( shutdownDemanded ) /\ plantWaiting /\ not ( startUpFault ) /\ not ( programReadySent ) /\ levelAboveN2 /\ not ( valveOpen )
		action valveOpen = true ; send valve ; send mode
	}
	transition t3 {
		from INITIALISATION
		to INITIALISATION
		trigger transmission
		condition not ( shutdownDemanded ) /\ plantWaiting /\ not ( startUpFault ) /\ not ( programReadySent ) /\ levelAboveN2 /\ valveOpen
		action send mode
	}
	transition t4 {
		from INITIALISATION
		to INITIALISATION
		trigger transmission
		condition not ( shutdownDemanded ) /\ plantWaiting /\ not ( startUpFault ) /\ not ( programReadySent ) /\ levelBelowN1 /\ valveOpen
		action valveOpen = false ; send valve ; openPump ! 1 ; send mode
	}
	transition t5 {
		from INITIALISATION
		to INITIALISATION
		trigger transmission
		condition not ( shutdownDemanded ) /\ plantWaiting /\ not ( startUpFault ) /\ not ( programReadySent ) /\ levelBelowN1 /\ not ( valveOpen )
		action openPump ! 1 ; send mode
	}
	transition t6 {
		from INITIALISATION
		to INITIALISATION
		trigger transmission
		condition not ( shutdownDemanded ) /\ plantWaiting /\ not ( startUpFault ) /\ not ( programReadySent ) /\ not ( levelBelowN1 ) /\ not ( levelAboveN2 ) /\ valveOpen
		action valveOpen = false ; programReadySent = true ; send valve ; closePump ! 1 ; send programReady ; send mode
	}
	transition t7 {
		from INITIALISATION
		to INITIALISATION
		trigger transmission
		condition not ( shutdownDemanded ) /\ plantWaiting /\ not ( startUpFault ) /\ not ( programReadySent ) /\ not ( levelBelowN1 ) /\ not ( levelAboveN2 ) /\ not ( valveOpen )
		action programReadySent = true ; closePump ! 1 ; send programReady ; send mode
	}
	transition t8 {
		from INITIALISATION
		to INITIALISATION
		trigger transmission
		condition not ( shutdownDemanded ) /\ plantWaiting /\ not ( startUpFault ) /\ programReadySent /\ not ( unitsReady )
		action send programReady ; send mode
	}
	transition t9 {
		from INITIALISATION
		to NORMAL
		trigger transmission
		condition not ( shutdownDemanded ) /\ plantWaiting /\ not ( startUpFault ) /\ programReadySent /\ unitsReady /\ not ( unitFailure )
		action send mode
	}
	transition t10 {
		from INITIALISATION
		to DEGRADED
		trigger transmission
		condition not ( shutdownDemanded ) /\ plantWaiting /\ not ( startUpFault ) /\ programReadySent /\ unitsReady /\ unitFailure
		action send mode
	}
	transition t11 {
		from INITIALISATION
		to INITIALISATION
		trigger transmission
		action send mode
	}
	transition t12 {
		from NORMAL
		to EMERGENCY_STOP
		trigger transmission
		condition not ( not ( shutdownDemanded ) /\ not ( levelAtRisk ) ) \/ levelFailure /\ estimateUnreliable
	}
	transition t13 {
		from NORMAL
		to RESCUE
		trigger transmission
		condition not ( shutdownDemanded ) /\ not ( levelAtRisk ) /\ levelFailure /\ not ( estimateUnreliable ) /\ levelBelowN1
		action openPump ! 1 ; openPump ! 2 ; openPump ! 3 ; openPump ! 4 ; send mode
	}
	transition t14 {
		from NORMAL
		to RESCUE
		trigger transmission
		condition not ( shutdownDemanded ) /\ not ( levelAtRisk ) /\ levelFailure /\ not ( estimateUnreliable ) /\ levelAboveN2
		action closePump ! 1 ; closePump ! 2 ; closePump ! 3 ; closePump ! 4 ; send mode
	}
	transition t15 {
		from NORMAL
		to RESCUE
		trigger transmission
		condition not ( shutdownDemanded ) /\ not ( levelAtRisk ) /\ levelFailure /\ not ( estimateUnreliable ) /\ not ( levelBelowN1 ) /\ not ( levelAboveN2 )
		action send mode
	}
	transition t16 {
		from NORMAL
		to DEGRADED
		trigger transmission
		condition not ( shutdownDemanded ) /\ not ( levelAtRisk ) /\ not ( levelFailure ) /\ unitFailure /\ levelBelowN1
		action openPump ! 1 ; openPump ! 2 ; openPump ! 3 ; openPump ! 4 ; send mode
	}
	transition t17 {
		from NORMAL
		to DEGRADED
		trigger transmission
		condition not ( shutdownDemanded ) /\ not ( levelAtRisk ) /\ not ( levelFailure ) /\ unitFailure /\ levelAboveN2
		action closePump ! 1 ; closePump ! 2 ; closePump ! 3 ; closePump ! 4 ; send mode
	}
	transition t18 {
		from NORMAL
		to DEGRADED
		trigger transmission
		condition not ( shutdownDemanded ) /\ not ( levelAtRisk ) /\ not ( levelFailure ) /\ unitFailure /\ not ( levelBelowN1 ) /\ not ( levelAboveN2 )
		action send mode
	}
	transition t19 {
		from NORMAL
		to NORMAL
		trigger transmission
		condition not ( shutdownDemanded ) /\ not ( levelAtRisk ) /\ not ( levelFailure ) /\ not ( unitFailure ) /\ levelBelowN1
		action openPump ! 1 ; openPump ! 2 ; openPump ! 3 ; openPump ! 4 ; send mode
	}
	transition t20 {
		from NORMAL
		to NORMAL
		trigger transmission
		condition not ( shutdownDemanded ) /\ not ( levelAtRisk ) /\ not ( levelFailure ) /\ not ( unitFailure ) /\ levelAboveN2
		action closePump ! 1 ; closePump ! 2 ; closePump ! 3 ; closePump ! 4 ; send mode
	}
	transition t21 {
		from NORMAL
		to NORMAL
		trigger transmission
		action send mode
	}
	transition t22 {
		from DEGRADED
		to EMERGENCY_STOP
		trigger transmission
		condition not ( not ( shutdownDemanded ) /\ not ( levelAtRisk ) ) \/ levelFailure /\ estimateUnreliable
	}
	transition t23 {
		from DEGRADED
		to RESCUE
		trigger transmission
		condition not ( shutdownDemanded ) /\ not ( levelAtRisk ) /\ levelFailure /\ not ( estimateUnreliable ) /\ levelBelowN1
		action openPump ! 1 ; openPump ! 2 ; openPump ! 3 ; openPump ! 4 ; send mode
	}
	transition t24 {
		from DEGRADED
		to RESCUE
		trigger transmission
		condition not ( shutdownDemanded ) /\ not ( levelAtRisk ) /\ levelFailure /\ not ( estimateUnreliable ) /\ levelAboveN2
		action closePump ! 1 ; closePump ! 2 ; closePump ! 3 ; closePump ! 4 ; send mode
	}
	transition t25 {
		from DEGRADED
		to RESCUE
		trigger transmission
		condition not ( shutdownDemanded ) /\ not ( levelAtRisk ) /\ levelFailure /\ not ( estimateUnreliable ) /\ not ( levelBelowN1 ) /\ not ( levelAboveN2 )
		action send mode
	}
	transition t26 {
		from DEGRADED
		to NORMAL
		trigger transmission
		condition not ( shutdownDemanded ) /\ not ( levelAtRisk ) /\ not ( levelFailure ) /\ not ( unitFailure ) /\ levelBelowN1
		action openPump ! 1 ; openPump ! 2 ; openPump ! 3 ; openPump ! 4 ; send mode
	}
	transition t27 {
		from DEGRADED
		to NORMAL
		trigger transmission
		condition not ( shutdownDemanded ) /\ not ( levelAtRisk ) /\ not ( levelFailure ) /\ not ( unitFailure ) /\ levelAboveN2
		action closePump ! 1 ; closePump ! 2 ; closePump ! 3 ; closePump ! 4 ; send mode
	}
	transition t28 {
		from DEGRADED
		to NORMAL
		trigger transmission
		condition not ( shutdownDemanded ) /\ not ( levelAtRisk ) /\ not ( levelFailure ) /\ not ( unitFailure ) /\ not ( levelBelowN1 ) /\ not ( levelAboveN2 )
		action send mode
	}
	transition t29 {
		from DEGRADED
		to DEGRADED
		trigger transmission
		condition not ( shutdownDemanded ) /\ not ( levelAtRisk ) /\ not ( levelFailure ) /\ unitFailure /\ levelBelowN1
		action openPump ! 1 ; openPump ! 2 ; openPump ! 3 ; openPump ! 4 ; send mode
	}
	transition t30 {
		from DEGRADED
		to DEGRADED
		trigger transmission
		condition not ( shutdownDemanded ) /\ not ( levelAtRisk ) /\ not ( levelFailure ) /\ unitFailure /\ levelAboveN2
		action closePump ! 1 ; closePump ! 2 ; closePump ! 3 ; closePump ! 4 ; send mode
	}
	transition t31 {
		from DEGRADED
		to DEGRADED
		trigger transmission
		action send mode
	}
	transition t32 {
		from RESCUE
		to EMERGENCY_STOP
		trigger transmission
		condition not ( not ( shutdownDemanded ) /\ not ( levelAtRisk ) ) \/ estimateUnreliable
	}
	transition t33 {
		from RESCUE
		to NORMAL
		trigger transmission
		condition not ( shutdownDemanded ) /\ not ( levelAtRisk ) /\ not ( estimateUnreliable ) /\ not ( levelFailure ) /\ not ( unitFailure ) /\ levelBelowN1
		action openPump ! 1 ; openPump ! 2 ; openPump ! 3 ; openPump ! 4 ; send mode
	}
	transition t34 {
		from RESCUE
		to NORMAL
		trigger transmission
		condition not ( shutdownDemanded ) /\ not ( levelAtRisk ) /\ not ( estimateUnreliable ) /\ not ( levelFailure ) /\ not ( unitFailure ) /\ levelAboveN2
		action closePump ! 1 ; closePump ! 2 ; closePump ! 3 ; closePump ! 4 ; send mode
	}
	transition t35 {
		from RESCUE
		to NORMAL
		trigger transmission
		condition not ( shutdownDemanded ) /\ not ( levelAtRisk ) /\ not ( estimateUnreliable ) /\ not ( levelFailure ) /\ not ( unitFailure ) /\ not ( levelBelowN1 ) /\ not ( levelAboveN2 )
		action send mode
	}
	transition t36 {
		from RESCUE
		to DEGRADED
		trigger transmission
		condition not ( shutdownDemanded ) /\ not ( levelAtRisk ) /\ not ( estimateUnreliable ) /\ not ( levelFailure ) /\ unitFailure /\ levelBelowN1
		action openPump ! 1 ; openPump ! 2 ; openPump ! 3 ; openPump ! 4 ; send mode
	}
	transition t37 {
		from RESCUE
		to DEGRADED
		trigger transmission
		condition not ( shutdownDemanded ) /\ not ( levelAtRisk ) /\ not ( estimateUnreliable ) /\ not ( levelFailure ) /\ unitFailure /\ levelAboveN2
		action closePump ! 1 ; closePump ! 2 ; closePump ! 3 ; closePump ! 4 ; send mode
	}
	transition t38 {
		from RESCUE
		to DEGRADED
		trigger transmission
		condition not ( shutdownDemanded ) /\ not ( levelAtRisk ) /\ not ( estimateUnreliable ) /\ not ( levelFailure ) /\ unitFailure /\ not ( levelBelowN1 ) /\ not ( levelAboveN2 )
		action send mode
	}
	transition t39 {
		from RESCUE
		to RESCUE
		trigger transmission
		condition not ( shutdownDemanded ) /\ not ( levelAtRisk ) /\ not ( estimateUnreliable ) /\ levelFailure /\ levelBelowN1
		action openPump ! 1 ; openPump ! 2 ; openPump ! 3 ; openPump ! 4 ; send mode
	}
	transition t40 {
		from RESCUE
		to RESCUE
		trigger transmission
		condition not ( shutdownDemanded ) /\ not ( levelAtRisk ) /\ not ( estimateUnreliable ) /\ levelFailure /\ levelAboveN2
		action closePump ! 1 ; closePump ! 2 ; closePump ! 3 ; closePump ! 4 ; send mode
	}
	transition t41 {
		from RESCUE
		to RESCUE
		trigger transmission
		action send mode
	}
	transition t42 {
		from EMERGENCY_STOP
		to EMERGENCY_STOP
		trigger transmission
	}
}

controller SteamBoilerController_Ctrl {
	uses Inputs uses Outputs requires SteamBoilerController_State requires Constants requires Sensors
	sref stm_ref0 = SteamBoilerController
	connection SteamBoilerController_Ctrl on transmission to stm_ref0 on transmission
	connection stm_ref0 on mode to SteamBoilerController_Ctrl on mode
	connection stm_ref0 on valve to SteamBoilerController_Ctrl on valve
	connection stm_ref0 on openPump to SteamBoilerController_Ctrl on openPump
	connection stm_ref0 on closePump to SteamBoilerController_Ctrl on closePump
	connection stm_ref0 on programReady to SteamBoilerController_Ctrl on programReady
}

module SteamBoilerController_Module {
	robotic platform SteamBoilerController_Platform {
		provides Sensors provides Actuators provides Constants
		event transmission
		event mode
		event valve
		event openPump : int
		event closePump : int
		event programReady
	}
	cref ctrl_ref0 = SteamBoilerController_Ctrl
	connection SteamBoilerController_Platform on transmission to ctrl_ref0 on transmission
	connection ctrl_ref0 on mode to SteamBoilerController_Platform on mode
	connection ctrl_ref0 on valve to SteamBoilerController_Platform on valve
	connection ctrl_ref0 on openPump to SteamBoilerController_Platform on openPump
	connection ctrl_ref0 on closePump to SteamBoilerController_Platform on closePump
	connection ctrl_ref0 on programReady to SteamBoilerController_Platform on programReady
}

