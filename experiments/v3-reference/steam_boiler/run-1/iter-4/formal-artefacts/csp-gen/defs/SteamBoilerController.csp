					 			,setL_startUpAbort
					 			,setL_unitFailure
					 			,setL_emergencyCause
					 			,setL_startUpLevelReached
					 			,setL_unitsReady
					 			,setL_levelFailure
					 			,setL_programReadySent
					 			,setL_estimateUnreliable
					|}) |]
					 ((i0::enter -> Transitions(id__))
					  [[ share__ <- x__ | x__ <- {| share__,setL_startUpAbort,setL_unitFailure,setL_emergencyCause,setL_startUpLevelReached,setL_unitsReady,setL_levelFailure,setL_programReadySent,setL_estimateUnreliable |} ]]
					 )
					)[[setL_startUpAbort <- set_startUpAbort,setL_unitFailure <- set_unitFailure,setL_emergencyCause <- set_emergencyCause,setL_startUpLevelReached <- set_startUpLevelReached,setL_unitsReady <- set_unitsReady,setL_levelFailure <- set_levelFailure,setL_programReadySent <- set_programReadySent,setL_estimateUnreliable <- set_estimateUnreliable]]
					)
				)
				 \ hideSet)
				[[
					transmission__.x____ <- transmission,
					mode__.x____ <- mode,
					programReady__.x____ <- programReady
					| x____ <- NIDS
				]]
			)
			 [| {| interrupt |} |] SKIP)
		)
		)
	
	Behaviour(id__) = 
		dbisim((MachineBody(id__)\ enteredSS)
		)
	
	IteratedBehaviour(id__) = 
		dbisim((MachineBody(id__)\ enteredSS)
		)
	
	Stateful(id__) = 
		((
			(Behaviour(id__) [| union(getsetLocalChannels,{terminate}) |] varMemory(id__))
		 	\getsetLocalChannels
		)
		)
	
	IteratedStateful(id__) =
		(Behaviour(id__))
	
	-- Visible counterparts
	MachineBody_VS_O(id__) = 
		dbisim((
		let
			finalNodesEntered = {||}
		within
			((let
				-- IMPLEMENTATION NOTE:
				-- Here the 'enter' channel set is calculated explicitly because of the use of CSPM 
				-- modules for defining the semantics of each node.
				enterSS = {|
				EMERGENCY_STOP::enter,
				RESCUE::enter,
				DEGRADED::enter,
				NORMAL::enter,
				INITIALISATION::enter,
				i0::enter
				|}
				hideSet = union(enterSS,{|exit,exited,internal__|})
			within 
				((let
					-- IMPLEMENTATION NOTE: the channel set 'enter' is calculated explicitly
					-- because CSPM modules are used for the semantics of Node.
					flowevts = union(enterSS,{|exit,exited,interrupt|})
					transSync = {|internal__.NID_i0,transmission__.NID_INITIALISATION.in,transmission__.NID_INITIALISATION.in,transmission__.NID_INITIALISATION.in,transmission__.NID_INITIALISATION.in,transmission__.NID_INITIALISATION.in,transmission__.NID_INITIALISATION.in,transmission__.NID_NORMAL.in,transmission__.NID_NORMAL.in,transmission__.NID_NORMAL.in,transmission__.NID_NORMAL.in,transmission__.NID_DEGRADED.in,transmission__.NID_DEGRADED.in,transmission__.NID_DEGRADED.in,transmission__.NID_DEGRADED.in,transmission__.NID_RESCUE.in,transmission__.NID_RESCUE.in,transmission__.NID_RESCUE.in,transmission__.NID_RESCUE.in,transmission__.NID_EMERGENCY_STOP.in|}
				within
					((
					 (((-- RULE composeNodes(nc:NodeContainer)^nops : CSPProcess
					   EMERGENCY_STOP::VS_O__(id__)
					   [| { share__, terminate } |] (
					   RESCUE::VS_O__(id__)
					   [| { share__, terminate } |] (
					   DEGRADED::VS_O__(id__)
					   [| { share__, terminate } |] (
					   NORMAL::VS_O__(id__)
					   [| { share__, terminate } |] (
					   INITIALISATION::VS_O__(id__)
					   [| { share__, terminate } |] (
					   i0::VS_O__(id__)
					   )
					   )
					   )
					   )
					   )
					 )
					 [[EMERGENCY_STOP::interrupt <- x__ | x__ <- {|interrupt,transmission__.NID_EMERGENCY_STOP.in|}]]
					 [[RESCUE::interrupt <- x__ | x__ <- {|interrupt,transmission__.NID_RESCUE.in,transmission__.NID_RESCUE.in,transmission__.NID_RESCUE.in,transmission__.NID_RESCUE.in|}]]
					 [[DEGRADED::interrupt <- x__ | x__ <- {|interrupt,transmission__.NID_DEGRADED.in,transmission__.NID_DEGRADED.in,transmission__.NID_DEGRADED.in,transmission__.NID_DEGRADED.in|}]]
					 [[NORMAL::interrupt <- x__ | x__ <- {|interrupt,transmission__.NID_NORMAL.in,transmission__.NID_NORMAL.in,transmission__.NID_NORMAL.in,transmission__.NID_NORMAL.in|}]]
					 [[INITIALISATION::interrupt <- x__ | x__ <- {|interrupt,transmission__.NID_INITIALISATION.in,transmission__.NID_INITIALISATION.in,transmission__.NID_INITIALISATION.in,transmission__.NID_INITIALISATION.in,transmission__.NID_INITIALISATION.in,transmission__.NID_INITIALISATION.in|}]]
					 [[i0::interrupt <- x__ | x__ <- {|internal__.NID_i0|}]]
					 )
					  [[ share__ <- x__ | x__ <- {| share__ |} ]] 
					  [[set_startUpAbort <- setL_startUpAbort,set_unitFailure <- setL_unitFailure,set_emergencyCause <- setL_emergencyCause,set_startUpLevelReached <- setL_startUpLevelReached,set_unitsReady <- setL_unitsReady,set_levelFailure <- setL_levelFailure,set_programReadySent <- setL_programReadySent,set_estimateUnreliable <- setL_estimateUnreliable]]
					 )
					 [| union(union(union(flowevts,transSync),{terminate}),{|share__
					 			,setL_startUpAbort
					 			,setL_unitFailure
					 			,setL_emergencyCause
					 			,setL_startUpLevelReached
					 			,setL_unitsReady
					 			,setL_levelFailure
					 			,setL_programReadySent
					 			,setL_estimateUnreliable
					|}) |]
					 ((i0::enter -> Transitions(id__))
					  [[ share__ <- x__ | x__ <- {| share__,setL_startUpAbort,setL_unitFailure,setL_emergencyCause,setL_startUpLevelReached,setL_unitsReady,setL_levelFailure,setL_programReadySent,setL_estimateUnreliable |} ]]
					 )
					)[[setL_startUpAbort <- set_startUpAbort,setL_unitFailure <- set_unitFailure,setL_emergencyCause <- set_emergencyCause,setL_startUpLevelReached <- set_startUpLevelReached,setL_unitsReady <- set_unitsReady,setL_levelFailure <- set_levelFailure,setL_programReadySent <- set_programReadySent,setL_estimateUnreliable <- set_estimateUnreliable]]
					)
				)
				 \ hideSet)
				[[
					transmission__.x____ <- transmission,
					mode__.x____ <- mode,
					programReady__.x____ <- programReady
					| x____ <- NIDS
				]]
			)
			 [| {| interrupt |} |] SKIP)
		)
		)
	
	Behaviour_VS_O(id__) = 
		dbisim((MachineBody_VS_O(id__))
		)
	
	IteratedBehaviour_VS_O(id__) = 
		dbisim((MachineBody_VS_O(id__))
		)
	
	Stateful_VS_O(id__) = 
		dbisim((
			(Behaviour_VS_O(id__) [| union(getsetLocalChannels,{terminate}) |] varMemory(id__))
		 	\getsetLocalChannels
		)
		)
	
	IteratedStateful_VS_O(id__) =
		(Behaviour_VS_O(id__))
	
	-- END
	
	-- Memory
	-- Memory variables
	
	-- varMemory process
	varMemory(id__) = terminate -> SKIP
	
	getsetLocalChannels = {||}
	
	-- Definition of the behaviour of state machines (default, optimised, visible, visible and optimised)
	FVS__(id__) = STM_VS_O(id__)
	
	D__(id__) = STM(id__) \ internal_events
	O__(id__) = sbisim(diamond(D__(id__)))
	VS__(id__) = FVS__(id__)
	VS_O__(id__) = sbisim(diamond(FVS__(id__)))
	HEXT__(id__) = O__(id__) [|shared_variable_events|] SKIP
	HUP__(id__) = O__(id__) [|{share__}|] SKIP
	
	-- Shared memory
	-- Shared memory variables
	Memory_programReadySent(programReadySent) =
		get_programReadySent!programReadySent -> Memory_programReadySent(programReadySent)
		[]
		set_programReadySent?x__ -> Memory_programReadySent(x__)
		[]
		set_EXT_programReadySent?x__ -> Memory_programReadySent(x__)
		[]
		terminate -> SKIP
	Memory_startUpAbort(startUpAbort) =
		get_startUpAbort!startUpAbort -> Memory_startUpAbort(startUpAbort)
		[]
		set_startUpAbort?x__ -> Memory_startUpAbort(x__)
		[]
		set_EXT_startUpAbort?x__ -> Memory_startUpAbort(x__)
		[]
		terminate -> SKIP
	Memory_startUpLevelReached(startUpLevelReached) =
		get_startUpLevelReached!startUpLevelReached -> Memory_startUpLevelReached(startUpLevelReached)
		[]
		set_startUpLevelReached?x__ -> Memory_startUpLevelReached(x__)
		[]
		set_EXT_startUpLevelReached?x__ -> Memory_startUpLevelReached(x__)
		[]
		terminate -> SKIP
	Memory_unitsReady(unitsReady) =
		get_unitsReady!unitsReady -> Memory_unitsReady(unitsReady)
		[]
		set_unitsReady?x__ -> Memory_unitsReady(x__)
		[]
		set_EXT_unitsReady?x__ -> Memory_unitsReady(x__)
		[]
		terminate -> SKIP
	Memory_emergencyCause(emergencyCause) =
		get_emergencyCause!emergencyCause -> Memory_emergencyCause(emergencyCause)
		[]
		set_emergencyCause?x__ -> Memory_emergencyCause(x__)
		[]
		set_EXT_emergencyCause?x__ -> Memory_emergencyCause(x__)
		[]
		terminate -> SKIP
	Memory_levelFailure(levelFailure) =
		get_levelFailure!levelFailure -> Memory_levelFailure(levelFailure)
		[]
		set_levelFailure?x__ -> Memory_levelFailure(x__)
		[]
		set_EXT_levelFailure?x__ -> Memory_levelFailure(x__)
		[]
		terminate -> SKIP
	Memory_unitFailure(unitFailure) =
		get_unitFailure!unitFailure -> Memory_unitFailure(unitFailure)
		[]
		set_unitFailure?x__ -> Memory_unitFailure(x__)
		[]
		set_EXT_unitFailure?x__ -> Memory_unitFailure(x__)
		[]
		terminate -> SKIP
	Memory_estimateUnreliable(estimateUnreliable) =
		get_estimateUnreliable!estimateUnreliable -> Memory_estimateUnreliable(estimateUnreliable)
		[]
		set_estimateUnreliable?x__ -> Memory_estimateUnreliable(x__)
		[]
		set_EXT_estimateUnreliable?x__ -> Memory_estimateUnreliable(x__)
		[]
		terminate -> SKIP
	Memory_plantWaiting(plantWaiting) =
		get_plantWaiting!plantWaiting -> Memory_plantWaiting(plantWaiting)
		[]
		set_plantWaiting?x__ -> Memory_plantWaiting(x__)
		[]
		set_EXT_plantWaiting?x__ -> Memory_plantWaiting(x__)
		[]
		terminate -> SKIP
	Memory_levelBelowNormal(levelBelowNormal) =
		get_levelBelowNormal!levelBelowNormal -> Memory_levelBelowNormal(levelBelowNormal)
		[]
		set_levelBelowNormal?x__ -> Memory_levelBelowNormal(x__)
		[]
		set_EXT_levelBelowNormal?x__ -> Memory_levelBelowNormal(x__)
		[]
		terminate -> SKIP
	Memory_levelAboveNormal(levelAboveNormal) =
		get_levelAboveNormal!levelAboveNormal -> Memory_levelAboveNormal(levelAboveNormal)
		[]
		set_levelAboveNormal?x__ -> Memory_levelAboveNormal(x__)
		[]
		set_EXT_levelAboveNormal?x__ -> Memory_levelAboveNormal(x__)
		[]
		terminate -> SKIP
	
	-- sharedVarMemory process
	sharedVarMemory(id__) = Memory_programReadySent(false)
	[| { terminate } |] (
	Memory_startUpAbort(true)
	[| { terminate } |] (
	Memory_startUpLevelReached(true)
	[| { terminate } |] (
	Memory_unitsReady(true)
	[| { terminate } |] (
	Memory_emergencyCause(true)
	[| { terminate } |] (
	Memory_levelFailure(true)
	[| { terminate } |] (
	Memory_unitFailure(true)
	[| { terminate } |] (
	Memory_estimateUnreliable(true)
	[| { terminate } |] (
	Memory_plantWaiting(true)
	[| { terminate } |] (
	Memory_levelBelowNormal(true)
	[| { terminate } |] (
	Memory_levelAboveNormal(true)
	)
	)
	)
	)
	)
	)
	)
	)
	)
	)
	
	sharedVarSync = {|get_programReadySent,set_programReadySent,set_EXT_programReadySent,get_startUpAbort,set_startUpAbort,set_EXT_startUpAbort,get_startUpLevelReached,set_startUpLevelReached,set_EXT_startUpLevelReached,get_unitsReady,set_unitsReady,set_EXT_unitsReady,get_emergencyCause,set_emergencyCause,set_EXT_emergencyCause,get_levelFailure,set_levelFailure,set_EXT_levelFailure,get_unitFailure,set_unitFailure,set_EXT_unitFailure,get_estimateUnreliable,set_estimateUnreliable,set_EXT_estimateUnreliable,get_plantWaiting,set_plantWaiting,set_EXT_plantWaiting,get_levelBelowNormal,set_levelBelowNormal,set_EXT_levelBelowNormal,get_levelAboveNormal,set_levelAboveNormal,set_EXT_levelAboveNormal|}
	
	sharedVarHide = {|get_programReadySent,get_startUpAbort,get_startUpLevelReached,get_unitsReady,get_emergencyCause,get_levelFailure,get_unitFailure,get_estimateUnreliable,get_plantWaiting,get_levelBelowNormal,get_levelAboveNormal|}
