	channel get_otherUnitOutOfOrder, set_otherUnitOutOfOrder, setL_otherUnitOutOfOrder, setR_otherUnitOutOfOrder: core_boolean
	channel get_levelBelowNormal, set_levelBelowNormal, setL_levelBelowNormal, setR_levelBelowNormal: core_boolean
	channel get_levelAboveNormal, set_levelAboveNormal, setL_levelAboveNormal, setR_levelAboveNormal: core_boolean
	channel get_levelMayFallBelowNormal, set_levelMayFallBelowNormal, setL_levelMayFallBelowNormal, setR_levelMayFallBelowNormal: core_boolean
	channel get_levelMayRiseAboveNormal, set_levelMayRiseAboveNormal, setL_levelMayRiseAboveNormal, setR_levelMayRiseAboveNormal: core_boolean
	channel get_levelDeviceFailed, set_levelDeviceFailed, setL_levelDeviceFailed, setR_levelDeviceFailed: core_boolean
	channel get_steamDeviceFailed, set_steamDeviceFailed, setL_steamDeviceFailed, setR_steamDeviceFailed: core_boolean
