	-- END of Nodes --
	
	-- Operation calls --
	-- Only the undefined operations are declared here.
	-- If the state machine is in isolation, all required operations will be undefined.
	-- If it is in the context of a controller, the required operations not provided by the
	-- controller will be declared here, and the defined operations will be defined in the
	-- context of the Controller module, and therefore within scope of the state machine module.
	
	-- END of Operation calls --
	
	-- STM processes
	STM(id__) = -- RULE: [[stm:StateMachineDef]]_STM^nops : CSPProcess
	( 
		(
			(
				(IteratedStateful(id__) \ {terminate} ; share__choice(terminate -> SKIP))
			 	[[ share__ <- x__ | x__ <- {|set_EXT_steamBoilerWaitingSeen,set_EXT_readyAnnounced,set_EXT_valveOpen,set_EXT_pumpsOpen,set_EXT_levelDeviceOutOfOrder,set_EXT_steamDeviceOutOfOrder,set_EXT_pumpControllerOutOfOrder,set_EXT_otherUnitOutOfOrder,set_EXT_levelBelowNormal,set_EXT_levelAboveNormal,set_EXT_levelMayFallBelowNormal,set_EXT_levelMayRiseAboveNormal,set_EXT_levelDeviceFailed,set_EXT_steamDeviceFailed,set_EXT_otherUnitFailed,set_EXT_levelAboveN2,set_EXT_levelBelowN1,set_EXT_levelMayFallBelowN1,set_EXT_levelMayRiseAboveN2,set_EXT_pumpControllerFailed|} ]]
			)
		[| {share__} |]
		SKIP
		)
		[| union(sharedVarSync,{terminate}) |]
		dbisim(sharedVarMemory(id__))
	)\sharedVarHide
	
	STM_VS_O(id__) = -- RULE: [[stm:StateMachineDef]]_STM^nops : CSPProcess
	( 
		(
			(
				(IteratedStateful_VS_O(id__) \ {terminate} ; share__choice(terminate -> SKIP))
			 	[[ share__ <- x__ | x__ <- {|set_EXT_steamBoilerWaitingSeen,set_EXT_readyAnnounced,set_EXT_valveOpen,set_EXT_pumpsOpen,set_EXT_levelDeviceOutOfOrder,set_EXT_steamDeviceOutOfOrder,set_EXT_pumpControllerOutOfOrder,set_EXT_otherUnitOutOfOrder,set_EXT_levelBelowNormal,set_EXT_levelAboveNormal,set_EXT_levelMayFallBelowNormal,set_EXT_levelMayRiseAboveNormal,set_EXT_levelDeviceFailed,set_EXT_steamDeviceFailed,set_EXT_otherUnitFailed,set_EXT_levelAboveN2,set_EXT_levelBelowN1,set_EXT_levelMayFallBelowN1,set_EXT_levelMayRiseAboveN2,set_EXT_pumpControllerFailed|} ]]
			)
		[| {share__} |]
		SKIP
		)
		[| union(sharedVarSync,{terminate}) |]
		dbisim(sharedVarMemory(id__))
	)\sharedVarHide
	
	-- Transitions
	Transitions(id__) = ((let
		Trans = share__choice(get_levelMayFallBelowN1?levelMayFallBelowN1 -> get_levelBelowN1?levelBelowN1 -> get_levelMayRiseAboveN2?levelMayRiseAboveN2 -> get_steamDeviceFailed?steamDeviceFailed -> get_otherUnitFailed?otherUnitFailed -> get_valveOpen?valveOpen -> get_steamBoilerWaitingSeen?steamBoilerWaitingSeen -> get_levelAboveN2?levelAboveN2 -> get_readyAnnounced?readyAnnounced -> get_pumpControllerFailed?pumpControllerFailed -> get_levelDeviceFailed?levelDeviceFailed -> (
			((share__ -> SKIP
			 [] dbisim((true)&(internal__!NID_i0 -> SKIP ;  ((SKIP ; INITIALIZATION::enter -> SKIP))))
			 	 [] dbisim((true)&(stopConfirmed__!NID_INITIALIZATION.in -> SKIP ;  share__choice(exit -> SKIP) ; (share__choice(exited -> SKIP) ; SKIP ; EMERGENCY_STOP::enter -> SKIP)))
			 	 [] dbisim((true)&(transmissionFault__!NID_INITIALIZATION.in -> SKIP ;  share__choice(exit -> SKIP) ; (share__choice(exited -> SKIP) ; SKIP ; EMERGENCY_STOP::enter -> SKIP)))
			 	 [] dbisim(((not ((steamBoilerWaitingSeen))))&(steamBoilerWaiting__!NID_INITIALIZATION.in -> SKIP ;  share__choice(exit -> SKIP) ; (share__choice(exited -> SKIP) ; share__choice(true & (share__choice(set_steamBoilerWaitingSeen!true -> SKIP))) ; INITIALIZATION::enter -> SKIP)))
			 	 [] dbisim(((readyAnnounced and levelDeviceFailed))&(physicalUnitsReady__!NID_INITIALIZATION.in -> SKIP ;  share__choice(exit -> SKIP) ; (share__choice(exited -> SKIP) ; SKIP ; EMERGENCY_STOP::enter -> SKIP)))
			 	 [] dbisim((((readyAnnounced and (not ((levelDeviceFailed)))) and steamDeviceFailed))&(physicalUnitsReady__!NID_INITIALIZATION.in -> SKIP ;  share__choice(exit -> SKIP) ; (share__choice(exited -> SKIP) ; SKIP ; EMERGENCY_STOP::enter -> SKIP)))
			 	 [] dbisim(((((readyAnnounced and (not ((levelDeviceFailed)))) and (not ((steamDeviceFailed)))) and (not ((otherUnitFailed)))))&(physicalUnitsReady__!NID_INITIALIZATION.in -> SKIP ;  share__choice(exit -> SKIP) ; (share__choice(exited -> SKIP) ; SKIP ; NORMAL::enter -> SKIP)))
			 	 [] dbisim(((((readyAnnounced and (not ((levelDeviceFailed)))) and (not ((steamDeviceFailed)))) and otherUnitFailed))&(physicalUnitsReady__!NID_INITIALIZATION.in -> SKIP ;  share__choice(exit -> SKIP) ; (share__choice(exited -> SKIP) ; SKIP ; DEGRADED::enter -> SKIP)))
			 	 [] dbisim(((not ((steamBoilerWaitingSeen))))&(transmission__!NID_INITIALIZATION.in -> SKIP ;  share__choice(exit -> SKIP) ; (share__choice(exited -> SKIP) ; SKIP ; INITIALIZATION::enter -> SKIP)))
			 	 [] dbisim(((steamBoilerWaitingSeen and levelDeviceFailed))&(transmission__!NID_INITIALIZATION.in -> SKIP ;  share__choice(exit -> SKIP) ; (share__choice(exited -> SKIP) ; SKIP ; EMERGENCY_STOP::enter -> SKIP)))
			 	 [] dbisim((((steamBoilerWaitingSeen and (not ((levelDeviceFailed)))) and steamDeviceFailed))&(transmission__!NID_INITIALIZATION.in -> SKIP ;  share__choice(exit -> SKIP) ; (share__choice(exited -> SKIP) ; SKIP ; EMERGENCY_STOP::enter -> SKIP)))
			 	 [] dbisim(((((steamBoilerWaitingSeen and (not ((levelDeviceFailed)))) and (not ((steamDeviceFailed)))) and readyAnnounced))&(transmission__!NID_INITIALIZATION.in -> SKIP ;  share__choice(exit -> SKIP) ; (share__choice(exited -> SKIP) ; true&(share__choice(programReady.out -> SKIP)) ; INITIALIZATION::enter -> SKIP)))
			 	 [] dbisim(((((((steamBoilerWaitingSeen and (not ((levelDeviceFailed)))) and (not ((steamDeviceFailed)))) and (not ((readyAnnounced)))) and levelAboveN2) and (not ((valveOpen)))))&(transmission__!NID_INITIALIZATION.in -> SKIP ;  share__choice(exit -> SKIP) ; (share__choice(exited -> SKIP) ; true&(share__choice(valve.out -> SKIP));share__choice(true & (share__choice(set_valveOpen!true -> SKIP)));share__choice(true & (share__choice(set_pumpsOpen!false -> SKIP))) ; INITIALIZATION::enter -> SKIP)))
			 	 [] dbisim(((((((steamBoilerWaitingSeen and (not ((levelDeviceFailed)))) and (not ((steamDeviceFailed)))) and (not ((readyAnnounced)))) and levelAboveN2) and valveOpen))&(transmission__!NID_INITIALIZATION.in -> SKIP ;  share__choice(exit -> SKIP) ; (share__choice(exited -> SKIP) ; SKIP ; INITIALIZATION::enter -> SKIP)))
			 	 [] dbisim(((((((steamBoilerWaitingSeen and (not ((levelDeviceFailed)))) and (not ((steamDeviceFailed)))) and (not ((readyAnnounced)))) and (not ((levelAboveN2)))) and valveOpen))&(transmission__!NID_INITIALIZATION.in -> SKIP ;  share__choice(exit -> SKIP) ; (share__choice(exited -> SKIP) ; true&(share__choice(valve.out -> SKIP));share__choice(true & (share__choice(set_valveOpen!false -> SKIP))) ; INITIALIZATION::enter -> SKIP)))
			 	 [] dbisim((((((((steamBoilerWaitingSeen and (not ((levelDeviceFailed)))) and (not ((steamDeviceFailed)))) and (not ((readyAnnounced)))) and (not ((levelAboveN2)))) and levelBelowN1) and (not ((valveOpen)))))&(transmission__!NID_INITIALIZATION.in -> SKIP ;  share__choice(exit -> SKIP) ; (share__choice(exited -> SKIP) ; share__choice(true & (share__choice(set_pumpsOpen!true -> SKIP))) ; INITIALIZATION::enter -> SKIP)))
			 	 [] dbisim((((((((steamBoilerWaitingSeen and (not ((levelDeviceFailed)))) and (not ((steamDeviceFailed)))) and (not ((readyAnnounced)))) and (not ((levelAboveN2)))) and (not ((levelBelowN1)))) and (not ((valveOpen)))))&(transmission__!NID_INITIALIZATION.in -> SKIP ;  share__choice(exit -> SKIP) ; (share__choice(exited -> SKIP) ; share__choice(true & (share__choice(set_pumpsOpen!false -> SKIP)));true&(share__choice(programReady.out -> SKIP));share__choice(true & (share__choice(set_readyAnnounced!true -> SKIP))) ; INITIALIZATION::enter -> SKIP)))
			 	 [] dbisim((true)&(stopConfirmed__!NID_NORMAL.in -> SKIP ;  share__choice(exit -> SKIP) ; (share__choice(exited -> SKIP) ; SKIP ; EMERGENCY_STOP::enter -> SKIP)))
			 	 [] dbisim((true)&(transmissionFault__!NID_NORMAL.in -> SKIP ;  share__choice(exit -> SKIP) ; (share__choice(exited -> SKIP) ; SKIP ; EMERGENCY_STOP::enter -> SKIP)))
			 	 [] dbisim((true)&(levelRisk__!NID_NORMAL.in -> SKIP ;  share__choice(exit -> SKIP) ; (share__choice(exited -> SKIP) ; SKIP ; EMERGENCY_STOP::enter -> SKIP)))
			 	 [] dbisim((levelDeviceFailed)&(transmission__!NID_NORMAL.in -> SKIP ;  share__choice(exit -> SKIP) ; (share__choice(exited -> SKIP) ; SKIP ; RESCUE::enter -> SKIP)))
			 	 [] dbisim((((not ((levelDeviceFailed))) and otherUnitFailed))&(transmission__!NID_NORMAL.in -> SKIP ;  share__choice(exit -> SKIP) ; (share__choice(exited -> SKIP) ; SKIP ; DEGRADED::enter -> SKIP)))
			 	 [] dbisim(((((not ((levelDeviceFailed))) and (not ((otherUnitFailed)))) and levelMayFallBelowN1))&(transmission__!NID_NORMAL.in -> SKIP ;  share__choice(exit -> SKIP) ; (share__choice(exited -> SKIP) ; share__choice(true & (share__choice(set_pumpsOpen!true -> SKIP))) ; NORMAL::enter -> SKIP)))
			 	 [] dbisim((((((not ((levelDeviceFailed))) and (not ((otherUnitFailed)))) and (not ((levelMayFallBelowN1)))) and levelMayRiseAboveN2))&(transmission__!NID_NORMAL.in -> SKIP ;  share__choice(exit -> SKIP) ; (share__choice(exited -> SKIP) ; share__choice(true & (share__choice(set_pumpsOpen!false -> SKIP))) ; NORMAL::enter -> SKIP)))
			 	 [] dbisim((((((not ((levelDeviceFailed))) and (not ((otherUnitFailed)))) and (not ((levelMayFallBelowN1)))) and (not ((levelMayRiseAboveN2)))))&(transmission__!NID_NORMAL.in -> SKIP ;  share__choice(exit -> SKIP) ; (share__choice(exited -> SKIP) ; SKIP ; NORMAL::enter -> SKIP)))
