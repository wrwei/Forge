					 	 [] dbisim(((((readyAnnounced and (not ((levelDeviceFailed)))) and (not ((steamDeviceFailed)))) and (not ((otherUnitFailed)))))&(physicalUnitsReady__!NID_INITIALIZATION.in -> SKIP ;  share__choice(exit -> SKIP) ; (share__choice(exited -> SKIP) ; SKIP ; NORMAL::enter -> SKIP)))
					 	 [] dbisim(((((readyAnnounced and (not ((levelDeviceFailed)))) and (not ((steamDeviceFailed)))) and otherUnitFailed))&(physicalUnitsReady__!NID_INITIALIZATION.in -> SKIP ;  share__choice(exit -> SKIP) ; (share__choice(exited -> SKIP) ; SKIP ; DEGRADED::enter -> SKIP)))
