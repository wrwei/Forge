	channel get_levelBelowN1, set_levelBelowN1, setL_levelBelowN1, setR_levelBelowN1: core_boolean
	channel get_levelMayFallBelowN1, set_levelMayFallBelowN1, setL_levelMayFallBelowN1, setR_levelMayFallBelowN1: core_boolean
