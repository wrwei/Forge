		-- declaring machines
		module stm_ref0
		exports
			transparent diamond
			transparent sbisim
			transparent dbisim
			transparent chase
		
			-- Transition identifiers
			-- declaring identifiers of transitions
			datatype NIDS = 
			              NID_EMERGENCY_STOP|
			              NID_RESCUE|
			              NID_DEGRADED|
			              NID_NORMAL|
			              NID_INITIALIZATION|
			              NID_i0
			
			channel internal__ : NIDS
			
			-- Flow channels		
			channel interrupt
			channel exited
			channel exit
			channel terminate
			
			-- Variable channels
			channel get_steamBoilerWaitingSeen, set_steamBoilerWaitingSeen, setL_steamBoilerWaitingSeen, setR_steamBoilerWaitingSeen: core_boolean
