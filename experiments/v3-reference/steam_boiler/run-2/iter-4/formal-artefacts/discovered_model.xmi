    <typeMember xsi:type="spoon:CtMethod" name="publish">
      <comment xsi:type="spoon:CtJavaDoc" commentContent="SB-V4, SB-Beh13, SB-Beh25: worst-case level until the next transmission,&#xA;from the level bounds (q, or the estimate), worst-case steam (W, U1, U2)&#xA;and the pumps. Pumps ordered open in this cycle pour nothing before then;&#xA;pumps closed now stop at once, except those out of order, which may not&#xA;obey. The controller closes the pumps exactly when the level could rise&#xA;above N2 (and cannot fall below N1), so the limit risk is judged with&#xA;the pumps closed in that case and left as they are otherwise. Returns&#xA;whether the level risks reaching M1 or M2."/>
      <modifier>PRIVATE</modifier>
      <body xsi:type="spoon:CtBlock">
        <statement xsi:type="spoon:CtLocalVariable" name="open">
          <type name="int"/>
          <assignment xsi:type="spoon:CtLiteral" value="0" valueKind="Integer">
            <type name="int"/>
          </assignment>
        </statement>
        <statement xsi:type="spoon:CtLocalVariable" name="stuckOpen">
          <type name="int"/>
          <assignment xsi:type="spoon:CtLiteral" value="0" valueKind="Integer">
            <type name="int"/>
          </assignment>
        </statement>
        <statement xsi:type="spoon:CtLocalVariable" name="anyPumpOut">
          <type name="boolean"/>
          <assignment xsi:type="spoon:CtLiteral" value="false" valueKind="Boolean">
            <type name="boolean"/>
          </assignment>
        </statement>
        <statement xsi:type="spoon:CtLocalVariable" name="anyControllerOut">
          <type name="boolean"/>
          <assignment xsi:type="spoon:CtLiteral" value="false" valueKind="Boolean">
            <type name="boolean"/>
