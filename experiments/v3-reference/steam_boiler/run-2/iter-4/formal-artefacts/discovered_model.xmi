    <typeMember xsi:type="spoon:CtMethod" name="sendProtocolMessages">
      <comment xsi:type="spoon:CtJavaDoc" commentContent="SB-FR6 and SB-FR7: announce every unacknowledged failure, and acknowledge&#xA;every repair notified in this cycle."/>
      <modifier>PUBLIC</modifier>
      <body xsi:type="spoon:CtBlock">
        <statement xsi:type="spoon:CtFor">
          <body xsi:type="spoon:CtBlock">
            <statement xsi:type="spoon:CtLocalVariable" name="pump">
              <type name="int"/>
