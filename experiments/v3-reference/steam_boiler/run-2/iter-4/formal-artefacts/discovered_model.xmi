              <then xsi:type="spoon:CtBlock">
                <statement xsi:type="spoon:CtInvocation">
                  <type name="void"/>
                  <target xsi:type="spoon:CtVariableRead">
                    <type name="BoilerActuator">
                      <packageRef name="steam_boiler.actuator"/>
                    </type>
                    <variable xsi:type="spoon:CtParameterReference" name="actuator"/>
                  </target>
                  <executableRef name="apply">
                    <argumentType name="OutputEvent">
                      <packageRef name="steam_boiler.event"/>
                    </argumentType>
                    <declaringType name="BoilerActuator">
                      <packageRef name="steam_boiler.actuator"/>
