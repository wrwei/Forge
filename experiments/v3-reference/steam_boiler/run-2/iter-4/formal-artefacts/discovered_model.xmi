                      <type name="int"/>
                      <leftOperand xsi:type="spoon:CtVariableRead">
                        <type name="int"/>
                        <variable xsi:type="spoon:CtLocalVariableReference" name="i"/>
                      </leftOperand>
                      <rightOperand xsi:type="spoon:CtLiteral" value="1" valueKind="Integer">
                        <type name="int"/>
                      </rightOperand>
                    </argument>
