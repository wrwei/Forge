                      <type name="void"/>
                      <accessedType name="PumpUnit">
                        <packageRef name="steam_boiler.monitor"/>
                      </accessedType>
                    </target>
                  </target>
                </target>
                <executableRef name="sound">
                  <declaringType name="UnitHealth">
                    <packageRef name="steam_boiler.monitor"/>
                  </declaringType>
                </executableRef>
              </expression>
            </rightOperand>
          </condition>
          <then xsi:type="spoon:CtBlock">
            <statement xsi:type="spoon:CtReturn">
              <expression xsi:type="spoon:CtLiteral" value="true" valueKind="Boolean">
                <type name="boolean"/>
              </expression>
            </statement>
          </then>
        </statement>
        <statement xsi:type="spoon:CtIf">
          <condition xsi:type="spoon:CtBinaryOperator" operatorKind="EQ">
            <type name="boolean"/>
            <leftOperand xsi:type="spoon:CtFieldRead">
              <type name="PumpOrder">
                <packageRef name="steam_boiler.monitor"/>
              </type>
              <variable xsi:type="spoon:CtFieldReference" name="lastOrder">
                <declaringType name="PumpUnit">
                  <packageRef name="steam_boiler.monitor"/>
                </declaringType>
              </variable>
              <target xsi:type="spoon:CtThisAccess" isImplicit="true">
                <type name="PumpUnit">
                  <packageRef name="steam_boiler.monitor"/>
                </type>
                <target xsi:type="spoon:CtTypeAccess">
                  <type name="void"/>
                  <accessedType name="PumpUnit">
                    <packageRef name="steam_boiler.monitor"/>
                  </accessedType>
                </target>
              </target>
            </leftOperand>
            <rightOperand xsi:type="spoon:CtFieldRead">
              <type name="PumpOrder">
                <packageRef name="steam_boiler.monitor"/>
              </type>
              <variable xsi:type="spoon:CtFieldReference" name="CLOSE_ORDER" isFinal="true" isStatic="true">
                <declaringType name="PumpOrder">
                  <packageRef name="steam_boiler.monitor"/>
