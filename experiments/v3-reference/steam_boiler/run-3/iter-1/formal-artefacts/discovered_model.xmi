    <typeMember xsi:type="spoon:CtMethod" name="step">
      <comment xsi:type="spoon:CtJavaDoc" commentContent="Analyses one cycle and moves to the mode the requirements prescribe."/>
      <modifier>PUBLIC</modifier>
      <body xsi:type="spoon:CtBlock">
        <statement xsi:type="spoon:CtLocalVariable" name="stopDemanded">
          <comment commentContent="--- Named predicates: what the cycle's transmission and analysis report ---"/>
          <type name="boolean"/>
          <assignment xsi:type="spoon:CtBinaryOperator" operatorKind="GE">
            <type name="boolean"/>
            <leftOperand xsi:type="spoon:CtInvocation">
              <type name="int"/>
