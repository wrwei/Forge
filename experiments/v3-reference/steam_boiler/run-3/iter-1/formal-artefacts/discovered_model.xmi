            <statement xsi:type="spoon:CtReturn">
              <expression xsi:type="spoon:CtLiteral" value="false" valueKind="Boolean">
                <type name="boolean"/>
              </expression>
            </statement>
          </then>
        </statement>
        <statement xsi:type="spoon:CtReturn">
          <comment commentContent="A pump switched on in the previous transmission was still balancing (SB-Beh25)."/>
