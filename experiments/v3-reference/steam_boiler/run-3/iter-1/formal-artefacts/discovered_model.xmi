    <typeMember xsi:type="spoon:CtMethod" name="updateLevel">
      <comment commentContent="SB-FR3 and SB-V8: predicts the level range reachable over the cycle just elapsed"/>
      <comment commentContent="from the previous range, the pumps (with their start-up latency, SB-Beh25) and the"/>
      <comment commentContent="steam dynamics; judges the reading against it, or replaces the reading by it."/>
