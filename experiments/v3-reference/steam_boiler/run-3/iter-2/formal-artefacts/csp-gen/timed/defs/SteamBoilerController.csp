										[| {|get_CLID_EMERGENCY_STOP,EMERGENCY_STOP::entered,terminate|} |]
										dbisim(Clock_CLID_EMERGENCY_STOP(id__,0))
									)\{|get_CLID_EMERGENCY_STOP|}
								)
								[| {|get_CLID_INITIALIZATION,INITIALIZATION::entered,terminate|} |]
								dbisim(Clock_CLID_INITIALIZATION(id__,0))
							)\{|get_CLID_INITIALIZATION|}
						)
						[| {|get_CLID_RESCUE,RESCUE::entered,terminate|} |]
						dbisim(Clock_CLID_RESCUE(id__,0))
					)\{|get_CLID_RESCUE|}
				)
				) \ diff(union(stateClockSync,enteredSS),enteredSS)
			)
			)
		
		Stateful_VS_O(id__) = 
			dbisim((let
				getsetLocalChannels = {||}
				clockSync = {||}
			within
				(Behaviour_VS_O(id__) 
				 [| union(union(getsetLocalChannels,clockSync),{terminate}) |] 
				 (varMemory(id__) [| {terminate} |] Clocks(id__))
			 	)\union(getsetLocalChannels,clockSync)
			)
			)
		
		IteratedStateful_VS_O(id__) =
			(IteratedBehaviour_VS_O(id__))
		
		-- END
		
		-- Memory
		-- Memory variables
		
		-- varMemory process
		varMemory(id__) = terminate -> SKIP
		
		getsetLocalChannels = {||}
		
		-- Definition of the behaviour of state machines (default, optimised, visible, visible and optimised)
		FVS__(id__) = STM_VS_O(id__) \ localClockResets
		D__(id__) = timed_priority(STM(id__) \ union(internal_events,localClockResets))
		O__(id__) = dbisim(D__(id__))
		VS__(id__) = FVS__(id__)
		VS_O__(id__) = dbisim(FVS__(id__))
		HEXT__(id__) = O__(id__) [|shared_variable_events|] SKIP
		FVS_C__(id__) = dbisim(timed_priority(STM(id__) \ internal_events))
		HUP__(id__) = timed_priority(O__(id__) [|{share__}|] SKIP)
		
		-- Clocks
		
		Clocks(id__) = terminate -> SKIP
		
		clockSync = {||}
		
		Clock_CLID_RESCUE(id__,x__) = 
			TimeOut_1(
				RESCUE::entered -> Clock_CLID_RESCUE(id__,0)
				[]
				get_CLID_RESCUE!x__ -> Clock_CLID_RESCUE(id__,x__)
				[]
				terminate -> SKIP,Clock_CLID_RESCUE(id__,clock_type_plus(x__,1,CLID_RESCUE_clock_type(id__))))
		Clock_CLID_INITIALIZATION(id__,x__) = 
			TimeOut_1(
				INITIALIZATION::entered -> Clock_CLID_INITIALIZATION(id__,0)
				[]
				get_CLID_INITIALIZATION!x__ -> Clock_CLID_INITIALIZATION(id__,x__)
				[]
				terminate -> SKIP,Clock_CLID_INITIALIZATION(id__,clock_type_plus(x__,1,CLID_INITIALIZATION_clock_type(id__))))
		Clock_CLID_EMERGENCY_STOP(id__,x__) = 
			TimeOut_1(
				EMERGENCY_STOP::entered -> Clock_CLID_EMERGENCY_STOP(id__,0)
				[]
				get_CLID_EMERGENCY_STOP!x__ -> Clock_CLID_EMERGENCY_STOP(id__,x__)
				[]
				terminate -> SKIP,Clock_CLID_EMERGENCY_STOP(id__,clock_type_plus(x__,1,CLID_EMERGENCY_STOP_clock_type(id__))))
		Clock_CLID_NORMAL(id__,x__) = 
			TimeOut_1(
				NORMAL::entered -> Clock_CLID_NORMAL(id__,0)
				[]
				get_CLID_NORMAL!x__ -> Clock_CLID_NORMAL(id__,x__)
				[]
				terminate -> SKIP,Clock_CLID_NORMAL(id__,clock_type_plus(x__,1,CLID_NORMAL_clock_type(id__))))
		Clock_CLID_DEGRADED(id__,x__) = 
			TimeOut_1(
				DEGRADED::entered -> Clock_CLID_DEGRADED(id__,0)
				[]
				get_CLID_DEGRADED!x__ -> Clock_CLID_DEGRADED(id__,x__)
				[]
				terminate -> SKIP,Clock_CLID_DEGRADED(id__,clock_type_plus(x__,1,CLID_DEGRADED_clock_type(id__))))
		
		StateClocks(id__) = dbisim(Clock_CLID_RESCUE(id__,0))
		[| { terminate } |] (
		dbisim(Clock_CLID_INITIALIZATION(id__,0))
		[| { terminate } |] (
		dbisim(Clock_CLID_EMERGENCY_STOP(id__,0))
		[| { terminate } |] (
		dbisim(Clock_CLID_NORMAL(id__,0))
		[| { terminate } |] (
		dbisim(Clock_CLID_DEGRADED(id__,0))
		)
		)
		)
		)
		
		stateClockSync = {|get_CLID_RESCUE,RESCUE::entered,get_CLID_INITIALIZATION,INITIALIZATION::entered,get_CLID_EMERGENCY_STOP,EMERGENCY_STOP::entered,get_CLID_NORMAL,NORMAL::entered,get_CLID_DEGRADED,DEGRADED::entered|}
		
		-- Shared memory
		-- Shared memory variables
		Memory_readyAnnounced(readyAnnounced) =
			get_readyAnnounced!readyAnnounced -> Memory_readyAnnounced(readyAnnounced)
			[]
			set_readyAnnounced?x__ -> Memory_readyAnnounced(x__)
			[]
			set_EXT_readyAnnounced?x__ -> Memory_readyAnnounced(x__)
			[]
			terminate -> SKIP
		Memory_evacuationValve(evacuationValve) =
			get_evacuationValve!evacuationValve -> Memory_evacuationValve(evacuationValve)
			[]
			set_evacuationValve?x__ -> Memory_evacuationValve(x__)
			[]
			set_EXT_evacuationValve?x__ -> Memory_evacuationValve(x__)
			[]
			terminate -> SKIP
		Memory_stopOrTransmissionFault(stopOrTransmissionFault) =
			get_stopOrTransmissionFault!stopOrTransmissionFault -> Memory_stopOrTransmissionFault(stopOrTransmissionFault)
			[]
			set_stopOrTransmissionFault?x__ -> Memory_stopOrTransmissionFault(x__)
			[]
			set_EXT_stopOrTransmissionFault?x__ -> Memory_stopOrTransmissionFault(x__)
			[]
			terminate -> SKIP
		Memory_unitsReady(unitsReady) =
			get_unitsReady!unitsReady -> Memory_unitsReady(unitsReady)
			[]
			set_unitsReady?x__ -> Memory_unitsReady(x__)
			[]
			set_EXT_unitsReady?x__ -> Memory_unitsReady(x__)
			[]
			terminate -> SKIP
		Memory_plantWaiting(plantWaiting) =
			get_plantWaiting!plantWaiting -> Memory_plantWaiting(plantWaiting)
			[]
			set_plantWaiting?x__ -> Memory_plantWaiting(x__)
			[]
			set_EXT_plantWaiting?x__ -> Memory_plantWaiting(x__)
			[]
			terminate -> SKIP
		Memory_startupFault(startupFault) =
			get_startupFault!startupFault -> Memory_startupFault(startupFault)
			[]
			set_startupFault?x__ -> Memory_startupFault(x__)
			[]
			set_EXT_startupFault?x__ -> Memory_startupFault(x__)
			[]
			terminate -> SKIP
		Memory_otherUnitDefective(otherUnitDefective) =
			get_otherUnitDefective!otherUnitDefective -> Memory_otherUnitDefective(otherUnitDefective)
			[]
			set_otherUnitDefective?x__ -> Memory_otherUnitDefective(x__)
			[]
			set_EXT_otherUnitDefective?x__ -> Memory_otherUnitDefective(x__)
			[]
			terminate -> SKIP
		Memory_levelHigh(levelHigh) =
			get_levelHigh!levelHigh -> Memory_levelHigh(levelHigh)
			[]
			set_levelHigh?x__ -> Memory_levelHigh(x__)
			[]
			set_EXT_levelHigh?x__ -> Memory_levelHigh(x__)
			[]
			terminate -> SKIP
		Memory_levelLow(levelLow) =
			get_levelLow!levelLow -> Memory_levelLow(levelLow)
			[]
			set_levelLow?x__ -> Memory_levelLow(x__)
			[]
			set_EXT_levelLow?x__ -> Memory_levelLow(x__)
			[]
			terminate -> SKIP
		Memory_operatingEmergency(operatingEmergency) =
			get_operatingEmergency!operatingEmergency -> Memory_operatingEmergency(operatingEmergency)
			[]
			set_operatingEmergency?x__ -> Memory_operatingEmergency(x__)
			[]
			set_EXT_operatingEmergency?x__ -> Memory_operatingEmergency(x__)
			[]
			terminate -> SKIP
		Memory_levelDefective(levelDefective) =
			get_levelDefective!levelDefective -> Memory_levelDefective(levelDefective)
			[]
			set_levelDefective?x__ -> Memory_levelDefective(x__)
			[]
			set_EXT_levelDefective?x__ -> Memory_levelDefective(x__)
			[]
			terminate -> SKIP
		Memory_estimateUnreliable(estimateUnreliable) =
			get_estimateUnreliable!estimateUnreliable -> Memory_estimateUnreliable(estimateUnreliable)
			[]
			set_estimateUnreliable?x__ -> Memory_estimateUnreliable(x__)
			[]
			set_EXT_estimateUnreliable?x__ -> Memory_estimateUnreliable(x__)
			[]
			terminate -> SKIP
		Memory_predictedHigh(predictedHigh) =
			get_predictedHigh!predictedHigh -> Memory_predictedHigh(predictedHigh)
			[]
			set_predictedHigh?x__ -> Memory_predictedHigh(x__)
			[]
			set_EXT_predictedHigh?x__ -> Memory_predictedHigh(x__)
			[]
			terminate -> SKIP
		Memory_predictedLow(predictedLow) =
			get_predictedLow!predictedLow -> Memory_predictedLow(predictedLow)
			[]
			set_predictedLow?x__ -> Memory_predictedLow(x__)
			[]
			set_EXT_predictedLow?x__ -> Memory_predictedLow(x__)
			[]
			terminate -> SKIP
		
		-- sharedVarMemory process
		sharedVarMemory(id__) = Memory_readyAnnounced(false)
		[| { terminate } |] (
		Memory_evacuationValve(ValvePosition_CLOSED)
		[| { terminate } |] (
		Memory_stopOrTransmissionFault(true)
		[| { terminate } |] (
		Memory_unitsReady(true)
		[| { terminate } |] (
		Memory_plantWaiting(true)
		[| { terminate } |] (
		Memory_startupFault(true)
		[| { terminate } |] (
		Memory_otherUnitDefective(true)
		[| { terminate } |] (
		Memory_levelHigh(true)
		[| { terminate } |] (
		Memory_levelLow(true)
		[| { terminate } |] (
		Memory_operatingEmergency(true)
		[| { terminate } |] (
		Memory_levelDefective(true)
		[| { terminate } |] (
		Memory_estimateUnreliable(true)
		[| { terminate } |] (
		Memory_predictedHigh(true)
		[| { terminate } |] (
		Memory_predictedLow(true)
		)
		)
		)
		)
		)
		)
		)
		)
		)
		)
		)
		)
		)
		
		sharedVarSync = {|get_readyAnnounced,set_readyAnnounced,set_EXT_readyAnnounced,get_evacuationValve,set_evacuationValve,set_EXT_evacuationValve,get_stopOrTransmissionFault,set_stopOrTransmissionFault,set_EXT_stopOrTransmissionFault,get_unitsReady,set_unitsReady,set_EXT_unitsReady,get_plantWaiting,set_plantWaiting,set_EXT_plantWaiting,get_startupFault,set_startupFault,set_EXT_startupFault,get_otherUnitDefective,set_otherUnitDefective,set_EXT_otherUnitDefective,get_levelHigh,set_levelHigh,set_EXT_levelHigh,get_levelLow,set_levelLow,set_EXT_levelLow,get_operatingEmergency,set_operatingEmergency,set_EXT_operatingEmergency,get_levelDefective,set_levelDefective,set_EXT_levelDefective,get_estimateUnreliable,set_estimateUnreliable,set_EXT_estimateUnreliable,get_predictedHigh,set_predictedHigh,set_EXT_predictedHigh,get_predictedLow,set_predictedLow,set_EXT_predictedLow|}
		
		sharedVarHide = {|get_readyAnnounced,get_evacuationValve,get_stopOrTransmissionFault,get_unitsReady,get_plantWaiting,get_startupFault,get_otherUnitDefective,get_levelHigh,get_levelLow,get_operatingEmergency,get_levelDefective,get_estimateUnreliable,get_predictedHigh,get_predictedLow|}
		}
endmodule
