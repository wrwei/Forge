    <typeMember xsi:type="spoon:CtMethod" name="possiblyPouredLastCycle">
      <comment commentContent="--- level prediction ----------------------------------------------------------"/>
      <comment xsi:type="spoon:CtJavaDoc" commentContent="The pump may have poured water during the cycle just elapsed."/>
