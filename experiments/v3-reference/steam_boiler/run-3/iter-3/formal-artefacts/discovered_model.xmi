                <declaringType name="PumpUnit">
                  <packageRef name="steam_boiler.monitor"/>
                </declaringType>
              </variable>
              <target xsi:type="spoon:CtThisAccess" isImplicit="true">
                <type name="PumpUnit">
                  <packageRef name="steam_boiler.monitor"/>
                </type>
                <target xsi:type="spoon:CtTypeAccess">
                  <type name="void"/>
                  <accessedType name="PumpUnit">
                    <packageRef name="steam_boiler.monitor"/>
                  </accessedType>
                </target>
              </target>
            </leftOperand>
            <rightOperand xsi:type="spoon:CtFieldRead">
              <type name="PumpOrder">
                <packageRef name="steam_boiler.monitor"/>
              </type>
              <variable xsi:type="spoon:CtFieldReference" name="CLOSE_ORDER" isFinal="true" isStatic="true">
