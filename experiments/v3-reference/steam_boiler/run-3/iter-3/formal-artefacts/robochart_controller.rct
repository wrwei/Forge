diagram SteamBoilerController

enumeration PumpPosition { OFF ON }
enumeration ValvePosition { CLOSED OPEN }
enumeration WaterFlow { NO_FLOW FLOWING }
enumeration MessageKind { STOP_REQUEST STEAM_BOILER_WAITING PHYSICAL_UNITS_READY PUMP_STATE PUMP_CONTROL_STATE LEVEL_READING STEAM_READING PUMP_REPAIRED PUMP_CONTROL_REPAIRED LEVEL_REPAIRED STEAM_REPAIRED PUMP_FAILURE_ACKNOWLEDGEMENT PUMP_CONTROL_FAILURE_ACKNOWLEDGEMENT LEVEL_FAILURE_ACKNOWLEDGEMENT STEAM_OUTCOME_FAILURE_ACKNOWLEDGEMENT }
enumeration PumpOrder { NO_ORDER OPEN_ORDER CLOSE_ORDER }

interface Inputs {
	event transmissionReceived
}

interface Outputs {
	event modeMessage
}

interface Sensors {
	var initAbort : boolean
	var unitsReady : boolean
	var otherUnitDefective : boolean
	var operatingEmergency : boolean
	var levelDefective : boolean
	var estimateUnreliable : boolean
}

interface Actuators {
}

interface SteamBoilerController_State {
}

interface Constants {
}

stm SteamBoilerController {
	uses Inputs uses Outputs requires SteamBoilerController_State requires Constants requires Sensors
	state EMERGENCY_STOP {
		entry send modeMessage
	}
	state RESCUE {
		entry send modeMessage
	}
	state DEGRADED {
		entry send modeMessage
	}
	state NORMAL {
		entry send modeMessage
	}
	state INITIALIZATION {
	}
	initial i0
	transition t_init {
		from i0
		to INITIALIZATION
	}
	transition t1 {
		from INITIALIZATION
		to EMERGENCY_STOP
		trigger transmissionReceived
		condition initAbort
	}
	transition t2 {
		from INITIALIZATION
		to DEGRADED
		trigger transmissionReceived
		condition unitsReady /\ otherUnitDefective
	}
	transition t3 {
		from INITIALIZATION
		to NORMAL
		trigger transmissionReceived
		condition unitsReady
	}
	transition t4 {
		from INITIALIZATION
		to INITIALIZATION
		trigger transmissionReceived
		action send modeMessage
	}
	transition t5 {
		from NORMAL
		to EMERGENCY_STOP
		trigger transmissionReceived
		condition operatingEmergency \/ levelDefective /\ estimateUnreliable
	}
	transition t6 {
		from NORMAL
		to RESCUE
		trigger transmissionReceived
		condition levelDefective
	}
	transition t7 {
		from NORMAL
		to DEGRADED
		trigger transmissionReceived
		condition otherUnitDefective
	}
	transition t8 {
		from NORMAL
		to NORMAL
		trigger transmissionReceived
	}
	transition t9 {
		from DEGRADED
		to EMERGENCY_STOP
		trigger transmissionReceived
		condition operatingEmergency \/ levelDefective /\ estimateUnreliable
	}
	transition t10 {
		from DEGRADED
		to RESCUE
		trigger transmissionReceived
		condition levelDefective
	}
	transition t11 {
		from DEGRADED
		to NORMAL
		trigger transmissionReceived
		condition not ( otherUnitDefective )
	}
	transition t12 {
		from DEGRADED
		to DEGRADED
		trigger transmissionReceived
	}
	transition t13 {
		from RESCUE
		to EMERGENCY_STOP
		trigger transmissionReceived
		condition operatingEmergency \/ estimateUnreliable
	}
	transition t14 {
		from RESCUE
		to NORMAL
		trigger transmissionReceived
		condition not ( levelDefective ) /\ not ( otherUnitDefective )
	}
	transition t15 {
		from RESCUE
		to DEGRADED
		trigger transmissionReceived
		condition not ( levelDefective )
	}
	transition t16 {
		from RESCUE
		to RESCUE
		trigger transmissionReceived
	}
}

controller SteamBoilerController_Ctrl {
	uses Inputs uses Outputs requires SteamBoilerController_State requires Constants requires Sensors
	sref stm_ref0 = SteamBoilerController
	connection SteamBoilerController_Ctrl on transmissionReceived to stm_ref0 on transmissionReceived
	connection stm_ref0 on modeMessage to SteamBoilerController_Ctrl on modeMessage
}

module SteamBoilerController_Module {
	robotic platform SteamBoilerController_Platform {
		provides Sensors provides Actuators provides Constants
		event transmissionReceived
		event modeMessage
	}
	cref ctrl_ref0 = SteamBoilerController_Ctrl
	connection SteamBoilerController_Platform on transmissionReceived to ctrl_ref0 on transmissionReceived
	connection ctrl_ref0 on modeMessage to SteamBoilerController_Platform on modeMessage
}

