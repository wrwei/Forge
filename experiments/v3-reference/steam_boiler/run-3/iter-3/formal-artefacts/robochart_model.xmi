      <literals name="LEVEL_FAILURE_ACKNOWLEDGEMENT"/>
      <literals name="STEAM_OUTCOME_FAILURE_ACKNOWLEDGEMENT"/>
    </types>
    <types xsi:type="robochart:Enumeration" name="PumpOrder">
      <literals name="NO_ORDER"/>
      <literals name="OPEN_ORDER"/>
      <literals name="CLOSE_ORDER"/>
    </types>
    <types xsi:type="robochart:PrimitiveType" name="boolean"/>
    <machines name="SteamBoilerController">
      <events name="transmissionReceived"/>
      <events name="modeMessage"/>
      <nodes xsi:type="robochart:State" name="INITIALIZATION"/>
      <nodes xsi:type="robochart:State" name="NORMAL"/>
      <nodes xsi:type="robochart:State" name="DEGRADED"/>
      <nodes xsi:type="robochart:State" name="RESCUE"/>
      <nodes xsi:type="robochart:State" name="EMERGENCY_STOP"/>
      <nodes xsi:type="robochart:Initial" name="i0"/>
      <transitions name="t_init" source="/0/@machines.0/@nodes.5" target="/0/@machines.0/@nodes.0"/>
      <transitions name="t1" source="/0/@machines.0/@nodes.0" target="/0/@machines.0/@nodes.4">
        <trigger event="/0/@machines.0/@events.0"/>
        <condition xsi:type="robochart:CallExp">
          <function xsi:type="robochart:StringExp" value="initAbort"/>
        </condition>
        <action xsi:type="robochart:CommunicationStmt">
          <communication event="/0/@machines.0/@events.1"/>
        </action>
      </transitions>
      <transitions name="t2" source="/0/@machines.0/@nodes.0" target="/0/@machines.0/@nodes.2">
        <trigger event="/0/@machines.0/@events.0"/>
        <condition xsi:type="robochart:And">
          <left xsi:type="robochart:CallExp">
            <function xsi:type="robochart:StringExp" value="unitsReady"/>
          </left>
          <right xsi:type="robochart:CallExp">
            <function xsi:type="robochart:StringExp" value="otherUnitDefective"/>
          </right>
        </condition>
        <action xsi:type="robochart:CommunicationStmt">
          <communication event="/0/@machines.0/@events.1"/>
        </action>
      </transitions>
      <transitions name="t3" source="/0/@machines.0/@nodes.0" target="/0/@machines.0/@nodes.1">
