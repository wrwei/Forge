<?xml version="1.0" encoding="ASCII"?>
<xmi:XMI xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:robochart="http://www.robocalc.circus/RoboChart">
  <robochart:RCPackage name="extracted">
    <interfaces name="Ctrl_State"/>
    <interfaces name="Sensors">
      <variableList>
        <vars name="initAbort">
          <type xsi:type="robochart:TypeRef" ref="/0/@types.5"/>
        </vars>
        <vars name="unitsReady">
          <type xsi:type="robochart:TypeRef" ref="/0/@types.5"/>
        </vars>
        <vars name="otherUnitDefective">
          <type xsi:type="robochart:TypeRef" ref="/0/@types.5"/>
        </vars>
        <vars name="operatingEmergency">
          <type xsi:type="robochart:TypeRef" ref="/0/@types.5"/>
        </vars>
        <vars name="levelDefective">
          <type xsi:type="robochart:TypeRef" ref="/0/@types.5"/>
        </vars>
        <vars name="estimateUnreliable">
          <type xsi:type="robochart:TypeRef" ref="/0/@types.5"/>
        </vars>
      </variableList>
    </interfaces>
    <interfaces name="Actuators"/>
    <interfaces name="Constants"/>
    <types xsi:type="robochart:Enumeration" name="PumpPosition">
      <literals name="OFF"/>
      <literals name="ON"/>
    </types>
    <types xsi:type="robochart:Enumeration" name="ValvePosition">
      <literals name="CLOSED"/>
      <literals name="OPEN"/>
    </types>
    <types xsi:type="robochart:Enumeration" name="WaterFlow">
      <literals name="NO_FLOW"/>
      <literals name="FLOWING"/>
    </types>
    <types xsi:type="robochart:Enumeration" name="MessageKind">
      <literals name="STOP_REQUEST"/>
      <literals name="STEAM_BOILER_WAITING"/>
      <literals name="PHYSICAL_UNITS_READY"/>
      <literals name="PUMP_STATE"/>
      <literals name="PUMP_CONTROL_STATE"/>
      <literals name="LEVEL_READING"/>
      <literals name="STEAM_READING"/>
      <literals name="PUMP_REPAIRED"/>
      <literals name="PUMP_CONTROL_REPAIRED"/>
      <literals name="LEVEL_REPAIRED"/>
      <literals name="STEAM_REPAIRED"/>
      <literals name="PUMP_FAILURE_ACKNOWLEDGEMENT"/>
