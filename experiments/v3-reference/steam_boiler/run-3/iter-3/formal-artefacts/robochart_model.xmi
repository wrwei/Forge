        <condition xsi:type="robochart:Or">
          <left xsi:type="robochart:CallExp">
            <function xsi:type="robochart:StringExp" value="operatingEmergency"/>
          </left>
          <right xsi:type="robochart:And">
            <left xsi:type="robochart:CallExp">
