diagram SteamBoilerController

enumeration FlowObservation { WATER_FLOWS NO_WATER_FLOW }

datatype LevelEstimate {
	lowerBound : real
	upperBound : real
}

datatype PumpControlReading {
	controlledPump : int
	observation : FlowObservation
}

datatype PumpReading {
	pumpNumber : int
	pumpRunning : boolean
}

datatype UnitStatus {
	outOfOrder : boolean
	detectionAcknowledged : boolean
}

interface Inputs {
	event transmissionReceived
}

interface Outputs {
	event modeMessage
	event valve
	event openPump : int
	event closePump : int
	event programReady
}

interface Sensors {
	var PUMPS : int
	var DT : real
	var TOLERANCE : real
	var stopPresent : boolean
	var waitingPresent : boolean
	var readyPresent : boolean
	var levelSeen : boolean
	var steamSeen : boolean
	var levelValue : real
	var steamValue : real
	var levelRepairedSeen : boolean
	var steamRepairedSeen : boolean
	var levelAckSeen : boolean
	var steamAckSeen : boolean
	var malformed : boolean
	var levelJustRepaired : boolean
	var programReadySent : boolean
	var plantWaiting : boolean
	var stopCount : int
	var transmissionFailed : boolean
	var lastLevel : real
	var lastSteam : real
	var trustedSteam : real
	var steamTrusted : boolean
	var levelGrounded : boolean
	var throughput : real
	var levelOutOfOrder : boolean
	var steamOutOfOrder : boolean
	var failedPumps : int
	var failedControls : int
	var currentLevel : real
	var minimumNext : real
	var maximumNext : real
	var initialisationAbort : boolean
	var operationAbort : boolean
	var rescueAbort : boolean
	var otherUnitOutOfOrder : boolean
	var underNormalBand : boolean
	var overNormalBand : boolean
	var initAbort : boolean
	var unitsReady : boolean
	var otherUnitFailed : boolean
	var levelAboveNormal : boolean
	var levelBelowNormal : boolean
	var operatingAbort : boolean
	var levelFailed : boolean
}

interface Actuators {
}

interface SteamBoilerController_State {
	var valveOpen : boolean = false
}

interface Constants {
}

stm SteamBoilerController {
	uses Inputs uses Outputs requires SteamBoilerController_State requires Constants requires Sensors
	state NORMAL {
		entry send modeMessage
	}
	state INITIALIZATION {
	}
	state EMERGENCY_STOP {
		entry send modeMessage
	}
	state DEGRADED {
		entry send modeMessage
	}
	state RESCUE {
		entry send modeMessage
	}
	initial i0
	transition t_init {
		from i0
		to INITIALIZATION
	}
	transition t1 {
		from INITIALIZATION
		to EMERGENCY_STOP
		trigger transmissionReceived
		condition initAbort
	}
	transition t2 {
		from INITIALIZATION
		to INITIALIZATION
		trigger transmissionReceived
		condition not ( initAbort ) /\ not ( plantWaiting )
		action send modeMessage
	}
	transition t3 {
		from INITIALIZATION
		to NORMAL
		trigger transmissionReceived
		condition not ( initAbort ) /\ plantWaiting /\ unitsReady /\ not ( otherUnitFailed )
	}
	transition t4 {
		from INITIALIZATION
		to DEGRADED
		trigger transmissionReceived
		condition not ( initAbort ) /\ plantWaiting /\ unitsReady /\ otherUnitFailed
	}
	transition t5 {
		from INITIALIZATION
		to INITIALIZATION
		trigger transmissionReceived
		condition not ( initAbort ) /\ plantWaiting /\ not ( unitsReady ) /\ levelAboveNormal /\ not ( valveOpen )
		action valveOpen = true ; send modeMessage ; send valve
	}
	transition t6 {
		from INITIALIZATION
		to INITIALIZATION
		trigger transmissionReceived
		condition not ( initAbort ) /\ plantWaiting /\ not ( unitsReady ) /\ levelAboveNormal /\ valveOpen
		action send modeMessage
	}
	transition t7 {
		from INITIALIZATION
		to INITIALIZATION
		trigger transmissionReceived
		condition not ( initAbort ) /\ plantWaiting /\ not ( unitsReady ) /\ not ( levelAboveNormal ) /\ valveOpen
		action valveOpen = false ; send modeMessage ; send valve
	}
	transition t8 {
		from INITIALIZATION
		to INITIALIZATION
		trigger transmissionReceived
		condition not ( initAbort ) /\ plantWaiting /\ not ( unitsReady ) /\ levelBelowNormal /\ not ( levelAboveNormal ) /\ not ( valveOpen )
		action send modeMessage ; openPump ! 1 ; openPump ! 2 ; openPump ! 3 ; openPump ! 4
	}
	transition t9 {
		from INITIALIZATION
		to INITIALIZATION
		trigger transmissionReceived
		condition not ( initAbort ) /\ plantWaiting /\ not ( unitsReady ) /\ not ( levelBelowNormal ) /\ not ( levelAboveNormal ) /\ not ( valveOpen )
		action send modeMessage ; closePump ! 1 ; closePump ! 2 ; closePump ! 3 ; closePump ! 4 ; send programReady
	}
	transition t10 {
		from NORMAL
		to EMERGENCY_STOP
		trigger transmissionReceived
		condition operatingAbort
	}
	transition t11 {
		from NORMAL
		to RESCUE
		trigger transmissionReceived
		condition not ( operatingAbort ) /\ levelFailed
	}
	transition t12 {
		from NORMAL
		to DEGRADED
		trigger transmissionReceived
		condition not ( operatingAbort ) /\ not ( levelFailed ) /\ otherUnitFailed
	}
	transition t13 {
		from NORMAL
		to NORMAL
		trigger transmissionReceived
		condition not ( operatingAbort ) /\ not ( levelFailed ) /\ not ( otherUnitFailed ) /\ levelBelowNormal /\ not ( levelAboveNormal )
		action send modeMessage ; openPump ! 1 ; openPump ! 2 ; openPump ! 3 ; openPump ! 4
	}
	transition t14 {
		from NORMAL
		to NORMAL
		trigger transmissionReceived
		condition not ( operatingAbort ) /\ not ( levelFailed ) /\ not ( otherUnitFailed ) /\ levelAboveNormal
		action send modeMessage ; closePump ! 1 ; closePump ! 2 ; closePump ! 3 ; closePump ! 4
	}
	transition t15 {
		from NORMAL
		to NORMAL
		trigger transmissionReceived
		condition not ( operatingAbort ) /\ not ( levelFailed ) /\ not ( otherUnitFailed ) /\ not ( levelBelowNormal ) /\ not ( levelAboveNormal )
	}
	transition t16 {
		from DEGRADED
		to EMERGENCY_STOP
		trigger transmissionReceived
		condition operatingAbort
	}
	transition t17 {
		from DEGRADED
		to RESCUE
		trigger transmissionReceived
		condition not ( operatingAbort ) /\ levelFailed
	}
	transition t18 {
		from DEGRADED
		to NORMAL
		trigger transmissionReceived
		condition not ( operatingAbort ) /\ not ( levelFailed ) /\ not ( otherUnitFailed )
	}
	transition t19 {
		from DEGRADED
		to DEGRADED
		trigger transmissionReceived
		condition not ( operatingAbort ) /\ not ( levelFailed ) /\ otherUnitFailed /\ levelBelowNormal /\ not ( levelAboveNormal )
		action send modeMessage ; openPump ! 1 ; openPump ! 2 ; openPump ! 3 ; openPump ! 4
	}
	transition t20 {
		from DEGRADED
		to DEGRADED
		trigger transmissionReceived
		condition not ( operatingAbort ) /\ not ( levelFailed ) /\ otherUnitFailed /\ levelAboveNormal
		action send modeMessage ; closePump ! 1 ; closePump ! 2 ; closePump ! 3 ; closePump ! 4
	}
	transition t21 {
		from DEGRADED
		to DEGRADED
		trigger transmissionReceived
		condition not ( operatingAbort ) /\ not ( levelFailed ) /\ otherUnitFailed /\ not ( levelBelowNormal ) /\ not ( levelAboveNormal )
	}
	transition t22 {
		from RESCUE
		to EMERGENCY_STOP
		trigger transmissionReceived
		condition rescueAbort
	}
	transition t23 {
		from RESCUE
		to NORMAL
		trigger transmissionReceived
		condition not ( rescueAbort ) /\ not ( levelFailed ) /\ not ( otherUnitFailed )
	}
	transition t24 {
		from RESCUE
		to DEGRADED
		trigger transmissionReceived
		condition not ( rescueAbort ) /\ not ( levelFailed ) /\ otherUnitFailed
	}
	transition t25 {
		from RESCUE
		to RESCUE
		trigger transmissionReceived
		condition not ( rescueAbort ) /\ levelFailed /\ levelBelowNormal /\ not ( levelAboveNormal )
		action send modeMessage ; openPump ! 1 ; openPump ! 2 ; openPump ! 3 ; openPump ! 4
	}
	transition t26 {
		from RESCUE
		to RESCUE
		trigger transmissionReceived
		condition not ( rescueAbort ) /\ levelFailed /\ levelAboveNormal
		action send modeMessage ; closePump ! 1 ; closePump ! 2 ; closePump ! 3 ; closePump ! 4
	}
	transition t27 {
		from RESCUE
		to RESCUE
		trigger transmissionReceived
		condition not ( rescueAbort ) /\ levelFailed /\ not ( levelBelowNormal ) /\ not ( levelAboveNormal )
	}
}

controller SteamBoilerController_Ctrl {
	uses Inputs uses Outputs requires SteamBoilerController_State requires Constants requires Sensors
	sref stm_ref0 = SteamBoilerController
	connection SteamBoilerController_Ctrl on transmissionReceived to stm_ref0 on transmissionReceived
	connection stm_ref0 on modeMessage to SteamBoilerController_Ctrl on modeMessage
	connection stm_ref0 on valve to SteamBoilerController_Ctrl on valve
	connection stm_ref0 on openPump to SteamBoilerController_Ctrl on openPump
	connection stm_ref0 on closePump to SteamBoilerController_Ctrl on closePump
	connection stm_ref0 on programReady to SteamBoilerController_Ctrl on programReady
}

module SteamBoilerController_Module {
	robotic platform SteamBoilerController_Platform {
		provides Sensors provides Actuators provides Constants
		event transmissionReceived
		event modeMessage
		event valve
		event openPump : int
		event closePump : int
		event programReady
	}
	cref ctrl_ref0 = SteamBoilerController_Ctrl
	connection SteamBoilerController_Platform on transmissionReceived to ctrl_ref0 on transmissionReceived
	connection ctrl_ref0 on modeMessage to SteamBoilerController_Platform on modeMessage
	connection ctrl_ref0 on valve to SteamBoilerController_Platform on valve
	connection ctrl_ref0 on openPump to SteamBoilerController_Platform on openPump
	connection ctrl_ref0 on closePump to SteamBoilerController_Platform on closePump
	connection ctrl_ref0 on programReady to SteamBoilerController_Platform on programReady
}

