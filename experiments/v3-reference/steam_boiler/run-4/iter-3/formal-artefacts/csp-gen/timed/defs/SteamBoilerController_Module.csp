					----------------------------------------------------------------------
					-- Initial: i0
					module i0
					exports
					
						channel enter, interrupt
						
						Timed(OneStep) {
							D__(id__) = 
								dbisim(let
									Inactive 	= share__choice(enter -> SKIP [] terminate -> SKIP) ; Active
									
									Termination = terminate -> SKIP
									
									Active 		= share__choice(interrupt -> SKIP) ; Inactive
								within
									Inactive [| {terminate} |> SKIP)
							
							VS_O__(id__) = D__(id__)
						}
					
					endmodule
					----------------------------------------------------------------------
					
					-- END of Nodes --
					
					Timed(OneStep) {
					-- Operation calls --
					-- Only the undefined operations are declared here.
					-- If the state machine is in isolation, all required operations will be undefined.
					-- If it is in the context of a controller, the required operations not provided by the
					-- controller will be declared here, and the defined operations will be defined in the
					-- context of the Controller module, and therefore within scope of the state machine module.
					
					-- END of Operation calls --
				
					-- STM processes
					STM(id__) = -- RULE: [[stm:StateMachineDef]]_STM^nops : CSPProcess
					( 
						(
							(
								(IteratedStateful(id__) \ {terminate} ; share__choice(terminate -> SKIP))
							 	[[ share__ <- x__ | x__ <- {|set_EXT_valveOpen,set_EXT_PUMPS,set_EXT_DT,set_EXT_TOLERANCE,set_EXT_stopPresent,set_EXT_waitingPresent,set_EXT_readyPresent,set_EXT_levelSeen,set_EXT_steamSeen,set_EXT_levelValue,set_EXT_steamValue,set_EXT_levelRepairedSeen,set_EXT_steamRepairedSeen,set_EXT_levelAckSeen,set_EXT_steamAckSeen,set_EXT_malformed,set_EXT_levelJustRepaired,set_EXT_programReadySent,set_EXT_plantWaiting,set_EXT_stopCount,set_EXT_transmissionFailed,set_EXT_lastLevel,set_EXT_lastSteam,set_EXT_trustedSteam,set_EXT_steamTrusted,set_EXT_levelGrounded,set_EXT_throughput,set_EXT_levelOutOfOrder,set_EXT_steamOutOfOrder,set_EXT_failedPumps,set_EXT_failedControls,set_EXT_currentLevel,set_EXT_minimumNext,set_EXT_maximumNext,set_EXT_initialisationAbort,set_EXT_operationAbort,set_EXT_rescueAbort,set_EXT_otherUnitOutOfOrder,set_EXT_underNormalBand,set_EXT_overNormalBand,set_EXT_initAbort,set_EXT_unitsReady,set_EXT_otherUnitFailed,set_EXT_levelAboveNormal,set_EXT_levelBelowNormal,set_EXT_operatingAbort,set_EXT_levelFailed|} ]]
							)
						[| {share__} |]
						SKIP
						)
						[| union(sharedVarSync,{terminate}) |]
						dbisim(sharedVarMemory(id__))
					)\sharedVarHide
					
					STM_VS_O(id__) = -- RULE: [[stm:StateMachineDef]]_STM^nops : CSPProcess
					( 
						(
							(
								(IteratedStateful_VS_O(id__) \ {terminate} ; share__choice(terminate -> SKIP))
							 	[[ share__ <- x__ | x__ <- {|set_EXT_valveOpen,set_EXT_PUMPS,set_EXT_DT,set_EXT_TOLERANCE,set_EXT_stopPresent,set_EXT_waitingPresent,set_EXT_readyPresent,set_EXT_levelSeen,set_EXT_steamSeen,set_EXT_levelValue,set_EXT_steamValue,set_EXT_levelRepairedSeen,set_EXT_steamRepairedSeen,set_EXT_levelAckSeen,set_EXT_steamAckSeen,set_EXT_malformed,set_EXT_levelJustRepaired,set_EXT_programReadySent,set_EXT_plantWaiting,set_EXT_stopCount,set_EXT_transmissionFailed,set_EXT_lastLevel,set_EXT_lastSteam,set_EXT_trustedSteam,set_EXT_steamTrusted,set_EXT_levelGrounded,set_EXT_throughput,set_EXT_levelOutOfOrder,set_EXT_steamOutOfOrder,set_EXT_failedPumps,set_EXT_failedControls,set_EXT_currentLevel,set_EXT_minimumNext,set_EXT_maximumNext,set_EXT_initialisationAbort,set_EXT_operationAbort,set_EXT_rescueAbort,set_EXT_otherUnitOutOfOrder,set_EXT_underNormalBand,set_EXT_overNormalBand,set_EXT_initAbort,set_EXT_unitsReady,set_EXT_otherUnitFailed,set_EXT_levelAboveNormal,set_EXT_levelBelowNormal,set_EXT_operatingAbort,set_EXT_levelFailed|} ]]
							)
						[| {share__} |]
						SKIP
						)
						[| union(sharedVarSync,{terminate}) |]
						dbisim(sharedVarMemory(id__))
					)\sharedVarHide
					
					-- Transitions
					Transitions(id__) = ((let
						Trans = share__choice(get_levelBelowNormal?levelBelowNormal -> get_otherUnitFailed?otherUnitFailed -> get_valveOpen?valveOpen -> get_rescueAbort?rescueAbort -> get_plantWaiting?plantWaiting -> get_levelAboveNormal?levelAboveNormal -> get_initAbort?initAbort -> get_unitsReady?unitsReady -> get_operatingAbort?operatingAbort -> get_levelFailed?levelFailed -> TimeOut_1(
							 (share__ -> SKIP
							 [] dbisim((true)&(internal__!NID_i0 -> SKIP ;  ((SKIP ; INITIALIZATION::enter -> SKIP))))
							 [] dbisim((initAbort)&(transmissionReceived__!NID_INITIALIZATION.in -> SKIP ;  share__choice(exit -> SKIP) ; (share__choice(exited -> SKIP) ; SKIP ; EMERGENCY_STOP::enter -> SKIP)))
							 [] dbisim((((not ((initAbort))) and (not ((plantWaiting)))))&(transmissionReceived__!NID_INITIALIZATION.in -> SKIP ;  share__choice(exit -> SKIP) ; (share__choice(exited -> SKIP) ; true&(share__choice(modeMessage.out -> SKIP)) ; INITIALIZATION::enter -> SKIP)))
							 [] dbisim((((((not ((initAbort))) and plantWaiting) and unitsReady) and (not ((otherUnitFailed)))))&(transmissionReceived__!NID_INITIALIZATION.in -> SKIP ;  share__choice(exit -> SKIP) ; (share__choice(exited -> SKIP) ; SKIP ; NORMAL::enter -> SKIP)))
							 [] dbisim((((((not ((initAbort))) and plantWaiting) and unitsReady) and otherUnitFailed))&(transmissionReceived__!NID_INITIALIZATION.in -> SKIP ;  share__choice(exit -> SKIP) ; (share__choice(exited -> SKIP) ; SKIP ; DEGRADED::enter -> SKIP)))
