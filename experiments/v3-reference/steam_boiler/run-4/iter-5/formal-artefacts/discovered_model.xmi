    <typeMember xsi:type="spoon:CtMethod" name="issue">
      <comment xsi:type="spoon:CtJavaDoc" commentContent="Issues the cycle's device commands for the mode the controller has just decided."/>
      <modifier>PUBLIC</modifier>
      <body xsi:type="spoon:CtBlock">
        <statement xsi:type="spoon:CtLocalVariable" name="below">
          <type name="boolean"/>
          <assignment xsi:type="spoon:CtInvocation">
            <type name="boolean"/>
            <target xsi:type="spoon:CtFieldRead">
              <type name="BoilerSensor">
                <packageRef name="steam_boiler.sensor"/>
              </type>
              <variable xsi:type="spoon:CtFieldReference" name="sensor" isFinal="true">
                <declaringType name="DeviceCommands">
                  <packageRef name="steam_boiler.actuator"/>
                </declaringType>
              </variable>
              <target xsi:type="spoon:CtThisAccess" isImplicit="true">
                <type name="DeviceCommands">
                  <packageRef name="steam_boiler.actuator"/>
                </type>
                <target xsi:type="spoon:CtTypeAccess">
                  <type name="void"/>
                  <accessedType name="DeviceCommands">
                    <packageRef name="steam_boiler.actuator"/>
                  </accessedType>
                </target>
              </target>
            </target>
            <executableRef name="levelUnderNormalBand">
              <declaringType name="BoilerSensor">
                <packageRef name="steam_boiler.sensor"/>
              </declaringType>
            </executableRef>
          </assignment>
        </statement>
        <statement xsi:type="spoon:CtLocalVariable" name="above">
          <type name="boolean"/>
          <assignment xsi:type="spoon:CtInvocation">
            <type name="boolean"/>
            <target xsi:type="spoon:CtFieldRead">
              <type name="BoilerSensor">
                <packageRef name="steam_boiler.sensor"/>
              </type>
              <variable xsi:type="spoon:CtFieldReference" name="sensor" isFinal="true">
                <declaringType name="DeviceCommands">
                  <packageRef name="steam_boiler.actuator"/>
                </declaringType>
              </variable>
              <target xsi:type="spoon:CtThisAccess" isImplicit="true">
                <type name="DeviceCommands">
                  <packageRef name="steam_boiler.actuator"/>
                </type>
                <target xsi:type="spoon:CtTypeAccess">
                  <type name="void"/>
                  <accessedType name="DeviceCommands">
                    <packageRef name="steam_boiler.actuator"/>
                  </accessedType>
                </target>
              </target>
            </target>
            <executableRef name="levelOverNormalBand">
              <declaringType name="BoilerSensor">
                <packageRef name="steam_boiler.sensor"/>
              </declaringType>
            </executableRef>
          </assignment>
        </statement>
        <statement xsi:type="spoon:CtIf">
          <else xsi:type="spoon:CtBlock" isImplicit="true">
            <statement xsi:type="spoon:CtIf">
              <condition xsi:type="spoon:CtBinaryOperator">
                <type name="boolean"/>
                <leftOperand xsi:type="spoon:CtBinaryOperator">
                  <type name="boolean"/>
                  <leftOperand xsi:type="spoon:CtBinaryOperator" operatorKind="EQ">
                    <type name="boolean"/>
                    <leftOperand xsi:type="spoon:CtVariableRead">
                      <type name="BoilerMode">
                        <packageRef name="steam_boiler.domain"/>
                      </type>
                      <variable xsi:type="spoon:CtParameterReference" name="mode"/>
                    </leftOperand>
                    <rightOperand xsi:type="spoon:CtFieldRead">
                      <type name="BoilerMode">
                        <packageRef name="steam_boiler.domain"/>
                      </type>
                      <variable xsi:type="spoon:CtFieldReference" name="NORMAL" isFinal="true" isStatic="true">
                        <declaringType name="BoilerMode">
                          <packageRef name="steam_boiler.domain"/>
                        </declaringType>
                      </variable>
                      <target xsi:type="spoon:CtTypeAccess">
                        <type name="void"/>
                        <accessedType name="BoilerMode">
                          <packageRef isImplicit="true" name="steam_boiler.domain"/>
                        </accessedType>
                      </target>
                    </rightOperand>
                  </leftOperand>
                  <rightOperand xsi:type="spoon:CtBinaryOperator" operatorKind="EQ">
                    <type name="boolean"/>
                    <leftOperand xsi:type="spoon:CtVariableRead">
                      <type name="BoilerMode">
                        <packageRef name="steam_boiler.domain"/>
                      </type>
                      <variable xsi:type="spoon:CtParameterReference" name="mode"/>
                    </leftOperand>
                    <rightOperand xsi:type="spoon:CtFieldRead">
                      <type name="BoilerMode">
                        <packageRef name="steam_boiler.domain"/>
                      </type>
                      <variable xsi:type="spoon:CtFieldReference" name="DEGRADED" isFinal="true" isStatic="true">
                        <declaringType name="BoilerMode">
                          <packageRef name="steam_boiler.domain"/>
                        </declaringType>
                      </variable>
                      <target xsi:type="spoon:CtTypeAccess">
                        <type name="void"/>
                        <accessedType name="BoilerMode">
                          <packageRef isImplicit="true" name="steam_boiler.domain"/>
                        </accessedType>
                      </target>
                    </rightOperand>
                  </rightOperand>
                </leftOperand>
                <rightOperand xsi:type="spoon:CtBinaryOperator" operatorKind="EQ">
                  <type name="boolean"/>
                  <leftOperand xsi:type="spoon:CtVariableRead">
                    <type name="BoilerMode">
                      <packageRef name="steam_boiler.domain"/>
                    </type>
                    <variable xsi:type="spoon:CtParameterReference" name="mode"/>
                  </leftOperand>
                  <rightOperand xsi:type="spoon:CtFieldRead">
                    <type name="BoilerMode">
                      <packageRef name="steam_boiler.domain"/>
                    </type>
                    <variable xsi:type="spoon:CtFieldReference" name="RESCUE" isFinal="true" isStatic="true">
                      <declaringType name="BoilerMode">
                        <packageRef name="steam_boiler.domain"/>
                      </declaringType>
                    </variable>
                    <target xsi:type="spoon:CtTypeAccess">
                      <type name="void"/>
                      <accessedType name="BoilerMode">
                        <packageRef isImplicit="true" name="steam_boiler.domain"/>
                      </accessedType>
                    </target>
                  </rightOperand>
                </rightOperand>
              </condition>
              <then xsi:type="spoon:CtBlock">
                <statement xsi:type="spoon:CtIf">
                  <comment commentContent="SB-Beh10, SB-Beh15, SB-Beh19: switch the pumps on below N1 and off above N2"/>
                  <comment commentContent="(in rescue mode the level is the estimate's middle)."/>
                  <else xsi:type="spoon:CtBlock" isImplicit="true">
                    <statement xsi:type="spoon:CtIf">
                      <condition xsi:type="spoon:CtVariableRead">
                        <type name="boolean"/>
                        <variable xsi:type="spoon:CtLocalVariableReference" name="above"/>
                      </condition>
                      <then xsi:type="spoon:CtBlock">
                        <statement xsi:type="spoon:CtInvocation">
                          <type name="void"/>
                          <target xsi:type="spoon:CtThisAccess" isImplicit="true">
                            <type name="DeviceCommands">
                              <packageRef name="steam_boiler.actuator"/>
                            </type>
                            <target xsi:type="spoon:CtTypeAccess">
                              <type name="void"/>
                              <accessedType name="DeviceCommands">
                                <packageRef name="steam_boiler.actuator"/>
                              </accessedType>
                            </target>
                          </target>
                          <executableRef name="orderAllPumps">
                            <argumentType name="boolean"/>
                            <declaringType name="DeviceCommands">
                              <packageRef name="steam_boiler.actuator"/>
                            </declaringType>
                          </executableRef>
                          <argument xsi:type="spoon:CtLiteral" value="false" valueKind="Boolean">
                            <type name="boolean"/>
                          </argument>
                        </statement>
                      </then>
                    </statement>
                  </else>
                  <condition xsi:type="spoon:CtVariableRead">
                    <type name="boolean"/>
                    <variable xsi:type="spoon:CtLocalVariableReference" name="below"/>
