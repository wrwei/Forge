    <typeMember xsi:type="spoon:CtMethod" name="initialisationEmergency">
      <comment xsi:type="spoon:CtJavaDoc" commentContent="Emergency stop is due in initialization (SB-Beh3, SB-Beh6, SB-Beh9,&#xA;SB-Beh23): STOP on three successive transmissions, a transmission&#xA;failure, or, once the plant is waiting, a defective level device or a&#xA;steam device that is defective or reports a non-zero rate."/>
      <modifier>PUBLIC</modifier>
      <body xsi:type="spoon:CtBlock">
        <statement xsi:type="spoon:CtReturn">
          <expression xsi:type="spoon:CtFieldRead">
            <type name="boolean"/>
            <variable xsi:type="spoon:CtFieldReference" name="initialisationEmergency">
              <declaringType name="BoilerSensor">
                <packageRef name="steam_boiler.sensor"/>
              </declaringType>
            </variable>
            <target xsi:type="spoon:CtThisAccess" isImplicit="true">
              <type name="BoilerSensor">
                <packageRef name="steam_boiler.sensor"/>
              </type>
              <target xsi:type="spoon:CtTypeAccess">
                <type name="void"/>
                <accessedType name="BoilerSensor">
                  <packageRef name="steam_boiler.sensor"/>
                </accessedType>
              </target>
            </target>
          </expression>
        </statement>
      </body>
      <type name="boolean"/>
    </typeMember>
    <typeMember xsi:type="spoon:CtMethod" name="operationEmergency">
      <comment xsi:type="spoon:CtJavaDoc" commentContent="Emergency stop is due in normal or degraded mode (SB-Beh13, SB-Beh14,&#xA;SB-Beh18, SB-Beh23, SB-FR8): STOP on three successive transmissions, a&#xA;transmission failure, a level at risk of reaching M1 or M2, or a level&#xA;device failure while the steam device or a pump controller is out of&#xA;order."/>
      <modifier>PUBLIC</modifier>
