                      <function xsi:type="robochart:StringExp" value="minimumLevelForecast"/>
                    </left>
                    <right xsi:type="robochart:CallExp">
                      <function xsi:type="robochart:StringExp" value="minLimit"/>
                    </right>
                  </left>
                  <right xsi:type="robochart:GreaterOrEqual">
                    <left xsi:type="robochart:CallExp">
                      <function xsi:type="robochart:StringExp" value="maximumLevelForecast"/>
                    </left>
                    <right xsi:type="robochart:CallExp">
                      <function xsi:type="robochart:StringExp" value="maxLimit"/>
                    </right>
                  </right>
                </right>
              </left>
              <right xsi:type="robochart:Or">
                <left xsi:type="robochart:CallExp">
                  <function xsi:type="robochart:StringExp" value="steamOutOfOrder"/>
                </left>
                <right xsi:type="robochart:CallExp">
                  <function xsi:type="robochart:StringExp" value="pumpControllerOutOfOrder"/>
                </right>
              </right>
            </exp>
          </left>
          <right xsi:type="robochart:CallExp">
            <function xsi:type="robochart:StringExp" value="levelOutOfOrder"/>
          </right>
        </left>
        <right xsi:type="robochart:And">
          <left xsi:type="robochart:Not">
            <exp xsi:type="robochart:LessThan">
              <left xsi:type="robochart:CallExp">
                <function xsi:type="robochart:StringExp" value="levelEstimate"/>
              </left>
              <right xsi:type="robochart:CallExp">
                <function xsi:type="robochart:StringExp" value="minNormal"/>
              </right>
            </exp>
          </left>
          <right xsi:type="robochart:Not">
            <exp xsi:type="robochart:GreaterThan">
              <left xsi:type="robochart:CallExp">
                <function xsi:type="robochart:StringExp" value="levelEstimate"/>
              </left>
              <right xsi:type="robochart:CallExp">
                <function xsi:type="robochart:StringExp" value="maxNormal"/>
              </right>
            </exp>
          </right>
        </right>
      </condition>
      <action xsi:type="robochart:CommunicationStmt">
        <communication event="//@machines.0/@events.1"/>
      </action>
    </transitions>
  </machines>
</robochart:RCPackage>
