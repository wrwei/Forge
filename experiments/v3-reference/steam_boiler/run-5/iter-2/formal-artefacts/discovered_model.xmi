  <spoon:CtClass name="SteamBoilerConstants">
    <comment xsi:type="spoon:CtJavaDoc" commentContent="The constant characteristics of the plant (SB-DM1, SB-DM2, SB-DM3) and of the protocol&#xA;(SB-V3, SB-Beh23). The requirements name these constants but give no values; the values&#xA;below are chosen so that M1 &amp;lt; N1 &amp;lt; N2 &amp;lt; M2 &amp;lt; C and so that one cycle of&#xA;worst-case steam (5 W) or pump (5 * 4 * P) evolution cannot carry the level from a normal&#xA;bound to a limit."/>
    <modifier>PUBLIC</modifier>
    <modifier>FINAL</modifier>
    <typeMember xsi:type="spoon:CtField" name="CAPACITY">
