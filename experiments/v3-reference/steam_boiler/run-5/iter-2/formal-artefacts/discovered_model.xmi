  <spoon:CtClass name="BoilerActuator">
    <comment xsi:type="spoon:CtJavaDoc" commentContent="The sending side of the message transmission system: collects the messages of the current&#xA;cycle's outgoing transmission, which are emitted together at the end of the cycle (SB-V3,&#xA;SB-DM8), and records the last mode reported and the position the evacuation valve was last&#xA;ordered to (SB-DM7)."/>
    <modifier>PUBLIC</modifier>
    <modifier>FINAL</modifier>
    <typeMember xsi:type="spoon:CtConstructor" isImplicit="true" name="&lt;init>">
