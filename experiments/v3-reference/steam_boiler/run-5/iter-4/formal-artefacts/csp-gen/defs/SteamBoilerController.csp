					)
				)
				 \ hideSet)
				[[
					transmissionReceived__.x____ <- transmissionReceived,
					mode__.x____ <- mode,
					programReady__.x____ <- programReady,
					valve__.x____ <- valve,
					closePump__.x____ <- closePump,
					openPump__.x____ <- openPump
					| x____ <- NIDS
				]]
			)
			 [| {| interrupt |} |] SKIP)
		)
		)
	
	Behaviour(id__) = 
		dbisim((MachineBody(id__)\ enteredSS)
		)
	
	IteratedBehaviour(id__) = 
