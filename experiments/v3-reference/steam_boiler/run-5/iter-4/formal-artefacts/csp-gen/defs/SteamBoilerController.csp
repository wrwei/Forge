	within
		Trans
	)
	)
	
	-- Stateful
	-- RULE: Stateful(stm:StateMachineBody) : CSPProcess
	
	-- Named process definitions
	MachineBody(id__) = 
		dbisim((
		let
			finalNodesEntered = {||}
		within
			((let
				-- IMPLEMENTATION NOTE:
				-- Here the 'enter' channel set is calculated explicitly because of the use of CSPM 
				-- modules for defining the semantics of each node.
				enterSS = {|
				NORMAL::enter,
				INITIALIZATION::enter,
				EMERGENCY_STOP::enter,
				DEGRADED::enter,
				RESCUE::enter,
				i0::enter
				|}
				hideSet = union(enterSS,{|exit,exited,internal__|})
			within 
				((let
					-- IMPLEMENTATION NOTE: the channel set 'enter' is calculated explicitly
					-- because CSPM modules are used for the semantics of Node.
					flowevts = union(enterSS,{|exit,exited,interrupt|})
					transSync = {|internal__.NID_i0,transmissionReceived__.NID_INITIALIZATION.in,transmissionReceived__.NID_INITIALIZATION.in,transmissionReceived__.NID_INITIALIZATION.in,transmissionReceived__.NID_INITIALIZATION.in,transmissionReceived__.NID_INITIALIZATION.in,transmissionReceived__.NID_INITIALIZATION.in,transmissionReceived__.NID_INITIALIZATION.in,transmissionReceived__.NID_INITIALIZATION.in,transmissionReceived__.NID_INITIALIZATION.in,transmissionReceived__.NID_INITIALIZATION.in,transmissionReceived__.NID_NORMAL.in,transmissionReceived__.NID_NORMAL.in,transmissionReceived__.NID_NORMAL.in,transmissionReceived__.NID_NORMAL.in,transmissionReceived__.NID_NORMAL.in,transmissionReceived__.NID_NORMAL.in,transmissionReceived__.NID_DEGRADED.in,transmissionReceived__.NID_DEGRADED.in,transmissionReceived__.NID_DEGRADED.in,transmissionReceived__.NID_DEGRADED.in,transmissionReceived__.NID_DEGRADED.in,transmissionReceived__.NID_DEGRADED.in,transmissionReceived__.NID_RESCUE.in,transmissionReceived__.NID_RESCUE.in,transmissionReceived__.NID_RESCUE.in,transmissionReceived__.NID_RESCUE.in,transmissionReceived__.NID_RESCUE.in,transmissionReceived__.NID_RESCUE.in,transmissionReceived__.NID_EMERGENCY_STOP.in|}
				within
					((
					 (((-- RULE composeNodes(nc:NodeContainer)^nops : CSPProcess
					   NORMAL::D__(id__)
					   [| { share__, terminate } |] (
					   INITIALIZATION::D__(id__)
					   [| { share__, terminate } |] (
					   EMERGENCY_STOP::D__(id__)
					   [| { share__, terminate } |] (
					   DEGRADED::D__(id__)
					   [| { share__, terminate } |] (
					   RESCUE::D__(id__)
					   [| { share__, terminate } |] (
					   i0::D__(id__)
					   )
					   )
					   )
					   )
					   )
					 )
					 [[NORMAL::interrupt <- x__ | x__ <- {|interrupt,transmissionReceived__.NID_NORMAL.in,transmissionReceived__.NID_NORMAL.in,transmissionReceived__.NID_NORMAL.in,transmissionReceived__.NID_NORMAL.in,transmissionReceived__.NID_NORMAL.in,transmissionReceived__.NID_NORMAL.in|}]]
					 [[INITIALIZATION::interrupt <- x__ | x__ <- {|interrupt,transmissionReceived__.NID_INITIALIZATION.in,transmissionReceived__.NID_INITIALIZATION.in,transmissionReceived__.NID_INITIALIZATION.in,transmissionReceived__.NID_INITIALIZATION.in,transmissionReceived__.NID_INITIALIZATION.in,transmissionReceived__.NID_INITIALIZATION.in,transmissionReceived__.NID_INITIALIZATION.in,transmissionReceived__.NID_INITIALIZATION.in,transmissionReceived__.NID_INITIALIZATION.in,transmissionReceived__.NID_INITIALIZATION.in|}]]
					 [[EMERGENCY_STOP::interrupt <- x__ | x__ <- {|interrupt,transmissionReceived__.NID_EMERGENCY_STOP.in|}]]
					 [[DEGRADED::interrupt <- x__ | x__ <- {|interrupt,transmissionReceived__.NID_DEGRADED.in,transmissionReceived__.NID_DEGRADED.in,transmissionReceived__.NID_DEGRADED.in,transmissionReceived__.NID_DEGRADED.in,transmissionReceived__.NID_DEGRADED.in,transmissionReceived__.NID_DEGRADED.in|}]]
					 [[RESCUE::interrupt <- x__ | x__ <- {|interrupt,transmissionReceived__.NID_RESCUE.in,transmissionReceived__.NID_RESCUE.in,transmissionReceived__.NID_RESCUE.in,transmissionReceived__.NID_RESCUE.in,transmissionReceived__.NID_RESCUE.in,transmissionReceived__.NID_RESCUE.in|}]]
					 [[i0::interrupt <- x__ | x__ <- {|internal__.NID_i0|}]]
					 )
