					 ((i0::enter -> Transitions(id__))
					  [[ share__ <- x__ | x__ <- {| share__,setL_belowNormal,setL_valveOpen,setL_plantWaiting,setL_readyAnnounced,setL_initializationAbort,setL_unitsReady,setL_levelFailed,setL_emergencyStop,setL_otherUnitFailed,setL_aboveNormal |} ]]
					 )
					)[[setL_belowNormal <- set_belowNormal,setL_valveOpen <- set_valveOpen,setL_plantWaiting <- set_plantWaiting,setL_readyAnnounced <- set_readyAnnounced,setL_initializationAbort <- set_initializationAbort,setL_unitsReady <- set_unitsReady,setL_levelFailed <- set_levelFailed,setL_emergencyStop <- set_emergencyStop,setL_otherUnitFailed <- set_otherUnitFailed,setL_aboveNormal <- set_aboveNormal]]
					)
