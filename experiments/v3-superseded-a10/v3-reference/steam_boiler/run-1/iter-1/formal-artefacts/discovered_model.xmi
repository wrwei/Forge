  <spoon:CtClass name="SteamBoilerProgram">
    <comment xsi:type="spoon:CtJavaDoc" commentContent="The steam-boiler control program: one call per five-second cycle. A cycle receives the&#xA;incoming messages (all considered simultaneous), analyses them, and returns the outgoing&#xA;messages (all emitted together). Once in emergency stop the program has stopped and&#xA;answers nothing."/>
    <modifier>FINAL</modifier>
    <modifier>PUBLIC</modifier>
    <typeMember xsi:type="spoon:CtConstructor" isImplicit="true" name="&lt;init>">
      <modifier>PUBLIC</modifier>
