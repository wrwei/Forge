	channel set_EXT_boilerWaitingSeen: core_boolean
	channel set_EXT_programReadySent: core_boolean
	channel set_EXT_valveOpen: core_boolean
	channel set_EXT_pumpObservation: PumpReading
	channel set_EXT_consecutiveStopCount: core_int
	channel set_EXT_boilerWaitingReceived: core_boolean
	channel set_EXT_transmissionFailed: core_boolean
	channel set_EXT_levelDeviceFailed: core_boolean
