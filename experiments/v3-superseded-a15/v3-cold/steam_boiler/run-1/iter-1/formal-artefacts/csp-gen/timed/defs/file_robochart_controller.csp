	channel get_pumpStartable, set_pumpStartable, setL_pumpStartable, setR_pumpStartable: core_boolean
	channel get_predictedLevelLow, set_predictedLevelLow, setL_predictedLevelLow, setR_predictedLevelLow: core_real
	channel get_predictedLevelHigh, set_predictedLevelHigh, setL_predictedLevelHigh, setR_predictedLevelHigh: core_real
	channel get_steamDeviceOutOfOrder, set_steamDeviceOutOfOrder, setL_steamDeviceOutOfOrder, setR_steamDeviceOutOfOrder: core_boolean
	channel get_anyPumpControllerOutOfOrder, set_anyPumpControllerOutOfOrder, setL_anyPumpControllerOutOfOrder, setR_anyPumpControllerOutOfOrder: core_boolean
	channel get_steamFailureDetected, set_steamFailureDetected, setL_steamFailureDetected, setR_steamFailureDetected: core_boolean
	channel get_pumpFailureDetected, set_pumpFailureDetected, setL_pumpFailureDetected, setR_pumpFailureDetected: core_boolean
	channel get_pumpControlFailureDetected, set_pumpControlFailureDetected, setL_pumpControlFailureDetected, setR_pumpControlFailureDetected: core_boolean
	channel get_pumpsRunning, set_pumpsRunning, setL_pumpsRunning, setR_pumpsRunning: core_int
	channel get_pumpsWanted, set_pumpsWanted, setL_pumpsWanted, setR_pumpsWanted: core_int
	channel get_levelRepairReported, set_levelRepairReported, setL_levelRepairReported, setR_levelRepairReported: core_boolean
	
