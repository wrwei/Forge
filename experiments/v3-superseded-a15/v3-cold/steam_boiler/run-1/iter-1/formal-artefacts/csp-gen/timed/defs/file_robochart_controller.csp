	-- declaring identifiers of transitions
	datatype NIDS = 
	              NID_EMERGENCY_STOP|
	              NID_RESCUE|
	              NID_DEGRADED|
	              NID_NORMAL|
	              NID_INITIALIZATION|
	              NID_i0
	
	channel internal__ : NIDS
	
	-- Flow channels		
	channel interrupt
	channel exited
	channel exit
	channel terminate
	
	-- Variable channels
	channel get_boilerWaitingSeen, set_boilerWaitingSeen, setL_boilerWaitingSeen, setR_boilerWaitingSeen: core_boolean
	channel get_programReadySent, set_programReadySent, setL_programReadySent, setR_programReadySent: core_boolean
	channel get_valveOpen, set_valveOpen, setL_valveOpen, setR_valveOpen: core_boolean
