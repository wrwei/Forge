	channel set_EXT_pumpsRunning: core_int
	channel set_EXT_pumpsWanted: core_int
	channel set_EXT_levelRepairReported: core_boolean
	
	-- Local variable channels for defined operations that are required by the state machine
	
	-- Declaring state machine events
	channel transmissionReceived__: NIDS.InOut
	channel transmissionReceived: InOut
	channel modeMessage__: NIDS.InOut
	channel modeMessage: InOut
	channel programReady__: NIDS.InOut
	channel programReady: InOut
	channel closePump__: NIDS.InOut
	channel closePump: InOut
	channel valveCommand__: NIDS.InOut
	channel valveCommand: InOut
	channel openPump__: NIDS.InOut
	channel openPump: InOut
	
	-- Declaring call and ret events for undefined operations
	
	enterSS = {|
	EMERGENCY_STOP::enter,
	RESCUE::enter,
	DEGRADED::enter,
	NORMAL::enter,
	INITIALIZATION::enter,
	i0::enter
	|}
	
	enteredSS = 	{|
	EMERGENCY_STOP::entered,
	RESCUE::entered,
	DEGRADED::entered,
	NORMAL::entered,
	INITIALIZATION::entered
	|}
	
	internal_events = union(enteredSS,union(enterSS,{|interrupt,exited|}))
	
	shared_variable_events = {|
		set_EXT_boilerWaitingSeen,
		set_EXT_programReadySent,
		set_EXT_valveOpen,
		set_EXT_pumpObservation,
		set_EXT_consecutiveStopCount,
		set_EXT_boilerWaitingReceived,
		set_EXT_transmissionFailed,
		set_EXT_levelDeviceFailed,
		set_EXT_steamNotZero,
		set_EXT_unitsReadyAnswered,
		set_EXT_everyUnitSound,
		set_EXT_levelMidpoint,
		set_EXT_pumpStoppable,
		set_EXT_pumpStartable,
		set_EXT_predictedLevelLow,
		set_EXT_predictedLevelHigh,
		set_EXT_steamDeviceOutOfOrder,
		set_EXT_anyPumpControllerOutOfOrder,
		set_EXT_steamFailureDetected,
		set_EXT_pumpFailureDetected,
		set_EXT_pumpControlFailureDetected,
		set_EXT_pumpsRunning,
		set_EXT_pumpsWanted,
		set_EXT_levelRepairReported
	|}
	
	-- channel set with all visible events
	sem__events = {|
		terminate
	,	set_EXT_boilerWaitingSeen, set_boilerWaitingSeen,
		set_EXT_programReadySent, set_programReadySent,
		set_EXT_valveOpen, set_valveOpen,
		set_EXT_pumpObservation, set_pumpObservation,
		set_EXT_consecutiveStopCount, set_consecutiveStopCount,
		set_EXT_boilerWaitingReceived, set_boilerWaitingReceived,
		set_EXT_transmissionFailed, set_transmissionFailed,
		set_EXT_levelDeviceFailed, set_levelDeviceFailed,
		set_EXT_steamNotZero, set_steamNotZero,
		set_EXT_unitsReadyAnswered, set_unitsReadyAnswered,
		set_EXT_everyUnitSound, set_everyUnitSound,
		set_EXT_levelMidpoint, set_levelMidpoint,
		set_EXT_pumpStoppable, set_pumpStoppable,
		set_EXT_pumpStartable, set_pumpStartable,
		set_EXT_predictedLevelLow, set_predictedLevelLow,
		set_EXT_predictedLevelHigh, set_predictedLevelHigh,
		set_EXT_steamDeviceOutOfOrder, set_steamDeviceOutOfOrder,
		set_EXT_anyPumpControllerOutOfOrder, set_anyPumpControllerOutOfOrder,
		set_EXT_steamFailureDetected, set_steamFailureDetected,
		set_EXT_pumpFailureDetected, set_pumpFailureDetected,
		set_EXT_pumpControlFailureDetected, set_pumpControlFailureDetected,
		set_EXT_pumpsRunning, set_pumpsRunning,
		set_EXT_pumpsWanted, set_pumpsWanted,
		set_EXT_levelRepairReported, set_levelRepairReported
	,	transmissionReceived,
		modeMessage,
		programReady,
		closePump,
		valveCommand,
		openPump
		|}
	
	channel clockReset, clockResetL, clockResetR 
	
	localClockResets = {||}
	
	
	channel get_CLID_RESCUE : core_clock_type 
	channel get_CLID_DEGRADED : core_clock_type 
	channel get_CLID_NORMAL : core_clock_type 
	channel get_CLID_INITIALIZATION : core_clock_type 
	channel get_CLID_EMERGENCY_STOP : core_clock_type 
	--channel increment__
	
	CLID_RESCUE_clock_type(id__,
			          const_SteamBoilerController_stopLimit,
			          const_SteamBoilerController_n2,
			          const_SteamBoilerController_n1,
			          const_SteamBoilerController_m1,
			          const_SteamBoilerController_m2) = 
		let
			max = (clock_type_max(Union({
	{}
	}))+1)
		ctype = {0..max}
	within
		if member(max,core_clock_type) then ctype else error("core_clock_type is not wide enough")
	
	CLID_DEGRADED_clock_type(id__,
			          const_SteamBoilerController_stopLimit,
			          const_SteamBoilerController_n2,
			          const_SteamBoilerController_n1,
			          const_SteamBoilerController_m1,
			          const_SteamBoilerController_m2) = 
		let
			max = (clock_type_max(Union({
	{}
	}))+1)
		ctype = {0..max}
	within
		if member(max,core_clock_type) then ctype else error("core_clock_type is not wide enough")
	
	CLID_NORMAL_clock_type(id__,
			          const_SteamBoilerController_stopLimit,
			          const_SteamBoilerController_n2,
