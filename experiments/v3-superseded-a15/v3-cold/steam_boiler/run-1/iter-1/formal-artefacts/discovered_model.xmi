                <packageRef name="steam_boiler.sensor"/>
              </declaringType>
            </variable>
            <target xsi:type="spoon:CtThisAccess" isImplicit="true">
              <type name="BoilerSensor">
                <packageRef name="steam_boiler.sensor"/>
              </type>
              <target xsi:type="spoon:CtTypeAccess">
                <type name="void"/>
                <accessedType name="BoilerSensor">
                  <packageRef name="steam_boiler.sensor"/>
                </accessedType>
              </target>
            </target>
          </condition>
          <then xsi:type="spoon:CtBlock">
            <statement xsi:type="spoon:CtAssignment">
              <type name="int"/>
              <assignment xsi:type="spoon:CtBinaryOperator" operatorKind="PLUS">
                <type name="int"/>
                <leftOperand xsi:type="spoon:CtFieldRead">
                  <type name="int"/>
