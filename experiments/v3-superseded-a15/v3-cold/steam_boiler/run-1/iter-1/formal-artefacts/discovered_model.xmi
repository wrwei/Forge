    <typeMember xsi:type="spoon:CtMethod" name="analyse">
      <comment xsi:type="spoon:CtJavaDoc" commentContent="Analysis stage: counts successive STOPs, applies repairs and&#xA;acknowledgements, judges the transmission and every unit, and derives&#xA;the level, steam and pump quantities for the current cycle."/>
      <modifier>PUBLIC</modifier>
      <body xsi:type="spoon:CtBlock">
        <statement xsi:type="spoon:CtIf">
