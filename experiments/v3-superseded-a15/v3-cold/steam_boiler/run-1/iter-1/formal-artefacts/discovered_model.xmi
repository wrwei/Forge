    <typeMember xsi:type="spoon:CtMethod" name="runCycle">
      <comment xsi:type="spoon:CtJavaDoc" commentContent="Runs one cycle on the messages of one transmission and returns the&#xA;messages to transmit. Once in emergency stop the program has stopped&#xA;and returns no messages (SB-Beh22)."/>
      <modifier>PUBLIC</modifier>
      <body xsi:type="spoon:CtBlock">
        <statement xsi:type="spoon:CtLocalVariable" name="outgoing">
          <type name="List">
            <typeArgument name="OutputEvent">
              <packageRef isImplicit="true" name="steam_boiler.event"/>
            </typeArgument>
            <packageRef isImplicit="true" name="java.util"/>
          </type>
          <assignment xsi:type="spoon:CtConstructorCall">
            <type name="ArrayList">
              <typeArgument isImplicit="true" name="OutputEvent">
                <packageRef name="steam_boiler.event"/>
              </typeArgument>
              <packageRef isImplicit="true" name="java.util"/>
            </type>
            <executableRef isImplicit="true" name="&lt;init>">
              <declaringType name="ArrayList">
                <packageRef name="java.util"/>
              </declaringType>
            </executableRef>
          </assignment>
        </statement>
        <statement xsi:type="spoon:CtIf">
          <condition xsi:type="spoon:CtBinaryOperator" operatorKind="EQ">
            <type name="boolean"/>
            <leftOperand xsi:type="spoon:CtInvocation">
              <type name="OperatingMode">
                <packageRef name="steam_boiler.controller"/>
              </type>
              <target xsi:type="spoon:CtFieldRead">
                <type name="SteamBoilerController">
                  <packageRef name="steam_boiler.controller"/>
                </type>
                <variable xsi:type="spoon:CtFieldReference" name="controller" isFinal="true">
                  <declaringType name="SteamBoilerProgram">
                    <packageRef name="steam_boiler"/>
                  </declaringType>
                </variable>
                <target xsi:type="spoon:CtThisAccess" isImplicit="true">
                  <type name="SteamBoilerProgram">
                    <packageRef name="steam_boiler"/>
                  </type>
                  <target xsi:type="spoon:CtTypeAccess">
                    <type name="void"/>
                    <accessedType name="SteamBoilerProgram">
                      <packageRef name="steam_boiler"/>
                    </accessedType>
                  </target>
                </target>
              </target>
              <executableRef name="currentMode">
                <declaringType name="SteamBoilerController">
                  <packageRef name="steam_boiler.controller"/>
                </declaringType>
              </executableRef>
            </leftOperand>
            <rightOperand xsi:type="spoon:CtFieldRead">
              <type name="OperatingMode">
                <packageRef name="steam_boiler.controller"/>
              </type>
              <variable xsi:type="spoon:CtFieldReference" name="EMERGENCY_STOP" isFinal="true" isStatic="true">
                <declaringType name="OperatingMode">
                  <packageRef name="steam_boiler.controller"/>
                </declaringType>
              </variable>
              <target xsi:type="spoon:CtTypeAccess">
                <type name="void"/>
                <accessedType name="OperatingMode">
                  <packageRef isImplicit="true" name="steam_boiler.controller"/>
                </accessedType>
              </target>
            </rightOperand>
          </condition>
          <then xsi:type="spoon:CtBlock">
            <statement xsi:type="spoon:CtReturn">
              <expression xsi:type="spoon:CtVariableRead">
                <type name="List">
                  <typeArgument name="OutputEvent">
                    <packageRef name="steam_boiler.event"/>
                  </typeArgument>
                  <packageRef name="java.util"/>
                </type>
                <variable xsi:type="spoon:CtLocalVariableReference" name="outgoing"/>
              </expression>
            </statement>
          </then>
        </statement>
        <statement xsi:type="spoon:CtInvocation">
          <type name="void"/>
          <target xsi:type="spoon:CtFieldRead">
            <type name="BoilerSensor">
              <packageRef name="steam_boiler.sensor"/>
            </type>
            <variable xsi:type="spoon:CtFieldReference" name="sensor" isFinal="true">
              <declaringType name="SteamBoilerProgram">
                <packageRef name="steam_boiler"/>
              </declaringType>
            </variable>
            <target xsi:type="spoon:CtThisAccess" isImplicit="true">
              <type name="SteamBoilerProgram">
                <packageRef name="steam_boiler"/>
              </type>
              <target xsi:type="spoon:CtTypeAccess">
                <type name="void"/>
                <accessedType name="SteamBoilerProgram">
                  <packageRef name="steam_boiler"/>
                </accessedType>
              </target>
            </target>
          </target>
          <executableRef name="beginCycle">
            <declaringType name="BoilerSensor">
              <packageRef name="steam_boiler.sensor"/>
            </declaringType>
          </executableRef>
        </statement>
        <statement xsi:type="spoon:CtForEach">
          <body xsi:type="spoon:CtBlock">
            <statement xsi:type="spoon:CtInvocation">
              <type name="void"/>
              <target xsi:type="spoon:CtFieldRead">
                <type name="BoilerSensor">
                  <packageRef name="steam_boiler.sensor"/>
                </type>
                <variable xsi:type="spoon:CtFieldReference" name="sensor" isFinal="true">
                  <declaringType name="SteamBoilerProgram">
                    <packageRef name="steam_boiler"/>
                  </declaringType>
                </variable>
                <target xsi:type="spoon:CtThisAccess" isImplicit="true">
                  <type name="SteamBoilerProgram">
                    <packageRef name="steam_boiler"/>
                  </type>
                  <target xsi:type="spoon:CtTypeAccess">
                    <type name="void"/>
                    <accessedType name="SteamBoilerProgram">
                      <packageRef name="steam_boiler"/>
                    </accessedType>
                  </target>
                </target>
              </target>
              <executableRef name="receive">
                <argumentType name="InputEvent">
                  <packageRef name="steam_boiler.event"/>
                </argumentType>
                <declaringType name="BoilerSensor">
                  <packageRef name="steam_boiler.sensor"/>
                </declaringType>
              </executableRef>
              <argument xsi:type="spoon:CtVariableRead">
                <type name="InputEvent">
                  <packageRef name="steam_boiler.event"/>
                </type>
                <variable xsi:type="spoon:CtLocalVariableReference" name="message"/>
              </argument>
            </statement>
          </body>
          <expression xsi:type="spoon:CtVariableRead">
            <type name="List">
              <typeArgument name="InputEvent">
                <packageRef name="steam_boiler.event"/>
              </typeArgument>
              <packageRef name="java.util"/>
            </type>
            <variable xsi:type="spoon:CtParameterReference" name="incoming"/>
          </expression>
          <foreachVariable name="message">
