                  <assigned xsi:type="spoon:CtVariableWrite">
                    <type name="boolean"/>
                    <variable xsi:type="spoon:CtLocalVariableReference" name="outOfOrder"/>
                  </assigned>
                </statement>
              </then>
            </statement>
          </body>
          <forInit xsi:type="spoon:CtLocalVariable" name="i">
            <type name="int"/>
            <assignment xsi:type="spoon:CtLiteral" value="0" valueKind="Integer">
