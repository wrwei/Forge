diagram SteamBoilerController

enumeration PumpPosition { PUMP_OFF PUMP_ON }
enumeration WaterFlow { NO_WATER_FLOW WATER_FLOWING }

datatype PumpControlReading {
	controlledPump : int
	flow : WaterFlow
}

datatype PumpReading {
	pumpNumber : int
	position : PumpPosition
}

interface Inputs {
	event transmissionReceived
}

interface Outputs {
	event modeMessage
	event programReady
	event closePump
	event valveCommand
	event openPump
}

interface Sensors {
	var pumpObservation : PumpReading
	var consecutiveStopCount : int
	var boilerWaitingReceived : boolean
	var transmissionFailed : boolean
	var levelDeviceFailed : boolean
	var steamNotZero : boolean
	var unitsReadyAnswered : boolean
	var everyUnitSound : boolean
	var levelMidpoint : real
	var pumpStoppable : boolean
	var pumpStartable : boolean
	var predictedLevelLow : real
	var predictedLevelHigh : real
	var steamDeviceOutOfOrder : boolean
	var anyPumpControllerOutOfOrder : boolean
	var steamFailureDetected : boolean
	var pumpFailureDetected : boolean
	var pumpControlFailureDetected : boolean
	var pumpsRunning : int
	var pumpsWanted : int
	var levelRepairReported : boolean
}

interface Actuators {
}

interface SteamBoilerController_State {
	var boilerWaitingSeen : boolean = false
	var programReadySent : boolean = false
	var valveOpen : boolean = false
}

interface Constants {
	const stopLimit : real = 3
	const n2 : real = 600
	const n1 : real = 400
	const m1 : real = 125
	const m2 : real = 800
}

stm SteamBoilerController {
	uses Inputs uses Outputs requires SteamBoilerController_State requires Constants requires Sensors
	state EMERGENCY_STOP {
		entry send modeMessage
	}
	state RESCUE {
		entry send modeMessage
	}
	state DEGRADED {
		entry send modeMessage
	}
	state NORMAL {
		entry send modeMessage
	}
	state INITIALIZATION {
	}
	initial i0
	transition t_init {
		from i0
		to INITIALIZATION
	}
	transition t1 {
		from INITIALIZATION
		to EMERGENCY_STOP
		trigger transmissionReceived
		condition consecutiveStopCount >= stopLimit
	}
	transition t2 {
		from INITIALIZATION
		to INITIALIZATION
		trigger transmissionReceived
		condition not ( consecutiveStopCount >= stopLimit ) /\ not ( boilerWaitingSeen \/ boilerWaitingReceived )
		action send modeMessage
	}
	transition t3 {
		from INITIALIZATION
		to EMERGENCY_STOP
		trigger transmissionReceived
		condition not ( consecutiveStopCount >= stopLimit ) /\ (boilerWaitingSeen \/ boilerWaitingReceived) /\ transmissionFailed
	}
	transition t4 {
		from INITIALIZATION
		to EMERGENCY_STOP
		trigger transmissionReceived
		condition not ( consecutiveStopCount >= stopLimit ) /\ (boilerWaitingSeen \/ boilerWaitingReceived) /\ not ( transmissionFailed ) /\ levelDeviceFailed
	}
	transition t5 {
		from INITIALIZATION
		to EMERGENCY_STOP
		trigger transmissionReceived
		condition not ( consecutiveStopCount >= stopLimit ) /\ (boilerWaitingSeen \/ boilerWaitingReceived) /\ not ( transmissionFailed ) /\ not ( levelDeviceFailed ) /\ steamNotZero
	}
	transition t6 {
		from INITIALIZATION
		to NORMAL
		trigger transmissionReceived
		condition not ( consecutiveStopCount >= stopLimit ) /\ (boilerWaitingSeen \/ boilerWaitingReceived) /\ not ( transmissionFailed ) /\ not ( levelDeviceFailed ) /\ not ( steamNotZero ) /\ programReadySent /\ unitsReadyAnswered /\ everyUnitSound
	}
	transition t7 {
		from INITIALIZATION
		to DEGRADED
		trigger transmissionReceived
		condition not ( consecutiveStopCount >= stopLimit ) /\ (boilerWaitingSeen \/ boilerWaitingReceived) /\ not ( transmissionFailed ) /\ not ( levelDeviceFailed ) /\ not ( steamNotZero ) /\ programReadySent /\ unitsReadyAnswered /\ not ( everyUnitSound )
	}
	transition t8 {
		from INITIALIZATION
		to INITIALIZATION
		trigger transmissionReceived
		condition not ( consecutiveStopCount >= stopLimit ) /\ (boilerWaitingSeen \/ boilerWaitingReceived) /\ not ( transmissionFailed ) /\ not ( levelDeviceFailed ) /\ not ( steamNotZero ) /\ programReadySent /\ not ( unitsReadyAnswered )
		action send modeMessage ; send programReady
	}
	transition t9 {
		from INITIALIZATION
		to INITIALIZATION
		trigger transmissionReceived
		condition not ( consecutiveStopCount >= stopLimit ) /\ (boilerWaitingSeen \/ boilerWaitingReceived) /\ not ( transmissionFailed ) /\ not ( levelDeviceFailed ) /\ not ( steamNotZero ) /\ not ( programReadySent ) /\ levelMidpoint > n2 /\ pumpStoppable
		action boilerWaitingSeen = true ; send modeMessage ; send closePump
	}
	transition t10 {
		from INITIALIZATION
		to INITIALIZATION
		trigger transmissionReceived
		condition not ( consecutiveStopCount >= stopLimit ) /\ (boilerWaitingSeen \/ boilerWaitingReceived) /\ not ( transmissionFailed ) /\ not ( levelDeviceFailed ) /\ not ( steamNotZero ) /\ not ( programReadySent ) /\ levelMidpoint > n2 /\ not ( pumpStoppable ) /\ not ( valveOpen )
		action boilerWaitingSeen = true ; valveOpen = true ; send modeMessage ; send valveCommand
	}
	transition t11 {
		from INITIALIZATION
		to INITIALIZATION
		trigger transmissionReceived
		condition not ( consecutiveStopCount >= stopLimit ) /\ (boilerWaitingSeen \/ boilerWaitingReceived) /\ not ( transmissionFailed ) /\ not ( levelDeviceFailed ) /\ not ( steamNotZero ) /\ not ( programReadySent ) /\ levelMidpoint > n2 /\ not ( pumpStoppable ) /\ valveOpen
		action boilerWaitingSeen = true ; send modeMessage
	}
	transition t12 {
		from INITIALIZATION
		to INITIALIZATION
		trigger transmissionReceived
		condition not ( consecutiveStopCount >= stopLimit ) /\ (boilerWaitingSeen \/ boilerWaitingReceived) /\ not ( transmissionFailed ) /\ not ( levelDeviceFailed ) /\ not ( steamNotZero ) /\ not ( programReadySent ) /\ levelMidpoint < n1 /\ valveOpen
		action boilerWaitingSeen = true ; valveOpen = false ; send modeMessage ; send valveCommand
	}
	transition t13 {
		from INITIALIZATION
		to INITIALIZATION
		trigger transmissionReceived
		condition not ( consecutiveStopCount >= stopLimit ) /\ (boilerWaitingSeen \/ boilerWaitingReceived) /\ not ( transmissionFailed ) /\ not ( levelDeviceFailed ) /\ not ( steamNotZero ) /\ not ( programReadySent ) /\ levelMidpoint < n1 /\ not ( valveOpen ) /\ not ( pumpStoppable ) /\ pumpStartable
		action boilerWaitingSeen = true ; send modeMessage ; send openPump
	}
	transition t14 {
		from INITIALIZATION
		to INITIALIZATION
		trigger transmissionReceived
		condition not ( consecutiveStopCount >= stopLimit ) /\ (boilerWaitingSeen \/ boilerWaitingReceived) /\ not ( transmissionFailed ) /\ not ( levelDeviceFailed ) /\ not ( steamNotZero ) /\ not ( programReadySent ) /\ levelMidpoint < n1 /\ not ( valveOpen ) /\ (pumpStoppable \/ not ( pumpStartable ))
		action boilerWaitingSeen = true ; send modeMessage
	}
	transition t15 {
		from INITIALIZATION
		to INITIALIZATION
		trigger transmissionReceived
		condition not ( consecutiveStopCount >= stopLimit ) /\ (boilerWaitingSeen \/ boilerWaitingReceived) /\ not ( transmissionFailed ) /\ not ( levelDeviceFailed ) /\ not ( steamNotZero ) /\ not ( programReadySent ) /\ not ( levelMidpoint < n1 ) /\ not ( levelMidpoint > n2 ) /\ valveOpen
		action boilerWaitingSeen = true ; valveOpen = false ; programReadySent = true ; send modeMessage ; send valveCommand ; send programReady
	}
	transition t16 {
		from INITIALIZATION
		to INITIALIZATION
		trigger transmissionReceived
		condition not ( consecutiveStopCount >= stopLimit ) /\ (boilerWaitingSeen \/ boilerWaitingReceived) /\ not ( transmissionFailed ) /\ not ( levelDeviceFailed ) /\ not ( steamNotZero ) /\ not ( programReadySent ) /\ not ( levelMidpoint < n1 ) /\ not ( levelMidpoint > n2 ) /\ not ( valveOpen ) /\ pumpStoppable
		action boilerWaitingSeen = true ; programReadySent = true ; send modeMessage ; send closePump ; send programReady
	}
	transition t17 {
		from INITIALIZATION
		to INITIALIZATION
		trigger transmissionReceived
		condition not ( consecutiveStopCount >= stopLimit ) /\ (boilerWaitingSeen \/ boilerWaitingReceived) /\ not ( transmissionFailed ) /\ not ( levelDeviceFailed ) /\ not ( steamNotZero ) /\ not ( programReadySent ) /\ not ( levelMidpoint < n1 ) /\ not ( levelMidpoint > n2 ) /\ not ( valveOpen ) /\ not ( pumpStoppable )
		action boilerWaitingSeen = true ; programReadySent = true ; send modeMessage ; send programReady
	}
	transition t18 {
		from NORMAL
		to EMERGENCY_STOP
		trigger transmissionReceived
		condition consecutiveStopCount >= stopLimit
	}
	transition t19 {
		from NORMAL
		to EMERGENCY_STOP
		trigger transmissionReceived
		condition not ( consecutiveStopCount >= stopLimit ) /\ (transmissionFailed \/ predictedLevelLow <= m1 \/ predictedLevelHigh >= m2)
	}
	transition t20 {
		from NORMAL
		to EMERGENCY_STOP
		trigger transmissionReceived
		condition not ( consecutiveStopCount >= stopLimit ) /\ not ( transmissionFailed \/ predictedLevelLow <= m1 \/ predictedLevelHigh >= m2 ) /\ levelDeviceFailed /\ (steamDeviceOutOfOrder \/ anyPumpControllerOutOfOrder)
	}
	transition t21 {
		from NORMAL
		to RESCUE
		trigger transmissionReceived
		condition not ( consecutiveStopCount >= stopLimit ) /\ not ( transmissionFailed \/ predictedLevelLow <= m1 \/ predictedLevelHigh >= m2 ) /\ levelDeviceFailed /\ not ( steamDeviceOutOfOrder \/ anyPumpControllerOutOfOrder )
	}
	transition t22 {
		from NORMAL
		to DEGRADED
		trigger transmissionReceived
		condition not ( consecutiveStopCount >= stopLimit ) /\ not ( transmissionFailed \/ predictedLevelLow <= m1 \/ predictedLevelHigh >= m2 ) /\ not ( levelDeviceFailed ) /\ (steamFailureDetected \/ pumpFailureDetected \/ pumpControlFailureDetected)
	}
	transition t23 {
		from NORMAL
		to NORMAL
		trigger transmissionReceived
		condition not ( consecutiveStopCount >= stopLimit ) /\ not ( transmissionFailed \/ predictedLevelLow <= m1 \/ predictedLevelHigh >= m2 ) /\ not ( levelDeviceFailed ) /\ not ( steamFailureDetected \/ pumpFailureDetected \/ pumpControlFailureDetected ) /\ pumpsRunning < pumpsWanted /\ pumpStartable
		action send modeMessage ; send openPump
	}
	transition t24 {
		from NORMAL
		to NORMAL
		trigger transmissionReceived
		condition not ( consecutiveStopCount >= stopLimit ) /\ not ( transmissionFailed \/ predictedLevelLow <= m1 \/ predictedLevelHigh >= m2 ) /\ not ( levelDeviceFailed ) /\ not ( steamFailureDetected \/ pumpFailureDetected \/ pumpControlFailureDetected ) /\ pumpsRunning > pumpsWanted /\ pumpStoppable
		action send modeMessage ; send closePump
	}
	transition t25 {
		from NORMAL
		to NORMAL
		trigger transmissionReceived
		condition not ( consecutiveStopCount >= stopLimit ) /\ not ( transmissionFailed \/ predictedLevelLow <= m1 \/ predictedLevelHigh >= m2 ) /\ not ( levelDeviceFailed ) /\ not ( steamFailureDetected \/ pumpFailureDetected \/ pumpControlFailureDetected ) /\ not ( pumpsRunning < pumpsWanted /\ pumpStartable ) /\ not ( pumpsRunning > pumpsWanted /\ pumpStoppable )
	}
	transition t26 {
		from DEGRADED
		to EMERGENCY_STOP
		trigger transmissionReceived
		condition consecutiveStopCount >= stopLimit
	}
	transition t27 {
		from DEGRADED
		to EMERGENCY_STOP
		trigger transmissionReceived
		condition not ( consecutiveStopCount >= stopLimit ) /\ (transmissionFailed \/ predictedLevelLow <= m1 \/ predictedLevelHigh >= m2)
	}
	transition t28 {
		from DEGRADED
		to EMERGENCY_STOP
		trigger transmissionReceived
		condition not ( consecutiveStopCount >= stopLimit ) /\ not ( transmissionFailed \/ predictedLevelLow <= m1 \/ predictedLevelHigh >= m2 ) /\ levelDeviceFailed /\ (steamDeviceOutOfOrder \/ anyPumpControllerOutOfOrder)
	}
	transition t29 {
		from DEGRADED
		to RESCUE
		trigger transmissionReceived
		condition not ( consecutiveStopCount >= stopLimit ) /\ not ( transmissionFailed \/ predictedLevelLow <= m1 \/ predictedLevelHigh >= m2 ) /\ levelDeviceFailed /\ not ( steamDeviceOutOfOrder \/ anyPumpControllerOutOfOrder )
	}
	transition t30 {
		from DEGRADED
		to NORMAL
		trigger transmissionReceived
		condition not ( consecutiveStopCount >= stopLimit ) /\ not ( transmissionFailed \/ predictedLevelLow <= m1 \/ predictedLevelHigh >= m2 ) /\ not ( levelDeviceFailed ) /\ everyUnitSound
	}
	transition t31 {
		from DEGRADED
		to DEGRADED
		trigger transmissionReceived
		condition not ( consecutiveStopCount >= stopLimit ) /\ not ( transmissionFailed \/ predictedLevelLow <= m1 \/ predictedLevelHigh >= m2 ) /\ not ( levelDeviceFailed ) /\ not ( everyUnitSound ) /\ pumpsRunning < pumpsWanted /\ pumpStartable
		action send modeMessage ; send openPump
	}
	transition t32 {
		from DEGRADED
		to DEGRADED
		trigger transmissionReceived
		condition not ( consecutiveStopCount >= stopLimit ) /\ not ( transmissionFailed \/ predictedLevelLow <= m1 \/ predictedLevelHigh >= m2 ) /\ not ( levelDeviceFailed ) /\ not ( everyUnitSound ) /\ pumpsRunning > pumpsWanted /\ pumpStoppable
		action send modeMessage ; send closePump
	}
	transition t33 {
		from DEGRADED
		to DEGRADED
		trigger transmissionReceived
		condition not ( consecutiveStopCount >= stopLimit ) /\ not ( transmissionFailed \/ predictedLevelLow <= m1 \/ predictedLevelHigh >= m2 ) /\ not ( levelDeviceFailed ) /\ not ( everyUnitSound ) /\ not ( pumpsRunning < pumpsWanted /\ pumpStartable ) /\ not ( pumpsRunning > pumpsWanted /\ pumpStoppable )
	}
	transition t34 {
		from RESCUE
		to EMERGENCY_STOP
		trigger transmissionReceived
		condition consecutiveStopCount >= stopLimit
	}
	transition t35 {
		from RESCUE
		to EMERGENCY_STOP
		trigger transmissionReceived
		condition not ( consecutiveStopCount >= stopLimit ) /\ (transmissionFailed \/ predictedLevelLow <= m1 \/ predictedLevelHigh >= m2)
	}
	transition t36 {
		from RESCUE
		to EMERGENCY_STOP
		trigger transmissionReceived
		condition not ( consecutiveStopCount >= stopLimit ) /\ not ( transmissionFailed \/ predictedLevelLow <= m1 \/ predictedLevelHigh >= m2 ) /\ (steamDeviceOutOfOrder \/ anyPumpControllerOutOfOrder)
	}
	transition t37 {
		from RESCUE
		to NORMAL
		trigger transmissionReceived
		condition not ( consecutiveStopCount >= stopLimit ) /\ not ( transmissionFailed \/ predictedLevelLow <= m1 \/ predictedLevelHigh >= m2 ) /\ not ( steamDeviceOutOfOrder \/ anyPumpControllerOutOfOrder ) /\ levelRepairReported /\ not ( levelDeviceFailed ) /\ everyUnitSound
	}
	transition t38 {
		from RESCUE
		to DEGRADED
		trigger transmissionReceived
		condition not ( consecutiveStopCount >= stopLimit ) /\ not ( transmissionFailed \/ predictedLevelLow <= m1 \/ predictedLevelHigh >= m2 ) /\ not ( steamDeviceOutOfOrder \/ anyPumpControllerOutOfOrder ) /\ levelRepairReported /\ not ( levelDeviceFailed ) /\ not ( everyUnitSound )
	}
	transition t39 {
		from RESCUE
		to RESCUE
		trigger transmissionReceived
		condition not ( consecutiveStopCount >= stopLimit ) /\ not ( transmissionFailed \/ predictedLevelLow <= m1 \/ predictedLevelHigh >= m2 ) /\ not ( steamDeviceOutOfOrder \/ anyPumpControllerOutOfOrder ) /\ not ( levelRepairReported /\ not ( levelDeviceFailed ) ) /\ pumpsRunning < pumpsWanted /\ pumpStartable
		action send modeMessage ; send openPump
	}
	transition t40 {
		from RESCUE
		to RESCUE
		trigger transmissionReceived
		condition not ( consecutiveStopCount >= stopLimit ) /\ not ( transmissionFailed \/ predictedLevelLow <= m1 \/ predictedLevelHigh >= m2 ) /\ not ( steamDeviceOutOfOrder \/ anyPumpControllerOutOfOrder ) /\ not ( levelRepairReported /\ not ( levelDeviceFailed ) ) /\ pumpsRunning > pumpsWanted /\ pumpStoppable
		action send modeMessage ; send closePump
	}
	transition t41 {
		from RESCUE
		to RESCUE
		trigger transmissionReceived
		condition not ( consecutiveStopCount >= stopLimit ) /\ not ( transmissionFailed \/ predictedLevelLow <= m1 \/ predictedLevelHigh >= m2 ) /\ not ( steamDeviceOutOfOrder \/ anyPumpControllerOutOfOrder ) /\ not ( levelRepairReported /\ not ( levelDeviceFailed ) ) /\ not ( pumpsRunning < pumpsWanted /\ pumpStartable ) /\ not ( pumpsRunning > pumpsWanted /\ pumpStoppable )
	}
}

controller SteamBoilerController_Ctrl {
	uses Inputs uses Outputs requires SteamBoilerController_State requires Constants requires Sensors
	sref stm_ref0 = SteamBoilerController
	connection SteamBoilerController_Ctrl on transmissionReceived to stm_ref0 on transmissionReceived
	connection stm_ref0 on modeMessage to SteamBoilerController_Ctrl on modeMessage
	connection stm_ref0 on programReady to SteamBoilerController_Ctrl on programReady
	connection stm_ref0 on closePump to SteamBoilerController_Ctrl on closePump
	connection stm_ref0 on valveCommand to SteamBoilerController_Ctrl on valveCommand
	connection stm_ref0 on openPump to SteamBoilerController_Ctrl on openPump
}

module SteamBoilerController_Module {
	robotic platform SteamBoilerController_Platform {
		provides Sensors provides Actuators provides Constants
		event transmissionReceived
		event modeMessage
		event programReady
		event closePump
		event valveCommand
		event openPump
	}
	cref ctrl_ref0 = SteamBoilerController_Ctrl
	connection SteamBoilerController_Platform on transmissionReceived to ctrl_ref0 on transmissionReceived
	connection ctrl_ref0 on modeMessage to SteamBoilerController_Platform on modeMessage
	connection ctrl_ref0 on programReady to SteamBoilerController_Platform on programReady
	connection ctrl_ref0 on closePump to SteamBoilerController_Platform on closePump
	connection ctrl_ref0 on valveCommand to SteamBoilerController_Platform on valveCommand
	connection ctrl_ref0 on openPump to SteamBoilerController_Platform on openPump
}

