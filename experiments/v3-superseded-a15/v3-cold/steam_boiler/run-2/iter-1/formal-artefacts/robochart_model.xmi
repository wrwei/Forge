            <exp xsi:type="robochart:Or">
              <left xsi:type="robochart:Or">
                <left xsi:type="robochart:Or">
                  <left xsi:type="robochart:GreaterOrEqual">
                    <left xsi:type="robochart:CallExp">
                      <function xsi:type="robochart:StringExp" value="consecutiveStops"/>
                    </left>
                    <right xsi:type="robochart:CallExp">
                      <function xsi:type="robochart:StringExp" value="stopLimit"/>
                    </right>
                  </left>
                  <right xsi:type="robochart:Or">
                    <left xsi:type="robochart:Or">
                      <left xsi:type="robochart:CallExp">
                        <function xsi:type="robochart:StringExp" value="linkFailed"/>
                      </left>
                      <right xsi:type="robochart:CallExp">
                        <function xsi:type="robochart:StringExp" value="waitingMessageSeen"/>
                      </right>
                    </left>
                    <right xsi:type="robochart:CallExp">
                      <function xsi:type="robochart:StringExp" value="unitsReadyMessageSeen"/>
                    </right>
                  </right>
                </left>
                <right xsi:type="robochart:Or">
                  <left xsi:type="robochart:LessOrEqual">
                    <left xsi:type="robochart:CallExp">
                      <function xsi:type="robochart:StringExp" value="predictedLevelMin"/>
                    </left>
                    <right xsi:type="robochart:CallExp">
                      <function xsi:type="robochart:StringExp" value="limitM1"/>
                    </right>
                  </left>
                  <right xsi:type="robochart:GreaterOrEqual">
                    <left xsi:type="robochart:CallExp">
                      <function xsi:type="robochart:StringExp" value="predictedLevelMax"/>
                    </left>
                    <right xsi:type="robochart:CallExp">
                      <function xsi:type="robochart:StringExp" value="limitM2"/>
                    </right>
                  </right>
                </right>
              </left>
              <right xsi:type="robochart:Or">
                <left xsi:type="robochart:CallExp">
                  <function xsi:type="robochart:StringExp" value="steamUnitDefective"/>
                </left>
                <right xsi:type="robochart:CallExp">
                  <function xsi:type="robochart:StringExp" value="pumpControlDefective"/>
                </right>
              </right>
            </exp>
          </left>
          <right xsi:type="robochart:CallExp">
            <function xsi:type="robochart:StringExp" value="levelUnitDefective"/>
          </right>
        </left>
        <right xsi:type="robochart:And">
          <left xsi:type="robochart:Not">
            <exp xsi:type="robochart:GreaterThan">
              <left xsi:type="robochart:CallExp">
                <function xsi:type="robochart:StringExp" value="levelEstimate"/>
              </left>
              <right xsi:type="robochart:CallExp">
                <function xsi:type="robochart:StringExp" value="normalN2"/>
              </right>
            </exp>
          </left>
          <right xsi:type="robochart:Not">
            <exp xsi:type="robochart:And">
              <left xsi:type="robochart:LessThan">
                <left xsi:type="robochart:CallExp">
                  <function xsi:type="robochart:StringExp" value="levelEstimate"/>
                </left>
                <right xsi:type="robochart:CallExp">
                  <function xsi:type="robochart:StringExp" value="normalN1"/>
                </right>
              </left>
              <right xsi:type="robochart:Not">
                <exp xsi:type="robochart:GreaterThan">
                  <left xsi:type="robochart:CallExp">
                    <function xsi:type="robochart:StringExp" value="levelEstimate"/>
                  </left>
                  <right xsi:type="robochart:CallExp">
                    <function xsi:type="robochart:StringExp" value="normalN2"/>
                  </right>
                </exp>
              </right>
            </exp>
          </right>
        </right>
      </condition>
      <action xsi:type="robochart:CommunicationStmt">
        <communication event="//@machines.0/@events.1"/>
      </action>
    </transitions>
  </machines>
</robochart:RCPackage>
