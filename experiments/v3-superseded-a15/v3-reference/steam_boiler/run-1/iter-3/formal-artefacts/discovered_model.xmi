          </assignment>
        </statement>
        <statement xsi:type="spoon:CtLocalVariable" name="transmissionLost">
          <type name="boolean"/>
          <assignment xsi:type="spoon:CtInvocation">
            <type name="boolean"/>
            <target xsi:type="spoon:CtFieldRead">
              <type name="BoilerSensor">
