diagram SteamBoilerController

enumeration ValvePosition { VALVE_CLOSED VALVE_OPEN }
enumeration FlowObservation { NO_WATER_FLOW WATER_FLOWING }
enumeration ModeValue { INITIALIZATION_MODE NORMAL_MODE DEGRADED_MODE RESCUE_MODE EMERGENCY_STOP_MODE }

datatype PumpControlStateData {
	pump : int
	flow : FlowObservation
}

datatype PumpStateData {
	pump : int
	switchedOn : boolean
}

interface Inputs {
	event transmissionReceived
}

interface Outputs {
	event modeMessage
	event closeValve
	event regulatePumps
	event programReady
	event openValve
	event stopPumps
	event runFillingPump
}

interface Sensors {
	var pump : int
	var switchedOn : boolean
	var operatorStopRequested : boolean
	var plantWaiting : boolean
	var transmissionLost : boolean
	var steamRate : real
	var levelUnitFailed : boolean
	var unitsReady : boolean
	var nonLevelUnitFailed : boolean
	var readyAnnounced : boolean
	var waterLevel : real
	var startMessageArrived : boolean
	var levelNearLimit : boolean
	var steamUnitFailed : boolean
	var pumpControlUnitFailed : boolean
}

interface Actuators {
}

interface SteamBoilerController_State {
}

interface Constants {
	const normalN2 : real = 600
	const normalN1 : real = 400
}

stm SteamBoilerController {
	uses Inputs uses Outputs requires SteamBoilerController_State requires Constants requires Sensors
	state EMERGENCY_STOP {
		entry send modeMessage
	}
	state RESCUE {
		entry send modeMessage ; send regulatePumps
	}
	state DEGRADED {
	}
	state NORMAL {
	}
	state INITIALIZATION {
	}
	initial i0
	transition t_init {
		from i0
		to INITIALIZATION
	}
	transition t1 {
		from INITIALIZATION
		to EMERGENCY_STOP
		trigger transmissionReceived
		condition operatorStopRequested
	}
	transition t2 {
		from INITIALIZATION
		to INITIALIZATION
		trigger transmissionReceived
		condition not ( operatorStopRequested ) /\ not ( plantWaiting )
		action send modeMessage
	}
	transition t3 {
		from INITIALIZATION
		to EMERGENCY_STOP
		trigger transmissionReceived
		condition not ( operatorStopRequested ) /\ plantWaiting /\ transmissionLost
	}
	transition t4 {
		from INITIALIZATION
		to EMERGENCY_STOP
		trigger transmissionReceived
		condition not ( operatorStopRequested ) /\ plantWaiting /\ not ( transmissionLost ) /\ steamRate != 0
	}
	transition t5 {
		from INITIALIZATION
		to EMERGENCY_STOP
		trigger transmissionReceived
		condition not ( operatorStopRequested ) /\ plantWaiting /\ not ( transmissionLost ) /\ not ( steamRate != 0 ) /\ levelUnitFailed
	}
	transition t6 {
		from INITIALIZATION
		to NORMAL
		trigger transmissionReceived
		condition not ( operatorStopRequested ) /\ plantWaiting /\ not ( transmissionLost ) /\ not ( steamRate != 0 ) /\ not ( levelUnitFailed ) /\ unitsReady /\ not ( nonLevelUnitFailed )
		action send modeMessage ; send closeValve ; send regulatePumps
	}
	transition t7 {
		from INITIALIZATION
		to DEGRADED
		trigger transmissionReceived
		condition not ( operatorStopRequested ) /\ plantWaiting /\ not ( transmissionLost ) /\ not ( steamRate != 0 ) /\ not ( levelUnitFailed ) /\ unitsReady /\ nonLevelUnitFailed
		action send modeMessage ; send closeValve ; send regulatePumps
	}
	transition t8 {
		from INITIALIZATION
		to INITIALIZATION
		trigger transmissionReceived
		condition not ( operatorStopRequested ) /\ plantWaiting /\ not ( transmissionLost ) /\ not ( steamRate != 0 ) /\ not ( levelUnitFailed ) /\ not ( unitsReady ) /\ readyAnnounced
		action send modeMessage ; send programReady
	}
	transition t9 {
		from INITIALIZATION
		to INITIALIZATION
		trigger transmissionReceived
		condition not ( operatorStopRequested ) /\ plantWaiting /\ not ( transmissionLost ) /\ not ( steamRate != 0 ) /\ not ( levelUnitFailed ) /\ not ( unitsReady ) /\ not ( readyAnnounced ) /\ waterLevel > normalN2
		action send modeMessage ; send openValve ; send stopPumps
	}
	transition t10 {
		from INITIALIZATION
		to INITIALIZATION
		trigger transmissionReceived
		condition not ( operatorStopRequested ) /\ plantWaiting /\ not ( transmissionLost ) /\ not ( steamRate != 0 ) /\ not ( levelUnitFailed ) /\ not ( unitsReady ) /\ not ( readyAnnounced ) /\ not ( waterLevel > normalN2 ) /\ waterLevel < normalN1
		action send modeMessage ; send closeValve ; send runFillingPump
	}
	transition t11 {
		from INITIALIZATION
		to INITIALIZATION
		trigger transmissionReceived
		condition not ( operatorStopRequested ) /\ plantWaiting /\ not ( transmissionLost ) /\ not ( steamRate != 0 ) /\ not ( levelUnitFailed ) /\ not ( unitsReady ) /\ not ( readyAnnounced ) /\ not ( waterLevel > normalN2 ) /\ not ( waterLevel < normalN1 )
		action send modeMessage ; send closeValve ; send stopPumps ; send programReady
	}
	transition t12 {
		from NORMAL
		to EMERGENCY_STOP
		trigger transmissionReceived
		condition operatorStopRequested
	}
	transition t13 {
		from NORMAL
		to EMERGENCY_STOP
		trigger transmissionReceived
		condition not ( operatorStopRequested ) /\ transmissionLost
	}
	transition t14 {
		from NORMAL
		to EMERGENCY_STOP
		trigger transmissionReceived
		condition not ( operatorStopRequested ) /\ not ( transmissionLost ) /\ startMessageArrived
	}
	transition t15 {
		from NORMAL
		to EMERGENCY_STOP
		trigger transmissionReceived
		condition not ( operatorStopRequested ) /\ not ( transmissionLost ) /\ not ( startMessageArrived ) /\ levelNearLimit
	}
	transition t16 {
		from NORMAL
		to RESCUE
		trigger transmissionReceived
		condition not ( operatorStopRequested ) /\ not ( transmissionLost ) /\ not ( startMessageArrived ) /\ not ( levelNearLimit ) /\ levelUnitFailed
	}
	transition t17 {
		from NORMAL
		to DEGRADED
		trigger transmissionReceived
		condition not ( operatorStopRequested ) /\ not ( transmissionLost ) /\ not ( startMessageArrived ) /\ not ( levelNearLimit ) /\ not ( levelUnitFailed ) /\ nonLevelUnitFailed
		action send modeMessage ; send regulatePumps
	}
	transition t18 {
		from NORMAL
		to NORMAL
		trigger transmissionReceived
		condition not ( operatorStopRequested ) /\ not ( transmissionLost ) /\ not ( startMessageArrived ) /\ not ( levelNearLimit ) /\ not ( levelUnitFailed ) /\ not ( nonLevelUnitFailed )
		action send modeMessage ; send regulatePumps
	}
	transition t19 {
		from DEGRADED
		to EMERGENCY_STOP
		trigger transmissionReceived
		condition operatorStopRequested
	}
	transition t20 {
		from DEGRADED
		to EMERGENCY_STOP
		trigger transmissionReceived
		condition not ( operatorStopRequested ) /\ transmissionLost
	}
	transition t21 {
		from DEGRADED
		to EMERGENCY_STOP
		trigger transmissionReceived
		condition not ( operatorStopRequested ) /\ not ( transmissionLost ) /\ startMessageArrived
	}
	transition t22 {
		from DEGRADED
		to EMERGENCY_STOP
		trigger transmissionReceived
		condition not ( operatorStopRequested ) /\ not ( transmissionLost ) /\ not ( startMessageArrived ) /\ levelNearLimit
	}
	transition t23 {
		from DEGRADED
		to RESCUE
		trigger transmissionReceived
		condition not ( operatorStopRequested ) /\ not ( transmissionLost ) /\ not ( startMessageArrived ) /\ not ( levelNearLimit ) /\ levelUnitFailed
	}
	transition t24 {
		from DEGRADED
		to NORMAL
		trigger transmissionReceived
		condition not ( operatorStopRequested ) /\ not ( transmissionLost ) /\ not ( startMessageArrived ) /\ not ( levelNearLimit ) /\ not ( levelUnitFailed ) /\ not ( nonLevelUnitFailed )
		action send modeMessage ; send regulatePumps
	}
	transition t25 {
		from DEGRADED
		to DEGRADED
		trigger transmissionReceived
		condition not ( operatorStopRequested ) /\ not ( transmissionLost ) /\ not ( startMessageArrived ) /\ not ( levelNearLimit ) /\ not ( levelUnitFailed ) /\ nonLevelUnitFailed
		action send modeMessage ; send regulatePumps
	}
	transition t26 {
		from RESCUE
		to EMERGENCY_STOP
		trigger transmissionReceived
		condition operatorStopRequested
	}
	transition t27 {
		from RESCUE
		to EMERGENCY_STOP
		trigger transmissionReceived
		condition not ( operatorStopRequested ) /\ transmissionLost
	}
	transition t28 {
		from RESCUE
		to EMERGENCY_STOP
		trigger transmissionReceived
		condition not ( operatorStopRequested ) /\ not ( transmissionLost ) /\ startMessageArrived
	}
	transition t29 {
		from RESCUE
		to EMERGENCY_STOP
		trigger transmissionReceived
		condition not ( operatorStopRequested ) /\ not ( transmissionLost ) /\ not ( startMessageArrived ) /\ levelNearLimit
	}
	transition t30 {
		from RESCUE
		to EMERGENCY_STOP
		trigger transmissionReceived
		condition not ( operatorStopRequested ) /\ not ( transmissionLost ) /\ not ( startMessageArrived ) /\ not ( levelNearLimit ) /\ steamUnitFailed
	}
	transition t31 {
		from RESCUE
		to EMERGENCY_STOP
		trigger transmissionReceived
		condition not ( operatorStopRequested ) /\ not ( transmissionLost ) /\ not ( startMessageArrived ) /\ not ( levelNearLimit ) /\ not ( steamUnitFailed ) /\ pumpControlUnitFailed
	}
	transition t32 {
		from RESCUE
		to RESCUE
		trigger transmissionReceived
		condition not ( operatorStopRequested ) /\ not ( transmissionLost ) /\ not ( startMessageArrived ) /\ not ( levelNearLimit ) /\ not ( steamUnitFailed ) /\ not ( pumpControlUnitFailed ) /\ levelUnitFailed
	}
	transition t33 {
		from RESCUE
		to NORMAL
		trigger transmissionReceived
		condition not ( operatorStopRequested ) /\ not ( transmissionLost ) /\ not ( startMessageArrived ) /\ not ( levelNearLimit ) /\ not ( steamUnitFailed ) /\ not ( pumpControlUnitFailed ) /\ not ( levelUnitFailed ) /\ not ( nonLevelUnitFailed )
		action send modeMessage ; send regulatePumps
	}
	transition t34 {
		from RESCUE
		to DEGRADED
		trigger transmissionReceived
		condition not ( operatorStopRequested ) /\ not ( transmissionLost ) /\ not ( startMessageArrived ) /\ not ( levelNearLimit ) /\ not ( steamUnitFailed ) /\ not ( pumpControlUnitFailed ) /\ not ( levelUnitFailed ) /\ nonLevelUnitFailed
		action send modeMessage ; send regulatePumps
	}
}

controller SteamBoilerController_Ctrl {
	uses Inputs uses Outputs requires SteamBoilerController_State requires Constants requires Sensors
	sref stm_ref0 = SteamBoilerController
	connection SteamBoilerController_Ctrl on transmissionReceived to stm_ref0 on transmissionReceived
	connection stm_ref0 on modeMessage to SteamBoilerController_Ctrl on modeMessage
	connection stm_ref0 on closeValve to SteamBoilerController_Ctrl on closeValve
	connection stm_ref0 on regulatePumps to SteamBoilerController_Ctrl on regulatePumps
	connection stm_ref0 on programReady to SteamBoilerController_Ctrl on programReady
	connection stm_ref0 on openValve to SteamBoilerController_Ctrl on openValve
	connection stm_ref0 on stopPumps to SteamBoilerController_Ctrl on stopPumps
	connection stm_ref0 on runFillingPump to SteamBoilerController_Ctrl on runFillingPump
}

module SteamBoilerController_Module {
	robotic platform SteamBoilerController_Platform {
		provides Sensors provides Actuators provides Constants
		event transmissionReceived
		event modeMessage
		event closeValve
		event regulatePumps
		event programReady
		event openValve
		event stopPumps
		event runFillingPump
	}
	cref ctrl_ref0 = SteamBoilerController_Ctrl
	connection SteamBoilerController_Platform on transmissionReceived to ctrl_ref0 on transmissionReceived
	connection ctrl_ref0 on modeMessage to SteamBoilerController_Platform on modeMessage
	connection ctrl_ref0 on closeValve to SteamBoilerController_Platform on closeValve
	connection ctrl_ref0 on regulatePumps to SteamBoilerController_Platform on regulatePumps
	connection ctrl_ref0 on programReady to SteamBoilerController_Platform on programReady
	connection ctrl_ref0 on openValve to SteamBoilerController_Platform on openValve
	connection ctrl_ref0 on stopPumps to SteamBoilerController_Platform on stopPumps
	connection ctrl_ref0 on runFillingPump to SteamBoilerController_Platform on runFillingPump
}

