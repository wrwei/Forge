diagram SteamBoilerController

enumeration ValvePosition { VALVE_CLOSED VALVE_OPEN }
enumeration FlowObservation { NO_WATER_FLOW WATER_FLOWING }
enumeration ModeValue { INITIALIZATION_MODE NORMAL_MODE DEGRADED_MODE RESCUE_MODE EMERGENCY_STOP_MODE }

datatype PumpControlStateData {
	pump : int
	flow : FlowObservation
}

datatype PumpStateData {
	pump : int
	switchedOn : boolean
}

interface Inputs {
	event transmissionReceived
}

interface Outputs {
	event modeMessage
	event closeValve
	event regulatePumps
	event openValve
	event stopPumps
	event runFillingPump
	event programReady
}

interface Sensors {
	var pump : int
	var switchedOn : boolean
	var startupEmergency : boolean
	var unitsConfirmedReady : boolean
	var nonLevelUnitFailed : boolean
	var plantWaiting : boolean
	var excessWater : boolean
	var lowWater : boolean
	var operatingEmergency : boolean
	var levelUnitFailed : boolean
	var levelEstimateUnreliable : boolean
}

interface Actuators {
}

interface SteamBoilerController_State {
}

interface Constants {
}

stm SteamBoilerController {
	uses Inputs uses Outputs requires SteamBoilerController_State requires Constants requires Sensors
	state EMERGENCY_STOP {
		entry send modeMessage
	}
	state RESCUE {
		entry send modeMessage ; send regulatePumps
	}
	state DEGRADED {
	}
	state NORMAL {
	}
	state INITIALIZATION {
	}
	initial i0
	transition t_init {
		from i0
		to INITIALIZATION
	}
	transition t1 {
		from INITIALIZATION
		to EMERGENCY_STOP
		trigger transmissionReceived
		condition startupEmergency
	}
	transition t2 {
		from INITIALIZATION
		to NORMAL
		trigger transmissionReceived
		condition not ( startupEmergency ) /\ unitsConfirmedReady /\ not ( nonLevelUnitFailed )
		action send modeMessage ; send closeValve ; send regulatePumps
	}
	transition t3 {
		from INITIALIZATION
		to DEGRADED
		trigger transmissionReceived
		condition not ( startupEmergency ) /\ unitsConfirmedReady /\ nonLevelUnitFailed
		action send modeMessage ; send closeValve ; send regulatePumps
	}
	transition t4 {
		from INITIALIZATION
		to INITIALIZATION
		trigger transmissionReceived
		condition not ( startupEmergency ) /\ not ( unitsConfirmedReady ) /\ not ( plantWaiting )
		action send modeMessage
	}
	transition t5 {
		from INITIALIZATION
		to INITIALIZATION
		trigger transmissionReceived
		condition not ( startupEmergency ) /\ not ( unitsConfirmedReady ) /\ plantWaiting /\ excessWater
		action send modeMessage ; send openValve ; send stopPumps
	}
	transition t6 {
		from INITIALIZATION
		to INITIALIZATION
		trigger transmissionReceived
		condition not ( startupEmergency ) /\ not ( unitsConfirmedReady ) /\ plantWaiting /\ not ( excessWater ) /\ lowWater
		action send modeMessage ; send closeValve ; send runFillingPump
	}
	transition t7 {
		from INITIALIZATION
		to INITIALIZATION
		trigger transmissionReceived
		condition not ( startupEmergency ) /\ not ( unitsConfirmedReady ) /\ plantWaiting /\ not ( excessWater ) /\ not ( lowWater )
		action send modeMessage ; send closeValve ; send stopPumps ; send programReady
	}
	transition t8 {
		from NORMAL
		to EMERGENCY_STOP
		trigger transmissionReceived
		condition operatingEmergency
	}
	transition t9 {
		from NORMAL
		to RESCUE
		trigger transmissionReceived
		condition not ( operatingEmergency ) /\ levelUnitFailed
	}
	transition t10 {
		from NORMAL
		to DEGRADED
		trigger transmissionReceived
		condition not ( operatingEmergency ) /\ not ( levelUnitFailed ) /\ nonLevelUnitFailed
		action send modeMessage ; send regulatePumps
	}
	transition t11 {
		from NORMAL
		to NORMAL
		trigger transmissionReceived
		condition not ( operatingEmergency ) /\ not ( levelUnitFailed ) /\ not ( nonLevelUnitFailed )
		action send modeMessage ; send regulatePumps
	}
	transition t12 {
		from DEGRADED
		to EMERGENCY_STOP
		trigger transmissionReceived
		condition operatingEmergency
	}
	transition t13 {
		from DEGRADED
		to RESCUE
		trigger transmissionReceived
		condition not ( operatingEmergency ) /\ levelUnitFailed
	}
	transition t14 {
		from DEGRADED
		to NORMAL
		trigger transmissionReceived
		condition not ( operatingEmergency ) /\ not ( levelUnitFailed ) /\ not ( nonLevelUnitFailed )
		action send modeMessage ; send regulatePumps
	}
	transition t15 {
		from DEGRADED
		to DEGRADED
		trigger transmissionReceived
		condition not ( operatingEmergency ) /\ not ( levelUnitFailed ) /\ nonLevelUnitFailed
		action send modeMessage ; send regulatePumps
	}
	transition t16 {
		from RESCUE
		to EMERGENCY_STOP
		trigger transmissionReceived
		condition operatingEmergency
	}
	transition t17 {
		from RESCUE
		to EMERGENCY_STOP
		trigger transmissionReceived
		condition not ( operatingEmergency ) /\ levelEstimateUnreliable
	}
	transition t18 {
		from RESCUE
		to RESCUE
		trigger transmissionReceived
		condition not ( operatingEmergency ) /\ not ( levelEstimateUnreliable ) /\ levelUnitFailed
	}
	transition t19 {
		from RESCUE
		to NORMAL
		trigger transmissionReceived
		condition not ( operatingEmergency ) /\ not ( levelEstimateUnreliable ) /\ not ( levelUnitFailed ) /\ not ( nonLevelUnitFailed )
		action send modeMessage ; send regulatePumps
	}
	transition t20 {
		from RESCUE
		to DEGRADED
		trigger transmissionReceived
		condition not ( operatingEmergency ) /\ not ( levelEstimateUnreliable ) /\ not ( levelUnitFailed ) /\ nonLevelUnitFailed
		action send modeMessage ; send regulatePumps
	}
}

controller SteamBoilerController_Ctrl {
	uses Inputs uses Outputs requires SteamBoilerController_State requires Constants requires Sensors
	sref stm_ref0 = SteamBoilerController
	connection SteamBoilerController_Ctrl on transmissionReceived to stm_ref0 on transmissionReceived
	connection stm_ref0 on modeMessage to SteamBoilerController_Ctrl on modeMessage
	connection stm_ref0 on closeValve to SteamBoilerController_Ctrl on closeValve
	connection stm_ref0 on regulatePumps to SteamBoilerController_Ctrl on regulatePumps
	connection stm_ref0 on openValve to SteamBoilerController_Ctrl on openValve
	connection stm_ref0 on stopPumps to SteamBoilerController_Ctrl on stopPumps
	connection stm_ref0 on runFillingPump to SteamBoilerController_Ctrl on runFillingPump
	connection stm_ref0 on programReady to SteamBoilerController_Ctrl on programReady
}

module SteamBoilerController_Module {
	robotic platform SteamBoilerController_Platform {
		provides Sensors provides Actuators provides Constants
		event transmissionReceived
		event modeMessage
		event closeValve
		event regulatePumps
		event openValve
		event stopPumps
		event runFillingPump
		event programReady
	}
	cref ctrl_ref0 = SteamBoilerController_Ctrl
	connection SteamBoilerController_Platform on transmissionReceived to ctrl_ref0 on transmissionReceived
	connection ctrl_ref0 on modeMessage to SteamBoilerController_Platform on modeMessage
	connection ctrl_ref0 on closeValve to SteamBoilerController_Platform on closeValve
	connection ctrl_ref0 on regulatePumps to SteamBoilerController_Platform on regulatePumps
	connection ctrl_ref0 on openValve to SteamBoilerController_Platform on openValve
	connection ctrl_ref0 on stopPumps to SteamBoilerController_Platform on stopPumps
	connection ctrl_ref0 on runFillingPump to SteamBoilerController_Platform on runFillingPump
	connection ctrl_ref0 on programReady to SteamBoilerController_Platform on programReady
}

