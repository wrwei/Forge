module SteamBoilerController
exports
	transparent diamond
	transparent sbisim
	transparent dbisim
	transparent chase

	-- Transition identifiers
	-- declaring identifiers of transitions
	datatype NIDS = 
	              NID_EMERGENCY_STOP|
	              NID_RESCUE|
	              NID_DEGRADED|
	              NID_NORMAL|
	              NID_INITIALIZATION|
	              NID_i0
	
	channel internal__ : NIDS
	
	-- Flow channels		
	channel interrupt
	channel exited
	channel exit
	channel terminate
	
	-- Variable channels
	channel get_plantWaiting, set_plantWaiting, setL_plantWaiting, setR_plantWaiting: core_boolean
	channel get_valveOpen, set_valveOpen, setL_valveOpen, setR_valveOpen: core_boolean
