diagram SteamBoilerController

enumeration OperatingMode { INITIALIZATION NORMAL DEGRADED RESCUE EMERGENCY_STOP }
enumeration PumpId { PUMP1 PUMP2 PUMP3 PUMP4 }

interface Inputs {
	event messagesReceived
}

interface Outputs {
	event modeMessage
	event programReady
	event valve
	event openPump
	event closePump
}

interface Sensors {
	var ESTIMATION_SLICES : int
	var stopInbox : boolean
	var waitingInbox : boolean
	var readyInbox : boolean
	var levelInboxCount : int
	var steamInboxCount : int
	var levelRepairedInbox : boolean
	var steamRepairedInbox : boolean
	var levelAckInbox : boolean
	var steamAckInbox : boolean
	var reportedLevel : real
	var reportedSteam : real
	var referenceSteam : real
	var steamReferenceValid : boolean
	var levelReferenceValid : boolean
	var levelRepairAckDue : boolean
	var steamRepairAckDue : boolean
	var throughput : real
	var lowerLevel : real
	var upperLevel : real
	var estimatedLevel : real
	var lowestReachable : real
	var highestReachable : real
	var transmissionFault : boolean
	var stopRun : int
	var waitingArrived : boolean
	var readyArrived : boolean
	var monitoring : boolean
	var drainOpen : boolean
	var controllersHealthy : boolean
	var othersHealthy : boolean
	var successiveStops : int
	var transmissionFailed : boolean
	var unitsReady : boolean
	var waitingReceived : boolean
	var steamRate : real
	var levelDeviceSound : boolean
	var otherUnitsSound : boolean
	var waterLevel : real
	var lowestReachableLevel : real
	var highestReachableLevel : real
	var steamDeviceSound : boolean
	var pumpControllersSound : boolean
}

interface Actuators {
}

interface SteamBoilerController_State {
	var plantWaiting : boolean = false
	var valveOpen : boolean = false
	var programReadySent : boolean = false
}

interface Constants {
	const stopRepetitions : real = 3
	const normalN2 : real = 600
	const normalN1 : real = 400
	const limitM1 : real = 150
	const limitM2 : real = 800
}

stm SteamBoilerController {
	uses Inputs uses Outputs requires SteamBoilerController_State requires Constants requires Sensors
	state EMERGENCY_STOP {
		entry send modeMessage
	}
	state RESCUE {
		entry send modeMessage
	}
	state DEGRADED {
		entry send modeMessage
	}
	state NORMAL {
		entry send modeMessage
	}
	state INITIALIZATION {
	}
	initial i0
	transition t_init {
		from i0
		to INITIALIZATION
	}
	transition t1 {
		from INITIALIZATION
		to EMERGENCY_STOP
		trigger messagesReceived
		condition successiveStops >= stopRepetitions
	}
	transition t2 {
		from INITIALIZATION
		to EMERGENCY_STOP
		trigger messagesReceived
		condition transmissionFailed \/ unitsReady /\ not ( programReadySent )
	}
	transition t3 {
		from INITIALIZATION
		to EMERGENCY_STOP
		trigger messagesReceived
		condition (plantWaiting \/ waitingReceived) /\ steamRate != 0
	}
	transition t4 {
		from INITIALIZATION
		to EMERGENCY_STOP
		trigger messagesReceived
		condition (plantWaiting \/ waitingReceived) /\ not ( levelDeviceSound )
	}
	transition t5 {
		from INITIALIZATION
		to NORMAL
		trigger messagesReceived
		condition not ( successiveStops >= stopRepetitions \/ transmissionFailed \/ unitsReady /\ not ( programReadySent ) \/ (plantWaiting \/ waitingReceived) /\ steamRate != 0 \/ (plantWaiting \/ waitingReceived) /\ not ( levelDeviceSound ) ) /\ programReadySent /\ unitsReady /\ otherUnitsSound /\ not ( not ( levelDeviceSound ) )
	}
	transition t6 {
		from INITIALIZATION
		to DEGRADED
		trigger messagesReceived
		condition not ( successiveStops >= stopRepetitions \/ transmissionFailed \/ unitsReady /\ not ( programReadySent ) \/ (plantWaiting \/ waitingReceived) /\ steamRate != 0 \/ (plantWaiting \/ waitingReceived) /\ not ( levelDeviceSound ) ) /\ programReadySent /\ unitsReady /\ not ( otherUnitsSound /\ not ( not ( levelDeviceSound ) ) )
	}
	transition t7 {
		from INITIALIZATION
		to INITIALIZATION
		trigger messagesReceived
		condition not ( successiveStops >= stopRepetitions \/ transmissionFailed \/ unitsReady /\ not ( programReadySent ) \/ (plantWaiting \/ waitingReceived) /\ steamRate != 0 \/ (plantWaiting \/ waitingReceived) /\ not ( levelDeviceSound ) ) /\ programReadySent /\ not ( unitsReady )
		action send modeMessage ; send programReady
	}
	transition t8 {
		from INITIALIZATION
		to INITIALIZATION
		trigger messagesReceived
		condition not ( successiveStops >= stopRepetitions \/ transmissionFailed \/ unitsReady /\ not ( programReadySent ) \/ (plantWaiting \/ waitingReceived) /\ steamRate != 0 \/ (plantWaiting \/ waitingReceived) /\ not ( levelDeviceSound ) ) /\ not ( programReadySent ) /\ not ( plantWaiting \/ waitingReceived )
		action send modeMessage
	}
	transition t9 {
		from INITIALIZATION
		to INITIALIZATION
		trigger messagesReceived
		condition not ( successiveStops >= stopRepetitions \/ transmissionFailed \/ unitsReady /\ not ( programReadySent ) \/ (plantWaiting \/ waitingReceived) /\ steamRate != 0 \/ (plantWaiting \/ waitingReceived) /\ not ( levelDeviceSound ) ) /\ not ( programReadySent ) /\ (plantWaiting \/ waitingReceived) /\ waterLevel > normalN2 /\ not ( valveOpen )
		action plantWaiting = true ; valveOpen = true ; send modeMessage ; send valve
	}
	transition t10 {
		from INITIALIZATION
		to INITIALIZATION
		trigger messagesReceived
		condition not ( successiveStops >= stopRepetitions \/ transmissionFailed \/ unitsReady /\ not ( programReadySent ) \/ (plantWaiting \/ waitingReceived) /\ steamRate != 0 \/ (plantWaiting \/ waitingReceived) /\ not ( levelDeviceSound ) ) /\ not ( programReadySent ) /\ (plantWaiting \/ waitingReceived) /\ waterLevel > normalN2 /\ valveOpen
		action plantWaiting = true ; send modeMessage
	}
	transition t11 {
		from INITIALIZATION
		to INITIALIZATION
		trigger messagesReceived
		condition not ( successiveStops >= stopRepetitions \/ transmissionFailed \/ unitsReady /\ not ( programReadySent ) \/ (plantWaiting \/ waitingReceived) /\ steamRate != 0 \/ (plantWaiting \/ waitingReceived) /\ not ( levelDeviceSound ) ) /\ not ( programReadySent ) /\ (plantWaiting \/ waitingReceived) /\ waterLevel < normalN1 /\ valveOpen
		action plantWaiting = true ; valveOpen = false ; send modeMessage ; send valve ; send openPump ; send openPump ; send openPump ; send openPump
	}
	transition t12 {
		from INITIALIZATION
		to INITIALIZATION
		trigger messagesReceived
		condition not ( successiveStops >= stopRepetitions \/ transmissionFailed \/ unitsReady /\ not ( programReadySent ) \/ (plantWaiting \/ waitingReceived) /\ steamRate != 0 \/ (plantWaiting \/ waitingReceived) /\ not ( levelDeviceSound ) ) /\ not ( programReadySent ) /\ (plantWaiting \/ waitingReceived) /\ waterLevel < normalN1 /\ not ( valveOpen )
		action plantWaiting = true ; send modeMessage ; send openPump ; send openPump ; send openPump ; send openPump
	}
	transition t13 {
		from INITIALIZATION
		to INITIALIZATION
		trigger messagesReceived
		condition not ( successiveStops >= stopRepetitions \/ transmissionFailed \/ unitsReady /\ not ( programReadySent ) \/ (plantWaiting \/ waitingReceived) /\ steamRate != 0 \/ (plantWaiting \/ waitingReceived) /\ not ( levelDeviceSound ) ) /\ not ( programReadySent ) /\ (plantWaiting \/ waitingReceived) /\ not ( waterLevel < normalN1 ) /\ not ( waterLevel > normalN2 ) /\ valveOpen
		action plantWaiting = true ; valveOpen = false ; programReadySent = true ; send modeMessage ; send valve ; send closePump ; send closePump ; send closePump ; send closePump ; send programReady
	}
	transition t14 {
		from INITIALIZATION
		to INITIALIZATION
		trigger messagesReceived
		condition not ( successiveStops >= stopRepetitions \/ transmissionFailed \/ unitsReady /\ not ( programReadySent ) \/ (plantWaiting \/ waitingReceived) /\ steamRate != 0 \/ (plantWaiting \/ waitingReceived) /\ not ( levelDeviceSound ) ) /\ not ( programReadySent ) /\ (plantWaiting \/ waitingReceived) /\ not ( waterLevel < normalN1 ) /\ not ( waterLevel > normalN2 ) /\ not ( valveOpen )
		action plantWaiting = true ; programReadySent = true ; send modeMessage ; send closePump ; send closePump ; send closePump ; send closePump ; send programReady
	}
	transition t15 {
		from NORMAL
		to EMERGENCY_STOP
		trigger messagesReceived
		condition successiveStops >= stopRepetitions
	}
	transition t16 {
		from NORMAL
		to EMERGENCY_STOP
		trigger messagesReceived
		condition transmissionFailed \/ waitingReceived \/ unitsReady
	}
	transition t17 {
		from NORMAL
		to EMERGENCY_STOP
		trigger messagesReceived
		condition lowestReachableLevel < limitM1 \/ highestReachableLevel > limitM2
	}
	transition t18 {
		from NORMAL
		to RESCUE
		trigger messagesReceived
		condition not ( successiveStops >= stopRepetitions \/ transmissionFailed \/ waitingReceived \/ unitsReady \/ lowestReachableLevel < limitM1 \/ highestReachableLevel > limitM2 ) /\ not ( levelDeviceSound )
	}
	transition t19 {
		from NORMAL
		to DEGRADED
		trigger messagesReceived
		condition not ( successiveStops >= stopRepetitions \/ transmissionFailed \/ waitingReceived \/ unitsReady \/ lowestReachableLevel < limitM1 \/ highestReachableLevel > limitM2 ) /\ not ( not ( levelDeviceSound ) ) /\ not ( otherUnitsSound )
	}
	transition t20 {
		from NORMAL
		to NORMAL
		trigger messagesReceived
		condition not ( successiveStops >= stopRepetitions \/ transmissionFailed \/ waitingReceived \/ unitsReady \/ lowestReachableLevel < limitM1 \/ highestReachableLevel > limitM2 ) /\ otherUnitsSound /\ not ( not ( levelDeviceSound ) ) /\ waterLevel < normalN1
		action send modeMessage ; send openPump ; send openPump ; send openPump ; send openPump
	}
	transition t21 {
		from NORMAL
		to NORMAL
		trigger messagesReceived
		condition not ( successiveStops >= stopRepetitions \/ transmissionFailed \/ waitingReceived \/ unitsReady \/ lowestReachableLevel < limitM1 \/ highestReachableLevel > limitM2 ) /\ otherUnitsSound /\ not ( not ( levelDeviceSound ) ) /\ waterLevel > normalN2
		action send modeMessage ; send closePump ; send closePump ; send closePump ; send closePump
	}
	transition t22 {
		from NORMAL
		to NORMAL
		trigger messagesReceived
		condition not ( successiveStops >= stopRepetitions \/ transmissionFailed \/ waitingReceived \/ unitsReady \/ lowestReachableLevel < limitM1 \/ highestReachableLevel > limitM2 ) /\ otherUnitsSound /\ not ( not ( levelDeviceSound ) ) /\ not ( waterLevel < normalN1 ) /\ not ( waterLevel > normalN2 )
	}
	transition t23 {
		from DEGRADED
		to EMERGENCY_STOP
		trigger messagesReceived
		condition successiveStops >= stopRepetitions
	}
	transition t24 {
		from DEGRADED
		to EMERGENCY_STOP
		trigger messagesReceived
		condition transmissionFailed \/ waitingReceived \/ unitsReady
	}
	transition t25 {
		from DEGRADED
		to EMERGENCY_STOP
		trigger messagesReceived
		condition lowestReachableLevel < limitM1 \/ highestReachableLevel > limitM2
	}
	transition t26 {
		from DEGRADED
		to RESCUE
		trigger messagesReceived
		condition not ( successiveStops >= stopRepetitions \/ transmissionFailed \/ waitingReceived \/ unitsReady \/ lowestReachableLevel < limitM1 \/ highestReachableLevel > limitM2 ) /\ not ( levelDeviceSound )
	}
	transition t27 {
		from DEGRADED
		to NORMAL
		trigger messagesReceived
		condition not ( successiveStops >= stopRepetitions \/ transmissionFailed \/ waitingReceived \/ unitsReady \/ lowestReachableLevel < limitM1 \/ highestReachableLevel > limitM2 ) /\ otherUnitsSound /\ not ( not ( levelDeviceSound ) )
	}
	transition t28 {
		from DEGRADED
		to DEGRADED
		trigger messagesReceived
		condition not ( successiveStops >= stopRepetitions \/ transmissionFailed \/ waitingReceived \/ unitsReady \/ lowestReachableLevel < limitM1 \/ highestReachableLevel > limitM2 ) /\ not ( not ( levelDeviceSound ) ) /\ not ( otherUnitsSound ) /\ waterLevel < normalN1
		action send modeMessage ; send openPump ; send openPump ; send openPump ; send openPump
	}
	transition t29 {
		from DEGRADED
		to DEGRADED
		trigger messagesReceived
		condition not ( successiveStops >= stopRepetitions \/ transmissionFailed \/ waitingReceived \/ unitsReady \/ lowestReachableLevel < limitM1 \/ highestReachableLevel > limitM2 ) /\ not ( not ( levelDeviceSound ) ) /\ not ( otherUnitsSound ) /\ waterLevel > normalN2
		action send modeMessage ; send closePump ; send closePump ; send closePump ; send closePump
	}
	transition t30 {
		from DEGRADED
		to DEGRADED
		trigger messagesReceived
		condition not ( successiveStops >= stopRepetitions \/ transmissionFailed \/ waitingReceived \/ unitsReady \/ lowestReachableLevel < limitM1 \/ highestReachableLevel > limitM2 ) /\ not ( not ( levelDeviceSound ) ) /\ not ( otherUnitsSound ) /\ not ( waterLevel < normalN1 ) /\ not ( waterLevel > normalN2 )
	}
	transition t31 {
		from RESCUE
		to EMERGENCY_STOP
		trigger messagesReceived
		condition successiveStops >= stopRepetitions
	}
	transition t32 {
		from RESCUE
		to EMERGENCY_STOP
		trigger messagesReceived
		condition transmissionFailed \/ waitingReceived \/ unitsReady
	}
	transition t33 {
		from RESCUE
		to EMERGENCY_STOP
		trigger messagesReceived
		condition not ( steamDeviceSound ) \/ not ( pumpControllersSound )
	}
	transition t34 {
		from RESCUE
		to EMERGENCY_STOP
		trigger messagesReceived
		condition lowestReachableLevel < limitM1 \/ highestReachableLevel > limitM2
	}
	transition t35 {
		from RESCUE
		to NORMAL
		trigger messagesReceived
		condition not ( successiveStops >= stopRepetitions \/ transmissionFailed \/ waitingReceived \/ unitsReady \/ lowestReachableLevel < limitM1 \/ highestReachableLevel > limitM2 \/ not ( steamDeviceSound ) \/ not ( pumpControllersSound ) ) /\ otherUnitsSound /\ not ( not ( levelDeviceSound ) )
	}
	transition t36 {
		from RESCUE
		to DEGRADED
		trigger messagesReceived
		condition not ( successiveStops >= stopRepetitions \/ transmissionFailed \/ waitingReceived \/ unitsReady \/ lowestReachableLevel < limitM1 \/ highestReachableLevel > limitM2 \/ not ( steamDeviceSound ) \/ not ( pumpControllersSound ) ) /\ not ( not ( levelDeviceSound ) ) /\ not ( otherUnitsSound )
	}
	transition t37 {
		from RESCUE
		to RESCUE
		trigger messagesReceived
		condition not ( successiveStops >= stopRepetitions \/ transmissionFailed \/ waitingReceived \/ unitsReady \/ lowestReachableLevel < limitM1 \/ highestReachableLevel > limitM2 \/ not ( steamDeviceSound ) \/ not ( pumpControllersSound ) ) /\ not ( levelDeviceSound ) /\ waterLevel < normalN1
		action send modeMessage ; send openPump ; send openPump ; send openPump ; send openPump
	}
	transition t38 {
		from RESCUE
		to RESCUE
		trigger messagesReceived
		condition not ( successiveStops >= stopRepetitions \/ transmissionFailed \/ waitingReceived \/ unitsReady \/ lowestReachableLevel < limitM1 \/ highestReachableLevel > limitM2 \/ not ( steamDeviceSound ) \/ not ( pumpControllersSound ) ) /\ not ( levelDeviceSound ) /\ waterLevel > normalN2
		action send modeMessage ; send closePump ; send closePump ; send closePump ; send closePump
	}
	transition t39 {
		from RESCUE
		to RESCUE
		trigger messagesReceived
		condition not ( successiveStops >= stopRepetitions \/ transmissionFailed \/ waitingReceived \/ unitsReady \/ lowestReachableLevel < limitM1 \/ highestReachableLevel > limitM2 \/ not ( steamDeviceSound ) \/ not ( pumpControllersSound ) ) /\ not ( levelDeviceSound ) /\ not ( waterLevel < normalN1 ) /\ not ( waterLevel > normalN2 )
	}
}

controller SteamBoilerController_Ctrl {
	uses Inputs uses Outputs requires SteamBoilerController_State requires Constants requires Sensors
	sref stm_ref0 = SteamBoilerController
	connection SteamBoilerController_Ctrl on messagesReceived to stm_ref0 on messagesReceived
	connection stm_ref0 on modeMessage to SteamBoilerController_Ctrl on modeMessage
	connection stm_ref0 on programReady to SteamBoilerController_Ctrl on programReady
	connection stm_ref0 on valve to SteamBoilerController_Ctrl on valve
	connection stm_ref0 on openPump to SteamBoilerController_Ctrl on openPump
	connection stm_ref0 on closePump to SteamBoilerController_Ctrl on closePump
}

module SteamBoilerController_Module {
	robotic platform SteamBoilerController_Platform {
		provides Sensors provides Actuators provides Constants
		event messagesReceived
		event modeMessage
		event programReady
		event valve
		event openPump
		event closePump
	}
	cref ctrl_ref0 = SteamBoilerController_Ctrl
	connection SteamBoilerController_Platform on messagesReceived to ctrl_ref0 on messagesReceived
	connection ctrl_ref0 on modeMessage to SteamBoilerController_Platform on modeMessage
	connection ctrl_ref0 on programReady to SteamBoilerController_Platform on programReady
	connection ctrl_ref0 on valve to SteamBoilerController_Platform on valve
	connection ctrl_ref0 on openPump to SteamBoilerController_Platform on openPump
	connection ctrl_ref0 on closePump to SteamBoilerController_Platform on closePump
}

