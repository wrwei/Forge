        </annotationType>
      </annotation>
      <comment xsi:type="spoon:CtJavaDoc" commentContent="C: total capacity of the boiler (litre)."/>
      <modifier>FINAL</modifier>
      <modifier>STATIC</modifier>
      <modifier>PUBLIC</modifier>
      <type name="double"/>
      <assignment xsi:type="spoon:CtLiteral" value="1000.0" valueKind="Double">
        <type name="double"/>
      </assignment>
    </typeMember>
    <typeMember xsi:type="spoon:CtField" name="MINIMAL_M1">
