  <spoon:CtClass name="BoilerConstants">
    <comment xsi:type="spoon:CtJavaDoc" commentContent="The constant characteristics of the plant. The requirements name these quantities but give no&#xA;values; the values below are chosen so that the two danger conditions of the boiler hold:&#xA;MINIMAL_M1 is at least five seconds of maximal steam, and CAPACITY_C - MAXIMAL_M2 is at least five&#xA;seconds of all four pumps."/>
    <modifier>FINAL</modifier>
    <modifier>PUBLIC</modifier>
    <typeMember xsi:type="spoon:CtField" name="CAPACITY_C">
