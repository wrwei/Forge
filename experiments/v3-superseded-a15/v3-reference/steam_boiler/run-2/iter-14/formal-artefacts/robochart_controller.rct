diagram SteamBoilerController

enumeration OperatingMode { MODE_INITIALIZATION MODE_NORMAL MODE_DEGRADED MODE_RESCUE MODE_EMERGENCY_STOP }
enumeration PumpId { PUMP1 PUMP2 PUMP3 PUMP4 }
enumeration PumpSwitch { ALL_ON ALL_OFF }
enumeration ValveSetting { VALVE_CLOSED VALVE_OPEN }

interface Inputs {
	event messagesReceived
}

interface Outputs {
	event modeMessage
	event programReady
	event drainValve
	event switchPumps
}

interface Sensors {
	var ESTIMATION_SLICES : int
	var stopInbox : boolean
	var waitingInbox : boolean
	var readyInbox : boolean
	var levelInboxCount : int
	var steamInboxCount : int
	var levelRepairedInbox : boolean
	var steamRepairedInbox : boolean
	var levelAckInbox : boolean
	var steamAckInbox : boolean
	var reportedLevel : real
	var reportedSteam : real
	var referenceSteam : real
	var steamReferenceValid : boolean
	var levelReferenceValid : boolean
	var levelRepairAckDue : boolean
	var steamRepairAckDue : boolean
	var throughput : real
	var lowerLevel : real
	var upperLevel : real
	var estimatedLevel : real
	var nextSteamOutMax : real
	var nextSteamOutMin : real
	var uncontrolledInflow : real
	var lowestReachable : real
	var highestReachable : real
	var transmissionFault : boolean
	var stopRun : int
	var waitingArrived : boolean
	var readyArrived : boolean
	var monitoring : boolean
	var drainOpen : boolean
	var controllersHealthy : boolean
	var othersHealthy : boolean
	var levelHealthy : boolean
	var steamHealthy : boolean
	var stopDemandedFlag : boolean
	var steamNonZeroFlag : boolean
	var belowBandFlag : boolean
	var aboveBandFlag : boolean
	var tooLowFlag : boolean
	var tooHighFlag : boolean
	var safeRangeFlag : boolean
	var haltFlag : boolean
	var plausibleFlag : boolean
	var trustworthyFlag : boolean
	var pumpsHealthy : boolean
	var emergencyFlag : boolean
	var operatingPhase : boolean
	var programReadyIssued : boolean
	var emergencyDemanded : boolean
	var physicalUnitsReadyReceived : boolean
	var levelDeviceSound : boolean
	var otherUnitsSound : boolean
	var boilerWaitingSeen : boolean
	var levelAboveNormalBand : boolean
	var levelBelowNormalBand : boolean
}

interface Actuators {
}

interface SteamBoilerController_State {
	var programReadySent : boolean = false
}

interface Constants {
}

stm SteamBoilerController {
	uses Inputs uses Outputs requires SteamBoilerController_State requires Constants requires Sensors
	state EMERGENCY_STOP {
		entry send modeMessage
	}
	state RESCUE {
		entry send modeMessage
	}
	state DEGRADED {
		entry send modeMessage
	}
	state NORMAL {
		entry send modeMessage
	}
	state INITIALIZATION {
	}
	initial i0
	transition t_init {
		from i0
		to INITIALIZATION
	}
	transition t1 {
		from INITIALIZATION
		to EMERGENCY_STOP
		trigger messagesReceived
		condition not ( not ( emergencyDemanded ) /\ not ( physicalUnitsReadyReceived /\ not ( programReadySent ) ) )
	}
	transition t2 {
		from INITIALIZATION
		to NORMAL
		trigger messagesReceived
		condition not ( emergencyDemanded ) /\ not ( physicalUnitsReadyReceived /\ not ( programReadySent ) ) /\ programReadySent /\ physicalUnitsReadyReceived /\ levelDeviceSound /\ otherUnitsSound
	}
	transition t3 {
		from INITIALIZATION
		to DEGRADED
		trigger messagesReceived
		condition not ( emergencyDemanded ) /\ not ( physicalUnitsReadyReceived /\ not ( programReadySent ) ) /\ programReadySent /\ physicalUnitsReadyReceived /\ not ( levelDeviceSound /\ otherUnitsSound )
	}
	transition t4 {
		from INITIALIZATION
		to INITIALIZATION
		trigger messagesReceived
		condition not ( emergencyDemanded ) /\ not ( physicalUnitsReadyReceived /\ not ( programReadySent ) ) /\ programReadySent /\ not ( physicalUnitsReadyReceived )
		action send modeMessage ; send programReady
	}
	transition t5 {
		from INITIALIZATION
		to INITIALIZATION
		trigger messagesReceived
		condition not ( emergencyDemanded ) /\ not ( physicalUnitsReadyReceived /\ not ( programReadySent ) ) /\ not ( programReadySent ) /\ not ( boilerWaitingSeen )
		action send modeMessage
	}
	transition t6 {
		from INITIALIZATION
		to INITIALIZATION
		trigger messagesReceived
		condition not ( emergencyDemanded ) /\ not ( physicalUnitsReadyReceived /\ not ( programReadySent ) ) /\ not ( programReadySent ) /\ boilerWaitingSeen /\ levelAboveNormalBand /\ not ( levelBelowNormalBand )
		action send modeMessage ; send drainValve
	}
	transition t7 {
		from INITIALIZATION
		to INITIALIZATION
		trigger messagesReceived
		condition not ( emergencyDemanded ) /\ not ( physicalUnitsReadyReceived /\ not ( programReadySent ) ) /\ not ( programReadySent ) /\ boilerWaitingSeen /\ levelBelowNormalBand
		action send modeMessage ; send drainValve ; send switchPumps
	}
	transition t8 {
		from INITIALIZATION
		to INITIALIZATION
		trigger messagesReceived
		condition not ( emergencyDemanded ) /\ not ( physicalUnitsReadyReceived /\ not ( programReadySent ) ) /\ not ( not ( emergencyDemanded ) /\ not ( physicalUnitsReadyReceived /\ not ( programReadySent ) ) /\ programReadySent /\ physicalUnitsReadyReceived /\ levelDeviceSound /\ otherUnitsSound ) /\ not ( not ( emergencyDemanded ) /\ not ( physicalUnitsReadyReceived /\ not ( programReadySent ) ) /\ programReadySent /\ physicalUnitsReadyReceived /\ not ( levelDeviceSound /\ otherUnitsSound ) ) /\ not ( not ( emergencyDemanded ) /\ not ( physicalUnitsReadyReceived /\ not ( programReadySent ) ) /\ programReadySent /\ not ( physicalUnitsReadyReceived ) ) /\ not ( not ( emergencyDemanded ) /\ not ( physicalUnitsReadyReceived /\ not ( programReadySent ) ) /\ not ( programReadySent ) /\ not ( boilerWaitingSeen ) ) /\ not ( not ( emergencyDemanded ) /\ not ( physicalUnitsReadyReceived /\ not ( programReadySent ) ) /\ not ( programReadySent ) /\ boilerWaitingSeen /\ levelAboveNormalBand /\ not ( levelBelowNormalBand ) ) /\ not ( not ( emergencyDemanded ) /\ not ( physicalUnitsReadyReceived /\ not ( programReadySent ) ) /\ not ( programReadySent ) /\ boilerWaitingSeen /\ levelBelowNormalBand )
		action programReadySent = true ; send modeMessage ; send drainValve ; send switchPumps ; send programReady
	}
	transition t9 {
		from NORMAL
		to EMERGENCY_STOP
		trigger messagesReceived
		condition emergencyDemanded \/ physicalUnitsReadyReceived
	}
	transition t10 {
		from NORMAL
		to RESCUE
		trigger messagesReceived
		condition not ( emergencyDemanded \/ physicalUnitsReadyReceived ) /\ not ( levelDeviceSound )
	}
	transition t11 {
		from NORMAL
		to DEGRADED
		trigger messagesReceived
		condition not ( emergencyDemanded \/ physicalUnitsReadyReceived ) /\ levelDeviceSound /\ not ( otherUnitsSound )
	}
	transition t12 {
		from NORMAL
		to NORMAL
		trigger messagesReceived
		condition not ( emergencyDemanded \/ physicalUnitsReadyReceived ) /\ levelDeviceSound /\ otherUnitsSound /\ levelBelowNormalBand
		action send modeMessage ; send switchPumps
	}
	transition t13 {
		from NORMAL
		to NORMAL
		trigger messagesReceived
		condition not ( emergencyDemanded \/ physicalUnitsReadyReceived ) /\ levelDeviceSound /\ otherUnitsSound /\ levelAboveNormalBand /\ not ( levelBelowNormalBand )
		action send modeMessage ; send switchPumps
	}
	transition t14 {
		from NORMAL
		to NORMAL
		trigger messagesReceived
		condition not ( emergencyDemanded \/ physicalUnitsReadyReceived ) /\ not ( not ( emergencyDemanded \/ physicalUnitsReadyReceived ) /\ not ( levelDeviceSound ) ) /\ not ( not ( emergencyDemanded \/ physicalUnitsReadyReceived ) /\ levelDeviceSound /\ not ( otherUnitsSound ) ) /\ not ( not ( emergencyDemanded \/ physicalUnitsReadyReceived ) /\ levelDeviceSound /\ otherUnitsSound /\ levelBelowNormalBand ) /\ not ( not ( emergencyDemanded \/ physicalUnitsReadyReceived ) /\ levelDeviceSound /\ otherUnitsSound /\ levelAboveNormalBand /\ not ( levelBelowNormalBand ) )
	}
	transition t15 {
		from DEGRADED
		to EMERGENCY_STOP
		trigger messagesReceived
		condition emergencyDemanded \/ physicalUnitsReadyReceived
	}
	transition t16 {
		from DEGRADED
		to RESCUE
		trigger messagesReceived
		condition not ( emergencyDemanded \/ physicalUnitsReadyReceived ) /\ not ( levelDeviceSound )
	}
	transition t17 {
		from DEGRADED
		to NORMAL
		trigger messagesReceived
		condition not ( emergencyDemanded \/ physicalUnitsReadyReceived ) /\ levelDeviceSound /\ otherUnitsSound
	}
	transition t18 {
		from DEGRADED
		to DEGRADED
		trigger messagesReceived
		condition not ( emergencyDemanded \/ physicalUnitsReadyReceived ) /\ levelDeviceSound /\ not ( otherUnitsSound ) /\ levelBelowNormalBand
		action send modeMessage ; send switchPumps
	}
	transition t19 {
		from DEGRADED
		to DEGRADED
		trigger messagesReceived
		condition not ( emergencyDemanded \/ physicalUnitsReadyReceived ) /\ levelDeviceSound /\ not ( otherUnitsSound ) /\ levelAboveNormalBand /\ not ( levelBelowNormalBand )
		action send modeMessage ; send switchPumps
	}
	transition t20 {
		from DEGRADED
		to DEGRADED
		trigger messagesReceived
		condition not ( emergencyDemanded \/ physicalUnitsReadyReceived ) /\ not ( not ( emergencyDemanded \/ physicalUnitsReadyReceived ) /\ not ( levelDeviceSound ) ) /\ not ( not ( emergencyDemanded \/ physicalUnitsReadyReceived ) /\ levelDeviceSound /\ otherUnitsSound ) /\ not ( not ( emergencyDemanded \/ physicalUnitsReadyReceived ) /\ levelDeviceSound /\ not ( otherUnitsSound ) /\ levelBelowNormalBand ) /\ not ( not ( emergencyDemanded \/ physicalUnitsReadyReceived ) /\ levelDeviceSound /\ not ( otherUnitsSound ) /\ levelAboveNormalBand /\ not ( levelBelowNormalBand ) )
	}
	transition t21 {
		from RESCUE
		to EMERGENCY_STOP
		trigger messagesReceived
		condition emergencyDemanded \/ physicalUnitsReadyReceived
	}
	transition t22 {
		from RESCUE
		to NORMAL
		trigger messagesReceived
		condition not ( emergencyDemanded \/ physicalUnitsReadyReceived ) /\ levelDeviceSound /\ otherUnitsSound
	}
	transition t23 {
		from RESCUE
		to DEGRADED
		trigger messagesReceived
		condition not ( emergencyDemanded \/ physicalUnitsReadyReceived ) /\ levelDeviceSound /\ not ( otherUnitsSound )
	}
	transition t24 {
		from RESCUE
		to RESCUE
		trigger messagesReceived
		condition not ( emergencyDemanded \/ physicalUnitsReadyReceived ) /\ not ( levelDeviceSound ) /\ levelBelowNormalBand
		action send modeMessage ; send switchPumps
	}
	transition t25 {
		from RESCUE
		to RESCUE
		trigger messagesReceived
		condition not ( emergencyDemanded \/ physicalUnitsReadyReceived ) /\ not ( levelDeviceSound ) /\ levelAboveNormalBand /\ not ( levelBelowNormalBand )
		action send modeMessage ; send switchPumps
	}
	transition t26 {
		from RESCUE
		to RESCUE
		trigger messagesReceived
		condition not ( emergencyDemanded \/ physicalUnitsReadyReceived ) /\ not ( not ( emergencyDemanded \/ physicalUnitsReadyReceived ) /\ levelDeviceSound /\ otherUnitsSound ) /\ not ( not ( emergencyDemanded \/ physicalUnitsReadyReceived ) /\ levelDeviceSound /\ not ( otherUnitsSound ) ) /\ not ( not ( emergencyDemanded \/ physicalUnitsReadyReceived ) /\ not ( levelDeviceSound ) /\ levelBelowNormalBand ) /\ not ( not ( emergencyDemanded \/ physicalUnitsReadyReceived ) /\ not ( levelDeviceSound ) /\ levelAboveNormalBand /\ not ( levelBelowNormalBand ) )
	}
	transition t27 {
		from EMERGENCY_STOP
		to EMERGENCY_STOP
		trigger messagesReceived
	}
}

controller SteamBoilerController_Ctrl {
	uses Inputs uses Outputs requires SteamBoilerController_State requires Constants requires Sensors
	sref stm_ref0 = SteamBoilerController
	connection SteamBoilerController_Ctrl on messagesReceived to stm_ref0 on messagesReceived
	connection stm_ref0 on modeMessage to SteamBoilerController_Ctrl on modeMessage
	connection stm_ref0 on programReady to SteamBoilerController_Ctrl on programReady
	connection stm_ref0 on drainValve to SteamBoilerController_Ctrl on drainValve
	connection stm_ref0 on switchPumps to SteamBoilerController_Ctrl on switchPumps
}

module SteamBoilerController_Module {
	robotic platform SteamBoilerController_Platform {
		provides Sensors provides Actuators provides Constants
		event messagesReceived
		event modeMessage
		event programReady
		event drainValve
		event switchPumps
	}
	cref ctrl_ref0 = SteamBoilerController_Ctrl
	connection SteamBoilerController_Platform on messagesReceived to ctrl_ref0 on messagesReceived
	connection ctrl_ref0 on modeMessage to SteamBoilerController_Platform on modeMessage
	connection ctrl_ref0 on programReady to SteamBoilerController_Platform on programReady
	connection ctrl_ref0 on drainValve to SteamBoilerController_Platform on drainValve
	connection ctrl_ref0 on switchPumps to SteamBoilerController_Platform on switchPumps
}

