					endmodule
					----------------------------------------------------------------------
					
					-- END of Nodes --
					
					Timed(OneStep) {
					-- Operation calls --
					-- Only the undefined operations are declared here.
					-- If the state machine is in isolation, all required operations will be undefined.
					-- If it is in the context of a controller, the required operations not provided by the
					-- controller will be declared here, and the defined operations will be defined in the
					-- context of the Controller module, and therefore within scope of the state machine module.
					
					-- END of Operation calls --
				
					-- STM processes
					STM(id__) = -- RULE: [[stm:StateMachineDef]]_STM^nops : CSPProcess
					( 
						(
							(
								(IteratedStateful(id__) \ {terminate} ; share__choice(terminate -> SKIP))
							 	[[ share__ <- x__ | x__ <- {|set_EXT_plantWaiting,set_EXT_valveOpen,set_EXT_programReadySent,set_EXT_ESTIMATION_SLICES,set_EXT_stopInbox,set_EXT_waitingInbox,set_EXT_readyInbox,set_EXT_levelInboxCount,set_EXT_steamInboxCount,set_EXT_levelRepairedInbox,set_EXT_steamRepairedInbox,set_EXT_levelAckInbox,set_EXT_steamAckInbox,set_EXT_reportedLevel,set_EXT_reportedSteam,set_EXT_referenceSteam,set_EXT_steamReferenceValid,set_EXT_levelReferenceValid,set_EXT_levelRepairAckDue,set_EXT_steamRepairAckDue,set_EXT_throughput,set_EXT_lowerLevel,set_EXT_upperLevel,set_EXT_estimatedLevel,set_EXT_lowestReachable,set_EXT_highestReachable,set_EXT_transmissionFault,set_EXT_stopRun,set_EXT_waitingArrived,set_EXT_readyArrived,set_EXT_monitoring,set_EXT_drainOpen,set_EXT_controllersHealthy,set_EXT_othersHealthy,set_EXT_operatorStopDemanded,set_EXT_transmissionFailure,set_EXT_physicalUnitsReadyReceived,set_EXT_steamBoilerWaitingReceived,set_EXT_steamDetected,set_EXT_levelDeviceSound,set_EXT_otherUnitsSound,set_EXT_levelAboveNormalBand,set_EXT_levelBelowNormalBand,set_EXT_levelLimitAtRisk,set_EXT_steamDeviceSound,set_EXT_pumpControllersSound|} ]]
							)
						[| {share__} |]
