diagram SteamBoilerController

enumeration OperatingMode { MODE_INITIALIZATION MODE_NORMAL MODE_DEGRADED MODE_RESCUE MODE_EMERGENCY_STOP }
enumeration PumpId { PUMP1 PUMP2 PUMP3 PUMP4 }

interface Inputs {
	event messagesReceived
}

interface Outputs {
	event modeMessage
	event programReady
	event valve
	event openPump
	event closePump
}

interface Sensors {
	var ESTIMATION_SLICES : int
	var stopInbox : boolean
	var waitingInbox : boolean
	var readyInbox : boolean
	var levelInboxCount : int
	var steamInboxCount : int
	var levelRepairedInbox : boolean
	var steamRepairedInbox : boolean
	var levelAckInbox : boolean
	var steamAckInbox : boolean
	var reportedLevel : real
	var reportedSteam : real
	var referenceSteam : real
	var steamReferenceValid : boolean
	var levelReferenceValid : boolean
	var levelRepairAckDue : boolean
	var steamRepairAckDue : boolean
	var throughput : real
	var lowerLevel : real
	var upperLevel : real
	var estimatedLevel : real
	var nextSteamOutMax : real
	var nextSteamOutMin : real
	var uncontrolledInflow : real
	var lowestReachable : real
	var highestReachable : real
	var transmissionFault : boolean
	var stopRun : int
	var waitingArrived : boolean
	var readyArrived : boolean
	var monitoring : boolean
	var drainOpen : boolean
	var controllersHealthy : boolean
	var othersHealthy : boolean
	var levelHealthy : boolean
	var steamHealthy : boolean
	var stopDemandedFlag : boolean
	var steamNonZeroFlag : boolean
	var belowBandFlag : boolean
	var aboveBandFlag : boolean
	var tooLowFlag : boolean
	var tooHighFlag : boolean
	var haltFlag : boolean
	var plausibleFlag : boolean
	var trustworthyFlag : boolean
	var haltDemanded : boolean
	var physicalUnitsReadyReceived : boolean
	var steamBoilerWaitingReceived : boolean
	var startupReadingsPlausible : boolean
	var levelDeviceSound : boolean
	var otherUnitsSound : boolean
	var levelAboveNormalBand : boolean
	var levelBelowNormalBand : boolean
	var levelMayFallTooLow : boolean
	var levelMayRiseTooHigh : boolean
	var estimateTrustworthy : boolean
}

interface Actuators {
}

interface SteamBoilerController_State {
	var plantWaiting : boolean = false
	var valveOpen : boolean = false
	var programReadySent : boolean = false
}

interface Constants {
}

stm SteamBoilerController {
	uses Inputs uses Outputs requires SteamBoilerController_State requires Constants requires Sensors
	state EMERGENCY_STOP {
		entry send modeMessage
	}
	state RESCUE {
		entry send modeMessage
	}
	state DEGRADED {
		entry send modeMessage
	}
	state NORMAL {
		entry send modeMessage
	}
	state INITIALIZATION {
	}
	initial i0
	transition t_init {
		from i0
		to INITIALIZATION
	}
	transition t1 {
		from INITIALIZATION
		to EMERGENCY_STOP
		trigger messagesReceived
		condition not ( not ( haltDemanded ) /\ not ( physicalUnitsReadyReceived /\ not ( programReadySent ) ) /\ not ( not ( not ( plantWaiting ) /\ not ( steamBoilerWaitingReceived ) ) /\ not ( startupReadingsPlausible ) ) )
	}
	transition t2 {
		from INITIALIZATION
		to NORMAL
		trigger messagesReceived
		condition not ( haltDemanded ) /\ not ( physicalUnitsReadyReceived /\ not ( programReadySent ) ) /\ not ( not ( not ( plantWaiting ) /\ not ( steamBoilerWaitingReceived ) ) /\ not ( startupReadingsPlausible ) ) /\ programReadySent /\ physicalUnitsReadyReceived /\ levelDeviceSound /\ otherUnitsSound
	}
	transition t3 {
		from INITIALIZATION
		to DEGRADED
		trigger messagesReceived
		condition not ( haltDemanded ) /\ not ( physicalUnitsReadyReceived /\ not ( programReadySent ) ) /\ not ( not ( not ( plantWaiting ) /\ not ( steamBoilerWaitingReceived ) ) /\ not ( startupReadingsPlausible ) ) /\ programReadySent /\ physicalUnitsReadyReceived /\ not ( levelDeviceSound /\ otherUnitsSound )
	}
	transition t4 {
		from INITIALIZATION
		to INITIALIZATION
		trigger messagesReceived
		condition not ( haltDemanded ) /\ not ( physicalUnitsReadyReceived /\ not ( programReadySent ) ) /\ not ( not ( not ( plantWaiting ) /\ not ( steamBoilerWaitingReceived ) ) /\ not ( startupReadingsPlausible ) ) /\ programReadySent /\ not ( physicalUnitsReadyReceived )
		action send modeMessage ; send programReady
	}
	transition t5 {
		from INITIALIZATION
		to INITIALIZATION
		trigger messagesReceived
		condition not ( haltDemanded ) /\ not ( physicalUnitsReadyReceived /\ not ( programReadySent ) ) /\ not ( not ( not ( plantWaiting ) /\ not ( steamBoilerWaitingReceived ) ) /\ not ( startupReadingsPlausible ) ) /\ not ( programReadySent ) /\ not ( plantWaiting ) /\ not ( steamBoilerWaitingReceived )
		action send modeMessage
	}
	transition t6 {
		from INITIALIZATION
		to INITIALIZATION
		trigger messagesReceived
		condition not ( haltDemanded ) /\ not ( physicalUnitsReadyReceived /\ not ( programReadySent ) ) /\ not ( not ( not ( plantWaiting ) /\ not ( steamBoilerWaitingReceived ) ) /\ not ( startupReadingsPlausible ) ) /\ not ( programReadySent ) /\ not ( not ( plantWaiting ) /\ not ( steamBoilerWaitingReceived ) ) /\ levelAboveNormalBand /\ not ( levelBelowNormalBand ) /\ not ( valveOpen )
		action plantWaiting = true ; valveOpen = true ; send modeMessage ; send valve
	}
	transition t7 {
		from INITIALIZATION
		to INITIALIZATION
		trigger messagesReceived
		condition not ( haltDemanded ) /\ not ( physicalUnitsReadyReceived /\ not ( programReadySent ) ) /\ not ( not ( not ( plantWaiting ) /\ not ( steamBoilerWaitingReceived ) ) /\ not ( startupReadingsPlausible ) ) /\ not ( programReadySent ) /\ not ( not ( plantWaiting ) /\ not ( steamBoilerWaitingReceived ) ) /\ levelAboveNormalBand /\ not ( levelBelowNormalBand ) /\ valveOpen
		action plantWaiting = true ; send modeMessage
	}
	transition t8 {
		from INITIALIZATION
		to INITIALIZATION
		trigger messagesReceived
		condition not ( haltDemanded ) /\ not ( physicalUnitsReadyReceived /\ not ( programReadySent ) ) /\ not ( not ( not ( plantWaiting ) /\ not ( steamBoilerWaitingReceived ) ) /\ not ( startupReadingsPlausible ) ) /\ not ( programReadySent ) /\ not ( not ( plantWaiting ) /\ not ( steamBoilerWaitingReceived ) ) /\ not ( levelAboveNormalBand /\ not ( levelBelowNormalBand ) ) /\ not ( not ( levelBelowNormalBand ) /\ not ( levelAboveNormalBand ) ) /\ valveOpen
		action plantWaiting = true ; valveOpen = false ; send modeMessage ; send valve ; send openPump ; send openPump ; send openPump ; send openPump
	}
	transition t9 {
		from INITIALIZATION
		to INITIALIZATION
		trigger messagesReceived
		condition not ( haltDemanded ) /\ not ( physicalUnitsReadyReceived /\ not ( programReadySent ) ) /\ not ( not ( not ( plantWaiting ) /\ not ( steamBoilerWaitingReceived ) ) /\ not ( startupReadingsPlausible ) ) /\ not ( programReadySent ) /\ not ( not ( plantWaiting ) /\ not ( steamBoilerWaitingReceived ) ) /\ not ( levelAboveNormalBand /\ not ( levelBelowNormalBand ) ) /\ not ( not ( levelBelowNormalBand ) /\ not ( levelAboveNormalBand ) ) /\ not ( valveOpen )
		action plantWaiting = true ; send modeMessage ; send openPump ; send openPump ; send openPump ; send openPump
	}
	transition t10 {
		from INITIALIZATION
		to INITIALIZATION
		trigger messagesReceived
		condition not ( haltDemanded ) /\ not ( physicalUnitsReadyReceived /\ not ( programReadySent ) ) /\ not ( not ( not ( plantWaiting ) /\ not ( steamBoilerWaitingReceived ) ) /\ not ( startupReadingsPlausible ) ) /\ not ( programReadySent ) /\ not ( not ( plantWaiting ) /\ not ( steamBoilerWaitingReceived ) ) /\ not ( levelBelowNormalBand ) /\ not ( levelAboveNormalBand ) /\ valveOpen
		action plantWaiting = true ; valveOpen = false ; programReadySent = true ; send modeMessage ; send valve ; send closePump ; send closePump ; send closePump ; send closePump ; send programReady
	}
	transition t11 {
		from INITIALIZATION
		to INITIALIZATION
		trigger messagesReceived
		condition not ( haltDemanded ) /\ not ( physicalUnitsReadyReceived /\ not ( programReadySent ) ) /\ not ( not ( not ( plantWaiting ) /\ not ( steamBoilerWaitingReceived ) ) /\ not ( startupReadingsPlausible ) ) /\ not ( programReadySent ) /\ not ( not ( plantWaiting ) /\ not ( steamBoilerWaitingReceived ) ) /\ not ( levelBelowNormalBand ) /\ not ( levelAboveNormalBand ) /\ not ( valveOpen )
		action plantWaiting = true ; programReadySent = true ; send modeMessage ; send closePump ; send closePump ; send closePump ; send closePump ; send programReady
	}
	transition t12 {
		from NORMAL
		to EMERGENCY_STOP
		trigger messagesReceived
		condition haltDemanded \/ steamBoilerWaitingReceived \/ physicalUnitsReadyReceived \/ levelMayFallTooLow \/ levelMayRiseTooHigh
	}
	transition t13 {
		from NORMAL
		to RESCUE
		trigger messagesReceived
		condition not ( haltDemanded \/ steamBoilerWaitingReceived \/ physicalUnitsReadyReceived \/ levelMayFallTooLow \/ levelMayRiseTooHigh ) /\ not ( levelDeviceSound )
	}
	transition t14 {
		from NORMAL
		to DEGRADED
		trigger messagesReceived
		condition not ( haltDemanded \/ steamBoilerWaitingReceived \/ physicalUnitsReadyReceived \/ levelMayFallTooLow \/ levelMayRiseTooHigh ) /\ levelDeviceSound /\ not ( otherUnitsSound )
	}
	transition t15 {
		from NORMAL
		to NORMAL
		trigger messagesReceived
		condition not ( haltDemanded \/ steamBoilerWaitingReceived \/ physicalUnitsReadyReceived \/ levelMayFallTooLow \/ levelMayRiseTooHigh ) /\ levelDeviceSound /\ otherUnitsSound /\ not ( levelAboveNormalBand /\ not ( levelBelowNormalBand ) ) /\ not ( not ( levelBelowNormalBand ) /\ not ( levelAboveNormalBand ) )
		action send modeMessage ; send openPump ; send openPump ; send openPump ; send openPump
	}
	transition t16 {
		from NORMAL
		to NORMAL
		trigger messagesReceived
		condition not ( haltDemanded \/ steamBoilerWaitingReceived \/ physicalUnitsReadyReceived \/ levelMayFallTooLow \/ levelMayRiseTooHigh ) /\ levelDeviceSound /\ otherUnitsSound /\ levelAboveNormalBand /\ not ( levelBelowNormalBand )
		action send modeMessage ; send closePump ; send closePump ; send closePump ; send closePump
	}
	transition t17 {
		from NORMAL
		to NORMAL
		trigger messagesReceived
		condition not ( haltDemanded \/ steamBoilerWaitingReceived \/ physicalUnitsReadyReceived \/ levelMayFallTooLow \/ levelMayRiseTooHigh ) /\ levelDeviceSound /\ otherUnitsSound /\ not ( levelBelowNormalBand ) /\ not ( levelAboveNormalBand )
	}
	transition t18 {
		from DEGRADED
		to EMERGENCY_STOP
		trigger messagesReceived
		condition haltDemanded \/ steamBoilerWaitingReceived \/ physicalUnitsReadyReceived \/ levelMayFallTooLow \/ levelMayRiseTooHigh
	}
	transition t19 {
		from DEGRADED
		to RESCUE
		trigger messagesReceived
		condition not ( haltDemanded \/ steamBoilerWaitingReceived \/ physicalUnitsReadyReceived \/ levelMayFallTooLow \/ levelMayRiseTooHigh ) /\ not ( levelDeviceSound )
	}
	transition t20 {
		from DEGRADED
		to NORMAL
		trigger messagesReceived
		condition not ( haltDemanded \/ steamBoilerWaitingReceived \/ physicalUnitsReadyReceived \/ levelMayFallTooLow \/ levelMayRiseTooHigh ) /\ levelDeviceSound /\ otherUnitsSound
	}
	transition t21 {
		from DEGRADED
		to DEGRADED
		trigger messagesReceived
		condition not ( haltDemanded \/ steamBoilerWaitingReceived \/ physicalUnitsReadyReceived \/ levelMayFallTooLow \/ levelMayRiseTooHigh ) /\ levelDeviceSound /\ not ( otherUnitsSound ) /\ not ( levelAboveNormalBand /\ not ( levelBelowNormalBand ) ) /\ not ( not ( levelBelowNormalBand ) /\ not ( levelAboveNormalBand ) )
		action send modeMessage ; send openPump ; send openPump ; send openPump ; send openPump
	}
	transition t22 {
		from DEGRADED
		to DEGRADED
		trigger messagesReceived
		condition not ( haltDemanded \/ steamBoilerWaitingReceived \/ physicalUnitsReadyReceived \/ levelMayFallTooLow \/ levelMayRiseTooHigh ) /\ levelDeviceSound /\ not ( otherUnitsSound ) /\ levelAboveNormalBand /\ not ( levelBelowNormalBand )
		action send modeMessage ; send closePump ; send closePump ; send closePump ; send closePump
	}
	transition t23 {
		from DEGRADED
		to DEGRADED
		trigger messagesReceived
		condition not ( haltDemanded \/ steamBoilerWaitingReceived \/ physicalUnitsReadyReceived \/ levelMayFallTooLow \/ levelMayRiseTooHigh ) /\ levelDeviceSound /\ not ( otherUnitsSound ) /\ not ( levelBelowNormalBand ) /\ not ( levelAboveNormalBand )
	}
	transition t24 {
		from RESCUE
		to EMERGENCY_STOP
		trigger messagesReceived
		condition haltDemanded \/ steamBoilerWaitingReceived \/ physicalUnitsReadyReceived \/ levelMayFallTooLow \/ levelMayRiseTooHigh \/ not ( estimateTrustworthy )
	}
	transition t25 {
		from RESCUE
		to NORMAL
		trigger messagesReceived
		condition not ( haltDemanded \/ steamBoilerWaitingReceived \/ physicalUnitsReadyReceived \/ levelMayFallTooLow \/ levelMayRiseTooHigh \/ not ( estimateTrustworthy ) ) /\ levelDeviceSound /\ otherUnitsSound
	}
	transition t26 {
		from RESCUE
		to DEGRADED
		trigger messagesReceived
		condition not ( haltDemanded \/ steamBoilerWaitingReceived \/ physicalUnitsReadyReceived \/ levelMayFallTooLow \/ levelMayRiseTooHigh \/ not ( estimateTrustworthy ) ) /\ levelDeviceSound /\ not ( otherUnitsSound )
	}
	transition t27 {
		from RESCUE
		to RESCUE
		trigger messagesReceived
		condition not ( haltDemanded \/ steamBoilerWaitingReceived \/ physicalUnitsReadyReceived \/ levelMayFallTooLow \/ levelMayRiseTooHigh \/ not ( estimateTrustworthy ) ) /\ not ( levelDeviceSound ) /\ not ( levelAboveNormalBand /\ not ( levelBelowNormalBand ) ) /\ not ( not ( levelBelowNormalBand ) /\ not ( levelAboveNormalBand ) )
		action send modeMessage ; send openPump ; send openPump ; send openPump ; send openPump
	}
	transition t28 {
		from RESCUE
		to RESCUE
		trigger messagesReceived
		condition not ( haltDemanded \/ steamBoilerWaitingReceived \/ physicalUnitsReadyReceived \/ levelMayFallTooLow \/ levelMayRiseTooHigh \/ not ( estimateTrustworthy ) ) /\ not ( levelDeviceSound ) /\ levelAboveNormalBand /\ not ( levelBelowNormalBand )
		action send modeMessage ; send closePump ; send closePump ; send closePump ; send closePump
	}
	transition t29 {
		from RESCUE
		to RESCUE
		trigger messagesReceived
		condition not ( haltDemanded \/ steamBoilerWaitingReceived \/ physicalUnitsReadyReceived \/ levelMayFallTooLow \/ levelMayRiseTooHigh \/ not ( estimateTrustworthy ) ) /\ not ( levelDeviceSound ) /\ not ( levelBelowNormalBand ) /\ not ( levelAboveNormalBand )
	}
}

controller SteamBoilerController_Ctrl {
	uses Inputs uses Outputs requires SteamBoilerController_State requires Constants requires Sensors
	sref stm_ref0 = SteamBoilerController
	connection SteamBoilerController_Ctrl on messagesReceived to stm_ref0 on messagesReceived
	connection stm_ref0 on modeMessage to SteamBoilerController_Ctrl on modeMessage
	connection stm_ref0 on programReady to SteamBoilerController_Ctrl on programReady
	connection stm_ref0 on valve to SteamBoilerController_Ctrl on valve
	connection stm_ref0 on openPump to SteamBoilerController_Ctrl on openPump
	connection stm_ref0 on closePump to SteamBoilerController_Ctrl on closePump
}

module SteamBoilerController_Module {
	robotic platform SteamBoilerController_Platform {
		provides Sensors provides Actuators provides Constants
		event messagesReceived
		event modeMessage
		event programReady
		event valve
		event openPump
		event closePump
	}
	cref ctrl_ref0 = SteamBoilerController_Ctrl
	connection SteamBoilerController_Platform on messagesReceived to ctrl_ref0 on messagesReceived
	connection ctrl_ref0 on modeMessage to SteamBoilerController_Platform on modeMessage
	connection ctrl_ref0 on programReady to SteamBoilerController_Platform on programReady
	connection ctrl_ref0 on valve to SteamBoilerController_Platform on valve
	connection ctrl_ref0 on openPump to SteamBoilerController_Platform on openPump
	connection ctrl_ref0 on closePump to SteamBoilerController_Platform on closePump
}

