    <typeMember xsi:type="spoon:CtMethod" name="analyse">
      <comment xsi:type="spoon:CtJavaDoc" commentContent="Second stage of a cycle, before the controller decides: checks the transmission,&#xA;counts STOP messages, applies acknowledgements and repairs, detects unit failures and&#xA;advances the level estimate. Failure detection starts with STEAM_BOILER_WAITING."/>
      <modifier>PUBLIC</modifier>
