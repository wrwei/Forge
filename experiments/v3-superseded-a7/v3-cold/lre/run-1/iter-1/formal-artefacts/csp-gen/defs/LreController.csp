					 			|}) |]
					 ((i0::enter -> Transitions(id__,
					 		    const_LreController_momEntryMaxVel,
					 		    const_LreController_momEntryMinDist,
					 		    const_LreController_minSafeDist,
					 		    const_LreController_minTcpa,
					 		    const_LreController_highHorizVel,
					 		    const_LreController_staticObsHorizDist,
					 		    const_LreController_highVertVel,
					 		    const_LreController_staticObsVertDist,
					 		    const_LreController_staticObsDfltVertDist,
					 		    const_LreController_cpaEpsilon,
					 		    const_LreController_surfaceDepth))
					  [[ share__ <- x__ | x__ <- {| share__,setL_cdyn,setL_vel,setL_tcpa,setL_cda,setL_vvel,setL_cstc,setL_hvel,setL_inOpez |} ]]
					  [[set_v <- setR_v]]
					 )
					)[[setL_cdyn <- set_cdyn,setL_vel <- set_vel,setL_tcpa <- set_tcpa,setL_cda <- set_cda,setL_vvel <- set_vvel,setL_cstc <- set_cstc,setL_hvel <- set_hvel,setL_inOpez <- set_inOpez]]
					 [[setR_v <- set_v]]
					)
				)
				 \ hideSet)
				[[
					reqVel__.x____ <- reqVel,
					reqHdng__.x____ <- reqHdng,
					reqMOM__.x____ <- reqMOM,
					reqOCM__.x____ <- reqOCM,
					endTask__.x____ <- endTask,
					reqHCM__.x____ <- reqHCM,
					advVel__.x____ <- advVel,
					advHdng__.x____ <- advHdng
					| x____ <- NIDS
				]]
			)
			 [| {| interrupt |} |] SKIP)
		)
		)
	
	Behaviour_VS_O(id__,
			    const_LreController_momEntryMaxVel,
			    const_LreController_momEntryMinDist,
			    const_LreController_minSafeDist,
			    const_LreController_minTcpa,
			    const_LreController_highHorizVel,
			    const_LreController_staticObsHorizDist,
			    const_LreController_highVertVel,
			    const_LreController_staticObsVertDist,
			    const_LreController_staticObsDfltVertDist,
			    const_LreController_cpaEpsilon,
			    const_LreController_surfaceDepth) = 
		dbisim((MachineBody_VS_O(id__,
				    const_LreController_momEntryMaxVel,
				    const_LreController_momEntryMinDist,
				    const_LreController_minSafeDist,
				    const_LreController_minTcpa,
				    const_LreController_highHorizVel,
				    const_LreController_staticObsHorizDist,
				    const_LreController_highVertVel,
				    const_LreController_staticObsVertDist,
				    const_LreController_staticObsDfltVertDist,
				    const_LreController_cpaEpsilon,
				    const_LreController_surfaceDepth))
		)
	
	IteratedBehaviour_VS_O(id__,
			    const_LreController_momEntryMaxVel,
			    const_LreController_momEntryMinDist,
			    const_LreController_minSafeDist,
			    const_LreController_minTcpa,
			    const_LreController_highHorizVel,
			    const_LreController_staticObsHorizDist,
			    const_LreController_highVertVel,
			    const_LreController_staticObsVertDist,
			    const_LreController_staticObsDfltVertDist,
			    const_LreController_cpaEpsilon,
			    const_LreController_surfaceDepth) = 
		dbisim((MachineBody_VS_O(id__,
				    const_LreController_momEntryMaxVel,
				    const_LreController_momEntryMinDist,
				    const_LreController_minSafeDist,
				    const_LreController_minTcpa,
				    const_LreController_highHorizVel,
				    const_LreController_staticObsHorizDist,
				    const_LreController_highVertVel,
				    const_LreController_staticObsVertDist,
				    const_LreController_staticObsDfltVertDist,
				    const_LreController_cpaEpsilon,
				    const_LreController_surfaceDepth))
		)
	
	Stateful_VS_O(id__,
			    const_LreController_momEntryMaxVel,
			    const_LreController_momEntryMinDist,
			    const_LreController_minSafeDist,
			    const_LreController_minTcpa,
			    const_LreController_highHorizVel,
			    const_LreController_staticObsHorizDist,
			    const_LreController_highVertVel,
			    const_LreController_staticObsVertDist,
			    const_LreController_staticObsDfltVertDist,
			    const_LreController_cpaEpsilon,
			    const_LreController_surfaceDepth) = 
		dbisim((
			(Behaviour_VS_O(id__,
					    const_LreController_momEntryMaxVel,
					    const_LreController_momEntryMinDist,
					    const_LreController_minSafeDist,
					    const_LreController_minTcpa,
					    const_LreController_highHorizVel,
					    const_LreController_staticObsHorizDist,
					    const_LreController_highVertVel,
					    const_LreController_staticObsVertDist,
					    const_LreController_staticObsDfltVertDist,
					    const_LreController_cpaEpsilon,
					    const_LreController_surfaceDepth) [| union(getsetLocalChannels,{terminate}) |] varMemory(id__,
					    const_LreController_momEntryMaxVel,
					    const_LreController_momEntryMinDist,
					    const_LreController_minSafeDist,
					    const_LreController_minTcpa,
					    const_LreController_highHorizVel,
					    const_LreController_staticObsHorizDist,
					    const_LreController_highVertVel,
					    const_LreController_staticObsVertDist,
					    const_LreController_staticObsDfltVertDist,
					    const_LreController_cpaEpsilon,
					    const_LreController_surfaceDepth))
		 	\getsetLocalChannels
		)
		)
	
	IteratedStateful_VS_O(id__,
			    const_LreController_momEntryMaxVel,
			    const_LreController_momEntryMinDist,
			    const_LreController_minSafeDist,
			    const_LreController_minTcpa,
			    const_LreController_highHorizVel,
			    const_LreController_staticObsHorizDist,
			    const_LreController_highVertVel,
			    const_LreController_staticObsVertDist,
			    const_LreController_staticObsDfltVertDist,
			    const_LreController_cpaEpsilon,
			    const_LreController_surfaceDepth) =
		(dbisim(
			sbisim(
				Behaviour_VS_O(id__,
						    const_LreController_momEntryMaxVel,
						    const_LreController_momEntryMinDist,
						    const_LreController_minSafeDist,
						    const_LreController_minTcpa,
						    const_LreController_highHorizVel,
						    const_LreController_staticObsHorizDist,
						    const_LreController_highVertVel,
						    const_LreController_staticObsVertDist,
						    const_LreController_staticObsDfltVertDist,
						    const_LreController_cpaEpsilon,
						    const_LreController_surfaceDepth)
				[| {|get_v,set_v,terminate|} |]
				Memory_v(0)
			)\{|get_v,set_v|}
		)
		)
	
	-- END
	
	-- Memory
	-- Memory variables
	Memory_v(v) =
		get_v!v -> Memory_v(v)
		[]
		set_v?x__ -> Memory_v(x__)
		[]
		terminate -> SKIP
	
	-- varMemory process
	varMemory(id__,
			    const_LreController_momEntryMaxVel,
			    const_LreController_momEntryMinDist,
			    const_LreController_minSafeDist,
			    const_LreController_minTcpa,
			    const_LreController_highHorizVel,
			    const_LreController_staticObsHorizDist,
			    const_LreController_highVertVel,
			    const_LreController_staticObsVertDist,
			    const_LreController_staticObsDfltVertDist,
			    const_LreController_cpaEpsilon,
			    const_LreController_surfaceDepth) = Memory_v(0)
	
	getsetLocalChannels = {|get_v,set_v|}
	
	-- Definition of the behaviour of state machines (default, optimised, visible, visible and optimised)
	FVS__(id__,
			    const_LreController_momEntryMaxVel,
			    const_LreController_momEntryMinDist,
			    const_LreController_minSafeDist,
			    const_LreController_minTcpa,
			    const_LreController_highHorizVel,
			    const_LreController_staticObsHorizDist,
			    const_LreController_highVertVel,
			    const_LreController_staticObsVertDist,
			    const_LreController_staticObsDfltVertDist,
			    const_LreController_cpaEpsilon,
			    const_LreController_surfaceDepth) = STM_VS_O(id__,
			    const_LreController_momEntryMaxVel,
			    const_LreController_momEntryMinDist,
			    const_LreController_minSafeDist,
			    const_LreController_minTcpa,
			    const_LreController_highHorizVel,
			    const_LreController_staticObsHorizDist,
			    const_LreController_highVertVel,
			    const_LreController_staticObsVertDist,
			    const_LreController_staticObsDfltVertDist,
			    const_LreController_cpaEpsilon,
			    const_LreController_surfaceDepth)
	
	D__(id__,
			    const_LreController_momEntryMaxVel,
			    const_LreController_momEntryMinDist,
			    const_LreController_minSafeDist,
			    const_LreController_minTcpa,
			    const_LreController_highHorizVel,
			    const_LreController_staticObsHorizDist,
			    const_LreController_highVertVel,
			    const_LreController_staticObsVertDist,
			    const_LreController_staticObsDfltVertDist,
			    const_LreController_cpaEpsilon,
			    const_LreController_surfaceDepth) = STM(id__,
			    const_LreController_momEntryMaxVel,
			    const_LreController_momEntryMinDist,
			    const_LreController_minSafeDist,
			    const_LreController_minTcpa,
			    const_LreController_highHorizVel,
			    const_LreController_staticObsHorizDist,
			    const_LreController_highVertVel,
			    const_LreController_staticObsVertDist,
			    const_LreController_staticObsDfltVertDist,
			    const_LreController_cpaEpsilon,
			    const_LreController_surfaceDepth) \ internal_events
	O__(id__,
			    const_LreController_momEntryMaxVel,
			    const_LreController_momEntryMinDist,
			    const_LreController_minSafeDist,
			    const_LreController_minTcpa,
			    const_LreController_highHorizVel,
			    const_LreController_staticObsHorizDist,
			    const_LreController_highVertVel,
			    const_LreController_staticObsVertDist,
			    const_LreController_staticObsDfltVertDist,
			    const_LreController_cpaEpsilon,
			    const_LreController_surfaceDepth) = sbisim(diamond(D__(id__,
			    const_LreController_momEntryMaxVel,
			    const_LreController_momEntryMinDist,
			    const_LreController_minSafeDist,
			    const_LreController_minTcpa,
			    const_LreController_highHorizVel,
			    const_LreController_staticObsHorizDist,
			    const_LreController_highVertVel,
			    const_LreController_staticObsVertDist,
			    const_LreController_staticObsDfltVertDist,
			    const_LreController_cpaEpsilon,
			    const_LreController_surfaceDepth)))
	VS__(id__,
			    const_LreController_momEntryMaxVel,
			    const_LreController_momEntryMinDist,
			    const_LreController_minSafeDist,
			    const_LreController_minTcpa,
			    const_LreController_highHorizVel,
			    const_LreController_staticObsHorizDist,
			    const_LreController_highVertVel,
			    const_LreController_staticObsVertDist,
			    const_LreController_staticObsDfltVertDist,
			    const_LreController_cpaEpsilon,
			    const_LreController_surfaceDepth) = FVS__(id__,
			    const_LreController_momEntryMaxVel,
			    const_LreController_momEntryMinDist,
			    const_LreController_minSafeDist,
			    const_LreController_minTcpa,
			    const_LreController_highHorizVel,
			    const_LreController_staticObsHorizDist,
			    const_LreController_highVertVel,
			    const_LreController_staticObsVertDist,
			    const_LreController_staticObsDfltVertDist,
			    const_LreController_cpaEpsilon,
			    const_LreController_surfaceDepth)
	VS_O__(id__,
			    const_LreController_momEntryMaxVel,
			    const_LreController_momEntryMinDist,
			    const_LreController_minSafeDist,
			    const_LreController_minTcpa,
			    const_LreController_highHorizVel,
			    const_LreController_staticObsHorizDist,
			    const_LreController_highVertVel,
			    const_LreController_staticObsVertDist,
			    const_LreController_staticObsDfltVertDist,
			    const_LreController_cpaEpsilon,
			    const_LreController_surfaceDepth) = sbisim(diamond(FVS__(id__,
			    const_LreController_momEntryMaxVel,
			    const_LreController_momEntryMinDist,
			    const_LreController_minSafeDist,
			    const_LreController_minTcpa,
			    const_LreController_highHorizVel,
			    const_LreController_staticObsHorizDist,
			    const_LreController_highVertVel,
			    const_LreController_staticObsVertDist,
			    const_LreController_staticObsDfltVertDist,
			    const_LreController_cpaEpsilon,
			    const_LreController_surfaceDepth)))
	HEXT__(id__,
			    const_LreController_momEntryMaxVel,
			    const_LreController_momEntryMinDist,
			    const_LreController_minSafeDist,
			    const_LreController_minTcpa,
			    const_LreController_highHorizVel,
			    const_LreController_staticObsHorizDist,
			    const_LreController_highVertVel,
			    const_LreController_staticObsVertDist,
			    const_LreController_staticObsDfltVertDist,
			    const_LreController_cpaEpsilon,
			    const_LreController_surfaceDepth) = O__(id__,
			    const_LreController_momEntryMaxVel,
			    const_LreController_momEntryMinDist,
			    const_LreController_minSafeDist,
			    const_LreController_minTcpa,
			    const_LreController_highHorizVel,
			    const_LreController_staticObsHorizDist,
			    const_LreController_highVertVel,
			    const_LreController_staticObsVertDist,
			    const_LreController_staticObsDfltVertDist,
			    const_LreController_cpaEpsilon,
			    const_LreController_surfaceDepth) [|shared_variable_events|] SKIP
	HUP__(id__,
			    const_LreController_momEntryMaxVel,
			    const_LreController_momEntryMinDist,
			    const_LreController_minSafeDist,
			    const_LreController_minTcpa,
			    const_LreController_highHorizVel,
			    const_LreController_staticObsHorizDist,
			    const_LreController_highVertVel,
			    const_LreController_staticObsVertDist,
			    const_LreController_staticObsDfltVertDist,
			    const_LreController_cpaEpsilon,
			    const_LreController_surfaceDepth) = O__(id__,
			    const_LreController_momEntryMaxVel,
			    const_LreController_momEntryMinDist,
			    const_LreController_minSafeDist,
			    const_LreController_minTcpa,
			    const_LreController_highHorizVel,
			    const_LreController_staticObsHorizDist,
			    const_LreController_highVertVel,
			    const_LreController_staticObsVertDist,
			    const_LreController_staticObsDfltVertDist,
			    const_LreController_cpaEpsilon,
			    const_LreController_surfaceDepth) [|{share__}|] SKIP
	
	-- Shared memory
	-- Shared memory variables
	Memory_vel(vel) =
		get_vel!vel -> Memory_vel(vel)
		[]
		set_vel?x__ -> Memory_vel(x__)
		[]
		set_EXT_vel?x__ -> Memory_vel(x__)
		[]
		terminate -> SKIP
	Memory_inOpez(inOpez) =
		get_inOpez!inOpez -> Memory_inOpez(inOpez)
		[]
		set_inOpez?x__ -> Memory_inOpez(x__)
		[]
		set_EXT_inOpez?x__ -> Memory_inOpez(x__)
		[]
		terminate -> SKIP
	Memory_cdyn(cdyn) =
		get_cdyn!cdyn -> Memory_cdyn(cdyn)
		[]
		set_cdyn?x__ -> Memory_cdyn(x__)
		[]
		set_EXT_cdyn?x__ -> Memory_cdyn(x__)
		[]
		terminate -> SKIP
	Memory_cstc(cstc) =
		get_cstc!cstc -> Memory_cstc(cstc)
		[]
		set_cstc?x__ -> Memory_cstc(x__)
		[]
		set_EXT_cstc?x__ -> Memory_cstc(x__)
		[]
		terminate -> SKIP
	Memory_cda(cda) =
		get_cda!cda -> Memory_cda(cda)
		[]
		set_cda?x__ -> Memory_cda(x__)
		[]
		set_EXT_cda?x__ -> Memory_cda(x__)
		[]
		terminate -> SKIP
	Memory_tcpa(tcpa) =
		get_tcpa!tcpa -> Memory_tcpa(tcpa)
		[]
		set_tcpa?x__ -> Memory_tcpa(x__)
		[]
		set_EXT_tcpa?x__ -> Memory_tcpa(x__)
		[]
		terminate -> SKIP
	Memory_hvel(hvel) =
		get_hvel!hvel -> Memory_hvel(hvel)
		[]
		set_hvel?x__ -> Memory_hvel(x__)
		[]
		set_EXT_hvel?x__ -> Memory_hvel(x__)
		[]
		terminate -> SKIP
	Memory_vvel(vvel) =
		get_vvel!vvel -> Memory_vvel(vvel)
		[]
		set_vvel?x__ -> Memory_vvel(x__)
		[]
		set_EXT_vvel?x__ -> Memory_vvel(x__)
		[]
		terminate -> SKIP
	
	-- sharedVarMemory process
	sharedVarMemory(id__,
			    const_LreController_momEntryMaxVel,
			    const_LreController_momEntryMinDist,
			    const_LreController_minSafeDist,
			    const_LreController_minTcpa,
			    const_LreController_highHorizVel,
			    const_LreController_staticObsHorizDist,
			    const_LreController_highVertVel,
			    const_LreController_staticObsVertDist,
			    const_LreController_staticObsDfltVertDist,
			    const_LreController_cpaEpsilon,
			    const_LreController_surfaceDepth) = Memory_vel(0)
	[| { terminate } |] (
	Memory_inOpez(true)
	[| { terminate } |] (
	Memory_cdyn(0)
	[| { terminate } |] (
	Memory_cstc(0)
	[| { terminate } |] (
	Memory_cda(0)
	[| { terminate } |] (
	Memory_tcpa(0)
	[| { terminate } |] (
	Memory_hvel(0)
	[| { terminate } |] (
	Memory_vvel(0)
	)
	)
	)
	)
	)
	)
	)
	
	sharedVarSync = {|get_vel,set_vel,set_EXT_vel,get_inOpez,set_inOpez,set_EXT_inOpez,get_cdyn,set_cdyn,set_EXT_cdyn,get_cstc,set_cstc,set_EXT_cstc,get_cda,set_cda,set_EXT_cda,get_tcpa,set_tcpa,set_EXT_tcpa,get_hvel,set_hvel,set_EXT_hvel,get_vvel,set_vvel,set_EXT_vvel|}
	
	sharedVarHide = {|get_vel,get_inOpez,get_cdyn,get_cstc,get_cda,get_tcpa,get_hvel,get_vvel|}
endmodule
