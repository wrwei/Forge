						    const_CheckOPEZ_staticObsVertDist,
						    const_CheckOPEZ_staticObsDfltVertDist,
						    const_CheckOPEZ_cpaEpsilon) 
				 [| union(union(getsetLocalChannels,clockSync),{terminate}) |] 
				 (varMemory(id__,
				 		    const_CheckOPEZ_momEntryMaxVel,
				 		    const_CheckOPEZ_momEntryMinDist,
				 		    const_CheckOPEZ_minSafeDist,
				 		    const_CheckOPEZ_cautionVel,
				 		    const_CheckOPEZ_staticObsHorizDist,
				 		    const_CheckOPEZ_staticObsVertDist,
				 		    const_CheckOPEZ_staticObsDfltVertDist,
				 		    const_CheckOPEZ_cpaEpsilon) [| {terminate} |] Clocks(id__,
				 		          const_CheckOPEZ_momEntryMaxVel,
				 		          const_CheckOPEZ_momEntryMinDist,
				 		          const_CheckOPEZ_minSafeDist,
				 		          const_CheckOPEZ_cautionVel,
				 		          const_CheckOPEZ_staticObsHorizDist,
				 		          const_CheckOPEZ_staticObsVertDist,
				 		          const_CheckOPEZ_staticObsDfltVertDist,
				 		          const_CheckOPEZ_cpaEpsilon))
			 	)\union(getsetLocalChannels,clockSync)
			)
			)
		
		IteratedStateful_VS_O(id__,
				    const_CheckOPEZ_momEntryMaxVel,
				    const_CheckOPEZ_momEntryMinDist,
				    const_CheckOPEZ_minSafeDist,
				    const_CheckOPEZ_cautionVel,
				    const_CheckOPEZ_staticObsHorizDist,
				    const_CheckOPEZ_staticObsVertDist,
				    const_CheckOPEZ_staticObsDfltVertDist,
				    const_CheckOPEZ_cpaEpsilon) =
			(IteratedBehaviour_VS_O(id__,
					    const_CheckOPEZ_momEntryMaxVel,
					    const_CheckOPEZ_momEntryMinDist,
					    const_CheckOPEZ_minSafeDist,
					    const_CheckOPEZ_cautionVel,
					    const_CheckOPEZ_staticObsHorizDist,
					    const_CheckOPEZ_staticObsVertDist,
					    const_CheckOPEZ_staticObsDfltVertDist,
					    const_CheckOPEZ_cpaEpsilon))
		
		-- END
		
		-- Memory
		-- Memory variables
		
		-- varMemory process
		varMemory(id__,
				    const_CheckOPEZ_momEntryMaxVel,
				    const_CheckOPEZ_momEntryMinDist,
				    const_CheckOPEZ_minSafeDist,
				    const_CheckOPEZ_cautionVel,
				    const_CheckOPEZ_staticObsHorizDist,
				    const_CheckOPEZ_staticObsVertDist,
				    const_CheckOPEZ_staticObsDfltVertDist,
				    const_CheckOPEZ_cpaEpsilon) = terminate -> SKIP
		
		getsetLocalChannels = {||}
		
		-- Definition of the behaviour of state machines (default, optimised, visible, visible and optimised)
		FVS__(id__,
				    const_CheckOPEZ_momEntryMaxVel,
				    const_CheckOPEZ_momEntryMinDist,
				    const_CheckOPEZ_minSafeDist,
				    const_CheckOPEZ_cautionVel,
				    const_CheckOPEZ_staticObsHorizDist,
				    const_CheckOPEZ_staticObsVertDist,
				    const_CheckOPEZ_staticObsDfltVertDist,
				    const_CheckOPEZ_cpaEpsilon) = STM_VS_O(id__,
				    const_CheckOPEZ_momEntryMaxVel,
				    const_CheckOPEZ_momEntryMinDist,
				    const_CheckOPEZ_minSafeDist,
				    const_CheckOPEZ_cautionVel,
				    const_CheckOPEZ_staticObsHorizDist,
				    const_CheckOPEZ_staticObsVertDist,
				    const_CheckOPEZ_staticObsDfltVertDist,
				    const_CheckOPEZ_cpaEpsilon) \ localClockResets
		D__(id__,
				    const_CheckOPEZ_momEntryMaxVel,
				    const_CheckOPEZ_momEntryMinDist,
				    const_CheckOPEZ_minSafeDist,
				    const_CheckOPEZ_cautionVel,
				    const_CheckOPEZ_staticObsHorizDist,
				    const_CheckOPEZ_staticObsVertDist,
				    const_CheckOPEZ_staticObsDfltVertDist,
				    const_CheckOPEZ_cpaEpsilon) = timed_priority(STM(id__,
				    const_CheckOPEZ_momEntryMaxVel,
				    const_CheckOPEZ_momEntryMinDist,
				    const_CheckOPEZ_minSafeDist,
				    const_CheckOPEZ_cautionVel,
