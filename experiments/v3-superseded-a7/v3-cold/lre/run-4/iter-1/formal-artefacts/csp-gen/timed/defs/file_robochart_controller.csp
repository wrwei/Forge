			)
		
		IteratedBehaviour_VS_O(id__,
				    const_CalcCPA_momEntryMaxVel,
				    const_CalcCPA_momEntryMinDist,
				    const_CalcCPA_minSafeDist,
				    const_CalcCPA_cautionVel,
				    const_CalcCPA_staticObsHorizDist,
				    const_CalcCPA_staticObsVertDist,
				    const_CalcCPA_staticObsDfltVertDist,
				    const_CalcCPA_cpaEpsilon) = 
