			endmodule
-- compileSelfContainedOperation
module OP_CalcCStc
exports
	transparent diamond
	transparent sbisim
	transparent dbisim
	transparent chase

	-- Transition identifiers
	-- declaring identifiers of transitions
	datatype NIDS = 
	              NID_i0|
	              NID_f0
	
	channel internal__ : NIDS
	
	-- Flow channels		
	channel interrupt
	channel exited
	channel exit
	channel terminate
	
	-- Variable channels
	channel get_vel, set_vel, setL_vel, setR_vel: core_real
	channel get_inOpez, set_inOpez, setL_inOpez, setR_inOpez: core_boolean
	channel get_cdyn, set_cdyn, setL_cdyn, setR_cdyn: core_int
	channel get_cstc, set_cstc, setL_cstc, setR_cstc: core_int
	channel get_cda, set_cda, setL_cda, setR_cda: core_real
	channel get_tcpa, set_tcpa, setL_tcpa, setR_tcpa: core_real
	channel get_hvel, set_hvel, setL_hvel, setR_hvel: core_real
	channel get_vvel, set_vvel, setL_vvel, setR_vvel: core_real
	channel get_cpaTarget, set_cpaTarget, setL_cpaTarget, setR_cpaTarget: core_int
	channel get_relVelNs, set_relVelNs, setL_relVelNs, setR_relVelNs: core_real
	channel get_relVelEw, set_relVelEw, setL_relVelEw, setR_relVelEw: core_real
	channel get_opezTarget, set_opezTarget, setL_opezTarget, setR_opezTarget: core_int
	channel get_NO_OBSTACLE_DISTANCE, set_NO_OBSTACLE_DISTANCE, setL_NO_OBSTACLE_DISTANCE, setR_NO_OBSTACLE_DISTANCE: core_real
	channel get_depth, set_depth, setL_depth, setR_depth: core_real
	channel get_nsVel, set_nsVel, setL_nsVel, setR_nsVel: core_real
	channel get_ewVel, set_ewVel, setL_ewVel, setR_ewVel: core_real
	channel get_rateOfClimb, set_rateOfClimb, setL_rateOfClimb, setR_rateOfClimb: core_real
	channel get_closestDynamicIndex, set_closestDynamicIndex, setL_closestDynamicIndex, setR_closestDynamicIndex: core_int
	channel get_closestStaticIndex, set_closestStaticIndex, setL_closestStaticIndex, setR_closestStaticIndex: core_int
	
	-- Shared variable channels
	channel set_EXT_vel: core_real
	channel set_EXT_inOpez: core_boolean
	channel set_EXT_cdyn: core_int
	channel set_EXT_cstc: core_int
	channel set_EXT_cda: core_real
	channel set_EXT_tcpa: core_real
	channel set_EXT_hvel: core_real
	channel set_EXT_vvel: core_real
