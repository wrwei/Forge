				channel advVel: InOut.core_real
				channel advHdng__: NIDS.InOut.core_real
				channel advHdng: InOut.core_real
				
				-- Declaring call and ret events for undefined operations
				
				enterSS = {|
				MOM::enter,
				OCM::enter,
				HCM::enter,
				CAM::enter,
				i0::enter
				|}
				
				enteredSS = 	{|
				MOM::entered,
				OCM::entered,
				HCM::entered,
				CAM::entered
				|}
				
				internal_events = union(enteredSS,union(enterSS,{|interrupt,exited|}))
				
				shared_variable_events = {|
					set_EXT_vel,
					set_EXT_inOpez,
					set_EXT_cdyn,
					set_EXT_cstc,
					set_EXT_cda,
					set_EXT_tcpa,
					set_EXT_hvel,
					set_EXT_vvel,
					set_EXT_cpaTarget,
					set_EXT_relVelNs,
					set_EXT_relVelEw,
					set_EXT_opezTarget
				|}
				
