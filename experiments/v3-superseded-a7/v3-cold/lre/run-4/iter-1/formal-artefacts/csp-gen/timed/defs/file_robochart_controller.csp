				sem__events = {|
					terminate
				,	set_EXT_vel, set_vel,
					set_EXT_inOpez, set_inOpez,
					set_EXT_cdyn, set_cdyn,
					set_EXT_cstc, set_cstc,
					set_EXT_cda, set_cda,
					set_EXT_tcpa, set_tcpa,
					set_EXT_hvel, set_hvel,
					set_EXT_vvel, set_vvel,
