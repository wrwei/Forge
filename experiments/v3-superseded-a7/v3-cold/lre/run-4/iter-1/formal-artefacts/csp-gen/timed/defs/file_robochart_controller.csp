		----------------------------------------------------------------------
		-- Initial: i0
		module i0
		exports
		
			channel enter, interrupt
			
			Timed(OneStep) {
				D__(id__,
						    const_LreController_momEntryMaxVel,
						    const_LreController_momEntryMinDist,
						    const_LreController_minSafeDist,
						    const_LreController_cautionVel,
						    const_LreController_staticObsHorizDist,
						    const_LreController_staticObsVertDist,
						    const_LreController_staticObsDfltVertDist,
						    const_LreController_cpaEpsilon) = 
					dbisim(let
						Inactive 	= share__choice(enter -> SKIP [] terminate -> SKIP) ; Active
						
						Termination = terminate -> SKIP
						
						Active 		= share__choice(interrupt -> SKIP) ; Inactive
					within
						Inactive [| {terminate} |> SKIP)
				
				VS_O__(id__,
						    const_LreController_momEntryMaxVel,
						    const_LreController_momEntryMinDist,
						    const_LreController_minSafeDist,
						    const_LreController_cautionVel,
						    const_LreController_staticObsHorizDist,
						    const_LreController_staticObsVertDist,
						    const_LreController_staticObsDfltVertDist,
						    const_LreController_cpaEpsilon) = D__(id__,
						    const_LreController_momEntryMaxVel,
						    const_LreController_momEntryMinDist,
						    const_LreController_minSafeDist,
						    const_LreController_cautionVel,
						    const_LreController_staticObsHorizDist,
						    const_LreController_staticObsVertDist,
						    const_LreController_staticObsDfltVertDist,
						    const_LreController_cpaEpsilon)
			}
		
		endmodule
		----------------------------------------------------------------------
		
		-- END of Nodes --
		
		Timed(OneStep) {
		-- Operation calls --
		-- Only the undefined operations are declared here.
		-- If the state machine is in isolation, all required operations will be undefined.
		-- If it is in the context of a controller, the required operations not provided by the
		-- controller will be declared here, and the defined operations will be defined in the
		-- context of the Controller module, and therefore within scope of the state machine module.
		
		-- END of Operation calls --
	
		-- STM processes
		STM(id__,
				    const_LreController_momEntryMaxVel,
				    const_LreController_momEntryMinDist,
				    const_LreController_minSafeDist,
				    const_LreController_cautionVel,
				    const_LreController_staticObsHorizDist,
				    const_LreController_staticObsVertDist,
				    const_LreController_staticObsDfltVertDist,
				    const_LreController_cpaEpsilon) = -- RULE: [[stm:StateMachineDef]]_STM^nops : CSPProcess
		( 
			(
				(
					(IteratedStateful(id__,
							    const_LreController_momEntryMaxVel,
							    const_LreController_momEntryMinDist,
							    const_LreController_minSafeDist,
							    const_LreController_cautionVel,
							    const_LreController_staticObsHorizDist,
							    const_LreController_staticObsVertDist,
							    const_LreController_staticObsDfltVertDist,
							    const_LreController_cpaEpsilon) \ {terminate} ; share__choice(terminate -> SKIP))
				 	[[ share__ <- x__ | x__ <- {|set_EXT_vel,set_EXT_inOpez,set_EXT_cdyn,set_EXT_cstc,set_EXT_cda,set_EXT_tcpa,set_EXT_hvel,set_EXT_vvel,set_EXT_cpaTarget,set_EXT_relVelNs,set_EXT_relVelEw,set_EXT_opezTarget|} ]]
				)
			[| {share__} |]
			SKIP
			)
			[| union(sharedVarSync,{terminate}) |]
			dbisim(sharedVarMemory(id__,
					    const_LreController_momEntryMaxVel,
					    const_LreController_momEntryMinDist,
					    const_LreController_minSafeDist,
					    const_LreController_cautionVel,
					    const_LreController_staticObsHorizDist,
					    const_LreController_staticObsVertDist,
					    const_LreController_staticObsDfltVertDist,
					    const_LreController_cpaEpsilon))
		)\sharedVarHide
		
		STM_VS_O(id__,
				    const_LreController_momEntryMaxVel,
				    const_LreController_momEntryMinDist,
				    const_LreController_minSafeDist,
				    const_LreController_cautionVel,
				    const_LreController_staticObsHorizDist,
				    const_LreController_staticObsVertDist,
				    const_LreController_staticObsDfltVertDist,
				    const_LreController_cpaEpsilon) = -- RULE: [[stm:StateMachineDef]]_STM^nops : CSPProcess
		( 
			(
				(
					(IteratedStateful_VS_O(id__,
							    const_LreController_momEntryMaxVel,
							    const_LreController_momEntryMinDist,
							    const_LreController_minSafeDist,
							    const_LreController_cautionVel,
							    const_LreController_staticObsHorizDist,
							    const_LreController_staticObsVertDist,
							    const_LreController_staticObsDfltVertDist,
							    const_LreController_cpaEpsilon) \ {terminate} ; share__choice(terminate -> SKIP))
				 	[[ share__ <- x__ | x__ <- {|set_EXT_vel,set_EXT_inOpez,set_EXT_cdyn,set_EXT_cstc,set_EXT_cda,set_EXT_tcpa,set_EXT_hvel,set_EXT_vvel,set_EXT_cpaTarget,set_EXT_relVelNs,set_EXT_relVelEw,set_EXT_opezTarget|} ]]
				)
			[| {share__} |]
			SKIP
			)
			[| union(sharedVarSync,{terminate}) |]
			dbisim(sharedVarMemory(id__,
					    const_LreController_momEntryMaxVel,
					    const_LreController_momEntryMinDist,
					    const_LreController_minSafeDist,
					    const_LreController_cautionVel,
					    const_LreController_staticObsHorizDist,
					    const_LreController_staticObsVertDist,
					    const_LreController_staticObsDfltVertDist,
					    const_LreController_cpaEpsilon))
		)\sharedVarHide
		
		-- Transitions
		Transitions(id__,
				    const_LreController_momEntryMaxVel,
				    const_LreController_momEntryMinDist,
				    const_LreController_minSafeDist,
				    const_LreController_cautionVel,
				    const_LreController_staticObsHorizDist,
				    const_LreController_staticObsVertDist,
				    const_LreController_staticObsDfltVertDist,
				    const_LreController_cpaEpsilon) = ((let
			Trans = share__choice(get_vel?vel -> get_cdyn?cdyn -> get_hvel?hvel -> get_vvel?vvel -> get_tcpa?tcpa -> get_cda?cda -> get_inOpez?inOpez -> get_cstc?cstc -> TimeOut_1(
				 (share__ -> SKIP
				 [] dbisim((true)&(internal__!NID_i0 -> SKIP ;  ((SKIP ; OCM::enter -> SKIP))))
				 [] dbisim((true)&(reqVel__!NID_OCM.in?v:{v|v <- core_real, true} -> share__choice(set_v!v -> SKIP) ;  share__choice(exit -> SKIP) ; (share__choice(exited -> SKIP) ; share__choice(get_v?v -> true&(share__choice(advVel.out!v -> SKIP))) ; OCM::enter -> SKIP)))
				 [] dbisim((true)&(reqHdng__!NID_OCM.in?v:{v|v <- core_real, true} -> share__choice(set_v!v -> SKIP) ;  share__choice(exit -> SKIP) ; (share__choice(exited -> SKIP) ; share__choice(get_v?v -> true&(share__choice(advHdng.out!v -> SKIP))) ; OCM::enter -> SKIP)))
				 [] dbisim((((((vel<=const_LreController_momEntryMaxVel) and (not ((inOpez)))) and (odist(cdyn)>const_LreController_momEntryMinDist)) and (odist(cstc)>const_LreController_momEntryMinDist)))&(reqMOM__!NID_OCM.in -> SKIP ;  share__choice(exit -> SKIP) ; (share__choice(exited -> SKIP) ; SKIP ; MOM::enter -> SKIP)))
