							 	[[ share__ <- x__ | x__ <- {|set_EXT_vel,set_EXT_inOpez,set_EXT_cdyn,set_EXT_cstc,set_EXT_cda,set_EXT_tcpa,set_EXT_hvel,set_EXT_vvel,set_EXT_cpaTarget,set_EXT_relVelNs,set_EXT_relVelEw,set_EXT_opezTarget|} ]]
