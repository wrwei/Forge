		)
		
		stateClockSync = {|get_CLID_MOM,MOM::entered,get_CLID_HCM,HCM::entered,get_CLID_CAM,CAM::entered,get_CLID_OCM,OCM::entered|}
		
		-- Shared memory
		-- Shared memory variables
		Memory_vel(vel) =
			get_vel!vel -> Memory_vel(vel)
			[]
			set_vel?x__ -> Memory_vel(x__)
			[]
			set_EXT_vel?x__ -> Memory_vel(x__)
			[]
			terminate -> SKIP
		Memory_inOpez(inOpez) =
