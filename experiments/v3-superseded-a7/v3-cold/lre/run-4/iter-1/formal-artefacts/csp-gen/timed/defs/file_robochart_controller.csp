				-- Declaring call and ret events for undefined operations
				
				enterSS = {|
				i0::enter,
				f0::enter
				|}
				
				enteredSS = 	{|
				f0::entered
				|}
				
				internal_events = union(enteredSS,union(enterSS,{|interrupt,exited|}))
				
				shared_variable_events = {|
					set_EXT_vel,
					set_EXT_inOpez,
					set_EXT_cdyn,
					set_EXT_cstc,
					set_EXT_cda,
					set_EXT_tcpa,
					set_EXT_hvel,
					set_EXT_vvel,
					set_EXT_cpaTarget,
