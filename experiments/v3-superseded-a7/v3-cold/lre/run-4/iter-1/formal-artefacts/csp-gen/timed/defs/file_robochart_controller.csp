				channel get_relVelEw, set_relVelEw, setL_relVelEw, setR_relVelEw: core_real
				channel get_opezTarget, set_opezTarget, setL_opezTarget, setR_opezTarget: core_int
				
				-- Shared variable channels
				channel set_EXT_vel: core_real
				channel set_EXT_inOpez: core_boolean
				channel set_EXT_cdyn: core_int
				channel set_EXT_cstc: core_int
				channel set_EXT_cda: core_real
				channel set_EXT_tcpa: core_real
				channel set_EXT_hvel: core_real
				channel set_EXT_vvel: core_real
				channel set_EXT_cpaTarget: core_int
				channel set_EXT_relVelNs: core_real
				channel set_EXT_relVelEw: core_real
				channel set_EXT_opezTarget: core_int
				
				-- Local variable channels for defined operations that are required by the state machine
				
				-- Declaring state machine events
				channel reqVel__: NIDS.InOut.core_real
				channel reqVel: InOut.core_real
				channel reqHdng__: NIDS.InOut.core_real
				channel reqHdng: InOut.core_real
				channel reqMOM__: NIDS.InOut
				channel reqMOM: InOut
				channel reqOCM__: NIDS.InOut
				channel reqOCM: InOut
				channel endTask__: NIDS.InOut
				channel endTask: InOut
