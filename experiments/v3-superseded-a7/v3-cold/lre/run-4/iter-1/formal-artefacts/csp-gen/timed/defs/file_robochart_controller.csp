										    const_LreController_cpaEpsilon) \ {terminate} ; share__choice(terminate -> SKIP))
							 	[[ share__ <- x__ | x__ <- {|set_EXT_vel,set_EXT_inOpez,set_EXT_cdyn,set_EXT_cstc,set_EXT_cda,set_EXT_tcpa,set_EXT_hvel,set_EXT_vvel,set_EXT_cpaTarget,set_EXT_relVelNs,set_EXT_relVelEw,set_EXT_opezTarget|} ]]
							)
						[| {share__} |]
						SKIP
						)
						[| union(sharedVarSync,{terminate}) |]
						dbisim(sharedVarMemory(id__,
								    const_LreController_momEntryMaxVel,
								    const_LreController_momEntryMinDist,
								    const_LreController_minSafeDist,
								    const_LreController_cautionVel,
