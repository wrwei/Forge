							    const_LreController_staticObsVertDist,
							    const_LreController_staticObsDfltVertDist,
							    const_LreController_cpaEpsilon) = 
						dbisim((let
							stateClockSync = {|get_CLID_MOM,MOM::entered,get_CLID_HCM,HCM::entered,get_CLID_CAM,CAM::entered,get_CLID_OCM,OCM::entered|}
						 within
							(MachineBody(id__,
									    const_LreController_momEntryMaxVel,
