		set_EXT_vvel,
		set_EXT_cpaTarget,
		set_EXT_relVelNs,
		set_EXT_relVelEw,
		set_EXT_opezTarget
	|}
	
	-- channel set with all visible events
	sem__events = {|
		terminate
	,	set_EXT_vel, set_vel,
		set_EXT_inOpez, set_inOpez,
		set_EXT_cdyn, set_cdyn,
		set_EXT_cstc, set_cstc,
