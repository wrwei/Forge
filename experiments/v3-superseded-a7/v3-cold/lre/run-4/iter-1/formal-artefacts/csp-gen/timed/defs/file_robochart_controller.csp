									   		    const_LreController_cpaEpsilon)
									   )
									   )
									   )
									   )
									 )
									 [[MOM::interrupt <- x__ | x__ <- {|interrupt,reqOCM__.NID_MOM.in,internal__.NID_MOM,internal__.NID_MOM,endTask__.NID_MOM.in,reqHCM__.NID_MOM.in,internal__.NID_MOM,internal__.NID_MOM,internal__.NID_MOM|}]]
									 [[OCM::interrupt <- x__ | x__ <- {|interrupt,reqVel__.NID_OCM.in,reqHdng__.NID_OCM.in,reqMOM__.NID_OCM.in|}]]
									 [[HCM::interrupt <- x__ | x__ <- {|interrupt,reqOCM__.NID_HCM.in,internal__.NID_HCM,internal__.NID_HCM,internal__.NID_HCM|}]]
									 [[CAM::interrupt <- x__ | x__ <- {|interrupt,reqOCM__.NID_CAM.in,internal__.NID_CAM|}]]
									 [[i0::interrupt <- x__ | x__ <- {|internal__.NID_i0|}]]
									 )
									  [[ share__ <- x__ | x__ <- {| share__,setR_v |} ]] 
									  [[set_vel <- setL_vel,set_cdyn <- setL_cdyn,set_hvel <- setL_hvel,set_vvel <- setL_vvel,set_tcpa <- setL_tcpa,set_cda <- setL_cda,set_inOpez <- setL_inOpez,set_cstc <- setL_cstc]]
