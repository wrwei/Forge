						 [[OCM::interrupt <- x__ | x__ <- {|interrupt,reqVel__.NID_OCM.in,reqHdng__.NID_OCM.in,reqMOM__.NID_OCM.in|}]]
						 [[HCM::interrupt <- x__ | x__ <- {|interrupt,reqOCM__.NID_HCM.in,internal__.NID_HCM,internal__.NID_HCM,internal__.NID_HCM|}]]
