									)[[setL_vel <- set_vel,setL_cdyn <- set_cdyn,setL_hvel <- set_hvel,setL_vvel <- set_vvel,setL_tcpa <- set_tcpa,setL_cda <- set_cda,setL_inOpez <- set_inOpez,setL_cstc <- set_cstc]]
									 [[setR_v <- set_v]]
