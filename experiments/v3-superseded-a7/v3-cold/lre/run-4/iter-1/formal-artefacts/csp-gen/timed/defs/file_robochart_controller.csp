							    const_LreController_cpaEpsilon) = ((let
						Trans = share__choice(get_vel?vel -> get_cdyn?cdyn -> get_hvel?hvel -> get_vvel?vvel -> get_tcpa?tcpa -> get_cda?cda -> get_inOpez?inOpez -> get_cstc?cstc -> TimeOut_1(
							 (share__ -> SKIP
							 [] dbisim((true)&(internal__!NID_i0 -> SKIP ;  ((SKIP ; OCM::enter -> SKIP))))
							 [] dbisim((true)&(reqVel__!NID_OCM.in?v:{v|v <- core_real, true} -> share__choice(set_v!v -> SKIP) ;  share__choice(exit -> SKIP) ; (share__choice(exited -> SKIP) ; share__choice(get_v?v -> true&(share__choice(advVel.out!v -> SKIP))) ; OCM::enter -> SKIP)))
							 [] dbisim((true)&(reqHdng__!NID_OCM.in?v:{v|v <- core_real, true} -> share__choice(set_v!v -> SKIP) ;  share__choice(exit -> SKIP) ; (share__choice(exited -> SKIP) ; share__choice(get_v?v -> true&(share__choice(advHdng.out!v -> SKIP))) ; OCM::enter -> SKIP)))
							 [] dbisim((((((vel<=const_LreController_momEntryMaxVel) and (not ((inOpez)))) and (odist(cdyn)>const_LreController_momEntryMinDist)) and (odist(cstc)>const_LreController_momEntryMinDist)))&(reqMOM__!NID_OCM.in -> SKIP ;  share__choice(exit -> SKIP) ; (share__choice(exited -> SKIP) ; SKIP ; MOM::enter -> SKIP)))
							 [] dbisim((true)&(reqOCM__!NID_MOM.in -> SKIP ;  share__choice(exit -> SKIP) ; (share__choice(exited -> SKIP) ; SKIP ; OCM::enter -> SKIP)))
							 [] dbisim((((cda<const_LreController_minSafeDist) and (tcpa>=0)))&(internal__!NID_MOM -> SKIP ;  share__choice(exit -> SKIP) ; (share__choice(exited -> SKIP) ; SKIP ; CAM::enter -> SKIP)))
							 [] dbisim(((inOpez and (not ((((cda<const_LreController_minSafeDist) and (tcpa>=0)))))))&(internal__!NID_MOM -> SKIP ;  share__choice(exit -> SKIP) ; (share__choice(exited -> SKIP) ; SKIP ; OCM::enter -> SKIP)))
							 [] dbisim((((not ((((cda<const_LreController_minSafeDist) and (tcpa>=0))))) and (not ((inOpez)))))&(endTask__!NID_MOM.in -> SKIP ;  share__choice(exit -> SKIP) ; (share__choice(exited -> SKIP) ; true&(share__choice(advVel.out!0 -> SKIP)) ; OCM::enter -> SKIP)))
							 [] dbisim((((not ((((cda<const_LreController_minSafeDist) and (tcpa>=0))))) and (not ((inOpez)))))&(reqHCM__!NID_MOM.in -> SKIP ;  share__choice(exit -> SKIP) ; (share__choice(exited -> SKIP) ; SKIP ; HCM::enter -> SKIP)))
							 [] dbisim((((((hvel>=const_LreController_cautionVel) and (hdist(cstc)<=const_LreController_staticObsHorizDist)) and (not ((((cda<const_LreController_minSafeDist) and (tcpa>=0)))))) and (not ((inOpez)))))&(internal__!NID_MOM -> SKIP ;  share__choice(exit -> SKIP) ; (share__choice(exited -> SKIP) ; SKIP ; HCM::enter -> SKIP)))
							 [] dbisim(((((((vvel>=const_LreController_cautionVel) and (vdist(cstc)<=const_LreController_staticObsVertDist)) and (not ((((cda<const_LreController_minSafeDist) and (tcpa>=0)))))) and (not ((inOpez)))) and (not ((((hvel>=const_LreController_cautionVel) and (hdist(cstc)<=const_LreController_staticObsHorizDist)))))))&(internal__!NID_MOM -> SKIP ;  share__choice(exit -> SKIP) ; (share__choice(exited -> SKIP) ; SKIP ; HCM::enter -> SKIP)))
							 [] dbisim(((((((vdist(cstc)<=const_LreController_staticObsDfltVertDist) and (not ((((cda<const_LreController_minSafeDist) and (tcpa>=0)))))) and (not ((inOpez)))) and (not ((((hvel>=const_LreController_cautionVel) and (hdist(cstc)<=const_LreController_staticObsHorizDist)))))) and (not ((((vvel>=const_LreController_cautionVel) and (vdist(cstc)<=const_LreController_staticObsVertDist)))))))&(internal__!NID_MOM -> SKIP ;  share__choice(exit -> SKIP) ; (share__choice(exited -> SKIP) ; SKIP ; HCM::enter -> SKIP)))
							 [] dbisim((true)&(reqOCM__!NID_HCM.in -> SKIP ;  share__choice(exit -> SKIP) ; (share__choice(exited -> SKIP) ; SKIP ; OCM::enter -> SKIP)))
							 [] dbisim((((cda<const_LreController_minSafeDist) and (tcpa>=0)))&(internal__!NID_HCM -> SKIP ;  share__choice(exit -> SKIP) ; (share__choice(exited -> SKIP) ; SKIP ; CAM::enter -> SKIP)))
							 [] dbisim(((inOpez and (not ((((cda<const_LreController_minSafeDist) and (tcpa>=0)))))))&(internal__!NID_HCM -> SKIP ;  share__choice(exit -> SKIP) ; (share__choice(exited -> SKIP) ; SKIP ; OCM::enter -> SKIP)))
							 [] dbisim((((((not (((hdist(cstc)<=const_LreController_staticObsHorizDist)))) and (not (((vdist(cstc)<=const_LreController_staticObsVertDist))))) and (not ((((cda<const_LreController_minSafeDist) and (tcpa>=0)))))) and (not ((inOpez)))))&(internal__!NID_HCM -> SKIP ;  share__choice(exit -> SKIP) ; (share__choice(exited -> SKIP) ; SKIP ; MOM::enter -> SKIP)))
							 [] dbisim((true)&(reqOCM__!NID_CAM.in -> SKIP ;  share__choice(exit -> SKIP) ; (share__choice(exited -> SKIP) ; SKIP ; OCM::enter -> SKIP)))
							 [] dbisim(((not (((cda<const_LreController_minSafeDist)))))&(internal__!NID_CAM -> SKIP ;  share__choice(exit -> SKIP) ; (share__choice(exited -> SKIP) ; true&(share__choice(advVel.out!0 -> SKIP)) ; OCM::enter -> SKIP)))
							 []
							 (interrupt -> share__choice(exit -> SKIP) ; share__choice(exited -> terminate -> SKIP))
							 []
							 terminate -> SKIP
