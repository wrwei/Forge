				localClockResets = {||}
				
				
				channel get_CLID_MOM : core_clock_type 
				channel get_CLID_HCM : core_clock_type 
				channel get_CLID_CAM : core_clock_type 
				channel get_CLID_OCM : core_clock_type 
				--channel increment__
				
				CLID_MOM_clock_type(id__,
						          const_LreController_momEntryMaxVel,
						          const_LreController_momEntryMinDist,
						          const_LreController_minSafeDist,
						          const_LreController_cautionVel,
						          const_LreController_staticObsHorizDist,
						          const_LreController_staticObsVertDist,
						          const_LreController_staticObsDfltVertDist,
						          const_LreController_cpaEpsilon) = 
					let
						max = (clock_type_max(Union({
				{}
				}))+1)
					ctype = {0..max}
				within
					if member(max,core_clock_type) then ctype else error("core_clock_type is not wide enough")
				
