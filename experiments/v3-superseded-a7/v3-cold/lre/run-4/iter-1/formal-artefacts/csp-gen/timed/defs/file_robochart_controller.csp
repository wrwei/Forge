				    const_CheckOPEZ_staticObsDfltVertDist,
				    const_CheckOPEZ_cpaEpsilon) [|shared_variable_events|] SKIP
		FVS_C__(id__,
				    const_CheckOPEZ_momEntryMaxVel,
				    const_CheckOPEZ_momEntryMinDist,
				    const_CheckOPEZ_minSafeDist,
				    const_CheckOPEZ_cautionVel,
				    const_CheckOPEZ_staticObsHorizDist,
				    const_CheckOPEZ_staticObsVertDist,
				    const_CheckOPEZ_staticObsDfltVertDist,
				    const_CheckOPEZ_cpaEpsilon) = dbisim(timed_priority(STM(id__,
				    const_CheckOPEZ_momEntryMaxVel,
				    const_CheckOPEZ_momEntryMinDist,
				    const_CheckOPEZ_minSafeDist,
