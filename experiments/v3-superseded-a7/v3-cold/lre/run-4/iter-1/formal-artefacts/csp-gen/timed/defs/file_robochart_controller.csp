				    const_CheckOPEZ_staticObsHorizDist,
				    const_CheckOPEZ_staticObsVertDist,
				    const_CheckOPEZ_staticObsDfltVertDist,
				    const_CheckOPEZ_cpaEpsilon) \ internal_events))
		HUP__(id__,
				    const_CheckOPEZ_momEntryMaxVel,
				    const_CheckOPEZ_momEntryMinDist,
				    const_CheckOPEZ_minSafeDist,
				    const_CheckOPEZ_cautionVel,
				    const_CheckOPEZ_staticObsHorizDist,
				    const_CheckOPEZ_staticObsVertDist,
				    const_CheckOPEZ_staticObsDfltVertDist,
				    const_CheckOPEZ_cpaEpsilon) = timed_priority(O__(id__,
				    const_CheckOPEZ_momEntryMaxVel,
				    const_CheckOPEZ_momEntryMinDist,
				    const_CheckOPEZ_minSafeDist,
				    const_CheckOPEZ_cautionVel,
				    const_CheckOPEZ_staticObsHorizDist,
				    const_CheckOPEZ_staticObsVertDist,
				    const_CheckOPEZ_staticObsDfltVertDist,
				    const_CheckOPEZ_cpaEpsilon) [|{share__}|] SKIP)
		
		-- Clocks
		
		Clocks(id__,
				          const_CheckOPEZ_momEntryMaxVel,
				          const_CheckOPEZ_momEntryMinDist,
				          const_CheckOPEZ_minSafeDist,
				          const_CheckOPEZ_cautionVel,
				          const_CheckOPEZ_staticObsHorizDist,
				          const_CheckOPEZ_staticObsVertDist,
				          const_CheckOPEZ_staticObsDfltVertDist,
				          const_CheckOPEZ_cpaEpsilon) = terminate -> SKIP
		
		clockSync = {||}
		
		
		StateClocks(id__,
				          const_CheckOPEZ_momEntryMaxVel,
				          const_CheckOPEZ_momEntryMinDist,
				          const_CheckOPEZ_minSafeDist,
				          const_CheckOPEZ_cautionVel,
				          const_CheckOPEZ_staticObsHorizDist,
				          const_CheckOPEZ_staticObsVertDist,
