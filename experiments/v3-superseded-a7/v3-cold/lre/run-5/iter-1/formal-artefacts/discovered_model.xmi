  <spoon:CtClass name="Sensor">
    <comment xsi:type="spoon:CtJavaDoc" commentContent="The AUV's environmental data and the obstacle functions derived from it (LRE-DM5).&#xA;When no obstacle is stored at an index, the distance functions return a safe&#xA;large distance and the field accessors return zero."/>
    <modifier>PUBLIC</modifier>
    <modifier>FINAL</modifier>
