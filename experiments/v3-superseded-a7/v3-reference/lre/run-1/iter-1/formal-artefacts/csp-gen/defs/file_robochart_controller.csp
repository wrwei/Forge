	-- context of the Controller module, and therefore within scope of the state machine module.
	
	-- END of Operation calls --
	
	-- STM processes
	STM(id__) = -- RULE: [[stm:OperationDef]]_STM^nops : CSPProcess
	Stateful(id__) \ {terminate}
	
	STM_VS_O(id__) = -- RULE: [[stm:OperationDef]]_STM^nops : CSPProcess
	Stateful(id__) \ {terminate}
	
	-- Transitions
	Transitions(id__) = ((let
		Trans = (
			((share__ -> SKIP
			 [] dbisim((true)&(internal__!NID_i0 -> SKIP ;  ((share__choice(share__choice(get_ewVel?ewVel -> share__choice(get_nsVel?nsVel -> true & (share__choice(set_hvel!sqrt(Plus(Mult(nsVel, nsVel, core_real), Mult(ewVel, ewVel, core_real), core_real)) -> SKIP)))));share__choice(share__choice(get_rateOfClimb?rateOfClimb -> true & (share__choice(set_vvel!rateOfClimb -> SKIP))));share__choice(share__choice(get_hvel?hvel -> share__choice(get_vvel?vvel -> true & (share__choice(set_vel!sqrt(Plus(Mult(hvel, hvel, core_real), Mult(vvel, vvel, core_real), core_real)) -> SKIP))))) ; f0::enter -> SKIP))))
			 ) ; Trans)
			 []
			 (interrupt -> share__choice(exit -> SKIP) ; share__choice(exited -> terminate -> SKIP))
			 []
			 terminate -> SKIP
