		-- declaring machines
		module stm_ref0
		exports
			transparent diamond
			transparent sbisim
			transparent dbisim
			transparent chase
		
			-- Transition identifiers
			-- declaring identifiers of transitions
			datatype NIDS = 
			              NID_MOM|
			              NID_OCM|
			              NID_HCM|
			              NID_CAM|
			              NID_i0
			
			channel internal__ : NIDS
			
			-- Flow channels		
			channel interrupt
			channel exited
			channel exit
			channel terminate
			
			-- Variable channels
			channel get_v, set_v, setL_v, setR_v: core_real
			channel get_vel, set_vel, setL_vel, setR_vel: core_real
