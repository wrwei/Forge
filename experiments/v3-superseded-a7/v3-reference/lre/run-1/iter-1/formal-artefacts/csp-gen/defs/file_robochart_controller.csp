				set_EXT_closestStaticIndex
			|}
			
			-- channel set with all visible events
			sem__events = {|
				terminate
			,	set_EXT_vel, set_vel,
				set_EXT_inOpez, set_inOpez,
				set_EXT_cdyn, set_cdyn,
				set_EXT_cstc, set_cstc,
