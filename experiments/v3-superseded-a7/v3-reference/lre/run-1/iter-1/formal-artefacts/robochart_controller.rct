diagram LreController

datatype Obstacle {
	ns_rel_dist : real
	ew_rel_dist : real
	obs_depth : real
	obs_ns_vel : real
	obs_ew_vel : real
	obs_roc : real
}

function odist ( index : int ) : real { }
function hdist ( index : int ) : real { }
function vdist ( index : int ) : real { }
function nsRelDist ( index : int ) : real { }
function ewRelDist ( index : int ) : real { }
function obsNsVel ( index : int ) : real { }
function obsEwVel ( index : int ) : real { }
function sqrt ( x : real ) : real { }

interface Inputs {
	event reqVel : real
	event reqHdng : real
	event reqMOM
	event reqOCM
	event endTask
	event reqHCM
}

interface Outputs {
	event advVel : real
	event advHdng : real
}

interface Sensors {
	var NO_OBSTACLE_DIST : real
	var depth : real
	var nsVel : real
	var ewVel : real
	var rateOfClimb : real
	var closestDynamicIndex : int
	var closestStaticIndex : int
}

interface Actuators {
}

interface LreController_State {
	var vel : real
	var inOpez : boolean
	var cdyn : int
	var cstc : int
	var cda : real
	var tcpa : real
	var hvel : real
	var vvel : real
	var dynObsIndex : int
	var relNsDist : real
	var closingNsVel : real
	var relEwDist : real
	var closingEwVel : real
	var missNsDist : real
	var missEwDist : real
	var vertSep : real
}

interface Constants {
	const momEntryMaxVel : real = 1
	const momEntryMinObsDist : real = 1
	const minSafeDist : real = 1
	const hcmHorizVelLimit : real = 1
	const staticObsHorizDist : real = 1
	const hcmVertVelLimit : real = 1
	const staticObsVertDist : real = 1
	const staticObsDfltVertDist : real = 1
	const cpaSpeedSqEps : real = 1
	const opezSurfaceDepth : real = 0
}

operation CalcCDyn ( ) {
	requires LreController_State requires Sensors
	initial i0
	final f0
	transition t0 {
		from i0
		to f0
		action cdyn = closestDynamicIndex
	}
}

operation CalcCPA ( ) {
	requires LreController_State requires Sensors requires Constants
	initial i0
	final f0
	transition t0 {
		from i0
		to f0
		action dynObsIndex = closestDynamicIndex ; relNsDist = nsRelDist ( dynObsIndex ) ; relEwDist = ewRelDist ( dynObsIndex ) ; closingNsVel = nsVel - obsNsVel ( dynObsIndex ) ; closingEwVel = ewVel - obsEwVel ( dynObsIndex ) ; vertSep = vdist ( dynObsIndex ) ; tcpa = (relNsDist * closingNsVel + relEwDist * closingEwVel) / (closingNsVel * closingNsVel + closingEwVel * closingEwVel + cpaSpeedSqEps) ; missNsDist = relNsDist - closingNsVel * tcpa ; missEwDist = relEwDist - closingEwVel * tcpa ; cda = sqrt ( missNsDist * missNsDist + missEwDist * missEwDist + vertSep * vertSep )
	}
}

operation CalcCStc ( ) {
	requires LreController_State requires Sensors
	initial i0
	final f0
	transition t0 {
		from i0
		to f0
		action cstc = closestStaticIndex
	}
}

operation CalcVel ( ) {
	requires LreController_State requires Sensors
	initial i0
	final f0
	transition t0 {
		from i0
		to f0
		action hvel = sqrt ( nsVel * nsVel + ewVel * ewVel ) ; vvel = rateOfClimb ; vel = sqrt ( hvel * hvel + vvel * vvel )
	}
}

operation CheckOPEZ ( ) {
	requires LreController_State requires Sensors requires Constants
	initial i0
	final f0
	transition t0 {
		from i0
		to f0
		action inOpez = ( odist ( closestStaticIndex ) <= minSafeDist \/ depth <= opezSurfaceDepth )
	}
}

stm LreController {
	uses Inputs uses Outputs requires LreController_State requires Constants
	var v : real
	state MOM {
		entry advVel ! 1
	}
	state OCM {
	}
	state HCM {
		entry advVel ! 0
	}
	state CAM {
	}
	initial i0
	transition t_init {
		from i0
		to OCM
	}
	transition t1 {
		from OCM
		to OCM
		trigger reqVel ? v
		action advVel ! v
	}
	transition t2 {
		from OCM
		to OCM
		trigger reqHdng ? v
		action advHdng ! v
	}
	transition t3 {
		from OCM
		to MOM
		trigger reqMOM
		condition vel <= momEntryMaxVel /\ not ( inOpez ) /\ odist ( cdyn ) > momEntryMinObsDist /\ odist ( cstc ) > momEntryMinObsDist
	}
	transition t4 {
		from MOM
		to OCM
		trigger reqOCM
	}
	transition t5 {
		from MOM
		to OCM
		trigger endTask
		action advVel ! 0
	}
	transition t6 {
		from MOM
		to OCM
		condition inOpez
	}
	transition t7 {
		from MOM
		to CAM
		condition cda < minSafeDist /\ tcpa >= 0 /\ not ( inOpez )
	}
	transition t8 {
		from MOM
		to HCM
		condition hvel >= hcmHorizVelLimit /\ hdist ( cstc ) <= staticObsHorizDist /\ not ( inOpez ) /\ not ( cda < minSafeDist /\ tcpa >= 0 )
	}
	transition t9 {
		from MOM
		to HCM
		condition vvel >= hcmVertVelLimit /\ vdist ( cstc ) <= staticObsVertDist /\ not ( inOpez ) /\ not ( cda < minSafeDist /\ tcpa >= 0 ) /\ not ( hvel >= hcmHorizVelLimit /\ hdist ( cstc ) <= staticObsHorizDist )
	}
	transition t10 {
		from MOM
		to HCM
		condition vdist ( cstc ) <= staticObsDfltVertDist /\ not ( inOpez ) /\ not ( cda < minSafeDist /\ tcpa >= 0 ) /\ not ( hvel >= hcmHorizVelLimit /\ hdist ( cstc ) <= staticObsHorizDist ) /\ not ( vvel >= hcmVertVelLimit /\ vdist ( cstc ) <= staticObsVertDist )
	}
	transition t11 {
		from MOM
		to HCM
		trigger reqHCM
		condition not ( inOpez ) /\ not ( cda < minSafeDist /\ tcpa >= 0 ) /\ not ( hvel >= hcmHorizVelLimit /\ hdist ( cstc ) <= staticObsHorizDist ) /\ not ( vvel >= hcmVertVelLimit /\ vdist ( cstc ) <= staticObsVertDist ) /\ not ( vdist ( cstc ) <= staticObsDfltVertDist )
	}
	transition t12 {
		from HCM
		to OCM
		trigger reqOCM
	}
	transition t13 {
		from HCM
		to OCM
		condition inOpez
	}
	transition t14 {
		from HCM
		to CAM
		condition cda < minSafeDist /\ tcpa >= 0 /\ not ( inOpez )
	}
	transition t15 {
		from HCM
		to MOM
		condition not ( hdist ( cstc ) <= staticObsHorizDist ) /\ not ( vdist ( cstc ) <= staticObsVertDist ) /\ not ( inOpez ) /\ not ( cda < minSafeDist /\ tcpa >= 0 )
	}
	transition t16 {
		from CAM
		to OCM
		trigger reqOCM
	}
	transition t17 {
		from CAM
		to OCM
		condition not ( cda < minSafeDist )
		action advVel ! 0
	}
}

controller LreController_Ctrl {
	uses Inputs uses Outputs requires LreController_State requires Constants requires Sensors
	sref stm_ref0 = LreController
	opref op_ref0 = CalcCDyn
	opref op_ref1 = CalcCPA
	opref op_ref2 = CalcCStc
	opref op_ref3 = CalcVel
	opref op_ref4 = CheckOPEZ
	connection LreController_Ctrl on reqVel to stm_ref0 on reqVel
	connection LreController_Ctrl on reqHdng to stm_ref0 on reqHdng
	connection LreController_Ctrl on reqMOM to stm_ref0 on reqMOM
	connection LreController_Ctrl on reqOCM to stm_ref0 on reqOCM
	connection LreController_Ctrl on endTask to stm_ref0 on endTask
	connection LreController_Ctrl on reqHCM to stm_ref0 on reqHCM
	connection stm_ref0 on advVel to LreController_Ctrl on advVel
	connection stm_ref0 on advHdng to LreController_Ctrl on advHdng
}

module LreController_Module {
	robotic platform LreController_Platform {
		provides Sensors provides Actuators provides Constants
		event reqVel : real
		event reqHdng : real
		event reqMOM
		event reqOCM
		event endTask
		event reqHCM
		event advVel : real
		event advHdng : real
	}
	cref ctrl_ref0 = LreController_Ctrl
	connection LreController_Platform on reqVel to ctrl_ref0 on reqVel
	connection LreController_Platform on reqHdng to ctrl_ref0 on reqHdng
	connection LreController_Platform on reqMOM to ctrl_ref0 on reqMOM
	connection LreController_Platform on reqOCM to ctrl_ref0 on reqOCM
	connection LreController_Platform on endTask to ctrl_ref0 on endTask
	connection LreController_Platform on reqHCM to ctrl_ref0 on reqHCM
	connection ctrl_ref0 on advVel to LreController_Platform on advVel
	connection ctrl_ref0 on advHdng to LreController_Platform on advHdng
}

