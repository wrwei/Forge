module OP_CalcCStc
exports
	transparent diamond
	transparent sbisim
	transparent dbisim
	transparent chase

	-- Transition identifiers
	-- declaring identifiers of transitions
	datatype NIDS = 
	              NID_i0|
	              NID_f0
	
	channel internal__ : NIDS
	
	-- Flow channels		
	channel interrupt
	channel exited
	channel exit
	channel terminate
	
	-- Variable channels
	channel get_vel, set_vel, setL_vel, setR_vel: core_real
	channel get_inOpez, set_inOpez, setL_inOpez, setR_inOpez: core_boolean
	channel get_cdyn, set_cdyn, setL_cdyn, setR_cdyn: core_int
	channel get_cstc, set_cstc, setL_cstc, setR_cstc: core_int
	channel get_cda, set_cda, setL_cda, setR_cda: core_real
	channel get_tcpa, set_tcpa, setL_tcpa, setR_tcpa: core_real
	channel get_hvel, set_hvel, setL_hvel, setR_hvel: core_real
	channel get_vvel, set_vvel, setL_vvel, setR_vvel: core_real
	channel get_dynamicIndex, set_dynamicIndex, setL_dynamicIndex, setR_dynamicIndex: core_int
	channel get_closingNsVel, set_closingNsVel, setL_closingNsVel, setR_closingNsVel: core_real
	channel get_closingEwVel, set_closingEwVel, setL_closingEwVel, setR_closingEwVel: core_real
	channel get_missNs, set_missNs, setL_missNs, setR_missNs: core_real
	channel get_missEw, set_missEw, setL_missEw, setR_missEw: core_real
	channel get_staticIndex, set_staticIndex, setL_staticIndex, setR_staticIndex: core_int
	channel get_aheadTime, set_aheadTime, setL_aheadTime, setR_aheadTime: core_real
	channel get_SAFE_LARGE_DISTANCE, set_SAFE_LARGE_DISTANCE, setL_SAFE_LARGE_DISTANCE, setR_SAFE_LARGE_DISTANCE: core_real
	channel get_depth, set_depth, setL_depth, setR_depth: core_real
	channel get_nsVel, set_nsVel, setL_nsVel, setR_nsVel: core_real
	channel get_ewVel, set_ewVel, setL_ewVel, setR_ewVel: core_real
	channel get_rateOfClimb, set_rateOfClimb, setL_rateOfClimb, setR_rateOfClimb: core_real
	channel get_closestDynamicIndex, set_closestDynamicIndex, setL_closestDynamicIndex, setR_closestDynamicIndex: core_int
	channel get_closestStaticIndex, set_closestStaticIndex, setL_closestStaticIndex, setR_closestStaticIndex: core_int
	
	-- Shared variable channels
	channel set_EXT_vel: core_real
	channel set_EXT_inOpez: core_boolean
	channel set_EXT_cdyn: core_int
	channel set_EXT_cstc: core_int
	channel set_EXT_cda: core_real
	channel set_EXT_tcpa: core_real
	channel set_EXT_hvel: core_real
	channel set_EXT_vvel: core_real
	channel set_EXT_dynamicIndex: core_int
	channel set_EXT_closingNsVel: core_real
	channel set_EXT_closingEwVel: core_real
	channel set_EXT_missNs: core_real
	channel set_EXT_missEw: core_real
	channel set_EXT_staticIndex: core_int
	channel set_EXT_aheadTime: core_real
	channel set_EXT_SAFE_LARGE_DISTANCE: core_real
	channel set_EXT_depth: core_real
	channel set_EXT_nsVel: core_real
	channel set_EXT_ewVel: core_real
	channel set_EXT_rateOfClimb: core_real
	channel set_EXT_closestDynamicIndex: core_int
	channel set_EXT_closestStaticIndex: core_int
	
	-- Local variable channels for defined operations that are required by the state machine
	
	-- Declaring state machine events
	
	-- Declaring call and ret events for undefined operations
	
	enterSS = {|
	i0::enter,
	f0::enter
	|}
	
	enteredSS = 	{|
	f0::entered
	|}
	
	internal_events = union(enteredSS,union(enterSS,{|interrupt,exited|}))
	
	shared_variable_events = {|
		set_EXT_vel,
		set_EXT_inOpez,
		set_EXT_cdyn,
		set_EXT_cstc,
		set_EXT_cda,
		set_EXT_tcpa,
		set_EXT_hvel,
		set_EXT_vvel,
		set_EXT_dynamicIndex,
		set_EXT_closingNsVel,
		set_EXT_closingEwVel,
		set_EXT_missNs,
		set_EXT_missEw,
		set_EXT_staticIndex,
		set_EXT_aheadTime,
		set_EXT_SAFE_LARGE_DISTANCE,
		set_EXT_depth,
		set_EXT_nsVel,
		set_EXT_ewVel,
		set_EXT_rateOfClimb,
		set_EXT_closestDynamicIndex,
		set_EXT_closestStaticIndex
	|}
	
	-- channel set with all visible events
	sem__events = {|
		terminate
	,	set_EXT_vel, set_vel,
		set_EXT_inOpez, set_inOpez,
		set_EXT_cdyn, set_cdyn,
		set_EXT_cstc, set_cstc,
		set_EXT_cda, set_cda,
		set_EXT_tcpa, set_tcpa,
		set_EXT_hvel, set_hvel,
		set_EXT_vvel, set_vvel,
		set_EXT_dynamicIndex, set_dynamicIndex,
		set_EXT_closingNsVel, set_closingNsVel,
		set_EXT_closingEwVel, set_closingEwVel,
		set_EXT_missNs, set_missNs,
		set_EXT_missEw, set_missEw,
		set_EXT_staticIndex, set_staticIndex,
		set_EXT_aheadTime, set_aheadTime,
		set_EXT_SAFE_LARGE_DISTANCE, set_SAFE_LARGE_DISTANCE,
		set_EXT_depth, set_depth,
		set_EXT_nsVel, set_nsVel,
		set_EXT_ewVel, set_ewVel,
		set_EXT_rateOfClimb, set_rateOfClimb,
		set_EXT_closestDynamicIndex, set_closestDynamicIndex,
		set_EXT_closestStaticIndex, set_closestStaticIndex
		, share__
		|}
	
	-- Nodes --
	-- declaring all nodes
	
	----------------------------------------------------------------------
	-- Initial: i0
	module i0
	exports
	
		channel enter, interrupt
		
		D__(id__) = 
			dbisim(let
				Inactive 	= share__choice(enter -> SKIP [] terminate -> SKIP) ; Active
				
				Termination = terminate -> SKIP
				
				Active 		= share__choice(interrupt -> SKIP) ; Inactive
			within
				Inactive [| {terminate} |> SKIP)
		
		VS_O__(id__) = D__(id__)
	
	endmodule
	----------------------------------------------------------------------
	
	
	----------------------------------------------------------------------
	-- Final state: f0
	module f0
	
	exports
	
		channel enter, entered, interrupt
		channel enteredL, enteredR
		
		--	Rule: behaviours(Node)
		D__(id__) = 
			dbisim(let
				Inactive 	= share__choice(enter -> SKIP [] terminate -> SKIP) ; Entering
				
				Entering 	= entered -> SKIP ; Active
				Active		= share__choice(terminate -> SKIP [] interrupt -> SKIP) ; Interrupted
				Interrupted	= share__choice(exit -> exited -> Inactive)
			within
				Inactive [| {terminate} |> SKIP)
			
		VS_O__(id__) = D__(id__)
	
	endmodule
	----------------------------------------------------------------------
	
	-- END of Nodes --
	
	-- Operation calls --
	-- Only the undefined operations are declared here.
	-- If the state machine is in isolation, all required operations will be undefined.
	-- If it is in the context of a controller, the required operations not provided by the
	-- controller will be declared here, and the defined operations will be defined in the
	-- context of the Controller module, and therefore within scope of the state machine module.
	
	-- END of Operation calls --
	
	-- STM processes
	STM(id__) = -- RULE: [[stm:OperationDef]]_STM^nops : CSPProcess
	Stateful(id__) \ {terminate}
	
	STM_VS_O(id__) = -- RULE: [[stm:OperationDef]]_STM^nops : CSPProcess
	Stateful(id__) \ {terminate}
	
	-- Transitions
	Transitions(id__) = ((let
		Trans = (
			((share__ -> SKIP
			 [] dbisim((true)&(internal__!NID_i0 -> SKIP ;  ((share__choice(share__choice(get_closestStaticIndex?closestStaticIndex -> true & (share__choice(set_cstc!closestStaticIndex -> SKIP)))) ; f0::enter -> SKIP))))
			 ) ; Trans)
			 []
			 (interrupt -> share__choice(exit -> SKIP) ; share__choice(exited -> terminate -> SKIP))
			 []
			 terminate -> SKIP
		)
	within
		Trans
	)
	)
	
	-- Stateful
	-- RULE: Stateful(stm:StateMachineBody) : CSPProcess
	
	-- Named process definitions
	MachineBody(id__) = 
		dbisim((
		let
			finalNodesEntered = {|f0::entered|}
		within
			((let
				-- IMPLEMENTATION NOTE:
				-- Here the 'enter' channel set is calculated explicitly because of the use of CSPM 
				-- modules for defining the semantics of each node.
				enterSS = {|
				i0::enter,
				f0::enter
				|}
				hideSet = union(enterSS,{|exit,exited,internal__|})
			within 
				((let
					-- IMPLEMENTATION NOTE: the channel set 'enter' is calculated explicitly
					-- because CSPM modules are used for the semantics of Node.
					flowevts = union(enterSS,{|exit,exited,interrupt|})
					transSync = {|internal__.NID_i0|}
				within
					((
					 (((-- RULE composeNodes(nc:NodeContainer)^nops : CSPProcess
					   i0::D__(id__)
					   [| { share__, terminate } |] (
					   f0::D__(id__)
					   )
					 )
					 [[f0::interrupt <- x__ | x__ <- {|interrupt|}]]
					 [[i0::interrupt <- x__ | x__ <- {|internal__.NID_i0|}]]
					 )
					  [[ share__ <- x__ | x__ <- {| share__ |} ]] 
					 )
					 [| union(union(union(flowevts,transSync),{terminate}),{|share__
					|}) |]
					 ((i0::enter -> Transitions(id__))
					  [[ share__ <- x__ | x__ <- {| share__ |} ]]
					 )
					)
					)
				)
				 \ hideSet)
			)
			 [| {| interrupt |} |] SKIP)
		)
		)
	
	Behaviour(id__) = 
		dbisim((MachineBody(id__)\ enteredSS)
		)
	
	IteratedBehaviour(id__) = 
		dbisim((MachineBody(id__)\ enteredSS)
		)
	
	Stateful(id__) = 
		((
			(Behaviour(id__) [| union(getsetLocalChannels,{terminate}) |] varMemory(id__))
		 	\getsetLocalChannels
		)
		)
	
	IteratedStateful(id__) =
		(Behaviour(id__))
	
	-- Visible counterparts
	MachineBody_VS_O(id__) = 
		dbisim((
		let
			finalNodesEntered = {|f0::entered|}
		within
			((let
				-- IMPLEMENTATION NOTE:
				-- Here the 'enter' channel set is calculated explicitly because of the use of CSPM 
				-- modules for defining the semantics of each node.
				enterSS = {|
				i0::enter,
				f0::enter
				|}
				hideSet = union(enterSS,{|exit,exited,internal__|})
			within 
				((let
					-- IMPLEMENTATION NOTE: the channel set 'enter' is calculated explicitly
					-- because CSPM modules are used for the semantics of Node.
					flowevts = union(enterSS,{|exit,exited,interrupt|})
					transSync = {|internal__.NID_i0|}
				within
					((
					 (((-- RULE composeNodes(nc:NodeContainer)^nops : CSPProcess
					   i0::VS_O__(id__)
					   [| { share__, terminate } |] (
					   f0::VS_O__(id__)
					   )
					 )
					 [[f0::interrupt <- x__ | x__ <- {|interrupt|}]]
					 [[i0::interrupt <- x__ | x__ <- {|internal__.NID_i0|}]]
					 )
					  [[ share__ <- x__ | x__ <- {| share__ |} ]] 
					 )
					 [| union(union(union(flowevts,transSync),{terminate}),{|share__
					|}) |]
					 ((i0::enter -> Transitions(id__))
					  [[ share__ <- x__ | x__ <- {| share__ |} ]]
					 )
					)
					)
				)
				 \ hideSet)
			)
			 [| {| interrupt |} |] SKIP)
		)
		)
	
	Behaviour_VS_O(id__) = 
		dbisim((MachineBody_VS_O(id__))
		)
	
	IteratedBehaviour_VS_O(id__) = 
		dbisim((MachineBody_VS_O(id__))
		)
	
	Stateful_VS_O(id__) = 
		dbisim((
			(Behaviour_VS_O(id__) [| union(getsetLocalChannels,{terminate}) |] varMemory(id__))
		 	\getsetLocalChannels
		)
		)
	
	IteratedStateful_VS_O(id__) =
		(Behaviour_VS_O(id__))
	
	-- END
	
	-- Memory
	-- Memory variables
	
	-- varMemory process
	varMemory(id__) = terminate -> SKIP
	
	getsetLocalChannels = {||}
	
	-- Definition of the behaviour of state machines (default, optimised, visible, visible and optimised)
	FVS__(id__) = STM_VS_O(id__)
	
	D__(id__) = STM(id__) \ internal_events
	O__(id__) = sbisim(diamond(D__(id__)))
	VS__(id__) = FVS__(id__)
	VS_O__(id__) = sbisim(diamond(FVS__(id__)))
	HEXT__(id__) = O__(id__) [|shared_variable_events|] SKIP
	HUP__(id__) = O__(id__) [|{share__}|] SKIP
			endmodule
