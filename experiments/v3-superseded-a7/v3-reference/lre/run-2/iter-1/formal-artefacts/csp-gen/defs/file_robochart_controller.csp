						 	 [] dbisim((((not ((inOpez))) and (not ((((cda<const_LreController_minSafeDist) and (tcpa>=0)))))))&(endTask__!NID_MOM.in -> SKIP ;  share__choice(exit -> SKIP) ; (share__choice(exited -> SKIP) ; true&(share__choice(advVel.out!0 -> SKIP)) ; OCM::enter -> SKIP)))
						 	 [] dbisim((((not ((inOpez))) and (not ((((cda<const_LreController_minSafeDist) and (tcpa>=0)))))))&(reqHCM__!NID_MOM.in -> SKIP ;  share__choice(exit -> SKIP) ; (share__choice(exited -> SKIP) ; SKIP ; HCM::enter -> SKIP)))
						 	 [] dbisim((((((hvel>=1) and (hdist(cstc)<=const_LreController_staticObsHorizDist)) and (not ((inOpez)))) and (not ((((cda<const_LreController_minSafeDist) and (tcpa>=0)))))))&(internal__!NID_MOM -> SKIP ;  share__choice(exit -> SKIP) ; (share__choice(exited -> SKIP) ; SKIP ; HCM::enter -> SKIP)))
						 	 [] dbisim(((((((vvel>=1) and (vdist(cstc)<=const_LreController_staticObsVertDist)) and (not ((inOpez)))) and (not ((((cda<const_LreController_minSafeDist) and (tcpa>=0)))))) and (not ((((hvel>=1) and (hdist(cstc)<=const_LreController_staticObsHorizDist)))))))&(internal__!NID_MOM -> SKIP ;  share__choice(exit -> SKIP) ; (share__choice(exited -> SKIP) ; SKIP ; HCM::enter -> SKIP)))
						 	 [] dbisim(((((((vdist(cstc)<=const_LreController_staticObsDfltVertDist) and (not ((inOpez)))) and (not ((((cda<const_LreController_minSafeDist) and (tcpa>=0)))))) and (not ((((hvel>=1) and (hdist(cstc)<=const_LreController_staticObsHorizDist)))))) and (not ((((vvel>=1) and (vdist(cstc)<=const_LreController_staticObsVertDist)))))))&(internal__!NID_MOM -> SKIP ;  share__choice(exit -> SKIP) ; (share__choice(exited -> SKIP) ; SKIP ; HCM::enter -> SKIP)))
