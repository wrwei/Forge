				    const_CheckOPEZ_staticObsDfltVertDist,
				    const_CheckOPEZ_cpaEpsilon)\ enteredSS)
		)
	
	IteratedBehaviour(id__,
			    const_CheckOPEZ_minSafeDist,
			    const_CheckOPEZ_staticObsHorizDist,
			    const_CheckOPEZ_staticObsVertDist,
			    const_CheckOPEZ_staticObsDfltVertDist,
			    const_CheckOPEZ_cpaEpsilon) = 
		dbisim((MachineBody(id__,
				    const_CheckOPEZ_minSafeDist,
				    const_CheckOPEZ_staticObsHorizDist,
				    const_CheckOPEZ_staticObsVertDist,
				    const_CheckOPEZ_staticObsDfltVertDist,
				    const_CheckOPEZ_cpaEpsilon)\ enteredSS)
		)
	
	Stateful(id__,
			    const_CheckOPEZ_minSafeDist,
			    const_CheckOPEZ_staticObsHorizDist,
			    const_CheckOPEZ_staticObsVertDist,
			    const_CheckOPEZ_staticObsDfltVertDist,
			    const_CheckOPEZ_cpaEpsilon) = 
		((
			(Behaviour(id__,
					    const_CheckOPEZ_minSafeDist,
					    const_CheckOPEZ_staticObsHorizDist,
					    const_CheckOPEZ_staticObsVertDist,
					    const_CheckOPEZ_staticObsDfltVertDist,
					    const_CheckOPEZ_cpaEpsilon) [| union(getsetLocalChannels,{terminate}) |] varMemory(id__,
					    const_CheckOPEZ_minSafeDist,
					    const_CheckOPEZ_staticObsHorizDist,
					    const_CheckOPEZ_staticObsVertDist,
					    const_CheckOPEZ_staticObsDfltVertDist,
					    const_CheckOPEZ_cpaEpsilon))
		 	\getsetLocalChannels
		)
		)
	
	IteratedStateful(id__,
			    const_CheckOPEZ_minSafeDist,
			    const_CheckOPEZ_staticObsHorizDist,
			    const_CheckOPEZ_staticObsVertDist,
			    const_CheckOPEZ_staticObsDfltVertDist,
			    const_CheckOPEZ_cpaEpsilon) =
		(Behaviour(id__,
				    const_CheckOPEZ_minSafeDist,
				    const_CheckOPEZ_staticObsHorizDist,
				    const_CheckOPEZ_staticObsVertDist,
				    const_CheckOPEZ_staticObsDfltVertDist,
				    const_CheckOPEZ_cpaEpsilon))
	
	-- Visible counterparts
	MachineBody_VS_O(id__,
			    const_CheckOPEZ_minSafeDist,
			    const_CheckOPEZ_staticObsHorizDist,
			    const_CheckOPEZ_staticObsVertDist,
			    const_CheckOPEZ_staticObsDfltVertDist,
			    const_CheckOPEZ_cpaEpsilon) = 
		dbisim((
		let
			finalNodesEntered = {|f0::entered|}
		within
			((let
				-- IMPLEMENTATION NOTE:
				-- Here the 'enter' channel set is calculated explicitly because of the use of CSPM 
				-- modules for defining the semantics of each node.
				enterSS = {|
				i0::enter,
				f0::enter
				|}
				hideSet = union(enterSS,{|exit,exited,internal__|})
			within 
				((let
					-- IMPLEMENTATION NOTE: the channel set 'enter' is calculated explicitly
					-- because CSPM modules are used for the semantics of Node.
					flowevts = union(enterSS,{|exit,exited,interrupt|})
					transSync = {|internal__.NID_i0|}
				within
					((
					 (((-- RULE composeNodes(nc:NodeContainer)^nops : CSPProcess
					   i0::VS_O__(id__,
					   		    const_CheckOPEZ_minSafeDist,
					   		    const_CheckOPEZ_staticObsHorizDist,
					   		    const_CheckOPEZ_staticObsVertDist,
					   		    const_CheckOPEZ_staticObsDfltVertDist,
					   		    const_CheckOPEZ_cpaEpsilon)
					   [| { share__, terminate } |] (
					   f0::VS_O__(id__,
					   		    const_CheckOPEZ_minSafeDist,
					   		    const_CheckOPEZ_staticObsHorizDist,
					   		    const_CheckOPEZ_staticObsVertDist,
					   		    const_CheckOPEZ_staticObsDfltVertDist,
					   		    const_CheckOPEZ_cpaEpsilon)
					   )
					 )
					 [[f0::interrupt <- x__ | x__ <- {|interrupt|}]]
					 [[i0::interrupt <- x__ | x__ <- {|internal__.NID_i0|}]]
					 )
					  [[ share__ <- x__ | x__ <- {| share__ |} ]] 
					 )
					 [| union(union(union(flowevts,transSync),{terminate}),{|share__
					|}) |]
					 ((i0::enter -> Transitions(id__,
					 		    const_CheckOPEZ_minSafeDist,
					 		    const_CheckOPEZ_staticObsHorizDist,
					 		    const_CheckOPEZ_staticObsVertDist,
					 		    const_CheckOPEZ_staticObsDfltVertDist,
					 		    const_CheckOPEZ_cpaEpsilon))
					  [[ share__ <- x__ | x__ <- {| share__ |} ]]
					 )
					)
					)
				)
				 \ hideSet)
			)
			 [| {| interrupt |} |] SKIP)
		)
		)
	
	Behaviour_VS_O(id__,
			    const_CheckOPEZ_minSafeDist,
			    const_CheckOPEZ_staticObsHorizDist,
			    const_CheckOPEZ_staticObsVertDist,
			    const_CheckOPEZ_staticObsDfltVertDist,
			    const_CheckOPEZ_cpaEpsilon) = 
		dbisim((MachineBody_VS_O(id__,
				    const_CheckOPEZ_minSafeDist,
				    const_CheckOPEZ_staticObsHorizDist,
				    const_CheckOPEZ_staticObsVertDist,
				    const_CheckOPEZ_staticObsDfltVertDist,
				    const_CheckOPEZ_cpaEpsilon))
		)
	
	IteratedBehaviour_VS_O(id__,
			    const_CheckOPEZ_minSafeDist,
			    const_CheckOPEZ_staticObsHorizDist,
			    const_CheckOPEZ_staticObsVertDist,
			    const_CheckOPEZ_staticObsDfltVertDist,
			    const_CheckOPEZ_cpaEpsilon) = 
		dbisim((MachineBody_VS_O(id__,
				    const_CheckOPEZ_minSafeDist,
				    const_CheckOPEZ_staticObsHorizDist,
				    const_CheckOPEZ_staticObsVertDist,
				    const_CheckOPEZ_staticObsDfltVertDist,
				    const_CheckOPEZ_cpaEpsilon))
		)
	
	Stateful_VS_O(id__,
			    const_CheckOPEZ_minSafeDist,
			    const_CheckOPEZ_staticObsHorizDist,
			    const_CheckOPEZ_staticObsVertDist,
			    const_CheckOPEZ_staticObsDfltVertDist,
			    const_CheckOPEZ_cpaEpsilon) = 
		dbisim((
			(Behaviour_VS_O(id__,
					    const_CheckOPEZ_minSafeDist,
					    const_CheckOPEZ_staticObsHorizDist,
					    const_CheckOPEZ_staticObsVertDist,
					    const_CheckOPEZ_staticObsDfltVertDist,
					    const_CheckOPEZ_cpaEpsilon) [| union(getsetLocalChannels,{terminate}) |] varMemory(id__,
					    const_CheckOPEZ_minSafeDist,
					    const_CheckOPEZ_staticObsHorizDist,
					    const_CheckOPEZ_staticObsVertDist,
					    const_CheckOPEZ_staticObsDfltVertDist,
					    const_CheckOPEZ_cpaEpsilon))
		 	\getsetLocalChannels
		)
		)
	
	IteratedStateful_VS_O(id__,
			    const_CheckOPEZ_minSafeDist,
			    const_CheckOPEZ_staticObsHorizDist,
			    const_CheckOPEZ_staticObsVertDist,
			    const_CheckOPEZ_staticObsDfltVertDist,
			    const_CheckOPEZ_cpaEpsilon) =
		(Behaviour_VS_O(id__,
				    const_CheckOPEZ_minSafeDist,
				    const_CheckOPEZ_staticObsHorizDist,
				    const_CheckOPEZ_staticObsVertDist,
				    const_CheckOPEZ_staticObsDfltVertDist,
				    const_CheckOPEZ_cpaEpsilon))
	
	-- END
	
	-- Memory
	-- Memory variables
	
	-- varMemory process
	varMemory(id__,
			    const_CheckOPEZ_minSafeDist,
			    const_CheckOPEZ_staticObsHorizDist,
			    const_CheckOPEZ_staticObsVertDist,
			    const_CheckOPEZ_staticObsDfltVertDist,
			    const_CheckOPEZ_cpaEpsilon) = terminate -> SKIP
	
	getsetLocalChannels = {||}
	
	-- Definition of the behaviour of state machines (default, optimised, visible, visible and optimised)
	FVS__(id__,
			    const_CheckOPEZ_minSafeDist,
			    const_CheckOPEZ_staticObsHorizDist,
			    const_CheckOPEZ_staticObsVertDist,
			    const_CheckOPEZ_staticObsDfltVertDist,
			    const_CheckOPEZ_cpaEpsilon) = STM_VS_O(id__,
			    const_CheckOPEZ_minSafeDist,
			    const_CheckOPEZ_staticObsHorizDist,
			    const_CheckOPEZ_staticObsVertDist,
			    const_CheckOPEZ_staticObsDfltVertDist,
			    const_CheckOPEZ_cpaEpsilon)
	
	D__(id__,
			    const_CheckOPEZ_minSafeDist,
			    const_CheckOPEZ_staticObsHorizDist,
			    const_CheckOPEZ_staticObsVertDist,
			    const_CheckOPEZ_staticObsDfltVertDist,
			    const_CheckOPEZ_cpaEpsilon) = STM(id__,
			    const_CheckOPEZ_minSafeDist,
			    const_CheckOPEZ_staticObsHorizDist,
			    const_CheckOPEZ_staticObsVertDist,
			    const_CheckOPEZ_staticObsDfltVertDist,
			    const_CheckOPEZ_cpaEpsilon) \ internal_events
	O__(id__,
			    const_CheckOPEZ_minSafeDist,
			    const_CheckOPEZ_staticObsHorizDist,
			    const_CheckOPEZ_staticObsVertDist,
			    const_CheckOPEZ_staticObsDfltVertDist,
			    const_CheckOPEZ_cpaEpsilon) = sbisim(diamond(D__(id__,
			    const_CheckOPEZ_minSafeDist,
			    const_CheckOPEZ_staticObsHorizDist,
			    const_CheckOPEZ_staticObsVertDist,
			    const_CheckOPEZ_staticObsDfltVertDist,
			    const_CheckOPEZ_cpaEpsilon)))
	VS__(id__,
			    const_CheckOPEZ_minSafeDist,
			    const_CheckOPEZ_staticObsHorizDist,
			    const_CheckOPEZ_staticObsVertDist,
			    const_CheckOPEZ_staticObsDfltVertDist,
			    const_CheckOPEZ_cpaEpsilon) = FVS__(id__,
			    const_CheckOPEZ_minSafeDist,
			    const_CheckOPEZ_staticObsHorizDist,
			    const_CheckOPEZ_staticObsVertDist,
			    const_CheckOPEZ_staticObsDfltVertDist,
			    const_CheckOPEZ_cpaEpsilon)
	VS_O__(id__,
			    const_CheckOPEZ_minSafeDist,
			    const_CheckOPEZ_staticObsHorizDist,
			    const_CheckOPEZ_staticObsVertDist,
			    const_CheckOPEZ_staticObsDfltVertDist,
			    const_CheckOPEZ_cpaEpsilon) = sbisim(diamond(FVS__(id__,
			    const_CheckOPEZ_minSafeDist,
			    const_CheckOPEZ_staticObsHorizDist,
			    const_CheckOPEZ_staticObsVertDist,
			    const_CheckOPEZ_staticObsDfltVertDist,
			    const_CheckOPEZ_cpaEpsilon)))
	HEXT__(id__,
			    const_CheckOPEZ_minSafeDist,
			    const_CheckOPEZ_staticObsHorizDist,
			    const_CheckOPEZ_staticObsVertDist,
			    const_CheckOPEZ_staticObsDfltVertDist,
			    const_CheckOPEZ_cpaEpsilon) = O__(id__,
			    const_CheckOPEZ_minSafeDist,
			    const_CheckOPEZ_staticObsHorizDist,
			    const_CheckOPEZ_staticObsVertDist,
			    const_CheckOPEZ_staticObsDfltVertDist,
			    const_CheckOPEZ_cpaEpsilon) [|shared_variable_events|] SKIP
	HUP__(id__,
			    const_CheckOPEZ_minSafeDist,
			    const_CheckOPEZ_staticObsHorizDist,
			    const_CheckOPEZ_staticObsVertDist,
			    const_CheckOPEZ_staticObsDfltVertDist,
			    const_CheckOPEZ_cpaEpsilon) = O__(id__,
			    const_CheckOPEZ_minSafeDist,
			    const_CheckOPEZ_staticObsHorizDist,
			    const_CheckOPEZ_staticObsVertDist,
			    const_CheckOPEZ_staticObsDfltVertDist,
			    const_CheckOPEZ_cpaEpsilon) [|{share__}|] SKIP
			endmodule

