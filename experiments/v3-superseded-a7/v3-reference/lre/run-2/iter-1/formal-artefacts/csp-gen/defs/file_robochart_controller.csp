					 ((i0::enter -> Transitions(id__,
					 		    const_LreController_minSafeDist,
					 		    const_LreController_staticObsHorizDist,
					 		    const_LreController_staticObsVertDist,
					 		    const_LreController_staticObsDfltVertDist,
					 		    const_LreController_cpaEpsilon))
					  [[ share__ <- x__ | x__ <- {| share__,setL_vel,setL_vvel,setL_tcpa,setL_cda,setL_inOpez,setL_cstc,setL_hvel,setL_cdyn |} ]]
					  [[set_v <- setR_v]]
					 )
					)[[setL_vel <- set_vel,setL_vvel <- set_vvel,setL_tcpa <- set_tcpa,setL_cda <- set_cda,setL_inOpez <- set_inOpez,setL_cstc <- set_cstc,setL_hvel <- set_hvel,setL_cdyn <- set_cdyn]]
					 [[setR_v <- set_v]]
					)
				)
				 \ hideSet)
				[[
					reqVel__.x____ <- reqVel,
					reqHdng__.x____ <- reqHdng,
					reqMOM__.x____ <- reqMOM,
					reqOCM__.x____ <- reqOCM,
					endTask__.x____ <- endTask,
					reqHCM__.x____ <- reqHCM,
					advVel__.x____ <- advVel,
					advHdng__.x____ <- advHdng
					| x____ <- NIDS
				]]
			)
			 [| {| interrupt |} |] SKIP)
		)
		)
	
	Behaviour_VS_O(id__,
			    const_LreController_minSafeDist,
			    const_LreController_staticObsHorizDist,
			    const_LreController_staticObsVertDist,
			    const_LreController_staticObsDfltVertDist,
			    const_LreController_cpaEpsilon) = 
		dbisim((MachineBody_VS_O(id__,
				    const_LreController_minSafeDist,
				    const_LreController_staticObsHorizDist,
				    const_LreController_staticObsVertDist,
				    const_LreController_staticObsDfltVertDist,
				    const_LreController_cpaEpsilon))
		)
	
	IteratedBehaviour_VS_O(id__,
			    const_LreController_minSafeDist,
			    const_LreController_staticObsHorizDist,
			    const_LreController_staticObsVertDist,
			    const_LreController_staticObsDfltVertDist,
			    const_LreController_cpaEpsilon) = 
		dbisim((MachineBody_VS_O(id__,
				    const_LreController_minSafeDist,
				    const_LreController_staticObsHorizDist,
				    const_LreController_staticObsVertDist,
				    const_LreController_staticObsDfltVertDist,
				    const_LreController_cpaEpsilon))
		)
	
	Stateful_VS_O(id__,
			    const_LreController_minSafeDist,
			    const_LreController_staticObsHorizDist,
			    const_LreController_staticObsVertDist,
			    const_LreController_staticObsDfltVertDist,
			    const_LreController_cpaEpsilon) = 
		dbisim((
			(Behaviour_VS_O(id__,
					    const_LreController_minSafeDist,
					    const_LreController_staticObsHorizDist,
					    const_LreController_staticObsVertDist,
					    const_LreController_staticObsDfltVertDist,
					    const_LreController_cpaEpsilon) [| union(getsetLocalChannels,{terminate}) |] varMemory(id__,
					    const_LreController_minSafeDist,
					    const_LreController_staticObsHorizDist,
					    const_LreController_staticObsVertDist,
					    const_LreController_staticObsDfltVertDist,
					    const_LreController_cpaEpsilon))
		 	\getsetLocalChannels
		)
		)
	
	IteratedStateful_VS_O(id__,
			    const_LreController_minSafeDist,
			    const_LreController_staticObsHorizDist,
			    const_LreController_staticObsVertDist,
			    const_LreController_staticObsDfltVertDist,
			    const_LreController_cpaEpsilon) =
		(dbisim(
			sbisim(
				Behaviour_VS_O(id__,
						    const_LreController_minSafeDist,
						    const_LreController_staticObsHorizDist,
						    const_LreController_staticObsVertDist,
						    const_LreController_staticObsDfltVertDist,
						    const_LreController_cpaEpsilon)
				[| {|get_v,set_v,terminate|} |]
				Memory_v(0)
			)\{|get_v,set_v|}
		)
		)
	
	-- END
	
	-- Memory
	-- Memory variables
	Memory_v(v) =
		get_v!v -> Memory_v(v)
		[]
		set_v?x__ -> Memory_v(x__)
		[]
		terminate -> SKIP
	
	-- varMemory process
	varMemory(id__,
			    const_LreController_minSafeDist,
			    const_LreController_staticObsHorizDist,
			    const_LreController_staticObsVertDist,
			    const_LreController_staticObsDfltVertDist,
			    const_LreController_cpaEpsilon) = Memory_v(0)
	
	getsetLocalChannels = {|get_v,set_v|}
	
	-- Definition of the behaviour of state machines (default, optimised, visible, visible and optimised)
	FVS__(id__,
			    const_LreController_minSafeDist,
			    const_LreController_staticObsHorizDist,
			    const_LreController_staticObsVertDist,
			    const_LreController_staticObsDfltVertDist,
			    const_LreController_cpaEpsilon) = STM_VS_O(id__,
			    const_LreController_minSafeDist,
			    const_LreController_staticObsHorizDist,
			    const_LreController_staticObsVertDist,
			    const_LreController_staticObsDfltVertDist,
			    const_LreController_cpaEpsilon)
	
	D__(id__,
			    const_LreController_minSafeDist,
			    const_LreController_staticObsHorizDist,
			    const_LreController_staticObsVertDist,
			    const_LreController_staticObsDfltVertDist,
			    const_LreController_cpaEpsilon) = STM(id__,
			    const_LreController_minSafeDist,
			    const_LreController_staticObsHorizDist,
			    const_LreController_staticObsVertDist,
			    const_LreController_staticObsDfltVertDist,
			    const_LreController_cpaEpsilon) \ internal_events
	O__(id__,
			    const_LreController_minSafeDist,
			    const_LreController_staticObsHorizDist,
			    const_LreController_staticObsVertDist,
			    const_LreController_staticObsDfltVertDist,
			    const_LreController_cpaEpsilon) = sbisim(diamond(D__(id__,
			    const_LreController_minSafeDist,
			    const_LreController_staticObsHorizDist,
			    const_LreController_staticObsVertDist,
			    const_LreController_staticObsDfltVertDist,
			    const_LreController_cpaEpsilon)))
	VS__(id__,
			    const_LreController_minSafeDist,
			    const_LreController_staticObsHorizDist,
			    const_LreController_staticObsVertDist,
			    const_LreController_staticObsDfltVertDist,
			    const_LreController_cpaEpsilon) = FVS__(id__,
			    const_LreController_minSafeDist,
			    const_LreController_staticObsHorizDist,
			    const_LreController_staticObsVertDist,
			    const_LreController_staticObsDfltVertDist,
			    const_LreController_cpaEpsilon)
	VS_O__(id__,
			    const_LreController_minSafeDist,
			    const_LreController_staticObsHorizDist,
			    const_LreController_staticObsVertDist,
			    const_LreController_staticObsDfltVertDist,
			    const_LreController_cpaEpsilon) = sbisim(diamond(FVS__(id__,
			    const_LreController_minSafeDist,
			    const_LreController_staticObsHorizDist,
			    const_LreController_staticObsVertDist,
			    const_LreController_staticObsDfltVertDist,
			    const_LreController_cpaEpsilon)))
	HEXT__(id__,
			    const_LreController_minSafeDist,
			    const_LreController_staticObsHorizDist,
			    const_LreController_staticObsVertDist,
			    const_LreController_staticObsDfltVertDist,
			    const_LreController_cpaEpsilon) = O__(id__,
			    const_LreController_minSafeDist,
			    const_LreController_staticObsHorizDist,
			    const_LreController_staticObsVertDist,
			    const_LreController_staticObsDfltVertDist,
			    const_LreController_cpaEpsilon) [|shared_variable_events|] SKIP
	HUP__(id__,
			    const_LreController_minSafeDist,
			    const_LreController_staticObsHorizDist,
			    const_LreController_staticObsVertDist,
			    const_LreController_staticObsDfltVertDist,
			    const_LreController_cpaEpsilon) = O__(id__,
			    const_LreController_minSafeDist,
			    const_LreController_staticObsHorizDist,
			    const_LreController_staticObsVertDist,
			    const_LreController_staticObsDfltVertDist,
			    const_LreController_cpaEpsilon) [|{share__}|] SKIP
	
	-- Shared memory
	-- Shared memory variables
	Memory_vel(vel) =
		get_vel!vel -> Memory_vel(vel)
		[]
		set_vel?x__ -> Memory_vel(x__)
		[]
		set_EXT_vel?x__ -> Memory_vel(x__)
		[]
		terminate -> SKIP
	Memory_inOpez(inOpez) =
		get_inOpez!inOpez -> Memory_inOpez(inOpez)
		[]
		set_inOpez?x__ -> Memory_inOpez(x__)
		[]
		set_EXT_inOpez?x__ -> Memory_inOpez(x__)
		[]
		terminate -> SKIP
	Memory_cdyn(cdyn) =
		get_cdyn!cdyn -> Memory_cdyn(cdyn)
		[]
		set_cdyn?x__ -> Memory_cdyn(x__)
		[]
		set_EXT_cdyn?x__ -> Memory_cdyn(x__)
		[]
		terminate -> SKIP
	Memory_cstc(cstc) =
		get_cstc!cstc -> Memory_cstc(cstc)
		[]
		set_cstc?x__ -> Memory_cstc(x__)
		[]
		set_EXT_cstc?x__ -> Memory_cstc(x__)
		[]
		terminate -> SKIP
	Memory_cda(cda) =
		get_cda!cda -> Memory_cda(cda)
		[]
		set_cda?x__ -> Memory_cda(x__)
		[]
		set_EXT_cda?x__ -> Memory_cda(x__)
		[]
		terminate -> SKIP
	Memory_tcpa(tcpa) =
		get_tcpa!tcpa -> Memory_tcpa(tcpa)
		[]
		set_tcpa?x__ -> Memory_tcpa(x__)
		[]
		set_EXT_tcpa?x__ -> Memory_tcpa(x__)
		[]
		terminate -> SKIP
	Memory_hvel(hvel) =
		get_hvel!hvel -> Memory_hvel(hvel)
		[]
		set_hvel?x__ -> Memory_hvel(x__)
		[]
		set_EXT_hvel?x__ -> Memory_hvel(x__)
		[]
		terminate -> SKIP
	Memory_vvel(vvel) =
		get_vvel!vvel -> Memory_vvel(vvel)
		[]
		set_vvel?x__ -> Memory_vvel(x__)
		[]
		set_EXT_vvel?x__ -> Memory_vvel(x__)
		[]
		terminate -> SKIP
	Memory_dynamicIndex(dynamicIndex) =
		get_dynamicIndex!dynamicIndex -> Memory_dynamicIndex(dynamicIndex)
		[]
		set_dynamicIndex?x__ -> Memory_dynamicIndex(x__)
		[]
		set_EXT_dynamicIndex?x__ -> Memory_dynamicIndex(x__)
		[]
		terminate -> SKIP
	Memory_closingNsVel(closingNsVel) =
		get_closingNsVel!closingNsVel -> Memory_closingNsVel(closingNsVel)
		[]
		set_closingNsVel?x__ -> Memory_closingNsVel(x__)
		[]
		set_EXT_closingNsVel?x__ -> Memory_closingNsVel(x__)
		[]
		terminate -> SKIP
	Memory_closingEwVel(closingEwVel) =
		get_closingEwVel!closingEwVel -> Memory_closingEwVel(closingEwVel)
		[]
		set_closingEwVel?x__ -> Memory_closingEwVel(x__)
		[]
		set_EXT_closingEwVel?x__ -> Memory_closingEwVel(x__)
		[]
		terminate -> SKIP
	Memory_missNs(missNs) =
		get_missNs!missNs -> Memory_missNs(missNs)
		[]
		set_missNs?x__ -> Memory_missNs(x__)
		[]
		set_EXT_missNs?x__ -> Memory_missNs(x__)
		[]
		terminate -> SKIP
	Memory_missEw(missEw) =
		get_missEw!missEw -> Memory_missEw(missEw)
		[]
		set_missEw?x__ -> Memory_missEw(x__)
		[]
		set_EXT_missEw?x__ -> Memory_missEw(x__)
		[]
		terminate -> SKIP
	Memory_staticIndex(staticIndex) =
		get_staticIndex!staticIndex -> Memory_staticIndex(staticIndex)
		[]
		set_staticIndex?x__ -> Memory_staticIndex(x__)
		[]
		set_EXT_staticIndex?x__ -> Memory_staticIndex(x__)
		[]
		terminate -> SKIP
	Memory_aheadTime(aheadTime) =
		get_aheadTime!aheadTime -> Memory_aheadTime(aheadTime)
		[]
		set_aheadTime?x__ -> Memory_aheadTime(x__)
		[]
		set_EXT_aheadTime?x__ -> Memory_aheadTime(x__)
		[]
		terminate -> SKIP
	
	-- sharedVarMemory process
	sharedVarMemory(id__,
			    const_LreController_minSafeDist,
			    const_LreController_staticObsHorizDist,
			    const_LreController_staticObsVertDist,
			    const_LreController_staticObsDfltVertDist,
			    const_LreController_cpaEpsilon) = Memory_vel(0)
	[| { terminate } |] (
	Memory_inOpez(true)
	[| { terminate } |] (
	Memory_cdyn(0)
	[| { terminate } |] (
	Memory_cstc(0)
	[| { terminate } |] (
	Memory_cda(0)
	[| { terminate } |] (
	Memory_tcpa(0)
	[| { terminate } |] (
	Memory_hvel(0)
	[| { terminate } |] (
	Memory_vvel(0)
	[| { terminate } |] (
	Memory_dynamicIndex(0)
	[| { terminate } |] (
	Memory_closingNsVel(0)
	[| { terminate } |] (
	Memory_closingEwVel(0)
	[| { terminate } |] (
	Memory_missNs(0)
	[| { terminate } |] (
	Memory_missEw(0)
	[| { terminate } |] (
	Memory_staticIndex(0)
	[| { terminate } |] (
	Memory_aheadTime(0)
	)
	)
	)
	)
	)
	)
	)
	)
	)
	)
	)
	)
	)
	)
	
	sharedVarSync = {|get_vel,set_vel,set_EXT_vel,get_inOpez,set_inOpez,set_EXT_inOpez,get_cdyn,set_cdyn,set_EXT_cdyn,get_cstc,set_cstc,set_EXT_cstc,get_cda,set_cda,set_EXT_cda,get_tcpa,set_tcpa,set_EXT_tcpa,get_hvel,set_hvel,set_EXT_hvel,get_vvel,set_vvel,set_EXT_vvel,get_dynamicIndex,set_dynamicIndex,set_EXT_dynamicIndex,get_closingNsVel,set_closingNsVel,set_EXT_closingNsVel,get_closingEwVel,set_closingEwVel,set_EXT_closingEwVel,get_missNs,set_missNs,set_EXT_missNs,get_missEw,set_missEw,set_EXT_missEw,get_staticIndex,set_staticIndex,set_EXT_staticIndex,get_aheadTime,set_aheadTime,set_EXT_aheadTime|}
	
	sharedVarHide = {|get_vel,get_inOpez,get_cdyn,get_cstc,get_cda,get_tcpa,get_hvel,get_vvel,get_dynamicIndex,get_closingNsVel,get_closingEwVel,get_missNs,get_missEw,get_staticIndex,get_aheadTime|}
endmodule

-- compileSelfContainedOperation
module OP_CalcCDyn
exports
	transparent diamond
	transparent sbisim
	transparent dbisim
	transparent chase

	-- Transition identifiers
	-- declaring identifiers of transitions
	datatype NIDS = 
	              NID_i0|
	              NID_f0
	
	channel internal__ : NIDS
	
	-- Flow channels		
	channel interrupt
	channel exited
	channel exit
	channel terminate
	
	-- Variable channels
	channel get_vel, set_vel, setL_vel, setR_vel: core_real
	channel get_inOpez, set_inOpez, setL_inOpez, setR_inOpez: core_boolean
	channel get_cdyn, set_cdyn, setL_cdyn, setR_cdyn: core_int
	channel get_cstc, set_cstc, setL_cstc, setR_cstc: core_int
	channel get_cda, set_cda, setL_cda, setR_cda: core_real
	channel get_tcpa, set_tcpa, setL_tcpa, setR_tcpa: core_real
	channel get_hvel, set_hvel, setL_hvel, setR_hvel: core_real
	channel get_vvel, set_vvel, setL_vvel, setR_vvel: core_real
	channel get_dynamicIndex, set_dynamicIndex, setL_dynamicIndex, setR_dynamicIndex: core_int
	channel get_closingNsVel, set_closingNsVel, setL_closingNsVel, setR_closingNsVel: core_real
	channel get_closingEwVel, set_closingEwVel, setL_closingEwVel, setR_closingEwVel: core_real
	channel get_missNs, set_missNs, setL_missNs, setR_missNs: core_real
	channel get_missEw, set_missEw, setL_missEw, setR_missEw: core_real
	channel get_staticIndex, set_staticIndex, setL_staticIndex, setR_staticIndex: core_int
	channel get_aheadTime, set_aheadTime, setL_aheadTime, setR_aheadTime: core_real
	channel get_SAFE_LARGE_DISTANCE, set_SAFE_LARGE_DISTANCE, setL_SAFE_LARGE_DISTANCE, setR_SAFE_LARGE_DISTANCE: core_real
	channel get_depth, set_depth, setL_depth, setR_depth: core_real
	channel get_nsVel, set_nsVel, setL_nsVel, setR_nsVel: core_real
	channel get_ewVel, set_ewVel, setL_ewVel, setR_ewVel: core_real
	channel get_rateOfClimb, set_rateOfClimb, setL_rateOfClimb, setR_rateOfClimb: core_real
	channel get_closestDynamicIndex, set_closestDynamicIndex, setL_closestDynamicIndex, setR_closestDynamicIndex: core_int
	channel get_closestStaticIndex, set_closestStaticIndex, setL_closestStaticIndex, setR_closestStaticIndex: core_int
	
	-- Shared variable channels
	channel set_EXT_vel: core_real
	channel set_EXT_inOpez: core_boolean
	channel set_EXT_cdyn: core_int
	channel set_EXT_cstc: core_int
	channel set_EXT_cda: core_real
	channel set_EXT_tcpa: core_real
	channel set_EXT_hvel: core_real
	channel set_EXT_vvel: core_real
	channel set_EXT_dynamicIndex: core_int
	channel set_EXT_closingNsVel: core_real
	channel set_EXT_closingEwVel: core_real
	channel set_EXT_missNs: core_real
	channel set_EXT_missEw: core_real
	channel set_EXT_staticIndex: core_int
	channel set_EXT_aheadTime: core_real
	channel set_EXT_SAFE_LARGE_DISTANCE: core_real
	channel set_EXT_depth: core_real
	channel set_EXT_nsVel: core_real
	channel set_EXT_ewVel: core_real
	channel set_EXT_rateOfClimb: core_real
	channel set_EXT_closestDynamicIndex: core_int
	channel set_EXT_closestStaticIndex: core_int
	
	-- Local variable channels for defined operations that are required by the state machine
	
	-- Declaring state machine events
	
	-- Declaring call and ret events for undefined operations
	
	enterSS = {|
	i0::enter,
	f0::enter
	|}
	
	enteredSS = 	{|
	f0::entered
	|}
	
	internal_events = union(enteredSS,union(enterSS,{|interrupt,exited|}))
	
	shared_variable_events = {|
		set_EXT_vel,
		set_EXT_inOpez,
		set_EXT_cdyn,
		set_EXT_cstc,
		set_EXT_cda,
		set_EXT_tcpa,
		set_EXT_hvel,
		set_EXT_vvel,
		set_EXT_dynamicIndex,
		set_EXT_closingNsVel,
		set_EXT_closingEwVel,
		set_EXT_missNs,
		set_EXT_missEw,
		set_EXT_staticIndex,
		set_EXT_aheadTime,
		set_EXT_SAFE_LARGE_DISTANCE,
		set_EXT_depth,
		set_EXT_nsVel,
		set_EXT_ewVel,
		set_EXT_rateOfClimb,
		set_EXT_closestDynamicIndex,
		set_EXT_closestStaticIndex
	|}
	
	-- channel set with all visible events
	sem__events = {|
		terminate
	,	set_EXT_vel, set_vel,
		set_EXT_inOpez, set_inOpez,
		set_EXT_cdyn, set_cdyn,
		set_EXT_cstc, set_cstc,
		set_EXT_cda, set_cda,
		set_EXT_tcpa, set_tcpa,
		set_EXT_hvel, set_hvel,
		set_EXT_vvel, set_vvel,
		set_EXT_dynamicIndex, set_dynamicIndex,
		set_EXT_closingNsVel, set_closingNsVel,
		set_EXT_closingEwVel, set_closingEwVel,
		set_EXT_missNs, set_missNs,
		set_EXT_missEw, set_missEw,
		set_EXT_staticIndex, set_staticIndex,
		set_EXT_aheadTime, set_aheadTime,
		set_EXT_SAFE_LARGE_DISTANCE, set_SAFE_LARGE_DISTANCE,
		set_EXT_depth, set_depth,
		set_EXT_nsVel, set_nsVel,
		set_EXT_ewVel, set_ewVel,
		set_EXT_rateOfClimb, set_rateOfClimb,
		set_EXT_closestDynamicIndex, set_closestDynamicIndex,
		set_EXT_closestStaticIndex, set_closestStaticIndex
		, share__
		|}
	
	-- Nodes --
	-- declaring all nodes
	
	----------------------------------------------------------------------
	-- Initial: i0
	module i0
	exports
	
		channel enter, interrupt
		
		D__(id__) = 
			dbisim(let
				Inactive 	= share__choice(enter -> SKIP [] terminate -> SKIP) ; Active
				
				Termination = terminate -> SKIP
				
				Active 		= share__choice(interrupt -> SKIP) ; Inactive
			within
				Inactive [| {terminate} |> SKIP)
		
		VS_O__(id__) = D__(id__)
	
	endmodule
	----------------------------------------------------------------------
	
	
	----------------------------------------------------------------------
	-- Final state: f0
	module f0
	
	exports
	
		channel enter, entered, interrupt
		channel enteredL, enteredR
		
		--	Rule: behaviours(Node)
		D__(id__) = 
			dbisim(let
				Inactive 	= share__choice(enter -> SKIP [] terminate -> SKIP) ; Entering
				
				Entering 	= entered -> SKIP ; Active
				Active		= share__choice(terminate -> SKIP [] interrupt -> SKIP) ; Interrupted
				Interrupted	= share__choice(exit -> exited -> Inactive)
			within
				Inactive [| {terminate} |> SKIP)
			
		VS_O__(id__) = D__(id__)
	
	endmodule
	----------------------------------------------------------------------
	
	-- END of Nodes --
	
	-- Operation calls --
	-- Only the undefined operations are declared here.
	-- If the state machine is in isolation, all required operations will be undefined.
	-- If it is in the context of a controller, the required operations not provided by the
	-- controller will be declared here, and the defined operations will be defined in the
	-- context of the Controller module, and therefore within scope of the state machine module.
	
	-- END of Operation calls --
	
	-- STM processes
	STM(id__) = -- RULE: [[stm:OperationDef]]_STM^nops : CSPProcess
	Stateful(id__) \ {terminate}
	
	STM_VS_O(id__) = -- RULE: [[stm:OperationDef]]_STM^nops : CSPProcess
	Stateful(id__) \ {terminate}
	
	-- Transitions
	Transitions(id__) = ((let
		Trans = (
			((share__ -> SKIP
			 [] dbisim((true)&(internal__!NID_i0 -> SKIP ;  ((share__choice(share__choice(get_closestDynamicIndex?closestDynamicIndex -> true & (share__choice(set_cdyn!closestDynamicIndex -> SKIP)))) ; f0::enter -> SKIP))))
			 ) ; Trans)
			 []
			 (interrupt -> share__choice(exit -> SKIP) ; share__choice(exited -> terminate -> SKIP))
			 []
			 terminate -> SKIP
		)
	within
		Trans
	)
	)
	
	-- Stateful
	-- RULE: Stateful(stm:StateMachineBody) : CSPProcess
	
	-- Named process definitions
	MachineBody(id__) = 
		dbisim((
		let
			finalNodesEntered = {|f0::entered|}
		within
			((let
				-- IMPLEMENTATION NOTE:
				-- Here the 'enter' channel set is calculated explicitly because of the use of CSPM 
				-- modules for defining the semantics of each node.
				enterSS = {|
				i0::enter,
				f0::enter
				|}
				hideSet = union(enterSS,{|exit,exited,internal__|})
			within 
				((let
					-- IMPLEMENTATION NOTE: the channel set 'enter' is calculated explicitly
