					 	 [] dbisim((((((not (((hdist(cstc)<=const_LreController_staticObsHorizDist)))) and (not (((vdist(cstc)<=const_LreController_staticObsVertDist))))) and (not ((inOpez)))) and (not ((((cda<const_LreController_minSafeDist) and (tcpa>=0)))))))&(internal__!NID_HCM -> SKIP ;  share__choice(exit -> SKIP) ; (share__choice(exited -> SKIP) ; SKIP ; MOM::enter -> SKIP)))
