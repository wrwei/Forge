						    const_LreController_staticObsVertDist,
						    const_LreController_staticObsDfltVertDist,
						    const_LreController_cpaEpsilon) = -- RULE: [[stm:StateMachineDef]]_STM^nops : CSPProcess
				( 
					(
						(
							(IteratedStateful(id__,
									    const_LreController_minSafeDist,
									    const_LreController_staticObsHorizDist,
									    const_LreController_staticObsVertDist,
									    const_LreController_staticObsDfltVertDist,
									    const_LreController_cpaEpsilon) \ {terminate} ; share__choice(terminate -> SKIP))
						 	[[ share__ <- x__ | x__ <- {|set_EXT_vel,set_EXT_inOpez,set_EXT_cdyn,set_EXT_cstc,set_EXT_cda,set_EXT_tcpa,set_EXT_hvel,set_EXT_vvel,set_EXT_dynamicIndex,set_EXT_closingNsVel,set_EXT_closingEwVel,set_EXT_missNs,set_EXT_missEw,set_EXT_staticIndex,set_EXT_aheadTime|} ]]
