// java2robochart.etl
// Extracts a RoboChart state machine from a Spoon Java EMF model
// containing a flat or mode-nested if-else state machine pattern.
// Migrated to official RoboChart metamodel (http://www.robocalc.circus/RoboChart).

// =====================================================================
// Configurable conventions
// =====================================================================
// Java naming patterns the ETL pattern-matches against. Changing the
// constants below adjusts what the M2M accepts without searching the
// rest of the file. Each convention also has an annotation-based
// equivalent (defined under `chemdetector.annotation.*` for the
// chemical_detector case study; case studies may declare equivalents
// in any package — the ETL matches by simple annotation name).
//
//   clockClassName        — fields whose declared type is this class
//                            become RoboChart `clock` declarations.
//                            Annotation alternative: @Clock on the
//                            field or its declaring class.
//   sensorClassNameHint   — substring used by Pass-3 sensor-class
//                            detection (case-insensitive class name
//                            match). Annotation alternative:
//                            @SensorService on the class.
//   timingMethodNames     — method invocations whose name appears in
//                            this list emit RoboChart `Wait`
//                            statements. (Future: @RoboChartWait on
//                            the method declaration.)
//   operationMethodName   — a class with a method of this name is
//                            treated as a RoboChart Operation.
// =====================================================================

pre {
    // FIX (2026-09-18). Enum simple names, consulted by findJavaLocalByName's
    // enum-parameter branch. Declared here in the `pre` block because an
    // operation-local `var` is not visible to operations (a first attempt
    // declared it beside enumTypeMap and every extraction failed with
    // "Undefined variable, type or model: 'enumNamesForParamLookup'").
    var enumNamesForParamLookup = new OrderedSet;

    var clockClassName = "Clock";
    var sensorClassNameHint = "sensor";
    var timingMethodNames = Sequence{"pause", "wait", "delay"};
    var operationMethodName = "compute";

    var rcPackage = new RoboChart!RCPackage;
    rcPackage.name = "extracted";

    // Predicate definitions map: varName -> Spoon initializer expression.
    // Populated when walking the step() body; passed through to buildGuardLeafExpr()
    // to inline comparison-expression initializers into guard trees.
    var predicateDefinitions = new Map;

    // Controller-state variable lookup: field-name -> RoboChart!Variable.
    // Populated in Phase 5 when walking controller fields; consulted by
    // extractActions() to build VarRef-targeted Assignments for
    // `this.<field> = rhs` statements in transition bodies.
    var ctrlStateVarLookup = new Map;

    // Clock-reset field lookup: field-name -> RoboChart!Clock.
    // Populated in Phase 4.9c-clocks: any controller field assigned from
    // `clock.nowMs()` (or any method on a Clock-typed receiver) gets
    // promoted from a Ctrl_State variable to a per-stm RoboChart clock.
    // extractActions() consults this map: when it sees
    // `this.tReset = clock.nowMs()` it emits a `ClockReset` on the
    // transition's `reset` slot rather than a regular Assignment.
    var clockFieldLookup = new Map;

    // Per-machine list of clock-field names. Built in Phase 4.9c-clocks
    // and consumed by the state-machine extraction loop, which attaches
    // a Clock EObject to each stm's `clocks` slot.
    var controllerClockFields = new Map;

    // Active event-payload pattern variable name (e.g. "g" for
    // `(GasAnalysisEvent.Gas) event`). Set by extractActions before
    // translating an action RHS; consulted by translateSpoonExpr to
    // remap pattern-variable reads to the typed-channel local `v`
    // (`trigger gas ? v` is the RCT syntax — the action sees `v`,
    // not the Java pattern name).
    var currentPatternVar = "";

    // Operation signature lookup: opName -> RoboChart!OperationSig.
    // Multi-arg actuator/vehicle method calls (e.g. `vehicle.move(LV, a)`)
    // can't be modelled as Communications (events have a single payload
    // type). They're emitted as RoboChart `Call` statements referencing
    // an OperationSig declared in an `LOperations` interface. The lookup
    // is populated lazily by buildOperationCall during action extraction.
    var operationSigLookup = new Map;

    // I1 (remainder): names of operation output variables whose action is a
    // STUB (`x = 0` / `x = false`) because extractComputeBody bailed out —
    // the compute() body had conditionals, an untranslatable method chain, or
    // an unassigned declared output. Populated in Phase 6; read by the
    // controller-field lifting pass (Phase 6a-ctrl) which refuses to lift any
    // expression whose reads include a stubbed name, so a placeholder is never
    // propagated into a lifted expression as though it were the Java's value.
    var stubbedOpVarNames = new OrderedSet;

    // Compute body local variable map: varName -> Spoon initializer expression.
    // Populated during extractComputeBody(); cleared after extraction.
    // Used by translateSpoonExpr() to inline local variables in compute() bodies.
    var computeLocalVarInits = new Map;

    // Named constants map: Java SCREAMING_SNAKE field name -> camelCase RoboChart name.
    // E.g., "MIN_SAFE_DIST" -> "minSafeDist".
    // Populated when a constants class is detected; used by translateSpoonExpr()
    // to emit named constant refs instead of literal values.
    var constantFieldMap = new Map;    // fieldName -> camelCaseName
    var constantValueMap = new Map;    // camelCaseName -> resolved value (for EGL constantDefaults)
    var constantTypeMap = new Map;     // camelCaseName -> "real" | "nat" | "boolean"
    var constantsClassName = "";       // e.g., "LreConstants"

    var modeEnum = findModeEnum();
    var controllerClass = findControllerClass();

    // Early constants class detection — must run before guard expression building
    // so that translateSpoonExpr() can emit named constant refs.
    for (cls in Spoon!CtClass.all) {
        if (constantsClassName <> "") { /* already found */ }
        else {
            if (findStepMethod(cls).isDefined()) { continue; }
            var container = cls.eContainer();
            if (container.isDefined() and (container.isKindOf(Spoon!CtClass)
                or container.isKindOf(Spoon!CtInterface))) { continue; }
            var clsName = getFeature(cls, "name");
            if (clsName.isUndefined() or clsName == "") { continue; }

            var primFieldCount2 = 0;
            var allStaticFinal = true;
            for (tm in cls.typeMember) {
                if (tm.isKindOf(Spoon!CtField)) {
                    var fType = getFeature(tm, "type");
                    if (fType.isDefined()) {
                        var fTypeName = getFeature(fType, "name");
                        if (fTypeName == "double" or fTypeName == "float"
                            or fTypeName == "int" or fTypeName == "long"
                            or fTypeName == "boolean") {
                            primFieldCount2 = primFieldCount2 + 1;
                            var mods = getFeature(tm, "modifier");
                            var hasFinal2 = false;
                            var hasStatic2 = false;
                            if (mods.isDefined()) {
                                for (m in mods) {
                                    if (m.toString() == "FINAL" or m.toString() == "final") {
                                        hasFinal2 = true;
                                    }
                                    if (m.toString() == "STATIC" or m.toString() == "static") {
                                        hasStatic2 = true;
                                    }
                                }
                            }
                            if (not hasFinal2 or not hasStatic2) {
                                allStaticFinal = false;
                            }
                        }
                    }
                }
            }
            if (primFieldCount2 >= 2 and allStaticFinal) {
                constantsClassName = clsName;
                for (tm2 in cls.typeMember) {
                    if (tm2.isKindOf(Spoon!CtField)) {
                        var fName2 = getFeature(tm2, "name");
                        var fType2 = getFeature(tm2, "type");
                        var fTypeName2 = "";
                        if (fType2.isDefined()) {
                            fTypeName2 = getFeature(fType2, "name");
                        }
                        if (fName2.isDefined() and fName2 <> "") {
                            var camelName = screamingSnakeToCamel(fName2);
                            constantFieldMap.put(fName2, camelName);
                            if (fTypeName2 == "double" or fTypeName2 == "float") {
                                constantTypeMap.put(camelName, "real");
                            } else if (fTypeName2 == "int" or fTypeName2 == "long") {
                                constantTypeMap.put(camelName, "nat");
                            } else if (fTypeName2 == "boolean") {
                                constantTypeMap.put(camelName, "boolean");
                            } else {
                                constantTypeMap.put(camelName, "real");
                            }
                            var defExpr = getFeature(tm2, "defaultExpression");
                            if (defExpr.isDefined() and resolvedValues.isDefined() and resolvedValues.containsKey(defExpr)) {
                                constantValueMap.put(camelName, resolvedValues.get(defExpr));
                            }
                        }
                    }
                }
            }
        }
    }

    // --- 4.9: Emit RoboChart Enumeration for every Java enum that is NOT
    // the controller mode enum. These are "domain enums" (e.g. Loc,
    // Status, Angle on the chemical_detector case study) referenced by
    // record fields and event payloads. Must be populated BEFORE the
    // state machine extraction begins (line ~108+), because
    // markEventTyped is called inside that extraction and needs to look
    // up these enums to type single-enum-payload events properly.
    var enumTypeMap = new Map;     // enumName  -> RoboChart!Enumeration
    var recordTypeMap = new Map;   // recordName -> RoboChart!RecordType
                                    // (populated by Phase 5a below; declared here
                                    // so markEventTyped can reference it even
                                    // before records are walked.)
    // Collect mode-enum names from every controller (multi-controller
    // support): each controller's mode enum drives that machine's
    // states, so they must NOT be emitted as domain types.
    var modeEnumNames = new Set;
    if (modeEnum.isDefined()) { modeEnumNames.add(modeEnum.name); }
    for (cc in findAllControllerClasses()) {
        var ccMe = findModeEnumForController(cc);
        if (ccMe.isDefined()) { modeEnumNames.add(ccMe.name); }
    }
    for (e in Spoon!CtEnum.all) {
        var eName = getFeature(e, "name");
        if (eName.isUndefined() or eName == "") { continue; }
        // Skip any controller's mode enum — it drives a state machine,
        // not the type system (states come from its literals).
        if (modeEnumNames.includes(eName)) { continue; }

        var enumType = new RoboChart!Enumeration;
        enumType.name = eName;
        for (lit in getFeature(e, "value")) {
            var litName = getFeature(lit, "name");
            if (litName.isDefined() and litName <> "") {
                var rcLit = new RoboChart!Literal;
                rcLit.name = litName;
                enumType.literals.add(rcLit);
            }
        }
        rcPackage.types.add(enumType);
        enumTypeMap.put(eName, enumType);
        enumNamesForParamLookup.add(eName);

        // Trace: Java enum -> RoboChart Enumeration
        var te = new Map;
        te.put("robochart_type", "Enumeration");
        te.put("robochart_element", eName);
        te.put("java_element", eName);
        te.put("java_type", "CtEnum");
        traceEntries.add(te);
    }

    // --- 4.9b: Pre-populate recordTypeMap with shell entries so that
    // markEventTyped (called during state-machine extraction below) can
    // resolve event payloads referencing records. The shells are
    // empty RoboChart!RecordType skeletons; Phase 5a below fills in
    // their fields and decides which ones to actually attach to
    // rcPackage.types. References (TypeRef) remain valid because they
    // point at the same object that Phase 5a later mutates.
    for (rec in Spoon!CtRecord.all) {
        var recName = getFeature(rec, "name");
        if (recName.isUndefined() or recName == "") { continue; }
        if (recordTypeMap.containsKey(recName)) { continue; }
        // Skip event records — variants of a Java sealed interface.
        // Phase 5a filters them out too; creating a shell for them
        // would leak an empty RecordType into the .xmi as an orphan
        // because Phase 5a won't reach the rcPackage.types.add() call.
        // Structural detection (sealed modifier) keeps the pipeline
        // generic; the legacy `endsWith("Event")` suffix is retained
        // as a fallback so code that omits `sealed` (a Java 17+
        // feature) still parses correctly.
        var container = rec.eContainer();
        if (container.isDefined()
            and (container.isKindOf(Spoon!CtClass) or container.isKindOf(Spoon!CtInterface))) {
            if (isSealedJavaType(container)) {
                continue;
            }
            var containerName = getFeature(container, "name");
            if (containerName.isDefined()
                and (containerName.endsWith("Event") or containerName.endsWith("Events"))) {
                continue;
            }
        }
        var shell = new RoboChart!RecordType;
        shell.name = recName;
        recordTypeMap.put(recName, shell);
    }

    // Resolve all controller classes up front. Needed by both the
    // Ctrl_State field walk (below) and the state-machine extraction loop
    // (further down) — declaring once keeps the two paths consistent.
    var allControllers = findAllControllerClasses();
    if (allControllers.size() == 0 and modeEnum.isDefined() and controllerClass.isDefined()) {
        allControllers.add(controllerClass);
    }

    // --- Phase 4.9c-clocks: Detect clock-reset fields ---
    // For each controller, walk its step() body looking for assignments
    // of the form `this.<field> = <Clock-typed method call>`. Such fields
    // are RoboChart clocks (declared `clock T` inside the stm), not data
    // state. We must identify them BEFORE Phase 4.9c so the Ctrl_State
    // field walk knows to skip them.
    for (cc in allControllers) {
        var stepBody = findStepMethod(cc);
        if (stepBody.isUndefined()) { continue; }
        var bodyBlock = getFeature(stepBody, "body");
        if (bodyBlock.isUndefined()) { continue; }
        var clockNames = new Sequence;
        collectClockResetFieldNames(bodyBlock, clockNames);
        controllerClockFields.put(cc.name, clockNames);
        for (cn in clockNames) {
            if (not clockFieldLookup.containsKey(cn)) {
                var clk = new RoboChart!Clock;
                clk.name = cn;
                clockFieldLookup.put(cn, clk);
            }
        }
    }

    // --- Phase 4.9c: Populate Ctrl_State from controller fields ---
    // Walks every controller's fields and emits RoboChart!Variable entries.
    // The EGL classifier later layers guard-derived predicate booleans on
    // top (declared fields win on type collision). Populating here, before
    // state-machine extraction, lets extractActions() resolve LHS field
    // names to Variable EObjects when building Assignment actions.
    //
    // Field inclusion heuristic:
    //   - Skip the mode field (it drives the state machine, not data state)
    //   - Skip final fields (they're constructor-injected dependencies:
    //     Sensor, Vehicle, Clock, etc.)
    //   - Skip fields whose type is a known infrastructure dep
    //     (Clock in particular — clock.nowMs() can't be modelled as
    //     a real state variable; assignments from it are silently dropped
    //     by action extraction)
    var ctrlStateIface = new RoboChart!Interface;
    ctrlStateIface.name = "Ctrl_State";
    var ctrlStateVarList = new RoboChart!VariableList;
    ctrlStateVarList.modifier = RoboChart!VariableModifier#VAR;
    var ctrlStateFieldNames = new Set;
    for (cc in allControllers) {
        var cmModeFieldName = findModeFieldName(cc);
        for (tm in cc.typeMember) {
            if (not tm.isKindOf(Spoon!CtField)) { continue; }
            var fName = getFeature(tm, "name");
            if (fName.isUndefined() or fName == "") { continue; }
            if (fName == cmModeFieldName) { continue; }
            // Skip final fields (dependency injection)
            var modifiers = getFeature(tm, "modifier");
            var isFinal = false;
            if (modifiers.isDefined()) {
                for (m in modifiers) {
                    if (m.toString() == "FINAL" or m.toString() == "final") {
                        isFinal = true;
                    }
                }
            }
            if (isFinal) { continue; }
            var fType = getFeature(tm, "type");
            if (fType.isUndefined()) { continue; }
            var fTypeName = getFeature(fType, "name");
            if (fTypeName.isUndefined() or fTypeName == "") { continue; }
            // Skip known infrastructure deps (defensive). Detection
            // accepts either the configured `clockClassName` OR a
            // `@Clock` annotation on the field declaration.
            if (fTypeName == clockClassName) { continue; }
            if (hasJavaAnnotation(tm, "Clock")) { continue; }
            // Clock-reset fields are promoted to `clock T` declarations
            // (handled in Phase 4.9c-clocks above) — they don't belong
            // in Ctrl_State as variables.
            if (clockFieldLookup.containsKey(fName)) { continue; }
            if (ctrlStateFieldNames.includes(fName)) { continue; }
            var fieldElementType = "";
            var fieldTypeArgs = getFeature(fType, "typeArgument");
            if (fieldTypeArgs.isDefined() and fieldTypeArgs.size() > 0) {
                var firstArg = fieldTypeArgs.first();
                if (firstArg.isDefined()) {
                    var argName = getFeature(firstArg, "name");
                    if (argName.isDefined()) {
                        fieldElementType = argName;
                    }
                }
            }
            var rcVarType = mapJavaTypeToRcTypeRef(fTypeName, fieldElementType,
                    enumTypeMap, recordTypeMap, rcPackage);
            if (rcVarType.isUndefined()) {
                var realPrim = new RoboChart!PrimitiveType;
                realPrim.name = "real";
                rcPackage.types.add(realPrim);
                rcVarType = new RoboChart!TypeRef;
                rcVarType.ref = realPrim;
            }
            var stateVar = new RoboChart!Variable;
            stateVar.name = fName;
            stateVar.type = rcVarType;
            // U5 FIX (initial data state). `Variable.initial` was never
            // populated anywhere in this file, so every emitted model carried
            // ZERO <initial> elements and each backend substituted its own
            // type default. On the CSP path that got the booleans WRONG:
            // LreController.java's constructor sets camActive/hcmActive/
            // momReturn/inOpez = false, but the CSP memory started them at
            // `true` — a state the Java constructor cannot produce.
            // resolveJavaFieldInitial reads the Java field's declaration
            // initialiser and its constructor-body assignment (constructor
            // wins, matching Java's own ordering) and returns a RoboChart
            // literal Expression, or undefined when the value does not fold.
            // Unresolved initials are left absent — same emission as before
            // this fix — so the change is strictly additive.
            var initExpr = resolveJavaFieldInitial(cc, tm, fName);
            if (initExpr.isDefined()) {
                stateVar.initial = initExpr;
            }
            ctrlStateVarList.vars.add(stateVar);
            ctrlStateFieldNames.add(fName);
            ctrlStateVarLookup.put(fName, stateVar);
        }
    }
    if (ctrlStateVarList.vars.size() > 0) {
        ctrlStateIface.variableList.add(ctrlStateVarList);
    }
    rcPackage.interfaces.add(ctrlStateIface);

    // --- Multi-controller state machine extraction ---
    // Emit one RoboChart!StateMachineDef per (controller, modeEnum) pair.
    // Each controller class with step()+enum-typed-mode-field becomes a
    // separate state machine in the package. The outer-scope
    // `controllerClass` / `modeEnum` remain set to the primary
    // (single-controller) pick so Phase 5 discovery (which uses them
    // for sensor/constants/record extraction) continues to work.
    //
    // Inside this loop:
    //   - `controllerClass` is shadowed by `cc` for clarity
    //   - `modeEnum` is shadowed by `ccModeEnum`
    //   - All other locals (stm, stateMap, eventMap, stateNames, tCount,
    //     firstStateName) are per-iteration and don't escape.
    //   - `predicateDefinitions` is module-level — reset at the top of
    //     each iteration so guard-predicate inlining stays scoped to
    //     the current step() body.
    // (allControllers was resolved before Phase 4.9c above.)
    for (cc in allControllers) {
        var ccModeEnum = findModeEnumForController(cc);
        if (ccModeEnum.isUndefined()) { continue; }
        predicateDefinitions = new Map;

        // Create state machine
        var stm = new RoboChart!StateMachineDef;
        stm.name = cc.name;
        rcPackage.machines.add(stm);

        // Attach RoboChart!Clock declarations for every clock-reset field
        // identified in this controller (Phase 4.9c-clocks). One Clock
        // per field, named after the field — RCT will render as
        // `clock <fieldName>` inside the stm body.
        if (controllerClockFields.containsKey(cc.name)) {
            for (cnm in controllerClockFields.get(cc.name)) {
                if (clockFieldLookup.containsKey(cnm)) {
                    stm.clocks.add(clockFieldLookup.get(cnm));
                }
            }
        }

        // Create states from enum values
        var stateMap = new Map;
        var stateNames = new Sequence;
        var firstStateName = "";
        for (ev in ccModeEnum.value) {
            var state = new RoboChart!State;
            state.name = ev.name;
            stm.nodes.add(state);
            stateMap.put(ev.name, state);
            stateNames.add(ev.name);
            if (firstStateName == "") {
                firstStateName = ev.name;
            }
            // Trace: enum literal → RoboChart State
            var te = new Map;
            te.put("robochart_type", "State");
            te.put("robochart_element", ev.name);
            te.put("java_element", ccModeEnum.name + "." + ev.name);
            te.put("java_type", "CtEnumValue");
            traceEntries.add(te);
        }

        // Determine initial state from the currentMode field initialiser,
        // falling back to the first enum literal if not found (E10 fix)
        var initialStateName = findInitialModeName(cc);
        if (initialStateName == "" or not stateMap.containsKey(initialStateName)) {
            initialStateName = firstStateName;
        }

        // Create initial junction
        var initial = new RoboChart!Initial;
        initial.name = "i0";
        stm.nodes.add(initial);

        // Create initial transition
        var tInit = new RoboChart!Transition;
        tInit.name = "t_init";
        tInit.source = initial;
        if (initialStateName <> "") {
            tInit.target = stateMap.get(initialStateName);
        }
        stm.transitions.add(tInit);

        // Walk the if-else chain in step()
        var stepMethod = findStepMethod(cc);
        if (stepMethod.isDefined() and stepMethod.body.isDefined()) {
            var bodyBlock = stepMethod.body;
            if (bodyBlock.isKindOf(Spoon!CtBlock) and bodyBlock.statement.size() > 0) {
                var eventMap = new Map;
                var tCount = 1;

                // Collect local variable (predicate) definitions before the if-else chain.
                // Populates the module-level predicateDefinitions map for later inlining.
                for (stmt in bodyBlock.statement) {
                    if (stmt.isTypeOf(Spoon!CtLocalVariable)) {
                        var varName = getFeature(stmt, "name");
                        // Initializer is in CtRHSReceiver.assignment (not CtVariable.defaultExpression)
                        var init = getFeature(stmt, "assignment");
                        if (varName.isDefined() and init.isDefined()) {
                            predicateDefinitions.put(varName, init);
                        }
                    }
                }

                // C1 fix (priority negation synthesis): Java's if-else chain gives
                // earlier branches priority; RoboChart transitions are an unguarded
                // choice. Accumulate each preceding TRIGGERLESS branch's data-guard
                // (keyed by source state) and prepend its negation to every LATER
                // branch's guard from the same source state — reproducing the
                // hand-written `hcmActive && !camActive` convention where the Java
                // lacks it. Event-triggered branches RECEIVE negations but never
                // CONTRIBUTE (their blocking effect is trigger disjointness, not a
                // state predicate — covered by the C2 trigger-precondition fix).
                var priorityGuardsByState = new Map;
                var currentIf = findFirstCtIf(bodyBlock);
                while (currentIf.isDefined() and currentIf.isTypeOf(Spoon!CtIf)) {
                    // Analyze condition
                    var cond = currentIf.condition;
                    var conjuncts = flattenCondition(cond);
                    var eqModeName = "";
                    var neModeName = "";
                    var eventTypeName = "";
                    var patternVarName = "";
                    var guardConjuncts = new Sequence;
                    for (conj in conjuncts) {
                        var consumed = false;
                        var eqName = extractModeComparison(conj, "EQ");
                        if (eqName.isDefined()) {
                            eqModeName = eqName;
                            consumed = true;
                        }
                        if (not consumed) {
                            var neName = extractModeComparison(conj, "NE");
                            if (neName.isDefined()) {
                                neModeName = neName;
                                consumed = true;
                            }
                        }
                        if (not consumed) {
                            var evtType = extractInstanceofType(conj);
                            if (evtType.isDefined()) {
                                eventTypeName = evtType;
                                // E11: extract pattern variable name for data flow tracking
                                var pv = extractPatternVariable(conj);
                                if (pv.isDefined()) {
                                    patternVarName = pv;
                                }
                                consumed = true;
                            }
                        }
                        if (not consumed) {
                            guardConjuncts.add(conj);
                        }
                    }

                    // Analyze body for target mode
                    var thenBlock = getFeature(currentIf, "then");
                    var targetModeName = findTargetMode(thenBlock);

                    // E11: fallback to cast variable detection for traditional instanceof
                    if (patternVarName == "" and eventTypeName <> "") {
                        var cv = extractCastVariable(thenBlock, eventTypeName);
                        if (cv.isDefined()) {
                            patternVarName = cv;
                        }
                    }

                    // E11: mark trigger event as typed if pattern/cast variable was detected
                    if (eventTypeName <> "" and patternVarName <> "") {
                        var trigEvt = getOrCreateEvent(eventTypeName, eventMap, stm);
                        markEventTyped(trigEvt, eventTypeName);
                    }

                    // C1 fix: raw (pre-negation) guard of this branch, captured for
                    // accumulation so LATER branches from the same source state can
                    // negate it. Captured immediately after createTransition, BEFORE
                    // applyPriorityNegations rewrites the condition.
                    var branchRawGuard;

                    // Create transitions based on the comparison type
                    if (eqModeName <> "" and targetModeName <> "") {
                        // EQ: single transition from specific source state
                        tCount = createTransition(stm, stateMap, eqModeName, targetModeName,
                                eventTypeName, eventMap, tCount, guardConjuncts, predicateDefinitions, currentIf);
                        branchRawGuard = stm.transitions.last().condition;
                        // C1 fix: block this branch when a higher-priority triggerless guard holds
                        applyPriorityNegations(stm, getPriorityList(priorityGuardsByState, eqModeName));
                        // E4/E11: extract actions from then-block with pattern variable context
                        var actions = extractActions(thenBlock, stm, eventMap, patternVarName, eventTypeName);
                        attachActions(stm, actions);
                    }
                    if (neModeName <> "" and targetModeName <> "") {
                        // NE: transitions from ALL states except the named one
                        // Self-transitions (source == target) are allowed (E5 fix)
                        for (sn in stateNames) {
                            if (sn <> neModeName) {
                                tCount = createTransition(stm, stateMap, sn, targetModeName,
                                        eventTypeName, eventMap, tCount, guardConjuncts, predicateDefinitions, currentIf);
                                if (branchRawGuard.isUndefined()) {
                                    branchRawGuard = stm.transitions.last().condition;
                                }
                                // C1 fix: per-source-state priority negations
                                applyPriorityNegations(stm, getPriorityList(priorityGuardsByState, sn));
                                // E4/E11: fresh actions for each transition (EMF containment)
                                var neActions = extractActions(thenBlock, stm, eventMap, patternVarName, eventTypeName);
                                attachActions(stm, neActions);
                            }
                        }
                    }
                    // E9 fix: branches with event trigger but no state change
                    // create self-transitions to keep the event visible in the model.
                    // Skip empty handler bodies (no statements) — these are no-op
                    // branches that should not produce transitions.
                    var thenStmts = thenBlock.isDefined() and thenBlock.isKindOf(Spoon!CtBlock)
                            ? thenBlock.statement : Sequence{};
                    if (targetModeName == "" and eventTypeName <> "" and thenStmts.size() > 0) {
                        if (eqModeName <> "") {
                            tCount = createTransition(stm, stateMap, eqModeName, eqModeName,
                                    eventTypeName, eventMap, tCount, guardConjuncts, predicateDefinitions, currentIf);
                            // C1 fix: per-source-state priority negations
                            applyPriorityNegations(stm, getPriorityList(priorityGuardsByState, eqModeName));
                            // E4/E11: extract actions from self-transition then-block
                            var e9Actions = extractActions(thenBlock, stm, eventMap, patternVarName, eventTypeName);
                            attachActions(stm, e9Actions);
                        }
                        if (neModeName <> "") {
                            for (sn in stateNames) {
                                if (sn <> neModeName) {
                                    tCount = createTransition(stm, stateMap, sn, sn,
                                            eventTypeName, eventMap, tCount, guardConjuncts, predicateDefinitions, currentIf);
                                    // C1 fix: per-source-state priority negations
                                    applyPriorityNegations(stm, getPriorityList(priorityGuardsByState, sn));
                                    // E4/E11: fresh actions for each self-transition
                                    var neE9Actions = extractActions(thenBlock, stm, eventMap, patternVarName, eventTypeName);
                                    attachActions(stm, neE9Actions);
                                }
                            }
                        }
                    }

                    // Mode-nested block detection (E8 fix):
                    // If outer branch has only currentMode == X (no event, no guards)
                    // and no direct target assignment, check for inner if-else chain
                    if (eqModeName <> "" and targetModeName == ""
                            and eventTypeName == "" and guardConjuncts.size() == 0) {
                        // Top-of-mode statements (statements at the head of
                        // the outer if-block, before the inner if-else
                        // chain) become EntryAction on the corresponding
                        // state. Java example:
                        //   if (mode == MovementMode.Waiting) {
                        //       vehicle.randomWalk();         // <- entry
                        //       if (event instanceof ...) ...
                        //   }
                        attachTopOfModeEntryActions(thenBlock, stateMap.get(eqModeName), stm, eventMap);
                        var innerIf = findFirstCtIf(thenBlock);
                        if (innerIf.isDefined()) {
                            tCount = walkInnerChain(innerIf, eqModeName,
                                    stm, stateMap, stateNames, eventMap, tCount, predicateDefinitions);
                        }
                    }

                    // C1 fix: contribute this branch's data guard to the per-state
                    // accumulator so later branches negate it. Rule (a): only
                    // TRIGGERLESS branches contribute — an event-triggered branch
                    // blocks via trigger disjointness (C2), not a state predicate.
                    if (eventTypeName == "" and guardConjuncts.size() > 0) {
                        if (branchRawGuard.isDefined()) {
                            if (eqModeName <> "") {
                                accumulatePriorityGuard(priorityGuardsByState, eqModeName, branchRawGuard);
                            } else if (neModeName <> "") {
                                for (sn in stateNames) {
                                    if (sn <> neModeName) {
                                        accumulatePriorityGuard(priorityGuardsByState, sn, branchRawGuard);
                                    }
                                }
                            } else {
                                // Guarded triggerless branch with no mode comparison:
                                // Java blocks ALL later branches when it fires, but the
                                // ETL created no transition to source a guard from.
                                ("[priority-c1] WARNING: triggerless guarded branch without "
                                        + "mode comparison — its blocking effect on later "
                                        + "branches is NOT encoded").println();
                            }
                        } else {
                            // Triggerless guarded branch that produced no transition
                            // (no target mode): the branch is dropped from the model,
                            // and its blocking effect is likewise not encoded.
                            ("[priority-c1] WARNING: dropped triggerless guarded branch "
                                    + "(no target mode) — its blocking effect on later "
                                    + "branches is NOT encoded").println();
                        }
                    }

                    // Move to next else-if branch
                    // Spoon wraps else-if in a CtBlock; unwrap to get the inner CtIf
                    var elseVal = getFeature(currentIf, "else");
                    if (elseVal.isDefined() and elseVal.isKindOf(Spoon!CtBlock)) {
                        if (elseVal.statement.size() > 0) {
                            var firstStmt = elseVal.statement.at(0);
                            if (firstStmt.isTypeOf(Spoon!CtIf)) {
                                // else-if: continue loop with inner CtIf
                                elseVal = firstStmt;
                            } else {
                                // Terminal else block: extract target mode and create
                                // default transitions from all states (E13 fix)
                                var elseTarget = findTargetMode(elseVal);
                                if (elseTarget <> "") {
                                    for (sn in stateNames) {
                                        tCount = createTransition(stm, stateMap, sn, elseTarget,
                                                "", eventMap, tCount, new Sequence, predicateDefinitions, currentIf);
                                        // C1 fix (E13): the terminal else fires only when no
                                        // preceding triggerless guard holds — receive negations.
                                        applyPriorityNegations(stm, getPriorityList(priorityGuardsByState, sn));
                                        // E4: fresh actions from terminal else block (no pattern var in else)
                                        var elseActions = extractActions(elseVal, stm, eventMap, "", "");
                                        attachActions(stm, elseActions);
                                    }
                                }
                                elseVal = null;
                            }
                        }
                    }
                    currentIf = elseVal;
                }

                // Phase 5 now handles function creation properly (with parameter types),
                // so the old zero-arg function creation from predicate method names is removed.

                // Phase 3: Remove presence-check guard patterns (variables ending in "Present").
                // These represent existence checks (x != -1) that are unnecessary in the
                // RoboChart model where absent entities have default/infinite values.
                // Patterns removed:
                //   And(presenceCheck, X) -> X
                //   Or(Not(presenceCheck), X) -> X
                //   bare presenceCheck -> removed (true)
                for (trans in stm.transitions) {
                    if (trans.condition.isDefined()) {
                        var simplified = simplifyPresenceChecks(trans.condition);
                        // simplifyPresenceChecks returns undefined when the whole
                        // guard simplified to a vacuous "true" (e.g. a bare
                        // presence-check leaf). Setting an EReference to
                        // undefined unsets it, turning the transition into an
                        // unconditionally-enabled one — which is wrong if the
                        // simplification dropped semantic content. Replace with
                        // an explicit BooleanExp(true) so semantics stay visible.
                        if (simplified.isUndefined()) {
                            var trueExp = new RoboChart!BooleanExp;
                            // FIX (2026-09-14). BooleanExp.value is EString in
                            // robochart.ecore; every other ETL site assigns "true"/
                            // "false" as STRINGS. This fallback path assigned the
                            // Boolean `true` and was never exercised until chem
                            // run-1 v2's codegen produced a guard the simplifier
                            // reduced to undefined — sranger/lre never reach here.
                            trueExp.value = "true";
                            trans.condition = trueExp;
                        } else {
                            trans.condition = simplified;
                        }
                    }
                }

                // Entry action lifting is handled by the EGL rendering pass
                // (robochart2rct.egl), which detects when all incoming transitions
                // to a state share the same action and promotes it to "entry".
            }
        }

        // --- Deadlock-freedom linter ---
        // The Isabelle/UTP Z-Machine `deadlock_free` proof relies on
        // every non-Final state having at least one bare-precondition
        // outgoing transition (no trigger, no non-trivial condition).
        // Java mode blocks that only handle specific events without an
        // unconditional fallback violate this. Surface a warning per
        // problematic state so the user can add a fallback in the Java
        // source before running the Isabelle proof.
        for (state in stm.nodes) {
            if (not state.isKindOf(RoboChart!State)) { continue; }
            // Final states are absorbing; the proof handles them via
            // St.exhaust_disc and doesn't need an outgoing transition.
            if (state.name == "Final") { continue; }
            var outgoing = stm.transitions.select(t |
                    t.source = state and t.source <> stm.nodes.selectOne(n | n.isKindOf(RoboChart!Initial)));
            if (outgoing.isEmpty()) {
                ("[deadlock-lint] " + stm.name + "." + state.name
                        + ": no outgoing transitions (Isabelle deadlock_free proof will fail)").println();
                continue;
            }
            var hasBare = outgoing.exists(t |
                    t.trigger.isUndefined() and t.condition.isUndefined());
            if (not hasBare) {
                ("[deadlock-lint] " + stm.name + "." + state.name
                        + ": all outgoing transitions are guarded or event-triggered "
                        + "(no unconditional fallback — Isabelle deadlock_free proof will fail). "
                        + "Add an unconditional else-branch in the Java mode block.").println();
            }
        }
    }

    // =========================================================================
    // Phase 5: Discover specification-level elements from Spoon model
    //   - Record types -> RoboChart RecordType (datatype)
    //   - Functions used in guards -> RoboChart Function (with parameters)
    //   - Sensor data record -> Sensors Interface
    //   - Empty Actuators Interface
    // =========================================================================

    // --- 5-pre: Auto-detect sensor data record via dependency chain ---
    // Strategy: Controller -> dependency class -> find record params in
    // methods first (dynamic data), then constructor (static config).
    // Method-parameter records are preferred because they represent dynamic
    // sensor data (e.g. update(AuvInputParameters)), while constructor-parameter
    // records are typically static configuration (e.g. SensorClass(ConstantsRecord)).
    var sensorRecordName = "";
    // Parse-order fix: this used to loop over Spoon!CtClass.all taking the
    // LAST class with step() (no mode-field requirement), while
    // findControllerClass() prefers step()+enum-mode-field and takes the
    // FIRST — so sensor detection could silently key off a dispatch-only
    // class (or a different controller) depending on model iteration order.
    // Use the same canonical pick as the rest of the ETL, and collect
    // constructor dependencies from ALL controllers so multi-controller
    // case studies don't depend on which controller was picked.
    var controllerCls = findControllerClass();
    var depClassNames = new OrderedSet;
    if (controllerCls.isDefined()) {
        // Collect dependency class names from every controller constructor
        // (allControllers resolved before Phase 4.9c; falls back to the
        // single canonical pick when empty).
        var depSourceControllers = allControllers;
        if (depSourceControllers.size() == 0) {
            depSourceControllers = Sequence{controllerCls};
        }
        for (depCc in depSourceControllers) {
        for (tm in depCc.typeMember) {
            if (not tm.isTypeOf(Spoon!CtConstructor)) { continue; }
            var ctorParams = getFeature(tm, "parameter");
            if (ctorParams.isUndefined()) { continue; }
            for (cp in ctorParams) {
                var cpType = getFeature(cp, "type");
                if (cpType.isDefined()) {
                    var cpTypeName = getFeature(cpType, "name");
                    if (cpTypeName.isDefined() and cpTypeName <> "") {
                        depClassNames.add(cpTypeName);
                    }
                }
            }
        }
        }

        // Pass 1: Check dependency class METHOD parameters for records (dynamic data)
        // Static methods are excluded — they're utility helpers
        // (e.g. `static Sensor.goreq(Intensity, Intensity)`) whose
        // parameter types don't represent the instance's sensor data.
        // Without this filter, `goreq(Intensity, Intensity)` would set
        // `sensorRecordName = "Intensity"` and leak `var value : real`
        // into the Sensors interface.
        for (depName in depClassNames) {
            if (sensorRecordName <> "") { /* already found */ }
            else {
                for (depCls in Spoon!CtClass.all) {
                    if (sensorRecordName <> "") { /* already found */ }
                    else if (getFeature(depCls, "name") == depName) {
                        for (depTm in depCls.typeMember) {
                            if (sensorRecordName == "" and depTm.isTypeOf(Spoon!CtMethod)
                                    and not isStaticMember(depTm)) {
                                var methodParams = getFeature(depTm, "parameter");
                                if (methodParams.isDefined()) {
                                    for (dp in methodParams) {
                                        if (sensorRecordName == "") {
                                            var dpType = getFeature(dp, "type");
                                            if (dpType.isDefined()) {
                                                var dpTypeName = getFeature(dpType, "name");
                                                if (dpTypeName.isDefined()) {
                                                    for (rec in Spoon!CtRecord.all) {
                                                        if (sensorRecordName == "" and getFeature(rec, "name") == dpTypeName) {
                                                            sensorRecordName = dpTypeName;
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }

        // Pass 2: Fall back to constructor parameters if no method-param record found
        if (sensorRecordName == "") {
            for (depName in depClassNames) {
                if (sensorRecordName <> "") { /* already found */ }
                else {
                    for (depCls in Spoon!CtClass.all) {
                        if (sensorRecordName <> "") { /* already found */ }
                        else if (getFeature(depCls, "name") == depName) {
                            for (depTm in depCls.typeMember) {
                                if (sensorRecordName == "" and depTm.isTypeOf(Spoon!CtConstructor)) {
                                    var depParams = getFeature(depTm, "parameter");
                                    if (depParams.isDefined()) {
                                        for (dp in depParams) {
                                            if (sensorRecordName == "") {
                                                var dpType = getFeature(dp, "type");
                                                if (dpType.isDefined()) {
                                                    var dpTypeName = getFeature(dpType, "name");
                                                    if (dpTypeName.isDefined()) {
                                                        for (rec in Spoon!CtRecord.all) {
                                                            if (sensorRecordName == "" and getFeature(rec, "name") == dpTypeName) {
                                                                sensorRecordName = dpTypeName;
                                                            }
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    // Pass 3: Fall back to CtClass-based sensor among controller dependencies.
    // A sensor class has 2+ primitive-typed fields and is NOT an operation class.
    // Restricted to classes whose name contains "sensor" (case-insensitive)
    // — without this guard, the heuristic over-fires on actuators
    // (e.g. Vehicle, with lastMoveVelocity/flagged/randomWalking fields).
    // When no dependency matches the naming hint, Sensors is populated
    // from Phase 6b's zero-arg function discovery instead.
    if (sensorRecordName == "" and depClassNames.size() > 0) {
        for (depName in depClassNames) {
            if (sensorRecordName <> "") { /* already found */ }
            // Accept either the name-substring hint OR a @SensorService
            // annotation on the class declaration.
            else if (depName.toLowerCase().indexOf(sensorClassNameHint) < 0
                    and not javaTypeHasAnnotation(depName, "SensorService")) {
                /* not a sensor candidate */
            }
            else {
                for (depCls in Spoon!CtClass.all) {
                    if (sensorRecordName <> "") { /* already found */ }
                    else if (getFeature(depCls, "name") == depName) {
                        var isOpClass = false;
                        for (tm in depCls.typeMember) {
                            if (tm.isTypeOf(Spoon!CtMethod) and getFeature(tm, "name") == "compute") {
                                isOpClass = true;
                            }
                        }
                        if (not isOpClass) {
                            var primFieldCount = 0;
                            var allPrimFinal = true;
                            for (tm in depCls.typeMember) {
                                if (tm.isKindOf(Spoon!CtField)) {
                                    var fType = getFeature(tm, "type");
                                    if (fType.isDefined()) {
                                        var fTypeName = getFeature(fType, "name");
                                        if (fTypeName == "double" or fTypeName == "float"
                                            or fTypeName == "int" or fTypeName == "long"
                                            or fTypeName == "boolean") {
                                            primFieldCount = primFieldCount + 1;
                                            // Check if field is final (constants pattern).
                                            var mods = getFeature(tm, "modifier");
                                            var hasFinal = false;
                                            if (mods.isDefined()) {
                                                for (m in mods) {
                                                    if (m.toString() == "FINAL" or m.toString() == "final") {
                                                        hasFinal = true;
                                                    }
                                                }
                                            }
                                            if (not hasFinal) {
                                                allPrimFinal = false;
                                            }
                                        }
                                    }
                                }
                            }
                            // Skip constants classes: all primitive fields are final.
                            if (primFieldCount >= 2 and not allPrimFinal) {
                                sensorRecordName = depName;
                            }
                        }
                    }
                }
            }
        }
    }

    // --- 5a: Discover Java records -> RoboChart RecordType ---
    // recordTypeMap declared above (Phase 4.9 area) so markEventTyped can
    // see it; populated below.
    for (rec in Spoon!CtRecord.all) {
        var recName = getFeature(rec, "name");
        if (recName.isUndefined() or recName == "") { continue; }
        // Skip sensor data record (becomes Sensors interface) and event records.
        // Event records nested inside sealed interfaces are detected by checking
        // the EMF container for an enclosing type named *Event.
        if (recName == sensorRecordName) { continue; }
        // Skip constants records — their fields become the Constants interface.
        // Heuristic: record is a controller dependency with all numeric fields.
        if (depClassNames.includes(recName)) {
            var allNumeric = true;
            var comps = getFeature(rec, "recordComponent");
            if (comps.isDefined()) {
                for (rc in comps) {
                    var rcType = getFeature(rc, "type");
                    if (rcType.isDefined()) {
                        var rcTypeName = getFeature(rcType, "name");
                        if (rcTypeName.isDefined()
                            and rcTypeName <> "double" and rcTypeName <> "Double"
                            and rcTypeName <> "float" and rcTypeName <> "Float"
                            and rcTypeName <> "int" and rcTypeName <> "Integer"
                            and rcTypeName <> "long" and rcTypeName <> "Long") {
                            allNumeric = false;
                        }
                    }
                }
            }
            if (allNumeric) { continue; }
        }
        // Skip event records (variants of a sealed interface). Same
        // structural-then-suffix detection as the Phase 4.9b loop.
        var container = rec.eContainer();
        if (container.isDefined() and (container.isKindOf(Spoon!CtClass) or container.isKindOf(Spoon!CtInterface))) {
            if (isSealedJavaType(container)) {
                continue;
            }
            var containerName = getFeature(container, "name");
            if (containerName.isDefined() and (containerName.endsWith("Event") or containerName.endsWith("Events"))) {
                continue;
            }
        }

        // Reuse the shell created in Phase 4.9b if one exists; this
        // preserves any TypeRefs that markEventTyped already created
        // pointing at this record. Falls back to a fresh RecordType
        // only if the shell is somehow absent.
        var recordType;
        if (recordTypeMap.containsKey(recName)) {
            recordType = recordTypeMap.get(recName);
        } else {
            recordType = new RoboChart!RecordType;
        }
        recordType.name = recName;

        var components = getFeature(rec, "recordComponent");
        if (components.isDefined()) {
            for (comp in components) {
                var fName = getFeature(comp, "name");
                if (fName.isUndefined() or fName == "") { continue; }
                var field = new RoboChart!Field;
                field.name = fName;
                // Look up the field's Java type and map to a RoboChart
                // TypeRef. Falls back to a fresh "real" PrimitiveType if
                // the type can't be resolved.
                var compTypeRef = getFeature(comp, "type");
                var javaTypeName = "";
                if (compTypeRef.isDefined()) {
                    var jtn = getFeature(compTypeRef, "name");
                    if (jtn.isDefined()) { javaTypeName = jtn; }
                }
                field.type = mapJavaTypeToRcTypeRef(javaTypeName, "", enumTypeMap, recordTypeMap, rcPackage);
                recordType.fields.add(field);
            }
        }

        // Add extra fields from recordMetadata that may not be in Java source
        if (recordMetadata.isDefined() and recordMetadata.containsKey(recName)) {
            var metaFields = recordMetadata.get(recName);
            for (mf in metaFields) {
                var mfName = mf.name();
                // Check if this field already exists from Spoon discovery
                var alreadyExists = recordType.fields.exists(f | f.name == mfName);
                if (not alreadyExists) {
                    var field = new RoboChart!Field;
                    field.name = mfName;
                    var mfJavaType = mf.javaType();
                    var mfElementType = mf.elementType();
                    field.type = mapJavaTypeToRcTypeRef(mfJavaType, mfElementType, enumTypeMap, recordTypeMap, rcPackage);
                    recordType.fields.add(field);
                }
            }
        }

        rcPackage.types.add(recordType);
        recordTypeMap.put(recName, recordType);
    }

    // --- 5a-rescue: Any shell created in Phase 4.9b that Phase 5a
    // skipped (e.g. sensorRecordName or constants-record filtering)
    // but is still referenced from elsewhere via TypeRef must be
    // attached to the RCPackage so the .xmi doesn't carry it as an
    // orphan top-level element. Fill in fields from recordMetadata
    // where available; otherwise leave as an empty RecordType.
    //
    // FORK: sort keys before iteration. recordTypeMap is a HashMap;
    // the rescue path adds elements to rcPackage.types (an ordered
    // EList) and that order determines XMI emission and downstream
    // .rct/.thy ordering. Audit-flagged determinism issue in Phase 4.
    var recordTypeMapKeys = recordTypeMap.keySet().asSequence();
    recordTypeMapKeys.sortBy(s | s);
    for (recName2 in recordTypeMapKeys) {
        var rt = recordTypeMap.get(recName2);
        if (rcPackage.types.contains(rt)) { continue; }
        // Fill in fields from recordMetadata if not already populated.
        if (rt.fields.size() == 0 and recordMetadata.isDefined() and recordMetadata.containsKey(recName2)) {
            for (mf in recordMetadata.get(recName2)) {
                var field = new RoboChart!Field;
                field.name = mf.name();
                field.type = mapJavaTypeToRcTypeRef(mf.javaType(), mf.elementType(), enumTypeMap, recordTypeMap, rcPackage);
                rt.fields.add(field);
            }
        }
        rcPackage.types.add(rt);
    }

    // --- 5b: Discover functions used in guard AND action expressions ---
    // Scan every machine's transitions, collecting CallExp function names
    // from both the guard condition and the action statements. Action
    // assignments (e.g. `this.sts = analysis(gs)`) reference sensor
    // methods that must be declared as RoboChart Functions, otherwise
    // the CSP generator can't resolve them.
    var guardFuncNames = new OrderedSet;
    for (smRef in rcPackage.machines) {
        for (trans in smRef.transitions) {
            if (trans.condition.isDefined()) {
                collectFunctionNames(trans.condition, guardFuncNames);
            }
            if (trans.action.isDefined()) {
                collectFunctionNamesFromAction(trans.action, guardFuncNames);
            }
        }
    }

    // Separate guard functions into regular functions and register variables.
    // The "register" pattern is the LRE-style sensor accessor `Obstacle
    // obs(int idx)` — a single nat parameter returning a record. Those
    // get modelled as function-typed variables in Sensors (`obs : nat ->
    // Obstacle`) so guards can read by index. Methods that take a non-
    // nat argument (e.g. `Intensity intensity(List<GasSensor> gs)`) or
    // multiple arguments are NOT register-style — they go to the plain-
    // function path, otherwise the RoboChart CSP generator crashes with
    // "Other types of callees not yet supported" when an action tries to
    // call the function-typed variable.
    var registerFuncNames = new OrderedSet;
    for (fname in guardFuncNames) {
        var jm = findJavaMethodByName(fname);
        if (jm.isDefined()) {
            var jRetTypeRef = getFeature(jm, "type");
            if (jRetTypeRef.isDefined()) {
                var jRetTypeName = getFeature(jRetTypeRef, "name");
                if (jRetTypeName.isDefined() and recordTypeMap.containsKey(jRetTypeName)) {
                    var jParams = getFeature(jm, "parameter");
                    var paramCount = 0;
                    var firstParamIsNat = false;
                    if (jParams.isDefined()) {
                        paramCount = jParams.size();
                        if (paramCount == 1) {
                            var jp0 = jParams.first();
                            var jp0Type = getFeature(jp0, "type");
                            if (jp0Type.isDefined()) {
                                var jp0TypeName = getFeature(jp0Type, "name");
                                if (jp0TypeName.isDefined()
                                        and (jp0TypeName == "int" or jp0TypeName == "Integer"
                                             or jp0TypeName == "long" or jp0TypeName == "Long")) {
                                    firstParamIsNat = true;
                                }
                            }
                        }
                    }
                    if (paramCount == 1 and firstParamIsNat) {
                        registerFuncNames.add(fname);
                    }
                }
            }
        }
    }

    for (fname in guardFuncNames) {
        // `since` is a RoboChart built-in clock expression (rendered as
        // `since(C)` in .rct); it must not be emitted as a user-declared
        // function. The since() rewrite in translateSpoonExpr produces
        // CallExp("since", ...) which gets picked up by the function-
        // name collectors above, hence this skip.
        if (fname == "since") { continue; }
        if (not registerFuncNames.includes(fname)) {
            // I2: the inference body that used to be inlined here now lives
            // in buildInferredFunction (see its header), so the guard path
            // and the Phase 6b operation-body path derive signatures from
            // the same Java declared types by the same code. This call is
            // behaviour-preserving for the guard path: the operation is a
            // verbatim extraction, fallbacks included.
            rcPackage.functions.add(
                buildInferredFunction(fname, enumTypeMap, recordTypeMap, rcPackage));
        }
    }

    // --- 5c: Discover sensor record -> Sensors Interface ---
    for (rec in Spoon!CtRecord.all) {
        var recName = getFeature(rec, "name");
        if (recName == sensorRecordName) {
            var sensorsIface = new RoboChart!Interface;
            sensorsIface.name = "Sensors";

            var varList = new RoboChart!VariableList;
            varList.modifier = RoboChart!VariableModifier#VAR;

            var components = getFeature(rec, "recordComponent");
            if (components.isDefined()) {
                for (comp in components) {
                    var cName = getFeature(comp, "name");
                    if (cName.isUndefined()) { continue; }
                    var v = new RoboChart!Variable;
                    v.name = cName;
                    // Type from the Java component type (was hardcoded "real",
                    // which silently retyped int/boolean sensor components —
                    // same defect class as the int->nat mapping). Unknown /
                    // non-primitive component types still fall back to "real"
                    // inside mapJavaTypeToRcTypeRef, preserving old behaviour.
                    var cTypeName = "";
                    var cTypeRef = getFeature(comp, "type");
                    if (cTypeRef.isDefined()) {
                        var ctn = getFeature(cTypeRef, "name");
                        if (ctn.isDefined()) { cTypeName = ctn; }
                    }
                    v.type = mapJavaTypeToRcTypeRef(cTypeName, "", enumTypeMap, recordTypeMap, rcPackage);
                    varList.vars.add(v);
                }
            }

            // Add function-typed variables for register accessors discovered in guards.
            // E.g. if guard calls obs(cstc) and Java method obs() returns a RecordType,
            // create var obs : nat -> RecordType in the Sensors interface.
            for (regFuncName in registerFuncNames) {
                var regJavaMethod = findJavaMethodByName(regFuncName);
                if (regJavaMethod.isDefined()) {
                    // Determine domain type from Java parameter
                    var domainTypeName = "nat";
                    var jParams = getFeature(regJavaMethod, "parameter");
                    if (jParams.isDefined() and jParams.size() > 0) {
                        var jp = jParams.first();
                        var jpTypeRef = getFeature(jp, "type");
                        if (jpTypeRef.isDefined()) {
                            var jpTypeName = getFeature(jpTypeRef, "name");
                            if (jpTypeName.isDefined()) {
                                if (jpTypeName == "double" or jpTypeName == "Double"
                                    or jpTypeName == "float" or jpTypeName == "Float") {
                                    domainTypeName = "real";
                                } else if (jpTypeName == "boolean" or jpTypeName == "Boolean") {
                                    domainTypeName = "boolean";
                                } else if (jpTypeName == "int" or jpTypeName == "Integer"
                                    or jpTypeName == "long" or jpTypeName == "Long") {
                                    // Signed Java int -> signed RoboChart int, matching
                                    // mapJavaTypeToRcTypeRef so int state vars can be
                                    // passed to these functions without a type clash.
                                    domainTypeName = "int";
                                }
                            }
                        }
                    }

                    // Determine range type from Java return type (must be a RecordType)
                    var rangeRecordType = null;
                    var jRetTypeRef = getFeature(regJavaMethod, "type");
                    if (jRetTypeRef.isDefined()) {
                        var jRetTypeName = getFeature(jRetTypeRef, "name");
                        if (jRetTypeName.isDefined() and recordTypeMap.containsKey(jRetTypeName)) {
                            rangeRecordType = recordTypeMap.get(jRetTypeName);
                        }
                    }

                    if (rangeRecordType.isDefined()) {
                        var regVar = new RoboChart!Variable;
                        regVar.name = regFuncName;
                        var funcType = new RoboChart!FunctionType;
                        var domainType = new RoboChart!PrimitiveType;
                        domainType.name = domainTypeName;
                        rcPackage.types.add(domainType);
                        var domRef = new RoboChart!TypeRef;
                        domRef.ref = domainType;
                        funcType.domain = domRef;
                        var rangeRef = new RoboChart!TypeRef;
                        rangeRef.ref = rangeRecordType;
                        funcType.range = rangeRef;
                        regVar.type = funcType;
                        varList.vars.add(regVar);
                    }
                }
            }

            sensorsIface.variableList.add(varList);
            rcPackage.interfaces.add(sensorsIface);
        }
    }

    // Phase 5c fallback: Create Sensors interface from CtClass-based sensor
    if (sensorRecordName <> "" and not rcPackage.interfaces.exists(i | i.name == "Sensors")) {
        for (cls in Spoon!CtClass.all) {
            var clsName = getFeature(cls, "name");
            if (clsName == sensorRecordName) {
                var sensorsIface = new RoboChart!Interface;
                sensorsIface.name = "Sensors";
                var varList = new RoboChart!VariableList;
                varList.modifier = RoboChart!VariableModifier#VAR;
                for (tm in cls.typeMember) {
                    if (not tm.isKindOf(Spoon!CtField)) { continue; }
                    var fName = getFeature(tm, "name");
                    if (fName.isUndefined() or fName == "") { continue; }
                    var fType = getFeature(tm, "type");
                    if (fType.isUndefined()) { continue; }
                    var fTypeName = getFeature(fType, "name");
                    if (fTypeName.isUndefined()) { continue; }
                    // Only include primitive fields (skip complex/collection types)
                    var rcTypeName = "";
                    if (fTypeName == "double" or fTypeName == "Double"
                        or fTypeName == "float" or fTypeName == "Float") {
                        rcTypeName = "real";
                    } else if (fTypeName == "int" or fTypeName == "Integer"
                               or fTypeName == "long" or fTypeName == "Long") {
                        // Signed Java int -> signed RoboChart int (see mapJavaTypeToRcTypeRef)
                        rcTypeName = "int";
                    } else if (fTypeName == "boolean" or fTypeName == "Boolean") {
                        rcTypeName = "boolean";
                    }
                    if (rcTypeName == "") { continue; }
                    var v = new RoboChart!Variable;
                    v.name = fName;
                    var vType = new RoboChart!PrimitiveType;
                    vType.name = rcTypeName;
                    rcPackage.types.add(vType);
                    var vTypeRef = new RoboChart!TypeRef;
                    vTypeRef.ref = vType;
                    v.type = vTypeRef;
                    varList.vars.add(v);
                }
                // Add function-typed variables for register accessors
                for (regFuncName in registerFuncNames) {
                    var regJavaMethod = findJavaMethodByName(regFuncName);
                    if (regJavaMethod.isDefined()) {
                        var domainTypeName = "nat";
                        var jParams = getFeature(regJavaMethod, "parameter");
                        if (jParams.isDefined() and jParams.size() > 0) {
                            var jp = jParams.first();
                            var jpTypeRef = getFeature(jp, "type");
                            if (jpTypeRef.isDefined()) {
                                var jpTypeName = getFeature(jpTypeRef, "name");
                                if (jpTypeName.isDefined()) {
                                    if (jpTypeName == "double" or jpTypeName == "Double"
                                        or jpTypeName == "float" or jpTypeName == "Float") {
                                        domainTypeName = "real";
                                    } else if (jpTypeName == "boolean" or jpTypeName == "Boolean") {
                                        domainTypeName = "boolean";
                                    } else if (jpTypeName == "int" or jpTypeName == "Integer"
                                        or jpTypeName == "long" or jpTypeName == "Long") {
                                        // Signed Java int -> signed RoboChart int (see 5b block)
                                        domainTypeName = "int";
                                    }
                                }
                            }
                        }
                        var rangeRecordType = null;
                        var jRetTypeRef = getFeature(regJavaMethod, "type");
                        if (jRetTypeRef.isDefined()) {
                            var jRetTypeName = getFeature(jRetTypeRef, "name");
                            if (jRetTypeName.isDefined() and recordTypeMap.containsKey(jRetTypeName)) {
                                rangeRecordType = recordTypeMap.get(jRetTypeName);
                            }
                        }
                        if (rangeRecordType.isDefined()) {
                            var regVar = new RoboChart!Variable;
                            regVar.name = regFuncName;
                            var funcType = new RoboChart!FunctionType;
                            var domainType = new RoboChart!PrimitiveType;
                            domainType.name = domainTypeName;
                            rcPackage.types.add(domainType);
                            var domRef = new RoboChart!TypeRef;
                            domRef.ref = domainType;
                            funcType.domain = domRef;
                            var rangeRef = new RoboChart!TypeRef;
                            rangeRef.ref = rangeRecordType;
                            funcType.range = rangeRef;
                            regVar.type = funcType;
                            varList.vars.add(regVar);
                        }
                    }
                }
                sensorsIface.variableList.add(varList);
                rcPackage.interfaces.add(sensorsIface);
            }
        }
    }

    // Always create an empty Sensors interface if none was added above
    // (record-based or CtClass-based detection both failed). Phase 6b
    // populates it from zero-arg sensor methods referenced in actions;
    // without the stub, those methods would leak into Ctrl_State as
    // bogus variables. Existing case studies (LRE) always go through
    // one of the prior detection paths, so this guard is a no-op for
    // them.
    if (not rcPackage.interfaces.exists(i | i.name == "Sensors")) {
        var emptySensorsIface = new RoboChart!Interface;
        emptySensorsIface.name = "Sensors";
        rcPackage.interfaces.add(emptySensorsIface);
    }

    // --- 5d: Create empty Actuators Interface ---
    var actuatorsIface = new RoboChart!Interface;
    actuatorsIface.name = "Actuators";
    rcPackage.interfaces.add(actuatorsIface);

    // =========================================================================
    // Phase 6: Operation discovery — find Java classes with compute() methods
    // and create RoboChart OperationDef objects.
    // Each operation gets Initial/Final nodes and a transition with stub
    // assignments (fieldName = 0) for each non-final output field.
    // =========================================================================

    // Ctrl_State interface (already populated in Phase 4.9c, before
    // state-machine extraction). Created earlier so that extractActions
    // can build VarRef-targeted Assignments via ctrlStateVarLookup.

    // Create Constants interface stub (content synthesized by the EGL)
    var constantsIface = new RoboChart!Interface;
    constantsIface.name = "Constants";
    rcPackage.interfaces.add(constantsIface);

    // Locate Sensors interface for rInterfaces references
    var sensorsIfaceRef = null;
    for (iface in rcPackage.interfaces) {
        if (iface.name == "Sensors") {
            sensorsIfaceRef = iface;
        }
    }

    for (cls in Spoon!CtClass.all) {
        // Skip the controller class (has step method)
        if (findStepMethod(cls).isDefined()) { continue; }

        // Skip nested types (inner classes, event records, etc.)
        var container = cls.eContainer();
        if (container.isDefined() and (container.isKindOf(Spoon!CtClass) or container.isKindOf(Spoon!CtInterface))) {
            continue;
        }

        // Check if the class has a compute() method — the operation marker
        var hasCompute = false;
        for (tm in cls.typeMember) {
            if (tm.isTypeOf(Spoon!CtMethod) and getFeature(tm, "name") == "compute") {
                hasCompute = true;
            }
        }
        if (not hasCompute) { continue; }

        var className = getFeature(cls, "name");
        if (className.isUndefined() or className == "") { continue; }

        // Create OperationDef
        var opDef = new RoboChart!OperationDef;
        opDef.name = className;
        opDef.terminates = true;

        // Reference Ctrl_State, Sensors, and Constants interfaces
        opDef.rInterfaces.add(ctrlStateIface);
        if (sensorsIfaceRef.isDefined()) {
            opDef.rInterfaces.add(sensorsIfaceRef);
        }
        if (constantValueMap.size() > 0) {
            opDef.rInterfaces.add(constantsIface);
        }

        // Create Initial and Final nodes
        var opInitial = new RoboChart!Initial;
        opInitial.name = "i0";
        opDef.nodes.add(opInitial);

        var opFinal = new RoboChart!Final;
        opFinal.name = "f0";
        opDef.nodes.add(opFinal);

        // Collect constructor parameter names — these are dependencies (Sensor, etc.)
        // Fields NOT in the constructor parameter list are output variables.
        var ctorParamNames = new OrderedSet;
        for (tm in cls.typeMember) {
            if (tm.isTypeOf(Spoon!CtConstructor)) {
                var params = getFeature(tm, "parameter");
                if (params.isDefined()) {
                    for (p in params) {
                        var pName = getFeature(p, "name");
                        if (pName.isDefined()) {
                            ctorParamNames.add(pName);
                        }
                    }
                }
            }
        }

        // Collect getter and setter method names to distinguish output fields
        // from input fields. A field with a getter (fieldName()) is an output;
        // a field with only a setter (setFieldName()) is an input.
        //
        // Tighter than the literal "any-method-name" rule the archive used:
        // we only count zero-arg methods whose name matches a field — so
        // "compute", "equals", "hashCode", and other methods that happen
        // to share a name with a field don't masquerade as accessors.
        var fieldNames = new OrderedSet;
        for (tm in cls.typeMember) {
            if (tm.isKindOf(Spoon!CtField)) {
                var fn = getFeature(tm, "name");
                if (fn.isDefined()) { fieldNames.add(fn); }
            }
        }
        var getterNames = new OrderedSet;
        var setterFieldNames = new OrderedSet;
        for (tm in cls.typeMember) {
            if (not tm.isKindOf(Spoon!CtMethod)) { continue; }
            var mName = getFeature(tm, "name");
            if (mName.isUndefined()) { continue; }
            if (mName.startsWith("set") and mName.length() > 3) {
                // setFoo -> foo (lowercase first char)
                var sfn = mName.substring(3, 4).toLowerCase() + mName.substring(4);
                setterFieldNames.add(sfn);
            } else {
                // Only count as a getter if the method name matches an
                // actual field AND takes zero parameters.
                var params = getFeature(tm, "parameter");
                var paramCount = 0;
                if (params.isDefined()) { paramCount = params.size(); }
                if (paramCount == 0 and fieldNames.includes(mName)) {
                    getterNames.add(mName);
                }
            }
        }

        var outputFieldNames = new Sequence;
        var opVarList = new RoboChart!VariableList;
        opVarList.modifier = RoboChart!VariableModifier#VAR;

        for (tm in cls.typeMember) {
            if (not tm.isKindOf(Spoon!CtField)) { continue; }

            var fieldName = getFeature(tm, "name");
            if (fieldName.isUndefined() or fieldName == "") { continue; }

            // Skip constructor dependencies (Sensor, Constants, etc.)
            if (ctorParamNames.includes(fieldName)) { continue; }

            // Skip input-only fields: has a setter but no getter
            if (setterFieldNames.includes(fieldName) and not getterNames.includes(fieldName)) { continue; }

            outputFieldNames.add(fieldName);

            // Create Variable for VarRef reference in Assignment
            var opVar = new RoboChart!Variable;
            opVar.name = fieldName;

            // Infer RoboChart type from Java field type
            var rcTypeName = "real";
            var fieldTypeRef = getFeature(tm, "type");
            if (fieldTypeRef.isDefined()) {
                var javaTypeName = getFeature(fieldTypeRef, "name");
                if (javaTypeName.isDefined()) {
                    if (javaTypeName == "boolean" or javaTypeName == "Boolean") {
                        rcTypeName = "boolean";
                    } else if (javaTypeName == "int" or javaTypeName == "Integer"
                               or javaTypeName == "long" or javaTypeName == "Long") {
                        // Signed Java int -> signed RoboChart int (see mapJavaTypeToRcTypeRef)
                        rcTypeName = "int";
                    } else if (javaTypeName == "double" or javaTypeName == "Double"
                               or javaTypeName == "float" or javaTypeName == "Float") {
                        rcTypeName = "real";
                    } else {
                        // FIX (2026-09-17). Enum-typed operation fields
                        // (chem run-2: OperationMove.direction : Angle) fell
                        // through to the default "real", so the .rct declared
                        // `var direction : real` while the actuator signature
                        // it flows into is `move(p0: real, p1: Angle)` — the
                        // parameter path types enums correctly via
                        // enumTypeMap, this field path never did (no prior
                        // study had enum-typed operation state). FDR4 then
                        // rejects CALL__move with "expected Angle, actual
                        // Int". Reference the existing Enumeration directly.
                        if (enumTypeMap.containsKey(javaTypeName)) {
                            var enumRef = new RoboChart!TypeRef;
                            enumRef.ref = enumTypeMap.get(javaTypeName);
                            opVar.type = enumRef;
                            opVarList.vars.add(opVar);
                            continue;
                        }
                        // Custom type: check if it matches a model RecordType.
                        // In the nat -> RecordType mapping pattern, variables of
                        // that type represent indices, so use nat.
                        var isRecordType = rcPackage.types.exists(
                            rt | rt.isKindOf(RoboChart!RecordType) and rt.name == javaTypeName);
                        if (isRecordType) {
                            rcTypeName = "nat";
                        }
                    }
                }
            }

            var varType = new RoboChart!PrimitiveType;
            varType.name = rcTypeName;
            rcPackage.types.add(varType);
            var varTypeRef = new RoboChart!TypeRef;
            varTypeRef.ref = varType;
            opVar.type = varTypeRef;
            opVarList.vars.add(opVar);
        }

        // Add variable list to operation (for EMF containment of Variable objects)
        if (opVarList.vars.size() > 0) {
            opDef.variableList.add(opVarList);
        }

        // Create transition from i0 to f0 with assignment actions
        var opTrans = new RoboChart!Transition;
        opTrans.name = "t0";
        opTrans.source = opInitial;
        opTrans.target = opFinal;

        // Try to extract real operation body from compute() method
        var extractedBody = extractComputeBody(cls, opVarList);
        if (extractedBody.isDefined()) {
            opTrans.action = extractedBody;
        } else if (outputFieldNames.size() == 1) {
            // Fallback: stub assignment fieldName = 0
            opTrans.action = createAssignment(opVarList.vars.at(0));
            // I1 (remainder): remember that this variable carries a STUB
            // placeholder, not the Java's computation. The controller-field
            // lifting pass below refuses to lift any expression that reads a
            // stubbed variable, because the lifted clause would propagate the
            // placeholder into the model as if it were the Java's value.
            stubbedOpVarNames.add(opVarList.vars.at(0).name);
        } else if (outputFieldNames.size() > 1) {
            // Fallback: stub assignments wrapped in SeqStatement
            var seq = new RoboChart!SeqStatement;
            for (v in opVarList.vars) {
                seq.statements.add(createAssignment(v));
                stubbedOpVarNames.add(v.name);   // see note above
            }
            opTrans.action = seq;
        }

        opDef.transitions.add(opTrans);
        rcPackage.operations.add(opDef);

        // Trace entry
        var te = new Map;
        te.put("robochart_type", "OperationDef");
        te.put("robochart_element", className);
        te.put("java_element", className);
        te.put("java_type", "CtClass");
        te.put("output_fields", outputFieldNames.concat(", "));
        traceEntries.add(te);
    }

    // =========================================================================
    // Phase 6a-ctrl: Lift CONTROLLER-LEVEL FIELD ASSIGNMENTS (I1 remainder).
    //
    // THE GAP. Three kinds of assignment appear in a controller's `step()`,
    // and pre-fix only two of them reached the model:
    //   1. inside a compute() body  -> lifted by Phase 6 into an OperationDef
    //                                  action (so the I1 data plane emits it);
    //   2. a controller-level LOCAL  -> recorded in `predicateDefinitions` and
    //      (`boolean velOk = ...`)      inlined into guards;
    //   3. a controller-level FIELD  -> NEITHER. The field is declared in
    //      (`this.camActive = ...`)     Ctrl_State (Phase 4.9c) and its guard
    //                                   READS are emitted, but its defining
    //                                   expression was dropped on the floor.
    // Consequence for the Isabelle data plane: `camActive`, `hcmActive`,
    // `momReturn` (LreController.java:176-183) and `turnDurationElapsed`
    // (SRangerController.java:155) reach the theory as zstore lenses that no
    // operation assigns — arbitrary but CONSTANT for a whole run, while the
    // Java re-evaluates them every step. Same under-approximation direction as
    // the rest of I1.
    //
    // THE VEHICLE, and why it is an OperationDef. The data plane is collected
    // (thy_generation_rule.egl, `dataDefOrder`/`dataDefExpr`) by walking
    // `p.operations` transition actions. Within a fix scoped to this file, an
    // OperationDef action is therefore the only place a lifted expression can
    // live and still reach the theory. One synthesized operation per
    // controller, named `<Controller>_Refresh`, holds the lifted block.
    //
    // HONEST NOTE ON WHAT THIS ADDS. The synthesized operation is declared and
    // opref'd but never `call`ed from the state machine — like the FIVE
    // operations already emitted (no `.rct` in any of the three studies
    // contains a single `call` statement). It therefore joins the existing,
    // already-documented U1 over-approximation rather than introducing a new
    // one; it does not make U1 worse in kind, but it does add one more
    // uninvoked operation to it.
    //
    // SOURCE ORDER (the U3 lesson). `step()` interleaves controller-field
    // assignments with compute() dispatches: `camActive` (:176) reads `cda`
    // and `tcpa`, which `calcCPA.compute()` (:171) produces earlier in the
    // same step. Assignments are collected by walking the step() body in
    // SOURCE ORDER into parallel Sequences — the same shape as
    // extractComputeBody's `assignedFieldOrder`/`assignedRhsOrder` — and
    // emitted into a SeqStatement in that order, so the downstream
    // `inlineRender` resolves a read of `cda` to CalcCPA's fresh expression
    // instead of a stale lens. A field assigned twice at top level yields two
    // statements, in order (not a Map collapse to the last one).
    //
    // WHAT IS REFUSED RATHER THAN GUESSED. Each guard below drops the single
    // assignment and logs `[i1-ctrl]` with the reason:
    //   * LHS is not a Ctrl_State variable (mode field, final dependency, or a
    //     field promoted to a `clock`);
    //   * RHS contains a Clock call — those are clock resets, whose promotion
    //     is Phase 4.9c-clocks' business, not the data plane's;
    //   * identity (`hvel = hvel`): the copy-out assignments
    //     `this.hvel = calcVel.hvel()` translate to a read of the same name,
    //     because the operation output variable and the controller field share
    //     it. Emitting `hvel = hvel` would add a vacuous clause and, worse,
    //     make `hvel` look controller-defined when CalcVel defines it;
    //   * RHS translation failed, or produced `unknown_expr` — the
    //     translateSpoonExpr fallback for a Java shape it cannot render;
    //   * RHS reads an operation output variable whose own action is a STUB
    //     (`stubbedOpVarNames`). This is the SRanger case:
    //     `this.turnDurationElapsed = turnTimer.elapsed()` translates to
    //     `turnDurationElapsed = elapsed`, and `elapsed` is stubbed to `false`
    //     because TurnTimer.compute() declares an output (`resetTime`) it does
    //     not assign, so extractComputeBody bails to stubs. Lifting it would
    //     PIN `turnDurationElapsed` to false — excluding the Turning -> Moving
    //     transition entirely, which is strictly worse than leaving the lens
    //     frozen-but-arbitrary. Refused, and reported as still-blocked.
    // =========================================================================
    var savedPredicateDefinitions = predicateDefinitions;
    for (cc in allControllers) {
        var ccStep = findStepMethod(cc);
        if (ccStep.isUndefined()) { continue; }
        var ccStepBody = getFeature(ccStep, "body");
        if (ccStepBody.isUndefined() or not ccStepBody.isKindOf(Spoon!CtBlock)) { continue; }

        // Scope local-variable inlining to THIS controller's step() body, so a
        // lifted RHS reading a step local inlines that controller's
        // definition. (After the multi-controller machine loop the module-level
        // map holds only the LAST controller's locals.)
        predicateDefinitions = new Map;
        for (stmt in ccStepBody.statement) {
            if (stmt.isTypeOf(Spoon!CtLocalVariable)) {
                var lvName = getFeature(stmt, "name");
                var lvInit = getFeature(stmt, "assignment");
                if (lvName.isDefined() and lvInit.isDefined()) {
                    predicateDefinitions.put(lvName, lvInit);
                }
            }
        }

        // Walk ONLY the top level of step(). Assignments nested inside the
        // if-else chain are transition actions and are already handled by
        // extractActions/buildStateAssignment — reaching into the chain here
        // would duplicate them and could perturb the C1 priority-negation
        // synthesis, which reads that chain.
        var liftedFieldOrder = new Sequence;   // fieldName, in source order
        var liftedRhsOrder = new Sequence;     // parallel: Spoon RHS expression
        for (stmt in ccStepBody.statement) {
            if (not stmt.isTypeOf(Spoon!CtAssignment)) { continue; }
            var lhs = getFeature(stmt, "assigned");
            if (lhs.isUndefined()) { continue; }
            if (not (lhs.isKindOf(Spoon!CtFieldWrite) or lhs.isKindOf(Spoon!CtFieldAccess))) { continue; }
            var lhsVarRef = lhs.variable;
            if (lhsVarRef.isUndefined()) { continue; }
            var fName = getFeature(lhsVarRef, "name");
            if (fName.isUndefined() or fName == "") { continue; }
            if (not ctrlStateVarLookup.containsKey(fName)) {
                ("[i1-ctrl] " + cc.name + "." + fName + ": not a Ctrl_State "
                    + "variable (mode field, final dependency, or promoted to a "
                    + "clock) — not lifted").println();
                continue;
            }
            var rhs = getFeature(stmt, "assignment");
            if (rhs.isUndefined()) { continue; }
            if (containsClockCall(rhs)) {
                ("[i1-ctrl] " + cc.name + "." + fName + ": RHS reads a Clock — "
                    + "clock promotion (Phase 4.9c-clocks) owns this, not the "
                    + "data plane — not lifted").println();
                continue;
            }
            liftedFieldOrder.add(fName);
            liftedRhsOrder.add(rhs);
        }

        // Translate in source order, applying the per-assignment refusals.
        //
        // The size guard is load-bearing, not defensive noise: Epsilon's
        // `Sequence{0..-1}` is NOT empty (it iterates 0 then -1), so an empty
        // `liftedFieldOrder` — every controller in the chemical detector study,
        // whose step() assigns fields only INSIDE the if-else chain — would
        // index a zero-length sequence and abort the whole M2M phase.
        if (liftedFieldOrder.size() == 0) { continue; }
        var ccLiftedAssignments = new Sequence;
        for (li in Sequence{0..liftedFieldOrder.size() - 1}) {
            var fName = liftedFieldOrder.at(li);
            var rcRhs = translateSpoonExpr(liftedRhsOrder.at(li));
            if (rcRhs.isUndefined()) {
                ("[i1-ctrl] " + cc.name + "." + fName + ": RHS did not translate "
                    + "to a RoboChart expression — not lifted").println();
                continue;
            }
            var rhsNames = new OrderedSet;
            collectAllRcCallExpNames(rcRhs, rhsNames);
            if (rhsNames.includes("unknown_expr")) {
                ("[i1-ctrl] " + cc.name + "." + fName + ": RHS contains an "
                    + "untranslatable Java sub-expression (unknown_expr) — "
                    + "not lifted").println();
                continue;
            }
            // Identity copy-out: `this.<f> = <op>.<f>()` renders as `<f>`.
            if (rhsNames.size() == 1 and rhsNames.includes(fName)
                    and rcRhs.isKindOf(RoboChart!CallExp)) {
                ("[i1-ctrl] " + cc.name + "." + fName + ": copy-out of an "
                    + "operation output of the same name — identity assignment, "
                    + "not lifted (the defining operation already carries the "
                    + "expression)").println();
                continue;
            }
            var stubbedReads = new OrderedSet;
            for (rn in rhsNames) {
                if (stubbedOpVarNames.includes(rn)) { stubbedReads.add(rn); }
            }
            if (stubbedReads.size() > 0) {
                ("[i1-ctrl] " + cc.name + "." + fName + ": RHS reads stubbed "
                    + "operation output(s) " + stubbedReads.concat(", ")
                    + " whose compute() body did not lift — lifting would "
                    + "propagate the stub placeholder as if it were the Java's "
                    + "value — not lifted").println();
                continue;
            }
            var assign = new RoboChart!Assignment;
            var vref = new RoboChart!VarRef;
            vref.name = ctrlStateVarLookup.get(fName);
            assign.left = vref;
            assign.right = rcRhs;
            ccLiftedAssignments.add(assign);
            ("[i1-ctrl] " + cc.name + "." + fName + ": lifted (source position "
                + li.toString() + " of " + liftedFieldOrder.size().toString()
                + " top-level field assignments)").println();
        }

        if (ccLiftedAssignments.size() == 0) { continue; }

        // Synthesize the refresh operation. Its Assignment LHS VarRefs point at
        // the EXISTING Ctrl_State Variables (via ctrlStateVarLookup), so the
        // operation declares no variableList of its own and the RCT's
        // "operation output variables" sweep cannot duplicate these names into
        // a state interface.
        var refreshOp = new RoboChart!OperationDef;
        refreshOp.name = cc.name + "_Refresh";
        refreshOp.terminates = true;
        refreshOp.rInterfaces.add(ctrlStateIface);
        if (sensorsIfaceRef.isDefined()) {
            refreshOp.rInterfaces.add(sensorsIfaceRef);
        }
        if (constantValueMap.size() > 0) {
            refreshOp.rInterfaces.add(constantsIface);
        }
        var refreshInitial = new RoboChart!Initial;
        refreshInitial.name = "i0";
        refreshOp.nodes.add(refreshInitial);
        var refreshFinal = new RoboChart!Final;
        refreshFinal.name = "f0";
        refreshOp.nodes.add(refreshFinal);
        var refreshTrans = new RoboChart!Transition;
        refreshTrans.name = "t0";
        refreshTrans.source = refreshInitial;
        refreshTrans.target = refreshFinal;
        if (ccLiftedAssignments.size() == 1) {
            refreshTrans.action = ccLiftedAssignments.at(0);
        } else {
            var refreshSeq = new RoboChart!SeqStatement;
            for (a in ccLiftedAssignments) {
                refreshSeq.statements.add(a);
            }
            refreshTrans.action = refreshSeq;
        }
        refreshOp.transitions.add(refreshTrans);
        rcPackage.operations.add(refreshOp);

        var teR = new Map;
        teR.put("robochart_type", "OperationDef");
        teR.put("robochart_element", refreshOp.name);
        teR.put("java_element", cc.name + ".step");
        teR.put("java_type", "CtMethod");
        teR.put("output_fields", liftedFieldOrder.concat(", "));
        traceEntries.add(teR);
    }
    predicateDefinitions = savedPredicateDefinitions;

    // =========================================================================
    // Phase 6b: Discover functions used in operation body actions.
    // Functions like sqrt() may appear in operation bodies but not in guards.
    // Create Function declarations for any new names not already in the package.
    // =========================================================================
    var opBodyFuncNames = new OrderedSet;
    for (opDef in rcPackage.operations) {
        for (trans in opDef.transitions) {
            if (trans.action.isDefined()) {
                collectFunctionNamesFromAction(trans.action, opBodyFuncNames);
            }
        }
    }
    // Also include state-machine action assignments — `this.sts =
    // analysis(gs)` calls a sensor function from a transition action,
    // not from an operation body.
    for (mchn in rcPackage.machines) {
        for (trans in mchn.transitions) {
            if (trans.action.isDefined()) {
                collectFunctionNamesFromAction(trans.action, opBodyFuncNames);
            }
        }
    }
    // Also collect zero-arg CallExp names from operation body actions.
    // These are sensor methods like closestStaticIndex() that have no parameters
    // and are distinct from state variable references.
    var opBodyZeroArgFuncNames = new OrderedSet;
    for (opDef in rcPackage.operations) {
        for (trans in opDef.transitions) {
            if (trans.action.isDefined()) {
                collectZeroArgFuncNamesFromAction(trans.action, opBodyZeroArgFuncNames);
            }
        }
    }
    // Same widening for state machines — `this.d0 = sensor.odometer()`
    // becomes `d0 = odometer` in the .rct, where odometer is a zero-arg
    // sensor method that must be declared as a no-param function.
    for (mchn in rcPackage.machines) {
        for (trans in mchn.transitions) {
            if (trans.action.isDefined()) {
                collectZeroArgFuncNamesFromAction(trans.action, opBodyZeroArgFuncNames);
            }
            // Also scan transition guard conditions: inlined boolean
            // predicates like `boolean velOk = sensor.vel() <= 0.1` get
            // unfolded into `LessOrEqual(CallExp("vel"), 0.1)`, so the
            // zero-arg sensor call only appears in the condition tree
            // (not the action). Without this scan, those methods leak
            // out of the Sensors interface — fine in case studies whose
            // controllers ALSO cache sensor values via state-var lift
            // (LRE), but broken for controllers that read sensors only
            // from guards.
            if (trans.condition.isDefined()) {
                collectZeroArgCallExpNames(trans.condition, opBodyZeroArgFuncNames);
            }
        }
    }

    var existingFuncNames = new OrderedSet;
    for (f in rcPackage.functions) {
        existingFuncNames.add(f.name);
    }
    // Collect known variable names (state variables, sensor variables,
    // operation output variables) to exclude from zero-arg function discovery
    var knownVarNames = new OrderedSet;
    for (iface in rcPackage.interfaces) {
        for (vl in iface.variableList) {
            for (v in vl.vars) {
                knownVarNames.add(v.name);
            }
        }
    }
    for (opDef in rcPackage.operations) {
        for (vl in opDef.variableList) {
            for (v in vl.vars) {
                knownVarNames.add(v.name);
            }
        }
    }

    // Functions already declared in the package (guard-phase discovery).
    // RoboChart has no built-in math functions — they must all be declared
    // as uninterpreted functions so the CSP generator can resolve them.
    var builtInFuncNames = new OrderedSet;

    // RoboChart built-ins that must NOT be emitted as user-declared
    // functions even when they appear in expression trees: `since(C)`
    // is a clock-reading expression, not a user function.
    builtInFuncNames.add("since");
    for (fname in opBodyFuncNames) {
        if (not existingFuncNames.includes(fname) and not builtInFuncNames.includes(fname)) {
            // I2 FIX. This site used to hardcode `(x : real) : real` with no
            // Java type inference whatsoever, so LRE emitted
            //     function nsRelDist ( x : real ) : real
            // against `double nsRelDist(@RoboChartType("nat") int index)`.
            // It now uses the SAME inferencer as the guard path (Phase 5b),
            // reading the Java DECLARED parameter/return types, so the four
            // operation-body functions (nsRelDist, ewRelDist, obsNsVel,
            // obsEwVel) come out as `( index : int ) : real` — agreeing with
            // the Java and with `odist`, which the guard path already got
            // right. Names with no resolvable Java method (`sqrt` resolves to
            // java.lang.Math, absent from the Spoon model) keep the previous
            // `( x : real ) : real` via the operation's fallbacks.
            rcPackage.functions.add(
                buildInferredFunction(fname, enumTypeMap, recordTypeMap, rcPackage));
            existingFuncNames.add(fname);
        }
    }
    // Zero-arg sensor methods (e.g., closestStaticIndex, closestDynamicIndex).
    // These represent derived sensor quantities provided each cycle.
    // Add them as variables in the Sensors interface (proper RoboChart pattern).
    var sensorsIfaceForZeroArg = null;
    for (iface in rcPackage.interfaces) {
        if (iface.name == "Sensors") {
            sensorsIfaceForZeroArg = iface;
        }
    }
    // Names that the zero-arg sweep must never lift into Sensors:
    //   (a) enum literals (e.g. `noGas`, `gasD` of a Status enum) — these
    //       are values declared by `enumeration Status { ... }`, not
    //       zero-arg sensor methods. A bare `sts == noGas` comparison
    //       surfaces `noGas` as a zero-arg CallExp, but it is an enum
    //       literal, not a Sensors variable.
    //   (b) clock field names (e.g. `tReset`) — these become RoboChart
    //       `clock T` declarations on the stm (Phase 4.9c-clocks) and a
    //       `since(T)` reference leaves the bare name in the tree, but
    //       the clock is not a Sensors variable.
    // Both leak as spurious `var <name> : nat` into Sensors and bloat the
    // FDR4 state space; exclude them here.
    var enumLiteralNamesForZeroArg = new OrderedSet;
    for (enumName in enumTypeMap.keySet()) {
        var enumDecl = enumTypeMap.get(enumName);
        for (lit in enumDecl.literals) {
            enumLiteralNamesForZeroArg.add(lit.name);
        }
    }
    if (sensorsIfaceForZeroArg.isDefined()) {
        for (fname in opBodyZeroArgFuncNames) {
            // `v` is the typed-trigger local declared inside each stm
            // (`var v : real`); event-payload reads (`gs = v`, `l = v`)
            // route through it but it is NOT a sensor variable.
            if (fname == "v") { continue; }
            // Skip enum literals and clock field names (see note above).
            if (enumLiteralNamesForZeroArg.includes(fname)) { continue; }
            if (clockFieldLookup.containsKey(fname)) { continue; }
            if (not existingFuncNames.includes(fname) and not knownVarNames.includes(fname)
                    and not constantFieldMap.values().includes(fname)) {
                // Infer RoboChart type from Java method return type
                var retTypeName = "nat";
                var enumRetRef = null;
                var javaMethod = findJavaMethodByName(fname);
                if (javaMethod.isUndefined()) {
                    // not a method — maybe a step-body local
                    // (boolean b = ...) referenced from a guard.
                    javaMethod = findJavaLocalByName(fname);
                }
                if (javaMethod.isDefined()) {
                    var jRetType = getFeature(javaMethod, "type");
                    if (jRetType.isDefined()) {
                        var jRetName = getFeature(jRetType, "name");
                        if (jRetName == "double" or jRetName == "Double"
                            or jRetName == "float" or jRetName == "Float") {
                            retTypeName = "real";
                        } else if (jRetName == "boolean" or jRetName == "Boolean") {
                            retTypeName = "boolean";
                        } else if (jRetName == "int" or jRetName == "Integer"
                            or jRetName == "long" or jRetName == "Long") {
                            // Signed Java int -> signed RoboChart int, matching
                            // mapJavaTypeToRcTypeRef. The "nat" default above is
                            // retained only for names with NO resolvable Java
                            // method (heuristic index guess).
                            retTypeName = "int";
                        } else if (jRetName.isDefined()
                                   and enumTypeMap.isDefined()
                                   and enumTypeMap.containsKey(jRetName)) {
                            // FIX (2026-09-14). Enum-returning sensor reads
                            // (chem: `Angle commandedAngle()`, `Angle
                            // avoidanceAngle()`) fell to the nat default; the
                            // lifted var then typed `nat` while assignments
                            // wrote enum literals into it — CSP-M died on
                            // Int-vs-Angle at every such site. Reference the
                            // Enumeration itself.
                            enumRetRef = enumTypeMap.get(jRetName);
                        }
                    }
                }
                var sVar = new RoboChart!Variable;
                sVar.name = fname;
                var sVarTypeRef = new RoboChart!TypeRef;
                if (enumRetRef.isDefined()) {
                    sVarTypeRef.ref = enumRetRef;
                } else {
                    var sVarType = new RoboChart!PrimitiveType;
                    sVarType.name = retTypeName;
                    rcPackage.types.add(sVarType);
                    sVarTypeRef.ref = sVarType;
                }
                sVar.type = sVarTypeRef;
                // Add to existing variable list or create one
                if (sensorsIfaceForZeroArg.variableList.size() > 0) {
                    sensorsIfaceForZeroArg.variableList.first().vars.add(sVar);
                } else {
                    var newVarList = new RoboChart!VariableList;
                    newVarList.modifier = RoboChart!VariableModifier#VAR;
                    newVarList.vars.add(sVar);
                    sensorsIfaceForZeroArg.variableList.add(newVarList);
                }
                knownVarNames.add(fname);
            }
        }
    }
}



// Create an Assignment statement: varRef = default-value.
// Uses BooleanExp(false) for boolean variables, IntegerExp(0) otherwise.
// Used by Phase 6 to build stub operation actions.
operation createAssignment(variable : Any) : Any {
    var assign = new RoboChart!Assignment;
    var vref = new RoboChart!VarRef;
    vref.name = variable;
    assign.left = vref;
    // Check if variable type is boolean
    var isBool = false;
    if (variable.type.isDefined()) {
        var resolved = variable.type;
        if (resolved.isKindOf(RoboChart!TypeRef)) {
            resolved = resolved.ref;
        }
        if (resolved.isDefined() and resolved.name == "boolean") {
            isBool = true;
        }
    }
    if (isBool) {
        var boolExp = new RoboChart!BooleanExp;
        boolExp.value = "false";
        assign.right = boolExp;
    } else {
        // FIX (2026-09-17). The earlier fix typed enum-valued operation fields as their
        // Enumeration, but this placeholder still assigned IntegerExp 0 — so the
        // .rct read `obstacleLocation = 0` against `var obstacleLocation : Loc`.
        // Both back ends rejected it downstream, from the SAME cause:
        //   FDR4  : "expected Int with actual Loc" at set_obstacleLocation!0
        //   Isabelle: "No type arity Loc :: zero"
        // For an Enumeration, emit its FIRST literal as the placeholder (a
        // well-typed member of the type, exactly what the Java field's own
        // initialiser is: `private Loc obstacleLocation = Loc.front`).
        var resolvedT = variable.type;
        if (resolvedT.isDefined() and resolvedT.isKindOf(RoboChart!TypeRef)) {
            resolvedT = resolvedT.ref;
        }
        // Shape note: an enum-literal use is CallExp(function = StringExp(name))
        // — the shape the working `move ( 0 , Front )` emission serialises to in
        // this same model. Build it with createNamedCallExp, which sets the
        // `function` feature reflectively (dot-access on it does not parse).
        if (resolvedT.isDefined() and resolvedT.isKindOf(RoboChart!Enumeration)
                and resolvedT.literals.size() > 0) {
            var litName = getFeature(resolvedT.literals.at(0), "name");
            if (litName.isDefined()) {
                assign.right = createNamedCallExp(litName);
                return assign;
            }
        }
        var intExp = new RoboChart!IntegerExp;
        intExp.value = 0;
        assign.right = intExp;
    }
    return assign;
}

// Extract the body of a compute() method as a RoboChart Statement.
// Walks the Spoon AST to find this.field = expr assignments and translates
// the RHS expressions to RoboChart. Supports local variable inlining via
// the module-level computeLocalVarInits map.
// Returns a Statement (Assignment or SeqStatement) if extraction succeeds
// for ALL output fields, or undefined if any field fails (falls back to stubs).
operation extractComputeBody(cls : Any, opVarList : Any) : Any {
    // Find the compute() method
    var computeMethod = null;
    for (tm in cls.typeMember) {
        if (tm.isTypeOf(Spoon!CtMethod) and getFeature(tm, "name") == "compute") {
            computeMethod = tm;
        }
    }
    if (computeMethod.isUndefined() or computeMethod.body.isUndefined()) {
        return;
    }
    var bodyBlock = computeMethod.body;
    if (not bodyBlock.isKindOf(Spoon!CtBlock)) {
        return;
    }

    // Pre-check: if the body contains if-statements or return statements,
    // the compute() method has conditional logic that cannot be faithfully
    // rendered as a flat sequence of assignments. Fall back to stubs.
    for (stmt in bodyBlock.statement) {
        if (stmt.isKindOf(Spoon!CtIf) or stmt.isKindOf(Spoon!CtReturn)
            or stmt.isKindOf(Spoon!CtWhile) or stmt.isKindOf(Spoon!CtFor)
            or stmt.isKindOf(Spoon!CtForEach)) {
            return;
        }
    }

    // Pass 1: Collect local variable definitions for inlining.
    // Uses CtRHSReceiver.assignment first (Spoon EMF convention), then defaultExpression.
    computeLocalVarInits = new Map;
    for (stmt in bodyBlock.statement) {
        if (stmt.isTypeOf(Spoon!CtLocalVariable)) {
            var varName = getFeature(stmt, "name");
            var init = getFeature(stmt, "assignment");
            if (init.isUndefined()) {
                init = getFeature(stmt, "defaultExpression");
            }
            if (varName.isDefined() and init.isDefined()) {
                computeLocalVarInits.put(varName, init);
            }
        }
    }

    // Pass 2: Collect field assignments (this.field = expr).
    //
    // U3 FIX (source order). This pass previously stored the assignments in a
    // Map keyed by field name, which DISCARDS the order in which the Java
    // executes them, and Pass 3 then re-emitted them in `opVarList.vars`
    // (i.e. FIELD DECLARATION) order. That is wrong whenever one assignment
    // reads a field an earlier assignment writes. Witness — LRE CalcCPA.java:
    //     :39  this.tcpa = ...;                 // written first
    //     :44  this.cda  = sqrt(... this.tcpa ...);   // reads the fresh tcpa
    // but the field declarations are `cda` (:26) then `tcpa` (:29), so the
    // emitted SeqStatement ran `cda` FIRST and the model's `cda` was computed
    // from the PREVIOUS cycle's `tcpa` — a value the Java never uses there.
    //
    // We now record (fieldName, rhs) in SOURCE order in two parallel
    // Sequences, and keep `fieldAssignments` solely to serve the
    // completeness check Pass 3 already performs against `opVarList`.
    // Repeated assignments to the same field are each recorded, so a
    // `this.x = a; this.x = b;` body emits both statements in order (the
    // Map form silently collapsed them to the last one).
    var fieldAssignments = new Map;
    var assignedFieldOrder = new Sequence;   // fieldName, in source order
    var assignedRhsOrder = new Sequence;     // parallel: Spoon RHS expression
    for (stmt in bodyBlock.statement) {
        if (stmt.isTypeOf(Spoon!CtAssignment)) {
            var lhs = stmt.assigned;
            if (lhs.isDefined() and (lhs.isKindOf(Spoon!CtFieldWrite) or lhs.isKindOf(Spoon!CtFieldAccess))) {
                var varRef = lhs.variable;
                if (varRef.isDefined()) {
                    var fieldName = getFeature(varRef, "name");
                    var rhs = stmt.assignment;
                    if (fieldName.isDefined() and rhs.isDefined()) {
                        fieldAssignments.put(fieldName, rhs);
                        assignedFieldOrder.add(fieldName);
                        assignedRhsOrder.add(rhs);
                    }
                }
            }
        }
    }

    // Pass 3a: PER-VARIABLE completeness classification (I1-SR fix).
    //
    // WHAT THIS USED TO DO, AND WHY IT WAS WRONG. This pass was a WHOLE-BODY
    // completeness check: if ANY declared output variable was not assigned
    // somewhere in compute(), it `return`ed, and the caller's fallback stubbed
    // EVERY output of the class — including the ones compute() does assign
    // with a perfectly translatable expression. The check conflated two
    // different facts: "this operation's body did not lift" (a property of the
    // body) with "this variable's value is unknown to the model" (a property of
    // one variable).
    //
    // WITNESS — sranger TurnTimer.java. Phase 6's output-field rule classifies
    // a private field with a zero-arg getter as an operation OUTPUT, so
    // TurnTimer declares two: `elapsed` (getter `elapsed()`) and `resetTime`
    // (getter `resetTime()`). But `compute()` assigns only `elapsed`;
    // `resetTime` is written by `markReset()`, which the controller calls from
    // the Moving -> Turning TRANSITION, not from compute(). Under the whole-body
    // check the emitted action was
    //     action resetTime = 0 ; elapsed = false
    // so `elapsed` — whose Java RHS
    //     cycleClock.nowMs() - this.resetTime >= SRangerConstants.turnDurationMs
    // translates fine — arrived in the model as the literal `false`. That in turn
    // put `elapsed` in `stubbedOpVarNames`, which made Phase 6a-ctrl refuse to
    // lift `SRangerController.turnDurationElapsed = turnTimer.elapsed()`,
    // leaving the last I1 data-lens unassigned.
    //
    // WHAT IT DOES NOW. Each declared output is classified on its own:
    //   * ASSIGNED in compute() -> carries its real translated expression
    //     (built by Pass 3b below, in Java source order);
    //   * NOT ASSIGNED in compute() -> stubbed INDIVIDUALLY (`x = 0` /
    //     `x = false` via createAssignment, the same placeholder the whole-body
    //     fallback used) and recorded in `stubbedOpVarNames`, so every consumer
    //     that already refuses to build on a stub — notably the Phase 6a-ctrl
    //     lift guard — keeps refusing for exactly that variable and no other.
    //
    // WHAT DID NOT CHANGE. The OTHER abort paths are still whole-body, and
    // deliberately so: a conditional/loop/return body (pre-check above), an
    // untranslatable method chain, or a translateSpoonExpr failure (Pass 3b)
    // each mean we could not read the body's CONTROL FLOW or an expression we
    // were supposed to render, so no assignment in it can be trusted. An
    // unassigned declared output is different in kind — it says nothing about
    // the assignments that ARE there. Only that one case is now per-variable.
    //
    // BLAST RADIUS (measured across all three case studies). TurnTimer is the
    // only operation class with a partial compute(): lre CalcCDyn {cdyn},
    // CalcCPA {cda,tcpa}, CalcCStc {cstc}, CalcVel {hvel,vel,vvel} and
    // CheckOPEZ {inOpez} assign every declared output, and chemical_detector's
    // ChangeDirection declares none. So the five total classes take the
    // `unassignedOutputs.size() == 0` path and their emission is unchanged.
    var opVarByName = new Map;
    var unassignedOutputs = new Sequence;   // RoboChart Variables, declaration order
    // `className` in the Phase 6 loop is caller-scope and NOT visible here;
    // re-derive it from the parameter for the log lines below.
    var ecbClassName = getFeature(cls, "name");
    if (ecbClassName.isUndefined()) { ecbClassName = "<anonymous>"; }
    for (opVar in opVarList.vars) {
        var fieldName = opVar.name;
        opVarByName.put(fieldName, opVar);
        if (not fieldAssignments.containsKey(fieldName)) {
            unassignedOutputs.add(opVar);
            ("[i1-op] " + ecbClassName + "." + fieldName + ": declared an operation "
                + "output (private field with a zero-arg getter) but compute() "
                + "does not assign it — stubbed INDIVIDUALLY; the outputs "
                + "compute() does assign keep their real expressions").println();
        }
    }

    // Pass 3b (stage 1): index the assigned outputs and collect each RHS's
    // READ NAMES at the JAVA level, in source order (U3 fix). Fields assigned
    // in the body but not declared as output variables are skipped, exactly as
    // before (Pass 3 only ever iterated `opVarList`).
    //
    // NOTHING IS TRANSLATED YET, deliberately: stage 2 decides which
    // assignments may keep a real expression, and a RoboChart expression built
    // for an assignment that stage 2 then discards would be serialised into
    // robochart_model.xmi as an orphan root object (see the header comment on
    // collectSpoonReadNames for the measured consequence). The whole-body abort
    // checks that used to live in this loop move to stage 3, where they run
    // only for the assignments actually being emitted.
    var xlFieldOrder = new Sequence;     // output name, source order
    var xlSpoonOrder = new Sequence;     // parallel: Spoon RHS expression
    var xlReadsOrder = new Sequence;     // parallel: OrderedSet of Java read names
    for (i in Sequence{0..assignedFieldOrder.size() - 1}) {
        if (assignedFieldOrder.size() == 0) { break; }   // Sequence{0..-1} is not empty
        var fieldName = assignedFieldOrder.at(i);
        if (not opVarByName.containsKey(fieldName)) {
            continue;
        }
        var spoonRhs = assignedRhsOrder.at(i);
        var spoonReads = new OrderedSet;
        collectSpoonReadNames(spoonRhs, spoonReads);
        xlFieldOrder.add(fieldName);
        xlSpoonOrder.add(spoonRhs);
        xlReadsOrder.add(spoonReads);
    }

    // Pass 3b (stage 2): TRANSITIVE STUB CLOSURE.
    //
    // WHY THIS IS NOT OPTIONAL — measured, not hypothesised. Per-variable
    // stubbing without this closure was run end-to-end on sranger and the
    // artefacts were inspected. TurnTimer.compute() assigns
    //     this.elapsed = cycleClock.nowMs() - this.resetTime >= turnDurationMs
    // whose RHS READS `resetTime` — the output that compute() does NOT assign
    // and that we have just stubbed to `0`. Emitting `elapsed`'s real
    // expression alongside that stub produced, in the `.rct`,
    //     action resetTime = 0 ; elapsed = nowMs - resetTime >= turndurationms
    // and, after the Isabelle template's data-plane inlining (which substitutes
    // each definition into its readers),
    //     turnDurationElapsed\<Zprime> = ((nowMs() - (0)) \<ge> turndurationms())
    // The Java predicate is "at least turnDurationMs has passed SINCE THE LAST
    // Turning ENTRY". That clause says "since the epoch" — the stub `0` reached
    // the theory dressed as the Java's reset timestamp. It is not a frozen
    // lens and not an under-approximation; it is a substituted value asserted
    // as the program's semantics, which is the precise failure mode the
    // pre-existing `stubbedOpVarNames` guard at Phase 6a-ctrl exists to
    // prevent. The guard was simply one level too high: it screened the
    // CONTROLLER's lift while the operation body could still splice a stub in
    // BELOW it.
    //
    // So an output keeps its real expression only if NOTHING it reads is
    // stubbed, transitively. `stubbed` starts as the unassigned outputs plus
    // the module-level `stubbedOpVarNames` (outputs of operation classes
    // already processed), and grows to a fixpoint: any assignment reading a
    // stubbed name becomes stubbed itself, and its own readers follow. The
    // loop terminates because `stubbed` only grows and is bounded by the
    // declared outputs; the `while` re-scans rather than ordering the graph,
    // so it is correct regardless of source order or read direction.
    //
    // CONSEQUENCE FOR SRANGER — stated plainly. `elapsed` reads `resetTime`,
    // so `elapsed` is stubbed too, TurnTimer's emission is unchanged, and
    // Phase 6a-ctrl's existing `stubbedOpVarNames` guard still refuses
    // `turnDurationElapsed`. Per-variable stubbing is therefore NOT sufficient
    // to close the SRanger lens: the blocker is not the whole-body check, it is
    // that `resetTime` — the datum the predicate is relative to — is written by
    // `markReset()` from a TRANSITION and is genuinely absent from the data
    // plane. Closing it needs transition-written operation state to reach the
    // data plane, which is a different fix. This pass is kept because it is
    // the correct per-variable semantics and it makes the residual blocker
    // precise (`resetTime`, not "the body"), but it is not the I1 close.
    //
    // CROSS-CLASS LIMITATION. `stubbedOpVarNames` accumulates in Phase 6's
    // `Spoon!CtClass.all` iteration order, so a class read BEFORE its stubbed
    // producer is processed would not see that producer's stub. No operation
    // body in the three case studies reads another operation class's output
    // (verified from the `.rct` action RHSs), so this cannot mis-emit today;
    // it needs a pre-pass over all bodies to close in general.
    //
    // The size guards on the index loops below are load-bearing, not
    // defensive noise, and for the reason already documented at Phase
    // 6a-ctrl: Epsilon's `Sequence{0..-1}` is NOT empty — it iterates 0 then
    // -1 — so an empty `xlFieldOrder` (every declared output unassigned, or a
    // class declaring no outputs at all, e.g. chemical_detector's
    // ChangeDirection) would index a zero-length sequence and abort the whole
    // M2M phase.
    var stubbed = new OrderedSet;
    for (uv in unassignedOutputs) { stubbed.add(uv.name); }
    for (sn in stubbedOpVarNames) {
        if (opVarByName.containsKey(sn)) { stubbed.add(sn); }
    }
    var closureChanged = xlFieldOrder.size() > 0;
    while (closureChanged) {
        closureChanged = false;
        for (xi in Sequence{0..xlFieldOrder.size() - 1}) {
            var xName = xlFieldOrder.at(xi);
            if (stubbed.includes(xName)) { continue; }
            var tainted = new OrderedSet;
            for (rn in xlReadsOrder.at(xi)) {
                if (stubbed.includes(rn)) { tainted.add(rn); }
            }
            if (tainted.size() > 0) {
                stubbed.add(xName);
                closureChanged = true;
                ("[i1-op] " + ecbClassName + "." + xName + ": compute() assigns "
                    + "it, but its RHS reads stubbed output(s) "
                    + tainted.concat(", ") + " — emitting the real expression "
                    + "would splice a stub placeholder in as if it were the "
                    + "Java's value — stubbed too").println();
            }
        }
    }
    // Pass 3b (stage 3): TRANSLATE the survivors first, then emit.
    //
    // Translation runs BEFORE any stub object is created so that a whole-body
    // abort (method chain / translateSpoonExpr failure) leaves NO RoboChart
    // object behind: on that path the caller's fallback creates all the stubs
    // itself, and a stub built here would be an orphan in the XMI. The
    // `stubbedOpVarNames` additions likewise happen only after the last abort
    // point — and re-adding on the abort path would be harmless anyway, since
    // the caller adds every output to that same OrderedSet.
    var realNames = new Sequence;    // survivor output names, Java source order
    var realRhs = new Sequence;      // parallel: translated RoboChart RHS
    for (xi2 in Sequence{0..xlFieldOrder.size() - 1}) {
        if (xlFieldOrder.size() == 0) { break; }   // see Sequence{0..-1} note above
        var xName2 = xlFieldOrder.at(xi2);
        if (stubbed.includes(xName2)) { continue; }
        var spoonRhs2 = xlSpoonOrder.at(xi2);

        // Detect untranslatable Java patterns: method chains (e.g. result.map(...).orElse(-1))
        // are CtInvocation whose target is also a CtInvocation. These cannot be faithfully
        // rendered in RoboChart; fall back to stubs for the entire operation.
        // Still WHOLE-BODY (see the stage-2 header): an unreadable expression
        // says nothing trustworthy about the rest of the body.
        if (spoonRhs2.isKindOf(Spoon!CtInvocation)) {
            var rhsTarget = getFeature(spoonRhs2, "target");
            if (rhsTarget.isDefined() and rhsTarget.isKindOf(Spoon!CtInvocation)) {
                computeLocalVarInits = new Map;
                return;
            }
        }

        var rcRhs = translateSpoonExpr(spoonRhs2);
        if (rcRhs.isUndefined()) {
            // Translation failed — abort, fall back to stubs
            computeLocalVarInits = new Map;
            return;
        }
        realNames.add(xName2);
        realRhs.add(rcRhs);
    }

    // Past every abort point. Stubs go FIRST, in DECLARATION order — that
    // position is not semantically load-bearing (a stub RHS is a literal with
    // no reads), and it makes the all-stub case byte-identical to the previous
    // whole-body fallback, which also iterated `opVarList.vars`. Real
    // assignments follow in Java source order, exactly as before.
    var rcAssignments = new Sequence;
    for (opVarE in opVarList.vars) {
        if (not stubbed.includes(opVarE.name)) { continue; }
        rcAssignments.add(createAssignment(opVarE));
        stubbedOpVarNames.add(opVarE.name);
    }
    for (ri in Sequence{0..realNames.size() - 1}) {
        if (realNames.size() == 0) { break; }   // see Sequence{0..-1} note above
        var assign = new RoboChart!Assignment;
        var vref = new RoboChart!VarRef;
        vref.name = opVarByName.get(realNames.at(ri));
        assign.left = vref;
        assign.right = realRhs.at(ri);
        rcAssignments.add(assign);
    }

    // Clear local var map
    computeLocalVarInits = new Map;

    if (rcAssignments.size() == 0) {
        return;
    } else if (rcAssignments.size() == 1) {
        return rcAssignments.at(0);
    } else {
        var seq = new RoboChart!SeqStatement;
        for (a in rcAssignments) {
            seq.statements.add(a);
        }
        return seq;
    }
}

// Build a RoboChart!Function for `fname`, inferring the parameter name,
// parameter type and return type from the matching Java method's DECLARED
// types via mapJavaTypeToRcTypeRef.
//
// I2 FIX (signature inference for operation-body functions). This body used
// to exist ONLY on the guard-discovery path (Phase 5b). Phase 6b — which
// declares functions discovered inside operation BODIES — instead hardcoded
//     function <name> ( x : real ) : real
// with no Java type inference at all, so the `.rct` said
//     function nsRelDist ( x : real ) : real
// while the Java says `double nsRelDist(@RoboChartType("nat") int index)`.
// Pre-I1 that mismatch was inert: those four LRE functions (nsRelDist,
// ewRelDist, obsNsVel, obsEwVel) were declared and applied ZERO times, so
// nothing could disagree with the wrong domain. The I1 data-plane inlining
// APPLIES them — to `cdyn`, an `int` variable — which makes the wrong domain
// live and forced the Isabelle template to patch the domain to `int` at its
// own emission site, leaving the `.rct`/CSP and the theory disagreeing on
// four signatures.
//
// Extracting the inference here (rather than writing a second inferencer)
// keeps ONE derivation of a RoboChart function signature from Java. Types
// come from the Java DECLARED types only: the `@RoboChartType` annotations on
// those parameters are deliberately NOT consulted — audit finding A-4
// established that annotation is read only by StructuralLinter and
// coverage.py, and making it a semantic input here would add a second,
// competing source of truth for typing.
//
// Fallbacks are exactly the guard path's previous ones: parameter name "x"
// and type `real` when no Java method matches (e.g. `sqrt`, which resolves to
// java.lang.Math and is absent from the Spoon model), and return type `real`
// on the same condition. Only the FIRST Java parameter is mapped, matching
// the previous guard-path behaviour.
operation buildInferredFunction(fname : String, enumTypeMap : Map,
                                 recordTypeMap : Map, rcPackage : Any) : Any {
    var func = new RoboChart!Function;
    func.name = fname;

    // Find matching Java method for type inference. Functions are
    // synthesised only for arg-carrying CallExps, so prefer an explicit
    // method WITH parameters over an implicit record accessor of the same
    // simple name (see findJavaMethodForFunction). The zero-arg Sensors
    // lift (Phase 6b) keeps the plain lookup — zero-arg reads are exactly
    // where an accessor IS the right declaration.
    var javaMethod = findJavaMethodForFunction(fname);

    // Infer parameter type from Java method signature. Reuses the generic
    // mapJavaTypeToRcTypeRef helper so that enums, records, and
    // parameterized collections (List<X> -> Seq(X)) all surface correctly
    // instead of falling through to the `real` default.
    // FIX (2026-09-19). This block read only javaParams.first() and added
    // exactly ONE RoboChart Parameter, so EVERY multi-argument Java method was
    // modelled as unary. The theory generator's own CASE 2 (multiple
    // parameters, `a \<times> b \<Rightarrow> r`) was therefore unreachable
    // from inferred functions: `double tcpaFrom(double approachDot, double
    // relSpeedSq)` emitted `consts tcpaFrom :: "real \<Rightarrow> real"` while
    // the call site passed two arguments, and Isabelle failed with
    // "Type unification failed: Clash of types _ x _ and R". Found by the
    // autonomous arm's lre run-5. Emit one Parameter per Java parameter; the
    // single-parameter case is unchanged (the loop runs once).
    var javaParamList;
    if (javaMethod.isDefined()) {
        javaParamList = getFeature(javaMethod, "parameter");
    }
    var nParams = 0;
    if (javaParamList.isDefined()) { nParams = javaParamList.size(); }
    if (nParams = 0) {
        // No signature resolved: keep the historical single `real` placeholder
        // rather than emitting a zero-parameter function, which would change
        // the shape of every previously-inferred nullary-lookup function.
        var paramType0 = new RoboChart!PrimitiveType;
        paramType0.name = "real";
        rcPackage.types.add(paramType0);
        var paramRcType0 = new RoboChart!TypeRef;
        paramRcType0.ref = paramType0;
        var param0 = new RoboChart!Parameter;
        param0.name = "x";
        param0.type = paramRcType0;
        func.parameters.add(param0);
    } else {
        var pi = 0;
        while (pi < nParams) {
            var jp = javaParamList.at(pi);
            var paramName = "x" + pi.asString();
            var paramRcType;
            var jpName = getFeature(jp, "name");
            if (jpName.isDefined() and jpName <> "") { paramName = jpName; }
            var jpTypeRef = getFeature(jp, "type");
            if (jpTypeRef.isDefined()) {
                var jpTypeName = getFeature(jpTypeRef, "name");
                if (jpTypeName.isDefined()) {
                    var jpElem = "";
                    var jpArgs = getFeature(jpTypeRef, "typeArgument");
                    if (jpArgs.isDefined() and jpArgs.size() > 0) {
                        var ja = jpArgs.first();
                        if (ja.isDefined()) {
                            var jaName = getFeature(ja, "name");
                            if (jaName.isDefined()) { jpElem = jaName; }
                        }
                    }
                    paramRcType = mapJavaTypeToRcTypeRef(jpTypeName, jpElem,
                            enumTypeMap, recordTypeMap, rcPackage);
                }
            }
            if (paramRcType.isUndefined()) {
                var paramTypeF = new RoboChart!PrimitiveType;
                paramTypeF.name = "real";
                rcPackage.types.add(paramTypeF);
                paramRcType = new RoboChart!TypeRef;
                paramRcType.ref = paramTypeF;
            }
            var param = new RoboChart!Parameter;
            param.name = paramName;
            param.type = paramRcType;
            func.parameters.add(param);
            pi = pi + 1;
        }
    }

    // Infer return type from Java method signature. Same helper and same
    // fallback as the parameter type, so enum returns (`Status`, `Angle`) and
    // record returns (`Intensity`) come through with proper TypeRefs instead
    // of `real`.
    var retRcType;
    if (javaMethod.isDefined()) {
        var jRetTypeRef = getFeature(javaMethod, "type");
        if (jRetTypeRef.isDefined()) {
            var jRetTypeName = getFeature(jRetTypeRef, "name");
            if (jRetTypeName.isDefined()) {
                var jRetElem = "";
                var jRetArgs = getFeature(jRetTypeRef, "typeArgument");
                if (jRetArgs.isDefined() and jRetArgs.size() > 0) {
                    var jr = jRetArgs.first();
                    if (jr.isDefined()) {
                        var jrName = getFeature(jr, "name");
                        if (jrName.isDefined()) { jRetElem = jrName; }
                    }
                }
                retRcType = mapJavaTypeToRcTypeRef(jRetTypeName, jRetElem,
                        enumTypeMap, recordTypeMap, rcPackage);
            }
        }
    }
    if (retRcType.isUndefined()) {
        var retType = new RoboChart!PrimitiveType;
        retType.name = "real";
        rcPackage.types.add(retType);
        retRcType = new RoboChart!TypeRef;
        retRcType.ref = retType;
    }
    func.type = retRcType;

    return func;
}

// Find a Java method by name in the Spoon model.
// Returns the first matching CtMethod or null if not found.
operation findJavaMethodByName(name : String) : Any {
    for (m in Spoon!CtMethod.all) {
        if (getFeature(m, "name") == name) {
            return m;
        }
    }
    return null;
}

// FIX (2026-09-14). Java allows several methods with one simple name;
// the model can also carry IMPLICIT record-component accessors under the
// same name (chem: `Obstacle.location(): Loc`, isImplicit, 0 params, vs
// `GasSensorService.location(GasSensorReading): Angle`). The plain
// first-match lookup returned the accessor, so the uninterpreted function
// was emitted as a chimera `location (x : real) : Loc` — return from the
// accessor, parameter from the no-params fallback — and BOTH CSP-M
// (Loc vs Angle at `set_anl!location(gs)`) and Isabelle
// (GasSensorReading_scheme vs real) rejected the artefacts. Functions are
// only synthesised for arg-carrying CallExps (see collectFunctionNames),
// so the right declaration is: explicit method WITH parameters first,
// then any explicit method, then the implicit accessor as a last resort.
operation findJavaMethodForFunction(name : String) : Any {
    var explicitWithParams = null;
    var explicitAny = null;
    var implicitAny = null;
    for (m in Spoon!CtMethod.all) {
        if (getFeature(m, "name") <> name) { continue; }
        var isImp = getFeature(m, "isImplicit");
        var ps = getFeature(m, "parameter");
        var hasParams = ps.isDefined() and ps.size() > 0;
        if (isImp.isDefined() and isImp == true) {
            if (implicitAny.isUndefined()) { implicitAny = m; }
        } else {
            if (hasParams and explicitWithParams.isUndefined()) { explicitWithParams = m; }
            if (explicitAny.isUndefined()) { explicitAny = m; }
        }
    }
    if (explicitWithParams.isDefined()) { return explicitWithParams; }
    if (explicitAny.isDefined()) { return explicitAny; }
    return implicitAny;
}

// FIX (2026-09-14). Step-body LOCALS (e.g. chem's
// `boolean intensityAtOrAboveThreshold = sensor.goreq(...)`) surface as
// bare names in guards and get lifted into Sensors, but they are not
// methods — findJavaMethodByName returns null and the lift fell to the
// `nat` default, so a boolean local typed `nat` and CSP-M failed
// Bool-vs-Int at `condition intensityAtOrAboveThreshold`. Resolve the
// declared type of a local by name so the lift can type it correctly.
operation findJavaLocalByName(name : String) : Any {
    for (lv in Spoon!CtLocalVariable.all) {
        if (getFeature(lv, "name") == name) {
            return lv;
        }
    }
    // FIX (2026-09-18). This resolver fed the Phase 6b zero-arg lift's type
    // inference and saw ONLY CtLocalVariable, so a name that is a METHOD
    // PARAMETER (`void compute(Angle commanded) { this.a = commanded; }`)
    // resolved to null, the inference chain never reached its enum branch, and
    // the lifted variable took the `nat` default while assignments wrote enum
    // literals into it. Same defect class as the enum-RETURNING-method fix on
    // the parameter path.
    //
    // SCOPED TO ENUM-TYPED PARAMETERS ONLY, and this scope is load-bearing. A
    // first version returned ANY matching CtParameter, which regressed chem
    // run-2: `lv`, `stuckDist` and `stuckPeriod` are accessor names on the
    // constants class whose CONSTRUCTOR PARAMETERS share those names. Resolving
    // to those parameters made the lift use the declared Java type
    // (double->real, int->int) instead of falling through to the `nat` default
    // that agrees with constantTypeMap's deliberate int->nat mapping (line
    // ~166), silently retyping three recorded variables. Primitive-typed
    // parameters must therefore keep resolving to null here.
    //
    // Returning only enum-typed parameters cannot regress a primitive: the
    // enum branch is the sole consumer that reads this result for a
    // non-primitive type, and `@RoboChartType` is deliberately not a semantic
    // input (audit finding A-4).
    for (pv in Spoon!CtParameter.all) {
        if (getFeature(pv, "name") == name) {
            var pvType = getFeature(pv, "type");
            if (pvType.isDefined()) {
                var pvTypeName = getFeature(pvType, "name");
                if (pvTypeName.isDefined() and enumNamesForParamLookup.includes(pvTypeName)) {
                    return pv;
                }
            }
        }
    }
    return null;
}

// Collect function names from RoboChart guard expressions (CallExp nodes with arguments).
// Only includes CallExp that have at least one argument (true function calls like odist(cstc)),
// not bare variable references (like vel, hvel) which also use CallExp but with no args.
operation collectFunctionNames(expr : Any, names : OrderedSet) {
    if (expr.isUndefined()) { return; }
    if (expr.isKindOf(RoboChart!CallExp)) {
        // Use reflective access for args (containment collection)
        var argsF = expr.eClass().getEStructuralFeature("args");
        var argsList = null;
        if (argsF.isDefined()) {
            argsList = expr.eGet(argsF);
        }
        // Only treat as function if it has arguments (not a bare variable reference)
        if (argsList.isDefined() and argsList.size() > 0) {
            var funcExpr = getRcFeature(expr, "function");
            if (funcExpr.isDefined() and funcExpr.isKindOf(RoboChart!StringExp)) {
                names.add(funcExpr.value);
            }
            for (arg in argsList) {
                collectFunctionNames(arg, names);
            }
        }
        return;
    }
    // FIX (2026-09-14). The generic tail below used to probe only
    // {left, right} (with And/Or/Not special-cased above it), so any
    // expression class carrying its child under a different feature hid
    // every call beneath it. Observed live on LRE run-1 v2: the codegen
    // wrote `tcpa = -(nsRelDist(cdyn) * ... + ewRelDist(cdyn) * ...)` — a
    // UNARY minus (child feature `exp`) — and exactly those two names
    // never reached the function-declaration list, while `obsNsVel`
    // (under a BINARY minus, features left/right) did. csp-gen then
    // failed on unresolved NamedExpressions, cascading fdr4 to
    // no-verdict. Descend reflectively over ALL containment features
    // (the collectAllRcCallExpNames pattern) so no metamodel expression
    // class can hide a call; the args>0 filter above is unchanged — the
    // zero-arg partition still routes to the Sensors path.
    for (f in expr.eClass().getEAllReferences()) {
        if (not f.isContainment()) { continue; }
        var val = expr.eGet(f);
        if (val.isUndefined()) { continue; }
        if (f.isMany()) {
            for (child in val) {
                if (child.isDefined() and child.isKindOf(RoboChart!Expression)) {
                    collectFunctionNames(child, names);
                }
            }
        } else {
            if (val.isKindOf(RoboChart!Expression)) {
                collectFunctionNames(val, names);
            }
        }
    }
}

// Collect function names from RoboChart action statements (Assignment, SeqStatement).
// Delegates to collectFunctionNames for the expression trees inside assignments.
operation collectFunctionNamesFromAction(stmt : Any, names : OrderedSet) {
    if (stmt.isUndefined()) { return; }
    if (stmt.isKindOf(RoboChart!SeqStatement)) {
        for (s in stmt.statements) {
            collectFunctionNamesFromAction(s, names);
        }
        return;
    }
    if (stmt.isKindOf(RoboChart!Assignment)) {
        collectFunctionNames(stmt.right, names);
        return;
    }
}

// Collect zero-arg CallExp names from RoboChart action statements.
// These represent sensor methods with no parameters (e.g. closestStaticIndex()).
operation collectZeroArgFuncNamesFromAction(stmt : Any, names : OrderedSet) {
    if (stmt.isUndefined()) { return; }
    if (stmt.isKindOf(RoboChart!SeqStatement)) {
        for (s in stmt.statements) {
            collectZeroArgFuncNamesFromAction(s, names);
        }
        return;
    }
    if (stmt.isKindOf(RoboChart!Assignment)) {
        collectZeroArgCallExpNames(stmt.right, names);
        return;
    }
}

// I1 (remainder): collect EVERY CallExp name in a RoboChart expression tree,
// of any arity, recursing through all containment features rather than a fixed
// {left, right, exp, args} list.
//
// The two pre-existing collectors are each deliberately partial —
// `collectFunctionNames` takes only CallExps WITH arguments and
// `collectZeroArgCallExpNames` only those WITHOUT — because each feeds a
// different declaration path (Function vs Sensors variable). The
// controller-field lifting pass needs a TOTAL name set instead: it uses the
// names to decide whether an expression is safe to lift at all (does it read
// a stubbed placeholder? did translation give up and leave `unknown_expr`?),
// and a name missed by a partial collector would be a lift wrongly allowed.
// Reflective iteration over eClass features means a metamodel expression class
// this file does not enumerate cannot silently hide a name from the check.
operation collectAllRcCallExpNames(expr : Any, names : OrderedSet) {
    if (expr.isUndefined()) { return; }
    if (expr.isKindOf(RoboChart!CallExp)) {
        var funcExpr = getRcFeature(expr, "function");
        if (funcExpr.isDefined() and funcExpr.isKindOf(RoboChart!StringExp)) {
            names.add(funcExpr.value);
        }
    }
    for (f in expr.eClass().getEAllReferences()) {
        if (not f.isContainment()) { continue; }
        var val = expr.eGet(f);
        if (val.isUndefined()) { continue; }
        if (f.isMany()) {
            for (child in val) {
                if (child.isDefined() and child.isKindOf(RoboChart!Expression)) {
                    collectAllRcCallExpNames(child, names);
                }
            }
        } else {
            if (val.isKindOf(RoboChart!Expression)) {
                collectAllRcCallExpNames(val, names);
            }
        }
    }
}

// Collect zero-arg CallExp names from a RoboChart expression tree.
operation collectZeroArgCallExpNames(expr : Any, names : OrderedSet) {
    if (expr.isUndefined()) { return; }
    if (expr.isKindOf(RoboChart!CallExp)) {
        var argsF = expr.eClass().getEStructuralFeature("args");
        var argsList = null;
        if (argsF.isDefined()) { argsList = expr.eGet(argsF); }
        if (argsList.isUndefined() or argsList.size() == 0) {
            var funcExpr = getRcFeature(expr, "function");
            if (funcExpr.isDefined() and funcExpr.isKindOf(RoboChart!StringExp)) {
                names.add(funcExpr.value);
            }
        } else {
            // Recurse into arguments of non-zero-arg calls
            for (arg in argsList) {
                collectZeroArgCallExpNames(arg, names);
            }
        }
        return;
    }
    // Recurse into binary/unary operators
    for (featName in Sequence{"left", "right", "exp"}) {
        var child = getRcFeature(expr, featName);
        if (child.isDefined()) {
            collectZeroArgCallExpNames(child, names);
        }
    }
}

// =====================================================================
// Helper operations
// =====================================================================

operation findModeEnum() : Any {
    for (e in Spoon!CtEnum.all) {
        for (suffix in enumSuffixes) {
            if (e.name.endsWith(suffix)) {
                return e;
            }
        }
    }
}

// Find the mode enum for a specific controller class by inspecting the
// type of its mode field (one of `modeFieldName`, "mode", "currentMode").
// Returns the CtEnum, or undefined if the controller has no enum-typed mode field.
operation findModeEnumForController(c : Any) : Any {
    var fieldCandidates = Sequence{modeFieldName, "mode", "currentMode"};
    for (tm in c.typeMember) {
        if (not tm.isKindOf(Spoon!CtField)) { continue; }
        var fName = getFeature(tm, "name");
        if (fName.isUndefined()) { continue; }
        if (not fieldCandidates.includes(fName)) { continue; }
        var fType = getFeature(tm, "type");
        if (fType.isUndefined()) { continue; }
        var fTypeName = getFeature(fType, "name");
        if (fTypeName.isUndefined()) { continue; }
        // Resolve the enum by name (CtTypeReference doesn't carry the
        // declaration; look it up among the model's CtEnums).
        for (e in Spoon!CtEnum.all) {
            if (e.name == fTypeName) {
                return e;
            }
        }
    }
}

// Find the actual mode-field name on a controller (in case the class
// uses "mode" rather than the default modeFieldName="currentMode").
// Returns the field name string, or modeFieldName as fallback.
operation findModeFieldName(c : Any) : String {
    var fieldCandidates = Sequence{modeFieldName, "mode", "currentMode"};
    for (tm in c.typeMember) {
        if (not tm.isKindOf(Spoon!CtField)) { continue; }
        var fName = getFeature(tm, "name");
        if (fName.isUndefined()) { continue; }
        if (not fieldCandidates.includes(fName)) { continue; }
        var fType = getFeature(tm, "type");
        if (fType.isUndefined()) { continue; }
        var fTypeName = getFeature(fType, "name");
        if (fTypeName.isUndefined()) { continue; }
        for (e in Spoon!CtEnum.all) {
            if (e.name == fTypeName) {
                return fName;
            }
        }
    }
    return modeFieldName;
}

operation findControllerClass() : Any {
    // Prefer a class that has BOTH a step() method AND an enum-typed
    // mode field. This avoids picking a dispatch-only class (e.g.,
    // ChemicalDetector in the chemical_detector case study) that has
    // step() but no mode field of its own.
    for (c in Spoon!CtClass.all) {
        if (findStepMethod(c).isDefined()
                and findModeEnumForController(c).isDefined()) {
            return c;
        }
    }
    // Fallback: any class with step() (legacy behaviour).
    for (c in Spoon!CtClass.all) {
        if (findStepMethod(c).isDefined()) {
            return c;
        }
    }
}

// Find every controller class that has both step() and an enum-typed
// mode field. Used by the multi-controller extraction loop in the pre
// block to emit one RoboChart!StateMachineDef per controller.
operation findAllControllerClasses() : Sequence {
    var result = new Sequence;
    for (c in Spoon!CtClass.all) {
        if (findStepMethod(c).isDefined()
                and findModeEnumForController(c).isDefined()) {
            result.add(c);
        }
    }
    return result;
}

// Find the initial mode from the currentMode field's default expression.
// e.g. "private MyMode currentMode = MyMode.INITIAL;" -> "INITIAL"
// Spoon stores the initialiser in either defaultExpression (CtVariable) or
// assignment (CtRHSReceiver) depending on the CtRole; we check both.
operation findInitialModeName(classDecl : Any) : String {
    var actualField = findModeFieldName(classDecl);
    for (tm in classDecl.typeMember) {
        if (tm.isKindOf(Spoon!CtField)) {
            if (getFeature(tm, "name") == actualField) {
                var initExpr = getFeature(tm, "defaultExpression");
                if (initExpr.isUndefined()) {
                    initExpr = getFeature(tm, "assignment");
                }
                if (initExpr.isDefined()) {
                    var enumName = extractEnumLiteralName(initExpr);
                    if (enumName.isDefined()) {
                        return enumName;
                    }
                }
            }
        }
    }
    return "";
}

operation findStepMethod(classDecl : Any) : Any {
    for (tm in classDecl.typeMember) {
        if (tm.isTypeOf(Spoon!CtMethod) and tm.name == stepMethodName) {
            return tm;
        }
    }
}

// Create a RoboChart transition and add it to the state machine.
// Returns the updated transition counter.
// spoonCtIf: the Spoon CtIf element that generated this transition (for fine-grained tracing)
operation createTransition(stm : Any, stateMap : Map, sourceName : String,
        targetName : String, eventTypeName : String,
        eventMap : Map, tCount : Integer, guardConjuncts : Sequence,
        predDefs : Map, spoonCtIf : Any) : Integer {
    var trans = new RoboChart!Transition;
    trans.name = "t" + tCount.toString();
    trans.source = stateMap.get(sourceName);
    trans.target = stateMap.get(targetName);

    if (eventTypeName <> "") {
        var evt = getOrCreateEvent(eventTypeName, eventMap, stm);
        // Official metamodel: Transition.trigger is Communication (not Trigger)
        var triggerComm = new RoboChart!Communication;
        triggerComm.event = evt;
        setCommunicationType(triggerComm, "SIMPLE");
        trans.trigger = triggerComm;
    }

    // Attach guard condition from unconsumed conjuncts (E2/E3 fix)
    if (guardConjuncts.size() > 0) {
        trans.condition = buildGuardExpression(tCount, guardConjuncts, predDefs);
    }

    stm.transitions.add(trans);

    // Trace: if-else branch in step() → RoboChart Transition
    var te = new Map;
    te.put("robochart_type", "Transition");
    te.put("robochart_element", trans.name);
    te.put("source_state", sourceName);
    te.put("target_state", targetName);
    te.put("java_element", stm.name + ".step");
    te.put("java_type", "CtMethod");
    if (eventTypeName <> "") {
        te.put("trigger_event", eventTypeName);
    }
    // Fine-grained source position from the CtIf element
    if (spoonCtIf.isDefined() and sourcePositionMap.isDefined() and sourcePositionMap.containsKey(spoonCtIf)) {
        var pos = sourcePositionMap.get(spoonCtIf);
        te.put("java_line_start", pos.at(0).toString());
        te.put("java_line_end", pos.at(1).toString());
    }
    traceEntries.add(te);

    return tCount + 1;
}

// Check if an expression refers to the controller's mode field.
// Accepts any of the canonical field names (modeFieldName, "mode",
// "currentMode") so that controllers using a non-default name (e.g.
// GasAnalysisController.mode) still match. Each controller has only
// one such field, so the broader match is safe.
operation isCurrentModeRef(expr : Any) : Boolean {
    if (expr.isUndefined()) {
        return false;
    }
    var fieldCandidates = Sequence{modeFieldName, "mode", "currentMode"};
    // In Spoon, field reads/writes have a "variable" reference with a name.
    // Use getFeature() for "name" because it's inherited and Epsilon may not
    // resolve inherited properties on dynamic EObjects via direct dot-access.
    // Check both read and write variants (CtFieldRead for conditions, CtFieldWrite for assignments).
    if (expr.isKindOf(Spoon!CtFieldRead) or expr.isKindOf(Spoon!CtFieldWrite)) {
        var varRef = expr.variable;
        if (varRef.isDefined()) {
            return fieldCandidates.includes(getFeature(varRef, "name"));
        }
    }
    if (expr.isKindOf(Spoon!CtVariableRead) or expr.isKindOf(Spoon!CtVariableWrite)) {
        var varRef = expr.variable;
        if (varRef.isDefined()) {
            return fieldCandidates.includes(getFeature(varRef, "name"));
        }
    }
    return false;
}

// Extract enum literal name from a field read expression (e.g. MyMode.S1 -> "S1")
operation extractEnumLiteralName(expr : Any) : Any {
    if (expr.isKindOf(Spoon!CtFieldRead)) {
        var varRef = expr.variable;
        if (varRef.isDefined()) {
            return getFeature(varRef, "name");
        }
    }
    if (expr.isKindOf(Spoon!CtVariableRead)) {
        var varRef = expr.variable;
        if (varRef.isDefined()) {
            return getFeature(varRef, "name");
        }
    }
}

// Get operator name from a CtBinaryOperator using reflective EMF access
operation getOpName(expr : Any) : String {
    var f = expr.eClass().getEStructuralFeature("operatorKind");
    if (f.isUndefined()) {
        return "";
    }
    var op = expr.eGet(f);
    if (op.isUndefined()) {
        return "";
    }
    return op.getName();
}

// Extract mode comparison from a binary expression (e.g. currentMode == MyMode.S1)
// Supports both EQ and NE operators via the expectedOpName parameter.
operation extractModeComparison(expr : Any, expectedOpName : String) : Any {
    if (not expr.isTypeOf(Spoon!CtBinaryOperator)) {
        return;
    }
    if (getOpName(expr) <> expectedOpName) {
        return;
    }
    var left = expr.leftOperand;
    var right = expr.rightOperand;
    if (isCurrentModeRef(left)) {
        return extractEnumLiteralName(right);
    }
    if (isCurrentModeRef(right)) {
        return extractEnumLiteralName(left);
    }
}

// Extract instanceof type name from a CtBinaryOperator with INSTANCEOF kind.
// Handles both plain instanceof (CtTypeAccess) and pattern-matching instanceof (CtTypePattern).
operation extractInstanceofType(expr : Any) : Any {
    if (not expr.isTypeOf(Spoon!CtBinaryOperator)) {
        return;
    }
    if (getOpName(expr) <> "INSTANCEOF") {
        return;
    }
    var rightOp = expr.rightOperand;
    if (rightOp.isUndefined()) {
        return;
    }
    var typeRef;
    // Plain instanceof: right operand is CtTypeAccess with accessedType
    if (rightOp.isKindOf(Spoon!CtTypeAccess)) {
        typeRef = getFeature(rightOp, "accessedType");
    }
    // Pattern-matching instanceof (Java 16+): right operand is CtTypePattern
    // with variable (CtLocalVariable) whose type gives the matched type
    if (typeRef.isUndefined() and rightOp.isKindOf(Spoon!CtTypePattern)) {
        var patternVar = rightOp.variable;
        if (patternVar.isDefined()) {
            typeRef = getFeature(patternVar, "type");
        }
    }
    if (typeRef.isDefined()) {
        var typeName = getFeature(typeRef, "name");
        if (typeName.isDefined()) {
            if (typeName.indexOf(".") >= 0) {
                typeName = typeName.substring(typeName.lastIndexOf(".") + 1);
            }
            return typeName;
        }
    }
}

// Build a guard expression for a transition's unconsumed conjuncts.
// Single simple conjunct: guard_tN (unchanged for backward compatibility)
// Multiple conjuncts (E2) or OR-containing conjuncts (E3): guard_tN_1, guard_tN_2, ...
// combined with AND between conjuncts and OR within OR-split conjuncts.
operation buildGuardExpression(tCount : Integer, guardConjuncts : Sequence, predDefs : Map) : Any {
    // Expand each conjunct: simple ones stay as singletons, OR expressions are flattened
    var parts = new Sequence;
    for (conj in guardConjuncts) {
        var orLeaves = flattenOr(conj);
        parts.add(orLeaves);
    }

    // Check if we need numbered sub-guards (multiple conjuncts or any conjunct has OR)
    var needsNumbering = guardConjuncts.size() > 1;
    if (not needsNumbering) {
        for (p in parts) {
            if (p.size() > 1) {
                needsNumbering = true;
            }
        }
    }

    if (not needsNumbering) {
        // Single conjunct, no OR: use named variable or simple guard_tN
        var leaf = parts.at(0).at(0);
        var syntheticName = "guard_t" + tCount.toString();
        return buildGuardLeafExpr(leaf, syntheticName, predDefs);
    }

    // Numbered scheme: assign sequential indices to all leaf guards
    var guardIndex = 1;
    var conjExprs = new Sequence;
    for (p in parts) {
        if (p.size() == 1) {
            // Single leaf for this conjunct: use named variable or guard_tN_K
            var syntheticName = "guard_t" + tCount.toString() + "_" + guardIndex.toString();
            var leafExpr = buildGuardLeafExpr(p.at(0), syntheticName, predDefs);
            conjExprs.add(leafExpr);
            guardIndex = guardIndex + 1;
        } else {
            // Multiple OR disjuncts: create sub-guards joined by OR
            var orExpr;
            for (leaf in p) {
                var syntheticName = "guard_t" + tCount.toString() + "_" + guardIndex.toString();
                var leafExpr = buildGuardLeafExpr(leaf, syntheticName, predDefs);
                guardIndex = guardIndex + 1;
                if (orExpr.isUndefined()) {
                    orExpr = leafExpr;
                } else {
                    var binExpr = createRcBinaryExpr("or");
                    binExpr.left = orExpr;
                    binExpr.right = leafExpr;
                    orExpr = binExpr;
                }
            }
            conjExprs.add(orExpr);
        }
    }

    // Build AND chain across conjuncts
    var andExpr;
    for (conjExpr in conjExprs) {
        if (andExpr.isUndefined()) {
            andExpr = conjExpr;
        } else {
            var binExpr = createRcBinaryExpr("and");
            binExpr.left = andExpr;
            binExpr.right = conjExpr;
            andExpr = binExpr;
        }
    }
    return andExpr;
}

// Extract a meaningful guard name from a guard leaf expression.
// Returns the variable name for CtVariableRead (local var refs), or undefined for other types.
// MUST use isTypeOf (exact match) because CtFieldRead extends CtVariableRead in spoon.ecore.
operation extractGuardLeafName(leaf : Any) : Any {
    if (leaf.isTypeOf(Spoon!CtVariableRead)) {
        var varRef = leaf.variable;
        if (varRef.isDefined()) {
            return getFeature(varRef, "name");
        }
    }
    // Negated local variable read: !inOpez
    if (leaf.isTypeOf(Spoon!CtUnaryOperator)) {
        if (getOpName(leaf) == "NOT") {
            var inner = leaf.expression;
            if (inner.isDefined() and inner.isTypeOf(Spoon!CtVariableRead)) {
                var varRef = inner.variable;
                if (varRef.isDefined()) {
                    return getFeature(varRef, "name");
                }
            }
        }
    }
}

// Build a RoboChart expression for a single guard leaf.
// If the leaf is a CtVariableRead whose predicate definition can be meaningfully
// translated (comparisons, boolean combinations, arithmetic), inlines the full
// expression tree.  Bare method-call initialisers (CtInvocation at the top level)
// are NOT inlined because the variable name (e.g. "inOpez") is usually more
// descriptive than the extracted method name alone.
// If the leaf is CtUnaryOperator(NOT, CtVariableRead), wraps in Not(...).
// Otherwise, falls back to the synthetic guard name.
operation buildGuardLeafExpr(leaf : Any, syntheticName : String, predDefs : Map) : Any {
    if (leaf.isTypeOf(Spoon!CtVariableRead)) {
        var varName = extractGuardLeafName(leaf);
        if (varName.isDefined()) {
            // Inline predicate initializers that translate meaningfully
            // (comparisons, boolean combos, arithmetic — NOT bare method calls)
            if (predDefs.isDefined() and predDefs.containsKey(varName)) {
                var init = predDefs.get(varName);
                if (not init.isKindOf(Spoon!CtInvocation)) {
                    var inlined = translateSpoonExpr(init);
                    if (inlined.isDefined()) {
                        return inlined;
                    }
                }
            }
            return createNamedCallExp(varName);
        }
    }
    if (leaf.isTypeOf(Spoon!CtUnaryOperator) and getOpName(leaf) == "NOT") {
        var innerName = extractGuardLeafName(leaf);
        if (innerName.isDefined()) {
            // Inline predicate initializer under negation (same gate as positive case)
            if (predDefs.isDefined() and predDefs.containsKey(innerName)) {
                var init = predDefs.get(innerName);
                if (not init.isKindOf(Spoon!CtInvocation)) {
                    var inlined = translateSpoonExpr(init);
                    if (inlined.isDefined()) {
                        var notExpr = new RoboChart!Not;
                        notExpr.exp = inlined;
                        return notExpr;
                    }
                }
            }
            var callExpr = createNamedCallExp(innerName);
            var notExpr = new RoboChart!Not;
            notExpr.exp = callExpr;
            return notExpr;
        }
    }
    // E1 fix: recursively translate the full Spoon expression tree
    var translated = translateSpoonExpr(leaf);
    if (translated.isDefined()) {
        return translated;
    }
    // Ultimate fallback (should not normally be reached)
    return createNamedCallExp(syntheticName);
}

// E1 fix: Recursively translate a Spoon AST expression node to a RoboChart Expression tree.
// Replaces the opaque guard_tN fallback with faithful expression structure.
operation translateSpoonExpr(expr : Any) : Any {
    if (expr.isUndefined()) {
        return;
    }

    // Leaf: local variable read (exact type, not CtFieldRead)
    if (expr.isTypeOf(Spoon!CtVariableRead)) {
        var varRef = expr.variable;
        if (varRef.isDefined()) {
            var varName = getFeature(varRef, "name");
            // Remap event-payload pattern variable to the typed-channel
            // local `v` so action RHS expressions reference the right
            // binding in the .rct.
            if (currentPatternVar.isDefined() and currentPatternVar <> ""
                    and varName == currentPatternVar) {
                return createNamedCallExp("v");
            }
            // Inline local variable from compute() body if available
            if (computeLocalVarInits.isDefined() and computeLocalVarInits.containsKey(varName)) {
                return translateSpoonExpr(computeLocalVarInits.get(varName));
            }
            // Cascade-inline a predicate definition when the predicate's
            // initializer is a structured expression we can faithfully
            // translate. Skipped for invocation initialisers — those
            // represent opaque sensor calls (e.g. `goreq(ins, thr)`)
            // we want to keep as named predicates, matching the LRE
            // convention. Binary expressions (clock difference checks
            // like `clock.nowMs() - tReset < STUCK_PERIOD`, distance
            // checks like `d1 - d0 > STUCK_DIST`, conjunctions, etc.)
            // are safe to inline: they translate to a comparable tree
            // and surface their actual semantics in the .rct.
            if (predicateDefinitions.isDefined() and predicateDefinitions.containsKey(varName)) {
                var pInit = predicateDefinitions.get(varName);
                if (pInit.isDefined() and not pInit.isKindOf(Spoon!CtInvocation)
                        and (containsClockCall(pInit)
                                or pInit.isTypeOf(Spoon!CtBinaryOperator)
                                or pInit.isTypeOf(Spoon!CtUnaryOperator))) {
                    var pInlined = translateSpoonExpr(pInit);
                    if (pInlined.isDefined()) {
                        return pInlined;
                    }
                }
            }
            return createNamedCallExp(varName);
        }
    }

    // Leaf: field read (this.ready, MyConstants.SAFE_SPEED, etc.)
    if (expr.isKindOf(Spoon!CtFieldRead)) {
        // Named constant reference: if the field belongs to the constants class,
        // emit a named CallExp (e.g., "minSafeDist") instead of a literal.
        if (constantsClassName <> "") {
            var varRef = expr.variable;
            if (varRef.isDefined()) {
                var fieldName = getFeature(varRef, "name");
                var declType = getFeature(varRef, "declaringType");
                if (declType.isDefined()) {
                    var declTypeName = getFeature(declType, "name");
                    if (declTypeName == constantsClassName and constantFieldMap.containsKey(fieldName)) {
                        return createNamedCallExp(constantFieldMap.get(fieldName));
                    }
                }
            }
        }
        // Try resolvedValues for static final constants
        if (resolvedValues.isDefined() and resolvedValues.containsKey(expr)) {
            var resolved = resolvedValues.get(expr);
            if (resolved.isKindOf(Native("java.lang.Double"))
                    or resolved.isKindOf(Native("java.lang.Float"))) {
                var floatExpr = new RoboChart!FloatExp;
                floatExpr.value = resolved.floatValue();
                return floatExpr;
            } else if (resolved.isKindOf(Native("java.lang.Integer"))
                    or resolved.isKindOf(Native("java.lang.Long"))
                    or resolved.isKindOf(Native("java.lang.Short"))
                    or resolved.isKindOf(Native("java.lang.Byte"))) {
                var intExpr = new RoboChart!IntegerExp;
                intExpr.value = resolved.intValue();
                return intExpr;
            } else if (resolved.isKindOf(Native("java.lang.Boolean"))) {
                var boolExpr = new RoboChart!BooleanExp;
                boolExpr.value = resolved.toString();
                return boolExpr;
            }
        }
        // Unresolved field: use field name as CallExp
        var varRef = expr.variable;
        if (varRef.isDefined()) {
            return createNamedCallExp(getFeature(varRef, "name"));
        }
    }

    // Leaf: literal value
    if (expr.isKindOf(Spoon!CtLiteral)) {
        if (resolvedValues.isDefined() and resolvedValues.containsKey(expr)) {
            var resolved = resolvedValues.get(expr);
            if (resolved.isKindOf(Native("java.lang.Double"))
                    or resolved.isKindOf(Native("java.lang.Float"))) {
                var floatExpr = new RoboChart!FloatExp;
                floatExpr.value = resolved.floatValue();
                return floatExpr;
            } else if (resolved.isKindOf(Native("java.lang.Integer"))
                    or resolved.isKindOf(Native("java.lang.Long"))
                    or resolved.isKindOf(Native("java.lang.Short"))
                    or resolved.isKindOf(Native("java.lang.Byte"))) {
                var intExpr = new RoboChart!IntegerExp;
                intExpr.value = resolved.intValue();
                return intExpr;
            } else if (resolved.isKindOf(Native("java.lang.Boolean"))) {
                var boolExpr = new RoboChart!BooleanExp;
                boolExpr.value = resolved.toString();
                return boolExpr;
            }
        }
        // No resolved value: parse the literal's own value/valueKind
        // attributes (populated by the T2M mapper) before giving up.
        var directLit = resolveLiteralValue(expr);
        if (directLit.isDefined()) {
            return directLit;
        }
        // Last resort: IntegerExp(0). This SUBSTITUTES a value — warn
        // loudly so the corpus surfaces it instead of silently shipping
        // a wrong constant into guards/actions.
        var wKind = getFeature(expr, "valueKind");
        if (wKind.isUndefined()) { wKind = "?"; }
        var wVal = getFeature(expr, "value");
        if (wVal.isUndefined()) { wVal = "?"; }
        ("[m2m] WARNING: unresolved CtLiteral (valueKind=" + wKind
                + ", value=" + wVal
                + ") substituted with IntegerExp(0) in guard/expression").println();
        var intExpr = new RoboChart!IntegerExp;
        intExpr.value = 0;
        return intExpr;
    }

    // Recursive: binary operator
    if (expr.isTypeOf(Spoon!CtBinaryOperator)) {
        var opName = getOpName(expr);
        // Special case: rewrite `clock.<method>() - <clockField>` to
        // `since(<clockField>)`. This makes time-elapsed predicates
        // (e.g. `clock.nowMs() - tReset < STUCK_PERIOD`) translate to
        // proper RoboChart `since(C)` semantics on a per-stm clock,
        // instead of an opaque difference of two unbound names.
        if (opName == "MINUS") {
            var left = expr.leftOperand;
            var right = expr.rightOperand;
            if (left.isDefined() and right.isDefined()
                    and containsClockCall(left)) {
                var rightFieldName = "";
                if (right.isKindOf(Spoon!CtFieldRead) or right.isTypeOf(Spoon!CtVariableRead)) {
                    var rVarRef = right.variable;
                    if (rVarRef.isDefined()) {
                        var rName = getFeature(rVarRef, "name");
                        if (rName.isDefined()) { rightFieldName = rName; }
                    }
                }
                if (rightFieldName <> "" and clockFieldLookup.containsKey(rightFieldName)) {
                    var sinceCall = createNamedCallExp("since");
                    sinceCall.args.add(createNamedCallExp(rightFieldName));
                    return sinceCall;
                }
            }
        }
        var rcOpName = mapSpoonBinaryOp(opName);
        if (rcOpName.isDefined()) {
            var binExpr = createRcBinaryExpr(rcOpName);
            binExpr.left = translateSpoonExpr(expr.leftOperand);
            binExpr.right = translateSpoonExpr(expr.rightOperand);
            return binExpr;
        }
    }

    // Recursive: unary operator
    if (expr.isTypeOf(Spoon!CtUnaryOperator)) {
        var opName = getOpName(expr);
        var rcOpName = mapSpoonUnaryOp(opName);
        if (rcOpName.isDefined()) {
            var unaryExpr = createRcUnaryExpr(rcOpName);
            unaryExpr.exp = translateSpoonExpr(expr.expression);
            return unaryExpr;
        }
    }

    // Method invocation: sensor.cda() -> CallExp("cda", args...)
    if (expr.isKindOf(Spoon!CtInvocation)) {
        var execRef = getFeature(expr, "executableRef");
        if (execRef.isDefined()) {
            var methodName = getFeature(execRef, "name");
            if (methodName.isDefined() and methodName <> "") {
                // Optional/collection check methods (.isPresent(), .isEmpty()) are
                // runtime safety checks with no RoboChart equivalent. Translate to
                // BooleanExp(true) so they are absorbed in conjunction simplification.
                if (methodName == "isPresent") {
                    var boolExpr = new RoboChart!BooleanExp;
                    boolExpr.value = "true";
                    return boolExpr;
                }
                // Unwrap no-arg terminal accessors (e.g. .get(), .orElse(), .value()).
                // When a no-arg method is called on a receiver, the receiver carries
                // more semantic meaning than the accessor method name.
                var invArgs = getFeature(expr, "argument");
                var argCount = 0;
                if (invArgs.isDefined()) { argCount = invArgs.size(); }
                if (argCount == 0) {
                    var target = getFeature(expr, "target");
                    if (target.isDefined()) {
                        // Case 1: receiver is another invocation (obj.compute(args).get())
                        if (target.isKindOf(Spoon!CtInvocation)) {
                            var targetExecRef = getFeature(target, "executableRef");
                            if (targetExecRef.isDefined()) {
                                var targetMethodName = getFeature(targetExecRef, "name");
                                if (targetMethodName.isDefined() and targetMethodName <> "") {
                                    // Sub-case 1a: localVar.method(args).accessor()
                                    // The local variable is a wrapper/function; the argument
                                    // carries the semantic meaning (e.g. getObs.apply(idx).get() -> idx).
                                    var targetTarget = getFeature(target, "target");
                                    var targetArgs = getFeature(target, "argument");
                                    var targetArgCount = 0;
                                    if (targetArgs.isDefined()) { targetArgCount = targetArgs.size(); }
                                    if (targetArgCount > 0 and targetTarget.isDefined()
                                        and targetTarget.isTypeOf(Spoon!CtVariableRead)) {
                                        return translateSpoonExpr(targetArgs.first());
                                    }
                                    // Sub-case 1b: obj.method().accessor() (no args on receiver)
                                    // -> use the receiver method name as a variable
                                    return createNamedCallExp(targetMethodName);
                                }
                            }
                        }
                        // Case 2: receiver is a local variable (cstcOpt.get())
                        // -> use the variable name, more meaningful than the accessor.
                        // Uses isTypeOf to exclude CtFieldRead (sensor.vel() keeps "vel").
                        // Delegate to translateSpoonExpr so the event-payload
                        // pattern-variable remapping (`g` -> `v` etc.) applies
                        // to record-accessor calls like `g.gs()`.
                        if (target.isTypeOf(Spoon!CtVariableRead)) {
                            return translateSpoonExpr(target);
                        }
                    }
                }
                var callExpr = createNamedCallExp(methodName);
                if (invArgs.isDefined()) {
                    for (arg in invArgs) {
                        var translatedArg = translateSpoonExpr(arg);
                        if (translatedArg.isDefined()) {
                            callExpr.args.add(translatedArg);
                        }
                    }
                }
                return callExpr;
            }
        }
    }

    // Fallback
    return createNamedCallExp("unknown_expr");
}

// Map Spoon BinaryOperatorKind name to RoboChart operator name.
// Returns undefined for operators that have no RoboChart equivalent (e.g. INSTANCEOF, BITOR).
operation mapSpoonBinaryOp(spoonOpName : String) : Any {
    if (spoonOpName == "AND") { return "and"; }
    if (spoonOpName == "OR") { return "or"; }
    if (spoonOpName == "EQ") { return "eq"; }
    if (spoonOpName == "NE") { return "neq"; }
    if (spoonOpName == "LT") { return "lt"; }
    if (spoonOpName == "GT") { return "gt"; }
    if (spoonOpName == "LE") { return "leq"; }
    if (spoonOpName == "GE") { return "geq"; }
    if (spoonOpName == "PLUS") { return "plus"; }
    if (spoonOpName == "MINUS") { return "minus"; }
    if (spoonOpName == "MUL") { return "mult"; }
    if (spoonOpName == "DIV") { return "div"; }
    return;
}

// Map Spoon UnaryOperatorKind name to RoboChart operator name.
// Returns undefined for operators that have no RoboChart equivalent.
operation mapSpoonUnaryOp(spoonOpName : String) : Any {
    if (spoonOpName == "NOT") { return "not"; }
    if (spoonOpName == "NEG") { return "neg"; }
    return;
}

// Check whether a Spoon expression is a comparison binary operator (LE/GE/LT/GT/EQ/NE).
// Used to decide whether a predicate definition's initializer should be inlined into the guard.
operation isComparisonOp(spoonExpr : Any) : Boolean {
    if (not spoonExpr.isTypeOf(Spoon!CtBinaryOperator)) { return false; }
    var opName = getOpName(spoonExpr);
    return opName == "LE" or opName == "GE" or opName == "LT"
        or opName == "GT" or opName == "EQ" or opName == "NE";
}

// Collect the READ NAMES of a Spoon expression tree at the JAVA level:
// every field read (`this.resetTime` -> "resetTime"), local/parameter read,
// and invoked method name (`turnTimer.elapsed()` -> "elapsed"), recursing
// through binary/unary operands and invocation targets and arguments.
//
// WHY A JAVA-LEVEL COLLECTOR (I1-SR fix). extractComputeBody's stub closure
// needs to know what an assignment's RHS reads BEFORE deciding whether to
// translate it. Asking the question after translation (via
// collectAllRcCallExpNames on the RoboChart tree) would mean CREATING the
// RoboChart expression objects for assignments the closure then discards.
// Those objects are not garbage: Epsilon adds every `new RoboChart!...` to the
// target resource, so a discarded RHS is SERIALISED into robochart_model.xmi as
// an orphan (a root-level `GreaterOrEqual` with no container). Measured
// consequence on sranger: the orphan changed the XMI, and the Isabelle
// template's downstream OrderedSet iteration over the resource then emitted
// the `listens` sets in a different order ({tick, endTask, obstacle} instead of
// {endTask, obstacle, tick}) — a set-valued, semantically inert difference, but
// enough to break byte-identity of a theory the change must not touch.
// Deciding at the Spoon level creates nothing and keeps the emission clean.
//
// Names are matched against DECLARED OUTPUT FIELD NAMES, which are Java field
// names verbatim (Phase 6 sets `opVar.name = fieldName`), so no RoboChart-side
// renaming (constant camelCasing, `since(C)` rewriting) can affect the match.
// Over-collection is safe here: an extra name that is not a declared output
// simply never matches.
operation collectSpoonReadNames(spoonExpr : Any, nameSet : OrderedSet) {
    if (spoonExpr.isUndefined()) { return; }
    if (spoonExpr.isKindOf(Spoon!CtFieldRead) or spoonExpr.isTypeOf(Spoon!CtVariableRead)) {
        var varRef = spoonExpr.variable;
        if (varRef.isDefined()) {
            var vn = getFeature(varRef, "name");
            if (vn.isDefined() and vn <> "") { nameSet.add(vn); }
        }
        return;
    }
    if (spoonExpr.isKindOf(Spoon!CtInvocation)) {
        var execRef = getFeature(spoonExpr, "executableRef");
        if (execRef.isDefined()) {
            var mn = getFeature(execRef, "name");
            if (mn.isDefined() and mn <> "") { nameSet.add(mn); }
        }
        var invTarget = getFeature(spoonExpr, "target");
        if (invTarget.isDefined()) { collectSpoonReadNames(invTarget, nameSet); }
        var invArgs = getFeature(spoonExpr, "argument");
        if (invArgs.isDefined()) {
            for (a in invArgs) { collectSpoonReadNames(a, nameSet); }
        }
        return;
    }
    if (spoonExpr.isTypeOf(Spoon!CtBinaryOperator)) {
        collectSpoonReadNames(spoonExpr.leftOperand, nameSet);
        collectSpoonReadNames(spoonExpr.rightOperand, nameSet);
        return;
    }
    if (spoonExpr.isTypeOf(Spoon!CtUnaryOperator)) {
        collectSpoonReadNames(spoonExpr.expression, nameSet);
        return;
    }
    // Local variables inlined by translateSpoonExpr are followed here too, so a
    // read reaching a stubbed output THROUGH a compute() local is still seen.
    if (spoonExpr.isTypeOf(Spoon!CtLocalVariable)) {
        var lvInit = getFeature(spoonExpr, "assignment");
        if (lvInit.isUndefined()) { lvInit = getFeature(spoonExpr, "defaultExpression"); }
        if (lvInit.isDefined()) { collectSpoonReadNames(lvInit, nameSet); }
        return;
    }
}

// Recursively collect method invocation names from a Spoon expression tree.
// Adds each CtInvocation's method name to the provided nameSet.
operation collectInvocationNames(spoonExpr : Any, nameSet : OrderedSet) {
    if (spoonExpr.isUndefined()) { return; }
    if (spoonExpr.isKindOf(Spoon!CtInvocation)) {
        var execRef = getFeature(spoonExpr, "executableRef");
        if (execRef.isDefined()) {
            var methodName = getFeature(execRef, "name");
            if (methodName.isDefined() and methodName <> "") {
                // Optional check methods are not functions; skip collecting them.
                if (methodName == "isPresent") { return; }
                // Unwrap no-arg terminal accessors (e.g. .get(), .orElse()).
                // When a no-arg method is called on a more meaningful receiver,
                // collect the receiver's name instead.
                var invArgs = getFeature(spoonExpr, "argument");
                var argCount = 0;
                if (invArgs.isDefined()) { argCount = invArgs.size(); }
                if (argCount == 0) {
                    var target = getFeature(spoonExpr, "target");
                    if (target.isDefined()) {
                        // Case 1: receiver is another invocation -> collect its name
                        if (target.isKindOf(Spoon!CtInvocation)) {
                            // Sub-case 1a: localVar.method(args).accessor()
                            // The argument carries semantic meaning; collect from args.
                            var targetTarget = getFeature(target, "target");
                            var targetArgs = getFeature(target, "argument");
                            var targetArgCount = 0;
                            if (targetArgs.isDefined()) { targetArgCount = targetArgs.size(); }
                            if (targetArgCount > 0 and targetTarget.isDefined()
                                and targetTarget.isTypeOf(Spoon!CtVariableRead)) {
                                for (tArg in targetArgs) {
                                    collectInvocationNames(tArg, nameSet);
                                }
                                return;
                            }
                            // Sub-case 1b: obj.method().accessor() -> collect receiver name
                            collectInvocationNames(target, nameSet);
                            return;
                        }
                        // Case 2: receiver is a local variable -> skip (it's a variable, not a function)
                        if (target.isTypeOf(Spoon!CtVariableRead)) {
                            return;
                        }
                    }
                }
                nameSet.add(methodName);
            }
        }
        // Also recurse into arguments
        var args = getFeature(spoonExpr, "argument");
        if (args.isDefined()) {
            for (arg in args) {
                collectInvocationNames(arg, nameSet);
            }
        }
        return;
    }
    if (spoonExpr.isTypeOf(Spoon!CtBinaryOperator)) {
        collectInvocationNames(spoonExpr.leftOperand, nameSet);
        collectInvocationNames(spoonExpr.rightOperand, nameSet);
        return;
    }
    if (spoonExpr.isTypeOf(Spoon!CtUnaryOperator)) {
        collectInvocationNames(spoonExpr.expression, nameSet);
        return;
    }
}

// Read the operator type from a RoboChart expression using its concrete class name.
// In the official metamodel, operator type IS the class (And, Or, Not, etc.).
operation getRcOperatorName(expr : Any) : String {
    var className = expr.eClass().getName();
    if (className == "And") { return "and"; }
    if (className == "Or") { return "or"; }
    if (className == "Equals") { return "eq"; }
    if (className == "Different") { return "neq"; }
    if (className == "LessThan") { return "lt"; }
    if (className == "GreaterThan") { return "gt"; }
    if (className == "LessOrEqual") { return "leq"; }
    if (className == "GreaterOrEqual") { return "geq"; }
    if (className == "Plus") { return "plus"; }
    if (className == "Minus") { return "minus"; }
    if (className == "Mult") { return "mult"; }
    if (className == "Div") { return "div"; }
    if (className == "Not") { return "not"; }
    if (className == "Neg") { return "neg"; }
    return "and";
}

// Read a structural feature from a RoboChart expression using reflective EMF access.
// Epsilon property resolution can fail on DynamicEObjects that have been detached
// from their container (e.g. predecessor guards replaced by priority-encoded versions).
operation getRcFeature(expr : Any, featureName : String) : Any {
    var f = expr.eClass().getEStructuralFeature(featureName);
    if (f.isDefined()) {
        return expr.eGet(f);
    }
    return;
}

// Deep-clone a RoboChart expression tree (E6 fix: needed because EMF containment
// means an EObject can only have one parent; predecessor guards must be cloned
// when building negated-predecessor compound guards for priority encoding).
// Uses reflective EMF access throughout because Epsilon property resolution
// can fail on DynamicEObjects detached from containment.
operation cloneExpression(expr : Any) : Any {
    if (expr.isUndefined()) { return; }
    if (expr.isKindOf(RoboChart!IntegerExp)) {
        var i = new RoboChart!IntegerExp;
        i.value = getRcFeature(expr, "value");
        return i;
    }
    if (expr.isKindOf(RoboChart!FloatExp)) {
        var r = new RoboChart!FloatExp;
        r.value = getRcFeature(expr, "value");
        return r;
    }
    if (expr.isKindOf(RoboChart!BooleanExp)) {
        var bo = new RoboChart!BooleanExp;
        bo.value = getRcFeature(expr, "value");
        return bo;
    }
    if (expr.isKindOf(RoboChart!StringExp)) {
        var se = new RoboChart!StringExp;
        se.value = getRcFeature(expr, "value");
        return se;
    }
    if (expr.isKindOf(RoboChart!CallExp)) {
        var c = new RoboChart!CallExp;
        // function is now Expression (containment) — must clone
        var funcExpr = getRcFeature(expr, "function");
        if (funcExpr.isDefined()) {
            var clonedFunc = cloneExpression(funcExpr);
            var funcF = c.eClass().getEStructuralFeature("function");
            c.eSet(funcF, clonedFunc);
        }
        var args = getRcFeature(expr, "args");
        if (args.isDefined()) {
            for (a in args) {
                c.args.add(cloneExpression(a));
            }
        }
        return c;
    }
    if (expr.isKindOf(RoboChart!Not)) {
        var u = new RoboChart!Not;
        u.exp = cloneExpression(getRcFeature(expr, "exp"));
        return u;
    }
    if (expr.isKindOf(RoboChart!Neg)) {
        var u = new RoboChart!Neg;
        u.exp = cloneExpression(getRcFeature(expr, "exp"));
        return u;
    }
    if (expr.isKindOf(RoboChart!BinaryExpression)) {
        // Reflective clone: create same concrete class (And, Or, Equals, etc.)
        var factory = expr.eClass().getEPackage().getEFactoryInstance();
        var b = factory.create(expr.eClass());
        var leftF = b.eClass().getEStructuralFeature("left");
        var rightF = b.eClass().getEStructuralFeature("right");
        b.eSet(leftF, cloneExpression(getRcFeature(expr, "left")));
        b.eSet(rightF, cloneExpression(getRcFeature(expr, "right")));
        return b;
    }
    return expr;
}

// Phase 3: Simplify presence-check guard patterns.
// Removes presence-check variable references (names ending in "Present") from guards.
// Patterns:
//   And(presenceCheck, X) -> X
//   Or(Not(presenceCheck), X) -> X
//   bare presenceCheck -> BooleanExp(true) (vacuously true)
operation simplifyPresenceChecks(expr : Any) : Any {
    if (expr.isUndefined()) { return; }
    if (expr.isKindOf(RoboChart!And)) {
        var left = simplifyPresenceChecks(getRcFeature(expr, "left"));
        var right = simplifyPresenceChecks(getRcFeature(expr, "right"));
        if (left.isUndefined() or isPresenceCheckExpr(left)) { return right; }
        if (right.isUndefined() or isPresenceCheckExpr(right)) { return left; }
        var newAnd = new RoboChart!And;
        newAnd.left = left;
        newAnd.right = right;
        return newAnd;
    }
    if (expr.isKindOf(RoboChart!Or)) {
        var left = simplifyPresenceChecks(getRcFeature(expr, "left"));
        var right = simplifyPresenceChecks(getRcFeature(expr, "right"));
        if (left.isUndefined() or isNegatedPresenceCheckExpr(left)) { return right; }
        if (right.isUndefined() or isNegatedPresenceCheckExpr(right)) { return left; }
        var newOr = new RoboChart!Or;
        newOr.left = left;
        newOr.right = right;
        return newOr;
    }
    if (isPresenceCheckExpr(expr)) {
        // Bare presence check (e.g. cstcPresent alone as a conjunct) -> vacuously true
        // Return undefined so the caller drops this conjunct
        return;
    }
    return expr;
}

// Check if an expression is a presence-check variable reference.
// Matches CallExp names ending in "Present" (e.g. cstcPresent, cdynPresent),
// and BooleanExp(true) from .isPresent() calls translated as vacuous checks.
//
// FORK / DOMAIN-INDEPENDENCE NOTE: the "Present" suffix is a defensive
// cleanup, not a required convention. CLAUDE.md's java_codegen_rules
// already forbid declaring sentinel-existence predicates
// (`itemExists = idx != -1`) — controllers that follow the rules never
// produce a "*Present" CallExp, so this code path is dead. We keep it
// to gracefully handle older / non-compliant Java sources without
// failing the pipeline. A third case study with compliant code is
// unaffected; a non-compliant one using a different suffix (e.g.
// "*Exists") would simply not have those conjuncts stripped — soft
// failure, no crash.
operation isPresenceCheckExpr(expr : Any) : Boolean {
    if (expr.isUndefined()) { return false; }
    // BooleanExp(true) from .isPresent() -> vacuously true, strip from conjunctions
    if (expr.isKindOf(RoboChart!BooleanExp)) {
        return expr.value.toString() == "true";
    }
    if (expr.isKindOf(RoboChart!CallExp)) {
        var funcExpr = getRcFeature(expr, "function");
        if (funcExpr.isDefined() and funcExpr.isKindOf(RoboChart!StringExp)) {
            return funcExpr.value.endsWith("Present");
        }
    }
    return false;
}

// Check if an expression is Not(presenceCheck).
operation isNegatedPresenceCheckExpr(expr : Any) : Boolean {
    if (expr.isUndefined()) { return false; }
    if (expr.isKindOf(RoboChart!Not)) {
        return isPresenceCheckExpr(getRcFeature(expr, "exp"));
    }
    return false;
}

// =====================================================================
// C1 fix: priority-negation synthesis for if-else chains
// =====================================================================
// Java's if-else chain gives earlier branches priority: a later branch
// fires only when every earlier branch's condition is false. RoboChart
// composes transitions as unguarded choice, so without explicit
// negations the model over-approximates (Tier-B conformance witness:
// OCMToMOM fires on ANY event where Java requires ReqMOM + guards).
// These helpers synthesise the negations that LRE's Java writes by
// hand (`hcmActive && !camActive`) for branches that LACK them.
//
// Rules:
//  - only preceding TRIGGERLESS branches contribute (an event-triggered
//    branch blocks via trigger disjointness, which the C2
//    trigger-precondition fix encodes — not via a state predicate);
//  - every later branch from the same source state RECEIVES the
//    accumulated negations, including event-triggered branches and
//    terminal-else transitions (the E13 unguarded case);
//  - vacuous conjuncts (BooleanExp(true) from isPresent absorption,
//    "*Present" presence checks) are dropped before negating so no
//    `not true` junk is emitted — each drop is logged;
//  - a predecessor whose negation is already syntactically implied by
//    the branch's own guard is skipped (LRE hand-negates predecessors;
//    naive prepending would emit `not camActive and (hcmActive and
//    not camActive)`);
//  - inside a multi-conjunct predecessor, conjuncts already asserted
//    true in context (by the branch guard or an earlier pending
//    negation) are removed before negating, so `not (hcmActive and
//    not camActive)` under a pending `not camActive` collapses to
//    `not hcmActive` — matching the hand-written artefact shape.

// Produce a recursive structural key for a RoboChart expression, used
// for syntactic dedupe/implication checks in priority-negation
// synthesis. Deliberately deeper than exprSignature() (which only
// keys top-level refs/literals for entry-action lifting).
operation rcExprKey(expr : Any) : String {
    if (expr.isUndefined()) { return "?"; }
    if (expr.isKindOf(RoboChart!IntegerExp) or expr.isKindOf(RoboChart!FloatExp)
            or expr.isKindOf(RoboChart!BooleanExp) or expr.isKindOf(RoboChart!StringExp)) {
        var v = getRcFeature(expr, "value");
        var vs = "?";
        if (v.isDefined()) { vs = v.toString(); }
        return expr.eClass().getName() + "(" + vs + ")";
    }
    if (expr.isKindOf(RoboChart!CallExp)) {
        var parts = new Sequence;
        parts.add(rcExprKey(getRcFeature(expr, "function")));
        var args = getRcFeature(expr, "args");
        if (args.isDefined()) {
            for (a in args) { parts.add(rcExprKey(a)); }
        }
        return "CallExp(" + parts.concat(",") + ")";
    }
    if (expr.isKindOf(RoboChart!Not) or expr.isKindOf(RoboChart!Neg)) {
        return expr.eClass().getName() + "(" + rcExprKey(getRcFeature(expr, "exp")) + ")";
    }
    if (expr.isKindOf(RoboChart!BinaryExpression)) {
        return expr.eClass().getName() + "(" + rcExprKey(getRcFeature(expr, "left"))
                + "," + rcExprKey(getRcFeature(expr, "right")) + ")";
    }
    return expr.eClass().getName();
}

// Flatten a RoboChart And-tree into its leaf conjuncts.
operation collectRcConjuncts(expr : Any, out : Sequence) {
    if (expr.isUndefined()) { return; }
    if (expr.isKindOf(RoboChart!And)) {
        collectRcConjuncts(getRcFeature(expr, "left"), out);
        collectRcConjuncts(getRcFeature(expr, "right"), out);
        return;
    }
    out.add(expr);
}

// Append a predecessor guard to the per-state accumulator map (outer chain).
operation accumulatePriorityGuard(map : Map, stateName : String, guardExpr : Any) {
    if (guardExpr.isUndefined()) { return; }
    if (not map.containsKey(stateName)) {
        map.put(stateName, new Sequence);
    }
    map.get(stateName).add(guardExpr);
}

// Fetch the accumulated predecessor guards for a state (may be empty).
operation getPriorityList(map : Map, stateName : String) : Sequence {
    if (map.containsKey(stateName)) {
        return map.get(stateName);
    }
    return new Sequence;
}

// Prepend the negations of the accumulated predecessor guards to the
// MOST RECENTLY created transition's condition (call immediately after
// createTransition). See the C1 block comment above for the rules.
operation applyPriorityNegations(stm : Any, predecessors : Sequence) {
    if (predecessors.isUndefined() or predecessors.isEmpty()) { return; }
    var trans = stm.transitions.last();
    var existingKeys = new Sequence;
    if (trans.condition.isDefined()) {
        var existingConjs = new Sequence;
        collectRcConjuncts(trans.condition, existingConjs);
        for (ec in existingConjs) { existingKeys.add(rcExprKey(ec)); }
    }
    var toNegate = new Sequence;
    var pendingKeys = new Sequence;   // keys of negations queued so far (chain order)
    for (p in predecessors) {
        var pConjs = new Sequence;
        collectRcConjuncts(p, pConjs);
        // Drop un-negatable (vacuous) conjuncts: BooleanExp(true) from
        // isPresent() absorption and "*Present" presence-check refs.
        var keep = new Sequence;
        for (pc in pConjs) {
            if (isPresenceCheckExpr(pc)) {
                ("[priority-c1] " + stm.name + "." + trans.name
                        + ": skipped un-negatable predecessor conjunct "
                        + rcExprKey(pc)).println();
            } else {
                keep.add(pc);
            }
        }
        if (keep.isEmpty()) { continue; }
        // Implication check: skip the predecessor entirely when the branch
        // guard already excludes it syntactically (hand-written negations).
        var implied = false;
        for (pc in keep) {
            if (existingKeys.includes("Not(" + rcExprKey(pc) + ")")) { implied = true; }
            if (pc.isKindOf(RoboChart!Not)) {
                if (existingKeys.includes(rcExprKey(getRcFeature(pc, "exp")))) { implied = true; }
            }
        }
        if (implied) { continue; }
        // Context simplification: a conjunct already asserted true by the
        // branch guard or an earlier pending negation can be removed from
        // inside this negation (not (A and B) with A asserted ≡ not B).
        var contextKeep = new Sequence;
        for (pc in keep) {
            var k = rcExprKey(pc);
            if (existingKeys.includes(k) or pendingKeys.includes(k)) { continue; }
            contextKeep.add(pc);
        }
        if (contextKeep.isEmpty()) {
            // Every conjunct is asserted true in context: the predecessor
            // always fires first, so keep the full guard (negation = false
            // is the faithful reading, but emit it un-simplified so the
            // contradiction is visible in the artefact rather than hidden).
            contextKeep = keep;
        }
        // Rebuild the (possibly reduced) predecessor guard from clones.
        var pGuard;
        for (pc in contextKeep) {
            var pcClone = cloneExpression(pc);
            if (pGuard.isUndefined()) {
                pGuard = pcClone;
            } else {
                var andExpr = new RoboChart!And;
                andExpr.left = pGuard;
                andExpr.right = pcClone;
                pGuard = andExpr;
            }
        }
        var negKey = "Not(" + rcExprKey(pGuard) + ")";
        // Double-negation: negating a Not(x) predecessor yields x directly.
        if (pGuard.isKindOf(RoboChart!Not)) {
            negKey = rcExprKey(getRcFeature(pGuard, "exp"));
        }
        if (existingKeys.includes(negKey) or pendingKeys.includes(negKey)) { continue; }
        pendingKeys.add(negKey);
        toNegate.add(pGuard);
    }
    if (toNegate.isEmpty()) { return; }
    trans.condition = prependNegatedGuards(trans.condition, toNegate);
}

// Build a priority-encoded guard: rawGuard AND not(pred1) AND not(pred2) ...
// Revived for the C1 fix (was dead after the Phase-3 "priority encoding
// removed" change; applyPriorityNegations is now its only call site).
// The branch's own guard comes FIRST, negations appended — matching the
// hand-written convention in the archived LRE artefacts
// (MOMToHCM pre "st = MOM \<and> hcmActive \<and> \<not> camActive").
// Double negation is unwrapped: a predecessor of shape Not(x)
// contributes x rather than Not(Not(x)).
// Returns undefined when predecessors is empty and rawGuard is undefined.
operation prependNegatedGuards(rawGuard : Any, predecessors : Sequence) : Any {
    var parts = new Sequence;
    if (rawGuard.isDefined()) {
        parts.add(cloneExpression(rawGuard));
    }
    for (pred in predecessors) {
        if (pred.isKindOf(RoboChart!Not)) {
            parts.add(cloneExpression(getRcFeature(pred, "exp")));
        } else {
            var negExpr = new RoboChart!Not;
            negExpr.exp = cloneExpression(pred);
            parts.add(negExpr);
        }
    }
    if (parts.isEmpty()) {
        return;
    }
    var result;
    for (part in parts) {
        if (result.isUndefined()) {
            result = part;
        } else {
            var binExpr = createRcBinaryExpr("and");
            binExpr.left = result;
            binExpr.right = part;
            result = binExpr;
        }
    }
    return result;
}

// Recursively flatten a CtBinaryOperator OR tree into its leaf disjuncts.
// e.g. OR(OR(A, B), C) -> [A, B, C]
// Non-OR expressions return a singleton sequence.
operation flattenOr(expr : Any) : Sequence {
    var result = new Sequence;
    if (not expr.isTypeOf(Spoon!CtBinaryOperator)) {
        result.add(expr);
        return result;
    }
    if (getOpName(expr) <> "OR") {
        result.add(expr);
        return result;
    }
    result.addAll(flattenOr(expr.leftOperand));
    result.addAll(flattenOr(expr.rightOperand));
    return result;
}

// Recursively flatten a CtBinaryOperator AND tree into its leaf conjuncts.
// e.g. AND(AND(A, B), C) -> [A, B, C]
operation flattenCondition(expr : Any) : Sequence {
    var result = new Sequence;
    if (not expr.isTypeOf(Spoon!CtBinaryOperator)) {
        result.add(expr);
        return result;
    }
    if (getOpName(expr) <> "AND") {
        result.add(expr);
        return result;
    }
    result.addAll(flattenCondition(expr.leftOperand));
    result.addAll(flattenCondition(expr.rightOperand));
    return result;
}

// Find the target mode name from a currentMode assignment in a block.
operation findTargetMode(block : Any) : String {
    if (block.isUndefined()) {
        return "";
    }
    if (not block.isKindOf(Spoon!CtBlock)) {
        return "";
    }
    // In Spoon, CtAssignment is directly a statement (no ExpressionStatement wrapper)
    for (stmt in block.statement) {
        if (stmt.isTypeOf(Spoon!CtAssignment)) {
            if (isCurrentModeRef(stmt.assigned)) {
                var targetName = extractEnumLiteralName(stmt.assignment);
                if (targetName.isDefined()) {
                    return targetName;
                }
            }
        }
    }
    return "";
}

// Extract non-mode-assignment statements from a then-block as RoboChart Communication actions.
// Returns a Sequence of Communication EObjects (E4 fix).
// IMPORTANT: Must be called once per transition (fresh EObjects for EMF containment).
// E11: patternVarName is the pattern variable name from instanceof (e.g. "rv"),
//      or "" if no pattern variable exists. Used to detect data flow in arguments.
operation extractActions(block : Any, stm : Any, eventMap : Map, patternVarName : Any, eventTypeName : String) : Sequence {
    var actions = new Sequence;
    if (block.isUndefined() or not block.isKindOf(Spoon!CtBlock)) {
        return actions;
    }
    for (stmt in block.statement) {
        // Skip currentMode assignments (handled by findTargetMode)
        if (stmt.isTypeOf(Spoon!CtAssignment) and isCurrentModeRef(stmt.assigned)) {
            continue;
        }
        // State-variable assignment: this.<field> = <expr>
        // Special case: clock-reset (`this.<clockField> = clock.nowMs()`)
        // becomes a RoboChart!ClockReset, attached separately to the
        // transition's `reset` slot (handled by attachActions below).
        // Otherwise, builds a RoboChart!Assignment with VarRef → Variable
        // and a translated RHS. Skip cases that can't be modelled:
        //   - The LHS isn't a known Ctrl_State field (e.g. a local)
        //   - The RHS references clock.nowMs() but the LHS isn't a clock
        //     field (e.g. arithmetic on time) — no faithful RoboChart form
        if (stmt.isTypeOf(Spoon!CtAssignment)) {
            var clockResetAction = buildClockReset(stmt);
            if (clockResetAction.isDefined()) {
                actions.add(clockResetAction);
                continue;
            }
            var assignAction = buildStateAssignment(stmt, patternVarName, eventTypeName);
            if (assignAction.isDefined()) {
                actions.add(assignAction);
            }
            continue;
        }
        // Timing methods like `vehicle.pause(N)` map to a RoboChart!Wait
        // statement (time-passing) rather than a Communication on an
        // event. Detection by method name keeps the heuristic local;
        // extend the set in buildWaitStatement if other timing primitives
        // (delay, sleep, ...) appear in case studies.
        // Multi-arg invocations (e.g. `vehicle.move(LV, a)`) need to
        // become RoboChart operation calls because events have a single
        // payload type — RoboChart can't pass two values via one event.
        if (stmt.isKindOf(Spoon!CtInvocation)) {
            var waitStmt = buildWaitStatement(stmt);
            if (waitStmt.isDefined()) {
                actions.add(waitStmt);
                continue;
            }
            var callStmt = buildOperationCall(stmt, patternVarName, eventTypeName);
            if (callStmt.isDefined()) {
                actions.add(callStmt);
                continue;
            }
            var comm = buildCommunication(stmt, stm, eventMap, patternVarName, eventTypeName);
            if (comm.isDefined()) {
                actions.add(comm);
            }
        }
    }
    return actions;
}

// Walk the top of a mode block (statements appearing before the inner
// if-else event chain) and attach the resulting RoboChart actions as
// EntryAction on the given State. Java pattern:
//
//   if (mode == M.Waiting) {
//       vehicle.randomWalk();      // <- becomes state Waiting entry
//       if (event instanceof ...) { ... }   // skipped (handled by walkInnerChain)
//   }
//
// Multiple statements are wrapped in a SeqStatement (single Statement
// is used directly). ClockReset items are skipped here because they
// belong on transitions, not state actions. A no-op when no
// pre-chain statements exist.
operation attachTopOfModeEntryActions(thenBlock : Any, state : Any, stm : Any, eventMap : Map) {
    if (state.isUndefined() or thenBlock.isUndefined()
            or not thenBlock.isKindOf(Spoon!CtBlock)) {
        return;
    }
    // Walk the thenBlock once, processing each statement up to (but
    // not including) the first inner CtIf. Don't move statements into
    // a virtual block — EMF containment would mutate the source list
    // mid-iteration and throw ConcurrentModificationException.
    var actions = new Sequence;
    var stopped = false;
    for (s in thenBlock.statement) {
        if (stopped) { continue; }
        if (s.isTypeOf(Spoon!CtIf)) { stopped = true; continue; }
        // Skip mode assignments — those are handled by transition extraction
        if (s.isTypeOf(Spoon!CtAssignment) and isCurrentModeRef(s.assigned)) { continue; }
        if (s.isTypeOf(Spoon!CtAssignment)) {
            // ClockReset / Assignment to ctrl-state field. Skip
            // ClockReset (belongs on a transition); accept Assignments.
            var resetA = buildClockReset(s);
            if (resetA.isDefined()) { continue; }
            var assignA = buildStateAssignment(s, "", "");
            if (assignA.isDefined()) { actions.add(assignA); }
            continue;
        }
        if (s.isKindOf(Spoon!CtInvocation)) {
            var waitA = buildWaitStatement(s);
            if (waitA.isDefined()) { actions.add(waitA); continue; }
            var commA = buildCommunication(s, stm, eventMap, "", "");
            if (commA.isDefined()) { actions.add(commA); }
        }
    }
    if (actions.isEmpty()) { return; }

    var stmt;
    if (actions.size() == 1) {
        stmt = wrapAction(actions.at(0));
    } else {
        var seq = new RoboChart!SeqStatement;
        for (a in actions) { seq.statements.add(wrapAction(a)); }
        stmt = seq;
    }

    var entry = new RoboChart!EntryAction;
    entry.action = stmt;
    state.actions.add(entry);
}

// Build a RoboChart!Call (operation invocation) for a Spoon CtInvocation
// with >= 2 arguments. RoboChart events have a single payload type, so
// multi-arg method calls (e.g. `vehicle.move(LV, a)`) must be modelled
// as operation calls rather than event Communications. Lazily creates
// an OperationSig (with parameters inferred from the Java method) inside
// an `LOperations` interface, and references it from the Call.
//
// Returns undefined for 0/1-arg invocations and for invocations the
// caller has already specialised (timing primitives, OutputEvent
// constructors). The fallback path keeps single-arg/no-arg events
// behaving exactly like before.
operation buildOperationCall(invocation : Any, patternVarName : Any, eventTypeName : String) : Any {
    var execRef = getFeature(invocation, "executableRef");
    if (execRef.isUndefined()) { return; }
    var methodName = getFeature(execRef, "name");
    if (methodName.isUndefined() or methodName == "") { return; }
    var args = getFeature(invocation, "argument");
    if (args.isUndefined() or args.size() < 2) { return; }

    // Resolve the operation signature, creating one lazily on first use.
    var opSig = operationSigLookup.get(methodName);
    if (opSig.isUndefined()) {
        opSig = new RoboChart!OperationSig;
        opSig.name = methodName;
        opSig.terminates = true;
        // Build parameter signature from the executable reference's
        // declared argument types (Spoon's `argumentType` feature is a
        // multi-valued list of CtTypeReferences on CtExecutableReference).
        // We use these rather than each call-site arg's `type` because
        // expression types can be subsumed (e.g. a CtFieldRead on an
        // Angle constant might report `Angle` but a literal might not),
        // while the executable's declared types are authoritative.
        var argTypeRefs = getFeature(execRef, "argumentType");
        var pIdx = 0;
        for (callArg in args) {
            var paramName = "p" + pIdx.toString();
            var paramTypeName = "real";
            var jpTypeRef = null;
            if (argTypeRefs.isDefined() and argTypeRefs.size() > pIdx) {
                jpTypeRef = argTypeRefs.at(pIdx);
            }
            if (jpTypeRef.isUndefined()) {
                jpTypeRef = getFeature(callArg, "type");
            }
            if (jpTypeRef.isDefined()) {
                var jpTypeName = getFeature(jpTypeRef, "name");
                if (jpTypeName.isDefined()) {
                    if (jpTypeName == "double" or jpTypeName == "Double"
                        or jpTypeName == "float" or jpTypeName == "Float") {
                        paramTypeName = "real";
                    } else if (jpTypeName == "int" or jpTypeName == "Integer"
                            or jpTypeName == "long" or jpTypeName == "Long") {
                        // Signed Java int -> signed RoboChart int (see mapJavaTypeToRcTypeRef)
                        paramTypeName = "int";
                    } else if (jpTypeName == "boolean" or jpTypeName == "Boolean") {
                        paramTypeName = "boolean";
                    } else if (enumTypeMap.containsKey(jpTypeName)) {
                        paramTypeName = jpTypeName;
                    } else if (recordTypeMap.containsKey(jpTypeName)) {
                        paramTypeName = jpTypeName;
                    }
                }
            }
            var param = new RoboChart!Parameter;
            param.name = paramName;
            if (enumTypeMap.containsKey(paramTypeName)) {
                var enumRef = new RoboChart!TypeRef;
                enumRef.ref = enumTypeMap.get(paramTypeName);
                param.type = enumRef;
            } else if (recordTypeMap.containsKey(paramTypeName)) {
                var recRef = new RoboChart!TypeRef;
                recRef.ref = recordTypeMap.get(paramTypeName);
                param.type = recRef;
            } else {
                var primT = new RoboChart!PrimitiveType;
                primT.name = paramTypeName;
                rcPackage.types.add(primT);
                var primRef = new RoboChart!TypeRef;
                primRef.ref = primT;
                param.type = primRef;
            }
            opSig.parameters.add(param);
            pIdx = pIdx + 1;
        }
        // Attach to the LOperations interface (lazily created).
        var lOps = rcPackage.interfaces.selectOne(i | i.name == "LOperations");
        if (lOps.isUndefined()) {
            lOps = new RoboChart!Interface;
            lOps.name = "LOperations";
            rcPackage.interfaces.add(lOps);
        }
        lOps.operations.add(opSig);
        operationSigLookup.put(methodName, opSig);
    }

    var call = new RoboChart!Call;
    // `operation` is an EOL reserved keyword — use reflective eSet to
    // assign the Call's operation reference without parser errors.
    call.eSet(call.eClass().getEStructuralFeature("operation"), opSig);
    // Translate each argument with the current pattern variable in scope
    // so event-payload reads (e.g. `t.a()` inside an action) remap to `v`.
    var savedPatternVar = currentPatternVar;
    if (patternVarName.isDefined() and patternVarName <> "") {
        currentPatternVar = patternVarName;
    }
    for (a in args) {
        var translated = translateSpoonExpr(a);
        if (translated.isDefined()) {
            call.args.add(translated);
        }
    }
    currentPatternVar = savedPatternVar;
    return call;
}

// Recognise method invocations that semantically pause execution (time-
// passing) and emit a RoboChart!Wait with the first argument as the
// duration expression. Returns undefined for non-timing invocations so
// the caller falls through to the regular Communication path.
operation buildWaitStatement(invocation : Any) : Any {
    var execRef = getFeature(invocation, "executableRef");
    if (execRef.isUndefined()) { return; }
    var methodName = getFeature(execRef, "name");
    if (methodName.isUndefined() or methodName == "") { return; }
    // Match by configured timing-method name OR `@RoboChartWait`
    // annotation on the called method's declaration.
    var isTiming = timingMethodNames.includes(methodName);
    if (not isTiming) {
        var declType = getFeature(execRef, "declaringType");
        if (declType.isDefined()) {
            var dtn = getFeature(declType, "name");
            if (dtn.isDefined() and javaMethodHasAnnotation(dtn, methodName, "RoboChartWait")) {
                isTiming = true;
            }
        }
    }
    if (not isTiming) { return; }
    var args = getFeature(invocation, "argument");
    if (args.isUndefined() or args.size() == 0) { return; }
    var duration = translateSpoonExpr(args.first());
    if (duration.isUndefined()) { return; }
    var w = new RoboChart!Wait;
    w.duration = duration;
    return w;
}

// Build a RoboChart!ClockReset from a Spoon CtAssignment of the form
// `this.<clockField> = clock.nowMs()`. Returns the ClockReset (pointing
// at the per-stm Clock EObject), or undefined if the assignment isn't a
// clock reset. The metamodel attaches ClockResets to `transition.reset`
// rather than to `transition.action`.
operation buildClockReset(stmt : Any) : Any {
    var lhs = getFeature(stmt, "assigned");
    if (lhs.isUndefined()) { return; }
    if (not lhs.isKindOf(Spoon!CtFieldWrite)) { return; }
    var lhsVarRef = lhs.variable;
    if (lhsVarRef.isUndefined()) { return; }
    var lhsFieldName = getFeature(lhsVarRef, "name");
    if (lhsFieldName.isUndefined() or lhsFieldName == "") { return; }
    if (not clockFieldLookup.containsKey(lhsFieldName)) { return; }

    var rhs = getFeature(stmt, "assignment");
    if (rhs.isUndefined() or not containsClockCall(rhs)) { return; }

    var reset = new RoboChart!ClockReset;
    reset.clock = clockFieldLookup.get(lhsFieldName);
    return reset;
}

// Build a RoboChart!Assignment from a Spoon CtAssignment whose LHS is
// a controller state field. Returns the Assignment, or undefined if the
// assignment can't be faithfully modelled (unknown LHS, clock RHS, ...).
operation buildStateAssignment(stmt : Any, patternVarName : Any, eventTypeName : String) : Any {
    var lhs = getFeature(stmt, "assigned");
    if (lhs.isUndefined()) { return; }
    if (not lhs.isKindOf(Spoon!CtFieldWrite)) { return; }
    var lhsVarRef = lhs.variable;
    if (lhsVarRef.isUndefined()) { return; }
    var lhsFieldName = getFeature(lhsVarRef, "name");
    if (lhsFieldName.isUndefined() or lhsFieldName == "") { return; }
    if (not ctrlStateVarLookup.containsKey(lhsFieldName)) { return; }

    var rhs = getFeature(stmt, "assignment");
    if (rhs.isUndefined()) { return; }
    if (containsClockCall(rhs)) { return; }

    // Make the active pattern variable visible to translateSpoonExpr so
    // event-payload reads (e.g. `o.l()` where `o` is the Java pattern
    // var for an Obstacle event) get remapped to the trigger's `v`
    // binding. Set/clear around the call so nested or sibling assignment
    // extraction sees the right context.
    var savedPatternVar = currentPatternVar;
    if (patternVarName.isDefined() and patternVarName <> "") {
        currentPatternVar = patternVarName;
    }
    var rcRhs = translateSpoonExpr(rhs);
    currentPatternVar = savedPatternVar;
    if (rcRhs.isUndefined()) { return; }

    var assign = new RoboChart!Assignment;
    var vref = new RoboChart!VarRef;
    vref.name = ctrlStateVarLookup.get(lhsFieldName);
    assign.left = vref;
    assign.right = rcRhs;
    return assign;
}

// True iff the given Spoon element carries an annotation whose
// annotation type's simple name equals `simpleName`. Used to detect
// `@Clock` / `@SensorService` / `@RoboChartWait` markers without
// caring about the annotation's package — case studies may declare
// their own annotation types in any package.
operation hasJavaAnnotation(elem : Any, simpleName : String) : Boolean {
    if (elem.isUndefined()) { return false; }
    var anns = getFeature(elem, "annotation");
    if (anns.isUndefined()) { return false; }
    for (a in anns) {
        var atyp = getFeature(a, "annotationType");
        if (atyp.isDefined()) {
            var aname = getFeature(atyp, "name");
            if (aname.isDefined() and aname == simpleName) {
                return true;
            }
        }
    }
    return false;
}

// True iff a Java type (CtClass or CtInterface) with simple name
// `typeName` exists in the model and carries `@<simpleName>` on its
// declaration. Used by `containsClockCall` (test `@Clock` on the
// receiver's declaring type) and Pass-3 sensor detection (test
// `@SensorService` on a controller dependency class).
operation javaTypeHasAnnotation(typeName : String, simpleName : String) : Boolean {
    if (typeName.isUndefined() or typeName == "") { return false; }
    for (cls in Spoon!CtClass.all) {
        if (getFeature(cls, "name") == typeName
                and hasJavaAnnotation(cls, simpleName)) {
            return true;
        }
    }
    for (iface in Spoon!CtInterface.all) {
        if (getFeature(iface, "name") == typeName
                and hasJavaAnnotation(iface, simpleName)) {
            return true;
        }
    }
    return false;
}

// True iff there's a method declaration named `methodName` on a class
// named `className` carrying `@<simpleName>`. Used by
// `buildWaitStatement` to recognise `@RoboChartWait`-annotated methods
// regardless of the method's actual name.
operation javaMethodHasAnnotation(className : String, methodName : String,
                                   simpleName : String) : Boolean {
    if (className.isUndefined() or className == "") { return false; }
    for (cls in Spoon!CtClass.all) {
        if (getFeature(cls, "name") <> className) { continue; }
        for (m in cls.typeMember) {
            if (m.isTypeOf(Spoon!CtMethod) and m.name == methodName
                    and hasJavaAnnotation(m, simpleName)) {
                return true;
            }
        }
    }
    for (iface in Spoon!CtInterface.all) {
        if (getFeature(iface, "name") <> className) { continue; }
        for (m in iface.typeMember) {
            if (m.isTypeOf(Spoon!CtMethod) and m.name == methodName
                    and hasJavaAnnotation(m, simpleName)) {
                return true;
            }
        }
    }
    return false;
}

// True if the given Spoon type-member (field/method/constructor) is
// declared `static`. Used to exclude static utility methods (e.g.
// `Sensor.goreq(Intensity, Intensity)`) from instance-data detection.
operation isStaticMember(tm : Any) : Boolean {
    if (tm.isUndefined()) { return false; }
    var mods = getFeature(tm, "modifier");
    if (mods.isUndefined()) { return false; }
    for (m in mods) {
        if (m.toString() == "STATIC" or m.toString() == "static") {
            return true;
        }
    }
    return false;
}

// Walk a Spoon block (or any statement tree) and collect the names of
// `this.<field>` LHS targets whose RHS is a Clock-method invocation
// (e.g. `clock.nowMs()`). Used by Phase 4.9c-clocks to identify which
// controller fields should become RoboChart clocks instead of variables.
operation collectClockResetFieldNames(node : Any, out : Sequence) {
    if (node.isUndefined()) { return; }
    if (node.isTypeOf(Spoon!CtAssignment)) {
        var lhs = getFeature(node, "assigned");
        var rhs = getFeature(node, "assignment");
        if (lhs.isDefined() and lhs.isKindOf(Spoon!CtFieldWrite)
                and rhs.isDefined() and containsClockCall(rhs)) {
            var lhsVarRef = lhs.variable;
            if (lhsVarRef.isDefined()) {
                var fName = getFeature(lhsVarRef, "name");
                if (fName.isDefined() and fName <> "" and not out.includes(fName)) {
                    out.add(fName);
                }
            }
        }
    }
    // Recurse into composite statement nodes
    if (node.isKindOf(Spoon!CtBlock)) {
        for (s in node.statement) { collectClockResetFieldNames(s, out); }
    }
    if (node.isKindOf(Spoon!CtIf)) {
        collectClockResetFieldNames(getFeature(node, "then"), out);
        collectClockResetFieldNames(getFeature(node, "else"), out);
    }
}

// True iff the expression tree contains a method invocation on a field
// of Clock type, i.e. `clock.nowMs()`. Used to skip state assignments
// whose RHS depends on the clock (e.g. `this.tReset = clock.nowMs()`).
// Detection: CtInvocation whose executableRef.declaringType is Clock,
// OR a target whose declared type is Clock. Recurses through binary /
// unary operators and invocation arguments.
operation containsClockCall(expr : Any) : Boolean {
    if (expr.isUndefined()) { return false; }
    if (expr.isKindOf(Spoon!CtInvocation)) {
        var execRef = getFeature(expr, "executableRef");
        if (execRef.isDefined()) {
            var declType = getFeature(execRef, "declaringType");
            if (declType.isDefined()) {
                var declTypeName = getFeature(declType, "name");
                if (declTypeName.isDefined() and declTypeName == clockClassName) {
                    return true;
                }
                // Annotation-based: declaring type has @Clock
                if (declTypeName.isDefined()
                        and javaTypeHasAnnotation(declTypeName, "Clock")) {
                    return true;
                }
            }
        }
        var target = getFeature(expr, "target");
        if (target.isDefined()) {
            var targetType = getFeature(target, "type");
            if (targetType.isDefined()) {
                var tName = getFeature(targetType, "name");
                if (tName.isDefined() and tName == clockClassName) {
                    return true;
                }
                if (tName.isDefined()
                        and javaTypeHasAnnotation(tName, "Clock")) {
                    return true;
                }
            }
            if (containsClockCall(target)) { return true; }
        }
        var iArgs = getFeature(expr, "argument");
        if (iArgs.isDefined()) {
            for (a in iArgs) {
                if (containsClockCall(a)) { return true; }
            }
        }
        return false;
    }
    if (expr.isTypeOf(Spoon!CtBinaryOperator)) {
        if (containsClockCall(expr.leftOperand)) { return true; }
        if (containsClockCall(expr.rightOperand)) { return true; }
        return false;
    }
    if (expr.isTypeOf(Spoon!CtUnaryOperator)) {
        return containsClockCall(expr.expression);
    }
    return false;
}

// Extract output event info from a CtConstructorCall argument.
// Detects patterns like: actuator.apply(new OutputEvent.AdvVel(value))
// Returns a Map with keys "eventName" and optionally "valueArg", or undefined.
operation extractOutputEventInfo(arg : Any) : Any {
    if (not arg.isKindOf(Spoon!CtConstructorCall)) { return; }
    // In Spoon's EMF model, the constructed type is NOT on the CtConstructorCall.type
    // (which is often null). Instead, it's on executableRef.type or executableRef.declaringType.
    var execRef = getFeature(arg, "executableRef");
    if (execRef.isUndefined()) { return; }
    // Try executableRef.type first (the return type of the constructor = constructed type)
    var ctorTypeRef = getFeature(execRef, "type");
    var typeName = "";
    if (ctorTypeRef.isDefined()) {
        typeName = getFeature(ctorTypeRef, "name");
    }
    // Fallback: try executableRef.declaringType
    if (typeName.isUndefined() or typeName == "" or typeName == "void") {
        var declType = getFeature(execRef, "declaringType");
        if (declType.isDefined()) {
            typeName = getFeature(declType, "name");
        }
    }
    if (typeName.isUndefined() or typeName == "") { return; }
    // Strip package/outer-class prefix (e.g. "OutputEvent.AdvVel" -> "AdvVel")
    if (typeName.indexOf(".") >= 0) {
        typeName = typeName.substring(typeName.lastIndexOf(".") + 1);
    }
    var result = new Map;
    result.put("eventName", typeName);
    var ctorArgs = getFeature(arg, "argument");
    if (ctorArgs.isDefined() and ctorArgs.size() > 0) {
        result.put("valueArg", ctorArgs.at(0));
    }
    return result;
}

// Resolve a CtLiteral directly to a RoboChart expression.
// For integer-valued doubles (e.g. 1.0, 0.0), creates IntegerExp.
// For non-integer doubles, creates FloatExp.
// Returns undefined for non-literals and non-numeric literals.
//
// NOTE: since the T2M metamodel change, CtLiteral carries `value` as an
// EString plus a `valueKind` discriminator (the Java boxed type's simple
// name, e.g. "Integer", "Double"). The old code tested the value against
// Native("java.lang.Number"), which can never match a String — making
// this operation silently dead. Parse the string per valueKind instead.
// The resolvedValues map (typed objects, sign-correct after the T2M
// ValueResolver fix) remains the primary path in callers; this is the
// fallback for literals ValueResolver did not fold.
operation resolveLiteralValue(arg : Any) : Any {
    if (not arg.isKindOf(Spoon!CtLiteral)) { return; }
    var litValue = getFeature(arg, "value");
    if (litValue.isUndefined()) { return; }
    var kind = getFeature(arg, "valueKind");
    if (kind.isUndefined()) { kind = ""; }
    if (kind == "Integer" or kind == "Long" or kind == "Short" or kind == "Byte") {
        var boxed = new Native("java.lang.Double")(litValue.toString());
        var intExpr = new RoboChart!IntegerExp;
        intExpr.value = boxed.intValue();
        return intExpr;
    }
    if (kind == "Double" or kind == "Float") {
        var boxed = new Native("java.lang.Double")(litValue.toString());
        var dv = boxed.doubleValue();
        var iv = boxed.intValue();
        if (dv == iv) {
            var intExpr = new RoboChart!IntegerExp;
            intExpr.value = iv;
            return intExpr;
        }
        var floatExpr = new RoboChart!FloatExp;
        floatExpr.value = boxed.floatValue();
        return floatExpr;
    }
    if (kind == "Boolean") {
        var boolExpr = new RoboChart!BooleanExp;
        boolExpr.value = litValue.toString();
        return boolExpr;
    }
    // Character / String / null literals have no RoboChart literal form here.
}

// ---------------------------------------------------------------------------
// U5 FIX — resolve a Java field's INITIAL VALUE to a RoboChart literal.
//
// Defect: `RoboChart!Variable.initial` was never populated anywhere in this
// transformation, so every emitted model contained zero <initial> elements
// and each backend fell back to its own type default. On the CSP path the
// booleans came out WRONG (Memory_camActive started `true` where the Java
// constructor sets `false`), which is under-approximating with respect to
// the Java's initial state: the model starts somewhere the program cannot.
//
// Java semantics implemented here (and the reason for the two-step lookup):
// a field declaration initialiser runs first, then the constructor body
// executes and may overwrite it. So the CONSTRUCTOR assignment WINS on
// collision — the same ordering java2dafny.egl already implements in its
// `extractStateFields` operation (the `ctorInits` map: comment at :631, the
// populating for-loop opens at :640 and closes at :676; :677 begins the
// separate declaration-site capture loop)
// for the Dafny constructor, which is why the Dafny artefact was already
// emitting `cstc := -1` while the RoboChart model carried nothing.
//
// Value resolution prefers the `resolvedValues` map injected by the T2M
// phase (post-T2M-2 it folds negated literals, so `cstc = -1` resolves to
// Integer(-1) rather than the +1 the persisted XMI still shows), and falls
// back to the literal's own value/valueKind attributes.
//
// Deliberately NOT resolved (returns undefined, leaving `initial` absent and
// the emission byte-identical to before this fix):
//   * non-literal initialisers such as `Double.MAX_VALUE` or a method call —
//     folding those would require constant propagation this stage does not do;
//   * constructor-parameter passthrough (`this.sensor = sensor`, a
//     CtVariableRead) — those are dependency objects, not data state, and are
//     excluded by the caller's final-modifier check anyway;
//   * String/char/null literals, which have no RoboChart literal form.
// Leaving the slot absent preserves the pre-fix behaviour for exactly the
// cases the fix cannot honestly represent, rather than substituting a value.
operation resolveJavaFieldInitial(classDecl : Any, fieldDecl : Any, fieldName : String) : Any {
    // Step 1 — declaration initialiser (`private int cstc = -1;`).
    var declInit = getFeature(fieldDecl, "assignment");
    if (declInit.isUndefined()) {
        declInit = getFeature(fieldDecl, "defaultExpression");
    }
    var result = resolveInitialExpression(declInit);
    if (declInit.isDefined() and result.isUndefined()) {
        // The Java DOES give this field an initial value but it is not a
        // primitive literal this fix can carry. The two shapes present in the
        // case studies are enum literals (`private Status sts = Status.noGas;`)
        // and collection constructors (`= new ArrayList<>()`).
        //
        // Enum initials are deliberately NOT emitted, and the reason is
        // downstream rather than here: robochart2rct.egl's formatRctExprPrec
        // (:1748-1805) has no EnumExp branch, so it falls through to its
        // "UNKNOWN" default and the .rct would read `var sts : Status = UNKNOWN`
        // — a worse artefact than the missing initial, and one the CSP
        // generator cannot parse. Emitting them requires an EnumExp case in
        // that operation first; until then the slot is left absent and the
        // gap is announced here rather than passing silently.
        ("[u5-initial] " + fieldName + ": declaration initialiser is not a "
                + "primitive literal (enum literal / constructor call) — no "
                + "initial emitted; see formatRctExprPrec EnumExp gap").println();
    }

    // Step 2 — constructor-body assignment (`this.cstc = -1;`), which
    // OVERWRITES the declaration initialiser in Java's execution order.
    // Only top-level statements of the constructor body are considered: a
    // conditional or loop-nested assignment has no single static value.
    for (tm in classDecl.typeMember) {
        if (not tm.isTypeOf(Spoon!CtConstructor)) { continue; }
        var cbody = getFeature(tm, "body");
        if (cbody.isUndefined() or not cbody.isKindOf(Spoon!CtBlock)) { continue; }
        for (cstmt in cbody.statement) {
            if (not cstmt.isTypeOf(Spoon!CtAssignment)) { continue; }
            var lhs = getFeature(cstmt, "assigned");
            if (lhs.isUndefined()) { continue; }
            if (not (lhs.isKindOf(Spoon!CtFieldWrite) or lhs.isKindOf(Spoon!CtFieldAccess))) {
                continue;
            }
            var lhsVar = getFeature(lhs, "variable");
            if (lhsVar.isUndefined()) { continue; }
            if (getFeature(lhsVar, "name") <> fieldName) { continue; }
            var rhs = getFeature(cstmt, "assignment");
            var ctorResolved = resolveInitialExpression(rhs);
            if (ctorResolved.isDefined()) {
                // Constructor wins.
                result = ctorResolved;
            } else {
                // The constructor DOES assign this field but the value did
                // not fold (e.g. `this.cda = Double.MAX_VALUE`). Emitting the
                // declaration initialiser here would be wrong — Java would
                // have overwritten it — so drop back to no initial at all.
                result = null;
                ("[u5-initial] " + fieldName + ": constructor assigns a value that "
                        + "did not resolve to a literal — no initial emitted "
                        + "(backend type default applies)").println();
            }
        }
    }
    return result;
}

// Resolve one Spoon expression to a RoboChart literal Expression for use as
// a Variable.initial, or undefined when it does not fold. Handles the unary
// minus wrapper directly as well: the PERSISTED discovered_model.xmi stores
// `-1` as CtUnaryOperator[NEG] over CtLiteral("1") with no value="-1"
// anywhere in the file, so a consumer reading the XMI rather than the live
// resolvedValues map would otherwise recover +1 (audit finding P4).
operation resolveInitialExpression(expr : Any) : Any {
    if (expr.isUndefined()) { return; }

    // Preferred: the T2M-injected value map (sign-correct post T2M-2).
    if (resolvedValues.isDefined() and resolvedValues.containsKey(expr)) {
        var resolved = resolvedValues.get(expr);
        if (resolved.isKindOf(Native("java.lang.Boolean"))) {
            var boolExpr = new RoboChart!BooleanExp;
            boolExpr.value = resolved.toString();
            return boolExpr;
        }
        if (resolved.isKindOf(Native("java.lang.Integer"))
                or resolved.isKindOf(Native("java.lang.Long"))
                or resolved.isKindOf(Native("java.lang.Short"))
                or resolved.isKindOf(Native("java.lang.Byte"))) {
            var intExpr = new RoboChart!IntegerExp;
            intExpr.value = resolved.intValue();
            return intExpr;
        }
        if (resolved.isKindOf(Native("java.lang.Double"))
                or resolved.isKindOf(Native("java.lang.Float"))) {
            var dv = resolved.doubleValue();
            var iv = resolved.intValue();
            if (dv == iv) {
                // Integral real: emit in integer form. The .rct consumer
                // (robochart2rct.egl:448-461) does the same normalisation
                // because the CSP generator v3.0.0 cannot compile FloatExp.
                var intExpr2 = new RoboChart!IntegerExp;
                intExpr2.value = iv;
                return intExpr2;
            }
            var floatExpr = new RoboChart!FloatExp;
            floatExpr.value = resolved.floatValue();
            return floatExpr;
        }
        return;
    }

    // Unary minus over a literal (the persisted-XMI shape of a negative
    // initialiser). Recurse and negate the recovered literal.
    if (expr.isKindOf(Spoon!CtUnaryOperator)) {
        var opKind = getFeature(expr, "kind");
        if (opKind.isUndefined()) { opKind = getFeature(expr, "operatorKind"); }
        if (opKind.isDefined() and opKind.toString() == "NEG") {
            var inner = resolveInitialExpression(getFeature(expr, "operand"));
            if (inner.isUndefined()) { return; }
            if (inner.isKindOf(RoboChart!IntegerExp)) {
                var negInt = new RoboChart!IntegerExp;
                negInt.value = 0 - inner.value;
                return negInt;
            }
            if (inner.isKindOf(RoboChart!FloatExp)) {
                var negFloat = new RoboChart!FloatExp;
                negFloat.value = 0.0 - inner.value;
                return negFloat;
            }
        }
        return;
    }

    // Plain literal: use its own value/valueKind attributes.
    if (expr.isKindOf(Spoon!CtLiteral)) {
        return resolveLiteralValue(expr);
    }
}

// Build a RoboChart Communication from a Spoon CtInvocation (E4 fix).
// Extracts the method name from executableRef and creates/reuses an Event.
// Detects OutputEvent constructor pattern: method(new OutputEvent.SubType(args))
// to split single apply() calls into separate advVel/advHdng events.
// E11: patternVarName enables data flow detection in arguments.
// E11 cross-branch: if event is already typed (by another branch) and the primary
// resolution fails (no pattern variable), falls back to direct value resolution
// to satisfy the typed channel contract.
operation buildCommunication(invocation : Any, stm : Any, eventMap : Map, patternVarName : Any, eventTypeName : String) : Any {
    var execRef = getFeature(invocation, "executableRef");
    if (execRef.isUndefined()) { return; }
    var methodName = getFeature(execRef, "name");
    if (methodName.isUndefined() or methodName == "") { return; }

    // Detect OutputEvent constructor pattern: method(new OutputEvent.AdvVel(args))
    // If detected, use the constructor type name as the event name instead of method name,
    // and resolve the constructor's argument as the value expression.
    var args = getFeature(invocation, "argument");
    var actualEventName = methodName;
    var ctorValueArg;
    if (args.isDefined() and args.size() > 0) {
        var firstArg = args.at(0);
        var outputInfo = extractOutputEventInfo(firstArg);
        if (outputInfo.isDefined()) {
            actualEventName = outputInfo.get("eventName");
            ctorValueArg = outputInfo.get("valueArg");
        }
    }

    var evt = getOrCreateEvent(actualEventName, eventMap, stm);
    var comm = new RoboChart!Communication;
    comm.event = evt;
    setCommunicationType(comm, "SIMPLE");

    // OutputEvent constructor path: resolve the constructor's argument
    if (ctorValueArg.isDefined()) {
        var valueExpr = resolveArgumentValue(ctorValueArg, patternVarName, eventTypeName);
        if (valueExpr.isUndefined()) {
            // resolveArgumentValue doesn't handle raw CtLiteral without pattern variable;
            // fall back to direct literal resolution for constructor args like 1.0, 0.0
            valueExpr = resolveLiteralValue(ctorValueArg);
        }
        if (valueExpr.isDefined()) {
            comm.value = valueExpr;
            setCommunicationType(comm, "OUTPUT");
            markEventTyped(evt, actualEventName);
        }
        return comm;
    }

    // Original path: non-constructor arguments (E11 check)
    if (args.isDefined() and args.size() > 0) {
        var firstArg = args.at(0);
        var valueExpr = resolveArgumentValue(firstArg, patternVarName, eventTypeName);
        if (valueExpr.isDefined()) {
            comm.value = valueExpr;
            setCommunicationType(comm, "OUTPUT");
            // Mark action event as typed with per-event TypeDecl
            if (valueExpr.isKindOf(RoboChart!CallExp)) {
                var funcExpr = getRcFeature(valueExpr, "function");
                var funcName = "";
                if (funcExpr.isDefined() and funcExpr.isKindOf(RoboChart!StringExp)) {
                    funcName = funcExpr.value;
                }
                if (funcName.startsWith("v_")) {
                    markEventTypedForField(evt, eventTypeName, funcName.substring(2));
                } else {
                    markEventTyped(evt, eventTypeName);
                }
            } else {
                markEventTyped(evt, eventTypeName);
            }
        } else if (getFeature(evt, "type").isDefined()) {
            // E11 cross-branch: event already typed by another branch.
            // Resolve value directly (without pattern variable guard) to satisfy
            // the typed channel contract. Do NOT call markEventTyped — already typed.
            var fallbackExpr = resolveArgumentDirect(firstArg);
            if (fallbackExpr.isDefined()) {
                comm.value = fallbackExpr;
                setCommunicationType(comm, "OUTPUT");
            } else {
                // Last resort: IntegerExp(0) to prevent FDR4 type error on typed
                // channel. This SUBSTITUTES a value — warn loudly (was silent).
                ("[m2m] WARNING: unresolved value for typed event '"
                        + actualEventName
                        + "' substituted with IntegerExp(0) (cross-branch typed-channel fill)").println();
                var intExpr = new RoboChart!IntegerExp;
                intExpr.value = 0;
                comm.value = intExpr;
                setCommunicationType(comm, "OUTPUT");
            }
        }
    }
    return comm;
}

// Attach extracted actions to the most recently created transition (E4 fix).
// ClockReset items go to `transition.reset` (separate slot in metamodel).
// Communications wrap in CommunicationStmt; Assignments are Statements.
// Single non-reset action -> direct wrapper; multiple -> SeqStatement.
operation attachActions(stm : Any, actions : Sequence) {
    if (actions.isEmpty()) { return; }
    var lastTrans = stm.transitions.last();
    var resets = new Sequence;
    var others = new Sequence;
    for (a in actions) {
        if (a.isKindOf(RoboChart!ClockReset)) {
            resets.add(a);
        } else {
            others.add(a);
        }
    }
    for (r in resets) {
        lastTrans.reset.add(r);
    }
    if (others.isEmpty()) { return; }
    if (others.size() == 1) {
        lastTrans.action = wrapAction(others.at(0));
    } else {
        var seq = new RoboChart!SeqStatement;
        for (a in others) {
            seq.statements.add(wrapAction(a));
        }
        lastTrans.action = seq;
    }
}

// Wrap a Communication in a CommunicationStmt; pass an Assignment
// or Wait through unchanged (both already implement Statement).
operation wrapAction(a : Any) : Any {
    if (a.isKindOf(RoboChart!Communication)) {
        var commStmt = new RoboChart!CommunicationStmt;
        commStmt.communication = a;
        return commStmt;
    }
    return a;
}

// Reflective EMF feature access (needed for features named "then"/"else" which are EOL keywords)
operation getFeature(obj : Any, featureName : String) : Any {
    var f = obj.eClass().getEStructuralFeature(featureName);
    if (f.isUndefined()) {
        return;
    }
    return obj.eGet(f);
}

// Check if a Spoon type element (CtClass / CtInterface) is declared
// `sealed`. The Java sealed-interface idiom is the codegen convention
// for algebraic event types (per CLAUDE.md: "Sealed interfaces for
// algebraic data types (events)"), so any record nested inside a
// sealed interface IS an event variant — handled by the event-typing
// pass, not by the data-record pass. Replaces an earlier
// `containerName.endsWith("Event"/"Events")` heuristic that hardwired
// a naming convention. Structural detection keeps the pipeline
// domain-independent.
operation isSealedJavaType(typeDecl : Any) : Boolean {
    if (typeDecl.isUndefined()) { return false; }
    var mods = getFeature(typeDecl, "modifier");
    if (mods.isUndefined()) { return false; }
    if (mods.isKindOf(Collection)) {
        for (m in mods) {
            if (m.toString() = "SEALED") { return true; }
        }
    }
    return false;
}

// Convert PascalCase to camelCase (lowercase first character).
// Used for event naming: Java uses PascalCase (ReqVel), RoboChart uses camelCase (reqVel).
operation toCamelCase(name : String) : String {
    if (name.length() == 0) { return name; }
    return name.substring(0, 1).toLowerCase() + name.substring(1);
}

// Convert SCREAMING_SNAKE_CASE to camelCase.
// E.g., "MIN_SAFE_DIST" -> "minSafeDist", "STATIC_OBS_HORIZ_DIST" -> "staticObsHorizDist".
operation screamingSnakeToCamel(name : String) : String {
    var parts = name.split("_");
    var result = "";
    for (i in Sequence{0..parts.size() - 1}) {
        var part = parts.get(i);
        if (part.length() == 0) { continue; }
        if (i == 0) {
            result = part.toLowerCase();
        } else {
            result = result + part.substring(0, 1).toUpperCase() + part.substring(1).toLowerCase();
        }
    }
    return result;
}

// =====================================================================
// Factory operations for official RoboChart metamodel
// =====================================================================

// Create a concrete BinaryExpression subclass for the given operator name.
// Official metamodel: BinaryExpression is abstract; And, Or, Equals, etc. are concrete.
operation createRcBinaryExpr(opName : String) : Any {
    if (opName == "and") { return new RoboChart!And; }
    if (opName == "or") { return new RoboChart!Or; }
    if (opName == "eq") { return new RoboChart!Equals; }
    if (opName == "neq") { return new RoboChart!Different; }
    if (opName == "lt") { return new RoboChart!LessThan; }
    if (opName == "gt") { return new RoboChart!GreaterThan; }
    if (opName == "leq") { return new RoboChart!LessOrEqual; }
    if (opName == "geq") { return new RoboChart!GreaterOrEqual; }
    if (opName == "plus") { return new RoboChart!Plus; }
    if (opName == "minus") { return new RoboChart!Minus; }
    if (opName == "mult") { return new RoboChart!Mult; }
    if (opName == "div") { return new RoboChart!Div; }
    return new RoboChart!And;
}

// Create a concrete unary expression (Not or Neg).
// Official metamodel: no UnaryExpression; use Not (with exp) or Neg (with exp).
operation createRcUnaryExpr(opName : String) : Any {
    if (opName == "not") { return new RoboChart!Not; }
    if (opName == "neg") { return new RoboChart!Neg; }
    return new RoboChart!Not;
}

// Create a CallExp with a StringExp function name (convenience factory).
// In the official metamodel, CallExp.function is Expression (containment), not String.
// We use StringExp to store the name for synthetic guard references.
operation createNamedCallExp(name : String) : Any {
    var callExpr = new RoboChart!CallExp;
    var nameExpr = new RoboChart!StringExp;
    nameExpr.value = name;
    var funcF = callExpr.eClass().getEStructuralFeature("function");
    callExpr.eSet(funcF, nameExpr);
    return callExpr;
}

// Set the CommunicationType enum on a Communication using reflective EMF access.
// Feature name "_type" starts with underscore, requiring reflective access.
operation setCommunicationType(comm : Any, typeName : String) {
    var f = comm.eClass().getEStructuralFeature("_type");
    var enumType = f.getEType();
    comm.eSet(f, enumType.getEEnumLiteral(typeName));
}

// Find the first CtIf statement in a CtBlock, skipping variable declarations
// and other non-if statements (e.g. named boolean predicates).
operation findFirstCtIf(block : Any) : Any {
    if (not block.isKindOf(Spoon!CtBlock)) {
        return;
    }
    for (stmt in block.statement) {
        if (stmt.isTypeOf(Spoon!CtIf)) {
            return stmt;
        }
    }
}

// Walk an inner if-else chain within a mode block (E8 fix).
// The source state is fixed (from the outer branch's currentMode == X).
// Each inner branch may have an event trigger, guard conjuncts, and a target mode.
// C1 fix: accumulates each preceding TRIGGERLESS branch's data guard and
// prepends its negation to every later branch (and the terminal else) so the
// model encodes Java's if-else priority (first matching branch wins) —
// reinstating the E6 behaviour that the Phase-3 change removed, which the
// Tier-B conformance enumeration proved to be an extraction gap.
operation walkInnerChain(firstIf : Any, sourceModeName : String,
        stm : Any, stateMap : Map, stateNames : Sequence,
        eventMap : Map, tCount : Integer, predDefs : Map) : Integer {
    // Accumulated raw guards of preceding triggerless branches (chain order).
    var priorityPredecessors = new Sequence;
    var currentIf = firstIf;
    while (currentIf.isDefined() and currentIf.isTypeOf(Spoon!CtIf)) {
        var cond = currentIf.condition;
        var conjuncts = flattenCondition(cond);
        var eventTypeName = "";
        var patternVarName = "";
        var guardConjuncts = new Sequence;

        for (conj in conjuncts) {
            var consumed = false;
            // No mode comparison extraction — source is fixed from outer level
            var evtType = extractInstanceofType(conj);
            if (evtType.isDefined()) {
                eventTypeName = evtType;
                // E11: extract pattern variable name for data flow tracking
                var pv = extractPatternVariable(conj);
                if (pv.isDefined()) {
                    patternVarName = pv;
                }
                consumed = true;
            }
            if (not consumed) {
                guardConjuncts.add(conj);
            }
        }

        // Get then-block early for cast variable detection
        var thenBlock = getFeature(currentIf, "then");

        // E11: fallback to cast variable detection for traditional instanceof
        if (patternVarName == "" and eventTypeName <> "") {
            var cv = extractCastVariable(thenBlock, eventTypeName);
            if (cv.isDefined()) {
                patternVarName = cv;
            }
        }

        // E11: mark trigger event as typed if pattern/cast variable was detected
        if (eventTypeName <> "" and patternVarName <> "") {
            var trigEvt = getOrCreateEvent(eventTypeName, eventMap, stm);
            markEventTyped(trigEvt, eventTypeName);
        }

        var targetModeName = findTargetMode(thenBlock);

        // C1 fix: raw guard captured before negation-rewrite (see outer chain).
        var branchRawGuard;

        // Create transition: source is always sourceModeName
        if (targetModeName <> "") {
            tCount = createTransition(stm, stateMap, sourceModeName, targetModeName,
                    eventTypeName, eventMap, tCount, guardConjuncts, predDefs, currentIf);
            branchRawGuard = stm.transitions.last().condition;
            // C1 fix: this branch fires only when no preceding triggerless
            // guard in the chain holds — prepend their negations.
            applyPriorityNegations(stm, priorityPredecessors);
            // E4/E11: extract actions from inner then-block with pattern variable context
            var innerActions = extractActions(thenBlock, stm, eventMap, patternVarName, eventTypeName);
            attachActions(stm, innerActions);
        }
        // E9: no-op branch with event trigger -> self-transition
        // Skip empty handler bodies (no statements) — these are no-op
        // branches that should not produce transitions.
        var innerThenStmts = thenBlock.isDefined() and thenBlock.isKindOf(Spoon!CtBlock)
                ? thenBlock.statement : Sequence{};
        if (targetModeName == "" and eventTypeName <> "" and innerThenStmts.size() > 0) {
            tCount = createTransition(stm, stateMap, sourceModeName, sourceModeName,
                    eventTypeName, eventMap, tCount, guardConjuncts, predDefs, currentIf);
            // C1 fix: event-triggered self-loops also fire only below
            // higher-priority triggerless guards.
            applyPriorityNegations(stm, priorityPredecessors);
            // E4/E11: extract actions from inner self-transition
            var innerE9Actions = extractActions(thenBlock, stm, eventMap, patternVarName, eventTypeName);
            attachActions(stm, innerE9Actions);
        }

        // C1 fix: contribute this branch's guard for later branches.
        // Rule (a): only TRIGGERLESS branches contribute.
        if (eventTypeName == "" and guardConjuncts.size() > 0) {
            if (branchRawGuard.isDefined()) {
                priorityPredecessors.add(branchRawGuard);
            } else {
                ("[priority-c1] WARNING: dropped triggerless guarded inner branch in "
                        + stm.name + "." + sourceModeName
                        + " (no target mode) — its blocking effect on later "
                        + "branches is NOT encoded").println();
            }
        }

        // Follow inner else branch
        var elseVal = getFeature(currentIf, "else");
        if (elseVal.isDefined() and elseVal.isKindOf(Spoon!CtBlock)) {
            if (elseVal.statement.size() > 0) {
                var firstStmt = elseVal.statement.at(0);
                if (firstStmt.isTypeOf(Spoon!CtIf)) {
                    elseVal = firstStmt;
                } else {
                    // Terminal else in inner chain: single transition from sourceModeName
                    var elseTarget = findTargetMode(elseVal);
                    if (elseTarget <> "") {
                        tCount = createTransition(stm, stateMap, sourceModeName, elseTarget,
                                "", eventMap, tCount, new Sequence, predDefs, currentIf);
                        // C1 fix (E13): the terminal else fires only when no preceding
                        // triggerless guard holds — receive the accumulated negations.
                        applyPriorityNegations(stm, priorityPredecessors);
                        // E4: extract actions from inner terminal else (no pattern var in else)
                        var innerElseActions = extractActions(elseVal, stm, eventMap, "", "");
                        attachActions(stm, innerElseActions);
                    }
                    elseVal = null;
                }
            }
        }
        currentIf = elseVal;
    }
    return tCount;
}

// Get or create a named Event in the state machine.
operation getOrCreateEvent(eventName : String, eventMap : Map, stm : Any) : Any {
    if (eventMap.containsKey(eventName)) {
        return eventMap.get(eventName);
    }
    var evt = new RoboChart!Event;
    evt.name = toCamelCase(eventName);
    stm.events.add(evt);
    eventMap.put(eventName, evt);

    // Trace: Java event type class/record → RoboChart Event
    var te = new Map;
    te.put("robochart_type", "Event");
    te.put("robochart_element", eventName);
    te.put("java_element", eventName);
    te.put("java_type", "CtClass");
    traceEntries.add(te);

    return evt;
}

// =====================================================================
// E11: Event data / payload extraction
// =====================================================================

// Extract the pattern variable name from a pattern-matching instanceof.
// Returns the variable name (e.g. "rv") if the expression is INSTANCEOF
// with a CtTypePattern, or undefined for plain instanceof / non-instanceof.
operation extractPatternVariable(expr : Any) : Any {
    if (not expr.isTypeOf(Spoon!CtBinaryOperator)) { return; }
    if (getOpName(expr) <> "INSTANCEOF") { return; }
    var rightOp = expr.rightOperand;
    if (rightOp.isUndefined()) { return; }
    if (rightOp.isKindOf(Spoon!CtTypePattern)) {
        var patternVar = rightOp.variable;
        if (patternVar.isDefined()) {
            return getFeature(patternVar, "name");
        }
    }
}

// Extract the cast variable name from a CtLocalVariable declaration in a then-block.
// Finds the first CtLocalVariable whose declared type name matches the instanceof type.
// Returns the variable name (e.g. "rv") or undefined if no match found.
// This handles the traditional instanceof + explicit cast pattern:
//   if (event instanceof InputEvent.ReqVel) {
//       InputEvent.ReqVel rv = (InputEvent.ReqVel) event;
//       ...
//   }
operation extractCastVariable(block : Any, eventTypeName : String) : Any {
    if (block.isUndefined() or not block.isKindOf(Spoon!CtBlock)) {
        return;
    }
    if (eventTypeName == "") {
        return;
    }
    for (stmt in block.statement) {
        if (stmt.isTypeOf(Spoon!CtLocalVariable)) {
            var localType = getFeature(stmt, "type");
            if (localType.isDefined()) {
                var localTypeName = getFeature(localType, "name");
                if (localTypeName.isDefined()) {
                    // Strip package prefix if present (match extractInstanceofType behaviour)
                    if (localTypeName.indexOf(".") >= 0) {
                        localTypeName = localTypeName.substring(localTypeName.lastIndexOf(".") + 1);
                    }
                    if (localTypeName == eventTypeName) {
                        return getFeature(stmt, "name");
                    }
                }
            }
        }
    }
}

// Mark an event as carrying data by creating a per-event PrimitiveType.
// The PrimitiveType name encodes field info using ONLY identifier-safe
// characters (underscores): "EvtName_Type_field_type" or
// "EvtName_Type_f1_t1_f2_t2". Uses record metadata from the live Spoon
// AST when available; falls back to "value_int". Idempotent -- does
// nothing if type is already set.
// Official metamodel: TypeDecl is abstract; use PrimitiveType. Event.type is Type (containment);
// wrap in TypeRef.
// NOTE: the previous delimiters (`|`, `:`, `.`) broke Isabelle's
// identifier lexer. No downstream consumer parses this encoding, so
// switching to underscore-only is safe for CSP/Dafny/Isabelle.
operation markEventTyped(evt : Any, eventTypeName : String) {
    var existingType = getFeature(evt, "type");
    if (existingType.isDefined()) { return; }

    // FIX (2026-09-14). Two ways the metadata key was missed, both
    // observed on chem run-1 v2 (instrumented trace):
    //   1. the OUTPUT path for an ENTRY-ACTION output (actuator.turn(anl)
    //      outside any instanceof branch) calls with eventTypeName = "" —
    //      the synthetic value_int fallback then typed `turn`, and because
    //      this operation returns early once a type exists, the trigger
    //      side's later correct call (typeName=Turn, metadata hit) could
    //      never repair it: `event turn : int` vs a writer sending Angle,
    //      and FDR4 died on the payload type clash.
    //   2. method name vs record simple name case ("turn" vs "Turn").
    // Derive the candidate from the event's own name when the caller has
    // none, and resolve the lowercase-method -> Capitalised-record
    // convention before falling through.
    if (recordMetadata.isDefined()) {
        var candidate = eventTypeName;
        if (candidate == "") {
            candidate = getFeature(evt, "name");
        }
        if (candidate.isDefined() and candidate.length() > 0
            and not recordMetadata.containsKey(candidate)) {
            var cap = candidate.substring(0, 1).toUpperCase()
                      + candidate.substring(1, candidate.length());
            if (recordMetadata.containsKey(cap)) {
                candidate = cap;
            }
        }
        if (candidate.isDefined() and recordMetadata.containsKey(candidate)) {
            eventTypeName = candidate;
        }
    }

    // Preferred path: single-field event records map to a clean
    // RoboChart TypeRef (Enumeration / RecordType / PrimitiveType / SeqType).
    // Multi-field records still fall back to a synthetic PrimitiveType
    // because RoboChart's event-typing slot doesn't carry multi-field
    // record decompositions.
    if (recordMetadata.isDefined() and recordMetadata.containsKey(eventTypeName)) {
        var fields = recordMetadata.get(eventTypeName);
        if (fields.size() == 1) {
            var f = fields.first();
            var mapped = mapJavaTypeToRcTypeRef(f.javaType(), f.elementType(), enumTypeMap, recordTypeMap, rcPackage);
            if (mapped.isDefined()) {
                evt.type = mapped;
                return;
            }
        }
    }

    // Fallback: synthesise a per-event PrimitiveType from the field
    // metadata (original behaviour). Only used when the preferred path
    // can't produce a meaningful TypeRef (e.g. multi-field records,
    // unmapped Java types).
    var fieldEncoding = "value_int";
    if (recordMetadata.isDefined() and recordMetadata.containsKey(eventTypeName)) {
        var fields = recordMetadata.get(eventTypeName);
        var parts = new Sequence;
        for (field in fields) {
            parts.add(field.name() + "_" + field.javaType());
        }
        fieldEncoding = parts.concat("_");
    }
    var primType = new RoboChart!PrimitiveType;
    primType.name = evt.name + "_Type_" + fieldEncoding;
    rcPackage.types.add(primType);
    var typeRef = new RoboChart!TypeRef;
    typeRef.ref = primType;
    evt.type = typeRef;
}

// Mark an event as typed for a specific field of a multi-field record.
// Creates a single-field PrimitiveType (e.g. "doX_Type_x_double") for
// action events that carry only one field from a multi-field record.
operation markEventTypedForField(evt : Any, eventTypeName : String, fieldName : String) {
    var existingType = getFeature(evt, "type");
    if (existingType.isDefined()) { return; }
    if (recordMetadata.isDefined() and recordMetadata.containsKey(eventTypeName)) {
        var fields = recordMetadata.get(eventTypeName);
        for (field in fields) {
            if (field.name() == fieldName) {
                var primType = new RoboChart!PrimitiveType;
                primType.name = evt.name + "_Type_" + fieldName + "_" + field.javaType();
                rcPackage.types.add(primType);
                var typeRef = new RoboChart!TypeRef;
                typeRef.ref = primType;
                evt.type = typeRef;
                return;
            }
        }
    }
    // Field not found in metadata: fall back to full event type
    markEventTyped(evt, eventTypeName);
}

// Resolve a method argument to a RoboChart Expression for Communication.value.
// Case 1: argument is rv.accessor() where rv is the pattern variable
//         -> CallExp("v") (the abstract variable bound from the trigger)
// Case 2: argument is a CtLiteral -> resolved value via resolvedValues map,
//         or IntegerExp(0) as fallback if no resolved value available
// Case 3: argument is a CtFieldRead (named constant) -> resolved value via
//         resolvedValues map, or IntegerExp(0) as fallback
// Returns undefined if no argument, no pattern variable, or unrecognised.
operation resolveArgumentValue(arg : Any, patternVarName : Any, eventTypeName : String) : Any {
    // Case 1: method call on pattern variable (e.g. rv.velocity())
    if (arg.isKindOf(Spoon!CtInvocation)) {
        var target = getFeature(arg, "target");
        if (target.isDefined() and target.isKindOf(Spoon!CtVariableRead)) {
            var varRef = target.variable;
            if (varRef.isDefined() and patternVarName.isDefined() and patternVarName <> "") {
                var refName = getFeature(varRef, "name");
                if (refName == patternVarName) {
                    // Check if record has multiple fields
                    var isMultiField = false;
                    if (recordMetadata.isDefined() and recordMetadata.containsKey(eventTypeName)) {
                        var fields = recordMetadata.get(eventTypeName);
                        if (fields.size() > 1) {
                            isMultiField = true;
                        }
                    }
                    if (isMultiField) {
                        // Multi-field: extract accessor name (e.g. rv.x() -> "x")
                        var argExecRef = getFeature(arg, "executableRef");
                        var accessorName = getFeature(argExecRef, "name");
                        return createNamedCallExp("v_" + accessorName);
                    } else {
                        return createNamedCallExp("v");
                    }
                }
            }
        }
    }
    // Case 2 & 3: resolve literals and named constants (CtFieldRead).
    // Always resolve when a pattern variable is active.  Also resolve when no
    // pattern variable but the argument is a resolvable constant — this handles
    // action calls like actuator.adviseVelocity(LreConstants.MOM_ADVISED_SPEED)
    // in branches with empty-record events (no pattern variable).
    if (arg.isKindOf(Spoon!CtLiteral) or arg.isKindOf(Spoon!CtFieldRead)) {
        // Try resolved value lookup from ValueResolver pre-processing
        if (resolvedValues.isDefined() and resolvedValues.containsKey(arg)) {
            var resolved = resolvedValues.get(arg);
            if (resolved.isKindOf(Native("java.lang.Double"))
                    or resolved.isKindOf(Native("java.lang.Float"))) {
                var floatExpr = new RoboChart!FloatExp;
                floatExpr.value = resolved.floatValue();
                return floatExpr;
            } else if (resolved.isKindOf(Native("java.lang.Integer"))
                    or resolved.isKindOf(Native("java.lang.Long"))
                    or resolved.isKindOf(Native("java.lang.Short"))
                    or resolved.isKindOf(Native("java.lang.Byte"))) {
                var intExpr = new RoboChart!IntegerExp;
                intExpr.value = resolved.intValue();
                return intExpr;
            }
        }
        // State-field read (e.g. `this.l`) — emit a named CallExp so the
        // .rct references the state variable rather than IntegerExp(0).
        if (arg.isKindOf(Spoon!CtFieldRead)) {
            var fieldVarRef = arg.variable;
            if (fieldVarRef.isDefined()) {
                var fieldRefName = getFeature(fieldVarRef, "name");
                if (fieldRefName.isDefined()
                        and ctrlStateVarLookup.containsKey(fieldRefName)) {
                    return createNamedCallExp(fieldRefName);
                }
            }
        }
        // No resolvedValues entry: parse the literal's own value/valueKind
        // attributes (T2M mapper) before substituting anything.
        if (arg.isKindOf(Spoon!CtLiteral)) {
            var directLit = resolveLiteralValue(arg);
            if (directLit.isDefined()) {
                return directLit;
            }
        }
        // Fallback when a pattern variable is active but no resolved value.
        // This SUBSTITUTES IntegerExp(0) for an unresolved argument — warn
        // loudly (was silent; a wrong payload constant reaches the .rct).
        if (patternVarName.isDefined() and patternVarName <> "") {
            ("[m2m] WARNING: unresolved communication argument ("
                    + arg.eClass().getName()
                    + ") substituted with IntegerExp(0)").println();
            var intExpr = new RoboChart!IntegerExp;
            intExpr.value = 0;
            return intExpr;
        }
    }
}

// Resolve a literal or field-read argument directly from resolvedValues,
// WITHOUT requiring a pattern variable. Used for cross-branch channel consistency:
// when an event is already typed by another branch, this resolves values in
// branches that lack a pattern variable (e.g. guard-only branches).
// Returns undefined if the argument is not a CtLiteral/CtFieldRead or has no resolved value.
operation resolveArgumentDirect(arg : Any) : Any {
    if (not (arg.isKindOf(Spoon!CtLiteral) or arg.isKindOf(Spoon!CtFieldRead))) {
        return;
    }
    if (resolvedValues.isDefined() and resolvedValues.containsKey(arg)) {
        var resolved = resolvedValues.get(arg);
        if (resolved.isKindOf(Native("java.lang.Double"))
                or resolved.isKindOf(Native("java.lang.Float"))) {
            var floatExpr = new RoboChart!FloatExp;
            floatExpr.value = resolved.floatValue();
            return floatExpr;
        } else if (resolved.isKindOf(Native("java.lang.Integer"))
                or resolved.isKindOf(Native("java.lang.Long"))
                or resolved.isKindOf(Native("java.lang.Short"))
                or resolved.isKindOf(Native("java.lang.Byte"))) {
            var intExpr = new RoboChart!IntegerExp;
            intExpr.value = resolved.intValue();
            return intExpr;
        }
    }
    // No resolvedValues entry: parse the literal's own value/valueKind
    // attributes (T2M mapper) before the caller substitutes anything.
    if (arg.isKindOf(Spoon!CtLiteral)) {
        return resolveLiteralValue(arg);
    }
}

// =====================================================================
// Action signature for entry-action lifting (Phase 4)
// =====================================================================

// Produce a string signature for an action statement.
// Two actions with the same signature are considered structurally identical.
operation actionSignature(action : Any) : String {
    if (action.isUndefined()) { return ""; }
    if (action.isKindOf(RoboChart!CommunicationStmt)) {
        var comm = action.communication;
        if (comm.isUndefined()) { return "commstmt:?"; }
        var evtName = "";
        if (comm.event.isDefined() and comm.event.name.isDefined()) {
            evtName = comm.event.name;
        }
        var valStr = exprSignature(comm.value);
        return "comm:" + evtName + "!" + valStr;
    }
    if (action.isKindOf(RoboChart!SeqStatement)) {
        var parts = new Sequence;
        for (s in action.statements) {
            parts.add(actionSignature(s));
        }
        return "seq:" + parts.concat(";");
    }
    return "other:" + action.eClass().getName();
}

// Produce a string signature for an expression.
operation exprSignature(expr : Any) : String {
    if (expr.isUndefined()) { return ""; }
    if (expr.isKindOf(RoboChart!IntegerExp)) {
        return "int:" + expr.value.toString();
    }
    if (expr.isKindOf(RoboChart!FloatExp)) {
        return "float:" + expr.value.toString();
    }
    var refFeature = expr.eClass().getEStructuralFeature("ref");
    if (refFeature.isDefined()) {
        var refVal = expr.eGet(refFeature);
        if (refVal.isDefined() and refVal.name.isDefined()) {
            return "ref:" + refVal.name;
        }
    }
    return "expr:" + expr.eClass().getName();
}


// Map a Java type simple-name to a fresh RoboChart TypeRef.
//
// Lookup order:
//   1. Java primitives  -> PrimitiveType "int" / "real" / "boolean"
//   2. enumTypeMap      -> existing Enumeration (Loc, Status, ...)
//   3. recordTypeMap    -> existing RecordType  (GasSensor, ...)
//   4. List<X> with elementType  -> SeqType wrapping a recursive lookup
//   5. fallback         -> fresh PrimitiveType "real"
//
// elementType is the simple name of the first type argument (e.g.
// "GasSensor" for List<GasSensor>); pass "" if not a generic.
// Always returns a TypeRef. Side-effect: adds any newly-created
// PrimitiveType / SeqType to rcPackage.types.
operation mapJavaTypeToRcTypeRef(javaTypeName : String, elementType : String,
                                  enumTypeMap : Map, recordTypeMap : Map,
                                  rcPackage : Any) : Any {
    // 1. Java primitives
    var primName = "";
    if (javaTypeName == "boolean" or javaTypeName == "Boolean") {
        primName = "boolean";
    } else if (javaTypeName == "int" or javaTypeName == "Integer"
               or javaTypeName == "long" or javaTypeName == "Long") {
        // Signed Java integers map to RoboChart's signed core `int`.
        // The previous `nat` mapping silently changed the value domain:
        // a Java int field holding -1 (sentinel) or any negative
        // intermediate became unrepresentable in the formal model.
        primName = "int";
    } else if (javaTypeName == "double" or javaTypeName == "Double"
               or javaTypeName == "float" or javaTypeName == "Float") {
        primName = "real";
    }
    if (primName <> "") {
        var pt = new RoboChart!PrimitiveType;
        pt.name = primName;
        rcPackage.types.add(pt);
        var tr = new RoboChart!TypeRef;
        tr.ref = pt;
        return tr;
    }

    // 2. existing Enumeration
    if (enumTypeMap.isDefined() and enumTypeMap.containsKey(javaTypeName)) {
        var tr = new RoboChart!TypeRef;
        tr.ref = enumTypeMap.get(javaTypeName);
        return tr;
    }

    // 3. existing RecordType
    if (recordTypeMap.isDefined() and recordTypeMap.containsKey(javaTypeName)) {
        var tr = new RoboChart!TypeRef;
        tr.ref = recordTypeMap.get(javaTypeName);
        return tr;
    }

    // 4. List<X> / Collection<X> / Set<X> with a known element type.
    // SeqType is a Type but NOT a TypeDecl, so it cannot live in
    // rcPackage.types (which is constrained to TypeDecl). It's
    // returned directly as an inline Type for the containing slot
    // (Field.type / Event.type) to absorb via containment.
    if ((javaTypeName == "List" or javaTypeName == "ArrayList"
         or javaTypeName == "Collection" or javaTypeName == "Set")
        and elementType <> "") {
        var innerRef = mapJavaTypeToRcTypeRef(elementType, "", enumTypeMap, recordTypeMap, rcPackage);
        var seqType = new RoboChart!SeqType;
        seqType.domain = innerRef;
        return seqType;
    }

    // 5. fallback to "real" — keeps the model parseable but loses
    //    semantic precision. The previous behaviour for everything.
    var fallback = new RoboChart!PrimitiveType;
    fallback.name = "real";
    rcPackage.types.add(fallback);
    var fallbackRef = new RoboChart!TypeRef;
    fallbackRef.ref = fallback;
    return fallbackRef;
}
