%]

[%
// FORK: archive defined `_axioms = ()` (unit), but the
// `<stm>_deadlock_free` lemma uses `_axioms \<Longrightarrow> ...`
// which requires a proposition. Unit `()` is not a bool. Use `True`
// for the vacuous-axioms case so the lemma typechecks. The developer
// can replace this with concrete axioms about the machine if needed.
%]
definition [z_defs]: "[%=stm_name%]_axioms = True"

[%
// GATE (2026-09-16). A state that is the SOURCE of no transition makes the
// deadlock_free obligation below FALSE, not merely hard.
//
// WHY. `z_machine Init Ops = process Init (loop (foldr (\<box>) Ops))`
// (Z_Machine.thy:80): the operations are combined by external choice and
// wrapped in LOOP, so the machine never returns. A state enabling no operation
// therefore offers the empty set — `Vis {}` — which is exactly
// `deadlock` (ITree_Deadlock.thy:10). `deadlock_free_Ret` does NOT rescue it:
// the machine never reaches Ret.
//
// MEASURED. chemical_detector v2 reached `state FINAL` (target of
// GAS_DETECTEDToFINAL, source of nothing) and four tactics burned their budgets
// on it — auto OOM-killed at 978s, metis 1825s, blast 922s, fastforce 923s —
// all searching for a proof of a false statement. Refuted by
// `probe_Y3_obligation_refuted` (scripts/isabelle_falsity_probe.sh), witness
// st = FINAL. v1 did NOT have this: its model carried a `FinalToFinal` tick
// self-loop (reference-runs/.../isabelle:170), and its proof closed in seconds.
// The self-loops were lost between v1 and v2, which is what exposed this.
//
// THE FIX IS UPSTREAM, in the Java: every mode needs an outgoing transition,
// and for a sink mode that means a TICK-TRIGGERED self-loop (bare
// `pre "st = X"` for Isabelle, a visible event for FDR4 rather than a
// tau-divergence). forge.assets/prompts/java_codegen_rules.txt now requires it.
// This gate exists so the omission fails HERE, loudly, at generation time,
// instead of silently downstream as an unprovable obligation that costs an hour
// of verifier budget to not-diagnose.
var nonSourceStates: OrderedSet;
for (nd in p.machines.at(stm_index).nodes) {
  if (not nd.isTypeOf(Final)) {
    var isSrc = false;
    for (tx in p.machines.at(stm_index).transitions) {
      if (tx.source = nd) { isSrc = true; }
    }
    if (not isSrc) { nonSourceStates.add(nd.zmState()); }
  }
}
if (not nonSourceStates.isEmpty()) {
  ("  !! states with NO outgoing transition in " + stm_name + ": "
   + nonSourceStates.concat(", ")
   + " -- deadlock_free is FALSE for this machine (loop semantics: a state"
   + " enabling no operation offers Vis {} = deadlock). Add a tick-triggered"
   + " self-loop in the Java for each. Emitting the lemma with an explicit"
   + " marker rather than a silent unprovable goal.").println();
}
%]
[% if (not nonSourceStates.isEmpty()) { %]
(* WARNING -- THIS OBLIGATION IS FALSE AS EMITTED.
   State(s) with no outgoing transition: [%=nonSourceStates.concat(", ")%].
   Under `loop` semantics such a state offers Vis {} = deadlock, so
   deadlock_free does not hold. This is a MODEL defect (a missing tick-triggered
   self-loop in the Java), not a proof-search problem: no tactic can close it.
   Measured on chemical_detector v2 -- auto OOM 978s, metis 1825s, blast 922s,
   fastforce 923s; refuted by probe_Y3_obligation_refuted with witness
   st = [%=nonSourceStates.at(0)%].
   Fix the Java per forge.assets/prompts/java_codegen_rules.txt ("EVERY MODE
   MUST HAVE AN OUTGOING TRANSITION"), re-extract, and this marker disappears. *)
[% } %]
lemma [%=stm_name%]_deadlock_free: "[%=stm_name%]_axioms  \<Longrightarrow> deadlock_free [%=stm_name%]Machine"
  unfolding [%=stm_name%]Machine_def
  apply deadlock_free
[% // FORK (C2 fix follow-on): event-triggered operations' enabledness
   // disjuncts now carry `<evt> \<in> offered`; with the invariant pinning
   // `st = S \<longrightarrow> listens = {..}` and the guards carrying
   // `offered \<subseteq> listens`, discharging them needs set membership
   // introduction on top of the enumtype exhaustion lemma. `insertCI`
   // (a \<in> insert a A) supplies it for the metis path.
   //
   // !! UNVERIFIED AFTER THE DYNAMIC-LENS SPLIT — the tactic selection below was
   // measured against the SINGLE-LENS encoding, where the pin fixed
   // `triggers` exactly and the trigger conjunct was entailed by it. With
   // `offered` a free input the residual goal changes shape: enabledness is
   // now conditional on an unconstrained variable, so the bare `st = X`
   // disjunct no longer closes every case by exhaustion alone. Whether
   // `metis`/`auto` still discharge, and whether `deadlock_free` remains
   // TRUE (not merely provable), could not be checked here: Isabelle is not
   // runnable in this environment. Re-run the three sessions before
   // claiming any proof result. The timings and tactic choices recorded
   // below are PRE-SPLIT measurements, retained as the starting point for
   // that re-run, NOT as evidence about the current emission.
   // TACTIC FIX (2026-09-16). With the `offered = listens` invariant
   // conjunct (see the inv emission above) the residual goal is a finite case
   // analysis over St PLUS every enum some precondition compares (chem:
   // `sts = noGas` puts Status in the disjunction). metis needs that enum's
   // exhaust_disc among its facts or it searches forever -- measured: chem
   // `metis St.exhaust_disc insertCI` TIMEOUT 900s, adding
   // Status.exhaust_disc -> ALL CLOSED 30s (probe_iteration3.sh arm M2).
   // COMPUTED, not hardcoded: an enum's lemma is supplied iff one of its
   // literals occurs in an accumulated precondition. sranger/lre have no such
   // enum and keep the bare-St call that closes them (21s/119s measured).
   // The old hasPayloadDomain->auto fork existed because metis hung on the
   // payload existential -- measured against a goal that was FALSE;
   // with the true goal, metis+facts closes the payload machine too.
   var exhaustFacts = "St.exhaust_disc";
   for (t in p.types) {
       if (t.isTypeOf(Enumeration) and t.name <> "St" and t.name <> "Evt") {
           var used = false;
           for (lit in t.literals) {
               if (allPreStrings.indexOf(lit.name) >= 0) { used = true; }
           }
           if (used) { exhaustFacts = exhaustFacts + " " + t.name + ".exhaust_disc"; }
       }
   }
   var ddTac; ddTac = "by (metis " + exhaustFacts + " insertCI)"; %]
  [%=ddTac%]
  (* TACTIC (2026-09-16, supersedes the hasPayloadDomain fork): the closing
     call is `by (metis St.exhaust_disc <used-enum>.exhaust_disc ... insertCI)`.
     Under the invariant conjunct `offered = listens` the residual goal after
     `apply deadlock_free` is a finite case analysis over St plus every enum a
     precondition compares (e.g. `sts = noGas` puts Status in the disjunction);
     each such enum's exhaust_disc lemma is supplied, computed from the emitted
     preconditions. Measured 2026-09-16: sranger 17/17 obligations (21s), lre
     39/39 (119s), chem 17/17 (30s -- without Status.exhaust_disc the same call
     is a >900s timeout). The earlier auto branch existed for a payload
     existential measured against a goal that was FALSE before this fix; with the true
     goal, metis with the computed fact list closes the payload machine too. *)
 [%
// '}' in the line below is the close end of package scope: if (p.name="Chemical")
} 
}
%]
end
[%
//-------------------------------------------------------------------
//                     Operations
//-------------------------------------------------------------------
operation OrderedSet toparathString(): String{
	var str:String;
	str=self.at(0);
	var i=1;
	while(i<self.size()){
		str= str+", "+self.at(i);
		i++;
	}
	str="("+str + ")";
	return str;
}
%]





[*convert initial state name from i1 to initial, final j1 to final*]
[%
operation RC!Node zmState(): String{
  if(self.isTypeOf(Initial)){
  return "initial";
  } else if(self.isTypeOf(Final)){
    return "final";
  } else{
  return self.name;
  }
  }%]
  

[*convert initial state name from i1 to Initial, final j1 to Final*]
[%
operation RC!Node zmStateCapt(): String{
  if(self.isTypeOf(Initial)){
  return "Initial";
  } else if(self.isTypeOf(Final)){
    return "Final";
  } else{
  return self.name;
  }
  }%]
  
  
[*convert boolean type to bool type, real to integer*]
[%
operation RC!Type zmType(): String{
  if(self.isTypeOf(ProductType)){
  return "("+self.types.at(0).zmType() + "\\<times>" + self.types.at(1).zmType()+")";
  // FIX (2026-09-14). Only TypeRef carries `.ref`; SeqType/SetType carry
  // `.domain` (robochart.ecore:145-149) and reaching the `.ref` branches with
  // one died with "Property 'ref' not found". First hit: chem run-1 v2's
  // codegen wrote `record GasSensorReading(List<GasSensor> values)` — a
  // sequence-typed record field no admitted study had produced before
  // (sranger/lre records carry scalar fields only). Map to the Z-Machine
  // list/set types the session provides.
  } else if(self.isTypeOf(SeqType)){
  return "(" + self.domain.zmType() + " list)";
  } else if(self.isTypeOf(SetType)){
  return "(" + self.domain.zmType() + " set)";
  } else if(self.ref.name="boolean"){
  return "bool";
  } else if(self.ref.name="real"){
  // FORK: archive mapped RoboChart `real` to Isabelle `integer`,
  // which forced everything into integer arithmetic but caused type
  // unification failures when literal `1.0` appears in a guard
  // (Isabelle parses 1.0 as a rational requiring `inverse`-class).
  // Mapping to Isabelle `real` aligns with our Java `double` source
  // semantics and unifies cleanly with the FloatExp renderer.
  return "real";
  } else  {
  return self.ref.name;
  }
  }%]
  
  
  
[%
operation RC!Expression binaryExpString(): String{
	
	if(self.isTypeOf(LessThan)){
		return self.lessThanString();}
	else if(self.isTypeOf(GreaterThan)){
		return self.greaterThanString();}
	else if(self.isTypeOf(LessOrEqual)){
		return self.lessOrEqualString();}
	else if(self.isTypeOf(GreaterOrEqual)){
		return self.greaterOrEqualString();}
	else if(self.isTypeOf(Equals)){
		return self.equalsString();}
	else if (self.isTypeOf(And)){
		return self.andString();}
	else if (self.isTypeOf(Or)){
		return self.orString();}
	else if (self.isTypeOf(Not)){
		return self.notString();}
	else if (self.isTypeOf(Plus)){
		return self.plusString();}
	else if (self.isTypeOf(Minus)){
		return self.minusString();}
	else if (self.isTypeOf(Mult)){
		return self.multString();}
	// FORK: archive's dispatcher missed Different (!=), Div (/), Neg (-x).
	// `Different` is emitted by the ETL for any Java != in a guard; without
	// this case the operation returned undefined and the precondition came
	// out as e.g. "st = MOM \<and> " (empty RHS), unparseable in Isabelle.
	else if (self.isTypeOf(Different)){
		return self.differentString();}
	else if (self.isTypeOf(Div)){
		return self.divString();}
	else if (self.isTypeOf(Neg)){
		return self.negString();}
	else if(self.isTypeOf(IntegerExp) or self.isTypeOf(RefExp) or self.isTypeOf(CallExp)  or self.isTypeOf(ResultExp) or self.isTypeOf(Selection) or self.isTypeOf(EnumExp) or self.isTypeOf(ArrayExp) or self.isTypeOf(TupleExp) or self.isTypeOf(ClockExp) or self.isTypeOf(SeqExp) or self.isTypeOf(FloatExp) or self.isTypeOf(BooleanExp) or self.isTypeOf(StringExp) ){
		return self.oneSideOfBianryString();}
	else if(self.isTypeOf(ParExp)){
		return self.exp.binaryExpString();
	}
}
%]
[%

operation RC!Expression lessThanString(): String{
	return self.left.binaryExpString() +"<" + self.right.binaryExpString();
}
%]

[%
operation RC!Expression lessOrEqualString(): String{
	return self.left.binaryExpString() +"\\<le>" + self.right.binaryExpString();
}
%]

[%
operation RC!Expression greaterThanString(): String{
return self.left.binaryExpString() +">" + self.right.binaryExpString();
}
%]

[%
operation RC!Expression greaterOrEqualString(): String{
	return self.left.binaryExpString() +"\\<ge>" + self.right.binaryExpString();
}
%]

[%
operation RC!Expression equalsString(): String{
	return self.left.binaryExpString() +"= (" + self.right.binaryExpString()+")";
}
%]
[%
operation RC!Expression andString(): String{
	return self.left.binaryExpString() +" \\<and> " + self.right.binaryExpString();
}
%]

[%
operation RC!Expression orString(): String{
	return "("+self.left.binaryExpString() +" \\<or> " + self.right.binaryExpString()+")";
}
%]

[%
operation RC!Expression notString(): String{
	// FIX (2026-09-17): twin of the inlineRender Not case — see the
	// comment there. \<not> binds tighter than \<and>/\<or>, so a negated
	// connective must be parenthesised or the negation lands on the first
	// operand only. Comparisons stay bare (they bind tighter than \<not>).
	if(self.exp.isTypeOf(And) or self.exp.isTypeOf(Or)){
		return "\\<not>(" + self.exp.binaryExpString() + ")";
	}
	return "\\<not>" + self.exp.binaryExpString();
}
%]

[%
operation RC!Expression plusString(): String{
	return "("+self.left.binaryExpString() +" + " + self.right.binaryExpString()+")";
}
%]

[%
operation RC!Expression minusString(): String{
	return "("+self.left.binaryExpString() +" - " + self.right.binaryExpString()+")";
}
%]


[%
operation RC!Expression multString(): String{
	return "("+self.left.binaryExpString() +" * " + self.right.binaryExpString()+")";
}
%]
[%
// FORK: helpers for Different, Div, Neg. See binaryExpString() dispatch above.
operation RC!Expression differentString(): String{
	return "("+self.left.binaryExpString() +" \\<noteq> " + self.right.binaryExpString()+")";
}
%]
[%
operation RC!Expression divString(): String{
	return "("+self.left.binaryExpString() +" / " + self.right.binaryExpString()+")";
}
%]
[%
operation RC!Expression negString(): String{
	return "(- " + self.exp.binaryExpString() + ")";
}
%]
[%
//DONE
//to return the string of left or right expression string of the binary expression

// FIX (2026-09-19). Java renders small/large doubles in SCIENTIFIC
// notation -- `1.0E-9` -- and the FloatExp render site passed that text
// through verbatim. Isabelle/HOL has no `E` exponent syntax, so the theory
// read `1.0E-9` as the application `(1.0) (-9)` and the build failed with
// "Type error in application: operator not of function type" alongside a
// bogus "(10::??'a) / (10::??'a)" operand. Found by the autonomous arm's
// lre run-4, which worked around it by moving the literal behind an
// abstracted sensor method -- a code-shape workaround for an instrument gap.
//
// Expand to an exact rational HOL can parse. A negative exponent becomes
// `(m / 10...0)` rather than a long 0.000... string: HOL decimal literals are
// exact either way, and the division form stays readable at large k.
operation normaliseFloatLiteral(raw : String) : String {
	var t = raw.trim();
	var up = t.toUpperCase();
	if (up.indexOf("E") < 0) { return t; }
	var i = up.indexOf("E");
	var mant = t.substring(0, i);
	var expo = t.substring(i + 1, t.length());
	if (expo.startsWith("+")) { expo = expo.substring(1, expo.length()); }
	var neg = expo.startsWith("-");
	if (neg) { expo = expo.substring(1, expo.length()); }
	var k = expo.asInteger();
	if (mant.endsWith(".0")) { mant = mant.substring(0, mant.length() - 2); }
	var pow = "1";
	var j = 0;
	while (j < k) { pow = pow + "0"; j = j + 1; }
	if (neg) { return "(" + mant + " / " + pow + ")"; }
	return "(" + mant + " * " + pow + ")";
}

//currently covers 3 types: Integer, RefExp, CallExp
operation RC!Expression oneSideOfBianryString(): String{
	if(self.isTypeOf(IntegerExp)){
		return self.value.toString();
	}
	// FORK: handle FloatExp (value may be null if ETL didn't populate) and
	// BoolExp / StringExp literals. Without this, numeric-literal RHSs
	// vanish from comparison preconditions and Isabelle parses truncated
	// operators (e.g. `vel()\<le>`).
	else if(self.isTypeOf(FloatExp)){
		// FORK: in EOL, `== null` is harness-dependent for unset
		// EAttributes — `.isUndefined()` is the idiomatic check.
		if(self.value.isUndefined()){ return "0"; }
		// expand scientific notation; HOL has no `E` exponent.
		return normaliseFloatLiteral(self.value.toString());
	}
	else if(self.isTypeOf(BooleanExp)){
		// FIX (2026-09-14). HOL's boolean literals are True/False;
		// emitting Java's lowercase `true` verbatim leaves a FREE
		// VARIABLE in the update ("Extra variables on rhs: true",
		// chem run-1 v2 InitialToREADING_def). Note BooleanExp.value
		// is EString in the metamodel, so compare as text.
		var bv = self.value.toString().toLowerCase();
		if (bv == "true")  { return "True"; }
		if (bv == "false") { return "False"; }
		return self.value.toString();
	}
	else if(self.isTypeOf(StringExp)){
		return "\"" + self.value + "\"";
	}
	else if(self.isTypeOf(RefExp)){
		return self.ref.name;
	}
	else if(self.isTypeOf(CallExp)){
		return self.callExpString();
	}
	else if(self.isTypeOf(ResultExp)){
		return "result";
	}
	else if(self.isTypeOf(Selection)){
		return self.member.name+"("+self.receiver.value.ref.name+"!"+self.receiver.parameters.at(0).ref.name+")";
	}
	
	else if(self.isTypeOf(EnumExp)){
		return self.literal.name;
	}
	else if(self.isTypeOf(SeqExp)){
		return self.sequenceString();
	}
	
	else if(self.isTypeOf(ArrayExp)){
		return self.value.ref.name + "."+self.parameters.at(0).value;
	//e.g., vel[1] -> vel.1
	}
	
	else if(self.isTypeOf(TupleExp)){
		return "("+ self.values.at(0).oneSideOfBianryString()+", "+self.values.at(1).oneSideOfBianryString() +")";
	//e.g., (3,4)
	}
	
	else if(self.isTypeOf(ClockExp)){
		return "clock";
	}
} 
%]
  
  
  
  
[*to generate the CallExp expression string for the statement of CallExp type, i.e. functions*]
[% 
// FORK: extract a function name from a CallExp's `function` feature,
// handling both RefExp (archive's shape) and StringExp (the shape our
// ETL emits). Keeps all callExp-name accesses in one place.
// FORK (I1): collect functions APPLIED to an int-typed data variable.
// See the `intDomainFuncs` block above for why the ETL's hardcoded
// `(x : real)` signature for operation-body functions must be corrected
// at the application site. Only a DIRECT zero-arg-CallExp argument whose
// name has an `int` state-var type counts; anything else leaves the
// declared domain alone.
operation RC!Expression collectIntArgFuncNames(acc: OrderedSet, svTypes: Map){
	if(self.isTypeOf(CallExp)){
		for(a in self.args){
			if(a.isTypeOf(CallExp) and a.args.size() == 0){
				var an = a.funcName();
				var at = svTypes.get(an);
				if(at.isDefined() and at.isTypeOf(TypeRef) and at.ref.isDefined()
						and at.zmType() = "int"){
					acc.add(self.funcName());
				}
			}
			a.collectIntArgFuncNames(acc, svTypes);
		}
		return;
	}
	if(self.isTypeOf(And) or self.isTypeOf(Or) or self.isTypeOf(LessThan)
			or self.isTypeOf(LessOrEqual) or self.isTypeOf(GreaterThan)
			or self.isTypeOf(GreaterOrEqual) or self.isTypeOf(Equals)
			or self.isTypeOf(Different) or self.isTypeOf(Plus)
			or self.isTypeOf(Minus) or self.isTypeOf(Mult) or self.isTypeOf(Div)){
		self.left.collectIntArgFuncNames(acc, svTypes);
		self.right.collectIntArgFuncNames(acc, svTypes);
		return;
	}
	if(self.isTypeOf(Not) or self.isTypeOf(ParExp) or self.isTypeOf(Neg)){
		self.exp.collectIntArgFuncNames(acc, svTypes);
		return;
	}
}
%]
[%
// FORK (I1 fix): render an expression for a SIMULTANEOUS-SUBSTITUTION
// update block, inlining data-plane dependencies.
//
// WHY THIS EXISTS. `binaryExpString()` renders a variable read as the
// bare lens name, which in an `update` block denotes the variable's
// PRE-state value. That is right for a guard and right for `tr\<Zprime>
// = tr @ ...`, but wrong for the data plane: the Java computes `tcpa`
// and then computes `cda` from the FRESH `tcpa`. Emitting
// `cda\<Zprime> = f(tcpa)` alongside `tcpa\<Zprime> = E` would make
// `cda` read the STALE `tcpa` — the same stale-read defect (U3) that
// was fixed at the M2M stage, reappearing one level up where it is much
// harder to see. So wherever a read resolves to a data-plane variable
// with a definition, we splice that definition's rendered text in.
//
// CYCLES. Inlining terminates only on an acyclic dependency graph. A
// genuine fixpoint (`x = g(y); y = h(x)`) has no finite inlined form,
// and substituting the pre-state value there would silently change the
// semantics. `stack` carries the chain of names currently being
// expanded; on re-entry we emit `(*I1-CYCLE:<name>*)<name>` — a marker
// that is BOTH grep-able in the artefact and a deliberate Isabelle
// comment, so the affected variable is reported as a blocker rather
// than quietly mis-emitted. The three case studies emit no such marker
// (grep for `I1-CYCLE` in the generated theories); the cycle path is
// exercised directly by IsabelleDataPlaneRegressionTest.
//
// `defs`  : Map name -> RC!Expression (the data-plane definitions)
// `svs`   : OrderedSet of state-variable names (for `f()` -> `f` strip)
// `enums` : OrderedSet of enum literal names (same strip)
// `stack` : OrderedSet of names on the current expansion path
operation RC!Expression inlineRender(defs: Map, svs: OrderedSet,
		enums: OrderedSet, stack: OrderedSet): String{
	if(self.isTypeOf(CallExp)){
		var fn = self.funcName();
		// Zero-arg call: either a data-plane read (inline it), a state
		// var / enum literal (strip the parens), or a genuine zero-arg
		// function (leave as `f()`).
		if(self.args.size() == 0){
			if(defs.containsKey(fn)){
				// FORK (I1 self-read, sranger cycle counter): a read of the
				// SAME name whose definition is currently being expanded —
				// `fn` is the TOP of the expansion stack — is a SELF-READ
				// (`cycleCount = cycleCount + 1`). Under simultaneous
				// substitution that read denotes the PRE-state lens, exactly
				// like the existing `tr\<Zprime> = tr @ [...]` emission, so
				// render the bare lens: it is well-defined, not a fixpoint.
				// Without this case the renderer inlined the definition into
				// itself once (emitting a DOUBLE increment) before the stack
				// guard fired and mis-labelled the inner read I1-CYCLE.
				// A re-entry of a name DEEPER in the stack (x = g(y); y =
				// h(x)) is still a genuine mutual fixpoint: substituting the
				// pre-state there would silently change semantics, so the
				// I1-CYCLE marker is kept for that case.
				if(stack.size() > 0 and stack.last() = fn){
					return fn;
				}
				if(stack.includes(fn)){
					// FORK (steam boiler held-out): the marker used to be
					// emitted INSIDE the quoted term as `(*I1-CYCLE:fn*)fn` —
					// but Isabelle's inner (term) syntax does not accept
					// (*..*) comments, so any theory containing one fails at
					// `Failed to parse term`. The marker is also semantically
					// over-cautious: these defs come from SEQUENTIAL Java
					// compute() bodies, where a read that re-enters the
					// expansion stack necessarily reads a variable assigned
					// at-or-after the current statement, i.e. the PRE-state
					// (steam boiler: levelLow = baseLevelLow(projLow) reads
					// the previous cycle's carried projLow). Under a
					// zoperation's simultaneous substitution the bare lens IS
					// the pre-state, so emit the bare name; keep the
					// diagnostic grep-able by printing it at GENERATION time
					// instead of inside the term.
					("[thy-inline] I1-CYCLE pre-state read: " + fn).println();
					return fn;
				}
				stack.add(fn);
				var inl = defs.get(fn).inlineRender(defs, svs, enums, stack);
				stack.remove(fn);
				return "(" + inl + ")";
			}
			if(svs.includes(fn) or enums.includes(fn)){ return fn; }
			return fn + "()";
		}
		var argStr: String = self.args.at(0).inlineRender(defs, svs, enums, stack);
		var aj = 1;
		while(aj < self.args.size()){
			argStr = argStr + ", " + self.args.at(aj).inlineRender(defs, svs, enums, stack);
			aj++;
		}
		return fn + "(" + argStr + ")";
	}
	if(self.isTypeOf(RefExp)){
		var rn = self.ref.name;
		if(defs.containsKey(rn)){
			// FORK (I1 self-read): see the CallExp twin above — a read of the
			// name whose definition is currently being expanded denotes the
			// PRE-state lens under simultaneous substitution.
			if(stack.size() > 0 and stack.last() = rn){ return rn; }
			// FORK: see the CallExp twin above — bare pre-state lens,
			// diagnostic printed at generation time (inner-syntax comments
			// are not legal Isabelle terms).
			if(stack.includes(rn)){
				("[thy-inline] I1-CYCLE pre-state read: " + rn).println();
				return rn;
			}
			stack.add(rn);
			var inlR = defs.get(rn).inlineRender(defs, svs, enums, stack);
			stack.remove(rn);
			return "(" + inlR + ")";
		}
		return rn;
	}
	// Binary / unary structure — bracketing mirrors the corresponding
	// *String() operations above so inlined text is parenthesised
	// identically to text rendered by the guard path.
	if(self.isTypeOf(And)){
		return self.left.inlineRender(defs, svs, enums, stack) + " \\<and> "
			+ self.right.inlineRender(defs, svs, enums, stack); }
	if(self.isTypeOf(Or)){
		return "(" + self.left.inlineRender(defs, svs, enums, stack) + " \\<or> "
			+ self.right.inlineRender(defs, svs, enums, stack) + ")"; }
	if(self.isTypeOf(Not)){
		// FIX (2026-09-17). Isabelle's \<not> binds TIGHTER than \<and>
		// and \<or>, so \<not>A \<and> B parses as (\<not>A) \<and> B — the
		// negation lands on the first conjunct only. For Not(And(A,B)) that
		// text is strictly stronger than \<not>(A \<and> B) and injects B
		// POSITIVELY; witness: lre run-2 iter-5, MOMToHCM_3's pre carried
		// `\<not>vvel\<ge>1.0 \<and> vdist(cstc)\<le>1.0` for the Java's
		// !(vvel>=1 && vdist<=1), colliding with the later branch's genuine
		// \<not>vdist\<le>1.0 into a false-by-construction precondition
		// (vacuity S1; escalated via the corrected directive's
		// extraction-introduced clause). Parenthesise ONLY connective
		// operands: comparisons bind tighter than \<not> and stay bare, so
		// theories without a negated conjunction are byte-identical.
		if(self.exp.isTypeOf(And) or self.exp.isTypeOf(Or)){
			return "\\<not>(" + self.exp.inlineRender(defs, svs, enums, stack) + ")"; }
		return "\\<not>" + self.exp.inlineRender(defs, svs, enums, stack); }
	if(self.isTypeOf(Plus)){
		return "(" + self.left.inlineRender(defs, svs, enums, stack) + " + "
			+ self.right.inlineRender(defs, svs, enums, stack) + ")"; }
	if(self.isTypeOf(Minus)){
		return "(" + self.left.inlineRender(defs, svs, enums, stack) + " - "
			+ self.right.inlineRender(defs, svs, enums, stack) + ")"; }
	if(self.isTypeOf(Mult)){
		return "(" + self.left.inlineRender(defs, svs, enums, stack) + " * "
			+ self.right.inlineRender(defs, svs, enums, stack) + ")"; }
	if(self.isTypeOf(Div)){
		return "(" + self.left.inlineRender(defs, svs, enums, stack) + " / "
			+ self.right.inlineRender(defs, svs, enums, stack) + ")"; }
	if(self.isTypeOf(Neg)){
		return "(- " + self.exp.inlineRender(defs, svs, enums, stack) + ")"; }
	if(self.isTypeOf(LessThan)){
		return self.left.inlineRender(defs, svs, enums, stack) + "<"
			+ self.right.inlineRender(defs, svs, enums, stack); }
	if(self.isTypeOf(LessOrEqual)){
		return self.left.inlineRender(defs, svs, enums, stack) + "\\<le>"
			+ self.right.inlineRender(defs, svs, enums, stack); }
	if(self.isTypeOf(GreaterThan)){
		return self.left.inlineRender(defs, svs, enums, stack) + ">"
			+ self.right.inlineRender(defs, svs, enums, stack); }
	if(self.isTypeOf(GreaterOrEqual)){
		return self.left.inlineRender(defs, svs, enums, stack) + "\\<ge>"
			+ self.right.inlineRender(defs, svs, enums, stack); }
	if(self.isTypeOf(Equals)){
		return self.left.inlineRender(defs, svs, enums, stack) + "= ("
			+ self.right.inlineRender(defs, svs, enums, stack) + ")"; }
	if(self.isTypeOf(Different)){
		return "(" + self.left.inlineRender(defs, svs, enums, stack) + " \\<noteq> "
			+ self.right.inlineRender(defs, svs, enums, stack) + ")"; }
	if(self.isTypeOf(ParExp)){
		return self.exp.inlineRender(defs, svs, enums, stack); }
	// Leaves with no sub-expressions: defer to the shared renderer.
	return self.oneSideOfBianryString();
}
%]
[%
// FIX (2026-09-14). The CyPhyAssure session registers OUTER-SYNTAX
// KEYWORDS beyond Isabelle's own — Z_Testing.thy alone reserves "depth",
// and the Z_Machines/Z_Toolkit theories add zmachine/zoperation/zinit/
// enumtype/actions/params/pre/update/... . A Java method whose name
// collides (LRE run-1 v2: `double depth()`) was emitted VERBATIM as
// `consts depth :: ...`, and the theory died at parse ("name expected")
// before any proof ran. Mangle colliding names to `<name>_fn` at the
// SINGLE SOURCE every collector and renderer routes through, so the
// consts declaration and every call site stay consistent by construction.
// The list is the session's registrations (grepped from the pinned
// distribution's `keywords` clauses), not guessed. Names that do not
// collide pass through untouched — the sranger/chem theories are
// byte-identical under this change.
operation String zsafeThyName(): String{
	var reserved = Sequence{
		"depth", "zmachine", "zoperation", "zinit", "zfun", "enumtype",
		"actions", "animate", "check_deadlock", "check_reachable",
		"def_consts", "emit", "extends", "init", "invariant", "operations",
		"output", "over", "params", "pre", "precondition", "postcondition",
		"promote", "record_default", "show_record", "tabulate", "until",
		"update"};
	if (reserved.includes(self)){
		return self + "_fn";
	}
	return self;
}

operation RC!CallExp funcName(): String{
	if(self.`function`.isTypeOf(StringExp)){
		return self.`function`.value.zsafeThyName();
	}
	return self.`function`.ref.name.zsafeThyName();
}

// FORK (I1 guard-skew): recursive collector for every NAME READ by an
// expression — zero-arg CallExps (the ETL's shape for state-var and
// sensor reads) AND RefExps — used to classify data-plane definitions
// as stateful and to decide whether a guard needs definition inlining.
// Differs from collectCallExpNames below in that it takes no `declared`
// filter and also walks RefExp leaves.
operation RC!Expression collectLensReadNames(acc: OrderedSet){
	if (self.isTypeOf(CallExp)){
		acc.add(self.funcName());
		for (a in self.args){
			a.collectLensReadNames(acc);
		}
		return;
	}
	if (self.isTypeOf(RefExp)){
		if(self.ref.isDefined() and self.ref.name.isDefined()){
			acc.add(self.ref.name);
		}
		return;
	}
	if (self.isTypeOf(And) or self.isTypeOf(Or) or self.isTypeOf(LessThan)
			or self.isTypeOf(LessOrEqual) or self.isTypeOf(GreaterThan)
			or self.isTypeOf(GreaterOrEqual) or self.isTypeOf(Equals)
			or self.isTypeOf(Different) or self.isTypeOf(Plus)
			or self.isTypeOf(Minus) or self.isTypeOf(Mult) or self.isTypeOf(Div)){
		self.left.collectLensReadNames(acc);
		self.right.collectLensReadNames(acc);
		return;
	}
	if (self.isTypeOf(Not)){
		self.exp.collectLensReadNames(acc);
		return;
	}
	if (self.isTypeOf(ParExp)){
		self.exp.collectLensReadNames(acc);
		return;
	}
	// Leaves (IntegerExp, FloatExp, BooleanExp, StringExp, ...) contribute nothing.
}

// FORK: recursive collector for CallExp identifiers used anywhere in
// an expression tree. Used by the consts-emission pass to discover
// functions referenced via StringExp-named CallExp (the shape our ETL
// emits for sensor/operation calls). Deliberately conservative — walks
// only the structural shapes the template understands.
operation RC!Expression collectCallExpNames(acc: OrderedSet, declared: Set){
	if (self.isTypeOf(CallExp)){
		var fn = self.funcName();
		if (not declared.includes(fn)){
			acc.add(fn);
		}
		for (a in self.args){
			a.collectCallExpNames(acc, declared);
		}
		return;
	}
	if (self.isTypeOf(And) or self.isTypeOf(Or) or self.isTypeOf(LessThan)
			or self.isTypeOf(LessOrEqual) or self.isTypeOf(GreaterThan)
			or self.isTypeOf(GreaterOrEqual) or self.isTypeOf(Equals)
			or self.isTypeOf(Different) or self.isTypeOf(Plus)
			or self.isTypeOf(Minus) or self.isTypeOf(Mult) or self.isTypeOf(Div)){
		self.left.collectCallExpNames(acc, declared);
		self.right.collectCallExpNames(acc, declared);
		return;
	}
	if (self.isTypeOf(Not)){
		self.exp.collectCallExpNames(acc, declared);
		return;
	}
	if (self.isTypeOf(ParExp)){
		self.exp.collectCallExpNames(acc, declared);
		return;
	}
	// Leaves (IntegerExp, FloatExp, BooleanExp, StringExp, RefExp, ...) contribute nothing.
}

// FORK: collect names of CallExps that appear as the direct operand
// of Not (e.g. `\<not>inOpez()`). These should be typed as boolean,
// not numeric, in the auto-emitted consts. Recurses through other
// expression shapes so nested occurrences are still caught.
operation RC!Expression collectBoolCallExpNames(acc: OrderedSet, declared: Set){
	if (self.isTypeOf(Not)){
		// The direct operand of Not is the boolean call site.
		if (self.exp.isTypeOf(CallExp)){
			var fn = self.exp.funcName();
			if (not declared.includes(fn)){
				acc.add(fn);
			}
		} else {
			// Could be \<not>(\<not> ...) or \<not>(par); recurse.
			self.exp.collectBoolCallExpNames(acc, declared);
		}
		return;
	}
	if (self.isTypeOf(And) or self.isTypeOf(Or)){
		// Boolean operands of And/Or could themselves be CallExps;
		// while we'd want to type those as bool too, we don't have
		// signal that they're used purely as bool (vs. e.g. compared).
		// Conservatively: only Not-direct triggers the bool override.
		self.left.collectBoolCallExpNames(acc, declared);
		self.right.collectBoolCallExpNames(acc, declared);
		return;
	}
	if (self.isTypeOf(LessThan) or self.isTypeOf(LessOrEqual) or self.isTypeOf(GreaterThan)
			or self.isTypeOf(GreaterOrEqual) or self.isTypeOf(Equals) or self.isTypeOf(Different)
			or self.isTypeOf(Plus) or self.isTypeOf(Minus) or self.isTypeOf(Mult) or self.isTypeOf(Div)){
		self.left.collectBoolCallExpNames(acc, declared);
		self.right.collectBoolCallExpNames(acc, declared);
		return;
	}
	if (self.isTypeOf(ParExp)){
		self.exp.collectBoolCallExpNames(acc, declared);
		return;
	}
	if (self.isTypeOf(CallExp)){
		// Recurse into args (may contain nested Not-CallExp patterns).
		for (a in self.args){
			a.collectBoolCallExpNames(acc, declared);
		}
		return;
	}
}

// FORK: collect names of CallExps that appear as direct args of
// another CallExp. Heuristic: in our LRE-style models, functions
// declared on the RoboChart package take `nat` indices (vdist, hdist,
// odist take `nat` per RoboChart Function declarations); callees that
// produce those indices (cstc, cdyn, cda, ...) therefore return `nat`.
// So if X appears as an arg of any CallExp, mark X's name as
// nat-returning so the auto-emit pass overrides the default `real`.
operation RC!Expression collectNatCallExpNames(acc: OrderedSet, declared: Set){
	if (self.isTypeOf(CallExp)){
		for (a in self.args){
			if (a.isTypeOf(CallExp)){
				var fn = a.funcName();
				if (not declared.includes(fn)){
					acc.add(fn);
				}
			}
			// Recurse into args to catch nested cases.
			a.collectNatCallExpNames(acc, declared);
		}
		return;
	}
	if (self.isTypeOf(And) or self.isTypeOf(Or) or self.isTypeOf(LessThan)
			or self.isTypeOf(LessOrEqual) or self.isTypeOf(GreaterThan)
			or self.isTypeOf(GreaterOrEqual) or self.isTypeOf(Equals)
			or self.isTypeOf(Different) or self.isTypeOf(Plus)
			or self.isTypeOf(Minus) or self.isTypeOf(Mult) or self.isTypeOf(Div)){
		self.left.collectNatCallExpNames(acc, declared);
		self.right.collectNatCallExpNames(acc, declared);
		return;
	}
	if (self.isTypeOf(Not) or self.isTypeOf(ParExp)){
		self.exp.collectNatCallExpNames(acc, declared);
		return;
	}
}

operation RC!CallExp callExpString(): String{
	var args_string: String = "";
	var callExp_string: String;
	// FORK: guard zero-argument calls — archive version blew up here
	if(self.args.size() == 0){
		return self.funcName() + "()";
	}
	//to get the parameter on the right

	if(self.args.at(0).isTypeOf(RefExp)){
		args_string= self.args.at(0).ref.name;
	}
	else
	//this branch is for callexp used in functions where we have the keyword result
	if(self.args.at(0).isTypeOf(ResultExp)){
		args_string= "result";
	}
	else
	if(self.args.at(0).isTypeOf(Selection)){
		args_string=self.args.at(0).member.name+"("+self.args.at(0).receiver.value.ref.name+"!"+self.args.at(0).receiver.parameters.at(0).ref.name+")";
	}
	else {
		// FORK: archive only handled RefExp/ResultExp/Selection. Anything
		// else (CallExp, IntegerExp, FloatExp, BinaryExpression, ...)
		// silently produced empty arg-string and dropped the argument,
		// e.g. odist(cstc()) became odist(). Render via the existing
		// expression dispatcher so any leaf or nested expression works.
		args_string = self.args.at(0).oneSideOfBianryString();
	}

	//for the case that there are more than 2 args, we need insert ',' between args
	var j=1;
	while(j<self.args.size()){

		if(self.args.at(j).isTypeOf(RefExp)){
			args_string=args_string+ ", "+ self.args.at(j).ref.name;
		}
		else
		//this branch is for callexp used in functions where we have the keyword result
		if(self.args.at(j).isTypeOf(ResultExp)){
			args_string=args_string+ ", "+ "result";
		}
		else
		if(self.args.at(j).isTypeOf(Selection)){
			self.args.at(j).receiver.println();
			args_string= args_string+ ", "+self.args.at(j).member.name+"("+self.args.at(j).receiver.value.ref.name+"!"+self.args.at(j).receiver.parameters.at(0).ref.name+")";
		}
		else {
			// FORK: same fallback for second-and-subsequent args.
			args_string = args_string + ", " + self.args.at(j).oneSideOfBianryString();
		}
		j++;
	}
	
	callExp_string=self.funcName()+"("+args_string+")";
	return callExp_string;
	}
  %]
    
[*to generate the Call expression string for the statement of Call type, i.e. operations*]
[% 
operation RC!Call callString(): String{
	var args_string: String;
	var call_string: String;
	//to get the parameter on the right
	if(self.args.size()=0){
		args_string="";
	}
	else if(self.args.size()>0){
		if(self.args.at(0).isTypeOf(RefExp)){
			args_string= self.args.at(0).ref.name;
		}
		else if(self.args.at(0).isTypeOf(IntegerExp)){
			args_string= self.args.at(0).value.toString();
		}
		else if(self.args.at(0).isTypeOf(EnumExp)){
			args_string= self.args.at(0).literal.name;
		}
		else 
		//this branch is for callexp used in functions where we have the keyword result
		if(self.args.at(0).isTypeOf(ResultExp)){
			args_string= "result";
		}
		else
		if(self.args.at(0).isTypeOf(Selection)){
			args_string=self.args.at(0).member.name+"("+self.args.at(0).receiver.value.ref.name+"!"+self.args.at(0).receiver.parameters.at(0).ref.name+")";
		}
		
		//for the case that there are more than 2 args, we need insert ',' between args
		var j=1;
		while(j<self.args.size()){
		//"self.args.at(j).type:".println();
		//self.args.at(j).type.println();
				
		if(self.args.at(j).isTypeOf(RefExp)){
			args_string=args_string+ ", "+ self.args.at(j).ref.name;
		}
		else if(self.args.at(j).isTypeOf(IntegerExp)){
			args_string= args_string+ ", "+ self.args.at(j).value.toString();
		}
		else if(self.args.at(j).isTypeOf(EnumExp)){
			args_string= args_string+ ", "+ self.args.at(j).literal.name;
		}
		else 
		//this branch is for callexp used in functions where we have the keyword result
		if(self.args.at(j).isTypeOf(ResultExp)){
			args_string=args_string+ ", "+ "result";
		}
		else
		if(self.args.at(j).isTypeOf(Selection)){
			self.args.at(j).receiver.println();
		args_string= args_string+ ", "+self.args.at(j).member.name+"("+self.args.at(j).receiver.value.ref.name+"!"+self.args.at(j).receiver.parameters.at(0).ref.name+")";
		
		}
		
		j++;
		}
	}
	call_string=self.`operation`.name+"("+args_string+")";
	return call_string;
}
  %]

  
[%
operation RC!SeqExp sequenceString(): String{
	
	if(self.values.size()=0){
		return  "[]";
	} 
	else if(self.values.size()>0) {
		var m=1;
		var sequence_string="["+self.values.at(0);
		while (m<self.values.size()){
			sequence_string=sequence_string+", "+self.values.at(m);
			m++;
		}
		sequence_string=sequence_string+"]";
		return sequence_string;
	}
}
%]


[%
operation RC!ProductType productString(): String{
	var strings: String;
	strings= "("+self.types.at(0).zmType() + "\\<times>" + self.types.at(1).zmType()+")" ;
	return strings;
}
%]